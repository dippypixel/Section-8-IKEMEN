[Info]
 ;Name of the stage.
name = "Jojo's Bizarre Adventure - Death 13"
displayname = "Jojo's Bizarre Adventure - Death 13" ;Name to display
mugenversion = 1.1          ;Version of M.U.G.E.N stage works on (X.XX)
author = "Carmell"
;--------------------------------------------------------
[Camera]
 ;Camera starting position: Usually 0 for both
startx = 0
starty = 0
boundleft = -226
boundright = 226
boundhigh = -3
boundlow = -3
verticalfollow = 1
;tensionhigh = 90
;tensionlow = -20
tension = 60
zoomin = 1.014
zoomout = 1.014
;overdrawhigh = 120
;overdrawlow = 120
cuthigh = 35
cutlow = -25

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
p1startx = -70         ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2facing = -1

;--- Player 3 ---
p3startx = -120
p3starty = 0
p3facing = 1

;--- Player 4 ---
p4startx = 120
p4starty = 0
p4facing = -1

;--- Common ---
leftbound  = -4000 ;Left bound (x-movement)
rightbound =  4000 ;Right bound

;--------------------------------------------------------
[Bound]
screenleft = 15
screenright = 15
;--------------------------------------------------------
[StageInfo]
zoffset = 216;660
autoturn = 1
resetBG = 0
localcoord = 320,240;1125,843;1000,750;800,600;640,480;320,240
xscale = 1
yscale = 1
;--------------------------------------------------------
[Shadow]
intensity = 100
yscale = .15
;--------------------------------------------------------
[Reflection]
intensity = 0
;--------------------------------------------------------
[Music]
bgmusic = sound/Jojo's Bizarre Adventure - Death 13.mp3
bgmvolume = 255
;-------------------------------------
[BGdef]
spr = CARMELLJJBA-Death13.sff
debugbg = 0

[BG LEFT]
type  = normal
spriteno = 1,1
layerno = 0
start = 0, 0;-28;350
delta = 1, 1
trans = none
mask  = 1

[BG MIDDLE]
type  = normal
spriteno = 1,3
layerno = 0
start = 0, 0;-28;350
delta = 1, 1
trans = none
mask  = 1

[BG RIGHT]
type  = normal
spriteno = 1,2
layerno = 0
start = 0, 0;-28;350
delta = 1, 1
trans = none
mask  = 1
