[Info]
name =  "KOF'98 UM - China Stage"
round1def = stages/KOF98UM_China_Stage1.def
round2def = stages/KOF98UM_China_Stage2.def
round3def = stages/KOF98UM_China_Stage3.def

[Camera]
startx = 0
starty = 0
boundleft = -224
boundright = 224
boundhigh = -16
verticalfollow = .16
boundlow = 0
floortension = 0
tension = 50

[PlayerInfo]
p1startx = -70
p1starty = 0            
p1startz = 0           
p1facing = 1            

p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000
rightbound =  1000
topbound  =  0    
botbound  =  0   

[Scaling]
topz     = 0      
botz     = 50    
topscale = 1      
botscale = 1.2    

[Bound]
screenleft = 25
screenright = 25

[StageInfo]
zoffset   = 210
autoturn  = 1
resetBG    = 0     

[Shadow]
intensity =128
colour = 0,0,0
yscale = .2
 
[reflection]
intensity = 0

[Music]

