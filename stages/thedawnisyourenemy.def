;Tools used: GIMP, Fighter Factory, Audacity
;--------------------------------------------------------
[Info]
name = "The Dawn Is Your Enemy"
displayname = "The Dawn Is Your Enemy"
versiondate = 19,05,2019
mugenversion = 1.0
author = "Meldo"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -80
boundright = 80
boundhigh = -120
boundlow = 0
verticalfollow = .4
floortension = 180
tension = 50
overdrawhigh = 0
overdrawlow = 0
cuthigh = 35
cutlow = 25


;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -140
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 140
p2starty = 0
p2facing = -1

;--- Common ---
leftbound  = -1000
rightbound =  1000

;--------------------------------------------------------
[Bound]
screenleft = 15
screenright = 15

;--------------------------------------------------------
[StageInfo]
zoffset = 450
autoturn = 1
resetBG = 0
localcoord = 640, 480
xscale = 1
yscale = 1
hires = 1
;--------------------------------------------------------
[Shadow]
intensity = 128
color = 0,0,0
yscale = .15
fade.range = -50,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/violence-is-a-menace.mp3
bgmvolume = 75
;bgmloopstart = 000028141
;bgmloopend = 000441216
;========================================================
;-------------------------------------
[BGdef]
spr = thedawnisyourenemy.sff
debugbg = 0

;----------
[BG Floor]
type  = normal
spriteno = 0, 0
layerno = 0
start = 0, 180
delta = 2, 2
mask = 1

[BG Text]
type  = normal
spriteno = 1, 0
layerno = 1
start = 0, 180
delta = 2, 2
trans = addalpha
alpha = 256, 256
mask = 1

[BG Flowers Sub]
type  = normal
spriteno = 0, 1
layerno = 0
start = 0, 180
delta = 2, 2
trans = sub
mask = 1

[BG Flowers Alpha]
type  = normal
spriteno = 0, 1
layerno = 1
start = 0, 180
delta = 2, 2
trans = addalpha
alpha = 256, 256
mask = 1