ステージ第２作目

ＫＯＦ９８　電車ステージ  By ブッチ

ホームページ（one for all）
http://hccweb1.bai.ne.jp/~hda47501/

メール
hda47501@hcc1.bai.ne.jp

;[Info]
name = "KOF98 - USA Yard" ;ステージの名前
round1def = stages/KOF98_U.S.A._Train_Yard1.def
round2def = stages/KOF98_U.S.A._Train_Yard2.def
round3def = stages/KOF98_U.S.A._Train_Yard3.def

;[Camera]
;startx = 0 ;カメラ開始位置 (x軸)
;starty = 0 ;カメラ開始位置 (y軸)
;boundleft = -95 ;ステージ限界座標 (左)
;boundright = 95 ;ステージ限界座標 (右)
;boundhigh = -25 ;ステージ限界座標 (上)
;boundlow = 0 ;ステージ限界座標 (下)
;verticalfollow = .2 ;カメラ移動速度
;floortension = 0 ;縦スクロール始点(？)
;tension = 50 ;横スクロール始点

;[PlayerInfo]
;p1startx = -70 ;ラウンド開始時のP1立ち位置 (x軸)
;p1starty = 0 ;ラウンド開始時のP1立ち位置 (y軸)
;p1startz = 0 ;ラウンド開始時のP1立ち位置 (z軸 ？)
;p1facing = 1 ;P1側キャラの向き (1で右, -1で左)
;p2startx = 70 ;ラウンド開始時のP2立ち位置 (x軸)
;p2starty = 0 ;ラウンド開始時のP2立ち位置 (y軸)
;p2startz = 0 ;ラウンド開始時のP2立ち位置 (z軸 ？)
;p2facing = -1 ;P2側キャラの向き (1で右, -1で左)
;leftbound = -1000 ;左の限界座標
;rightbound = 1000 ;右の限界座標
;topbound = 0 ;天井の限界座標(？)
;botbound = 0 ;底の限界座標(？)

;[Scaling]
;topz = 0
;botz = 50
;topscale = 1
;botscale = 1.2

;[Bound]
;screenleft = 15 ;左側の見えない壁の位置
;screenright = 15 ;右側の見えない壁の位置

;[StageInfo]
;zoffset = 190 ;地面の位置
;autoturn = 1 ;自動旋回 (0でOFF)
;resetBG = 1 ;背景表示位置のリセット(？)

;[Shadow]
;color = 128,128,128 ;影の色 (省略時 92,92,92)
;yscale = .3 ;影の長さ (省略時 0.4)
;reflect = 0 ;影の透過 (0でOFF)

[Music]
bgmusic =
bgvolume = 255

;[BGdef]
;spr = ???.sff ;構成するsffファイル名
;debugbg = 1 ;sff範囲外の残像表示 (0でON)

;[BG ?]
;type = normal ;表示タイプ (normal, anim)
;spriteno = 0, 0 ;sffの登録番号
;layerno = 0 ;表示位置 (0でキャラの奥, 1で手前)
;start = 0, 0 ;背景始点座標
;delta = 1, 1 ;スクロール速度 (0でノンスクロール)
;trans = none ;背景効果 (none, add, sub)
;mask = 0 ;指定透過色で透過 (0でOFF)
;tile = 1, 0 ;背景を並べて表示 (x, y軸, 0でOFF)
;tilespacing = 0, 0 ;背景を並べて表示する間隔
;window = 0,0, 319,239 ;画面表示範囲 (x, y軸 ～ x, y軸)




[Info]
name = "KOF'98 - U.S.A. Yard";電車

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = 107
boundright = 531
boundhigh = -7
boundlow = 0
verticalfollow = .2
tension = 50

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = 600         
p1starty = 0           
p1startz = 0            
p1facing = 1            

;--- Player 2 ---
p2startx = 390
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 
rightbound =  2000 
topbound  =  0     
botbound  =  0     

;--------------------------------------------------------
[Scaling]
topz     = 0       
botz     = 50   
topscale = 1   
botscale = 1.2     

;--------------------------------------------------------
[Bound]
screenleft = 15    
screenright = 15   

;--------------------------------------------------------
[StageInfo]
zoffset = 223
autoturn = 1
resetBG = 0

;--------------------------------------------------------
[Shadow]
color = 92,92,92
yscale = .1

;--------------------------------------------------------
[Music]
bgmusic = sound/03 - Saxophone Storm (Iori Yagami).mp3
bgvolume = 255

;========================================================

[BGdef]
spr =stages/KOF98_U.S.A._Train_Yard1.sff
debug=0
debugbg=0

[BG 0]
type  = normal
spriteno = 0, 0
start = -55, -7
delta = .5, 1
trans = none
mask  = 0

[BG 1]
type  = anim
spriteno = 1, 0
start = -55, -7
delta = 1, 1
mask = 1
velocity = 0, 0
actionno = 2
id = 2

[BG 2]
type  = anim
spriteno = 2, 0
start = -55, -7
delta = 1, 1
mask = 1
velocity = 0, 0
actionno = 3


[BG 3]
type  = anim
spriteno = 3, 0
start = -55, -7
delta = 1, 1
mask = 1
velocity = 0, 0
actionno = 4



