;--------------------------------------------------------

[Info]
name = "YDA_Jojo_Beach_Transition"
author= "Master Yoda"

;THANKS TO:
;Capcom for make this crazy game
;and you for downloading this stage

;http://senseiyoda.mugen-infantry.net
;DATE = 30/08/11

[BGdef]
spr = YDA_Jojo_Beach.sff
debugbg = 0
;--------------------------------------------------------
[Music]
bgmusic = sound/YDA_Jojo_Night_Beach.mp3 
bgvolume = 225

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -480
boundright = 480
boundhigh = -88
boundlow = 0
verticalfollow = .75
floortension = 80
tension = 50

;--------------------------------------------------------
[PlayerInfo]

;--- Player 1 ---
p1startx = -82
p1starty = 0            
p1startz = 0            
p1facing = 1            

;--- Player 2 ---
p2startx = 82
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
 ;Don't change these values.
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 20    ;Dist from left of screen that player can move to
screenright = 20   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 212
autoturn = 1
resetBG = 0
HIRES = 0

;--------------------------------------------------------
[Shadow]
intensity = 118
color = 0,0,0
yscale = .25
fade.range = -400,-100

;--------------------------------------------------------
[Reflection]
;intensity = 128

;========================================================
;--------------------------------------------------------
; Background definition
; ***
;-------------------------------------
[BG SKY_BLUE]
type  = normal
spriteno = 1,0
delta = .9,.98
mask = 1
[BG SKY_GREEN]
