;===========================================================================
;---------------------------------------------------------------------------
[Statedef -1]

[State -1, AI Guard]
Type = ChangeState
Value = 120
triggerall = StateType != A && Var(15) != 0 && Ctrl
trigger1 = (Var(15)*Var(15)*Var(15)*2)*0.1
trigger1 = !(enemynear,hitdefattr=SCA,AT) && inguarddist
trigger1 = (stateno!=[120,155])

;===========================================================================
;---------------------------------------------------------------------------
; NeoMax
[State -1, NeoMax]
type = ChangeState
value = 2500
triggerall = statetype != A
triggerall = power >= 3000
triggerall = RoundState = 2
triggerall = ctrl || (StateNo = [200,799]) && MoveContact ||  (StateNo = [1000,1999]) && MoveContact
trigger1 = (command = "xyz" || command = "c") && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.3 > random && RoundState = 2 ; AI chains from heavy
trigger2 = StateNo = 220 && MoveHit && P2StateType = A

