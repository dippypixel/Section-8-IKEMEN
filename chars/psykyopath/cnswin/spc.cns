triggerall = Var(7) = 60
triggerall = Var(6) = 4
trigger1 = AnimElem = 3
value = S1014,0
channel = 0
[State 0, Snd Voice 5]
type = PlaySnd
triggerall = Var(7) = 60
triggerall = Var(6) = 5
trigger1 = AnimElem = 3
value = S1015,random%2
channel = 0
[State 0, Snd Voice 6]
