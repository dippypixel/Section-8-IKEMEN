;---------------------------------------------------------------------------
; QCF
[Statedef 1000]
type = S
movetype = I
physics = S
poweradd = 40
velset = 0,0
anim = 1000
ctrl = 0

[State 0, VarSet]
type = VarSet
trigger1 = Time = 0
v = 5
value = ifelse(command="y",1,ifelse(command="z",2,0))

[State 0, VarSet]
type = VarSet
trigger1 = Time = 0
v = 6
value = random%7

[State 0, Var Voice]
type = VarSet
triggerall = Var(7) = 0
trigger1 = AnimElem = 3
v = 7
value = 60

[State 0, Snd Swing]
