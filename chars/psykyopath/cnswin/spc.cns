[State 0, Var Voice]
type = VarSet
triggerall = Var(7) = 0
trigger1 = AnimElem = 2
v = 7
value = 50

[State 0, Anim Strength]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Var(5) != 0
value = 1100+Var(5)

[State 0, Snd Jump]
type = PlaySnd
trigger1 = AnimElem = 4
value = S2,0
[State 0, Snd Voice]
type = PlaySnd
triggerall = Var(7) = 50
trigger1 = AnimElem = 2
value = S1100,random%5
channel = 0
[State 0, Snd Swing 1]
type = PlaySnd
trigger1 = AnimElem = 5
trigger2 = AnimElem = 10 && Var(5) != 0
value = S0,2
channel = 1
[State 0, Snd Swing 2]
type = PlaySnd
trigger1 = AnimElem = 21
value = S0,4
channel = 1

[State 0, Vel Init]
type = VelSet
trigger1 = AnimElemNo(0) = [1,2]
x = 4+Var(5)
y = 0
[State 0, VelSet]
type = VelSet
trigger1 = AnimElem = 5
x = 1+(Var(5)*1)
y = -3-(Var(5)*0.5)
[State 0, VelAdd]
type = VelAdd
trigger1 = Var(5) = 1 && AnimElemNo(0) = [5,10]
trigger2 = Var(5) = 2 && AnimElemNo(0) = [5,16] 
y = 0.1
[State 0, VelAdd]
type = VelAdd
trigger1 = Var(5) = 0 && AnimElemNo(0) >= 6 
trigger2 = Var(5) = 1 && AnimElemNo(0) >= 10
trigger3 = Var(5) = 2 && AnimElemNo(0) >= 16 
y = 0.4

