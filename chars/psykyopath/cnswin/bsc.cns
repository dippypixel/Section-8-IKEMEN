; Run forward
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 0, Snd Step]
type = PlaySnd
trigger1 = Time = 0
trigger2 = AnimElem = 5
trigger3 = AnimElem = 9 
value = S2,2+random%2
channel = 1

[State 5100, Run FX]
type = Explod
trigger1 = Time = 1
trigger2 = AnimElem = 5
trigger3 = AnimElem = 9 
anim = 8310
pos = 0, 0
scale = 0.5,0.5
sprpriority = -9

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 101
ctrl = 1

