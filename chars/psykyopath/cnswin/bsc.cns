type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 0, VarSet]
type = VarSet
trigger1 = 1
fv = 9 
value = 0.065

[State 5900, 4]
type = ChangeState
trigger1 = roundno = 1
trigger2 = RoundsExisted = 0
value = 190

[State 5900, 5]
type = ChangeState
trigger1 = 1
value = 0


