

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1
[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 2]
type = VarSet
trigger1 = Time = 0
v = 2
value = 1
[State 40, 2]
type = VarSet
trigger1 = command != "holdup"
trigger1 = PrevStateNo != 100
v = 2
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = Time = 0
v = 5
value = 0
[State 0, VarSet]
type = VarSet
trigger1 = command = "x"
v = 5
value = 1
[State 0, VarSet]
type = VarSet
trigger1 = command = "y"
v = 5
value = 2
[State 0, VarSet]
type = VarSet
trigger1 = command = "z"
v = 5
value = 3
[State 0, VarSet]
type = VarSet
trigger1 = command = "a"
v = 5
value = 4
[State 0, VarSet]
type = VarSet
trigger1 = command = "b"
v = 5
value = 5


[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(var(2)=1,const(velocity.jump.y),const(velocity.jump.y)*0.66)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = Var(5) = 1
value = 600
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = Var(5) = 2
value = 610
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = Var(5) = 3
value = 620
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = Var(5) = 4
value = 850
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = Var(5) = 5
value = 920
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 48

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 0, Snd Land]
type = PlaySnd
trigger1 = Time = 0 
value = S2,0
channel = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Var(2) = 1
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Var(2) = 0
value = ifelse((vel x)=0, 44, ifelse((vel x)>0, 45, 46))

