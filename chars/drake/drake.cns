type = S

[State 180, Set Random]
type = VarRandom
trigger1 = Time = 0
v = 4
range = 0,1

[State 180, 0]
type = ChangeState
trigger1 = Var(4) = 0
value = 181

[State 180, 1]
type = ChangeState
trigger1 = Var(4) = 1
value = 182


[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

