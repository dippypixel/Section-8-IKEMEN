;---------------------------------------------------------------------------
;Kung Fu Throw - Attempt
; CNS difficulty: medium-advanced
; Description: Throws are not difficult to make, although then can be
;     tedious at times. Throw attempt states have a HitDef of a
;     special format. The key parameters in a throw are p1stateno
;     and p2stateno. If the HitDef successfully connects, then
;     the attacker will change to the state number specified by
;     p1stateno, and the opponent will be change to the state
;     number assigned to p2stateno. The special thing about p2stateno
;     is that the opponent will be temporarily brought into the
;     attacker's state file. In this case, no matter who the
;     opponent is, he will be taken to state 820 of this file (kfm.cns)
;     and remain here until the end of the throw (look at his debug
;     information when he is being thrown; the text changes to yellow
;     to mean that he is in another player's state file).
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2

; Notes: The '-' symbol in the hitflag field means that it only affects
;   players who are not in a hit state. This prevents KFM from combo-ing
;   into the throw. The priority should be set to a low number, such as
;   1 or 2, so that the throw does not take precedence over normal attacks.
;   The type of priority must always be set to "Miss" or "Dodge" for throws,
;   otherwise strange behavior can result.
[State 850, ???????? - HitDef??]
type = HitDef
trigger1 = p2stateno != [130,153]
trigger1 = p2statetype != A
trigger1 = p2movetype != H
trigger1 = time = 0
attr = S, NT
hitflag = M
numhits = -1
priority = 2, miss
hitsound = s900, 0
sprpriority = -1
sparkno = -1
snap = 25,-11
p1stateno = 810
p2facing = 1
p2stateno = 820          ;Force p2 into falling down

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Kung Fu Throw - Throwing the opponent
; Description: In this state, KFM throws the opponent by binding him to
;     various offsets based on his current frame of animation. For
;     example, [State 810, Bind 1] binds the opponent to an offset of
;     28 pixels in front of KFM. That puts him around where KFM's hand
;     is at. Is is important to keep the opponent bound using a
;     TargetBind controller at all times, until you let him go. This
;     is especially important if your player has a Clsn2 box that
;     allows him to get hit while throwing someone. Each time a player
;     gets hit, all his bound targets will be set to a fall state. If
;     the opponent is not bound, then he may get stuck in his thrown
;     state when his attacker is knocked out of the throw halfway.
; Notes: There is a TargetLifeAdd controller to decrease the opponent's
;     life, and a TargetState controller to change his state to a
;     falling state when KFM lets go of him.
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
sprpriority = 2

; Here a variable, var(2), is used to remember whether or not the
; player was holding forward at the start of the state. This variable
; is checked later on to turn KFM around if necessary.
[State 810, Holding fwd?]
type = VarSet
trigger1 = Time = 0
var(2) = command = "holdfwd"

[State 810, Throw Sound]
type = PlaySnd
trigger1 = time = 0 
value = 810, 0

[State 810, Throw Sound]
type = PlaySnd
trigger1 = time = 18
value = 100, 1
channel = 1

[State 810, Throw Sound]
type = PlaySnd
trigger1 = time = 31
value = 200, 5
channel = 1

[State 810, Throw Sound]
type = PlaySnd
trigger1 = time = 76
value = 200, 6
channel = 1

[State 810, Throw Sound]
type = PlaySnd
trigger1 = time = 56
value = 100, 2
channel = 1

[State 1000, Spark]
type = Explod
trigger1 = time = 31 
Anim = 811
id = 8305
pos = 33,-88
postype = P1
ownpal = 1
sprpriority = 5
scale = 1,1
pausemovetime = 6

[State 1000, Spark]
type = Explod
trigger1 = time = 31 
Anim = 8001
id = 8305
pos = 44,-85 
postype = P1
ownpal = 1
sprpriority = 5
scale = 1,1
pausemovetime = 6

[State 1000, Spark]
type = Explod
trigger1 = time = 76
Anim = 812
id = 8305
removetime = 66
pos = 33,-88
postype = P1
ownpal = 1
sprpriority = 3
scale = 1,1

[State 1000, Spark]
type = Explod
trigger1 = time = 76
Anim = 813
id = 8305
removetime = 64
pos = 33,-88
postype = P1
ownpal = 1
sprpriority = 3
scale = 1,1

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 = AnimElem =  7
value = -44

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 = AnimElem = 10
value = -146

[State 810, State End]
