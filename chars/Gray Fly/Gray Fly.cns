attr = S, NA
animtype  = High
damage    = 63
guardflag = l
pausetime = 12,12
sparkno = s8002
guard.sparkno = s8100
sparkxy = -11,-48
hitsound   = s5,2
guardsound = s6,0
ground.type = Low
ground.slidetime = 12
ground.hittime  = 17
ground.velocity = -6
air.velocity = -2.2,-3.2

