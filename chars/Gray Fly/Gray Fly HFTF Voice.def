; Definition file for Gray Fly
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Gray Fly"        ;Name of character
displayname = "Gray Fly" ;Name of character to display
versiondate = 09,30,2009    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Kakyoin-Kun"         ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = Gray Fly.cmd           ;Command set
cns     = Gray Fly 2.cns           ;Constants
st      = Gray Fly 2.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = Gray Fly.sff           ;Sprite
anim    = Gray Fly.air           ;Animation
sound   = Gray Fly HFTF.snd           ;Sound
ai      = Gray Fly.ai            ;AI hints data (not used)
pal1=act004.act;スタンドボタンカラー
pal2=act005.act;スタートボタンカラー
pal3=act006.act;メディコス版アクションフィギュアカラー
pal4=act001.act;弱攻撃カラー
pal5=act002.act;中攻撃カラー
pal6=act003.act;強攻撃カラー
pal7=act010.act;18巻表紙カラー
pal8=act011.act;オリジナルカラー1
pal9=act012.act;オリジナルカラー2
pal10=act007.act;47巻表紙カラー
pal11=act008.act;33巻表紙カラー（コートは緑にアレンジ）
pal12=act009.act;16巻表紙カラー

; Arcade mode
[Arcade]
intro.storyboard = 
ending.storyboard = 
