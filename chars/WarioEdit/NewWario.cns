[Statedef 100]
type                = S
physics             = S
anim                = 100
sprpriority         = 1
[State -2:          Correr]
type                = PlaySnd
;triggerall          = stateno = 100
trigger1            = !time
value               = 0,11
channel             = 10
[State 100, 1]
type                = VelSet
trigger1            = 1
x                   = const(velocity.run.fwd.x)
[State 1001:        particulas]
