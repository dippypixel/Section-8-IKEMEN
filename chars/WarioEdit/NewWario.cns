trigger1            = time%7
vel                 = -2+(random<500),0
accel               = 0,.05
anim                = 6014
sprpriority         = -5
;postype             = p2
scale               = .3,.3
pos                 = 0,-100
random              = 10,30
facing              = -1+(random<500)*2
removetime          = -2
ignorehitpause      = 1
ownpal              = 1
[State 100, 2] ;Prevent run from canceling into walk
