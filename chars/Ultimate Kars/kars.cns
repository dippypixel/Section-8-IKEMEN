;==============================================================
; AI Walk
[Statedef 21]
type = S
physics = N
sprpriority = 0
velset = 0,0
ctrl = 0
facep2 = 1

[State 21, Exit-IF-Human]
type = ChangeState
trigger1 = !AILevel
value = 0
ctrl = 1

[State 21, Init Pos fix]
type = posset
trigger1 = !time
y = 0

;--------- Var INIT --------------
[State 21, Random walk if no other intention at start]
type = Varset
triggerall = var(14) >= 0 && cond(enemynear(var(59)),statetype !=A,!numexplod(750750),1)
trigger1 = !time
var(14) = cond(ailevel >= 7,2+1*(random < 200),3)  ;1=Random Move, 2=forced forward, 3=forced backward 11 = stop

[State 21, Input from command file]
type = varset
trigger1 = !time
trigger1 = var(14) < 0
var(14) = Abs(var(14))

[State 21, INIT Move Var]
type = Varset
trigger1 = !time && var(14)=1
var(15)= 0

[State 21, add random Move Var]
type= Varset
trigger1= var(14)=1 && var(15) < 1
var(15) = 40 + random%41

[State 21, consume Move var]
type = Varadd
trigger1 = var(14) = 1
trigger1 = var(15) > 0
var(15) = -1

;---------- Change Direction at condition --------------
[State 21, At the Point to move random]
type = Varset
triggerAll = var(14) != 1 && time
trigger1 = var(14) != 11
trigger1 = (P2Bodydist x = [250,330])
trigger1 = Random < 15
var(14) = 1

[State 21, Conditions for Move Forward]
type = varset
triggerall = var(14) != 2 && frontedgebodydist > 20
trigger1 = BackEdgeBodyDist <= 20 && (!inguarddist)
trigger2 = enemynear(var(59)),movetype !=A && enemynear(var(59)),statetype !=L
trigger3 = NumTarget && (!inguarddist)
trigger3 = Target,StateType != L
trigger3 = Target,Pos x - Pos x > 70-35*(enemynear(var(59)),movetype = H || !enemynear(var(59)),ctrl)
trigger4 = facing = enemynear(var(59)),facing || (var(30)=750||var(31)=750)
trigger4 = p2bodydist x > 25
trigger5 = cond(enemynear(var(59)),statetype !=A,numexplod(750750),1) && p2bodydist x > 25
var(14) = 2

[State 21, Conditions for Move Backward]
type = varset
triggerall = var(14) != 3 && (!numexplod(750750) || frontedgebodydist < 20)
trigger1 = !NumTarget && BackEdgeBodyDist > 100
trigger1 = P2StateNo = 5120
trigger1 = random < 30
trigger2 = !NumTarget && P2MoveType != H && (enemynear(var(59)),movetype = A) && facing != enemynear(var(59)),facing
trigger2 = P2BodyDist x < 130 
trigger3 = numtarget && p2bodydist x <= 0
var(14) = 3

[State 21, Conditions for force Stay all the time]
type = varset
triggerall = var(14) != 11 && !numexplod(750750)
trigger1 = frontedgebodydist < 35 || P2Bodydist x = [0,15]
trigger2 = P2Bodydist x > 100 && (enemynear(var(59)),statetype = L||enemynear(var(59)),movetype = I)
trigger2 = Random < 50+66*(power < 1000)
trigger3 = inguarddist 
var(14) = 11

;---------- Apply to animation and vel -----------
[State 21, Move Forward]
type = VelSet
trigger1 = var(14) = 2
trigger2 = Var(14) = 1 && Var(15) >= 30
x = const(velocity.walk.fwd.x)

[State 21, Move Backward]
type = VelSet
trigger1 = var(14) = 3
trigger2 = Var(14) = 1 && Var(15) < 30
x = const(velocity.walk.back.x)

[State 21, Stay]
type = VelSet
triggerall = vel x
trigger1 = var(14)= 11
trigger2 = (Anim = [10,12])
x = 0

[State 20, ‰??р?В?з??]
type = PlaySnd
triggerall = anim = 20
trigger1 = animelem = 4
value = s1,2

[State 20, ‰??р?В?з??]
type = PlaySnd
triggerall = anim = 20
trigger1 = animelem = 11
value = s1,3

[State 20, ‰??р?В?з??]
type = PlaySnd
triggerall = anim = 21
trigger1 = animelem = 3
value = s1,2

[State 20, ‰??р?В?з??]
type = PlaySnd
triggerall = anim = 21
trigger1 = animelem = 9
value = s1,3

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0.0
trigger1 = Anim != 20+var(49) && Anim != 5+var(49)
trigger2 = Anim = 5+var(49) && AnimTime = 0
value = 20+var(49)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0.0
trigger1 = Anim != 21+var(49) && Anim != 5+var(49)
trigger2 = Anim = 5+var(49) && AnimTime = 0
value = 21+var(49)

[State 21, Stay]
type = ChangeAnim
triggerall = vel x = 0.0
trigger1 = !(Anim = 0+var(49)) && Anim != 5+var(49)
trigger2 = Anim = 5+var(49) && AnimTime = 0
value = 0

[State 21, Exit to 0 General]
type = SelfState
trigger1 = P2bodyDist x < 15 || P2Bodydist X <= -40
trigger2 = 0;InGuardDist && facing != enemynear(var(59)),facing
trigger3 = roundstate != 2
trigger4 = (BackEdgeBodyDist <= 30)
trigger4 = Vel x <= 0.0
trigger4 = Random < 88
value = 0
ctrl = 1

[State 21, dead]
type = changestate
trigger1 = !life
value = 5050
