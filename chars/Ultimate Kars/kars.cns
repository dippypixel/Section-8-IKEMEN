ignorehitpause = 1
TriggerAll = ishelper&&roundstate = 2&& enemynear(root,var(59)), stateno > 199 && (cond(enemynear(root,var(59)),stateno >= 1000,1,(enemynear(root,var(59)), prevstateno = [0,199])))
trigger1 = root,AIlevel
trigger1 = enemy,teammode=Single ||enemy,teammode=Turns
