[state  0]
type = null
trigger1 = root, movetype != h
trigger1 = var(21) := root,stateno
 
[state  1] 
type = explod
trigger1 = var(21) != 0 
trigger1 = PlayerIDExist(var(3))
trigger1 = cond(playerid(var(3)),prevstateno = 0, var(2) := abs(floor(playerid(var(3)),vel x)), 1)
