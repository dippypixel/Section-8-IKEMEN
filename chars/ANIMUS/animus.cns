; Win pose 3 - lanza mina
[Statedef 183]
type = S
ctrl = 0
velset = 0,0
anim = 0

[State 0, ChangeState]
type = ChangeState
trigger1 = enemynear, alive
trigger2 = var(11)=1; si el enemigo es final
trigger3 = enemynear, name = "noroko" && enemynear, anim = 3175
value = cond(random<500,181,182)
ctrl = 0

;cambia si nunca puede llegar al enemigo en team mode
[State 0, ChangeState]
type = ChangeState
trigger1 = time >= 110 && anim = 20
value = 182
ctrl = 0

[State 181, a]
type = AssertSpecial
trigger1 = time < 250
flag = RoundNotOver

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !time && facing = -1 && Pos X < fvar(17)
trigger2 = !time && facing = 1 && Pos X > fvar(17)
value = 5

[State 0, Turn]
type = Turn
trigger1 = anim = 5 && animelem = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !time && anim != 5
trigger2 = anim = 5 && animtime = 0
value = 20

[State 0, VelSet]
type = VelSet
trigger1 = anim = 20 && animelem = 1
x = 3

[State -3, Landing Sound]
type = PlaySnd
trigger1 = anim = 20 && animelem = 3
value = 40, 0
freqmul = 0.9+(random/3333.3)
volume = -100

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 20
trigger1 = cond(facing = 1,Pos X >= fvar(17)-20, Pos X <= fvar(17)+20)
value = 910

[State 0, VelSet]
type = VelSet
trigger1 = anim = 910
x = 0

