;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]


;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
trigger3 = stateno = 641 ;Jp hk land
value = 40, 0
freqmul = 0.8+(random/3333.3)
volume = 50

[State 0, PlaySnd]
type = PlaySnd
triggerall = time=1
trigger1 = stateno = 50
trigger2 = stateno = 105
value = 0,cond(random<500,1,2)
volume = -100
freqmul = 0.8+(random/6666.6)

;mina turn backup
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = numhelper(4666)=1
trigger1 = anim = 5
value = 6205

;Survival winscreen partner
;------------------
[State 0, ChangeState]
type = ChangeState
triggerall = numpartner
trigger1 = partner,stateno=18000 && stateno !=18000 && stateno !=18001
value = 18001

;Survival winscreen enemigo
[State 0, ChangeState]
type = ChangeState
triggerall = numenemy
trigger1 = enemynear,stateno=18000 && stateno !=18002
value = 18002

;sangre constante
[State 0, Helper]
type = Helper
trigger1 = life <= 250 && random < 10
trigger1 = roundstate = 2 && movetype != H && alive = 1
trigger1 = stateno != 3100 && stateno != 3110 && stateno != 3180 && stateno != 3149 && stateno != 3150 && stateno != 3310
name = "sangre constante"
ID = 6100
stateno = 6100
pos = ceil(-8+(random/60)), ceil(cond(statetype != c,-40,-20)-(cond(statetype != c,(random/14),(random/25))))
facing = cond(random<500,1,-1)
ownpal = 1

;para apagar palfx de intro 1
[State 0, PalFX]
type = PalFX
trigger1 = stateno = 0 && prevstateno = 192
time = 1
add = 0,0,0

;se cancela afterimage si es golpeado
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = movetype = h
time = 0

;dark force
;----------

;DF cancela DF
[State -3, cancela]
type = ChangeState
triggerall = var(10) >0 && power > 0 && life !=0
triggerall = statetype !=A && (ctrl || (stateno=[200,440]) && time <3)
triggerall = command = "darkforce"
trigger1 = var(24) = 0
trigger2 = var(24) = 3
trigger3 = var(24) = 1 && power <=1000
trigger4 = var(24) = 2 && power <=1000
trigger2 = var(24) = 4
value = 3520
ctrl = 0

;DF apaga
[State 0, ChangeState]
type = ChangeState
triggerall = ctrl && statetype !=A
trigger1 = var(10) > 0 && power = 0
trigger2 = var(10) > 0 && roundstate !=2
value = 3520
ctrl = 0

;dark force cambios
[State 0, changestate]
type = changestate
triggerall = var(10)!=0 && stateno != 3510
triggerall = stateno != 5110 && stateno != 5120
trigger1 = var(10)!=1
trigger1 = life >=750
trigger2 = var(10)!=2
trigger2 = life >=500
trigger2 = life <750
trigger3 = var(10)!=3
trigger3 = life >=250
trigger3 = life <500
trigger4 = var(10)!=4
trigger4 = life <250
value = 3510

;DF
;baja el poder mientras esta en DF si es golpeado
[State -3, PowerAdd]
type = PowerAdd
triggerall = var(10) > 0
trigger1 = movetype = H && !time
value = -60


