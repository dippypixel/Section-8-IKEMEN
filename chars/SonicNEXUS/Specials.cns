trigger1 = Animelem = 8
value = 1, 5

[State 2000, Swing Snd]
type = PlaySnd
trigger1 = Animelem = 9
value = 1, 11
channel = 1

[State 2000, StateTypeSet: Air, No Phys]
type = StateTypeSet
trigger1 = AnimElem = 9
stateType = A
physics = N

[State 2000, Muteki]
type = Nothitby
trigger1 = AnimElemTime(9) < 0
time = 1
value = SCA

[State 2000, PosAdd]
type = PosAdd
trigger1 = !Time
x = 18

[State 2000, Rising Velocity]
type = VelSet
trigger1 = AnimElemTime(9) = 0
x = ifelse(var(10)=2,7, ifelse(var(10)=1, 5, 3))
y = ifelse(var(10)=2,-10.5, ifelse(var(10)=1, -8.5, -6.5))

[State 2000, VelStop]
type = VelSet
trigger1 = AnimElem = 24
x = 0

[State 2000, Gravity/Friction]
type = VelAdd
trigger1 = AnimElemTime(9) > 0
x = ifElse(Vel X <= 0, 0, -.25)
y = .5

[State 2000, Jump Snd]
type = PlaySnd
trigger1 = AnimElem = 9
value = 40,0
channel = 2

[State 2000, Dust Helper]
type = Helper
trigger1 = AnimElem = 9
helperType = Normal
stateNo = 8100
ID = 8100
name = "Jump Dust"
posType = P1
ownPal = 1

[State 2000, FX]
type = Explod
trigger1 = AnimElem = 9
anim = 2001
ID = 2001
postype = p1
pos = -10,-40
bindtime = -1
sprpriority = 5
ownpal = 1
removeongethit = 1
ignorehitpause = 0
persistent = 0
ontop = 0
scale = .5,.5

[State 2000, Hit]
type = HitDef
trigger1 = !var(16) && var(15) < 8
trigger1 = !Time
attr = A, SA
damage = ceil(ifElse(fvar(11) * ifElse(var(10) = 2, 100, ifElse(var(10), 90, 80)) < 7, 7, fvar(11) * ifElse(var(10) = 2, 100, ifElse(var(10), 90, 80)))), 7
priority = 4, hit
animtype = Hard
getpower = 50 * !var(20), 30 * !var(20)
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,5
guardsound = S130,0
pausetime = 12,12
guard.pausetime = 12,12
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 25), var(36) := -75
air.animtype = Back
fall.animtype = Back
ground.type = High
air.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -3, -9
air.velocity = -3, -9
guard.velocity = -5.5
airguard.velocity = -5.5, -5.5
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .5
fall = 1
fall.recover = 0
forcestand = 0
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 14
envshake.ampl = 4
envShake.freq = 120

