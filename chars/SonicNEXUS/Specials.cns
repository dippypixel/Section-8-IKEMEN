;Sonic Wind
[StateDef 1000]
type = S
physics = S
moveType = A
anim = 1000
ctrl = 0
velset = 0,0
sprPriority = 1
poweradd = 84 * !var(20)
faceP2 = 1

[State 1000, Button Detect]
type = VarSet
trigger1 = !Time
var(10)  = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))

[State 0, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || PrevStateNo = 750 || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 1000, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 0,8
channel = 0

[State 1000, snd]
type = PlaySnd
trigger1 = AnimElem = 6
value = 1, 11
channel = 2

[State 1000, Width]
type = Width
trigger1 = AnimElemTime(6) < 0
player = 35,0

[State 1000, Projectile]
type = Helper
trigger1 = AnimElem = 6
helperType = Normal
stateNo = 2010
ID = 2010
name = "Sonic Wind"
posType = P1
size.xScale = 1
size.yScale = 1
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1

;---------------------------------------------------------------------------

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 3000, power >= 0)
trigger1 = Command = "Super Sonic Burst"
trigger1 = AnimElemTime(6) >= 0 && AnimElemTime(13) < 0
value = 3100

;---------------------------------------------------------------------------

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 2000, power >= 0)
