[Statedef -1]

;===========================================================================
[State -1, AI Guard]
Type = ChangeState
Value = 120
triggerall = Var(15) ;&& StateType != A
triggerall = ctrl || stateno = 195
triggerall = !(enemynear,hitdefattr=SCA,AT) && inguarddist
triggerall = (stateno!=[120,155])
trigger1 = (Var(15)**3)*2*0.9 > random && RoundState = 2

[State -1, AI Jump]
type = ChangeState
value = 40
triggerall = statetype != A
triggerall = ctrl
trigger1 = Var(15) && (Var(15)**3)*2*0.4 > random && RoundState = 2
trigger1 = EnemyNear,StateType = A && EnemyNear,MoveType != H

[State -1, AI Jump Dir]
type = VarSet
trigger1 = Var(15) && Stateno = 40
sysvar(1) = ifelse(P2BodyDist X > 24,1,0)

;===========================================================================
;---------------------------------------------------------------------------
; Super
[State -1, Super]
type = ChangeState
value = 2000
triggerall = Power >= 1000
triggerall = statetype != A
triggerall = ctrl || (StateNo = [200,600)); && MoveContact
trigger1 = command = "Super" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger2 = (StateNo = [200,600)) && MoveHit && P2BodyDist X + EnemyNear,Vel X < 56 && EnemyNear,StateType != A
trigger3 = Var(15) && (Var(15)**3)*2*0.5 > random && RoundState = 2
trigger3 = (P2BodyDist X + EnemyNear,Vel X = [8,56]) && EnemyNear,StateType != A && EnemyNear,MoveType = A && EnemyNear,StateNo < 2000

;---------------------------------------------------------------------------
; Fireball
[State -1, Fireball]
type = ChangeState
value = 1100
triggerall = statetype != A
triggerall = NumProjId(1000) <= 0
triggerall = ctrl || (StateNo = [200,600)); && MoveContact
trigger1 = command = "QCF_c" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger2 = (StateNo = [200,600)) && MoveHit

;---------------------------------------------------------------------------
; Tornado
[State -1, Tornado]
type = ChangeState
value = 1000
triggerall = statetype != A
triggerall = NumProjId(1000) <= 0
triggerall = ctrl || (StateNo = [200,600)); && MoveContact
trigger1 = command = "QCF_b" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger2 = P2BodyDist X > 64 && P2MoveType = A && Abs(P2Dist Y) < 48 && EnemyNear, Vel Y >= 0
trigger3 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger3 = (StateNo = [200,600)) && MoveGuarded
trigger4 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger4 = PrevStateNo = 1100 && EnemyNear,MoveType = H

;---------------------------------------------------------------------------
[State -1, Throw]
type = ChangeState
value = 800
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != 100
triggerall = p2stateno != [40,52]
triggerall = p2bodydist X <= 20 && p2movetype != H
triggerall = p2statetype = S || p2statetype = C
trigger1 = (command = "holdfwd" || command = "holdback") && command = "b" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger2 = Enemy,PrevStateNo != 5120 && Enemy,StateNo < 5000

;---------------------------------------------------------------------------
; Stand P
[State -1, Stand P]
type = ChangeState
value = 200
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "b" && command != "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.7 > random && RoundState = 2
trigger2 = ctrl && (P2BodyDist X + EnemyNear,Vel X = [8,32]) && Abs(P2Dist Y) < 32 && P2StateNo < 5100
trigger3 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger3 = P2BodyDist X + EnemyNear,Vel X <= 32 && P2MoveType = H && P2StateNo < 5100

;---------------------------------------------------------------------------
; Stand K
[State -1, Stand K]
type = ChangeState
value = 300
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "c" && command != "holddown" && !Var(15)

;---------------------------------------------------------------------------
; Crouch P
[State -1, Crouch P]
type = ChangeState
value = 400
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "b" && command = "holddown" && !Var(15)

;---------------------------------------------------------------------------
; Crouch K
[State -1, Crouch K]
type = ChangeState
value = 500
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "c" && command = "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.7 > random && RoundState = 2
trigger2 = ctrl && P2BodyDist X < 28 && P2StateType = S && P2StateNo < 5000

;---------------------------------------------------------------------------
; Air P
[State -1, Air P]
type = ChangeState
value = 600
triggerall = statetype = A
triggerall = ctrl
trigger1 = command = "b" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.7 > random && RoundState = 2
trigger2 = Abs(P2BodyDist X) + Abs(P2Dist Y) < 96

;---------------------------------------------------------------------------
; Air K
[State -1, Air K]
type = ChangeState
value = 700
triggerall = statetype = A
triggerall = ctrl
trigger1 = command = "c" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.7 > random && RoundState = 2
trigger2 = Abs(P2BodyDist X) + Abs(P2Dist Y) < 96

;---------------------------------------------------------------------------
;Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "start" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.1 > random && RoundState = 3
trigger2 = PrevStateNo != 195