triggerall = !numexplod(930000) ;cooldown timer
trigger1=roundstate=2 && partner,alive && partner,movetype!=H
trigger1=command = "c" && (partner,stateno != [3000,3900])
trigger1=partner,stateno != 810
value = 930000
