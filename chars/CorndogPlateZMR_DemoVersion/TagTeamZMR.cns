triggerall = alive
trigger1 = time%20=0
value = 1

[State 4512, turn] ; always face the same direction as partner
type = turn
trigger1 = facing != partner,facing

[State Switch]
type = ChangeState
triggerall = numpartner
trigger1=partner,stateno = 910000 && roundstate = 2
trigger2=winko&&enemynear,stateno=5150
trigger3=partner,stateno = 5150
trigger4=partner,stateno=920001 ;Failsave
trigger5=losetime||wintime
trigger6=drawgame
value = 900000

