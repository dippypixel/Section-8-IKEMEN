movetype= A
physics = A
juggle  = 2
poweradd = 0 ;every character should get the same amount of power for normals. don't change this if you are making a character for ZMR
ctrl = 0   ;Var(4) tracks aerial raves and sets the power to 0 during air combos out of launcher. keep this intact
anim = 600
sprpriority = 0

[State Corndog Visual Helper]
type = Helper
trigger1 = animelem=2
helpertype = Normal ;Player
name = "Corndog"
ID = 600
stateno = 601
pos = 0,0
postype = P1
ownpal = 1

[State HitSpark]
type=null
;
;Spark X
trigger1=1||var(41):=0
;
;Spark Y
trigger1=1||var(42):=-58
;
;Spark Type
trigger1=1||var(43):=0
ignorehitpause=1

[State Whiff SFX]
type = PlaySnd
trigger1 = Time = 0
value = s2,0

[State 600, 2]
type = HitDef
trigger1 = !time
attr = A, NA
damage    = 30
animtype  = light
guardflag = HA
priority = 3, Hit
pausetime = 7,8
sparkno = -1
guard.sparkno=-1
sparkxy = -10,-58
hitsound = s1,0         
guardsound = s1,8            
ground.type = High
ground.slidetime = 7
ground.hittime  = 17
guard.ctrltime = 17
ground.velocity = -4
air.velocity = -1.3,ifelse(var(4)=1,-1,-3)
getpower = ifelse(var(4)=1,0,30)
air.fall = 1
fall.recover = ifelse(var(4)=1,0,1)
fall.recovertime = 45

;Parry Tracker Counter Fix.
;its REALLY important to keep these in all air normal states otherwise counter text will be broken
[State -2, Counter FX]
type = Helper
triggerall = NumEnemy 
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
triggerall = var(10)=1 ;Var(10) keeps track of Air Parries so that counter text doesn't get bugged.
triggerall = enemynear,movetype=H
triggerall = numhelper(8290)=0
trigger1 = MoveHit = 1
helperType = Normal
stateNo = 8290
ID = 8290
name = "Counter FX"
postype = P1
pos = 0,0
ownPal = 1
sprpriority = 9999
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1

