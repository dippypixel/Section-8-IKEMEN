;---------------------------------------------------------------------------------
;How Universal Launcher Works:

;In ZMR, everyone has a universal launcher
;they start up pretty fast but have some ending lag that can be punished 
;theres a small window to input a launcher jump after hit (Forward, Down, Up)
;and when successful will allow you to do air normal chains with no damage dampening
;this is known as an Aerial Rave in ZMR, which cost half a bar of meter to preform
;and during aerial rave state, air normals do not give any power on whiff or hit.
;if you have a combo 10 hits or higher you can't cancel into launcher
;---------------------------------------------------------------------------------

[State HitSpark]
type=null
;
;Spark X
trigger1=1||var(41):=0
;
;Spark Y
trigger1=1||var(42):=-55
;
;Spark Type
trigger1=1||var(43):=2
ignorehitpause=1

[State Whiff SFX]
type = PlaySnd
trigger1 = Animelem = 1
value = s2,3

[State 410, 2]
type = HitDef
trigger1 = !time 
attr = C, NA
damage    = 45
animtype  = Heavy
priority = 5, Hit
hitflag = MAF
guardflag = L
pausetime = 12,12
sparkno = -1
guard.sparkno=-1
sparkxy = -10,-55
hitsound   = s1,2
guardsound = s1,8
ground.type = Low
ground.slidetime = 12
ground.hittime  = 15
guard.ctrltime = 15
guard.hittime = 15
ground.velocity = -2,-8
air.velocity = -2,-6
guard.velocity = -6
guard.slidetime = 12
fall = 1
fall.recovertime = 45
ID = 420
NoChainID = 420
getpower = 0
envshake.time = 7
envshake.ampl = -6
envshake.freq = 110

[State EnvColor]
type = EnvColor
trigger1 = movehit
value = 255,255,255
time = 1
under = 1
persistent = 0
ignorehitpause = 1

[State Launcher Setup] ;Important
type = ChangeState
triggerall = movecontact=1 && roundstate = 2
triggerall = power > 499 && var(4)=0
;triggerall = enemynear,gethitvar(hitcount)<=9
trigger1 = command = "LauncherJump"&&(!var(59)||(var(59)&&var(50)=1))
value = 40

[State 410, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1
