sparkxy = -10,-40
hitsound   = s1,2
guardsound = s1,8
animtype = Heavy
ground.type = High
ground.slidetime = 15
ground.hittime  = 15
guard.ctrltime = 15
ground.velocity = -5
air.velocity = ifelse(var(4)=1,-12,-5),ifelse(var(4)=1,5,-4)
getpower = ifelse(var(4)=1,0,70)
air.fall = 1
fall.recover = ifelse(var(4)=1,0,1)
fall.recovertime = 45
envshake.time = ifelse(var(4)=1,20,7)
envshake.ampl = ifelse(var(4)=1,-9,-6)
envshake.freq = 110
ID = 620

[State HARD KNOCKDOWN] ;this trigger sends the opponent into a hard knockdown during aerial raves, which opens them up to OKI.
type = TargetState     ;OKI being the act of attacking the opponent right as they get up. 
triggerall = var(4)=1
triggerall = NumTarget
triggerall = !target,ishelper
trigger1 = movehit
value = 50501
ID = 620
ignorehitpause = 0
persistent = 0

