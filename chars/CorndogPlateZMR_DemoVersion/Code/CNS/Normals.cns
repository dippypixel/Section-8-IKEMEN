;---------------------------------------------------------------------------
;Kung Fu Throw - Attempt
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2

[State NO SPARK]
type=null
trigger1=1||var(43):=-1 ;this sets the variable to -1 so no spark shows up during a throw, removing this bugs out sparks if they are in this stateno
ignorehitpause=1        ;resulting it in displaying the last hitspark that showed up on your last hit before throw instead to compensate. keep this here
 
[State 800, 1]
type = HitDef
Trigger1 = Time = 0
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
p1facing = ifelse(command = "holdfwd", 1, -1)
p2facing = 1          ;Force p2 to face KFM
p1stateno = 810       ;On success, KFM changes to state 810
p2stateno = 820       ;If hit, p2 changes to state 820 in KFM's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down
fall.recover = 0

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
;Kung Fu Throw - Throwing the opponent
; Description: In this state, KFM throws the opponent by binding him to
;     various offsets based on his current frame of animation. For
;     example, [State 810, Bind 1] binds the opponent to an offset of
;     28 pixels in front of KFM. That puts him around where KFM's hand
;     is at. Is is important to keep the opponent bound using a
;     TargetBind controller at all times, until you let him go. This
;     is especially important if your player has a Clsn2 box that
;     allows him to get hit while throwing someone. Each time a player
;     gets hit, all his bound targets will be set to a fall state. If
;     the opponent is not bound, then he may get stuck in his thrown
;     state when his attacker is knocked out of the throw halfway.
; Notes: There is a TargetLifeAdd controller to decrease the opponent's
;     life, and a TargetState controller to change his state to a
;     falling state when KFM lets go of him.
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
poweradd = 0
sprpriority = -5

[State Throw Tech] ;this ensures that the other player has a chance to escape your grab if they happen to preform grab as well as you're grabbing them
type = changestate
triggerall = var(21)=1
triggerall = numtarget
trigger1 = time = [1,4]
trigger1 = target,command = "holdfwd" || target,command = "holdback"
trigger1 = target,command = "z"
value = 811

; Here a variable, var(8), is used to remember whether or not the
; player was holding forward at the start of the state. This variable
; is checked later on to turn KFM around if necessary.
[State 810, Holding fwd?]
type = VarSet
triggerall=!var(59)||(var(59)&&var(50)=1)
trigger1 = Time = 0
var(8) = command = "holdback"

;AI Versions
[State AI: Holding fwd?]
type = VarSet
triggerall=var(59)
triggerall=var(50)>=6
trigger1 = Time = 0
var(8) = (backedgebodydist<=40)

[State AI: Holding fwd?]
type = VarSet
triggerall=var(59)
triggerall=var(50)<6
trigger1 = Time = 0
var(8) = random%2
;--------------------------------------------------------------------------------
[State 810, Grab Sound]
type = PlaySnd
trigger1 = AnimElem = 1
value = s1,9

[State 810, Throw Sound]
type = PlaySnd
trigger1 = AnimElem = 7
value = s2,3

[State Voice Clip]
type = PlaySnd
trigger1 = AnimElem = 5
value = s100,0
channel = 0

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(1)>=0&&animelemtime(2)<=0
pos = 28, 0

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(2)>=0&& AnimElemTime(20)<0
pos = 5, 0

[State 810, Width 2-11]
type = Width
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(21) < 0
edge = 40,0

[State 810, holdfwd - Turn 6] ;If was holding fwd before, turn now
type = Turn
trigger1 = var(8)
trigger1 = AnimElem = 1

[State 810, holdfwd - Turn Target 6] ;If was holding fwd before, turn target too
type = TargetFacing
trigger1 = var(8)
trigger1 = AnimElem = 1
value = -1

[State 0, EnvShake]
type = EnvShake
triggerall = time%5=0
trigger1 = animelemtime(2)>=0
time = 14
freq = 130
ampl = -3

[State HitSpark]
type=null
;
;Spark X
trigger1=1||var(41):=0
;
;Spark Y
trigger1=1||var(42):=0
;
;Spark Type
;
;0=Normal Light
;1=Normal Medium
;2=Normal Hard
;10=Slash Light
;11=Slash Medium
;12=Slash Hard
;
trigger1=1||var(43):=2
ignorehitpause=1

