;---------------------------------------------------------------------------
; Stand Light
[Statedef 200]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 2                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 200                       ;Change animation (Def: no change)
poweradd = 0 ;every character should get the same amount of power for normals. don't change this if you are making a character for ZMR
sprpriority = 0                  ;Set p1's sprite layering priority to 2 (in front)

[State Movement Tracker]
type = VarSet
trigger1 = 1
v = 11   
value = 0
ignorehitpause = 1

[State Corndog Visual Helper]
type = Helper
trigger1 = animelem=1
helpertype = Normal ;Player
name = "Corndog"
ID = 200
stateno = 201
pos = 0,0
postype = P1
ownpal = 1

[State 0, Offset]
type = Offset
trigger1 = time >= 0
y = -sin((gametime-(pi/180))*0.09)*1.2
ignorehitpause = 1

[State HitSpark]
type=null
;
;Spark X
trigger1=1||var(41):=0
;
;Spark Y
trigger1=1||var(42):=-56
;
;Spark Type
;
;0=Normal Light
;1=Normal Medium
;2=Normal Hard
;10=Slash Light
;11=Slash Medium
;12=Slash Hard
;
trigger1=1||var(43):=0
ignorehitpause=1

[State Hitdef]
type = HitDef
trigger1 = !time
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 30, 0                   ;Damage that move inflicts, guard damage
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 8, 8                 ;Time attacker pauses, time opponent shakes
sparkno = -1                      ;Spark anim no (Def: set above)
guard.sparkno=-1
sparkxy = -10, -76               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = s1, 0                  ;Sound to play on hit
guardsound = s1, 8                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 12             ;Time opponent is in hit state
guard.ctrltime = 12
guard.hittime = 12
ground.velocity = -4             ;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.4,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 12                 ;Time before opponent regains control in air
air.fall = 1
fall.recovertime = 45

[State Whiff SFX]
type = PlaySnd
trigger1 = Time = 1
value = s2, 0

[State 200, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;----------------------------------------------------------------------------------------
;Corndog Visual Helper
[Statedef 201]
type    = U                    
movetype= I                     
physics = N                    
juggle  = 0                                     
ctrl = 0
poweradd = 0    
velset = 15,0  
anim = 201   
sprpriority = 5

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = animelemtime(2)>=0
flag = noshadow
ignorehitpause = 1

[State Spear Throw]
type = PlaySnd
trigger1 = !time
value = S0,15
channel = 1

[State Spear Throw]
type = PlaySnd
triggerall = parent,stateno!=3000
triggerall = random < 500
trigger1 = !time
value = S100,6+random%3
channel = 0

[State 2120]
type = VelMul
trigger1 = 1
x = .68

[State 1203]
type=NotHitBy
trigger1=time>=0
value=SCA

[State 1203]
type=destroyself
trigger1 = animtime = 0
trigger2 = parent,movetype =H

