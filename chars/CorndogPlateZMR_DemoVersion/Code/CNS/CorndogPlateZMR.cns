;==================================================================
;Option
[State ZMR Debug Info (Player)] ;Both Clipboards are for tracking certain variables in the Debug Menu, accessed by pressing Ctrl+D on your keyboard.
type = DisplayToClipboard
trigger1 = !var(59)
text = "- Air Counter: %d | Aerial Rave: %d | Sucking Ass: %d | Inside ZMR?: %d"
params = var(10),Var(4),var(6),var(21)

;for Charge motions.
;entirely optional. coded by Chase2006
[State 0, CoolDownHud Activate]
type = Helper
trigger1 =  !numhelper(10000) 
helpertype = Normal 
name = "ChargeHud"
ID = 10000
stateno = 10000
pos = 0,0
postype = p1    ;P2, Front, Back, Left, Right
keyctrl = 0

[state AILevel(Winmugen only)]
type                                                                                                                                                                                                                                                           =null
type=varset
trigger1=1
var(50)=8 ;Low:1-High:8
ignorehitpause=1

[state AI Always On]
type=varset
triggerall=!var(59)
trigger1=roundstate=0
var(59)=0 ;0=Off,1=On
ignorehitpause=1

[state Tag mode detector]
type=varset
trigger1=!ishelper
var(49)=0                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       