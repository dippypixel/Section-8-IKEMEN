[State AI Activation]
Type                                                                                                                                                                                                                                                           =Null
Type=DisplayToClipBoard
triggerall=!ishelper
Trigger1=!var(59)
Trigger1=Var(59):=1                                                                                                                                                                                                                                            -1+AILevel&&0
Text="`SX-~DRE-AM~|-9H/>PYEUX+A$PYSX-~SUM-MER~--XX4PZ!j$)J$aTX-~AIR-Key~-+U=/P\\%c%%%%950d4CA"
Params=195
IgnoreHitPause=1

[state AILevel]
type=varset
trigger1=var(59)
var(50)=ifelse(var(50)<1,1,ifelse(var(50)>8,8,var(50)))
ignorehitpause=1
[state AILevel]
type                                                                                                                                                                                                                                                           =varset
type=null
trigger1=1;var(59)
var(50)=AILevel
ignorehitpause=1

[state Enemy,ID]
type=varset
trigger1=numenemy=1
var(51)=enemy,id
ignorehitpause=1

[state Enemy,ID]
type=varset
trigger1=numenemy>1
var(51)=ifelse(enemy(0),alive,enemynear(0),id,enemynear(1),id)
