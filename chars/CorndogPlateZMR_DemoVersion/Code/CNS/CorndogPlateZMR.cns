[state Enemy,NumProj]
type=varset
triggerall=roundstate<2
trigger1=numenemy=1
var(57)=playerid(var(51)),numproj
ignorehitpause=1
[state Enemy,NumProj]
type=varset
triggerall=roundstate<2
trigger1=numenemy>1
var(57)=enemy(0),numproj+enemy(1),numproj
ignorehitpause=1

