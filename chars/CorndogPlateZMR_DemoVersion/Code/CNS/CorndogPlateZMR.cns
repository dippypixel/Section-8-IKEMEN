trigger1 = animelemtime(1)=1 
;-------------------------------
;Extras can be added here.

;trigger2 = anim = 40
;trigger2 = animelemtime(1) = 1
;-------------------------------
value = S0,7
persistent = 0

[State Static Noises]
type = PlaySnd
triggerall = movetype = H
trigger1 = anim = 5000 && stateno = 5000
trigger1 = time = 1
trigger2 = anim = 5001 && stateno = 5000 
trigger2 = time = 1
trigger3 = anim = 5010 && stateno = 5000
trigger3 = time = 1
trigger4 = anim = 5011 && stateno = 5000 
trigger4 = time = 1
trigger5 = anim = 5012 && stateno = 5000
trigger5 = time = 1
trigger6 = anim = 5020 && stateno = 5010
trigger6 = time = 1
trigger7 = anim = 5021 && stateno = 5010 
trigger7 = time = 1
trigger8 = anim = 5022 && stateno = 5010
trigger8 = time = 1
trigger9 = anim = 5030 && stateno = 5030
trigger9 = animelemtime(1)=1
value = S5000,2
ignorehitpause = 1
