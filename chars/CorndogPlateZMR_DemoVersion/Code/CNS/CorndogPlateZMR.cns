trigger1 = var(59)
text = "p2x:%d,p2y:%d,prev:%d,jumptype:%d,sj:%d"
params = floor(p2bodydist x),floor(p2bodydist y),var(50),var(52),var(35)
ignorehitpause = 1

[State Taunt]
type = Helper
triggerall = var(59)
triggerall = numhelper(195)=0
triggerall = movetype != H
triggerall = roundstate = [2,3]
trigger1 = roundstate = 3
trigger1 = ctrl || (stateno = [200,810])
trigger2 = (playerid(var(51)),stateno=[5110,5111])&&playerid(var(51)),time=1&&(random<=200||playerid(var(51)),life<=playerid(var(51)),lifemax/7||numprojid(210446))
trigger3 = ((stateno=810&&time=1)||(stateno=420&&movehit=1)||(stateno=620&&movehit=1&&Var(4)=1))&&(random<=300||numprojid(210447))
helperType = Normal
stateNo = 195
ID = 195
name = "Taunt Helper"
postype = P1
pos = 0,0
ownPal = 1
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1
persistent = 0

[state Recover]
