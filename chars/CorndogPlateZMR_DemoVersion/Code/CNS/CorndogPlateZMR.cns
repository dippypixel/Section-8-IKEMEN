;---------------------------------------------------------------------------------------------
;HitSparks

;ZMR Hitsparks are all coded into here for easier access. there is a Null trigger in all attack states
;that keep track of what kind of hitsparks they use and their positions. 

;[State HitSpark]
;type=null
;;
;;Spark X
;trigger1=1||var(41):=0
;;
;;Spark Y
;trigger1=1||var(42):=-76
;;
;;Spark Type
;;
;;0=Normal Light
;;1=Normal Medium
;;2=Normal Hard
;;10=Slash Light
;;11=Slash Medium
;;12=Slash Hard
;;
;trigger1=1||var(43):=0
;ignorehitpause=1

;if you see something like this in attack states, thats what its for. the rest
;you don't need to mess with, just the null trigger in attack states

[State 0, EnvColor]
type = EnvColor
triggerall=stateno=3000
triggerall = animelemtime(6)>=0
triggerall=hitpausetime=var(40)
trigger1=movehit=1
value = 255,255,255
time = 1
ignorehitpause = 1

[state Target,ID]
type=varset
triggerall=var(40)<0
triggerall=numenemy=1
trigger1=roundstate=0
trigger2=numtarget!=1
var(44)=enemynear,id
ignorehitpause=1
[state Target,ID]
type=varset
triggerall=var(40)<0
triggerall=numenemy>1
trigger1=roundstate=0
trigger2=numtarget!=1
var(44)=ifelse(enemynear(0),alive,enemynear(0),id,enemynear(1),id)
ignorehitpause=1
[state Target,ID]
type=varset
triggerall = enemynear,name != "CorndogOfLightV2" || enemynear,name != "PizzaRollOfDarknessV2"
triggerall=var(40)<0
trigger1=movecontact=1
trigger1=numtarget=1
var(44)=target,id
ignorehitpause=1
[state Target,ID]
type=varset
triggerall = enemynear,name != "CorndogOfLightV2" || enemynear,name != "PizzaRollOfDarknessV2"
triggerall=var(40)<0
trigger1=movecontact=1
trigger1=!numtarget
var(44)=-1
ignorehitpause=1
[state HitPause]
type=varset
triggerall=var(40)<0
trigger1=movecontact=1
var(40)=hitpausetime
ignorehitpause=1

[state Disable Spark]
type=varset
triggerall=var(43)>0
trigger1=stateno=0||stateno=10||stateno=20||stateno=40||stateno=50
trigger2=movetype=h
trigger3=roundstate<2
var(43)=-1
ignorehitpause=1

[State HitSpark FX]
type = Helper
triggerall = enemynear,name != "CorndogOfLightV2" || enemynear,name != "PizzaRollOfDarknessV2"
triggerall=playeridexist(var(44))
triggerall=hitpausetime=var(40)
triggerall=var(43)>=0
trigger1 = movehit=1
helpertype = Normal
name = "HitSpark"
ID = 823000
stateno = 823000
pos = (ceil(playerid(var(44)),pos x-pos x)*facing)+var(41),var(42)
postype = P1
ownpal = 1
supermovetime = 99999999
pausemovetime = 99999999
size.shadowoffset=100+var(43)
ignorehitpause = 1

[State HitSpark FX (FOR BOSSES ONLY)]
type = Helper
triggerall = teammode = single || teammode = turns || var(49)=1
triggerall = enemynear,name = "CorndogOfLightV2" || enemynear,name = "PizzaRollOfDarknessV2"
triggerall=hitpausetime=var(40)
triggerall=var(43)>=0
trigger1 = movehit=1
helpertype = Normal
name = "HitSpark"
ID = 823000
stateno = 823000
pos = p2dist x+var(41),var(42)
postype = P1
ownpal = 1
supermovetime = 99999999
pausemovetime = 99999999
size.shadowoffset=100+var(43)
ignorehitpause = 1

[State GuardSpark FX]
type = Helper
triggerall=playeridexist(var(44))
triggerall=hitpausetime=var(40)
triggerall=var(43)>=0
trigger1 = moveguarded=1
helpertype = Normal
name = "GuardSpark"
ID = 823000
stateno = 823001
pos = (ceil(playerid(var(44)),pos x-pos x)*facing)+var(41),var(42)
postype = P1
ownpal = 1
supermovetime = 99999999
pausemovetime = 99999999
size.shadowoffset=100+var(43)
ignorehitpause = 1

;;Projhit or guarded if you needed
;[State HitSpark FX Proj]
;type = Helper
;triggerall=playeridexist(var(44))
;trigger1 = projhit=1 ;projhitXXXX=1
;helpertype = Normal
;name = "HitSpark"
;ID = 823000
;stateno = 823000
