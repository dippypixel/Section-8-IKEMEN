;---------------------- Integer variable list ----------------------

;ZM Universal Variables (KEEP THESE WHEN DESIGNING CHARACTER FOR ZMR.)
;Var(0) - KO Messages / Hyper Combo Finish
;Var(1) - Pause Menu Detector
;Var(2) - Pause Menu Cursor
;Var(3) - Universal Damage Dampener
;Var(4) - Launcher Detector
;Var(5) - Command List Cursor
;Var(6) - Health Tracker (For First Attack Text)
;Var(7) - Counter Tracker (For Counter Text
;Var(8) - Throw Facing
;Var(9) - Projectile Type
;Var(10) - Air Parry Punish Tracker
;Var(11) - Movement Tracker
;Var(12) - Corndog Spear Hitcounter
;Var(21) - Character Detector
;Var(22) - White Parry Checker

;Hitspark Variables
;var(40)=HitPauseTime
;var(41)=Spark X
;var(42)=Spark Y
;var(43)=Spark Type(-1 or lower=Guard FX,0 or higher=Hit FX)
;var(44)=Enemy,ID

;Channels
;Channel 0 - Voice
;Channel 1 - Announcer
;Channels 2 to 4 - Intro

;--------------------------------------------------------
;Stats
;--------------------------------------------------------
[Data]
life = 900             ;Amount of life to start with
attack = 100           ;attack power (more is stronger)
defence = 100          ;defensive power (more is stronger)
power = 1000           ;for hypers, launcher and etc. (1000 by default)
fall.defence_up = 0    ;Unused in ZMR. Percentage to increase defense everytime player is knocked down
liedown.time = 60      ;this is left unused for ZMR, as it uses its own system to keep track of liedown time which is 60 ticks for all characters, the same as here. 
airjuggle = 12         ;Number of points for juggling
sparkno = s823100      ;Default hit spark number for HitDefs
guard.sparkno = s823600;Default guard spark number
KO.echo = 0            ;Always Unused. don't bother lol
volume = 255           ;Volume offset (negative for softer)
;--------------------------------------------------------
;if numbers for both Indexes are lower than 59, for example
;first ones at 39, the numbers 40-59 won't reset during rounds
;being able to be kepted consistent unaffected by the game.
;same applies to Float Index as well. anything beyond the number
;you put in that isn't 59-60 for Int or 39-40 would keep it 
;persistent between rounds
IntPersistIndex = 39
FloatPersistIndex = 7
;--------------------------------------------------------
[Size]
xscale = .8           ;Horizontal scaling factor.
yscale = .8           ;Vertical scaling factor.
ground.back = 30      ;Player width (back, ground)
ground.front = 30     ;Player width (front, ground)
air.back = 30         ;Player width (back, air)
air.front = 30        ;Player width (front, air)
height = 60           ;Height of player (for opponent to jump over)
attack.dist = 75      ;Default attack distance
proj.attack.dist = 75 ;Default attack distance for projectiles
proj.doscale = 0      ;Set to 1 to scale projectiles too
head.pos = 0, -60    ;Approximate position of head
mid.pos = 0, -60     ;Approximate position of midsection
shadowoffset = 0      ;Number of pixels to vertically offset the shadow
draw.offset = 0,0     ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.8      ;Walk forward
walk.back = -2.6      ;Walk backward
run.fwd  = 6.8, 0     ;Run forward (x, y)
run.back = -6.8,-5.8  ;Hop backward (x, y)
jump.neu = 0,-9.4     ;Neutral jumping velocity (x, y)
jump.back = -3.55     ;Jump back Speed (x, y)
jump.fwd = 3.5        ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 5,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0       ;Unused
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .55          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

; Up to 100 victory quotes can be specified per language (victory0 - victory99)
[Quotes]
victory1 = "*Jazz Music Intensifies*"
victory2 = "*proceeds to listen to Le Lis*"
victory3 = "*http://Corndogoncorndog.com*"
victory4 = "*spins like a beyblade*"
victory5 = "*wonders how to get back to its online domain*"
victory6 = "*listens to Billy Cobham music*"
victory7 = "*turns into a real plate*"
victory8 = "*preforms a sick drum solo*"
victory9 = "*rolls away*"
victory10 = "*goes back to The Useless Web*"
victory11 = "Dev Note: the plate doesn't talk you dumbass lol"
victory12 = "*wants to tell the player to go to Corndogoncorndog.com, but can't speak*"
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S100,15
channel = 0

[State 0, Offset]
type = Offset
trigger1 = 1
y = -sin((gametime-(pi/180))*0.09)*1.2
ignorehitpause = 1

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191+random%3

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1] ;Win Poses are added here. KFM only has one but you can have as many as you want (3 is preferred in ZMR)
type = ChangeState
trigger1 = Time = 0
value = 181+random%3

;---------------------------------------------------------------------------
; Win pose 1 - Teleport
[Statedef 181]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S100,11
channel = 0
[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 155
value = S0,24

[State 0, Offset]
type = Offset
trigger1 = time >= 0
y = -sin((gametime-(pi/180))*0.09)*1.2
ignorehitpause = 1

[State Roundnotover]
type = AssertSpecial
trigger1 = time = [0,230]
flag = roundnotover
flag2 = nomusic

[state ]
type=angledraw
triggerall=!ishelper
trigger1=time > 154
scale=sin((time-(pi/5))*0.0921),1
value=0
ignorehitpause=1
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = time > 171
flag = noshadow
flag2 = invisible
ignorehitpause=1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA

;=========================================
;Announcer Stuff. Keep these in win poses
;if its for ZMR. remove if not
;=========================================
[State YOU WIN (Regular Version)] ;this is flipped upside down, but the code will flip things rightside up as a workaround
type = Explod
triggerall = !var(59)
triggerall = numenemy
triggerall = !numpartner
trigger1 = !time
bindtime = -1
pausemovetime = - 1
removetime = -2
postype = Left
pos = 155,100
anim = 185
id = 185
sprpriority = 23333338
ontop = 1
OwnPal = 1
scale = 0,0
ignorehitpause = 0
supermovetime = 999999999
pausemovetime = 999999999

[State YOU WIN (Regular Version)] 
type = ModifyExplod
triggerall = !var(59)
triggerall = numenemy
triggerall = !numpartner
trigger1 = (time = [0,42])
anim = 185
ID = 185
;pos = 158,75
scale = -0.388-(0.0135*(Time-23)), -0.388-(0.0135*(Time-23))

[State Perfect! (Regular Version)]
type = Explod
triggerall = !var(59)
triggerall = numenemy
triggerall = !numpartner
triggerall = var(6)=0
trigger1 = time = 80
bindtime = -1
pausemovetime = - 1
removetime = -2
postype = Left
pos = 155,140
anim = 186
id = 186
sprpriority = 23333338
ontop = 1
OwnPal = 1
scale = 0.5,0.5
ignorehitpause = 0
supermovetime = 999999999
pausemovetime = 999999999

[State Character Win (Regular Version Boss)]
type = PlaySnd
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name="CorndogOfLightV2"||enemynear,name="PizzaRollOfDarknessV2" 
;-------------------------------------------------
triggerall = !var(59)
triggerall = numenemy
triggerall = !numpartner
trigger1 = !time
value = S9999,20
ignorehitpause = 1
[State Character Win (Regular Version)]
type = PlaySnd
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
triggerall = !var(59)
triggerall = numenemy
triggerall = !numpartner
trigger1 = !time
value = S9999,ifelse(teamside=2,26,24)
ignorehitpause = 1

[State Perfect (Regular Version)]
type = PlaySnd
triggerall = !var(59)
triggerall = var(6)=0
triggerall = numenemy 
triggerall = !numpartner
trigger1= time = 80
value = S9999,22
ignorehitpause = 1
