; HIT_GETUP
[Statedef 5120]
type    = L
movetype= I
physics = N

[State Dodge Getup]
type = ChangeState
triggerall = var(48)=0 ;tagged in
triggerall = prevstateno = 5111 || prevstateno = 5110
triggerall = time = 0 && alive
trigger1 = !var(59)||(var(59)&&(var(50)=1))
trigger1 = command = "holdfwd" || command = "holdback"
trigger2=(var(59)&&(var(50)!=1))
trigger2=backedgebodydist<=10&&(p2bodydist x=[-20,35])
value = 165

[State 5120, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 5120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 5120, 2]
type = VelSet
trigger1 = Time = 0
x = 0

[State 5120, 3]
type = NotHitBy
trigger1 = 1
value = SCA

[State 5120, 4]
type = HitFallSet
trigger1 = AnimTime = 0
value = 1

