triggerall = anim = 41
trigger1 = animelemtime(2)>=0
ignorehitpause = 1

[State 0, AngleAdd]
type = AngleAdd
triggerall = anim = 41
trigger1 = animelemtime(2)>=0
value = -15
ignorehitpause = 1

[State 0, AngleDraw]
type = AngleDraw
triggerall = anim = 42
trigger1 = animelemtime(2)>=0
ignorehitpause = 1

[State 0, AngleAdd]
type = AngleAdd
triggerall = anim = 42
trigger1 = animelemtime(2)>=0
value = -15
ignorehitpause = 1

[State 0, AngleDraw]
type = AngleDraw
triggerall = anim = 43
trigger1 = animelemtime(2)>=0
ignorehitpause = 1

[State 0, AngleAdd]
type = AngleAdd
triggerall = anim = 43
trigger1 = animelemtime(2)>=0
value = 15
ignorehitpause = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

