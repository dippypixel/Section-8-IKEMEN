type = S

[State 0, Offset]
type = Offset
trigger1 = time >= 0
y = -sin((gametime-(pi/180))*0.09)*1.2
ignorehitpause = 1

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0
first = 1
last = 47

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0
first = 1
last = 7

;Insert to Statedef 5900
[State Corndog Orbs Reset] 
type = VarSet
triggerall = roundno = 1
trigger1 = roundsexisted = 0
fvar(8)=0
ignorehitpause=1

[state Reset AILevel]
type=varset
triggerall = roundno = 1
trigger1=var(59)&&teammode=turns
trigger1=enemynear,teammode!=turns
var(50)=0
ignorehitpause=1

[State 5900, 3] ;Intro for round 1
type = ChangeState
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
trigger1 = roundno = 1
value = 190

[State Boss Detected] ;made so intros don't disrupt the bosses introduction for a more cinematic reveal
type = ChangeState
;-------------------------------------------------
;Enabled for Bosses
triggerall = enemynear,name="CorndogOfLightV2"
triggerall = enemynear,name="PizzaRollOfDarknessV2" 
;-------------------------------------------------
trigger1 = roundno = 1
value = 0
