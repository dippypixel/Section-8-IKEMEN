triggerall = anim = 11
trigger1 = animelemtime(1)=1
value = S0,13+random%2

[state ]
type=angledraw
triggerall=name="CorndogPlate_ZMR"
triggerall=2**9!=512
trigger1=statetype=c
value=0
scale=1,1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = prevstateno = [120,155]
value = 11
elem = 5
persistent = 0
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = prevstateno = 160
trigger2 = prevstateno = [400,420]
value = 11
elem = 5
persistent = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

