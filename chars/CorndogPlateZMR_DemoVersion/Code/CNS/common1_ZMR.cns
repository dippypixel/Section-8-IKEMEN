TriggerAll=Statetype = C
Triggerall = var(59)
Trigger1 = playerid(var(51)),StateType=A
Trigger1 = Random <= var(50)*20
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
