trigger1 = animelemtime(3)>=0&&animelemtime(4)<=0
value = 5
ignorehitpause = 1
[State 0, AngleAdd]
type = Angleset
triggerall = anim = 21
trigger1 = animelemtime(4)>=0&&animelemtime(5)<=0
value = 7
ignorehitpause = 1
[State 0, AngleAdd]
