;=================================================
;ZMR Universal Launcher
[State Launcher Set]
type = VarSet
trigger1 = prevstateno = 420
v = 4
value = 1
ignorehitpause = 1
[State 0, ChangeAnim]
type = ChangeAnim
triggerall = prevstateno = 420
trigger1 = anim != 40110
value = 40110
ignorehitpause=1
[State 0, PowerAdd]
type = PowerAdd
triggerall = var(4)=1
trigger1 = animtime = 0
value = -500
ignorehitpause = 1
[State Launcher FX]
type = PalFX
triggerall = var(4) = 1
trigger1 =  animtime = 0 
time = 3
add = 155,155,255
[State Launcher FX]
type = PlaySnd
triggerall = var(4) = 1
trigger1 = animtime = 0 
value = S0,10
[State Launcher Velocity]
type = VelSet
triggerall = var(4)=1
trigger1 = AnimTime = 0
x = const(velocity.jump.fwd.x)*1.5
y = const(velocity.jump.y)*1
[State Launcher Afterimage]
type = AfterImage
triggerall = var(4)=1
trigger1 = Animtime = 0
time = 30
timegap = 1
framegap = 4
length = 12
paladd = 0, 0, 0
palmul = 0.75, 0.75, 0.75
palcontrast = 128, 128, 128
palpostbright = 0, 0, 0
trans = add1
;===================================================
[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = ,NP,SP,HP,NT,ST,HT

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"&&!var(59)
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"&&!var(59)
sysvar(1) = -1

[State 40, 2]
type = VarSet
trigger1 = var(59)
trigger1=var(52)=2||var(52)=5||var(52)=8||var(52)=10
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = var(59)
trigger1=var(52)=3||var(52)=6||var(52)=9;||(var(52)=11&&p2bodydist x<=20)
sysvar(1) = -1

[State 40, 1]
type = VarSet
triggerall=(var(59)&&(var(50)=1))
trigger1 = Time = 0
sysvar(1) = -1+random%3
[State 40, 4]
type = VelSet
triggerall = var(4)=0
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)*ifelse(var(35)=-1,0.65,1)

[State 40, 5]
type = VelSet
triggerall = var(4)=0
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100||var(52)=8||var(52)=10 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
[State 40, 5]
type = VelSet
triggerall = var(4)=0
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100||var(52)=8||var(52)=10 ;RUN_FWD
trigger1 = sysvar(1) = -1
x = -5.7

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[State PAUSED]
type = ChangeState
trigger1 = numhelper(9999)
value = 0
ctrl = 1

