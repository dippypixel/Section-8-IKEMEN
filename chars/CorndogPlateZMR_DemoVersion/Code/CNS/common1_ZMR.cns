value = 0
ignorehitpause = 1
[State 0, AngleAdd]
type = Angleset
triggerall = anim = 100
trigger1 = animelemtime(2)>=0&&animelemtime(3)<=0
value = -1
ignorehitpause = 1
[State 0, AngleAdd]
type = Angleset
triggerall = anim = 100
