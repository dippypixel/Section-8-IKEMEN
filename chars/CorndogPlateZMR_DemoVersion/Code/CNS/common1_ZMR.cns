;------------------
;bounce off wall
; (a custom gethit state)
[Statedef 10280]
type    = A
movetype= H
physics = N

[State 1028, Vel Y]
type = VelSet
trigger1 = Time = 0
y = -6

[State 1028, Vel X]
type = VelSet
trigger1 = Time = 0
x = 1.6

[State 1028, Turn]
type = Turn
trigger1 = (Time = 0) && (BackEdgeDist < 30)

[State 1028, Gravity]
type = VelAdd
trigger1 = var(21)
y = const(movement.yaccel)*0.62+fvar(15)

[State 1028, Gravity]
type = VelAdd
trigger1 = !var(21)
y = const(movement.yaccel)*0.62

[State 1028, Anim 5050] ;Self falling animation
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !SelfAnimExist(5052)
value = 5050

[State 1028, Anim 5052] ;Self falling animation (diagup type)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5052)
value = 5052

[State 1028, Anim 5060] ;Coming down - normal
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5050
trigger1 = SelfAnimExist(5060)
persistent = 0
value = 5060

[State 1028, Anim 5062] ;Coming down - diagup type
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5052
trigger1 = SelfAnimExist(5062)
persistent = 0
value = 5062

[State 1028, Hit ground]
type = SelfState
trigger1 = (Vel y > 0) && (Pos y >= 0)
value = 5100

;--------------------------------------------------------------------------
;State Decider
[Statedef 9980]
type = U
movetype = I
physics = N
anim = 9999
ctrl = 0

[State Normal KO] ;if a player is not in hyper states, then game will use default finish.
type = ChangeState
triggerall=ishelper
triggerall=root,stateno!=3000
triggerall=root,stateno!=3100
triggerall=root,stateno!=3200
trigger1 = time = 10
value = 9981
ignorehitpause=1
[state Hyper KO] ;If a player KO's an opponent with hyper, this trigger will display a hyper message instead
type=changestate
triggerall=ishelper
;triggerall = time >= 10
trigger1=root,stateno=3000
trigger2=root,stateno=3100
trigger3=root,stateno=3200
value=9982
ignorehitpause=1
[State 0, DestroySelf]
type = DestroySelf
triggerall = parent,var(49)=1
trigger1 = roundstate = 4
;--------------------------------------------------------------------------
;Default Finish
[Statedef 9981]
type = U
movetype = I
physics = N
anim = 9999
ctrl = 0

[state ]
type=varset
trigger1=time=0
var(0)=-1
ignorehitpause=1

[state Anim,Sizeset]
type=null
triggerall=ishelper
trigger1=1||var(0):=ifelse((parent,prevstateno = [900000,930000]),9999,310103)
trigger1=1||fvar(0):=1
ignorehitpause=1

[State 0, Explod]
type = Explod
triggerall=var(0)>-1
trigger1 = time=0
anim = var(0)
ID = 310100
pos = 150,130
postype = left
bindtime=-1
removetime=-1
scale = 0,0
ontop = 0
pausemovetime=999999999
supermovetime=999999999
sprpriority = 999999999
ownpal = 1

[state ]
type=modifyexplod
trigger1=numexplod(310100)
id=310100
scale=ifelse(time>=10,1-(time-10)*0.0035,3-time*0.2)*fvar(0),ifelse(time>=10,1-(time-10)*0.0035,3-time*0.2)*fvar(0)
trans=addalpha
alpha=256-ifelse(time>=40,(time-40)*10,0),ifelse(time>=40,(time-40)*10,0)
ignorehitpause=1
[state ]
type=modifyexplod
trigger1=numexplod(310000)
trigger1=time>=40
id=310000
trans=addalpha
alpha=256-(time-40)*10,((time-40)*10)
ignorehitpause=1

[State KO]
type = PlaySnd
triggerall=var(0)=310103
trigger1 = time = 0 && roundstate=3
value = S9999,21
ignorehitpause = 1

;==================================================================================
;Hyper Combo Finish
[Statedef 9982]
type     = A
movetype = I
physics  = N
juggle   = 0
ctrl     = 0
velset=0,0
anim     = 9999
poweradd = 0
sprpriority = 0

[state ]
type=varset
trigger1=time=0
var(0)=-1
ignorehitpause=1

[state Anim,Sizeset]
type=null
triggerall=ishelper
ignorehitpause=1
;----------------------------------------------------------------------------------
;Hyper 1 (Rapid Corndog Combo)

trigger1=root,stateno=3000 ;this sees what hyper state the player is in

trigger1=1||var(0):=310100 ;this variable changes the animation number for messages

trigger1=1||fvar(0):=0.85   ;this changes/sets the size of the messages

;The Rest Follow Suit. everything past this code you don't need to worry much about
;----------------------------------------------------------------------------------
;Hyper 2 (Spinner Frenzy)
trigger2=root,stateno = 3100 || root,stateno = 3301
trigger2=1||var(0):=310101
trigger2=1||fvar(0):=1
;----------------------------------------------------------------------------------
;Hyper 3 (Condiment Cannon)
trigger3=root,stateno = 3200
trigger3=1||var(0):=310102
trigger3=1||fvar(0):=1
;----------------------------------------------------------------------------------

[State KO]
type = PlaySnd
trigger1 = time = 1
value = S9999,17+random%3
ignorehitpause = 1

[state ]
type=playsnd
triggerall=var(0)>-1
trigger1=time=1
value=65535,0
[state ]
type=playsnd
triggerall=var(0)>-1
trigger1=time=1
value=65535,1
[state ]
type=playsnd
triggerall=var(0)>-1
trigger1=time=1
value=65535,2
[state ]
type=playsnd
triggerall=var(0)>-1
trigger1=time=1
value=9000,1
[State 0, StopSnd]
type = StopSnd
trigger1 = !time
channel = -1

[state STAND TIME RESET]
type=parentvarset
triggerall=var(0)>-1
trigger1 = time=0
var(20)=-1
ignorehitpause=1

[State 0, Explod]
type = Explod
triggerall=var(0)>-1
trigger1 = time=0
anim = 310001
ID = 310000
pos = (facing=-1&&(2**9!=512)),0
postype = back
bindtime = -1
removetime = -1
scale = 1,1
ownpal = 0
pausemovetime=999999999
supermovetime=999999999
sprpriority = -54

[State 0, Explod]
