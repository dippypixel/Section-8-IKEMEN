value = -1
ignorehitpause = 1
[State 0, AngleAdd]
type = Angleset
triggerall = anim = 20
trigger1 = animelemtime(2)>=0&&animelemtime(3)<=0
value = -3
ignorehitpause = 1
[State 0, AngleAdd]
type = Angleset
triggerall = anim = 20
trigger1 = animelemtime(3)>=0&&animelemtime(4)<=0
value = -5
ignorehitpause = 1
[State 0, AngleAdd]
