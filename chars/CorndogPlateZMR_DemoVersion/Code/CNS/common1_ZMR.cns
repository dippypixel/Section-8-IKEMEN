; Common state file for Zander's Mugen Remastered
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defence increases at time = 0
; Hit_bounce (5100): defence increases at time = 0, player becomes
;                    invincible if within 10 ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, VelSet]
type = VelSet
trigger1 = prevstateno = 165
x = 0
y = 0

[State Movement Tracker]
type = VarSet
trigger1 = time = 1
v = 11   
value = 0
ignorehitpause = 1
[State Movement Tracker]
type = AngleDraw
trigger1 = 1
value = 1
ignorehitpause = 1
[State Movement Tracker]
type = Angleset
triggerall = var(11) = 1
trigger1 = prevstateno = 20
value = -5
ignorehitpause = 1
[State Movement Tracker]
type = Angleset
triggerall = var(11) = 2
trigger1 = prevstateno = 20
value = 5
ignorehitpause = 1

[State Movement Tracker]
type = Angleset
trigger1 = var(11) = 0
value = 0
ignorehitpause = 1
;--------------------------------------------------------
[State 0, Offset]
type = Offset
trigger1 = time >= 0
y = -sin((gametime-(pi/180))*0.09)*1.2
ignorehitpause = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1

;this code should be in statedef 0 in common1_ZMR.cns
[State 0, Helper]
type = Helper
triggerall = teammode = single && roundno = 1
trigger1 = prevstateno = 191 || prevstateno = 192 || prevstateno = 193 || prevstateno = 194 || prevstateno = 195 
trigger1 = time = 0
trigger1 = !numhelper(50783)
trigger1 = !numexplod(50783)
trigger1 = numenemy < 2 && !numpartner
trigger1 = roundno = 1 && matchno = 1
trigger1 = life = lifemax && powermax
helpertype = normal ;player
name = "Training Mode (Intro skipped)"
ID = 50783
stateno = 50783
pos = 0,9999
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 9999999999

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0
;
;[State 0, 2]
;type = VelSet
;trigger1 = Time = 0
;y = 0
;
;[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
;type = VelSet
;trigger1 = abs(vel x) < 2
;trigger2 = Time = 4
;x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
;Training Mode
[Statedef 50783]
type    = S
movetype= I
physics = N
velset = 0,0
anim = 9999
sprpriority = 4

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 1

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = invisible

[State 0, DestroySelf]
type = DestroySelf
trigger1 = roundsexisted > 0
trigger2 = roundstate != 2
trigger3 = root, prevstateno != 191
trigger3 = root, prevstateno != 192
trigger3 = root, prevstateno != 193
trigger3 = root, prevstateno != 194
;trigger3 = root, prevstateno != 195
;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[state ]
type=angledraw
triggerall=name="CorndogPlate_ZMR"
triggerall=2**9!=512
trigger1=statetype=c
value=0
scale=1,1-time*0.15
[state ]
type=angledraw
triggerall=name="CorndogPlate_ZMR"
triggerall=2**9=512
trigger1=statetype=c
value=0
scale=1,1-time*0.15
ignorehitpause=1

[State 0, AngleAdd]
type = AngleAdd
trigger1 = time >= 1
value = -5

[State 10, 2]
type = ChangeState
trigger1 = time>=2;AnimTime = 0
value = 11

[State PAUSED]
type = ChangeState
trigger1 = numhelper(9999)
value = 0
ctrl = 1
