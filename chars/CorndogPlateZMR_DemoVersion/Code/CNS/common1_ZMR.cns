trigger1 = animelemtime(6)>=0
value = -7
ignorehitpause = 1
[State 0, AngleSet]
type = AngleSet
trigger1 = anim = 101
value = 0
ignorehitpause = 1

[State 41, AfterImage]
type = AfterImage
triggerall = anim = 100
;------------------------------------------------------------------------------------------------------------------------------------------------------
trigger1 = animelemtime(2)=0 ;the reason this is animelem 2 insteaad of 1 is mainly because running takes 5 frames to start up to pervent any infinites
;------------------------------------------------------------------------------------------------------------------------------------------------------
Time = 8
palbright = 40,40,40
palpostbright = 70,70,70
palcontrast = 100,100,100
paladd = -30,-30,-30
palmul = .8,.8,.8
Trans = Add1
TimeGap  = 2
FrameGap = 1
length = 4

[State 100, 1]
type = VelSet
triggerall = anim = 100
trigger1 = animelemtime(2)>=0
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeAnim
triggerall=((!var(59))||(var(59)&&var(50)=1))
triggerall =animelemtime(2)>=0
trigger1 = command != "holdfwd" 
trigger1 = anim = 100 
value = 101

[State 100, 4]
type = ChangeAnim
triggerall=var(59)&&var(50)!=1
triggerall =animelemtime(2)>=0
triggerall=anim=100
trigger1 = p2bodydist x<=15+(playerid(var(51)),statetype=l&&p2bodydist y>=-10)*30
trigger2=var(50)<=1&&gametime%15=0&&random%4=0
value = 101

[State 0, CtrlSet]
type = CtrlSet
trigger1 = anim = 101
value = 0

[State 100, 4]
type = ChangeState
;triggerall=!var(59)
triggerall = anim = 101 
trigger1 = abs(vel x) < 0.3
value = 0
ctrl = 1
