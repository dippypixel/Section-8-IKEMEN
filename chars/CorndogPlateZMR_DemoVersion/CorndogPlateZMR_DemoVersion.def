;-------------------------------------------------------------------------
;Zander's Mugen Remastered Character Template
;made by Alexander Cooper 19 for easier time porting new characters over
;Hitspark Effects by Viola
;-------------------------------------------------------------------------
[Info]
name         = "CorndogPlate_ZMR"             ;the name referred to in debug mode
displayname  = "Corndog Plate"                ;the name displayed in game
versiondate  = 07,17,2025                     ;date the template was created
mugenversion = 1.1                            ;self explainatory. DON'T CHANGE OR CHARACTER WILL BREAK.
author       = "Alexander Cooper 19"          ;Author Name
pal.defaults = 1,2,3,4,5,6                    ;a list of palette defaults
;-------------------------------------------------------------------------
[Files]
sprite       = Code/CorndogPlateZMR.sff          ;Contains Sprites and Effects
anim         = Code/CorndogPlateZMR.air          ;Contains all Animations
sound        = Code/CorndogPlateZMR.snd          ;Includes all SFX/Voice Clips
cmd          = Code/CorndogPlateZMR.cmd          ;Contains the characters command list
movelist     = Code/Movelist.dat                 ;Generates a command list using text from this file for IKEMEN Go Pause Menu.
cns          = Code/CNS/CorndogPlateZMR.cns      ;Contains Code
stcommon     = Code/CNS/common1_ZMR.cns          ;Universal Common1 file for Zander's Mugen Remastered
st           = Code/CNS/CorndogPlateZMR.cns      ;Contains Code
st1          = Code/CNS/Normals.cns              ;Contains Code
st2          = Code/CNS/Specials.cns             ;Contains Code
st3          = Code/CNS/Supers.cns               ;Contains Code
st4          = TagTeamZMR.cns                    ;Tag Team Coding (keep it enabled, it doesn't intefere with mugen builds outside ZMR.)
;-------------------------------------------------------------------------
;Palette Colors
pal1         = Palettes/Palette1.act  ;Default
pal2         = Palettes/Palette2.act  ;Hot Cheetos Corndogs
pal3         = Palettes/Palette3.act  ;Lean Corndogs
pal4         = Palettes/Palette4.act  ;Mint Corndogs
pal5         = Palettes/Palette5.act  ;Mustard Corndogs
pal6         = Palettes/Palette6.act  ;Corndog Of Light Servant
pal7         = Palettes/Palette7.act  ;Burnt Corndogs
pal8         = Palettes/Palette8.act  ;Inverted Corndogs
pal9         = Palettes/Palette9.act  ;Sky Blue Corndogs
pal10        = Palettes/Palette10.act ;Midnight Corndogs
pal11        = Palettes/Palette11.act ;Inferno Corndogs
pal12        = Palettes/Palette12.act ;Valentines Corndogs
;-------------------------------------------------------------------------
;Palette Colors (Ikemen Go)

pal13         = Palettes/Palette13_IkemenGo.act ;Dark Plate
pal14         = Palettes/Palette14_IkemenGo.act ;White Plate
pal15         = Palettes/Palette15_IkemenGo.act ;Red Plate
pal16         = Palettes/Palette16_IkemenGo.act ;Blue Plate
pal17         = Palettes/Palette17_IkemenGo.act ;Green Plate
pal18         = Palettes/Palette18_IkemenGo.act ;Orange Plate
pal19         = Palettes/Palette19_IkemenGo.act ;Pink Plate
pal20         = Palettes/Palette20_IkemenGo.act ;Purple Plate
pal21         = Palettes/Palette21_IkemenGo.act ;Sky Plate
pal22         = Palettes/Palette22_IkemenGo.act ;Yellow Plate
pal23         = Palettes/Palette23_IkemenGo.act ;The Useless Palette
pal24         = Palettes/Palette24_IkemenGo.act ;Congratulations
pal25         = Palettes/Palette25_IkemenGo.act ;Frozen Corndogs
;-------------------------------------------------------------------------
[Palette Keymap] 
x 	= 1
y	= 2
z	= 3
a 	= 4 ;Default would be pressing "X" instead of "A" to keep consistent with universal controls.
b	= 5
c 	= 6
x2	= 7
y2	= 8
z2	= 9
a2	= 10
b2	= 11
c2	= 12
;-------------------------------------------------------------------------
;Information Read by Ikemen Go. universal compatibility is left unaffected.
[PalInfo]
