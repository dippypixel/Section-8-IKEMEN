;---------------------------------------------------------------------------
;Fireball HELPER
[Statedef 1002]
type = A
movetype = A
physics = N
velset = 5,0
anim = 1002
sprPriority = 2

[State 1002, HitDef]
type = HitDef
trigger1 = !Time
attr = S, SP                     ;Attribute: Standing, Normal Attack
damage = 80, 5                   ;Damage that move inflicts, guard damage
animtype = Medium                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 0, 10                 ;Time attacker pauses, time opponent shakes
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = 0, 0               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = s0, 3                  ;Sound to play on hit
guardsound = s0, 4                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 4             ;Time that the opponent slides back
ground.hittime  = 15             ;Time opponent is in hit state
ground.velocity = -10             ;Velocity at which opponent is pushed
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -10,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 15                 ;Time before opponent regains control in air
air.fall = 1

[State 1002, HitOverride]
type = HitOverride
trigger1 = !time
attr = SCA,AA,AP,AT
slot = 0
stateno = 1002
time = 99999
ignorehitpause = 1

[State 1002, NotHitBy]
type = NotHitBy
trigger1 = !time
value = ,AA,AT
time = 99999
ignorehitpause = 1

[State 1002, DestroySelf]
type = DestroySelf
trigger1 = FrontEdgeBodyDist <= -100

[State 1002, ChangeState]
type = ChangeState
trigger1 = MoveContact
value = 1003
ignorehitpause = 1

