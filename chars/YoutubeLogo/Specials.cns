;---------------------------------------------------------------------------
;Demuken
[Statedef 1000]
type = S
movetype = A
physics = S
juggle = 2
poweradd = 30
ctrl = 0
velset = 0,0
anim = 1000
sprPriority = 1

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S1000,0
channel = 0
volumescale = 150

[State 1000, Helper]
type = Helper
trigger1 = AnimElem = 3
helpertype = Normal    ;Player
name = "Demuken"
ID = 1001
stateno = 1001
pos = 65,15
postype = P1    ;P2, Front, Back, Left, Right
facing = 1
ownpal = 0
supermovetime = 0
pausemovetime = 0

[State 1000, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Demuken HELPER
[Statedef 1001]
type = A
movetype = A
physics = N
velset = 2.6,0
anim = 1001
sprPriority = 2

[State 1001, HitDef]
type = HitDef
trigger1 = !Time
attr = S, SP                     ;Attribute: Standing, Normal Attack
damage = 75, 5                   ;Damage that move inflicts, guard damage
animtype = Medium                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 0, 10                 ;Time attacker pauses, time opponent shakes
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = 0, 0               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = s0, 3                  ;Sound to play on hit
guardsound = s0, 4                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 4             ;Time that the opponent slides back
ground.hittime  = 20             ;Time opponent is in hit state
ground.velocity = -5             ;Velocity at which opponent is pushed
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -5,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 20                 ;Time before opponent regains control in air
air.fall = 1

[State 1001, HitOverride]
type = HitOverride
trigger1 = !time
attr = SCA,AA,AP,AT
slot = 0
stateno = 1002
time = 99999
ignorehitpause = 1

[State 1001, NotHitBy]
type = NotHitBy
trigger1 = !time
value = ,AA,AT
time = 99999
ignorehitpause = 1

[State 1001, DestroySelf]
type = DestroySelf
trigger1 = FrontEdgeBodyDist <= -100

[State 1001, ChangeState]
type = ChangeState
trigger1 = MoveContact
value = 1002
ignorehitpause = 1

;---------------------------------------------------------------------------
;Demuken EFFECT
[Statedef 1002]
movetype = I
physics = N
velset = 0,0
anim = 1002
sprPriority = 2

[State 1002, DestroySelf]
type = DestroySelf
trigger1 = AnimTime = 0

