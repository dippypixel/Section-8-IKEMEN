[State 900, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = s900, 1

[State 900, VelAdd]
type = VelAdd
trigger1 = command = "holdfwd" && vel x < 8
x = 0.6

[State 900, VelAdd]
type = VelAdd
trigger1 = command = "holdback"  && vel x > -8
x = -0.6

[State 900, ChangeState]
type = ChangeState
trigger1 = Pos Y >= 1
value = 52

