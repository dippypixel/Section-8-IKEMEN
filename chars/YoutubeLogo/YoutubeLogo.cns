;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win - Pimp Named Slickback!
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0
ignorehitpause = 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nomusic
ignorehitpause = 1
persistent = 1

[State 181, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S180,0
volumescale = 350
ignorehitpause = 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = (time > 0) && (time <= 680)
flag = RoundNotOver
ignorehitpause = 1

