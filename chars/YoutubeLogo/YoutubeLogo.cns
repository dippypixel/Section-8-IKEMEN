;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, Timer]
type = VarAdd
trigger1 = Statetype = A && Ctrl
trigger1 = command != "holddown" && command != "holdback"
trigger1 = command = "holdfwd"
v = 1
value = 1
ignorehitpause = 1

[State -2, Timer]
type = VarSet
trigger1 = Statetype = A && Ctrl
trigger1 = command != "holddown" && command != "holdback"
trigger1 = command != "holdfwd"
v = 1
value = 0
ignorehitpause = 1

[State -2, HitOverride]
type = HitOverride
triggerall = !var(59)>0
triggerall = Statetype = S && Ctrl
trigger1 = Command != "holddown" && Command != "holdback"
trigger1 = Command = "holdfwd" && time < 8
attr = SA, AA, AP
slot = 0
stateno = 910
ignorehitpause = 1

[State -2, HitOverride]
type = HitOverride
triggerall = !var(59)>0
triggerall = Statetype = C && Ctrl
trigger1 = Command != "holdfwd" && Command != "holdback"
trigger1 = Command = "holddown" && time < 8
attr = C, AA, AP
slot = 0
stateno = 911
ignorehitpause = 1

[State -2, HitOverride]
type = HitOverride
triggerall = !var(59)>0
trigger1 = Statetype = A && Ctrl
trigger1 = Var(1) = [1,8]
attr = SCA, AA, AP
slot = 0
stateno = 912
ignorehitpause = 1

[State -2, Parry AI]
type = HitOverride
triggerall = Statetype = S && Ctrl
triggerall = var(59)>0
trigger1 = random < 800
attr = SA, AA, AP
slot = 0
stateno = 910
ignorehitpause = 1

[State -2, Parry AI]
type = HitOverride
triggerall = Statetype = C && Ctrl
triggerall = var(59)>0
trigger1 = random < 800
attr = C, AA, AP
slot = 0
stateno = 911
ignorehitpause = 1

[State -2, Parry AI]
type = HitOverride
triggerall = Statetype = A && Ctrl
triggerall = var(59)>0
trigger1 = random < 800
attr = SCA, AA, AP
slot = 0
stateno = 912
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = s40, 1
volumescale = 150

[State -3, Jumping Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = Stateno = 40
value = s40, 0
volumescale = 300

[State -3, Walking Sound]
type = PlaySnd
triggerall = AnimElem = 3 || AnimElem = 7
trigger1 = Anim = 20 || Anim = 21
value = s40, 1
volumescale = 150

[State -3, Running Sound]
type = PlaySnd
triggerall = AnimElem = 3 || AnimElem = 7
trigger1 = Anim = 100
value = s40, 1
volumescale = 150

[State -3, Running Back Sound]
type = PlaySnd
triggerall = AnimElem = 3
trigger1 = Anim = 105
value = s40, 1
volumescale = 150

[State -3, Stop Running Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = Anim = 101
value = s40, 2
volumescale = 300

[State -3, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 905
id = 905
persistent = 1

[State -3, ChargeSndStop]
type = StopSnd
trigger1 = stateno != 905
channel = 8

[State -3, StopIntroSnd]
type = StopSnd
trigger1 = RoundState = 2
channel = 2

[State -3, GetHitVocal]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 600
triggerall = Alive
trigger1 = StateNo = 5000 ;Stand get hit.
trigger2 = StateNo = 5010 ;Crouch get hit.
trigger3 = StateNo = 5020 ;Air get hit.
trigger4 = StateNo = 5070 ;Tripped.
value = s5000, Random%8
volumescale = 250
channel = 0

[State -3, GetUpVocal]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 700
trigger1 = StateNo = 5120 ;Get Up
value = S5001, Random%3
volumescale = 250
channel = 0
