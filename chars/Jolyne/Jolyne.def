; サンプルキャラクター『カンフーマン』の定義ファイルです。
; キャラクターに必要なファイルを全て登録してください。
;
; ※説明文などで左の部分に半角でセミコロン（;）が付いていますが、
; 　これが付いた後の行や文章は全て『コメント化』されます。
; （プログラムとして処理はされない）
; 　作成中のメモを残しておいたり、ステート間の区切りを設ける時などに便利です。
;
;--| 基本情報 |---------------------------------------------------------------
[Info]
Name         = "jolyne"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Jolyne Cujoh"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 08,01,2014     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 03,02,2013     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "あまりもの"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6        ;ＣＰＵで出てきた時のカラーパレットの順番

;--| 必要なファイルの設定 |---------------------------------------------------
;
; def・sff・snd・act以外のファイルは全てメモ帳などで書き換えられる
; テキスト形式のファイルなので、拡張子は何でもＯＫです。
; しかしファイルの認識で不正終了が起こる可能性もあるので、
; 無難に行くならM.U.G.E.Nでサポートされている拡張子にしておきましょう。
;
; def（定義ファイル）のみ、テキスト形式のファイルですが拡張子の変更は不可です。
;
; ※StCommonは書き換えない限り、dataフォルダにある「common1.cns」を
; 　直接読み込んでますが、あなたが独自に作ったコモンファイルを設定する場合は
; 　各キャラクターの「defファイルのあるフォルダ」を基準に
; 　ディレクトリ階層が認識されます。
;
;-----------------------------------------------------------------------------

[Files]
Cmd     = jolyne_cujoh.cmd       ;コマンドファイルの登録
Cns     = jolyne_cujoh.cns       ;コンスタンツファイルの登録
St      = jolyne_cujoh.cns       ;ステートファイルの登録・最大１１個まで増やせます
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません
St2      = _config.cns
StCommon = jolyne_cujohcommon.cns  ;コモンステートファイルの登録
Sprite  = jolyne_cujoh.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = jolyne_cujoh.air       ;アニメーションファイルの登録
Sound   = jolyne_cujoh.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

;-----------------------------------------------------------------------------

Pal1 = pal/J0.act
Pal2 = pal/J2.act
Pal3 = pal/J1.act
Pal4 = pal/J4.act
Pal5 = pal/J5.act
Pal6 = pal/J6.act
Pal7 = pal/J7.act
Pal8 = pal/J8.act

;--| ストーリーボード設定 |---------------------------------------------------
;
; キャラクター固有のオープニングやエンディングのファイル（ストーリーボード）を
; 登録する場合はここで設定をします。
;
; ※ここで設定したストーリーボードが有効になるゲームモードは
; 「アーケードモード（ARCADE）」
; 「チームアーケードモード（TEAM ARCADE）」
; 「１Ｐと２ＰがペアになってＣＰＵと闘うモード（TEAM CO-OP）」の三種類のみ。
;
; 　しかしチームを組んだ場合、有効になるのは『選んだ最初の一人目』のみ。
;
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------

