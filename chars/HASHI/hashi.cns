;PODER AL MAXIMO (helper)
[Statedef 1996]
type    = S
movetype= I
physics = N
poweradd= 0
velset = 0,0
anim = 1996
ctrl = 0
sprpriority = 5

[State 0, Turn]
type = Turn
triggerall = !time
trigger1 = parent,var(34)=1 && parent,facing = -1
trigger2 = parent,var(34)=0 && parent,facing = 1


[State 0, PosSet]
type = PosSet
trigger1 = 1
x = cond(parent,var(34)=1,-95,92)
y = pos y - screenpos y + 30

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 55,ifelse(parent,var(34)=1,57,58)
volume = 256
abspan = ifelse(parent,var(34)=1,-200,200)
freqmul = ifelse(parent,var(34)=1,1.1,0.9)

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 700, 10]
type = destroyself
trigger1 = parent, power <3000


