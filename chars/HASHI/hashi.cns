trigger2 = movehit && enemynear,name = "animus" && enemynear,stateno = 3100
anim = cond(random < 500,7100,7101)
pos = 0,ceil((enemynear, pos y)-100)
persistent = 0
ignorehitpause = 1
sprpriority = 4

