;[State 0, AssertSpecial]
;type = AssertSpecial
;trigger1 = !(enemynear, Authorname = "Andres Borghi")
;trigger1 = stateno != 170 && stateno != 185
;flag = invisible


;===============================================================================
; ------- Damage Dampener --------
;===============================================================================

[State -2, Counter Flag]
type = VarSet
trigger1 = NumEnemy
fvar(13) = (EnemyNear, MoveType = A)
ignoreHitPause = 1

;Damage Dampener Variable (by POTS)
[State -2, Hit Count]
type = VarAdd
triggerall = !NumProjID(1337)
trigger1 = !IsHelper
trigger1 = MoveHit = 1
trigger1 = !HitPauseTime
trigger1 = !(HitDefAttr = SCA, AT)
fvar(14) = 1

[State -2, Hit Count Reset]
type = VarSet
trigger1 = NumEnemy && fvar(14)
trigger1 = (EnemyNear, MoveType != H) && (EnemyNear, StateNo != 5300)
fvar(14) = 0
ignoreHitPause = 1

[State -2, Dampener]
type = VarSet
trigger1 = 1
fvar(9) = cond(fvar(14) < 1, 30, cond(fvar(14) >= 29, 1, 30 - fvar(14))) / 30.0
ignoreHitPause = 1

[State -2, Dampener Limit]
type = VarSet
trigger1 = fvar(9) < 0
fvar(9) = 0
ignoreHitPause = 1

;[State 0, PlaySnd]
;type = PlaySnd
;trigger1 = !(enemynear, Authorname = "Andres Borghi")
;trigger1 = stateno != 170 && stateno != 185
;trigger1 = roundstate <=2
;trigger1 = gamemode!="training"
;value = 0,0
;loop = 1

[State -2, Root Dampener]
type = VarSet
trigger1 = 1
fvar(10) = fvar(9) * cond(fvar(13), 1.2, 1)
ignoreHitPause = 1


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]


;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 100, 3
freqmul = 0.7+(random/3333.3)

;pasos
[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 20 && animelem = 3
trigger2 = anim = 20 && animelem = 8
trigger3 = anim = 21 && animelem = 2
trigger4 = anim = 21 && animelem = 6
trigger5 = anim = 100 && animelem = 3
trigger6 = anim = 100 && animelem = 8
value = 100,3
volume = -100
freqmul = 0.7+(random/2000.0)

;saltos
[State 0, PlaySnd]
type = PlaySnd
triggerall = time=1
trigger1 = stateno = 50
trigger2 = stateno = 105
value = 0,cond(random<500,1,2)
volume = -100
freqmul = 0.8+(random/6666.6)

[State 0, StopSnd]
type = StopSnd
trigger1 = stateno!=197 && stateno != 198
channel = 26

;DF - se cancela afterimage si muere
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = life = 0
trigger2 = movetype = h && var(10)=0
time = 0

;DF cancela DF
[State -3, cancela]
type = ChangeState
triggerall = var(10) >0 && power > 0 && life !=0
triggerall = statetype !=A && (ctrl || (stateno=[200,440]) && time <3)
triggerall = command = "darkforce"
trigger1 = var(24) = 0
trigger2 = var(24) = 3
trigger3 = var(24) = 1 && power <=1000
trigger4 = var(24) = 2 && power <=1000
trigger5 = var(24) = 4
value = 3501
ctrl = 0

;DF cancela DF
[State -3, cancela]
type = ChangeState
triggerall = var(10) >0 && alive && statetype !=A && ctrl
trigger1 = power = 0
trigger2 = roundstate != 2
value = 3501
ctrl = 0

;DF
;baja el poder mientras esta en DF si es golpeado
[State -3, PowerAdd]
type = PowerAdd
triggerall = var(10) > 0
trigger1 = movetype = H && !time
value = -60

;Survival winscreen partner
;------------------
[State 0, ChangeState]
type = ChangeState
triggerall = numpartner
trigger1 = partner,stateno=18000 && stateno !=18000 && stateno !=18001
value = 18001

;Survival winscreen enemigo
[State 0, ChangeState]
type = ChangeState
triggerall = numenemy
trigger1 = enemynear,stateno=18000 && stateno !=18002
value = 18002

;sangre constante
[State 0, Helper]
type = Helper
trigger1 = life <= 250 && random < 10
trigger1 = roundstate = 2 && movetype != H && alive = 1
trigger1 = stateno != 4000 && stateno != 4001
name = "sangre constante"
ID = 6100
stateno = 6100
pos = ceil(-8+(random/60)), ceil(cond(statetype != c,-40,-20)-(cond(statetype != c,(random/14),(random/25))))
facing = cond(random<500,1,-1)
ownpal = 1

;---------------------------------------------------------------------------
;MOSCA
[Statedef 8000]
type    = A
movetype= I
sprpriority = 7

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = parent, stateno = 4500
flag = invisible

[State 8000, 1]
type = PlayerPush
trigger1 = 1
value = 0

[State 0, Turn]
type = Turn
trigger1 = facing != root, facing

;velsets
;-------

;primer velset
[State 0, VelSet]
type = VelSet
trigger1 = !time
x = -2.0 + (random/250.0)
y = -2.0 + (random/250.0)

;adelante
[State 8000, 2]
type = VelSet
trigger1 = RootDist X > 30
x = 0.7+(random/1000.0)

;atras
[State 8000, 2]
type = VelSet
trigger1 = RootDist X < -30
x = -0.7-(random/1000.0)

;arriba
[State 8000, 2]
type = VelSet
trigger1 = RootDist y <= 30
y = -0.7-(random/1000.0)

;abajo
[State 8000, 2]
type = VelSet
trigger1 = RootDist y >= 120
y = 0.7+(random/1000.0)

;randoms

;adelante
[State 8000, 2]
type = VelSet
trigger1 = vel x < 0 && random < 10
x = 0.7+(random/1000.0)

;atras
[State 8000, 2]
type = VelSet
trigger1 = vel x > 0 && random < 10
x = -0.7-(random/1000.0)

;arriba
[State 8000, 2]
type = VelSet
trigger1 = vel y < 0 && random < 10
y = -0.7-(random/1000.0)

;abajo
[State 8000, 2]
type = VelSet
trigger1 = vel x > 0 && random < 10
y = 0.7+(random/1000.0)

;changeanims
;-----------

;derecha
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = vel x >= 1 && anim != 8000
value = 8000

;frente
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = vel x > -1 && vel x < 1 && anim != 8001
value = 8001

;izquierda
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = vel x <= -1 && anim != 8002
value = 8002

;explod 1
[State 0, Explod]
type = Explod
triggerall = ishelper(8000) && numexplod(8010)=0
triggerall = anim != 8003 && anim != 8004
trigger1 = root, var(10) = 1
trigger2 = root, stateno = 181
trigger3 = root, stateno = 183
trigger4 = root, stateno = 185
anim = 3507
ID = 8010
bindtime = -1
sprpriority = 1
ownpal = 1

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = root, var(10) = 0
trigger1 = root, stateno !=181 && root, stateno !=183 && root, stateno !=185
trigger2 = ishelper(8000) && power <= 999
ID = 8010

;explod 2
[State 0, Explod]
type = Explod
triggerall = ishelper(8001) && numexplod(8011)=0
triggerall = anim != 8003 && anim != 8004
trigger1 = root, var(10) = 1
trigger2 = root, stateno = 181
trigger3 = root, stateno = 183
trigger4 = root, stateno = 185
anim = 3507
ID = 8011
bindtime = -1
sprpriority = 1
ownpal = 1

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = root, var(10) = 0
trigger1 = root, stateno !=181 && root, stateno !=183 && root, stateno !=185
trigger2 = ishelper(8001) && power <= 1999
ID = 8011

;explod 3
[State 0, Explod]
type = Explod
triggerall = ishelper(8002) && numexplod(8012)=0
triggerall = anim != 8003 && anim != 8004
trigger1 = root, stateno = 181
trigger2 = root, stateno = 183
trigger3 = root, stateno = 185
anim = 3507
ID = 8012
bindtime = -1
sprpriority = 6
ownpal = 1

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = root, var(10) = 0
trigger1 = root, stateno !=181 && root, stateno !=183 && root, stateno !=185
trigger2 = ishelper(8002) && power <= 2999
ID = 8012

;muere
;-----

[State a0, ChangeAnim]
type = ChangeAnim
triggerall = anim != 8003
trigger1 = ishelper(8000) && power <= 999
trigger2 = ishelper(8001) && power <= 1999
trigger3 = ishelper(8002) && power <= 2999
value = 8003

[State 0, VelSet]
type = VelSet
trigger1 = anim = 8003
x = 0
y = 2

[State e0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 8003 && pos y >=-3
value = 8004

[State 0, VelSet]
type = VelSet
trigger1 = anim = 8004
x = 0
y = 0

[State 0, posset]
type = posset
trigger1 = anim = 8004
y = 0

[State 0, SprPriority]
type = SprPriority
trigger1 = 1
value = cond(anim = 8004,0,3)

