;PODER MAXIMO
;----------------
[State 0, Helper]
type = null;Helper
trigger1 = power >= 3000
trigger1 = roundstate = 2
trigger1 = numhelper(1996) = 0
trigger1 = alive
trigger1 = cond(numpartner,partner, numhelper(1996)=0,1)
helpertype = normal
name = "podermaximo"
ID = 1996
stateno = 1996
;facing = cond(var(34)=1,1,-1)
keyctrl = 0
ownpal = 1
supermovetime = 50000
pausemovetime = 50000

;------------------------
;----------------------------------

;grito cuando sufre
[State -2, 1]
type = PlaySnd
triggerall = time = 1 && alive
trigger1 = random < 500
trigger1 = (stateno = 5000)||(stateno = 5020)||(stateno = 5070)||(stateno = 5080)
value = 11,cond(random<333,1,cond(random<500,2,3))
channel = 15
volume = 250
freqmul = 0.9+(random/3333.3)
ignorehitpause = 1

;aerial rave off
[State 0, VarSet]
type = VarSet
trigger1 = stateno!=410 && stateno !=40 && stateno != 50
v = 15
value = 0

;troncazo roto off
[State 0, VarSet]
type = VarSet
trigger1 = stateno != 3000
var(9)=0

;aerial rave off
[State 0, VarSet]
type = VarSet
trigger1 = stateno!=3520
var(34)=0

;DF
;baja el poder mientras esta en DF
[State -2, PowerAdd]
type = PowerAdd
triggerall = var(10) = 1
trigger1 = roundstate = 2 && stateno != 3500
value = -3
ignorehitpause = 1

;DF florecita constante
[State 0, Helper]
type = Helper
trigger1 = var(10)=1 && life !=0 && roundstate = 2
trigger1 = numhelper(3501) <= 3 && stateno != 3500 && stateno != 3520
name = "florecita"
ID = 3501
pos = ceil(-30+(random/16.6)),0
stateno = 4200
ownpal = 1

;DF
;BG color
[State -2, BGPalFX]
type = BGPalFX
triggerall = roundstate = 2 && life != 0 && stateno !=3501
trigger1 = var(10) = 1
trigger2 = stateno = 3500 && anim = 3500 && time >=4
time = 1
add = -30,-0,-30
color = 0
ignorehitpause = 1

;df - invisible
[State 0, AssertSpecial]
type = null;AssertSpecial
trigger1 = var(10)=1
flag = invisible

[State 0, PalFX]
type = PalFX
trigger1 = var(10)=1
time = 2
add = -240,0,-240
mul = 256,256,256

invertall = 1
color = 0
ignorehitpause =1
;persistent =


;df - recupera vida con fruto
[State 0, LifeAdd]
type = LifeAdd
trigger1 = numhelper(3500)>=1
trigger1 = helper(3500), anim = 3506 && helper(3500), animelemtime(1)=1
value = 80

;df - recupera power con fruto
[State 0, powerAdd]
type = poweradd
trigger1 = numhelper(3500)>=1
trigger1 = helper(3500), anim = 3506 && helper(3500), animelemtime(1)=1
value = 200

;DF
;muere y se cancela
[State 0, VarSet]
type = VarSet
trigger1 = !alive
var(10)=0

;DF - cancela grillos
[State 0, StopSnd]
type = StopSnd
trigger1 = var(10)=0
channel = 2

[State -2, mosca 1]
