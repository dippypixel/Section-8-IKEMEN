;------------------------------------------------------------------------------------

[Statedef 0]
type    = S
physics = S
sprpriority = 0

[State 0, アニメ変更] ;振り向き動作から移行
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 軸位置] ;地上に戻す
type = PosSet
trigger1 = time = 0
y = 0

[State 0, 移動速度] ;Y方向の速度を0に
type = VelSet
trigger1 = time = 0
y = 0

[State 0, 移動速度] ;低速になるか4フレーム経過で停止
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = time = 0
x = 0


[State 0, ステート変更] ;生存判定
type = ChangeState
trigger1 = !alive
value = 5050 ;生存していない場合ステート5050へ


;------------------------------------------------------------------------------------
;立ち→しゃがみ
;------------------------------------------------------------------------------------
[Statedef 10]
type    = C
physics = C
anim = 10

[State 20000]
type = Helper
trigger1 = time = 0
helpertype = normal
name = "zaxtu"
ID = 200000
pos = 0, 5
postype = p1
facing = facing
stateno = 200000
keyctrl = 0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999
size.xscale = 0.85
size.yscale = 0.85
ignorehitpause = 1

[State 10, AI]
Type = ChangeState
Trigger1 = Var(59) >= 1;条件を加えずに必ず戻るようにする。
Value = 0
Ctrl = 1
IgnoreHitPause = 1

