trigger1 = Win && MatchOver
trigger1 = time = 0
trigger1 = var(11) = 2
value = 183

[State 180, 我らとは比較にならぬ!]
type = ChangeState
trigger1 = Win && MatchOver
trigger1 = time = 0
trigger1 = var(11) = 3
value = 184

[State 180, R1] 
type = ChangeState
trigger1 =!MatchOver
trigger1 = Win 
trigger1 = Time = 0
value = ifelse(Random<=500,181,182)

