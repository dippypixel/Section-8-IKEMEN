;---------------------------------------------------------------------------
; Wave Shot
; CNS difficulty: medium
; Description: This is like a standard attack, but with some differences.
;   There are two HitDefs in this attack. One is triggered when the
;   opponent is near (using a p2bodydist trigger), and the other
;   when the opponent is farther away. The main differences between
;   the near and far versions of the HitDefs is that the near version
;   has a "fall" parameter set to 1, causing the opponent to be knocked
;   down. Other minor differences are the damage, and the velocity to
;   give the opponent.
;   The line "attr = S, SA" line means this is a Standing, Special Attack.
;   It is important you have the attr parameter set correctly for all
;   you HitDefs.
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2

[State 1000, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 0, 3

[State 181, Sound]
type = PlaySnd
trigger1 = AnimElem = 2
value = 5, (random%2)
channel = 0
volume = 255

[State 1000, naifudo kuraie!]
type = Projectile
trigger1 = AnimElem = 2
ProjID = 1001
projanim = 1001
;projhitanim = 1002
;projscale = 1,1
hitsound   = s44,0
guardsound = s44, 0
sparkno = s7676                      ;Spark anim no (Def: set above)
sparkxy = 0,0
projremove = 1
guardflag = MA    
projremovetime = -1
velocity = 10,0
projscale = 1.4, 1.4
remvelocity = 0,0
accel = 0,0
projhits = 1
pausetime = 0, 6
projpriority = 1
projsprpriority = 3
ground.type = Low
yaccel = .88
ground.slidetime = 14
ground.hittime  = 25
ground.velocity = -15
air.animtype = Back
air.velocity = -8,-6
down.velocity = -8,-6
offset = 14,-50
attr = S, SP
damage   = 100,40
yaccel = .80
postype = p1         ;p2,front,back,left,right


[State 1000, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

