;---------------------------------------------------------------------------
; Rising Uppercut
[Statedef 1000]
type    = U
movetype = A
physics = N
juggle  = 4
poweradd= ceil(35*fvar(7))
ctrl = 0
anim = 1000

[State 0, Turn]
type = Turn
trigger1 = p2dist x < 0 && statetype=S
trigger1 = !time

[State 0, HitBy]
type = HitBy
trigger1 = animelemtime(6) < 0
value = 
time = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S1000,0
[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S1000,1

[State 100, Red After]
type = AfterImage
triggerall = vel y < 0
trigger1 = time%16 = 0
time = 8
length = 3
palcolor = 256
palinvertall = 0
palbright = 0,0,0
palcontrast = 256,0,0
palpostbright = 0,0,0
paladd = 0,-256,-256
palmul = 1,1,1
timegap = 4
framegap = 1
trans = add1
[State 100, Green After]
type = AfterImage
triggerall = vel y < 0
trigger1 = time%16 = 8
time = 8
length = 3
palcolor = 256
palinvertall = 0
palbright = 0,0,0
palcontrast = 0,256,0
palpostbright = 0,0,0
paladd = -256,0,-256
palmul = 1,1,1
timegap = 4
framegap = 1
trans = add1

[State 40, Explod]
type = Explod
trigger1 = animelem = 2 ;animelemtime(3) = 1
anim = 6850
pos = 0,0
postype = p1
removetime = -2
;bindtime = 0
pausemovetime = -1
supermovetime = -1
sprpriority = -1
ownpal = 1
scale = ceil(const(size.xscale)),ceil(const(size.yscale))

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 2
x = 3
y = -11
[State 0, VelSet]
type = VelSet
trigger1 = animelem = 12
x = 1
y = -9

[State 1200, VelSet]
type = PosSet
trigger1= AnimElemTime(2) < 0
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0 
[State 1200, VelSet]
