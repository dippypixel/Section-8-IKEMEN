[State 200, Start/Reset Combo time]
type = VarSet
triggerall = AnimElemTime(12) >= 0 && AnimElemTime(14) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 20
value = 402
ignorehitpause = 1
persistent = 0

[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
triggerall = var(20) > 0 && var(20) < 402
trigger1 = movecontact=1 && moveguarded=1 && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = AnimElemTime(3) >= 0 && AnimElemTime(6) < 0
triggerall = var(20) > 0 && var(20) < 402
trigger1 = movecontact=1 && moveguarded=1 && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = AnimElemTime(12) >= 0 && AnimElemTime(14) < 0
triggerall = var(20) > 0 && var(20) < 402
trigger1 = (movecontact) && (movehit = 1)
v = 20
value = 20
ignorehitpause = 1
persistent = 0

[State 200, Add to Score]
type = VarAdd
triggerall = var(41) = 1
triggerall = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 22
value = ceil((var(21)**2 * 0.25) + (var(21)*10))
ignorehitpause = 1
persistent = 0
[State 200, Add to Score]
type = VarAdd
triggerall = var(41) = 1
triggerall = AnimElemTime(3) >= 0 && AnimElemTime(6) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 22
value = ceil((var(21)**2 * 0.25) + (var(21)*10))
ignorehitpause = 1
persistent = 0
[State 200, Add to Score]
