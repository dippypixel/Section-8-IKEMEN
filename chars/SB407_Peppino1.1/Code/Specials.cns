ground.hittime  = 14
air.hittime = 14
guard.hittime = 5
airguard.hittime = 5
ground.velocity = -3, -9
guard.velocity = -5
air.velocity = -3,-9
airguard.velocity = -2,-1.5
ground.cornerpush.veloff = 0
yaccel = 0.5/fvar(20)
fall = ifelse(var(16), 0, 1)
forcenofall = ifelse(var(16), 1, 0)
fall.recover = 1
fall.recovertime = 120

[State 0, VarSet]
type = VarSet
trigger1 = AnimElemTime(12) >= 0 && AnimElemTime(14) < 0
trigger1 = movehit = 1
trigger1 = !var(16)
var(16) = 1
ignorehitpause = 1

[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
triggerall = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 21
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
triggerall = AnimElemTime(3) >= 0 && AnimElemTime(6) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 21
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
triggerall = AnimElemTime(12) >= 0 && AnimElemTime(14) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 21
value = 1
ignorehitpause = 1
persistent = 0

[State 200, Start/Reset Combo time]
type = VarSet
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 20
value = 402
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarSet
triggerall = AnimElemTime(3) >= 0 && AnimElemTime(6) < 0
trigger1 = (movecontact) && (movehit = 1)
v = 20
