trigger1 = 1
y = const(size.mid.pos.y)

[State 0, ChangeAnim2]
type = ChangeAnim2
trigger1 = !time
value = 1308

[State 821, 1] ;Gravity
type = VelAdd
trigger1 = 1
y = const(movement.yaccel)

[State 821, 2] ; Recover near ground (use ChangeState)
