;---------------------------------------------------------------------------
; Suplex
[Statedef 1100]
type    = U
movetype = A
physics = N
juggle  = 4
poweradd= ceil(50*fvar(7))
ctrl = 0
anim = 1100

[State 0, Turn]
type = Turn
trigger1 = p2dist x < 0 && statetype=S
trigger1 = !time

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem=2
value = S1100,0

[State 100, Roll After]
type = AfterImage
trigger1 = animelem=2
time = 8
length = 3
palcolor = 256
palinvertall = 0
palbright = 0,0,0
palcontrast = 128,128,128
palpostbright = 0,0,0
paladd = 0,0,0
palmul = 1,1,1
timegap = 4
framegap = 1
trans = add1
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = animelemtime(2) >= 0 && animelemtime(8) < 0 && time%2 = 0
time = 2

[State 0, VelSet]
type = VelSet
triggerall = statetype != A
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
x = 0
y = 0 
[State 0, VelSet]
type = VelMul
trigger1 = statetype = A
trigger1 = !time
x = .15
y = .15

[State 1200, Air]
type = StateTypeSet
trigger1 = pos y != 0
statetype = A
[State 1200, Ground]
type = StateTypeSet
trigger1 = pos y = 0
statetype = S
[State 1200, Gravity]
type = VelAdd
trigger1 = statetype = A
trigger1 = animelemtime(8) >= 0
y = const(movement.yaccel)
[State 1200, Gravity]
type = VelMul
trigger1 = statetype = S
trigger1 = animelemtime(2) < 0
y = const(movement.stand.friction)


[State 0, VelSet]
type = VelSet
trigger1 = animelemtime(2) >= 0 && animelemtime(8) < 0
x = 10
persistent = 0

[State 0, ChangeState]
type = ChangeState
triggerall = statetype != A && !moveguarded && !moveguarded
triggerall = animelemtime(2) >= 0 && animelemtime(8) < 0 
triggerall = var(8) < 3
trigger1 = command = "holdup" && !aiLevel
trigger2 = aiLevel && !numtarget && p2bodydist x >= 150
trigger2 = random < var(58)*.1
trigger3 = aiLevel && p2statetype = A
trigger3 = random < var(58)*.667
value = 1105
ctrl = 1

[State 0, VelSet]
type = VelMul
triggerall = animelemtime(8) >= 0 
trigger1 = !moveguarded
trigger2 = moveguarded && statetype != A
x = const(movement.stand.friction)

[State 1200, Stop]
type = VelSet
triggerall = statetype != A
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
trigger2 = prevstateno = 250
x = 0
y = 0 
[State 1200, VelSet]
type = PosSet
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0 
[State 1200, VelSet]
type = VelSet
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0 

[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(8) >= 0
movetype= I

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = S1100,0


[State 800, 1]
type = HitDef
trigger1 = statetype != A && AnimElemTime(3) >= 0 && AnimElemTime(8) < 0
trigger1 = !movecontact && !moveguarded && !movereversed
attr = S, ST
guardflag = MA
hitflag = M
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
sparkxy = -10, ceil(-35*const(size.yscale))
p2facing = 1          ;Force p2 to face player
p1stateno = 1110       ;On success, player changes to state 810
fall = 1              ;Force p2 into falling down
getpower = 0, 0
givepower = 0, 0
ground.slidetime = 15
ground.hittime  = 15
air.hittime = 15
guard.hittime = 12
airguard.hittime = 12
ground.velocity = -8, -5
air.velocity = -8, -5
guard.velocity = -3
airguard.velocity = -1, -3
numhits = 0
id = 1110
[State 800, 1]
type = HitDef
trigger1 = statetype = A && AnimElemTime(3) >= 0 && AnimElemTime(8) < 0
trigger1 = !movecontact && !moveguarded && !movereversed
attr = A, ST
guardflag = HA
hitflag = AF
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
sparkxy = -10, ceil(-35*const(size.yscale))
p2facing = 1          ;Force p2 to face player
p1stateno = 1115       ;On success, player changes to state 810
fall = 1              ;Force p2 into falling down
getpower = 0, 0
givepower = 0, 0
ground.slidetime = 15
ground.hittime  = 15
air.hittime = 15
guard.hittime = 12
airguard.hittime = 12
ground.velocity = -8, -5
air.velocity = -3.5, -8
guard.velocity = -3
airguard.velocity = -1, -3
numhits = 0
id = 1115

[State 0, ChangeState]
type = ChangeAnim
trigger1 = moveguarded
value = 1100;1101
elem = 8
persistent = 0
[State 0, VelSet]
type = VelSet
trigger1 = moveguarded
x = ifelse(statetype = A, -1.5, -4)
y = ifelse(statetype = A, -5, 0)
persistent = 0

[State 1200, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0+(statetype = A * 50)
ctrl = 1

