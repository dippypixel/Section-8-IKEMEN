guard.velocity = -4.15
airguard.velocity = -2,-1.5
air.velocity = -1,-11.5
air.hittime = 24
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5
forcenofall = 1
[State 200, 1]
type = HitDef
trigger1 = AnimElemTime(12) >= 0 && AnimElemTime(14) < 0
trigger1 = movecontact != 1 && moveguarded != 1 && movereversed != 1
attr = A, SA
damage = 50, 5
animtype = Up
guardflag = HA
hitflag = MAF
priority = 3, Hit
pausetime = 9,9
