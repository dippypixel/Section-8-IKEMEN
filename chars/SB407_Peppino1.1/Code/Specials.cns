trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = (movecontact) && (movehit = 1)
fvar(10) = fvar(10)*0.9
ignorehitpause = 1
persistent = 0
[State 200, Damage Dampen]
type = varset
