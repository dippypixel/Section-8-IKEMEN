trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
value = ceil((115+((var(25)>0)*75))*fvar(7))

[State 0, HitAdd]
type = HitAdd
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
value = 1
[State 0, TargetLifeAdd]
type = TargetPowerAdd
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
value = 125
ID = 1305
[State 0, TargetPowerAdd]
type = TargetLifeAdd
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
value = ceil((-80-((var(25)>0)*45))*fvar(11))
ID = 1305
kill = 1
absolute = 0
[State 200, Damage Dampen]
type = varset
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
fvar(10) = fvar(10)*0.9

[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
v = 21
value = 1
[State 200, Start/Reset Combo time]
type = VarSet
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
v = 20
value = 402
[State 200, Add to Score]
type = VarAdd
triggerall = var(41) = 1
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
v = 22
value = ceil((var(21)**2 * 0.25) + (var(21)*10))

[State 0, TargetState]
type = TargetState
trigger1 = NumTarget(1305) && !time
trigger1 = target,stateno = 1305
value = 1306
ID = 1305
ignorehitpause = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = animtime = 0 && anim = 1303
value = 1304

[State 0, PosSet]
type = Null;PosSet
trigger1 = anim = 1303
y = floor(-GameHeight + (79*const(size.yscale)))

[State 0, VelAdd]
type = VelAdd
trigger1 = anim = 1304
y = const(movement.yaccel)

[State 100, 4]
type = ChangeState
triggerall = anim = 1304
trigger1= vel y > 0
trigger1= pos y > -vel y
value = 1921

;---------------------------------------------------------------------------
; Opponent Thrown
[Statedef 1305]
type    = A
movetype= H
physics = N
velset = 0,0
sprpriority = 0

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0
[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 820, ChangeAnim2]
type = ChangeAnim2
Trigger1 = Time = 0
value = 1307

;---------------------------------------------------------------------------
; Opponent thrown into the air
[Statedef 1306]
type    = A
movetype= H
physics = N
poweradd = 0
velset = -3.5, 1

[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,0

[State 0, ChangeAnim2]
type = ChangeAnim2
trigger1 = !time
value = 1308

[State 821, 1] ;Gravity
type = VelAdd
trigger1 = 1
y = .5

[State 821, 2] ; Recover near ground (use ChangeState)
type = ChangeState
triggerall = time >= 12
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 821, 3] ; Recover in mid air (use SelfState)
type = SelfState
triggerall = time >= 12
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 821, 4] ;Hit ground
type = ChangeState
trigger1= vel y > 0
trigger1= pos y > -vel y
;trigger1= pos y - const(size.mid.pos.y) > -vel y
value = 6100 ;Hit ground

;---------------------------------------------------------------------------
