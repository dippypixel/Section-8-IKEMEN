guardsound = s6, 0
getpower = ceil(12*fvar(7)), (8*fvar(7))
givepower = 15, 15
ground.type = High
air.type = High
ground.slidetime = 7
ground.hittime  = 10
guard.hittime = 6
airguard.hittime = 6
ground.velocity = -1.5, -8
guard.velocity = -4.15
airguard.velocity = -2,-1.5
air.velocity = -1,-11
air.hittime = 10
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5
forcenofall = 1
[State 200, 1]
type = HitDef
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(6) < 0
trigger1 = movecontact != 1 && moveguarded != 1 && movereversed != 1
