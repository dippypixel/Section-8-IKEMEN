;---------------------- Integer variable list ----------------------
; var(1):= Mach Speed
; var(2):= Mach Stop timer
; var(3):= Mach 3 FX
; var(5):= Roman Cancel FX
; var(6):= Parry code (thanks to ace_underscore_!)
; var(7):= Roman Cancel Trigger
; var(8):= Aerial IPS
; var(9):= OTG limiter
; var(10):= Spike sound
; var(11):= Crouch Parry code
; var(12):= Shine variable
; var(13-14):=Storing velocities during Taunt
; var(15):= Projectiles can be Roman Cancelled! (why is this here..)
; var(16):= Uppercut causes juggle reset
; var(17):= Breakdance variable so TAUNTING ACTUALLY FUCKING WORKS ON MUGEN
; var(18):= Ranks
; var(19):= Peppino Scooter/Clone Intro offset
; var(20):= Combo Time
; var(21):= Combo Amount
; var(22):= Score for ranking! Score earned from a combo is determined by the formula (x**2 * 0.25) + 10x.
; var(23):= Lost a combo during the match (used for P ranks) (0=No combo, 1=In combo, 2=Lost a combo)
; var(25):= Super Jump becomes stronger?
; var(30):= Has Super Taunt been used in a combo? (done to make it worthwhile using his Level 3 instead of just spamming Super Taunt 3 times in a row)
; var(38):= Throws Disabled (POTS shit)
; var(40):= Combo Meter configuration
; var(41):= Rank configuration
; var(42):= AI configuration
; var(50-51):= Wavedash Stuff
; var(53):= Wall Jump Trigger
; var(55-56);= Super Jump Codes
; var(58);= AI Difficulty

;---------------------- Float variable list ----------------------
; fvar(5):= POTS Corner Push
; fvar(7):= Roman Cancel Proration
; fvar(10-11):= RicePigeon Damage Proration
; fvar(20):= Velocity Deterioration

;--------------------- Sound channel list -------------------
; channel=0 := Voice (duh -_-)
; channel=1 := Run snd
; channel=2 := Body Slam sfx
; channel=3 := Super Jump sfx
; channel=4 := Breakdance sound

