;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

[State 0, Helper]
type = Helper
triggerall = var(40) > 0
triggerall = roundstate = 2 && (teammode = single || teammode = turns)
trigger1 = !numhelper(4000)
name = "Combo Meter"
ID = 4000
stateno = 4000
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 99999
pausemovetime = 99999
[State 0, Helper]
type = Helper
triggerall = var(41) = 1 ;Will not display when disabled or when Ranks are determined by HP
triggerall = roundstate = 2 && (teammode = single || teammode = turns)
triggerall = !ailevel
trigger1 = !numhelper(4001) && teamside = 1
name = "Rank"
ID = 4001
stateno = 4001
pos = 0,0
postype = left    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 99999
pausemovetime = 99999
[State 0, Helper]
type = Helper
triggerall = var(41) = 1 ;Will not display when disabled or when Ranks are determined by HP
triggerall = roundstate = 2 && (teammode = single || teammode = turns)
triggerall = !ailevel
trigger1 = !numhelper(4001) && teamside = 2
name = "Rank"
ID = 4001
stateno = 4001
pos = 0,0
postype = right    ;p2,front,back,left,right
facing = -1
keyctrl = 0
ownpal = 0
supermovetime = 99999
pausemovetime = 99999

[State -2, Combo time go down]
type = VarAdd
triggerall = movetype != H
triggerall = roundstate = 2 && var(20) > 0
trigger1 = (stateno != [810,815]) && (stateno != [1101,1199]) && (stateno != [3300,3303]) && stateno != 1301
trigger2 = (stateno = [810,815]) && animelemtime(4) > 0
trigger3 = stateno = 1150 && animelemtime(4) > 0
trigger4 = stateno = 1301 && !numtarget(1305)
trigger5 = stateno = 3300 && animelemtime(30) > 0
v = 20
value = -1
[State -2, Combo time go down when damaged]
type = VarAdd
triggerall = var(20) > 0
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5070)
trigger1 = !time
trigger2 = (stateno != 5000) && (stateno != 5010) && (stateno != 5020) && (stateno != 5070)
trigger2 = (stateno != [120,160]) && (stateno != [700,799])
trigger2 = gethitvar(damage)
v = 20
value = ceil(-gethitvar(damage)*.5)
[State -2, Score go down when damaged]
type = VarAdd
triggerall = var(22) > 0 && var(41) = 1
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5070)
trigger1 = !time
trigger2 = (stateno != 5000) && (stateno != 5010) && (stateno != 5020) && (stateno != 5070)
trigger2 = (stateno != [120,160]) && (stateno != [700,799])
trigger2 = gethitvar(damage)
v = 22
value = ceil(-gethitvar(damage)*10)
[State -2, Prevent combo score from going negative]
type = VarSet
trigger1 = var(22) < 0
v = 22
value = 0

[State -2, Combo counter reset]
type = VarSet
trigger1 = var(20) <= 0
trigger2 = teammode = simul
v = 21
value = 0
[State -2, Prevent combo score from going negative]
type = VarSet
trigger1 = var(21) < 0
trigger2 = teammode = simul
v = 21
value = 0

[State -2, Prevent combo time from going negative]
type = VarSet
trigger1 = var(20) < 0
trigger2 = teammode = simul
v = 20
value = 0
[State -2, Prevent combo time from going above the limit]
type = VarSet
trigger1 = var(20) > 402
v = 20
value = 402
[State -2, Prevent combo counter from going above the limit]
type = VarSet
trigger1 = var(21) > 999
v = 21
value = 999

[State -2, Combo Started]
type = VarSet
trigger1 = var(23) = 0 && var(21) > 0
v = 23
value = 1
[State -2, Combo Ended]
type = VarSet
trigger1 = var(23) = 1 && var(20) = 0
v = 23
value = 2

[State -2, SJ Strength Var]
type = VarSet
trigger1 = var(25) != 0 && stateno != [1300,1302]
v = 25
value = 0

[State 0, Hurt]
type = PlaySnd
triggerall = alive
triggerall = random > 250
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5070)
trigger1 = !time
trigger2 = (stateno != 5000) && (stateno != 5010) && (stateno != 5020) && (stateno != 5070)
trigger2 = (stateno != [120,160]) && (stateno != [700,799])
trigger2 = gethitvar(damage)
value = 5000,0+(random%2)
channel = 0

[State -2, Burned]
type = PlaySnd
trigger1 = animelemtime(1) = 1
trigger1 = anim = 7697 || anim = 9015
value = S7697,0
[State -2, Burned]
type = PlaySnd
trigger1 = animelemtime(1) = 1
trigger1 = anim = 7697 || anim = 9015
value = S7697,1
[State -2, Burned]
type = PlaySnd
trigger1 = animelemtime(1) = 1
trigger1 = anim = 7697 || anim = 9015
value = S190,0
channel = 0

[State -2, Reset Taunt velocity storages]
type = null;VarSet
trigger1 = stateno != 195
trigger1 = (var(13):=0) || 1 ;Reset X
trigger1 = (var(14):=0) || 1 ;Reset Y
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = var(1) >= 2
triggerall = var(3) = 0
v = 3
value = 1

[State 0, PalFX]
type = PalFX
trigger1 = var(3) = 1
time = 3
add = 256,256,256
mul = 256,256,256
invertall = 0
color = 256
ignorehitpause = 1
[State 0, VarSet]
type = VarSet
trigger1 = var(3) = 1
v = 3
value = 2

[State 0, RemoveExplod]
type = RemoveExplod
triggerall = numexplod(195)
trigger1 = stateno != 195 && stateno != 3000
trigger2 = stateno = 3000 && (animelemtime(13) < 0 || animelemtime(22) >= 0)
id = 195
ignorehitpause = 1
[State 0, RemoveExplod]
type = RemoveExplod
triggerall = numexplod(100)
trigger1 = stateno != 100 && stateno != 105 && stateno != 1200
trigger2 = anim = [109,110]
trigger3 = stateno = 1200 && animelemtime(13) < 0 && statetype = A
trigger4 = stateno = 1200 && animelemtime(3) < 0 && statetype != A
id = 100
ignorehitpause = 1
[State 0, RemoveExplod]
type = RemoveExplod
triggerall = numexplod(2999)
trigger1 = stateno != [3300,3302]
id = 2999
ignorehitpause = 1

[State 0, StopSnd]
type = StopSnd
;triggerall = !time
trigger1 = stateno != 100 && stateno != 105 && stateno != 1200
channel = 1
ignorehitpause = 1
[State 0, StopSnd]
type = StopSnd
;triggerall = !time
trigger1 = stateno != 635 && stateno != 3302
channel = 2
ignorehitpause = 1
[State 0, StopSnd]
type = StopSnd
;triggerall = !time
trigger1 = stateno != 1300
channel = 3
ignorehitpause = 1

[State 0, VarAdd]
type = VarAdd
triggerall = command != "holdfwd" && command != "holdback" && command != "holddown"
trigger1 = stateno = [40,119]
trigger1 = stateno != [101,102]
v = 2
value = 1 
ignorehitpause = 1
[State 0, VarSet]
type = VarSet
trigger1 = stateno != 195 && stateno != [40,105]
trigger2 = stateno = [101,102]
trigger3 = command = "holdfwd" || command = "holdback" || command = "holddown"
v = 2
value = 0
ignorehitpause = 1

[State 0, Mach Reset]
type = VarSet
triggerall = var(1)
trigger1 = movetype = H
trigger2 = stateno != 1200 && stateno != 195 && (stateno != [245,251]) && (stateno != [645,646]) && (stateno != [40,115])
trigger3 = stateno = 1200 && animelemtime(13) < 0
v = 1
value = 0
[State 0, Mach Reset]
type = VarSet
triggerall = var(3)
trigger1 = movetype = H
trigger2 = stateno != 1200 && stateno != 195 && (stateno != [245,251]) && (stateno != [645,646]) && stateno != [40,115]
trigger3 = var(1) < 2
trigger4 = stateno = 1200 && animelemtime(13) < 0
v = 3
value = 0

[State 0, DisplayToClipboard]
type = Null;DisplayToClipboard
trigger1 = 1
text = "Vel Scale=%f Dmg Scale=%f SJ=%d throw=%d"
params = fvar(20), fvar(11), var(55), var(38)
ignorehitpause = 1

[State -2, Only losers use juggles!]
type = AssertSpecial
trigger1 = 1
flag = nojugglecheck
ignorehitpause = 1

[State -2, Reset juggle resets]
type = null;VarSet
trigger1 = !numtarget || enemy, movetype != H
trigger1 = (var(16):=0) || 1 ;Reset Uppercut reset
trigger1 = (var(8):=0) || 1 ;Reset Aerial IPS
trigger1 = (var(10):=0) || 1 ;Reset OTG IPS
trigger1 = (var(30):=0) || 1 ;Reset Super Taunt reset
;v = 16
;value = 0
ignorehitpause = 1

[State -2, Reset Additional movement options]
type = NUll;VarSet
trigger1 = statetype != A
trigger1 = (var(45):=0) || 1 ;Reset Air Jump
trigger1 = (var(53):=0) || 1 ;Reset Wall Jump
;v = 45
;value = 0
ignorehitpause = 1

[State -1, Reset Roman Cancel]
type = VarSet
v = 15
value = 0
trigger1 = var(7) != 0
trigger2 = (!numhelper(1000) && stateno != 1000) && (!numhelper(3000) && stateno != 3000)
trigger3 = movetype = H
[State -1, Reset Roman Cancel]
type = VarSet
fv = 7
value = 1
trigger1 = !numtarget || enemy, movetype != H

[State -2, Roman Cancel FX]
type = VarAdd
trigger1 = var(5) != 0
v = 5
value = -64
[State -2, Roman Cancel FX]
type = PalFX
trigger1 = var(5) != 0
time = 1
add = var(5),var(5),var(5)
mul = 256,256,256
sinadd = 0,0,0,1
invertall = 0
color = 256

[State 1020, Afterimage]
type = AfterImage
trigger1 = var(56) = 1
length = 12
PalBright   =  30,30,30
PalContrast =  35,35,35
PalAdd      = 25,25,25
PalMul      = .8,.8,.8
TimeGap  = 1
FrameGap = 3
Trans = Add
time = 2
[State 1020, Afterimage]
type = AfterImageTime
trigger1 = Vel Y < 0 || stateno = 195
trigger1 = var(56) > 0
time = 2
ignorehitpause = 1
[State 0, VarSet]
type = VarAdd
triggerall = var(56) < 2
trigger1 = movetype != H && prevstateno = 41
v = 56
value = 1
ignorehitpause = 1
[State 0, VarSet]
type = VarSet
triggerall = var(56) > 0
trigger1 = statetype = A
trigger1 = Vel Y >= 0 && stateno != 195
trigger2 = statetype != A
trigger3 = movetype = H 
trigger4 = stateno = [1000,3999]
v = 56
value = 0
ignorehitpause = 1

[State -2, Super jump Movement variable]
type = VarSet
trigger1 = stateno = 50 && vel Y <= -2.5
trigger1 = prevstateno = 41
v = 55
value = 1
ignorehitpause = 1
[State -2, Super jump Movement variable]
type = VarSet
trigger1 = statetype != A
trigger2 = movetype = H
trigger3 = (stateno = [1000,3999])
trigger4 = stateno = 707
trigger5 = stateno = 45 || stateno = 55 || stateno = 635
v = 55
value = 0
ignorehitpause = 1
[State -2, Move Right]
type = VelAdd
triggerall = stateno != 195
triggerall = statetype = A
triggerall = var(55) != 0
triggerall = Vel X < const(velocity.jump.fwd.x)
triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = command = "holdfwd" && command != "holdback" && !aiLevel
trigger2 = aiLevel && p2bodydist X > 30
x = const(velocity.jump.fwd.x)*0.3
[State -2, Move Left]
type = VelAdd
triggerall = stateno != 195
triggerall = statetype = A
triggerall = var(55) != 0
triggerall = Vel X > const(velocity.jump.back.x)
triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = command = "holdback" && command != "holdfwd" && !aiLevel
trigger2 = aiLevel && p2bodydist X < -30
x = const(velocity.jump.back.x)*0.3
[State 0, Turn]
type = Turn
triggerall = stateno != 195
triggerall = var(55) != 0
triggerall = p2dist X < 0
triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = (stateno = [600,640]) && ctrl
trigger2 = stateno = 615 || stateno = 50

;Velocity Deterioration system (Edited from RicePigeon's Damage Proration system)
[State -2, Reset velocity dampener]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,statetype!=A)
trigger2 = !numenemy
fvar(20) = 1.0
[State 0, Make sure it never goes under the limit]
type = VarSet
trigger1 = fvar(20) < 0.35
fv = 20 
value = 0.35
ignorehitpause = 1

;RicePigeon Damage Proration system
[State -2, Reset var when the opponent recovers]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(10) = 1.0
[State -2, Final Dampen]
type = null
trigger1 = (fvar(11) := ifelse(0.2>fvar(10),0.2,fvar(10))) || 1
ignorehitpause = 1
[State -2, Dampener itself]
type = Attackmulset
trigger1 = 1
value = fvar(11)
ignorehitpause = 1

;POTS Code
[State -2, Throws Disallowed]; Resets condition every tick to check again
type=varset
trigger1= 1
var(38)= 0
[State -2, Throws Disallowed]
type=varset
trigger1= (enemynear,stateno=[150,155])
trigger2= (enemynear,movetype=H && enemynear,statetype!=A) || enemynear,statetype = L
trigger3= (enemynear,stateno=[5020,5040]) && !(enemynear,hitfall)
trigger4= ((enemynear,stateno=0) || (enemynear,stateno=52)) && (enemynear,prevstateno=[5000,5040]) && ((enemynear,time<=0) || !(enemynear,ctrl))
trigger5= (enemynear,stateno=0) && (enemynear,prevstateno=52) && ((enemynear,time<=0) || !(enemynear,ctrl))
trigger6= (enemynear,stateno=40) && (enemynear,time>=1 || enemynear,prevstateno=0 || enemynear,prevstateno=52)
var(38)= 1

[State -2, P2 Safe Fall]
type= targetstate
trigger1 = numtarget = 1
trigger1 = target, command = "recovery"
trigger1 = target, pos y >= -48 && target, vel y > 0
trigger1 = target, alive && target, hitfall && target, gethitvar(fall.recover)
trigger1 = target,stateno=5030 || target,stateno=5035 || target,stateno=5050 || target,stateno=5071 || target,stateno=6030 || target,stateno=6035 || target,stateno=6050 || target,stateno=6071
value= 5205
ignorehitpause= 1

[State -2, P2 Facing]
type= targetfacing
trigger1= movecontact=1 && numtarget=1
trigger1= !(target,hitshakeover) && !(target,hitfall) && (target,time<=1)
value= ifelse(p2dist x>=0, -1, 1)
ignorehitpause= 1

[State 0, VarAdd]
type = VarAdd
trigger1 = var(6)
v = 6
value = -1
[State 0, VarAdd]
type = VarAdd
trigger1 = var(11)
v = 11
value = -1

;Wavedash stuff
[State -2, Wavedash Disable]
type = VarSet
triggerall = var(50)
trigger1 = statetype != A
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = stateno = 20 || stateno = [100,105]
trigger3 = stateno = [1000,1999]
trigger4 = stateno = 50
v = 50
value = 0
[State -2, Wavedash Traction]
type = VelMul
trigger1 = var(50)
trigger1 = statetype != A
x = .96
[State -2, Wavedash Physics]
type = StateTypeSet
trigger1 = !var(50)
trigger1 = statetype = S
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger1 = stateno != [1000,3999]
physics = S
[State -2, Wavedash Physics]
type = StateTypeSet
trigger1 = !var(50)
trigger1 = statetype = C
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger1 = stateno != [1000,3999]
physics = C
[State -2, Wavedash Physics]
type = StateTypeSet
trigger1 = var(50)
trigger1 = statetype != A
trigger1 = stateno != [1000,3999]
physics = N
[State -2, Can't walk during wavedash]
type = AssertSpecial
trigger1 = var(50)
trigger1 = abs(vel x) > 3
trigger1 = statetype != A
flag = nowalk

[State -1, Reset Airdodge var]
type = VarSet
v = 51
value = 0
trigger1 = statetype != A

;===========CUSTOM FALL STATES==============================================

[State -2, FALL.]
type = TargetState
triggerall = NumTarget = 1
triggerall = (target,stateno != [6020,6120])
trigger1 = target,stateno = 5020
value = 6020
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget = 1
triggerall = (target,stateno != [6020,6120])
trigger1 = target,stateno = 5050
value = 6050
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget = 1
triggerall = (target,stateno != [6020,6120])
trigger1 = target,stateno = 5070
value = 6070
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget = 1
triggerall = (target,stateno != [6020,6120])
trigger1 = target,stateno = 5080
value = ifelse(enemynear,alive && var(10)>=2, 6530, 6080) ;6080
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;POTS stuff
[State -3, Corner Push]; Reset
type= varset
trigger1= fvar(5)
trigger1= numtarget
trigger1= (target, hitover) || (target, gethitvar(hitshaketime) > 0 && target, time <= 0)
triggerall = stateno != 1150 && stateno != 3101
fvar(5)= 0
[State -3, Corner Push]; Get initial velocity
type= varset
trigger1= movecontact=1 && numtarget
fvar(5)= (target, gethitvar(xvel))
ignorehitpause= 1
[State -3, Corner Push]; Apply corner push
type= posadd
triggerall= fvar(5)
triggerall= (statetype = S || statetype = C) && numtarget
triggerall= !hitpausetime && (target, gethitvar(hitshaketime) <= 0)
triggerall= (target, statetype != L)
trigger1= target, frontedgebodydist <= abs(target, vel x)
trigger1= (target, gethitvar(xvel) * target, facing) > 0
trigger2= target, backedgebodydist <= abs(target, vel x)
trigger2= (target, gethitvar(xvel) * target, facing) < 0
x= ifelse(target, frontedgebodydist <= 0, -1, 1) * (target, facing) * fvar(5)
[State -3, Corner Push]; Apply friction to the velocity
type= varset
trigger1= numtarget
trigger1= target, gethitvar(hitshaketime) <= 0
fvar(5)= fvar(5) * 0.85

[State -3, Underground Juggle Prevention]
type = targetbind
trigger1 = movecontact = 1
trigger1 = numtarget = 1 && numenemy
trigger1 = target, time <= 0
trigger1 = target, ID = enemynear, ID
trigger1 = !(target, hitshakeover) && (target, pos y > 0)
pos = ceil(p2dist x), ceil(-pos y)
ignorehitpause = 1

[State -3, Variable Height]
type= playerpush
triggerall= statetype=A && movetype!=H && numenemy
triggerall= p2bodydist x = [-(enemynear,const(size.ground.back) + enemynear,const(size.ground.front)), 0]; checks if both characters are within each other's width
trigger1= p2statetype=S
trigger1= p2dist y >= (enemynear,const(size.height) - 28)
trigger2= p2statetype=C
trigger2= p2dist y >= (enemynear,const(size.height) - 49)
trigger3= p2statetype=L
trigger3= p2dist y >= 10
value= 0
ignorehitpause= 1