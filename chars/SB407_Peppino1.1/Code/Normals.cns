;---------------------------------------------------------------------------
; Match win pose
[Statedef 188]
type = S
anim = 180
ctrl = 0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
trigger1 = teammode = single || teammode = turns
value = S180,0
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = teammode = single || teammode = turns
flag = nomusic
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = teammode = single || teammode = turns
trigger1 = time < 480
trigger2 = teammode = simul
trigger2 = time < 120
flag = roundnotover

[State 185, Set Rank (Score)]
type = VarSet
trigger1 = !time && var(41) = 1
v = 18
value = cond(var(22) >= 75000, cond(var(23) >= 2, 1, 0), ifelse(var(22) >= 40000, 2, ifelse(var(22) >= 25000, 3, ifelse(var(22) >= 12000, 4, 5))))
[State 185, Set Rank (HP)]
type = VarSet
trigger1 = !time && var(41) > 1
v = 18
value = cond(var(22) >= 20000, 0, ifelse(var(22) >= 16000, 1, ifelse(var(22) >= 12000, 2, ifelse(var(22) >= 8000, 3, ifelse(var(22) >= 4000, 4, 5)))))

[State 0, Helper]
type = Helper
triggerall = !aiLevel
triggerall = time = 7.5 * tickspersecond
trigger1 = teammode = single
name = "Rank"
stateno = 4200
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0

[State 185, Victory Quotes (Generic)]
type=VictoryQuote
trigger1=1
value=1+random%5

[State 185, Victory Quotes (P Rank)]
type=VictoryQuote
triggerall = !aiLevel && (teammode = single || teammode = turns)
triggerall = var(41) > 0
trigger1=var(18) = 0 && var(23) != 0
value=6+random%5
[State 185, Victory Quotes (S Rank)]
type=VictoryQuote
triggerall = !aiLevel && (teammode = single || teammode = turns)
triggerall = var(41) > 0
trigger1=var(18) = 1
value=11+random%3
[State 185, Victory Quotes (A Rank)]
type=VictoryQuote
triggerall = !aiLevel && (teammode = single || teammode = turns)
triggerall = var(41) > 0
trigger1=var(18) = 2
value=14+random%3
[State 185, Victory Quotes (B Rank)]
type=VictoryQuote
triggerall = !aiLevel && (teammode = single || teammode = turns)
