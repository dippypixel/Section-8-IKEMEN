triggerall = enemynear(!enemynear,alive), statetype != L
triggerall = AILevel && var(42) > 0 && roundstate = 2 && alive
triggerall = (statetype = A && p2statetype = A) || (statetype != A && p2statetype != A)
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger1 = random < var(58)*.1
trigger2 = (stateno = [200,699]) && movehit
trigger2 = random < var(58)

[State -1, AIThrow]
type = ChangeState
value = 800
triggerall = enemynear(!enemynear,alive),statetype != L && enemynear(!enemynear,alive), statetype != A
triggerall = AILevel && var(42) > 0 && roundstate = 2 && alive
triggerall = (stateno != [100, 101])
triggerall = statetype != A 
triggerall = enemynear(!enemynear,alive), movetype != H && (enemynear(!enemynear,alive), stateno != [5000, 6999])
triggerall = p2bodydist x = [0,10]
triggerall = var(38) = 0
trigger1 = (ctrl) && random < var(58) * 4.5

[State -1, AIThrow2]
