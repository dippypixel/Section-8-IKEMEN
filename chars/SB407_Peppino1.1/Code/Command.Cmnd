trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger1 = random < var(58)*.1
trigger2 = (stateno = [200,441]) && stateno != 440 && movehit
trigger2 = random < var(58)
trigger2 = enemynear(!enemynear,alive),vel y >= 0
trigger3 = stateno = 1301 && !movecontact
