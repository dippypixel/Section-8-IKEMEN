[Statedef -1]

;------------------------------------------------------------------------
;AI START HERE

;AI DiffSet
[State -1, AI DiffSet]
type = VarSet
trigger1 = 1
var(58) = ifelse(var(42)=0, 0, (AiLevel=1)*3 + (AiLevel=2)*8 + (AiLevel=3)*12 + (AiLevel=4)*24 + (AiLevel=5)*48 + (AiLevel=6)*72 + (AiLevel=7)*108 + (AiLevel=8)*150)

;--------------------------------MOVEMENT--------------------------------
; AI Run
[State -1, AI Run]
type = ChangeState
value = 100
triggerall = p2bodydist X >= 90
triggerall = AILevel && var(42) > 0 && roundstate = 2 && alive
triggerall = stateno != [100,105]
trigger1 = statetype != A
trigger1 = ctrl
trigger1 = random < var(58)*2

; AI Belly Slide
[State -1, AI Belly Slide]
type = ChangeState
value = 245
triggerall = statetype != A
triggerall = AILevel && var(42) > 0 && roundstate = 2 && alive
triggerall = random < var(58)*8
triggerall = enemynear(!enemynear,alive),movetype != A
trigger1 = stateno = 100 && var(1) < 2 && p2bodydist X >= 240
trigger1 = time < 8
trigger2 = stateno = 1100 && p2bodydist X >= 240

; AI Super Jump
[State -1, AI Super Jump]
type = ChangeState
value = 41
triggerall = AILevel && movehit
trigger1 = stateno = 410 
trigger2 = stateno = 215
trigger2 = numtarget && target,statetype = A

[State -1, Errr...no?]
type = AssertSpecial
triggerall = AILevel && RoundState = 2
triggerall = alive
trigger1 = enemynear(!enemynear,alive), statetype = L && (p2bodydist x = [-50, 50])
flag = nowalk
ignorehitpause = 1
persistent = 1

;--------------------------------OFFENSE--------------------------------

;---------------------------------------------------------------------------
; AI Roman Cancel
[State -1, AI Roman Cancel - Activate]
type = Null;VarSet
v = 7
value = 1
triggerall = roundstate = 2
triggerall = power >= 500
triggerall = (stateno = [200, 699]) || (stateno = [1000, 1599]) || (stateno = [810,817]) || (stateno = [3000,3299]) 
triggerall = movetype != H
triggerall = aiLevel
trigger1 = stateno = 441 && (p2statetype != S && p2statetype != C)
trigger1 = movehit
trigger1 = random < var(58)*.35
trigger2 = stateno = 1000
trigger2 = movehit && animelemtime(12) > 0
trigger2 = random < var(58)*.5
trigger3 = moveguarded
trigger3 = stateno = 210 || stateno = 240 || stateno = 410 || stateno = 441 || stateno = 1200 && statetype != A || stateno = 1100
ignorehitpause = 1

;---------------------------------------------------------------------------
; Breaking Point
[State -1, AIBreaking Point]
type = ChangeState
value = 3300
triggerall = enemynear(!enemynear,alive), statetype != L
triggerall = AILevel && var(42) > 0 && roundstate = 2 && alive
triggerall = power >= 3000
triggerall = statetype != A
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger1 = random < var(58)*.005
trigger1 = p2bodydist X < 150 && p2bodydist y > -40
trigger2 = (stateno = [200,699]) || ((stateno = [1000,1999]) && (stateno != [1100,1199]))
trigger2 = movehit
trigger2 = random < var(58)*.75
trigger2 = p2bodydist X < 150 && p2bodydist y > -40

