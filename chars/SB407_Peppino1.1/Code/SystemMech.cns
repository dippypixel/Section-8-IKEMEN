;------------------------HITBOX----------------
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = anim != 102
movetype = I
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = anim = 102
trigger2 = anim = 101
trigger2 = animtime = 0
movetype = A

[State 200, 1]
type = HitDef
trigger1 = anim = 102
trigger1 = !movecontact && !moveguarded && !movereversed
attr = S, NA
damage = 145, 0
animtype = Back
guardflag = ;MA
hitflag = MAF
priority = 3, Hit
pausetime = 9,9
sparkno = 2
sparkxy = -10, ceil(-11*const(size.yscale))
hitsound = s5, 2
guardsound = s6, 0
getpower = ceil(125*fvar(7)), ceil(60*fvar(7))
givepower = 20, 20
ground.type = High
air.type = High
ground.slidetime = 24
ground.hittime  = 28
air.hittime = 28
guard.hittime = 48
airguard.hittime = 48
ground.velocity = -9, -11
air.velocity = -8,-8
guard.velocity = -6
airguard.velocity = -5,-4
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/fvar(20)
forcenofall = 1

[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
trigger1 = movehit
v = 21
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarSet
trigger1 = movehit
v = 20
value = 402
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = var(20) > 0 && var(20) < 402
trigger1 = movecontact && moveguarded && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0
[State 200, Add to Score]
type = VarAdd
trigger1 = movehit
v = 22
value = ceil((var(21)**2 * 0.25) + (var(21)*10))
ignorehitpause = 1
persistent = 0

[State 200, Damage Dampen]
type = varset
trigger1 = movehit
fvar(10) = fvar(10)*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.05
ignorehitpause = 1
persistent = 0

[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact
value =250

;-------------------------ETC--------------------
[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup" && var(1) < 3 && !aiLevel
value = 40
[State 100, 4]
type = ChangeState
triggerall = command = "holdback" && command != "holdfwd" && command != "holddown" && !aiLevel
trigger1 = anim = 99
trigger2 = anim > 99
trigger2 = time > 5
value = ifelse(anim != 99, 102, 105)
[State 100, 4]
type = ChangeState
triggerall = anim != 99
trigger1 = command != "holdfwd" && command != "holddown" && !aiLevel
trigger1 = var(2) > 5
trigger2 = time >= 5
trigger2 = aiLevel && p2bodydist x <= 75 && p2statetype != L && ((enemynear,stateno != [5100,5120]) && (enemynear,stateno != [6100,6120]))
value = 101
[State 100, 4]
type = ChangeState
triggerall = anim = 99
trigger1 = command != "holdfwd" && command != "holddown" && !aiLevel
trigger1 = var(2) > 5
trigger2 = time >= 5
trigger2 = aiLevel && p2bodydist x <= 75 && p2statetype != L && ((enemynear,stateno != [5100,5120]) && (enemynear,stateno != [6100,6120]))
value = 0
ctrl = 1

