trigger2 = anim > 104
trigger2 = time > 5
value = ifelse(anim != 104, 102, 100)
[State 100, 4]
type = ChangeState
trigger1 = command != "holdback" && command != "holddown"
trigger1 = anim != 104
trigger1 = var(2) > 5
value = 101
[State 100, 4]
type = ChangeState
trigger1 = command != "holdback" && command != "holddown"
trigger1 = anim = 104
trigger1 = var(2) > 5
value = 0
ctrl = 1
