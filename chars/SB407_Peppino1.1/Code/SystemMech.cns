trigger1 = anim = 100
trigger1 = animtime = 0
trigger2 = var(1) = 2
trigger2 = command != "holddown"
trigger2 = anim = 109
value = S100,2
channel = 1
loop = 1
[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 101
trigger1 = animtime = 0
trigger2 = var(1) = 3
trigger2 = command != "holddown"
trigger2 = anim = 109
value = S100,3
channel = 1
loop = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = command = "holddown"
trigger1 = anim != 109
value = 109

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(1) = 0
trigger1 = command != "holddown"
trigger1 = anim = 109
value = 99
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 99
trigger1 = animtime = 0
trigger2 = var(1) = 1
trigger2 = command != "holddown"
trigger2 = anim = 109
value = 100
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 100
trigger1 = animtime = 0
trigger2 = var(1) >= 2
trigger2 = command != "holddown"
trigger2 = anim = 109
value = 101
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 101
trigger1 = animtime = 0
value = 102

