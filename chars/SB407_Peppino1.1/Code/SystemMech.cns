; Run - Stop
[Statedef 101]
type    = S
physics = N
anim = ifelse(prevstateno = 105, 118, 117)
ctrl = 0
sprpriority = 1

;---------------------TRANSITION FROM SHOULDER BASH-------------------------
[State 0, PosSet]
type = velSet
trigger1 = prevstateno = 1200 && !time
y = 0
[State 0, PosSet]
type = PosSet
trigger1 = prevstateno = 1200 && !time
y = 0

;the rest
[State 0, VarSet]
type = VarSet
trigger1 = var(1) > 2
v = 1
value = 2

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S101,0

[State 0, VarSet]
type = VarSet
trigger1 = !time
v = 1
value = 0
[State 100, 1]
type = VelMul
trigger1 = 1
x = 0.9

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = !ailevel
trigger1 = command = "holdup"
trigger1 = prevstateno != 1200
value = 40
[State 100, 4]
type = ChangeState
triggerall = !ailevel
triggerall = AnimElemTime(2) < 0
trigger1 = cond(anim = 107, command = "holdfwd", command = "holdback")
trigger1 = prevstateno != 1200
value = 102
anim = ifelse(prevstateno = 100, 102, 103)
ctrl = ifelse(command = "holdfwd" && command != "holdback", 0, ifelse(command = "holdback" && command != "holdfwd", 0, 1))
[State 100, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(!ailevel && command = "holdfwd" && command != "holdback", 100, ifelse(!ailevel && command = "holdback" && command != "holdfwd", 105, 0))
ctrl = ifelse(!ailevel && command = "holdfwd" && command != "holdback", 0, ifelse(!ailevel && command = "holdback" && command != "holdfwd", 0, 1))

