;---------------------------------------------------------------------------
; Super Jump
[Statedef 41]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40, Explod]
type = Explod
trigger1 = AnimTime = 0 ;animelemtime(3) = 1
anim = 6850
pos = 0,0
postype = p1
removetime = -2
pausemovetime = -1
supermovetime = -1
sprpriority = -1
ownpal = 1
scale = ceil(const(size.xscale)),ceil(const(size.yscale))

[State 0, HitBy]
type = HitBy
trigger1 = !var(50)
value = SCA,NA,SA,HA,NP,SP,HP

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 52, Dust]
type = Explod
trigger1 = AnimTime = 0
anim = 8650
pos = 0, ceil(Pos Y)
postype = p1
removetime = -2
pausemovetime = -1
supermovetime = -1
sprpriority = 3
ontop = 1
ownpal = 1
scale = 2.2, 2.2
[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ceil(const(velocity.jump.y)*1.45)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 105 ;RUN_Back
trigger1 = sysvar(1) = -1
x = const(velocity.runjump.back.x)

[State 0, VarSet]
type = VarSet
trigger1 = AnimTime = 0
v = 56
value = 1
ignorehitpause = 1
[State 40, Jump SFX]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,0
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = N
anim = 99+var(1)
ctrl = 0
sprpriority = 1

;Sorting the controllers like this so it's a bit easier to navigate through ;)


;---------------------TRANSITION FROM SHOULDER BASH-------------------------
[State 0, PosSet]
type = velSet
trigger1 = prevstateno = 1200 && !time
y = 0
[State 0, PosSet]
type = PosSet
trigger1 = prevstateno = 1200 && !time
y = 0

;---------------------SFX-------------------------

[State 100, Mach 1]
type = PlaySnd
triggerall = prevstateno != 1200
trigger1 = anim = 99
value = S100,0
channel = 1
loop = 1
persistent = 0

[State 100, Mach 2 Start]
type = StopSnd
triggerall = prevstateno != 1200
trigger1 = anim = 100
channel = 1 
persistent = 0
[State 100, Mach 2]
type = PlaySnd
triggerall = prevstateno != 1200
trigger1 = anim = 100
value = S100,1
channel = 1
loop = 1
persistent = 0

[State 100, Mach 3 Start]
type = StopSnd
triggerall = prevstateno != 1200
trigger1 = anim = 101
channel = 1
persistent = 0
[State 100, Mach 3]
type = PlaySnd
triggerall = prevstateno != 1200
trigger1 = anim = 101
value = S100,2
channel = 1
loop = 1
persistent = 0

[State 100, Mach 4 Start]
type = StopSnd
triggerall = prevstateno != 1200
trigger1 = anim = 102
channel = 1
persistent = 0
[State 100, Mach 4]
type = PlaySnd
triggerall = prevstateno != 1200
trigger1 = anim = 102
value = S100,3
channel = 1
loop = 1
persistent = 0

;----------------VELOCITIES-----------
[State 100, Mach 1 Speed]
type = VelSet
trigger1 = anim = 99
x = const(velocity.run.fwd.x)*.75
[State 100, Mach 2 Speed]
type = VelSet
trigger1 = anim = 100
trigger2 = anim = 109
trigger2 = var(1) = 1
x = const(velocity.run.fwd.x)
[State 100, Mach 3 Speed]
type = VelSet
trigger1 = anim = 101
trigger2 = anim = 109
trigger2 = var(1) >= 2
x = const(velocity.run.fwd.x)*1.45
[State 100, Mach 4 Speed]
type = VelSet
trigger1 = anim = 102
x = const(velocity.run.fwd.x)*2

;----------------VARIABLES----------
[State 100, Mach 2]
type = VarSet
trigger1 = anim = 99
trigger1 = animtime = 0
v = 1
value = 1
[State 100, Mach 3]
type = VarSet
trigger1 = anim = 100
trigger1 = animtime = 0
trigger2 = var(1) >= 3
trigger2 = anim = 109
v = 1
value = 2
[State 100, Mach 4]
type = VarSet
trigger1 = anim = 101
trigger1 = animtime = 0
v = 1
value = 3


;------------------------ROLL----------------
[State 100, Roll Start]
type = StopSnd
trigger1 = anim = 109
trigger1 = animelemtime(1) = 1
channel = 1

[State 0, PlaySnd]
type = PlaySnd
triggerall = command = "holddown"
trigger1 = anim = 109
trigger1 = animelemtime(1) = 1
value = S110,0
channel = 1
loop = 1

[State 0, PlaySnd]
