;イントロ
[Statedef 190]
type = S
movetype = I
physics = S
ctrl = 0
velset = 0,0

[State 0, power]
type = powerset
trigger1 = roundsexisted = 0
trigger1 = !time
trigger1 = power < 1000
value = 1000

[State 191, 2]
type = AssertSpecial
trigger1 = 1
flag = Intro


[State 0, end]
type = changestate
triggerall = time = 0
trigger1 = p2name = "Diavolo"
value = 192


[State 0, end]
type = changestate
triggerall = time = 0
trigger1 = p2name = "Bruno"
value = 193


[State 0, end]
type = changestate
triggerall = time = 0
trigger1 = p2name = "Vinegar Doppio"
trigger2 = p2name = "Aceto Doppio"
trigger3 = p2name = "Doppio"
trigger4 = p2name = "rizotto"
trigger5 = p2name = "Magneto"
trigger6 = p2name = "Giorno"
trigger7 = p2name = "Polnareff"
value = 194


[State 0, end]
type = changestate
trigger1 = 1
value = 191 

;---------------------------------------------------------------------------
;イントロ（ノーマル）
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 2]
type = PlaySnd
trigger1 = time = 3
value = S2, 10
channel = 2


[State 191, アニメ変更];バトル画面に切り替わった瞬間のフェードインの時、アニメを固定している
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State -3]
type = powerset
trigger1 = Time = 0
trigger1 = power < 1000
value = 1000


[State 191, 特殊効果];試合が開始するまではこのコントローラを使おう（※２）
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態

[State 191, ステート変更];アニメーションが終われば「通常立ち」のステートに変更する
type = ChangeState
trigger1 = AnimTime = 0
value = 0



;---------------------------------------------------------------------------
;イントロ（特殊1）
