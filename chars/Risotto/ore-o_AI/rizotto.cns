[State 410, 一発目のヒット定義]
type = HitDef
trigger1 = time = 0
attr = C, NA
damage    = 50,2
animtype  = Medium
hitflag = MAF
guardflag = M
pausetime = 12,12
sparkno = S8040
guard.sparkno = S8050
sparkxy = -10,-65
hitsound   = s6,6
guardsound = s6,5
ground.type = Low
ground.slidetime = 12
ground.hittime  = 15
ground.velocity = -4
air.velocity = -3,-4







[State 410, ステート変更]
type = ChangeState
