physics = S
velset = 0,0


[State 192, 1]
type = assertspecial
trigger1 = 1
flag = Intro

[State -3]
type = powerset
trigger1 = Time = 0
trigger1 = power < 1000
value = 1000



[State 192, 2]
type = changeanim
triggerall = time > 0
trigger1 = enemy,time >= 10
trigger2 = time > 400
trigger3 = p2name = "Diavolo"
value = 192
persistent = 0

[State 192,2]
type = PlaySnd
trigger1 = time = 0
value = s2, 12
channel = 2


[State 0, end]
type = changestate
trigger1 = anim = 192 && !animtime
value = 0

