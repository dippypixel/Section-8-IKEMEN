;--------------
; VAR 5  - TEMP
; VAR 7  - ID OF FREEZE VICTIM
; VAR 8  - INFATUATION
; VAR 9  - ENABLE THIS TO REMOVE THIS CHARACTER FROM JESUSZILLAS ROSTER
; VAR 12 - SUPER COUNT
; VAR 15 - AI CHECK
; VAR 20 - XFACTOR ACTIVE
; VAR 21 - XFACTOR COUNTDOWN
; VAR 22 - XFACTOR CANCEL DISABLED
; VAR 30 - MAXIMA IS AVAILABLE
; VAR 31 - MAXIMA IS OKAY TIMER
; VAR 32 - MAXIMA ORDER
; VAR 40 - KULA IS AVAILABLE
; VAR 41 - KULA IS OKAY TIMER
; VAR 42 - KULA ORDER

; FVAR 10 - DAMAGE MUL
;--------------

; Stance
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = anim != [1,2]
trigger1 = anim > 5
value = ifelse(PrevStateNo>199,1+random%2,0)

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 5 && AnimTime = 0
value = 0
elem = 3
 
;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type = S
physics = S
ctrl = 0
velset = 0,0
facep2 = 1
sprpriority = 1

[State 100, Kino]
type = VarSet
trigger1 = !time
var(4) = 0
[State 100, Karin]
type = VarSet
trigger1 = command = "x"
var(4) = 1
[State 100, Karin]
type = VarSet
trigger1 = command = "y"
var(4) = 2
[State 100, Karin]
type = VarSet
trigger1 = command = "z"
var(4) = 3
[State 100, Karin]
type = VarSet
trigger1 = command = "a"
var(4) = 4
[State 100, Karin]
type = VarSet
trigger1 = command = "b"
var(4) = 5
[State 100, Karin]
type = VarSet
trigger1 = command = "c"
var(4) = 6

[State 40, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = 40

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 1]
type = VarSet
triggerall = sysvar(1)
trigger1 = command = "hijump" && command != "chargedhijump"
trigger2 = PrevStateNo = 101 && sysvar(1) = 1
var(2) = 1
[State 40, 1]
type = VarSet
trigger1 = PrevStateNo = 101 && sysvar(1) = -1
var(2) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(3) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(3) = 2

[State 40, 6]
type = VelSet
triggerall = !var(2)
trigger1 = AnimTime = 0
trigger2 = var(4) && time > 0
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)
[State 40, 7]
type = VelSet
triggerall = var(2)
trigger1 = AnimTime = 0
trigger2 = var(4) && time > 0
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = const(velocity.jump.y)

;--------------------------[APPROPIATE ATTACK STATE]----------------------------
[State -1, A L P]
type = ChangeState
value = 600
trigger1 = var(4) = 1 && time > 0
[State -1, A M P]
type = ChangeState
value = 610
trigger1 = var(4) = 2 && time > 0
[State -1, A H P]
type = ChangeState
value = 620
trigger1 = var(4) = 3 && time > 0
[State -1, A L K]
type = ChangeState
value = 700
trigger1 = var(4) = 4 && time > 0
[State -1, A M K]
type = ChangeState
value = 710
trigger1 = var(4) = 5 && time > 0
[State -1, A H K]
type = ChangeState
value = 720
trigger1 = var(4) = 5 && time > 0
;-------------------------------------------------------------------------------

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0 && command = "holdup"
value = 50
ctrl = 1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0 && Var(3) = 2
value = 41
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type = A
physics = N

[State 50, 1]
type = VarSet
trigger1 = Time = 1
sysvar(1) = 0

[State 40, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S2,4

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, VelAdd]
type = VelAdd
trigger1 = time > 0
y = const(movement.yaccel)

[State 40, 6]
type = ChangeState
trigger1 = Vel Y + Pos Y >= 0
value = 52
ctrl = 1

;---------------------------------------------------------------------------
; Short Jump
[Statedef 41]
type = A
physics = N

[State 0, VelMul]
type = VelMul
trigger1 = !Time
y = 0.75

[State 1101, pos]
type = VelAdd
trigger1 = time > 0
y = const(movement.yaccel)

[State 40, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S2,3

[State 50, 1]
type = VarSet
trigger1 = Time = 1
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 51, ifelse((vel x)>0, 52, 53))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 40, 6]
type = ChangeState
trigger1 = Vel Y + Pos Y >= 0
value = 52
ctrl = 1

