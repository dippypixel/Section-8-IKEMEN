[State win]
type = Helper
triggerall = TeamMode = Single
triggerall = MatchOver = 1
triggerall = stateno != 185
trigger1 = stateno = 181
trigger1 = numhelper(33333) = 0
id = 33333
name = "super"
stateno = 33333
postype = back
pos = 160,0
ownpal = 1
supermovetime = 78

[State 600]
type = Explod
trigger1 = time >= 0
trigger1 = GameTime % 15 = 0
trigger1 = var(7) = 1
anim = 6000
id = 1
pos = 20-random%40,-20-random%40
postype = p1
vel = 0 ,-1.6
sprpriority = 2
bindtime = 1

[State 3000,00]
type = powerset
trigger1 = var(11) = 1
value = 0

