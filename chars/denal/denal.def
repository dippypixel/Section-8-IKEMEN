; Definition file for Kung Fu Man
; Contains all the filenames needed for the characterk

; Player information
[Info]
name = "Denal"        ;Name of character
displayname = "Denal" ;Name of character to display
versiondate = 04,14,2002    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Camisback9902 (A Spriteswap of Osjama Chaos"         ;Character author name
pal.defaults = 12     ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = ojisama_c.cmd   ;Command set
cns     = ojisama_c.cns   ;Constants
st      = ojisama_c.cns   ;States
st2      = common.cns   ;States
st3      = ojizone.cns
stcommon = common1.cns ;Common states
sprite  = ojisama_c.sff   ;Sprite
anim    = ojisama_c.air   ;Animation
sound   = ojisama_c.snd   ;Sound
pal1    = denal1.act  ;Palettes (can have up to 12)
pal2    = denal2.act 
pal3    = denal3.act 
pal4    = denal4.act
pal5    = denal5.act
pal6    = denal6.act
pal7    = denal7.act
pal8    = denal8.act
pal9    = denal9.act
pal10    = denal10.act
pal11    = denal11(LETSMAKEITATHING.act
pal12    = denal12.act

; Arcade mode
[Arcade]
;intro.storyboard =
;ending.storyboard = 
