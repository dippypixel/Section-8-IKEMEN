[Statedef 200]
type = S
movetype = A
physics = S
ctrl = 0
anim = ifelse((prevstateno=[100,105]),201,200)
poweradd = 0
sprpriority = 0

[State 0, vel]
type = velset
trigger1 = !time
trigger1 = prevstateno != [100,105]
trigger2 = animelemtime(6) = 1
x = 0

[State 0, snd]
type = playsnd
trigger1 = animelem = 3
value = 0,10

[State 0, vel]
type = veladd
triggerall = movecontact = 1
trigger1 = numtarget(200)
trigger1 = target(200),statetype != A
trigger1 = target(200),backedgebodydist <= 0 || target(200),frontedgebodydist <= 0
x = -6.5*ifelse(prevstateno=100,.8,ifelse(prevstateno=105,1.2,1))
persistent = 0

[State 0, hit]
type = hitdef
trigger1 = animelem = 3
attr = S, NA
damage = ceil(ifelse((19*fvar(0))<6,6,(19*fvar(0)))),0
priority = 3,Hit
hitflag = MAF
guardflag = M
animtype = Light
air.animtype = Back
fall.animtype = Back
pausetime = 9,9
sparkno = s6000
sparkxy = -8,-78
guard.sparkno = s6010
hitsound = s0,0
guardsound = s0,9
getpower = 20*!(var(9)=2),0
givepower = 10*!(var(9)=2),0
ground.type = High
ground.slidetime = 12
ground.hittime = 12
ground.velocity = -5
guard.velocity = -5
air.type = High
air.velocity = -4,ifelse(var(40)<12,-1.8+(var(40)*.15),0)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
air.hittime = 12
fall = 0
air.fall = 0
yaccel = .36
id = 200

[State 0, ctrl]
type = ctrlset
trigger1 = prevstateno != [100,105]
trigger1 = animtime = -2
value = 1

[State 0, end]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

