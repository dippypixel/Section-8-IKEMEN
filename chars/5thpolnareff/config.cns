anim = 20000

;[スタンドゲージ位置調整]
;===========================================================================
;手動調整:横軸（var(4) = ○←数値を変更してください）
[state 0, var]
type = parentvarset
trigger1 = 1
var(4) = 0
;===========================================================================
;手動調整:縦軸（var(5) = ○←数値を変更してください）
[state 0, var]
type = parentvarset
trigger1 = 1
var(5) = 0
;---------------------------------------------------------------------------
;自動調整:縦軸（パートナーのスタンドゲージと重なる場合自動で動かします）
;必要ない場合は 2段目の"trigger1 = ○"の数値を変更してください 1:ON/0:OFF
[state 0, var]
type = parentvarset
trigger1 = root,var(57)
trigger1 = 1
var(5) = 18

;===========================================================================
[State 0, end]
type = DestroySelf
trigger1 = 1
