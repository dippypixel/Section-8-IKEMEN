;===========================================================================
; ふっ飛ばし（共通）P2ステート
;===========================================================================

;吹っ飛ばされ部分
[Statedef 1900]
type = A		;空中
movetype= H		;ダメージ受けてる
physics = N		;摩擦なし

[State 1900];少し空中に浮かす
type = posSet
trigger1 = time = 0
y = -15

[State 1900,Velset];吹っ飛ばしの速度
type = VelSet
trigger1 = time = 0
x = -10
y = 0

[State 1900,ChangeAnim2];吹っ飛ばし中のアニメ
type = ChangeAnim2
trigger1 = time = 0
value = 5030

[State 1900, スクロール]
type = ScreenBound
triggerall = Pos x != 0
trigger1 = BackEdgeBodyDist < 15
trigger2 = FrontEdgeBodyDist < 15
value = 0         ;画面スクロールの影響を受けるか否か。0=受けない・1=受ける
movecamera = 0,1  ;カメラの動きをキャラに依存させるか否か。0=させない・1=させる（Ｘ軸,Ｙ軸）

[State 1900];端っこまできたら
type = ChangeState
trigger1 = BackEdgeBodyDist <= 20
trigger2 = FrontEdgeBodyDist <= 20
value = 1901

;壁ヒットの処理
[Statedef 1901]
movetype = H

[State 1901];壁ヒットエフェクト
type = Explod
trigger1 = Time = 0
anim = F72
pos = 0, floor(screenpos y) - 50
postype = back
sprpriority = 3

[State 1901];衝突音（ダウン大）
type = PlaySnd
trigger1 = Time = 0
value = 10,10

[State 1901]
type = ChangeState
trigger1 = AnimTime = 0
value = 1902

;壁ヒット後の処理
[Statedef 1902]
type    = A
movetype= H
physics = N

[State 1902];追撃不可
type = NotHitBy
trigger1 = 1
value = , NA, NP

[State 1902];一度空中に浮かせて
type = VelSet
trigger1 = Time = 0
y = -6

[State 1902];少し戻して
type = VelSet
trigger1 = Time = 0
x = 1.6

[State 1902];向きも変えて
type = Turn
trigger1 = (Time = 0) && (BackEdgeDist < 30)

[State 1902];重力を加える
type = VelAdd
trigger1 = 1
y = .35

[State 1902];地面に落ちたら
type = SelfState
trigger1 = (Vel y > 0) && (Pos y >= 0)
value = 5110

;===========================================================================
; 超必殺技
;===========================================================================

;シャボンレンズ開始
[Statedef 3000]
type    = S		;S(立ち) C(しゃがみ) A（空中） L(倒れ) U(前のステートと一緒)
movetype= A		;A(攻撃) I（通常動作）H（ダメージ）U(前のステートと一緒)
physics = N		;S 立っている時の摩擦係数  C しゃがんでいる時の摩擦係数  A 重力加速度  N いずれの影響も受けない
juggle  = 1		;事前に設定したairjuggleの値からここで設定した値を引いていき、値が０以下になるまで
velset = 0,0		;ステートの移動速度を設定します。(X軸方向の速度,Y軸方向の速度)と記述します。
ctrl = 0		;キー入力をうけつけるかどうかを設定します。0(受け付けない) 1(受け付ける)
anim = 1400
poweradd = -1000		;このステートで表示するアニメーションの番号を決定します。
;↑シャボンランチャー
sprpriority = 2		;ステートの表示順を設定します。値が大きいほど手前に表示されます。
face = 1

