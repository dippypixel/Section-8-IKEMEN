;kougeki
;===========================================================================
; 通常攻撃技
;===========================================================================
;立ち弱攻撃
[Statedef 200]
type    = S		;S(立ち) C(しゃがみ) A（空中） L(倒れ) U(前のステートと一緒)
movetype= A		;A(攻撃) I（通常動作）H（ダメージ）U(前のステートと一緒)
physics = S		;S 立っている時の摩擦係数  C しゃがんでいる時の摩擦係数  A 重力加速度  N いずれの影響も受けない
juggle  = 3		;事前に設定したairjuggleの値からここで設定した値を引いていき、値が０以下になるまで
velset = 0,0		;ステートの移動速度を設定します。(X軸方向の速度,Y軸方向の速度)と記述します。
ctrl = 0		;キー入力をうけつけるかどうかを設定します。0(受け付けない) 1(受け付ける)
anim = 200		;このステートで表示するアニメーションの番号を決定します。
;poweradd = 10		;このステートに入った瞬間に増えるパワーの量を決定します。
sprpriority = 2		;ステートの表示順を設定します。値が大きいほど手前に表示されます。
facep2 = 1

[State 200,空振り音]
type = PlaySnd
trigger1 = Time = 1
value = 10, 0

[State 200,掛け声];ふっ
type = PlaySnd
trigger1 = Time = 1
value = 60, 0

[State 200, ヒット定義]
type = HitDef			;ヒット定義
trigger1 = AnimElem = 3
attr = S, NA 			;立ち通常打撃（Standing, Normal Attack）
	;攻撃の属性を設定します。
	;S, NAのように記述します
	;１文字目は攻撃の状態でS(立ち),C(しゃがみ),A(空中)のいずれか
	;２文字目は攻撃の属性でN(通常),S(特殊),H(超必殺)のどれか
	;３文字目は攻撃の種類でA(通常攻撃),T(投げ),P(飛び道具)のどれか
	;を選択してください。
	;S, NAだと立ちの通常攻撃　
	;C,HPだとしゃがみの超必殺の飛び道具という意味になります。
damage = 14, 0			;ヒットした時のダメージ, ガードされたときのダメージ
animtype = Light
;当たった時の相手のアニメの種類: Light, Medium, Hard, Back, Up, DiagUp (デフォルト：Light)
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 8, 8		;攻撃がヒットした時の硬直時間を指定します。
sparkno = s6000
sparkxy = -15, -89
hitsound = s2, 50
guardsound = s6, 0
guard.sparkno = s6040
ground.type = high
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -4
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -1.4,-3
air.hittime = 12

[State 200, ステート変更]
type = ChangeState		;他のステートに移動(ここオワリ)
trigger1 = AnimTime = 0		;Animtime=0で、アニメーションが終わった時という意味
value = 0			;移動先の[ステート]の番号を記入
ctrl = 1			;キー入力をうけつけるかどうかを設定します。0(受け付けない) 1(受け付ける)



;立ち弱攻撃2
[Statedef 205]
type    = S		;S(立ち) C(しゃがみ) A（空中） L(倒れ) U(前のステートと一緒)
movetype= A		;A(攻撃) I（通常動作）H（ダメージ）U(前のステートと一緒)
physics = S		;S 立っている時の摩擦係数  C しゃがんでいる時の摩擦係数  A 重力加速度  N いずれの影響も受けない
juggle  = 3		;事前に設定したairjuggleの値からここで設定した値を引いていき、値が０以下になるまで
velset = 0,0		;ステートの移動速度を設定します。(X軸方向の速度,Y軸方向の速度)と記述します。
ctrl = 0		;キー入力をうけつけるかどうかを設定します。0(受け付けない) 1(受け付ける)
anim = 205		;このステートで表示するアニメーションの番号を決定します。
sprpriority = 2		;ステートの表示順を設定します。値が大きいほど手前に表示されます。
facep2 = 1

[State 205,空振り音]
type = PlaySnd
trigger1 = Time = 1
value = 10, 0

[State 205,掛け声];ふっ
type = PlaySnd
trigger1 = Time = 1
value = 60, 0

[State 205, ヒット定義]
type = HitDef			;ヒット定義
trigger1 = AnimElem = 3
attr = S, NA 			;立ち通常打撃（Standing, Normal Attack）
	;攻撃の属性を設定します。
	;S, NAのように記述します
	;１文字目は攻撃の状態でS(立ち),C(しゃがみ),A(空中)のいずれか
	;２文字目は攻撃の属性でN(通常),S(特殊),H(超必殺)のどれか
	;３文字目は攻撃の種類でA(通常攻撃),T(投げ),P(飛び道具)のどれか
	;を選択してください。
	;S, NAだと立ちの通常攻撃　
	;C,HPだとしゃがみの超必殺の飛び道具という意味になります。
damage = 18, 2			;ヒットした時のダメージ, ガードされたときのダメージ
animtype = Light
;当たった時の相手のアニメの種類: Light, Medium, Hard, Back, Up, DiagUp (デフォルト：Light)
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 8, 8		;攻撃がヒットした時の硬直時間を指定します。
sparkno = s6000
sparkxy = -10, -76
hitsound = s10, 3
guardsound = s6, 0
guard.sparkno = s6040
ground.type = high
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -4
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -1.4,-3
air.hittime = 12

[State 205, ステート変更]
type = ChangeState		;他のステートに移動(ここオワリ)
trigger1 = AnimTime = 0		;Animtime=0で、アニメーションが終わった時という意味
value = 0			;移動先の[ステート]の番号を記入
ctrl = 1			;キー入力をうけつけるかどうかを設定します。0(受け付けない) 1(受け付ける)

