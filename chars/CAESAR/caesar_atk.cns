;===========================================================================
; 投げ技
;===========================================================================

;マイナスの波紋（掴み）
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2

[State 800, 音を鳴らす];波紋ッ！
type = PlaySnd
trigger1 = Time = 1
value = 30, 0

[State 800, ヒット定義（投げ用）]
type = HitDef
trigger1 = Time = 0
attr = S, NT ;立ち通常投げ（Standing, Normal Throw）
hitflag = M-  ;マイナスが付加されてるので相手が食らい中の時は掴めない
priority = 1, Miss
sparkno = -1  ;-1だからヒットスパークは表示しない
p1sprpriority = 1
p1facing = ifelse (command = "holdfwd", 1, -1)
p2facing = 1
p1stateno = 810
p2stateno = 820
guard.dist = 0 ;相手のガード態勢に入る距離を０にしてるので、ガード不可
fall = 1
fall.recover = 0

[State 800, ステート変更]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;プラスの波紋：成功
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810

[State 810, 音を鳴らす];ビリビリ
type = PlaySnd
trigger1 = Time = 1
value = 10, 15

[State 810, 音を鳴らす];掴み効果音
type = PlaySnd
trigger1 = Time = 1
value = 10, 12

[State 810, 音を鳴らす];流し込んでやるッ
type = PlaySnd
trigger1 = Time = 30
value = 30, 18

[State 810, 変数];「holdfwd」のコマンドが入力されているかどうかを判断する
type = VarSet
trigger1 = Time = 0
var(2) = command = "holdfwd"

[State 810, 1]
type = TargetBind
trigger1 = time = 0
pos = 25, -20;固定する座標を指定してください。
time=30;固定する時間を指定してください。

[State 810, 物理的なキャラの幅]
type = Width
trigger1 = time < 30
edge = 30,0
value =30,15

[State 810, エフェクト];波紋（接点）
type = Explod
trigger1 = Time = [1,30] ;１～30フレームの間、毎フレーム有効にする。
trigger1 = NumExplod(830) <= 0
anim = 830
facing = 1
postype = p1
pos = 30,-50
sprpriority = 4
ownpal = 1
bindtime = -1       ;「このエフェクトを発生させた親」に『くっ付ける時間』（フレーム）
                   ;postypeに依存。-1なら常にくっ付ける事になる。
removetime = -1 ;「-1」なのでアニメーションが終わらず常に繰り返す
removeongethit = 1
ID = 830

[State 810, エフェクト];波紋（相手）
type = Explod
trigger1 = Time = 0
trigger1 = NumExplod(831) <= 0
anim = 831
trans = add
facing = 1
postype = p2
pos = 0,-30
sprpriority = 4
ownpal = 1
scale = 2 ,2		;***徐々に小さくする為、ここ変更予定***
bindtime = -1       ;「このエフェクトを発生させた親」に『くっ付ける時間』（フレーム）
                   ;postypeに依存。-1なら常にくっ付ける事になる。
removetime = 56
removeongethit = 1
ID = 831

;相手が食らい状態の時のみ機能するTarget系コントローラ
[State 810, 掴んだ相手のライフ増減]
type = TargetLifeAdd
trigger1 = AnimElem = 2
value = -78

[State 810, 掴んだ相手のステート変更]
type = TargetState
trigger1 = AnimElem = 2
value = 821

[State 810, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;プラスの波紋：相手側１（掴まれて放り投げられるまで）
[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 相手のアニメ変更]
