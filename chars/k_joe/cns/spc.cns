;---------------------------------------------------------------------------
; QCB+P
[Statedef 1000]
type    = S
movetype= A
physics = S
ctrl = 0
velset = 0,0
poweradd = 56
anim = 1000
sprpriority = 2

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 5
value = ifelse(command = "y"||Var(15),1,0)

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !Time
trigger1 = Var(5)
value = 1001
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 1001
value = 1002
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Time >= 40
trigger1 = Anim = 1002
value = 1003

[State 200, Swing Rapid]
type = PlaySnd
trigger1 = Anim = 1002
trigger1 = GameTime%2 = 0
value = S0, 1
channel = GameTime%4
ignorehitpause = 1
[State 200, Swing Heavy]
type = PlaySnd
triggerall = Anim = 1000 || Anim = 1003
trigger1 = AnimElem = 3
value = S0, 2
channel = 1
[State 200, Hit Rapid]
type = PlaySnd
trigger1 = Var(8) = 1
value = S1, 2
channel = 3 + GameTime%3
ignorehitpause = 1

[State 0, Explod Big Swing]
