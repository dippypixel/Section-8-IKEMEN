trigger1 = Var(8) = 1
anim = ifelse(MoveGuarded,7020,7000)
pos = -random%16,-64-floor(P2Dist Y)-random%16
postype = p2
pausemovetime = 666
supermovetime = 666
scale = 1.5,1.5
sprpriority = 9
ontop = 1
ownpal = 1
ignorehitpause = 1

[State 0, Helper]
