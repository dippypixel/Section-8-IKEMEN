trigger1 = Anim = 1000
trigger1 = AnimElem = 4
trigger2 = Anim = 1003
trigger2 = AnimElem = 4
anim = 1011
pos = 16,-96
removetime = 2
scale = 2,2
sprpriority = 9
removeongethit = 1
[State 0, Explod Quick Punches]
