trigger1 = Anim = 1002
anim = 1015
pos = 52+(GameTime*3)%9,-64-(GameTime*7)%17
vel = 24,0
accel = -3,0
removetime = 5
;scale = 2,2
sprpriority = 3
removeongethit = 1
ignorehitpause = 1

[State 0, HitDef]
type = HitDef
triggerall = Var(5)
trigger1 = Time%4 = 0
attr = S,SA
hitflag = MAF
guardflag = MA
animtype = medium
priority = 3,Hit
damage = Ceil(4*FVar(10)),1
pausetime = 2,2+Var(9)*4
sparkno = s8000
guard.sparkno = s8100
sparkxy = -8,-72
hitsound = -1;S1,0
guardsound = -1;S2,0
ground.type = High
ground.slidetime = 14
ground.hittime = 14
guard.hittime = 7
air.hittime = 14
yaccel = 0.5
ground.velocity = 0,0
air.velocity = -0.25,-1.66
airguard.velocity = -1,0
getpower = 32,16
givepower = 8,4
palfx.time = 2
palfx.invertall = 1

[State 0, Explod HitSpark S]
