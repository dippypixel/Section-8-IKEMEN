y = const(velocity.airjump.y)

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 2
value = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S5,4

[State 0, Explod]
type = Explod
trigger1 = !Time
anim = 7045
pos = 8,-24
vel = 8,-4
removetime = -2
sprpriority = -1
ownpal = 1
scale = 1.5,1.5
[State 0, Explod]
type = Explod
trigger1 = !Time
anim = 7045
pos = -8,-24
facing = -1
vel = -8,-4
removetime = -2
sprpriority = -1
ownpal = 1
scale = 1.5,1.5

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 5
value = 50
[State 0, VarSet]
type = VarSet
trigger1 = command = "x" && !Var(15)
trigger2 = Var(15) && EnemyNear,MoveType = H && P2BodyDist X < 64
v = 5
value = 600
[State 0, VarSet]
type = VarSet
trigger1 = command = "y" && !Var(15)
v = 5
value = 610 
[State 0, VarSet]
type = VarSet
trigger1 = command = "a" && !Var(15)
v = 5
value = 700
[State 0, VarSet]
type = VarSet
trigger1 = command = "b" && !Var(15)
v = 5
value = 710 

[State 45, 7]
type = ChangeState
trigger1 = Time = 1
value = Var(5)
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 41

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 3
value = 0
[State 0, VarSet]
type = VarSet
trigger1 = command != "holdup"
trigger1 = Var(2) = 1
v = 3
value = 1
[State 0, VarSet]
type = ChangeState
trigger1 = command = "holdup"
trigger1 = Var(3) = 1 && Var(2) = 1
value = 45
ctrl = 0

