;---------------------------------------------------------------------------
; Run F
[Statedef 100]
type    = S
physics = N
anim = 100
ctrl = 0
sprpriority = 1

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 0, Explod]
type = Explod
trigger1 = !Time
trigger2 = Time = 2
anim = 7100
vel = -8,cos(floor(GameTime%8)*45)*1
removetime = -2
sprpriority = 9
ownpal = 1
scale = 1.5,1.5

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S5,0

[State 100, 1]
type = VelSet
trigger1 = Time < 3
x = const(velocity.run.fwd.x)*0.33
[State 100, 1]
type = VelSet
trigger1 = Time >= 3
x = const(velocity.run.fwd.x)

[State 100, 4]
type = ChangeState
;triggerall = Time >= 5
trigger1 = (command = "holdup" || command = "up") && Var(15) = 0
value = 40

[State 100, 4]
type = ChangeState
triggerall = Time > 10
trigger1 = command != "holdfwd" && Var(15) = 0
trigger2 = Var(15) && P2BodyDist X < 8
trigger3 = FrontEdgeDist < 8
value = 101

;---------------------------------------------------------------------------
; Run Stop
[Statedef 101]
type    = S
physics = N
anim = 101
ctrl = 1
sprpriority = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S5,1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Vel X > 2
value = Anim

[State 0, VelMul]
type = VelMul
trigger1 = 1 
x = 1-(Time*0.05)

[State 0, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Dash B
[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S5,2

[State 0, Explod]
type = Explod
trigger1 = !Time
trigger2 = Time = 2
anim = 7100
vel = 8,cos(floor(GameTime%8)*45)*1
removetime = -2
sprpriority = 9
ownpal = 1
scale = 1.5,1.5

[State 105, Vel Dashing]
type = VelSet
trigger1 = Time <= 2
x = const(velocity.run.back.x)*0.2
[State 105, Vel Dashing]
type = VelSet
trigger1 = Time = 3
x = const(velocity.run.back.x)
[State 0, VelMul]
type = VelMul
trigger1 = Time < 12
x = 0.975
[State 0, VelMul]
type = VelMul
trigger1 = Time >= 12
x = 0.8

[State 0, NotHitBy]
type = NotHitBy
trigger1 = !Time
value = ,NA,SA,HA,NP,SP,HP
time = 4

[State 105, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Dodge
[Statedef 110]
type    = S
physics = N
anim = 110
velset = 0,0
ctrl = 0
sprpriority = 1

[State 0, PlayerPush]
type = PlayerPush
trigger1 = AnimElemNo(0) = [2,6]
trigger2 = Anim != 110
trigger2 = AnimElemNo(0) = 7
value = 0

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = !Time
trigger1 = command = "holdback"
value = 112
[State 0, ChangeAnim]
type = ChangeAnim
triggerall = !Time
trigger1 = command = "holdfwd"
value = 111

[State 0, NotHitBy]
type = NotHitBy
trigger1 = Time >= 2 && Time <= 25
value = ,NA,SA,HA,NP,SP,HP
time = 1

[State 0, VelSet]
type = VelSet
trigger1 = Anim != 110
trigger1 = AnimElemNo(0) = [3,5]
x = ifelse(anim=112,-4.5,5)

[State 0, VelMul]
type = VelMul
trigger1 = Anim != 110
trigger1 = AnimElemNo(0) >= 6
x = 0.8

[State 105, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

