;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 1 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
trigger3 = Anim <= 1 && AnimTime = 0
value = random%2

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0, 5] ;Are you floating?
type = ChangeState
trigger1 = pos y < 0
value = 50

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
facep2 = 1
anim = 40
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
v = 2
value = 1

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd" || Var(15)
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback" && !Var(15)
sysvar(1) = -1

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 5
value = 50
[State 0, VarSet]
type = VarSet
trigger1 = command = "x" && !Var(15)
trigger2 = Var(15) && EnemyNear,MoveType = H && P2BodyDist X < 64
v = 5
value = 600
[State 0, VarSet]
type = VarSet
trigger1 = command = "y" && !Var(15)
v = 5
value = 610 
[State 0, VarSet]
type = VarSet
trigger1 = command = "a" && !Var(15)
v = 5
value = 700
[State 0, VarSet]
type = VarSet
trigger1 = command = "b" && !Var(15)
v = 5
value = 710 

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S5,4

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.jump.fwd.x)*2

[State 0, Explod]
type = Explod
trigger1 = AnimTime = 0
anim = 7040
pos = -16+(sysvar(1) = -1)*32,-16
vel = -4+(sysvar(1) = -1)*8,-5
accel = 0,-0.5
removetime = -2
sprpriority = 3
ownpal = 1
scale = 1.5,1.5

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = Var(5);50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
