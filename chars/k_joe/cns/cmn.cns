x = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 0, Snd]
type = PlaySnd
trigger1 = Time = 0
value = S5,6

[State 0, Explod]
type = Explod
trigger1 = !Time
anim = 7047
vel = sin(GameTime%8*45)*6,cos(floor(GameTime%8)*45)*6
accel = sin(GameTime%8*45)*-1,cos(floor(GameTime%8)*45)*-1
removetime = -2
sprpriority = 9
ownpal = 1
scale = 1.5,1.5

[State 52, 3]
type = CtrlSet
trigger1 = Time = 2
value = 1

[State 52, 5]
