;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = Var(15)
sysvar(1) = 1
[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
trigger1 = !Var(15)
sysvar(1) = -1

[State 40, Var Jump Count]
type = VarSet
trigger1 = Time = 0
v = 4
value = 1

[State 40, Var Jump Height]
type = VarSet
trigger1 = Time = 0
v = 2
value = 1
[State 40, Var Jump Height]
type = VarSet
trigger1 = command != "holdup"
trigger1 = !Var(15)
v = 2
value = 0

[State 0, Var Buffer Reset]
type = VarSet
trigger1 = Time = 0
v = 6
value = 0
[State 0, Var Buffer 1]
type = VarSet
trigger1 = command = "x"
v = 6
value = 1
[State 0, Var Buffer 2]
type = VarSet
trigger1 = command = "y"
v = 6
value = 2
[State 0, Var Buffer 3]
type = VarSet
trigger1 = command = "z"
v = 6
value = 3
[State 0, Var Buffer 4]
type = VarSet
trigger1 = command = "a"
v = 6
value = 4
[State 0, Var Buffer 5]
type = VarSet
trigger1 = command = "b"
v = 6
value = 5
[State 0, Var Buffer 6]
type = VarSet
trigger1 = command = "c"
v = 6
value = 6

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(var(2)=0,const(velocity.jump.y)*0.7,const(velocity.jump.y))

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

