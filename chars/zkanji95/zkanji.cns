;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS ƒŒƒxƒ‹: Šî–{
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 0]
type = ChangeState
trigger1 = PalNo = 7
value = 191

[State 190, 0]
type = ChangeState
trigger1 = PalNo != 7
trigger1 = Random <= 500
trigger1 = Time <= 0
value = 193

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

