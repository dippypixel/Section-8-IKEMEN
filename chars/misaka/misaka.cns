attr = S, NA
animtype  = Medium
damage    = 37
guardflag = MA
pausetime = 12,12
sparkno = s8200
sparkxy = -10,-37
hitsound   = s0,3
guardsound = s0,5
ground.type = Low
ground.slidetime = 10
