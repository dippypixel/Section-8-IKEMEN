;===========================================================================
;---------------------------------------------------------------------------
; ジャンプ通常攻撃にChangeStateのコントローラが無いのは、
; Physicsを「A」にしているから。
; おまけフォルダの「小ネタ.txt」を参照。（Physicsの仕組み）
;
; しゃがみ通常技とは逆に、ジャンプ通常技は基本的に「中段属性」の攻撃。
; しゃがみガードが出来ないのが普通なので、guardflagを「HA」にしておくのが定石。
;「立ちガードの需要性」と「空対地のガードの揺さぶりによる駆け引き」を
; プレイヤーに楽しんでもらうための先人達の知恵だね。
;---------------------------------------------------------------------------
;ジャンプ弱パンチ
[Statedef 600]
type     = A
movetype = A
physics  = A
anim     = 600
ctrl     = 0
juggle   = ifelse((var(20) > 0 || var(21) > 0), 0, 1)

[State 600, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 600, ヒット定義]
type = HitDef
trigger1 = Time = 0
attr = A, NA ;空中通常打撃（Air, Normal Attack）
damage    = 20
guardflag = HA ;相手はしゃがみガードが出来ない
priority = 3
pausetime = 8,10
sparkno = s8100
sparkxy = -10,-58
hitsound   = s0,2
guardsound = s0,5
ground.type = High
ground.slidetime = 5
ground.hittime  = 8
ground.velocity = -4
air.velocity = -1.3,-3

[State 6010];乗算補正
type = Varset
trigger1 = movehit
fv = 1
value = fVar(1)*0.8
persistent = 0
ignorehitpause = 1


[State 600, コントロール]
type = CtrlSet
trigger1 = Time = 17
value = 1

