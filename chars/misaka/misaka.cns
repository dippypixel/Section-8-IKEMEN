;===========================================================================
; 通常攻撃技
;===========================================================================
;---------------------------------------------------------------------------
; 通常技はそんなに難しいテクニックは使ってないから、
; テンプレートを見ながら確認すれば覚えやすいと思う。
; 基本忘るべからず。
;
; ステートナンバーは、立ち技が２００～２９９、しゃがみ技が４００～４９９、
; ジャンプ技が６００～６９９の間で決めて作るのが一般的。
; しかし強制じゃないので自由に作っちゃってＯＫ。
;---------------------------------------------------------------------------
;立ち弱パンチ
[Statedef 200]
type     = S
movetype = A
physics  = S
juggle   = 5
ctrl     = 0
anim     = 200
poweradd = 10
velset   = 0,0

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 200, Hit]
type = HitDef
trigger1 = AnimElem = 1
attr              = S, NA
damage            = 20
animtype          = Light
getpower          = 35,15
guardflag         = MA
priority          = 3
pausetime         = 11,11
sparkno           = s8100
sparkxy           = -10,-37
hitsound          = s0,2
guardsound        = s0,5
ground.type       = High
ground.slidetime  = 5
ground.hittime    = 10
ground.velocity   = -6
airguard.velocity = -1.9
air.velocity      = -1.3,-3

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
