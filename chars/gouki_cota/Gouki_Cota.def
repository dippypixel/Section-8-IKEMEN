; Definition file for COTA Akuma
; Contains all the filenames needed for the character

; Player information
[Info]
name = "COTA Gouki"
displayname = "COTA Akuma"
versiondate = 2,2,2002
mugenversion = 1.0
author = "Nobuyuki, edited by guymbagoomba"
pal.defaults = 1,2,3,4

; Files for the player
[Files]
cmd     = Gouki.key   ;Command set
cns     = Gouki.cns   ;Constants
st  = Gouki.cns   ;States
st2 = Misc.cns
st3 = Normal.cns
st4 = Super.cns
st5 = -2.cns
st6 = GetHit.cns
st7=throw.cns
st8=AI.cns
stcommon = common.cns ;Common states
sprite = Gouki.sff   ;Sprite
anim = Gouki.air   ;Animation
sound= Gouki.snd   ;Sound
pal1 = Gouki-cota.act  ;Palettes (can have up to 12)
pal2 = Gouki-cota2.act
pal3 = Gouki.act
pal4 = Gouki2.act