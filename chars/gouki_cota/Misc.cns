[Statedef 5420]
type = A
ctrl = 1
physics = A

[State 0]
type = velset
trigger1 = prevstateno = 5410
trigger1 = time <= 6
y = -11

[State 4]
type = VarSet
trigger1 = Time = 0
v = 8
value = 1

[State 0]
type = turn
trigger1 = P2dist X < 0

[State 4]
type = Veladd
trigger1 = Time > 0
sysvar(1) != 0
trigger1 = vel x = [-3,3.5]
x = ifelse(command="holdfwd", 0.1, ifelse(command="holdback", -0.1, 0))

[State 4]
type = Velset
trigger1 = sysvar(1) = 0
trigger1 = Time >= 0
x = ifelse(command="holdfwd", 4, ifelse(command="holdback", -4, vel x))

[State 6]
type = ChangeAnim
trigger1 = vel y <= -3
trigger1 = anim != 41
value = 41

[State 6]
type = ChangeAnim
trigger1 = vel y > -3
trigger1 = anim != 44
value = 44

