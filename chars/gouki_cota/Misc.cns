trigger1 = Time = 2
value = 9,3

[State 2]
type = CtrlSet
trigger1 = Time = 1
value = 1

[State 1]
Type = Velset
trigger1 = Time = 3
y = -13

[State 6]
type = ChangeAnim
trigger1 = time = 0
value = ifelse(sysvar(1)=0, 41, ifelse(sysvar(1)=1, 42, 43))

[State F]
