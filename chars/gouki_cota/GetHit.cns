

;=========================================================================
;一度地面でバウンドしして着地する。バウンドまでは繋がる

[Statedef 291];地上くらいでバウンドし、空中ではしない場合
type    = S
movetype= H
physics = N
velset = 0,0

[State 0]
type = selfstate
trigger1 = time = 0
trigger1 = pos y < -1
value = 5020

[State 0]
type = changestate
trigger1 = time = 0
trigger1 = pos y >= 0
value = 299

; HITG_SHAKE
[Statedef 292];空中くらいでバウンドし、地上ではしない場合
type    = S
movetype= H
physics = N
velset = 0,0

[State 0]
type = selfstate
trigger1 = time = 0
trigger1 = pos y >= 0
value = 5000

[State 0]
type = changestate
trigger1 = time = 0
trigger1 = pos y < -1
value = 298

[Statedef 293];バウンドしない
type    = S
movetype= H
physics = N
velset = 0,0

[State 0]
type = selfstate
trigger1 = time = 0
trigger1 = pos y >= 0
trigger1 = GetHitVar(yvel) >= 0
value = 5000

[State 6]
type = ChangeState
trigger1 = time = 0
value = 299


;====================================================

[Statedef 299]
type    = S
movetype= H
physics = N
velset = 0,0

[State 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 3]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 3]
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 4]
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 && GetHitVar(fall)
trigger2 = Pos Y != 0
type = a

[State 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = prevstateno != 293
value = 297

[State 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = prevstateno = 293
value = 287

; HITA_SHAKE
[Statedef 298]
type    = A
movetype= H
physics = N
velset = 0,0

[State 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(airtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5020, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 3]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 4]
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = prevstateno = 691
value = 692

[State 5]
type = ChangeState
trigger1 = HitShakeOver
value = 297

[State 5020, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5020, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5020, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
trigger4 = anim = [5051,5059]
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;============================================

; HITA_UP_T (transition)
[Statedef 297]
type    = A
movetype= H
physics = N

[State 2]
type = VelSet
trigger1 = Time = 0
trigger1 = prevstateno != 289
x = 0
y = 0

[State 2]
type = HitVelSet
trigger1 = Time = 0
trigger1 = prevstateno != 289
x = 1
y = 1

[State 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5035

[State 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)+(0.4*const(movement.yaccel))

[State 3]
type = ChangeState
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 0  ;.
trigger1 = prevstateno != 293
value = 296

[State 0]
type = ChangeState
trigger1 = vel x < 0
trigger1 = backedgedist <= 2
trigger1 = time >= 5
trigger1 = prevstateno != 289
value = 289

;---------------------------------------------
;バウンドなし

; HITA_UP_T (transition)
[Statedef 287]
type    = A
movetype= H
physics = N

[State 2]
type = VelSet
trigger1 = Time = 0
trigger1 = prevstateno != 289
x = 0
y = 0

[State 2]
type = HitVelSet
trigger1 = Time = 0
trigger1 = prevstateno != 289
x = 1
y = 1

[State 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)+(0.4*const(movement.yaccel))

[State 3]
type = selfState
triggerall = Life <= 0
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  ;.
value = 5150 ;HITA_RECOV

[State 3]
type = selfState
trigger1 = GetHitVar(animtype) = [0,1]
trigger1 = HitOver
value = 5040 ;HITA_RECOV

[State 3]
type = selfState
triggerall = !HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV

[State 4]
type = selfState
triggerall = HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5050 ;HITA_FALL

[State 0]
type = ChangeState
trigger1 = vel x < 0
trigger1 = backedgedist <= 2
trigger1 = time >= 1
trigger1 = prevstateno != 289
value = 289

