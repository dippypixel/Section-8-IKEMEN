triggerall = var(59)>0
triggerall = ctrl || (stateno = [100,105]) || stateno = [120,140]
triggerall = statetype != A
triggerall = numhelper(33333333)
triggerall = numexplod(33330001) = 0
trigger1 = PlayerIdExist(helper(33333333),var(4))
