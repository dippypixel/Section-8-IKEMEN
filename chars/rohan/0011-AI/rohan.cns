trigger1 = time = 0
value = 182,0+(random%2)

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 191, 2] 
type = AssertSpecial
trigger1 = matchover
trigger1 = Time = [0,560]
flag = roundnotover
