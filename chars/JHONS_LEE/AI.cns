
;---------------------------------------------------------------------------
;AI　㍻㌢さんのAI説明書を参考にさせてもらいました。
;　　厨忍さんのサイトのAI製作メモを参考にさせてもらいました。
;---------------------------------------------------------------------------
;
;テキトーに技を振って、狙える場面ではコンボしたりしなかったりするAIです。
;全体的に迂闊な行動が多いのでそこを付けば簡単に勝てるような気がします。
;火力が異常に高いので事故にだけは気をつけましょう。
;

[Statedef -3]

[State -3, AIフラグセット]
type = VarSet
triggerall = !var(59)
triggerall = RoundState = [1,2]
trigger1 = Command = "AI0"
trigger2 = Command = "AI1"
trigger3 = Command = "AI2"
trigger4 = Command = "AI3"
trigger5 = Command = "AI4"
trigger6 = Command = "AI5"
trigger7 = Command = "AI6"
trigger8 = Command = "AI7"
trigger9 = Command = "AI8"
trigger10 = Command = "AI9"
trigger11 = Command = "AI10"
trigger12 = Command = "AI11"
trigger13 = Command = "AI12"
trigger14 = Command = "AI13"
trigger15 = Command = "AI14"
trigger16 = Command = "AI15"
trigger17 = Command = "AI16"
trigger18 = Command = "AI17"
trigger19 = Command = "AI18"
trigger20 = Command = "AI19"
trigger21 = Command = "AI20"
trigger22 = Command = "AI21"
trigger23 = Command = "AI22"
trigger24 = Command = "AI23"
trigger25 = Command = "AI24"
trigger26 = Command = "AI25"
trigger27 = Command = "AI26"
trigger28 = Command = "AI27"
trigger29 = Command = "AI28"
trigger30 = Command = "AI29"
trigger31 = Command = "AI30"
trigger32 = Command = "AI31"
trigger33 = Command = "AI32"
trigger34 = Command = "AI33"
trigger35 = Command = "AI34"
trigger36 = Command = "AI35"
trigger37 = Command = "AI36"
trigger38 = Command = "AI37"
trigger39 = Command = "AI38"
trigger40 = Command = "AI39"
trigger41 = Command = "AI40"
trigger42 = Command = "AI41"
trigger43 = Command = "AI42"
trigger44 = Command = "AI43"
trigger45 = Command = "AI44"
trigger46 = Command = "AI45"
trigger47 = Command = "AI46"
trigger48 = Command = "AI47"
trigger49 = Command = "AI48"
trigger50 = Command = "AI49"
trigger51 = Command = "AI50"
var(59) = 10;←1～11で設定可能、11が最高レベル(超反応アリ)

[State -3,勁ポイント横の位置]
type = VarSet
trigger1 = 1
v = 14
value = 0   ;(1P側の場合)負数だと左に、正数だと右によります。

[State -3,勁ポイント縦の位置]
type = VarSet
trigger1 = 1
v = 15
value = 0   ;負数だと上に、正数だと下によります。

[State -3, 発勁返し率]
type = VarSet
triggerall = var(59)!= 0
trigger1 = RoundState = [1,2]
var(57) = 30;←0～100で設定可能。

[State -3, AIの最大の勁の一撃使用有無]
type = VarSet
triggerall = var(59)!= 0
trigger1 = RoundState = [1,2]
var(56) = 1;　一撃を使わせたくない場合は0にしてください。

[State -3, タッグ時におけるヒットストップ減少(ジョンス・リー側が一人で相手二人の場合は作用しません)]
type = VarSet
TriggerAll=TeamMode = simul
trigger1 = Numpartner
trigger1 = partner,ALIVE
trigger1 = RoundState = [1,2]
var(55) = 5;　数字を大きくするほどヒットストップが減ります。5くらいが適切です。0でいつも通り。
           ;  大きくしすぎるとエラーメッセージが出るので注意。(プレイは普通にできる。)

[State -3, 相方死亡時のヒットストップ減少解除]
type = VarSet
TriggerAll=TeamMode = simul
trigger1 = Numpartner
trigger1 = partner,ALIVE = 0
trigger1 = RoundState = [1,2]
var(55) = 0

[State -3];変数設定
Type=varset
triggerall=!ishelper
Trigger1=numenemy=1
var(12)=enemynear,ID

[State -3];変数設定
Type=varset
triggerall=!ishelper
Trigger1=numenemy=2
var(12)=ifelse(EnemyNear(0),alive,enemynear(0),ID,enemynear(1),ID)


