;---------------------------------------------------------------------------
;var(0) = なんだソリャ…
;var(1) = なんだソリャ…
;var(2) = 本気にさせたな
;var(3) = 発勁返し(S)
;var(4) = 発勁返し(C)
;var(5) = 勝利ポーズ分岐
;var(6) = ガーキャン
;var(7) = 投げ追撃補正
;var(8) = 安いプライド
;var(9) = 構え猛虎
;var(10) = 構え猛虎
;var(11) = 追加 or 反転
;var(12) = ID
;var(13) = 勁ポイント被り防止
;var(14) = 勁ポイント横位置
;var(15) = 勁ポイント縦位置
;var(16) = 最大の勁の一撃制限
;var(17) = ガード硬直後相手投げ無敵


;var(53) = 勁ポイント
;var(54) = 勁ポイント
;var(55) = タッグ時におけるヒットストップ減少。
;var(56) = AIの最大の勁の一撃の使用有無。
;var(57) = 発勁返し率
;var(58) = 帰宅
;var(59) = AI
;---------------------------------------------------------------------------
[Data]
life              = 1000
power             = 3000
attack            = 100
defence           = 100
fall.defence_up   = 50
liedown.time      = 37
airjuggle         = 1000
sparkno           = 2
guard.sparkno     = 40
KO.echo           = 0
volume            = 0
IntPersistIndex   = 53,59
FloatPersistIndex = 40

;---------------------------------------------------------------------------

[Size]
xscale           = 0.5
yscale           = 0.5
ground.back      = 15
ground.front     = 16
air.back         = 12
air.front        = 12
height           = 60
attack.dist      = 160
proj.attack.dist = 90
proj.doscale     = 0
head.pos         = 5, -125
mid.pos          = 5, -75
shadowoffset     = 0
draw.offset      = 0,0

;---------------------------------------------------------------------------

[Velocity]
walk.fwd     = 1.6
walk.back    = -1.4
run.fwd      = 4.6, 0
run.back     = -15.5,0
jump.neu     = 0,-7.3
jump.back    = -2.5
jump.fwd     = 3.4
runjump.back = -2.55,-8.1
runjump.fwd  = 6,-6.3
airjump.neu  = 0,0
airjump.back = 0
airjump.fwd  = 0

;---------------------------------------------------------------------------

[Movement]
airjump.num     = 0
airjump.height  = 35
yaccel          = .47
stand.friction  = .84
crouch.friction = .84

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Stand

[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0]
type = SprPriority
trigger1 = win
value = -1

[State 0]
type = ChangeAnim
value = 182
trigger1 = Var(5) = 1

[State 0, 1]
type = ChangeAnim
triggerall = Var(5) = 0
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, ]
type = PosSet
trigger1 = Pos y != [-30,30]
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11,]
type = PosSet
trigger1 = Pos y != [-30,30]
y = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20,]
type = PosSet
trigger1 = Pos y != [-30,30]
y = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; ジャンプ
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40,]
Type = ChangeState
TriggerAll = Var(59) >= 7
Triggerall = Time = 0
trigger1 = prevstateno != 100
trigger1 = enemynear,MoveType != H || enemynear,StateType = L 
Value = 0
Ctrl = 1
IgnoreHitPause = 1

[State 40, 2]
type = VarSet
Trigger1 = var(59) = 0
Trigger1 = command = "holdfwd"
Trigger2 = var(59) != 0
Trigger2 = enemynear,StateType != L || P2BodyDist X = [40,70]
Trigger2 = enemynear,MoveType = H || Random <= 333
trigger3 = prevstateno = 100
sysvar(1) = 1

[State 40, 3]
type = VarSet
Trigger1 = var(59) = 0
Trigger1 = command = "holdback"
Trigger2 = var(59) != 0
Trigger2 = enemynear,StateType = L
Trigger2 = enemynear,MoveType = H
Trigger2 = BackEdgeBodyDist>60
Trigger2 = P2BodyDist X = [0,30]
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 音を鳴らす]
type = PlaySnd
trigger1 = AnimTime = 0
value = 40, 0

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

