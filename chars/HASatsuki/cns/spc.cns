; H - Chargeball
[Statedef 1020]
type    = A
movetype= A
physics = N
anim = 1020 + Parent,Var(6)
ctrl = 0
sprpriority = 9

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 6
value = Parent,Var(6)

[State 0, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA,NP,SP,HP
stateno = 1021
time = 1
[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = ,NA,SA,HA,NT,ST,HT
time = 1

[State 0, VelSet]
type = VelSet
trigger1 = !Time
trigger1 = !Parent,Var(5)
x = 1
[State 0, VelSet]
type = VelSet
trigger1 = !Time
trigger1 = Parent,Var(5)
x = 1
y = -0.4
[State 0, VelSet]
type = VelSet
trigger1 = Vel X && Anim = 1025
x = 0
y = 0

[State 0, VelAdd]
type = VelAdd
trigger1 = Anim != 1025
x = ifelse(Vel X < 10,0.15,0)
y = ifelse(Vel Y != 0 && Vel Y > -4.125,-0.04125,0)

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S1010,ifelse(Var(6)>1,1,0)
[State 0, PlaySnd]
type = PlaySnd
trigger1 = MoveContact = 1
value = S1011,Var(6)-1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = MoveContact || MoveReversed
trigger1 = Anim != 1025
value = 1025

[State 0, Explod]
type = Explod
triggerall = Anim = 1025
trigger1 = AnimElem = 2 && Var(6) >= 1
trigger2 = AnimElem = 3 && Var(6) >= 2
trigger3 = AnimElem = 4 && Var(6) >= 3
trigger4 = AnimElem = 5 && Var(6) >= 1
trigger5 = AnimElem = 6 && Var(6) >= 2
trigger6 = AnimElem = 7 && Var(6) >= 3
anim = 1025
pos = floor(sin(GameTime*1.75)*(AnimElemNo(0)*5)),floor(cos(GameTime*1.75)*(AnimElemNo(0)*5))
removetime = -2
sprpriority = 5
ownpal = 1
[State 0, Explod]
type = Explod
triggerall = Anim = [1020,1023]
trigger1 = Var(6) = 1 && Time%4 = 0
trigger2 = Var(6) = 2 && Time%3 = 0
trigger3 = Var(6) = 3 && Time%2 = 0
anim = 1026
pos = floor(sin(GameTime*1.125)*Var(6)*4),floor(cos(GameTime*1.125)*Var(6)*4)
removetime = -2
facing = ifelse(random%2,1,-1)
vfacing = ifelse(random%2,1,-1)
sprpriority = 5
ownpal = 1

[State 0, HitDef]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = S,NP
hitflag = MAF
guardflag = MA
animtype = medium
priority = 5,Hit
damage = Ceil((64+Var(6)*24)*Parent,FVar(10)),0
pausetime = 0,8+Var(6)
sparkno = s8005 + (Var(6)>=2) * 5
guard.sparkno = s8105 + (Var(6)>=2) * 5
sparkxy = -16,0
hitsound = S1,2 + (Var(6)>=2)
guardsound = S2,1 + (Var(6)>=2)
ground.type = High
ground.slidetime = 20 + Var(6) * 4
ground.hittime = 20 + Var(6) * 4
guard.hittime = 8 + Var(6) * 4
air.hittime = 16 + Var(6) * 4
yaccel = 0.5
ground.velocity = -6+(Var(6)>=2)*2,-4*(Var(6)>=2)
air.velocity = -2,-4
airguard.velocity = -4,0
fall = Var(6)>=2
fall.recover = 0
getpower = 128,64
givepower = 32,16
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = Anim = 1025
movetype = I

[State 0, DestroySelf]
type = DestroySelf
trigger1 = Time = 192
trigger2 = AnimTime = 0 && Anim = 1025

