trigger2 = StateNo = 515
trigger3 = StateNo = 1040
trigger4 = StateNo = 1100
trigger5 = StateNo = 1150
fv = 10
value = FVar(10)*0.85
ignorehitpause = 1
[State 0, Dampening H]
