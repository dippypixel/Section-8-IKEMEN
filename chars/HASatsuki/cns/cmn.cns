trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 1]
type = VelSet
trigger1 = Time <= 6
x = const(velocity.run.fwd.x)*0.50 + Var(42)
[State 100, 1]
type = VelSet
trigger1 = Time > 6
x = ifelse(Vel X < const(velocity.run.fwd.x) + Var(42),Vel X+0.25+Var(42)*0.125,const(velocity.run.fwd.x) + Var(42))

[State 200, Voice]
type = PlaySnd
trigger1 = Time = 4
trigger1 = Random <= 750
value = S100, Var(54)
channel = 0
[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time%9 = 0
value = S5,12
channel = 1

[State 0, Explod Boost]
type = Explod
trigger1 = AnimElemNo(0) >= 4
trigger1 = Time%4 = 0
trigger2 = Time%4 = 2
trigger2 = Var(42)
anim = 102
ID = 102
pos = 12,-56
;bindtime = 666
removetime = -2
sprpriority = 0
removeongethit = 1
ownpal = 1
[State 0, Explod Dust]
type = Explod
trigger1 = AnimElem = 2
anim = 8255
ownpal = 1

[State 100, 4]
type = ChangeState
;triggerall = Time >= 5
trigger1 = (command = "holdup" || command = "up") && Var(15) = 0
value = 40

[State 100, 4]
type = ChangeState
triggerall = Time > 10
trigger1 = command != "holdfwd" && Var(15) = 0
trigger2 = Var(15) && P2BodyDist X < 8
trigger3 = FrontEdgeDist < 8
value = 101

