;========================================================
; PAAAAAIIIIIN
;========================================================

[State -3, Pain S Sound]
type = PlaySnd
triggerall = Time = 1
triggerall = gethitvar(animtype) <= 1
triggerall = random < 500
triggerall = Life > 0
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
trigger4 = (anim = [5000,5001]) && (stateno != [5000,5999]) && AnimElem = 1, 1
trigger5 = (anim = [5010,5011]) && (stateno != [5000,5999]) && AnimElem = 1, 1
trigger6 = (anim = [5020,5021]) && (stateno != [5000,5999]) && AnimElem = 1, 1
value = S5000, ifelse(!Var(54),random%4,Var(54)+random%3)
channel = 3

[State -3, Pain L Sound]
type = PlaySnd
triggerall = Time = 1
triggerall = gethitvar(animtype) > 1
triggerall = Life > 0
trigger1 = Random < 450
trigger1 = stateno = 5000
trigger2 = Random < 550
trigger2 = stateno = 5010
trigger3 = Random < 600
trigger3 = stateno = 5020
trigger4 = (anim = 5002) && (stateno != [5000,5999]) && AnimElem = 1, 1
trigger5 = (anim = 5012) && (stateno != [5000,5999]) && AnimElem = 1, 1
trigger6 = (anim = 5022) && (stateno != [5000,5999]) && AnimElem = 1, 1
value = S5020, ifelse(!Var(54),random%4,Var(54)+random%3)
channel = 3

[State -3, Pain Trip]
type = PlaySnd
triggerall = Time = 1
triggerall = Life > 0
trigger1 = stateno = 5070
value = S5020, ifelse(!Var(54),random%4,Var(54)+random%3)
channel = 3

[State 0, GetUp Sound]
type = PlaySnd
triggerall = RoundState = 2
trigger1 = Time = 1
trigger1 = StateNo = 5120
value = S5120,ifelse(!Var(54),random%2,Var(54)+random%4)
channel = 0 ;3

[State 0, VarSet]
type = VarSet
trigger1 = !Alive
trigger1 = Var(32) = 0
v = 32
value = 1

