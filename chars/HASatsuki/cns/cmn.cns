triggerall = Var(8) = 1
trigger1 = StateNo = 210
trigger2 = StateNo = 310
trigger3 = StateNo = 410
trigger4 = StateNo = 510
trigger5 = StateNo = 610
trigger6 = StateNo = 710
fv = 10
value = FVar(10)*0.90
ignorehitpause = 1
[State 0, Dampening H]
