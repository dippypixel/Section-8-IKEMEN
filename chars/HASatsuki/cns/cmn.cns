[State 0, WAKE ME UP LOWER THE FEVER]
type = VarSet
trigger1 = Time%2
trigger1 = Var(53) = 666
v = 50
value = random%2
[State 0, LATELY IM A DESPERATE BELIEVER]
type = VarSet
trigger1 = Time%2
trigger1 = Var(53) = 666
v = 54
value = random%2*50