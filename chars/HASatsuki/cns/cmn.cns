;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
facep2 = 1
sprpriority = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !Time
value = ifelse(command="holdfwd",52,ifelse(command="holdback",53,40))

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
v = 2
value = 1

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd" || Var(15)
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback" && !Var(15)
sysvar(1) = -1

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 5
value = 50
[State 0, VarSet]
type = VarSet
trigger1 = command = "x" && !Var(15)
v = 5
value = 600
[State 0, VarSet]
type = VarSet
trigger1 = command = "y" && !Var(15)
v = 5
value = 610 
[State 0, VarSet]
type = VarSet
trigger1 = command = "a" && !Var(15)
trigger2 = Var(15) && EnemyNear,MoveType = H
v = 5
value = 700
[State 0, VarSet]
type = VarSet
trigger1 = command = "b" && !Var(15)
v = 5
value = 710 

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S5,0

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.jump.fwd.x)*2

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = Var(5);50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = 1
value = 44

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd" || Var(15)
sysvar(1) = 1
[State 45, 5]
type = VarSet
trigger1 = command = "holdback" && !Var(15)
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 1
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 2
value = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S5,0

[State 45, 7]
type = ChangeState
trigger1 = Time = 1
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
