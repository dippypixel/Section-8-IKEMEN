trigger1 = Time = 0
value = ifelse((vel x)<0, 43, ifelse((vel x)>0,42,41))

[State 50, 2]
type = ChangeAnim
triggerall = Anim = [41,43]
trigger1 = Vel Y >= -2
value = Anim + 3

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 3
value = 0
[State 0, VarSet]
type = VarSet
trigger1 = command != "holdup"
trigger1 = Var(2) = 1
v = 3
value = 1
[State 0, VarSet]
type = ChangeState
trigger1 = command = "holdup"
trigger1 = Var(3) = 1 && Var(2) = 1
value = 45
ctrl = 0

