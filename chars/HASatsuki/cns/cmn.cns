[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = StateType = A
trigger1 = Var(4) = 1
physics = A

[State 0, VarSet]
type = VarAdd
trigger1 = Var(4) > 0
v = 4
value = -1

;==============
; COMBO STRING
;==============

[State 0, VarRangeSet]
type = VarRangeSet
trigger1 = ctrl && StateNo < 200
trigger2 = StateNo = 40
value = 0
first = 20
last = 29

;==============
; COUNTER
;==============

[State 0, Counter Check]
type = VarSet
trigger1 = MoveType = A
v = 9
value = ifelse(EnemyNear,MoveType = A,1,0)
[State 0, Counter Test]
type = PalFX
triggerall = MoveHit && !MoveReversed
triggerall = MoveType != H && EnemyNear,MoveType = H
trigger1 = Var(8) = 1 && Var(9)
time = 2
add = 128,128,128
mul = 256,256,256
invertall = 0
color = 0
ignorehitpause = 2
[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = Var(9)
value = 1.25
[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = !Var(9)
value = 1
[State 0, Explod COUNTER!]
type = Explod
triggerall = MoveHit && !MoveReversed
triggerall = MoveType != H && EnemyNear,MoveType = H
trigger1 = Var(8) = 1 && Var(9)
anim = 8400
pos = Floor(P2Dist X*0.5),-24-(StateType!=C * 24)-Floor(P2Dist Y*-0.5)
removetime = 16
facing = facing
pausemovetime = 66666
supermovetime = 66666
sprpriority = 8
ontop = 1
ownpal = 1
ignorehitpause = 1
[State 0, Explod Sparkle R]
type = Explod
triggerall = MoveHit && !MoveReversed
triggerall = MoveType != H && EnemyNear,MoveType = H
trigger1 = Var(8) = 1 && Var(9)
anim = 8300
pos = Floor(P2Dist X*0.5),-24-(StateType!=C * 24)-Floor(P2Dist Y*-0.5)
removetime = 16
vel = 6,0
accel = -0.4,0
pausemovetime = 66666
supermovetime = 66666
sprpriority = 9
ownpal = 1
ignorehitpause = 1
[State 0, Explod Sparkle L]
type = Explod
triggerall = MoveHit && !MoveReversed
triggerall = MoveType != H && EnemyNear,MoveType = H
trigger1 = Var(8) = 1 && Var(9)
anim = 8300
pos = Floor(P2Dist X*0.5),-24-(StateType!=C * 24)-Floor(P2Dist Y*-0.5)
removetime = 16
vel = -6,0
accel = 0.4,0
pausemovetime = 66666
supermovetime = 66666
sprpriority = 9
ownpal = 1
ignorehitpause = 1
[State 0, Explod Sparkle X]
type = Explod
triggerall = MoveHit && !MoveReversed
triggerall = MoveType != H && EnemyNear,MoveType = H
trigger1 = Var(8) <= 5 && Var(9)
anim = 8300
pos = Floor(P2Dist X*0.5),-24-(StateType!=C * 24)-Floor(P2Dist Y*-0.5)
removetime = 16
vel = ifelse(GameTime%2,-5,5),cos(GameTime*0.5)*1.5
accel = ifelse(GameTime%2,0.33,-0.33),cos(GameTime*0.5)*-0.1
pausemovetime = 66666
supermovetime = 66666
sprpriority = 9
ownpal = 1
ignorehitpause = 1
[State 0, PlaySnd]
type = PlaySnd
triggerall = MoveHit && !MoveReversed
triggerall = MoveType != H && EnemyNear,MoveType = H
trigger1 = Var(8) = 1 && Var(9)
value = S5,13
channel = 3
ignorehitpause = 1

;========================================================
; HITTIME
;========================================================

[State 0, HitTime Add]
type = VarAdd
trigger1 = MoveContact
v = 8
value = 1
ignorehitpause = 1
[State 0, HitTime Reset]
type = VarSet
trigger1 = 1
v = 8
value = 0

;========================================================
; BOUNCE COUNT
;========================================================

[State 0, VarSet]
type = VarSet
triggerall = !Var(12)
triggerall = Var(8)
triggerall = EnemyNear,StateNo = 980
trigger1 = StateNo = 610
v = 12
value = 1
ignorehitpause = 1
[State 0, GroundBounce Reset]
type = VarSet
triggerall = Var(12)
trigger1 = EnemyNear,Ctrl
v = 12
value = 0

;========================================================
; DAMPENING
;========================================================

[State 0, Dampening Minimal]
type = VarSet
trigger1 = FVar(10) < 0.01
fv = 10
value = 0.01
[State 0, Dampening Reset]
type = VarSet
triggerall = FVar(10) < 1
trigger1 = P2MoveType != H
trigger2 = EnemyNear,Ctrl = 1
fv = 10
value = 1

[State 0, Dampening L]
type = VarSet
triggerall = MoveHit
triggerall = Var(8) = 1
trigger1 = StateNo = 200
trigger2 = StateNo = 300
trigger3 = StateNo = 400
trigger4 = StateNo = 500
trigger5 = StateNo = 600
trigger6 = StateNo = 700
fv = 10
value = FVar(10)*0.95
ignorehitpause = 1
[State 0, Dampening M]
