;---------------------------------------------------------------------------
; Dash Back
[Statedef 105]
type    = A
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = VelSet
trigger1 = Time = 2
x = -6
y = -1

[State 0, Snd GET BACK MOTHERFUCKER]
type = PlaySnd
trigger1 = !Time
value = S105,0

[State 0, VelAdd]
type = VelAdd
trigger1 = Time > 2
y = 0.18

[State 105, 3]
type = ChangeState
trigger1 = Time > 2
trigger1 = Vel Y + Pos Y > 0
trigger2 = AnimTime = 0
value = 106

