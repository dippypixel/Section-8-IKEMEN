;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 101]
type    = S
physics = N
anim = 101
ctrl = 0
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = time = 0
x = 0
y = 0

[State 100, 1]
type = Velmul
trigger1 = 1
x = 0.95

[State 100, 1]
type = null;VelSet
trigger1 = animelem = 1
x = 0

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
