; Definition file for Butthead
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Butt-head"        ;Name of character
displayname = "Butt-head" ;Name of character to display
versiondate = 11,27,2014    ;Version date of character (MM-DD-YYYY)
mugenversion = 1.1   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 4,5,6,1,2,3      ;Default palettes in order of preference


; Files for the player
[Files]
cmd     = butthead.cmd   ;Command set
cns     = butthead.cns   ;Constants
st      = 11ov.st   ;States
st2      = butthead.cns   ;States
st3     = config.txt
stcommon = common1.cns ;Common states
sprite  = butthead.sff   ;Sprite
anim    = butthead.air   ;Animation
sound   = butthead.snd   ;Sound
pal1    = butthead2.act
pal2    = butthead5.act
pal3    = butthead6.act
pal4    = butthead.act
pal5    = butthead4.act
pal6    = butthead3.act
pal7    = butthead7.act
pal8    = butthead8.act
pal9    = butthead9.act
pal10    = butthead10.act
pal11    = butthead11.act
pal12    = butthead12.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
