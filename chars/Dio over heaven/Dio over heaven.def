; ここにキャラ情報を書いてください
[Info]
name = "DIO"        ;キャラの名前
displayname = "Heaven Ascension DIO" ;示されるキャラの名前
versiondate = 02,16,2013    ;キャラの更新情報
mugenversion = 1.0   ;キャラが動くmugenのバジョン
author = "Heal_The_World"         ;キャラの製作者名
pal.defaults = 6,8,4,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = DIO.cmd   ;キャラのコンド
cns     = DIO.cns   ;キャラのプログラ
st      = DIO.cns   ;キャラのプログラ
st1      = tandem.cns   ;キャラのプログラ
stcommon = common.cns 
sprite  = DIO_O.sff   ;キャラの絵
anim    = DIO_O.air   ;キャラの動き
sound   = DIO.snd   ;キャラの音

pal1    = overheaven.act ;キャラの色（最大１２個）
pal2    = normal.act ;キャラの色（最大１２個）
pal3    = pucci.act ;キャラの色（最大１２個）
pal4    = greenbaby.act
pal5    = nishio.act
pal6    = straizo.act
pal7    = overheaven.act ;キャラの色（最大１２個）
pal8    = normal.act ;キャラの色（最大１２個）
pal9    = pucci.act ;キャラの色（最大１２個）
pal10    = greenbaby.act
pal11    = overheaven.act
pal12    = overheaven.act