;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[state 0, 0]
type = Afterimage
trigger1 = Time = 0
time = -1
length = 15
PalBright = 0, 0, 0
PalContrast =50, 50, 50
PalAdd = 0, 0, 0
PalMul = 0.9,0.9,0.9
FrameGap = 1
Trans = sub
ownpal = 1
ontop = 1

[State 0, ]
type = Explod
trigger1 = AnimElem = 2
anim = 10183
postype = P1
pos = -24,10
scale = 1,1
bindtime = -1
sprpriority = 1
ownpal = 1
removetime = 80
removeongethit = 1
scale = 0.3,0.3

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
[State ]
type = helper
trigger1 = !NumHelper(123456) && !ishelper
helpertype = normal
name = "AI Helper"
stateno = 123456
ID = 123456
pos = 0,5000
keyctrl = 0
pausemovetime = 999999999999
supermovetime = 999999999999
persistent = 0

[State ]
type = varadd
trigger1 = 1
v = 54
value = -1
ignorehitpause = 1

[State ]
type = nothitby
trigger1 = movehit && helper(123456),var(1)
value = SCA
time = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State ]
type = selfstate
triggerall = helper(123456),var(1)
trigger1 = gethitvar(damage)>=life && life>0
trigger1 = power>=1000 && var(54)<=0
value = 1080

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = S21, 4

[State 0, ]
type = Explod
triggerall  = time=1
trigger1 = stateno = 52
anim = 1288
postype = P1
pos = 0,-10
scale = 0.7,0.7
sprpriority = 1
ownpal = 1
removetime = 30
removeongethit = 1



