trigger1 = time = 0
persistent = 0
value = S21,7

[State 0, ]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 0, ]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 0, ]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State ]
type = VarSet
trigger1 = var(59)
sysvar(1) = helper(123456),var(50) < 75

[State 0, ]
type = VelSet
trigger1 = animtime = 0
trigger1 = palno != 11
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)*1.7

[State 0, ]
type = VelSet
trigger1 = animtime = 0
trigger1 = palno = 11
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)*1.40


[State 0, ]
type = ChangeState
trigger1 = animtime = 0
value = 50
ctrl = 1

