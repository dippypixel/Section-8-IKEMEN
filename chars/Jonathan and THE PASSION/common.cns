;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = N
anim = 40+var(0)
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 50, 2]
type = ChangeAnim
trigger1 = time = 2
value = ifelse(sysvar(1)=0, 41+var(0), ifelse(sysvar(1)=1, 42+var(0), 43+var(0)))
;------------------------------------
;ジャンプ管理(加速度)
[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(8) = 0

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = prevstateno != 100 || prevstateno != 105
trigger1 = command = "longjump"
var(8) = 1

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = PrevStateNo = 100 || PrevStateNo = 105
var(8) = 2
;------------------------------------
;ジャンプ管理(高さ)
[State 40, 4]
type = VarSet
trigger1 = time = 0
var(9) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(9) = 1

[State 40, 6]
type = VelSet
trigger1 = time = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*ifelse((!var(0)&&var(8))||(var(0)&&var(8)=2),1.33,1)
y = const(velocity.jump.y)*ifelse(!var(0)&&var(8)=1,1.1,1)

[State 40, 8]
type = VelMul
trigger1 = var(9)
y = .64
persistent = 0

[State 40, 10]
type = PosFreeze
trigger1 = time < 4
;------------------------------------
[State 120, 1]
type = VarSet
triggerall = anim = 10040
trigger1 = animelem = 1
var(13) = ceil(32*const(size.xscale))

[State 120, 1]
type = VarSet
triggerall = anim = 10040
trigger1 = animelem = 1
var(14) = ceil(-65*const(size.yscale))

[State 120, 1]
