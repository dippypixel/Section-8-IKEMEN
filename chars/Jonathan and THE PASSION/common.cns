[State 120, 1]
type = VarSet
trigger1 = animelem = 2
var(14) = ceil(-52*const(size.yscale))

[State 120, 1]
type = VarSet
trigger1 = animelem = 3
var(13) = ceil(10*const(size.xscale))

[State 120, 1]
type = VarSet
trigger1 = animelem = 3
var(14) = ceil(-40*const(size.yscale))

[State 120, 1]
type = VarSet
trigger1 = animelem = 4 || animelem = 5
var(13) = ceil(25*const(size.xscale))

[State 120, 1]
type = VarSet
trigger1 = animelem = 4 || animelem = 5
var(14) = ceil(-28*const(size.yscale))
;------------------------------------
[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

