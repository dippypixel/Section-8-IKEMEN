trigger1 = stateno = 210
trigger2 = stateno = 410
trigger3 = stateno = 10210
trigger4 = stateno = 10211
trigger5 = stateno = 10250
trigger6 = stateno = 10251
trigger7 = stateno = 10410
trigger8 = stateno = 1201 || stateno = 11200
fvar(2) = 14.6*const(size.xscale)
ignorehitpause = 1

[State -2, CornerPush]
type = VarSet
triggerall = movecontact
triggerall = time > 1
trigger1 = stateno = 220
trigger2 = stateno = 420
trigger3 = stateno = 10220 && !var(6)
trigger4 = stateno = 10260
trigger5 = stateno = 10270
trigger6 = stateno = 10420
