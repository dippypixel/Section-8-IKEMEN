;---------------------------------------------------------------------------
;コーナープッシュ処理
[State -2, CornerPush];初期化
type = VarSet
trigger1 = NumTarget
trigger1 = !target,gethitvar(hitshaketime) && fvar(2) < 1
trigger2 = NumTarget
trigger2 = target,statetype = A || target,statetype = L
trigger3 = movetype = H
fvar(2) = 0

[State -2, CornerPush];押し戻し
type = PosAdd
triggerall = StateType != A
triggerall = fvar(2)
triggerall = !NumExplod(7000)
triggerall = numtarget
triggerall = !target,gethitvar(hitshaketime)
trigger1 = target,BackEdgeBodyDist <= 5 || target,FrontEdgeBodyDist <= 5
x = -fvar(2)

[State -2, CornerPush];摩擦
type = VarSet
trigger1 = NumTarget
trigger1 = !target,gethitvar(hitshaketime) && fvar(2)
trigger1 = !NumExplod(7000)
fvar(2) = fvar(2)*.75
