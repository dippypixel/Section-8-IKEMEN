trigger3 = stateno = 600
trigger4 = stateno = 610
trigger5 = stateno = 620
trigger6 = stateno = 10200
trigger7 = stateno = 10220 && var(6)
trigger8 = stateno = 10230
trigger9 = stateno = 10400
trigger10 = stateno = 10600
trigger11 = stateno = 10610
trigger12 = stateno = 10620
trigger13 = stateno = 11000
trigger14 = stateno = [12000,12001]
trigger15 = stateno = [12200,12201]
fvar(2) = 9.8*const(size.xscale)
ignorehitpause = 1

[State -2, CornerPush]
