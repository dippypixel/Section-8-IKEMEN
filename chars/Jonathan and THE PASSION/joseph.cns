;スタンドゲージ(オリコン用)
[State -2]
type = VarSet
trigger1 = roundstate = 0
var(50) = 80
ignorehitpause = 1

;本体時ゲージ増加
[State -2]
type = VarAdd
trigger1 = !var(0)
trigger1 = var(50) = (0,80)
trigger1 = gametime%2=0
var(50) = 1
ignorehitpause = 1

;スタンドゲージ減少(通常用)
[State -2]
type = VarAdd
triggerall = var(0) && var(10) != 3
triggerall = var(50) = (0,80]
trigger1 = var(28) - Life > 0
var(50) = -ceil((var(28)-Life)*.25)
ignorehitpause = 1

;スタンドゲージ最大値
[State -2]
type = VarSet
trigger1 = var(50) > 80
var(50) = 80
ignorehitpause = 1

;スタンドゲージ最小値
[State -2]
