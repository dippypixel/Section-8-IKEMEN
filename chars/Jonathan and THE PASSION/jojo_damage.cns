var(29) = 20
ignorehitpause = 0
;------------------------------------
;行動不能時間
[State 6000]
type = VarAdd
trigger1 = var(33)
var(33) = -1
ignorehitpause = 1

[State 6000]
type = VarSet
trigger1 = time = 0
var(33) = 41
ignorehitpause = 1
;------------------------------------
[State 6000]
type = ChangeAnim
trigger1 = time = 0
trigger1 = statetype != A
value = 5800

[State 6000]
type = ChangeAnim
trigger1 = time = 0
trigger1 = statetype = A
value = 5030

[State 6000]
type = ChangeAnim
trigger1 = 1
value = anim
elem = 1

[State 6000]
type = Pause
trigger1 = time = 0
time = 6
movetime = 6

[State 6000];スタンドクラッシュSE
type = PlaySnd
trigger1 = time = 0
value = 6000,0

[State 20000]
type = DisplayToClipboard
trigger1 = 1
text = "var(33) = %d"
params = var(33)
;------------------------------------
