; ここにキャラ情報を書いてください
[Info]
name = "Jonathan and PASSIONE"        ;キャラの名前
displayname = "Jonathan Joestar" ;表示されるキャラの名前
versiondate = 12,10,2013    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "yukami"         ;キャラの製作者名
pal.defaults = 6,3,4,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = joseph.cmd   ;キャラのコマンド
cns     = joseph.cns   ;キャラのプログラム
st      = joseph.cns   ;キャラのプログラム
st2      = jojo_system.cns   ;スタンドモード通常,必殺,超必殺技
st3      = jojo_damage.cns
stcommon = common.cns 
sprite  = joseph.sff   ;キャラの絵
anim    = joseph.air   ;キャラの動き
sound   = joseph.snd   ;キャラの音
pal1    = act/joseph01.act  ;キャラの色（最大１２個）
pal2    = act/joseph02.act
pal3    =
pal4    = 
pal5    = 
pal6    =
pal7    = 
pal8    = 
pal9    = 
pal10    = 
;pal11    = act/joseph11.act
;pal12    = act/joseph12.act


