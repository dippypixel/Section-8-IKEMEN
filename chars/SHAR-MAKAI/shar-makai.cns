;Survival winscreen partner
;------------------
[State 0, ChangeState]
type = ChangeState
triggerall = numpartner
trigger1 = partner,stateno=18000 && stateno !=18000 && stateno !=18001
value = 18001

;Survival winscreen enemigo
[State 0, ChangeState]
type = ChangeState
triggerall = numenemy
trigger1 = enemynear,stateno=18000 && stateno !=18002
value = 18002

;sangre constante
[State 0, Helper]
type = Helper
trigger1 = life <= 250 && random < 10
trigger1 = roundstate = 2 && movetype != H && alive = 1
trigger1 = var(10)=0
trigger1 = stateno != 3300 && stateno != 3310 && stateno != 3200 && stateno != 3210
name = "sangre constante"
ID = 6100
stateno = 6100
pos = ceil(-14+(random/35)),ceil(cond(statetype!=c,-40,-20)-(cond(statetype!=c,(random/10),(random/12))))
facing = cond(random<500,1,-1)
ownpal = 1


