;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]


;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
freqmul = 1.3+(random/3333.3)

;camina
[State 0, PlaySnd]
type = PlaySnd
triggerall = animelem = 2
trigger1 = anim = 20
trigger2 = anim = 21
trigger3 = anim = 100
value = 800,8
freqmul = 1.1+(random/3333.3)
volume = -50

[State 0, PlaySnd]
type = PlaySnd
triggerall = time=1
trigger1 = stateno = 50
trigger2 = stateno = 105
value = 0,3
volume = -100
freqmul = 0.8+(random/6666.6)

;se cancela afterimage si es golpeado
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = movetype = h
time = 0

;DF
;baja el poder mientras esta en DF
[State -3, PowerAdd]
type = PowerAdd
triggerall = var(10) = 1
trigger1 = roundstate = 2
value = -3
ignorehitpause = 1

