type = Helper
trigger1 = numhelper(8500)=0 && id = 56
trigger1 = StageVar(info.name) = "el desierto"
name = "lanza-desierto"
ID = 8500
stateno = 8500
postype = left
pos = -100,0
ownpal = 1
facing = -1
;bindtime = -1
supermovetime = -1

;lanza desierto2
[State 0, Helper]
type = Helper
trigger1 = numhelper(8501)=0 && id = 56
trigger1 = StageVar(info.name) = "el desierto"
name = "lanza-desierto"
ID = 8501
stateno = 8500
postype = left
pos = 430,0
ownpal = 1
facing = -1
;bindtime = -1
supermovetime = -1

;caño prision 1
[State 0, Helper]
type = Helper
trigger1 = numhelper(8510)=0 && id = 56
trigger1 = StageVar(info.name) = "prision"
name = "caño-prision"
ID = 8510
stateno = 8510
postype = left
pos = -220,0
ownpal = 1
facing = 1
;bindtime = -1
supermovetime = -1

;caño prision 2
[State 0, Helper]
type = Helper
trigger1 = numhelper(8511)=0 && id = 56
trigger1 = StageVar(info.name) = "prision"
name = "caño-prision"
ID = 8511
stateno = 8510
postype = right
pos = 220,0
ownpal = 1
facing = -1
;bindtime = -1
supermovetime = -1

