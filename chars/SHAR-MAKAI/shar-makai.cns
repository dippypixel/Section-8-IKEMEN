pos = -20,-2
sprpriority = 100
ownpal = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time = 52 && facing = -1 && Pos X < fvar(15)
trigger2 = time = 52 && facing = 1 && Pos X > fvar(15)
value = 5

[State 18y, c]
type = ChangeAnim
trigger1 = time = 52 && facing = 1 && Pos X <= fvar(15)
trigger2 = time = 52 && facing = -1 && Pos X >= fvar(15)
trigger3 = anim = 5 && animtime = 0
value =  181
elem = cond(anim!=3450,1,6)

[State 0, Turn]
type = Turn
trigger1 = anim = 5 && animelem = 1

[State 182, 1]
type = AssertSpecial
trigger1 = time < 340
flag = roundnotover

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 200

[State 18y, c]
type = Changestate
trigger1 = anim = 181 && animtime = 0
value = 1812
ctrl = 0

