trigger1 = enemynear, movetype != h
trigger2 = enemynear, ctrl=1
var(17)=0
ignorehitpause =1

;var para JUGGLE de vomitada hyper
[State 0, VarSet]
type = VarSet
trigger1 = enemynear, movetype != h
trigger2 = enemynear, ctrl=1
var(16)=0
ignorehitpause =1

;var para JUGGLE 2 stHK
[State 0, VarSet]
type = VarSet
trigger1 = enemynear, movetype != h
trigger2 = enemynear, ctrl=1
var(20)=0
ignorehitpause =1

;timer para que no apmee jplp, bajando
[State 0, VarAdd]
type = VarAdd
trigger1 = 1
var(35)=-1

;timer para qque no apmee jplp, bajando
[State 0, Varset]
type = Varset
trigger1 = var(35)<0
var(35)=0

[State #, DTC]
type = DisplayToClipboard
trigger1 = 1
text = "var(35): %d"
params = var(35)
ignorehitpause = 1

;var para fatal texto
[State 0, VarSet]
type = VarSet
trigger1 = roundstate = 0 && facing = 1
var(33)=1


