;----------------------------------
;----------------------------------

;grito cuando sufre
[State -2, 1]
type = PlaySnd
triggerall = var(10) = 0 && time = 1 && alive
trigger1 = random < 500
trigger1 = (stateno = 5000)||(stateno = 5020)||(stateno = 5070)||(stateno = 5080)
value = 11,cond(random<333,1,cond(random<500,2,3))
channel = 15
freqmul = 0.9+(random/3333.3)
ignorehitpause = 1

;almacena posicion de P2
[State -2, GetP2Pos]
type = VarSet
trigger1 = RoundState <= 3
fvar(15) = enemynear, pos x

;temblor cuando aterriza
[State -2, temblor]
type = EnvShake
trigger1 = stateno = 52
trigger1 = time = 1
trigger2 = stateno = 5100
trigger2 = time = 1
trigger3 = stateno = 5110
trigger3 = time = 1
trigger4 = stateno = 106
trigger4 = time = 1
time = 15

;sonido de temblor
[State -2, 1]
type = PlaySnd
trigger1 = stateno = 5100
trigger1 = time = 1
trigger2 = stateno = 5110
trigger2 = time = 1
value = 40,0
freqmul = 1.2+(random/2500.0)
volume = -50

;DF
;bg palfx
[State -2, BGPalFX]
type = BGPalFX
trigger1 = var(10) = 1
time = 1
add = 0,-30,-30
color = 0
ignorehitpause = 1

;DF
;hit custom
[State -3, HitOverride]
type = HitOverride
trigger1 = stateno = 3450
trigger2 = stateno = 3460
trigger3 = stateno = 3490
trigger4 = stateno = 3420
trigger5 = stateno = 0 && anim = 3450
slot = 0
attr = SCA, AA,AP,AT
stateno = 3490
time = 1
ignorehitpause = 1

;DF
;inmune a throws
[State -3, NotHitBy]
type = NotHitBy
trigger1 = stateno = 3450
trigger2 = stateno = 3460
trigger3 = stateno = 3490
trigger4 = stateno = 3420
trigger5 = stateno = 0 && anim = 3450
value = ,AT
time = 1

;DF
;width
[State 0, Width]
type = Width
trigger1 = var(10) = 1
value = -15,-15

;DF
;apaga variable
[State 0, VarSet]
type = VarSet
trigger1 = life = 0
trigger2 = roundstate !=2
v = 10
value = 0

;DF
;BODYGUARD
[State 0, Helper]
type = Helper
helpertype = player
trigger1 = var(10)=1 && numhelper(35000)<=1
trigger1 = stateno != 3400 && stateno != 3420
name = "shar-df"
ID = 35000
pos = cond(random<500,75+(random/50),220+(random/50)),-300
postype = left
stateno = 3500
ownpal = 1

;DF no turn
[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = anim = 3450
flag = noautoturn

;para que no haga la winpose 3 contra final
[State 0, VarSet]
type = VarSet
trigger1 = enemynear, name = "final"
var(9)=1

