;var(17) = para juggle
;var(16) = cuando golpea con muchos gusanitos

; Stand
[Statedef 0]
type = S
physics = S
sprpriority = cond(anim=3450,12,0)

[State 0, b]
type = ChangeAnim
triggerall = life <= 250 && anim != 3450
trigger1 = Anim != 2 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 2

[State 0, 1]
type = ChangeAnim
triggerall = life > 250 && anim != 3450
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 191, Snd 2]
type = PlaySnd
triggerall = life <= 250
trigger1 = animelem = 10
value = 13,2
freqmul = 0.8+(random/2500.0)
volume = 100

[State 1010, 9]
type = explod
triggerall = life <= 250
triggerall = random < 500
trigger1 = animelem = 4
trigger2 = animelem = 10
anim = 5759
velocity = 0,0 ;syntax
accel = 0, .29
pos = 0,-95
postype = p1
sprpriority = 6
removetime = 29

;DF
;da control para winpose
[State 0, ctrl]
type = ctrlset
trigger1 = anim = 3450 && time = 70
value = 1

;DF
;width
[State 0, Width]
type = Width
trigger1 = anim = 3450
value = -15,-15

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = cond(sysvar(1)=0, const(velocity.jump.neu.x), cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 0, Explod]
type = Explod
trigger1 = AnimTime = 0
anim = f 63
pos = 0,10
facing = cond(random<500,1,-1)
scale = 0.3,0.3
sprpriority = 3
ownpal = 1

[State 0, Explod]
type = Explod
trigger1 = AnimTime = 0
anim = f 64
scale = 0.5,0.5
pos = 0,10
facing = cond(random<500,1,-1)
sprpriority = 0
ownpal = 1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = cond((vel x)=0, 41, cond((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 0, VarSet]
type = VarSet
trigger1 = time = 3
v = 15
value = 0

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

;salto largo
[State 100, 4]
type = ChangeState
trigger1 = command = "holdup"
trigger2 = command = "holdfwd" && command = "holdup"
trigger3 =  command = "holdback" && command = "holdup"
value = 40
ctrl = 0

;ataques basicos
;---------------
[State 100, 4]
type = ChangeState
trigger1 = command = "a"
value = 200
ctrl = 0

[State 100, 4]
type = ChangeState
trigger1 = command = "y"
value = 210
ctrl = 0

[State 100, 4]
type = ChangeState
trigger1 = command = "a"
value = 230
ctrl = 0

[State 100, 4]
type = ChangeState
trigger1 = command = "b"
value = 240
ctrl = 0
;----------------------

[State 100, 4]
type = ChangeState
trigger1= var(24)=0 && command != "holdfwd"
trigger2= var(24)!=0 && p2bodydist x<60
trigger3= var(24)>=2 && var(24)<=3 && enemynear, name = "ananzi" && enemynear, numhelper(1100)=1
trigger4 = var(24)>=2 && var(24)<=3 && enemynear, name = "ananzi" && enemynear, stateno = 3100
value = 0
ctrl = 1

