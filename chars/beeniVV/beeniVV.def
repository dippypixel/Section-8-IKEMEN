; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "BeeniVV"        ;Name of character
displayname = "BeeniVV" ;Name of character to display
versiondate = 09,30,2009    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.1
ikemenversion = 0.99.2
author = "beenibroh"         ;Character author name
pal.defaults = 1,2,3,4

; Files for the player
[Files]
cmd     = beeni.cmd           ;Command set
cns     = beeni.cns           ;Constants
st      = beeni.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = beeni.sff           ;Sprite
anim    = beeni.air           ;Animation
sound   = beeni.snd           ;Sound
ai      = beeni.ai            ;AI hints data (not used)
movelist = movelist.dat     ;Ikemen feature: Movelist

[Palette Keymap]
a = 1
b = 2
c = 3
x = 1
y = 2
z = 3
a2 = 4
b2 = 5
c2 = 6
x2 = 4
y2 = 5
z2 = 6

[Map]
partOfTheGang = 1

defenceBuff = 1.1
attackBuff = 1
speedBuff = 1.1
airAccelBuff = 1
specialRecharge = 300  ;Kick
specialRecharge2 = 300 ;Anti-air
specialRecharge3 = 180 ;Projectile
numSpecials = 3
wallClingOffset = 154
airAccel = .65
landVoiceClips = 2
maxPal = 34
curPal = 0

numTagInLines = 13
randomParryAnims = 4


; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
