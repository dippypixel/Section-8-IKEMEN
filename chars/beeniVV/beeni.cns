[State -2, Uppercut Cooldown]
type = VarAdd
trigger1 = stateno = 602 && time = 1
v =  7 ;fv = 
value = 1

[State -2, Reset Uppercut Cooldown when land]
type = VarSet
trigger1 = statetype !=A
;trigger2 = !numtarget
v = 7   ;fv = 10
value = 0

[State -2, Lilbros Spitball slowdown decrease]
type = VarAdd
trigger1 = var(55)
v = 55
value = -1
ignorehitpause = 1

[State -2, DMG buff]
type = AttackMulSet
trigger1 = power = powermax
value = 1 * map(attackBuff) * ifelse(map(attackDebuffTime) > 0, map(attackDebuff), 1)
[State -2, reset DMG buff when not at full power]
type = AttackMulSet
trigger1 = power < powermax
value = 1 * ifelse(map(attackDebuffTime) > 0, map(attackDebuff), 1)

[State -2, DEF buff]
type = DefenceMulSet
trigger1 = power = powermax
value = 1 * map(defenceBuff) * ifelse(map(defenceDebuffTime) > 0, map(defenceDebuff), 1)
[State -2, reset DEF buff when not at full power]
type = DefenceMulSet
trigger1 = power < powermax
value = 1 * ifelse(map(defenceDebuffTime) > 0, map(defenceDebuff), 1)

[State -2, HurtSFX]
type = PlaySnd
triggerall = alive && stateno != 700
triggerall = random >= 500
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5070)
trigger1 = !time
trigger2 = (stateno != 5000) && (stateno != 5010) && (stateno != 5020) && (stateno != 5070)
trigger2 = (stateno != [120,160]) && (stateno != [700,799])
trigger2 = gethitvar(damage)
value = 5000,0+(random%9)
channel = 10

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nocrouch

[State -2, Reset Wall Jump]
type = VarSet
trigger1 = statetype != A
trigger2 = movetype = H
v = 53
value = 0
ignorehitpause = 1

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1 
text = "super = %d"
params = sysvar(1)
ignorehitpause = 1

[State -2, Walk Sounds pt1]
type = PlaySnd
triggerall = anim = 20
trigger1 = AnimElem = 5
trigger2 = AnimElem = 10
value = 20, 0

[State -2, Walk Sounds pt2]
type = PlaySnd
triggerall = anim = 21
trigger1 = AnimElem = 3
trigger2 = AnimElem = 8
value = 20, 0

[State -2, Walk Sounds pt3]
type = PlaySnd
triggerall = anim = 100
trigger1 = AnimElem = 2
trigger2 = AnimElem = 6
value = 20, 0

;Velocity Deterioration system (Edited from RicePigeon's Damage Proration system)
[State -2, Reset velocity dampener]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,statetype!=A)
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(20) = 1.0
[State 0, Make sure it never goes under the limit]
type = VarSet
trigger1 = fvar(20) < 0.25
fv = 20 
value = 0.25
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -2, Jump Voiceclips]
type = PlaySnd
trigger1 = stateno = 40 && anim=40 && AnimTime = 0
value = S40,0 + random%2
channel = 0
[State -2, WallJump Voiceclips]
type = PlaySnd
trigger1 = stateno = 55  && command != "holdfwd" && command != "holdback"
value = S40,2 + random%2
channel = 0

[State 0, VictoryQuote]
type = VictoryQuote
trigger1 = 1
value = 0