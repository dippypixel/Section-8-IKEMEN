trigger1 = sysvar(0)
trigger1 = command = "hold_c"
value = 130

[State 132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]
type = ChangeState
trigger1 = command != "hold_c"
trigger2 = var(5) <= 1
value = 140

