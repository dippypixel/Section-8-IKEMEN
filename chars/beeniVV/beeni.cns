; Jump Start (converted to .cns)
 [Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1 

[State 0, NotHitBy]
type = NotHitBy
trigger1 = name != "Matt (Boss)" || (name = "Matt (Boss)" && map(isHeavy) != 1)
value = ,AT
time = 1

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
x = 0


[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y != 0
statetype = A
[State 0, VelSet]
type = VelSet
trigger1 = pos y != 0
y = 0

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0
[State 0, VarSet]
type = VarSet
trigger1 = command = "holdback" && aiLevel=0
sysvar(1) = -1
[State 0, VarSet]
type = VarSet
trigger1 = (command = "holdfwd" && aiLevel=0) || aiLevel>0
sysvar(1) = 1

[State 0, VelSet]
type = VelSet
trigger1 = animtime = 0
x = ifelse(sysvar(1) = 0, const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, ifelse(prevstateno = 100, ifelse(power=powermax,const(velocity.runjump.fwd.x)*map(speedBuff), const(velocity.runjump.fwd.x)), ifelse(power=powermax, const(velocity.jump.fwd.x)*map(speedBuff), const(velocity.jump.fwd.x))), ifelse(power=powermax,const(velocity.jump.back.x)*map(speedBuff),const(velocity.jump.back.x))))*ifelse(command="holdup", 1, 1.334)*ifelse(var(55) && map(spitballEffect) = 1, .8, 1)
y = ifelse(((aiLevel && enemynear, pos y < 0 && enemynear, vel y >= 1) || (!ailevel && command = "holdup")), const(velocity.jump.y)*ifelse(var(55) && map(spitballEffect) = 1, .8, 1), const(velocity.jump.y)*ifelse(map(shortJumpMul)=0, 0.667, map(shortJumpMul))*ifelse(var(55) && map(spitballEffect) = 1, .8, 1))


[State 0, Explod]
type = Explod
trigger1 = animtime = 0
anim = 20060
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = ifelse(vel x >= 0,1, -1)
vfacing = 1
bindtime = 0
vel = -vel x /3,0
removetime = -2
sprpriority = 3
ontop = 0
ownpal = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = animtime=0 
value = 50
ctrl = 1
 


