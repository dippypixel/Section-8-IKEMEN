x = ifelse(sysVar(1) =1,const(velocity.run.back.x)*map(speedBuff)*ifelse(map(backDashFwdMult)!=0, map(backDashFwdMult), 0.5),const(velocity.run.back.x)*map(speedBuff))
y=  const(velocity.run.back.y)

[State 0, Explod]
type = Explod
trigger1 = Time = ifelse(map(backDashStartup) > 0, map(backDashStartup), 2)
anim = 20060
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = ifelse(vel x >= 0,1, -1)
vfacing = 1
bindtime = 0
vel = -vel x /3,0
removetime = -2
sprpriority = 3
ontop = 0
ownpal = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = Time = ifelse(map(backDashStartup) > 0, map(backDashStartup), 2)
value =50
ctrl = 1


;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchange
ctrl = 0

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 4]
type = StateTypeSet
triggerall = Time = 0 
trigger1 = statetype = A 
trigger2 = pos y != 0
physics = A

[State 120, 3]
type = StateTypeSet
trigger1 = EnemyNear,HitDefAttr = C, NA, SA, HA
statetype = C

[State 120, 5]
type = ChangeState
trigger1 = Time = 1
value = ifelse(statetype =A,132,130)

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "hold_c" 
trigger2 = var(5) = 0
value = 140

;---------------------------------------------------------------------------
; Stand guard (guarding)
