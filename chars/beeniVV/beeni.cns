[State 12345, AS]
type=assertspecial
trigger1=1
flag=noshadow

[State 12345, Reset]
type=varset
trigger1=!time
fvar(38)=200

[State 12345, Pal]
type=varset
trigger1=!time
fvar(36)=root,palno
 
[State 12345, Varset]
type=varset
triggerall = root,command!="start"
trigger1=fvar(36)<1||fvar(36)>root,map(maxPal) ; last palette
fvar(36)=1+(fvar(36)<1)*(root,map(maxPal)-1) ; subtract -1 from your last palette

[State 12345, PlaySnd]
