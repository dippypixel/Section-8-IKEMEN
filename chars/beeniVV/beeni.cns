physics = S
ctrl = 0
[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 120, 3]
type = StateTypeSet
trigger1 = EnemyNear,HitDefAttr = S, NA, SA, HA
statetype = S

[State 120, 3]
type = StateTypeSet
trigger1 = EnemyNear,HitDefAttr = C, NA, SA, HA
statetype = C

[State 0, ChangeState]
type = ChangeState
trigger1 = pos y != 0
value = 132

[State 130, Stop Guarding]
type = ChangeState
trigger1 = command != "hold_c"
trigger2 = var(5) <= 1
value = 140

;---------------------------------------------------------------------------
; Air guard (guarding)
