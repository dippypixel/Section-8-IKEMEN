ground.velocity = -5.5
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -5,-8.8
air.hittime = 20
air.fall = 1
fall.recovertime = 40
id = 123
yaccel = .88
ground.cornerpush.veloff = 0

[State 0, StateTypeSet]
type = StateTypeSet
