; RUN_FWD
[Statedef 100]
type    = C
physics = C
anim = 100
sprpriority = 1
ctrl = 0

[State 0, Explod]
type = Explod
trigger1 = animelemtime(3) = 1
trigger2 = animelem = 4
anim = 905
ID = 905
pos = 16,0
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = 1,1
sprpriority = 3
ownpal = 1
[State 0, PosAdd]
type = PosAdd
trigger1 = animelem = 3
x = 14
ignorehitpause = 1
[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 3
value = S0,0
[State 100, 1]
type = VelSet
trigger1 = animelemtime(3) >= 0
trigger1 = animelemtime(4) < 0
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 0, CtrlSet]
type = CtrlSet
trigger1 = animelem = 5
value = 1

[State 100, 4]
type = ChangeState
trigger1 = animtime = 0
value = 11
ctrl = 1



