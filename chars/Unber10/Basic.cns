[State 800, AfterImage]
type = AfterImage
trigger1 = !time
time = 25
length = 10
palinvertall = 0
palcolor = 255
paladd = 50,50,150
timegap = 1
framegap = 5
trans = add1

[State 810, 2]
type = PlaySnd
trigger1 =  AnimElem = 1
value = 3,3
channel = 4

[State 810, NotHitBy]
type = NotHitBy
trigger1 = Animelem = 6,<= 0
value =  ,AA,AP

[State 810, VelSet]
type = VelSet
trigger1 = AnimElemTime(2) > 0
x = -6.8

[State 810, VelSet]
type = VelSet
trigger1 = AnimElem = 7, >= 0
x = 0

[State 810, PlayerPush]
type = PlayerPush
trigger1 = AnimElemTime(7) > 0
value = 0

[State 810, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Initialize(at the start of the round)
[Statedef 5900]
type=S

[state ];GGキャラ専用勝ち挑発（RAKUSYO）対応ステート
Type=PowerAdd
trigger1=roundsexisted>=1&&var(43)=1
Value=1500
persistent=0

[state ];GGキャラ専用勝ち挑発（RAKUSYO）解除ステート
type=Varset
trigger1=roundsexisted>=1&&var(43)=1
var(43)=0

[State ]
type=ChangeState
trigger1=roundsexisted=0&&teammode=turns
value=191

[State ]
type=VarRangeSet
trigger1=roundsexisted=0&&(TeamMode=single ||TeamMode=simul)
value=0

[State ]
type=VarRangeSet
trigger1=roundsexisted=0&&(TeamMode=single ||TeamMode=simul)
fvalue=0

[State ];iwakickさん製作キャライントロ対応
type=ChangeState
trigger1=prevstateno!=100191&&((teammode=single &&roundno=1)||teammode=turns)&&!(teammode=simul)&&enemy,animexist(18000)&&enemy,stateno!=192&&enemy,stateno!=199&&enemy,authorname="iwakick"
value=100191

[State ]
type=ChangeState
trigger1=roundno=1
value=190

;---------------------------------------------------------------------------
; SPECIAL CUSTOM STATES

;---------------------------------------------------------------------------
; Iwakick Colossus Intro
[Statedef 100191]
type=L
ctrl=0
velset=0,0
anim=0

[state ]
type=varset
trigger1=enemy,authorname="iwakick"&&(enemy,name="silversamurai"||enemy,name="spiral")&&sysvar(0)=0
sysvar(0)=1102

[state ]
type=varset
trigger1=enemy,authorname="iwakick"&&(enemy,name="silversamurai"||enemy,name="spiral")&&sysvar(1)=0
sysvar(1)=1

[state ]
type=varset
trigger1=enemy,authorname="iwakick"&&(enemy,name="silversamurai"||enemy,name="spiral")&&sysvar(2)=0
sysvar(2)=2

[State ]
type=AssertSpecial
trigger1=1
flag=Intro

[state ]
type=hitby
trigger1=enemy,authorname="iwakick"
value=S,HT

[State ]
type=ChangeState
trigger1=roundno=1&&time=31
value=190

[State ]
type=ChangeState
trigger1=roundno>1&&time=31
value=5900

[Statedef 100192]
type=L
ctrl=0
velset=0,0
anim=0
 
[state ]
type=hitby
trigger1=enemy,authorname="iwakick"
value=S,HT

[State ]
type=AssertSpecial
trigger1=1
flag=noshadow
flag2=invisible

[State ]
type=destroyself
trigger1=ishelper&&(roundstate>1||root,alive=0)

;VSシリーズイントロ対応ステート
[Statedef 100194]
type=S
ctrl=0
velset=0,0
anim=0
SprPriority=65

[state ]
type=assertspecial
trigger1=enemy,anim!=183
flag=invisible

[state ]
type=turn
trigger1=enemy,var(16)=0&&((root,teamside=1&&facing=-1)||(root,teamside=2&&facing=1))

[state ]
type=varset
trigger1=time=0
var(0)=floor(screenpos y)
persistent=0

[state ]
type=posset
trigger1=time=1
y=var(0)-var(0)

[state ]
type=varset
trigger1=time=2
var(0)=240-floor(screenpos y)
persistent=0

[state ]
type=posset
trigger1=time=3
x=-facing*60
y=-20+var(0)

[state ]
type=posset
trigger1=enemy,var(16)
x=facing*240+(var(1)*facing)
y=-180+var(0)+var(2)
persistent=0

[state ]
type=posadd
trigger1=enemy,var(16)=[21,50]
x=-facing*facing*16
y=-2

[state ]
type=posset
trigger1=enemy,var(16)=51
x=-facing*240+(var(1)*facing)
y=-240+var(0)+var(2)

[state ]
type=posadd
trigger1=enemy,var(16)>80
x=0.1

[state ]
type=SprPriority
trigger1=enemy,var(16)
value=54

[state ]
type=changeanim
trigger1=enemy,anim=183
value=8000
persistent=0

[state ]
type=changeanim
trigger1=enemy,var(16)
value=8002
persistent=0

[State ]
type=destroyself
trigger1=ishelper&&(roundstate>1||root,alive=0)

[Statedef 100195]
type=S
ctrl=0
velset=0,0
anim=0
sprpriority=65

[State ]
type=AssertSpecial
trigger1=enemy,var(16)<1000||(enemy,var(16)=[10000,1000000])
flag=invisible

[state ]
