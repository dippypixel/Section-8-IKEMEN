trigger1=time=0
var(0)=floor(screenpos y)
persistent=0

[state ]
type=varset
trigger1=time=1
var(0)=240-floor(screenpos y)
persistent=0

[state ]
type=posset
trigger1=var(10)=23
x=facing*(-100)
y=-20+var(0)

[state ]
type=posset
trigger1=enemy,var(16)>1000000
x=(-facing*(enemy,var(0)))+(-facing*var(1))
y=var(0)+240+var(2)
persistent=0

[state ]
type=posadd
trigger1=enemy,var(16)=[1000000,1000010]
x=1
y=-10

[state ]
