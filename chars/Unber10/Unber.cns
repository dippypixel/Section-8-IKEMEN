value = S190,1
channel = 0

[State 192, PlaySnd]
type = PlaySnd
trigger1 = Animelem = 7
value = S190,0
channel = 0

[State 191, StopSnd]
type = StopSnd
trigger1 = command = "a" || command = "b" || command = "c" || command = "x" || command = "y" || command = "z" 
channel = 0
persistent = 0

[State 191, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

