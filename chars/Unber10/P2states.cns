;---------------------------------------------------------------------------
; Grab P2 State
[Statedef 305]
movetype = H
physics = N
velset = 0,0
ctrl = 0

[State 801, ScreenBound]
type = ScreenBound
trigger1 = time <50
value = 1
movecamera = 10,0

[State 305, ChangeAnim2]
type = ChangeAnim2
trigger1 = !Time
value = 305

[State 305, Gravity]
type = Gravity
trigger1 = Time > 17

[State 305, SelfState]
type = SelfState
trigger1 = Pos Y > 0 && Vel Y > 0
value = 5100

;---------------------------------------------------------------------------
; Reagge Punch P2
[Statedef 3002]
type    = S
movetype= H
physics = N
ctrl = 0
velset = 0,0
sprpriority = -1

[State 3002, PosSet]
type = PosSet
trigger1 = Time = 1
y = 0

[State 3002, ScreenBound]
type = ScreenBound
trigger1 = Animelem = 3
value = 1
movecamera = 0,0

[State 3002, ChangeAnim2]
type = ChangeAnim2
trigger1 = !time
value = 3002

[State 3002, StateTypeSet]
type = StateTypeSet
trigger1 = Animelem = 3
statetype = A 

[State 3002, VelAdd]
type = VelAdd
trigger1 = Animelem = 3
x = -2
y = -12

[State 3002, HitAdd]
type = HitAdd
trigger1 = Animelem = 3
value = 1

[State 3002, LifeAdd]
type = LifeAdd
trigger1 = Animelem = 3
value = -141

[State 3002, Gravity]
type = Gravity
trigger1 = Time > 32

[State 3002, FallEnvShake]
type = FallEnvShake
trigger1 = Pos Y > 0 && vel Y > 0

[State 3002, SelfState]
type = SelfState
trigger1 = Pos Y > 0 && vel Y > 0
value = 5100

;---------------------------------------------------------------------------
; Divekick State
[Statedef 6000]
type = S
movetype = H
physics = S
ctrl = 0

[State 0, PosSet]
type = PosSet
trigger1 = time = 1
y = 0

[State 0, ChangeAnim2]
type = ChangeAnim2
trigger1 = Time = 0
value = 5300

[State 0, VelSet]
type = VelSet
trigger1 = Time = 0
x = -8
y = 0

[State 0, VelMul]
type = VelMul
trigger1 = Time%8 = 0
x = 1

[State 0, ChangeState]
type = SelfState
trigger1 = time = 48
value = 0
ctrl = 1