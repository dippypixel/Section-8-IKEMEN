[Statedef -1]
;===========================================================================
;---------------------------------------------------------------------------
[State -1, AI Guard]
Type = ChangeState
Value = 120
triggerall = Var(15) != 0 && Ctrl
trigger1 = (Var(15)*Var(15)*Var(15)*2)*0.1
trigger1 = !(enemynear,hitdefattr=SCA,AT) && inguarddist
trigger1 = (stateno!=[120,155])

;---------------------------------------------------------------------------
;Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "start" && !Var(15)
;---------------------------------------------------------------------------
;Dodge Foward
[State -1, Dodge Foward]
type = ChangeState
value = 800
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "z" && command = "holdfwd"&& !Var(15)

;---------------------------------------------------------------------------
;Dodge Back
[State -1, Dodge Back]
type = ChangeState
value = 810
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "z" && command = "holdback"&& !Var(15)

