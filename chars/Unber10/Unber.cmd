; Air Corkscrew
[State -1, Air Corkscrew]
type = ChangeState
value = 3010
triggerall = power >= 1000
triggerall = statetype = A
triggerall = ctrl || (stateno = 600 || Stateno = 610 || Stateno = 630 || Stateno = 640 || Stateno = 645) && MoveContact
trigger1 = (command = "QCB_xy" || command = "QCB_ab") && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI chains from HP
trigger2 = (StateNo = [600,645]) && MoveHit && !MoveReversed && EnemyNear,Pos Y > Pos Y

