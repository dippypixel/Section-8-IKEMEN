;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State 0, Snd Jump]
type = PlaySnd
trigger1 = stateno = 40
trigger1 = animtime = 0
trigger2 = stateno = 45
trigger2 = time = 1
value = S0,18
channel = 1

[State Collapse turning]
type = Turn
trigger1 = anim = 5950
trigger1 = animelem = 44
trigger2 = anim = 5131
trigger2 = animelem = 30

[State IntroSkip]
type = VarAdd
trigger1 = var(28) < 5
trigger1 = roundstate = 2
var(28) = 1
[State IntroSkip]
type = StopSnd
trigger1 = var(28) = 1
channel = 1
ignorehitpause = 1
[State 0, EnvShake]
type = EnvShake
trigger1 = var(28) = 1
time = 1
freq = 0
ampl = 0

[State Prepare the ballistic mode]
type = VarSet
triggerall = var(29) = 0
triggerall = life <= (p2life / 2)
triggerall = life <= (lifemax * 0.3)
trigger1 = stateno = 5120
trigger2 = movetype = H
trigger2 = prevstateno = [1000,1999]
var(29) = -2
ignorehitpause = 1
[State Count down the ballistic mode]
type = VarAdd
trigger1 = var(29) > 1
var(29) = -1
ignorehitpause = 1
[State Disable the ballistic mode]
type = VarSet
trigger1 = var(29) = 1
var(29) = -1
ignorehitpause = 1

[State Get rights to the Pixies Song]
type = TargetState
trigger1 = var(47) = 0
trigger1 = numtarget
trigger1 = winko
trigger1 = roundstate = 3
trigger1 = matchover
trigger1 = target,stateno = 5150
trigger1 = target,sysvar(4) != 4440
value = 5150

[State CHAOS?!]
type = VarSet
trigger1 = palno = [7,12]
trigger2 = name = "Giant Ape That Pisses on People"
var(47) = 1
ignorehitpause = 1

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noairguard
ignorehitpause = 1

[State 0, ]
type = PlaySnd
triggerall = alive
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5070)
trigger1 = time = 0
trigger2 = (stateno != 5000) && (stateno != 5010) && (stateno != 5020) && (stateno != 5070)
trigger2 = stateno != [120,160]
trigger2 = gethitvar(damage)
value = 5000,0+(var(47)=1)
channel = 0
ignorehitpause = 1

; if you're making a 10ov.st and copied the statedef -2 in it's entirety, uncomment this strcl so e.g. the hitpauses in both mugen versions would be the same
