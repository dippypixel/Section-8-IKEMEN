trigger1 = 1
x = (-6+((time%4)*3)) * facing
y = 0
ignorehitpause = 1

[State 5000, 6]
type = SelfState
trigger1 = time >= 14
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = ifelse(statetype=C,5011,5001) ;Stand get-hit (knocked back)

[State 5000, 7]
type = SelfState
trigger1 = time >= 14
value = 5030


