; Definition file for Viper
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Viper"        ;Name of character
displayname = "Viper" ;Name of character to display
versiondate = 05,31,2018    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 4,1,5,6,2,3


; Files for the player
[Files]
cmd     = viper.cmd   ;Command set
cns     = viper.cns   ;Constants
st      = viper.cns   ;States
st3     = config.txt
stcommon = common1.cns ;Common states
sprite  = viper.sff   ;Sprite
anim    = viper.air   ;Animation
sound   = viper.snd   ;Sound
pal1	= mic_ending.act
pal2	= mic_blackhole.act
pal3	= mic_fatalbert.act
pal4    = viper.act
pal5	= mic_macktheknife.act
pal6	= mic_homunculus.act
pal7	= meldo_eifel65.act
pal8	= meldo_gameboy.act
pal9	= meldo_virtualboy.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
