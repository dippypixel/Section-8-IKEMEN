; definition file for kung fu man
; contains all the filenames needed for the character

; player information
[info]
name ="Super Better Luigi V3"        
displayname ="SBL (Poyomousy AI)" 
versiondate = 07,15,2019    
mugenversion = 1.0   
author ="DS12"
pal.defaults = 1,2,3,4,5  

; files for the player
[files]
cmd     = LuigiAI/Super Better Luigi.cyd   ;command set
cns     = LuigiAI/Super Better Luigi.cns   ;constants
st      = LuigiAI/Super Better Luigi.cns   ;states
stcommon = LuigiAI/common1.cns ;common states
sprite  = Super Better Luigi.sff   ;sprite
anim    = Super Better Luigi.air   ;animation
sound   = Super Better Luigi.snd   ;sound
pal1    = Super Better Luigi.act  ;palettes (can have up to 12)
pal2    = Green-DarkGray.act
pal3    = Red-DarkGray.act
pal4    = Blue Dood.act
pal5    = Magenta-BrownRed.act
pal6    = LightBlue-DarkBlue.act
pal7    = LightGray-Green.act
pal8    = Orange-LightBlue.act
pal9    = Brown-BrightYellow.act
pal10   = SLG4.act
pal11   = SuperLuigiMaker.act
pal12   = SuperBetterLuiginoids.act
st1=LuigiAI/specials.cns
st2=LuigiAI/hypers.cns
st3=LuigiAI/AISystem.st
; arcade mode
[arcade]
intro.storyboard =
ending.storyboard =