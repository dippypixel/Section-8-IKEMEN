trigger1 = Vel Y > 0 && Pos Y >= 0
y = 0

[State 0, VelSet]
type = VelSet
trigger1 = Vel Y > 0 && Pos Y >= 0
x = 0
y = 0
ignorehitpause = 1
persistent = 1

