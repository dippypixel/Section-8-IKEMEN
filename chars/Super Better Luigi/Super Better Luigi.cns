trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 1

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State 3002, 2]
type = PlaySnd
trigger1 = !time
value = s3300,0
volumescale = 80

[State 3002, 2]
type = PlaySnd
trigger1 = !time
value = s3300,1
channel = 7
volumescale = 80

[State 3000, Charge]
type=explod
trigger1 = !time
anim=3302
ID=1
sprpriority=1
postype=p1
pos=-19,-34
removetime=-1
bindtime = -1
scale=0.3,0.3
supermovetime = 999
ownpal = 1

[State 3000, Charge]
type=explod
trigger1 = !time
anim=3302
ID=1
sprpriority=1
postype=p1
pos=28,-36
removetime=-1
bindtime = -1
scale=0.3,0.3
supermovetime = 999
ownpal = 1

[State 0, StopSnd]
type = StopSnd
trigger1 = parent,anim != 9
channel = 7

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = parent,anim != 9
id = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = parent,anim != 9
