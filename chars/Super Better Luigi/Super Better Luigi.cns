;==========================================================================
;[Info]
;author = "Inktrebuchet" 
;versiondate = 12/13/2018                  
;goal = Detect enemy projectile (helper). For use with AI. ( M.U.G.E.N | IKEMEN )
;       ?????(helper)?????? AI????????
;==========================================================================
;                Notes
;==========================================================================
;notes:
;-Enemy projectile now has a PlayerID use PlayerID(helper(33333333),var(3)) as a redirect.
;
;base examples of trigger use: 
;
;;Enemy projectile helper distance from character.
;trigger1 = PlayerIDExist(helper(33333333),var(3))
;trigger1 = PlayerID(helper(33333333),var(3)), p2bodydist x 
;
;;Enemy projectile helper velocity.
;trigger1 = PlayerIDExist(helper(33333333),var(3))
;trigger1 = PlayerID(helper(33333333),var(3)), Vel X
;
;==========================================================================
;                Helper var usage.
;==========================================================================
; numhelper(33333333) Variable usage:
; This is a record of the variables that are used
;
; var(0) - highest playerid + 1
; var(3) - projectile player id while it exists
; 
;==========================================================================
[Statedef 33333333]
type = A
movetype = I
physics = N
ctrl = 0
velset = 0, 0
 
;==========================================================================
;                Config Section
;==========================================================================
anim = 9999                   ; blank animation
 
;==========================================================================
;                Detect Enemy Projectile Helper
;==========================================================================
[State 33333333, 0]
type = Null
trigger1 = var(55) = 0
trigger1 = (var(55) := id)
ignorehitpause = 1
 
[state 33333333, 1] 
type = varadd
trigger1 = PlayerIdExist(var(55)) 
trigger2 = PlayerIdExist(var(55)+1) 
trigger3 = PlayerIdExist(var(55)+2) 
trigger4 = PlayerIdExist(var(55)+3) 
trigger5 = PlayerIdExist(var(55)+4) 
trigger6 = PlayerIdExist(var(55)+5) 
trigger7 = PlayerIdExist(var(55)+6) 
trigger8 = PlayerIdExist(var(55)+7) 
trigger9 = PlayerIdExist(var(55)+8) 
trigger10 = PlayerIdExist(var(55)+9) 
trigger11 = PlayerIdExist(var(55)+10) 
trigger12 = PlayerIdExist(var(55)+11) 
trigger13 = PlayerIdExist(var(55)+12) 
trigger14 = PlayerIdExist(var(55)+13) 
trigger15 = PlayerIdExist(var(55)+14) 
trigger16 = PlayerIdExist(var(55)+15) 
trigger17 = PlayerIdExist(var(55)+16) 
trigger18 = PlayerIdExist(var(55)+17) 
trigger19 = PlayerIdExist(var(55)+18) 
trigger20 = PlayerIdExist(var(55)+19) 
trigger21 = PlayerIdExist(var(55)+20) 
trigger22 = PlayerIdExist(var(55)+21) 
trigger23 = PlayerIdExist(var(55)+22) 
trigger24 = PlayerIdExist(var(55)+23) 
trigger25 = PlayerIdExist(var(55)+24) 
trigger26 = PlayerIdExist(var(55)+25) 
v = 55
value = 1
ignorehitpause = 1
 
[State 33333333, 2]
