trigger1 = PlayerID(gethitvar(fall.envshake.ampl)),StateNo != [3906,3907]
trigger2 = PlayerID(gethitvar(fall.envshake.ampl)),StateNo = 3911
value = 0
persistent = 0

[State 3316, Revert to normal sprpriority]
