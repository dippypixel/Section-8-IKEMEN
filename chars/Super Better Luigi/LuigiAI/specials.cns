type = VelSet
trigger1 = Time = 0
X = IfElse((facing = -1 && Pos X > enemy,cond(numhelper(28526969),helper(28526969),cond(1,pos X,0),0)) || (facing = 1 && Pos X < enemy,cond(numhelper(28526969),helper(28526969),cond(1,pos X,0),0)), 4, -4)
