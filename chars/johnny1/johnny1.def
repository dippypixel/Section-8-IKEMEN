;--| 基情報 |---------------------------------------------------------------

[Info]
Name         = "johnny"  ;キャラクの名前（必要な目なので省略不可）
DisplayName  = "johnny"  ;M.U.G.E.Nで実際に示される名前（省略可）
VersionDate  = 04,14,2002     ;キャラクの最終更新日（変えなくてもＯＫ）
MugenVersion = 1.0     ;キャラクが動作出来るM.U.G.E.Nの改訂版
Author       = "salami"     ;キャラクの作成者（必要な目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6       ;ＣＰＵで出てきた時のカラパレットの順番

;--| 必要なフイルの設定 |---------------------------------------------------

[Files]
Cmd     = johnny.cmd       ;コンドフイルの登
Cns     = johnny.cns       ;コンスンツフイルの登
St      = johnny.cns       ;ステトフイルの登・最大１１個まで増やせます
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な目なので省略出来ません
StCommon = johnny_common.cns  ;コモンステトフイルの登
Sprite  = johnny.sff       ;複数のＰＣＸ画像をまとめたスプライトフイルの登
Anim    = johnny.air       ;アニメションフイルの登
Sound   = johnny.snd       ;複数のＷＶＥ音声をまとめたサウンドフイルの登

;--| カラパレットフイル |-------------------------------------------------
;
; キャラクの色を定するフイルは最大１２個まで登が可です。
;
; なお、Pal712（７Ｐ１２Ｐカラ）を選びたい時は、
; ストン（Ｓン）を押しながらキャラクを決定すれば使えます。
; この要素を利用して『キャラ』や『殺意の波動に目覚めたリュウ』などの
; 別性バジョンも１体のキャラの中で作る事が可。
;
;-----------------------------------------------------------------------------

Pal1 = johnnygreenBlack.act  ;ンで決定した色が使えます
Pal2 = johnny.act  ;Ｂ
Pal3 = johnnyred.act  ;Ｃ
Pal4 = johnnygreen.act   ;Ｘ
Pal5 = johnnydark.act  ;Ｙ
Pal6 = johnnydark.act  ;Ｚ

Pal7 = johnnygreenBlack.act  ;Ｓ押しながらンで決定した色が使えます
Pal8 = johnnyredBlack.act  ;Ｓ押しながらＢ
Pal9 = johnnyredBlack.act  ;Ｓ押しながらＣ
Pal10= johnnyBlack.act  ;Ｓ押しながらＸ
Pal11= johnnydarkBlack.act  ;Ｓ押しながらＹ
Pal12= johnnydarkBlack.act  ;Ｓ押しながらＺ

;-----------------------------------------------------------------------------

