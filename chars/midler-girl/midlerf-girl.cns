;===========================================================================

; 通常攻撃技
;===========================================================================
;---------------------------------------------------------------------------
; 通常技はそんなに難しいテクニックは使ってないから、
; テンプレートを見ながら確認すれば覚えやすいと思う。
; 基本忘るべからず。
;
; ステートナンバーは、立ち技が２００～２９９、しゃがみ技が４００～４９９、
; ジャンプ技が６００～６９９の間で決めて作るのが一般的。
; しかし強制じゃないので自由に作っちゃってＯＫ。
;---------------------------------------------------------------------------
;パンチ
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 2
velset = 0,0
ctrl = 0
anim = 200
poweradd = 50
sprpriority = 2
facep2 = 1

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = time=1
value = 1, 1
channel=0

[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = animelem = 1
value = 1, 3

[State 200, ヒット定義]
type = HitDef
trigger1 = AnimElem =2 
attr = S, NA ;立ち通常打撃（Standing, Normal Attack）
damage = 15, 2
animtype = Light
guardflag = M
hitflag = MAF
priority = 4, Hit
pausetime = 4, 8
sparkno = S10006
sparkxy = -10, -45
hitsound = S1, 4
guardsound = S6, 0
ground.type = Low
ground.slidetime = 9
ground.hittime  = 11
ground.velocity = -3
airguard.velocity = -1,-.4
air.type = High
air.velocity = -1,-1.5
air.hittime = 8
ground.cornerpush.veloff = -4.5 
guard.kill = 0

[State 1000, 7]
type = ChangeState
triggerall = animelemtime(2) >= 1 && animelemtime(4) < 2
triggerall = command = "holddown"
trigger1 = command = "y"
value = 240
ctrl = 1

[State 1000, 7]
type = ChangeState
triggerall = animelemtime(2) >= 1 && animelemtime(4) < 2
triggerall = command != "holddown"
trigger1 = command = "y"
value = 210
ctrl = 1

[State 1000, 7]
type = ChangeState
triggerall = animelemtime(2) >= 1 && animelemtime(4) < 2
triggerall = command = "holddown"
trigger1 = command = "x"
value = 230
ctrl = 1

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

