ctrl = 0
anim = 181
velset = 0,0

[state 181,WIN]
type=explod
triggerall=matchover
trigger1=time=0
anim= 10002;+teamside
id= 10002
pos= 0,100
postype= left
bindtime= -1
ontop= 1
ownpal= 1

[state 181,効果音]
type=playsnd
triggerall= matchover
trigger1= time=20
value= 10,3

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, ステート変更]
type = ChangeState
