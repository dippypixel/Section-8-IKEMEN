;避け
[Statedef 850]
type = S
movetype = I
physics = N
ctrl = 0
anim = 850
velset = 0,0
sprpriority = -1

[State 850, 移動]
type = VelSet
trigger1 = AnimElemTime(1) = 2
x = 4

[State 850]
type = VelSet
trigger1 = AnimElemTime(6) = 3
x = 0

[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = animelem = 1
value = 1, 9
channel=0


[State 118, 2]
type = PlayerPush
trigger1 = AnimElemTime(1)
value = 0

[State 850, 残像]
type = AfterImage
trigger1 = AnimElem = 1
time = 26                     ;残像が出ている時間（フレーム）
PalBright   =  10, 10, 10     ;残像の色の明るさ（赤,緑,青・ＲＧＢ）
PalContrast =  80, 80, 80  ;残像の色合い　　（赤,緑,青・ＲＧＢ）
PalAdd      =  0,0,0          ;残像の色の加算値（赤,緑,青・ＲＧＢ）
PalMul      =  1,1,1          ;残像の色の乗算値（赤,緑,青・ＲＧＢ・float）
Trans = Add1                  ;残像の透過処理（Add,Add1,Sub,None,AddAlpha）
TimeGap  = 4                  ;残像の表示をスキップする間隔（デフォルトは1）
FrameGap = 1                  ;残像の形を変化させる間隔（デフォルトは4）
length = 3                    ;残像の表示する長さ（最大60・デフォルト20）
sprpriority = -2

[State 850, HitBy]
type = HitBy
trigger1 = 1
value = SCA, NT,ST,HT


[State 850, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
