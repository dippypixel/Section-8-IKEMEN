;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2]
type = Helper
trigger1 = roundstate = 3
trigger1 = numhelper(8000) = 0
helpertype = normal
ID = 8000
stateno = 8000
pos = 0,-20
postype = back
ownpal = 1
size.shadowoffset = -12

[State -2]
type = NotHitBy
trigger1 = numhelper(1005) = 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 5
ignorehitpause = 1
persistent = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3]
type = AssertSpecial
trigger1 = roundstate != 2
flag = nobardisplay
ignorehitpause = 1

[State -3]
type = RemoveExplod
trigger1 = stateno != [6000,6999]
trigger1 = numhelper(10000) = 0
id = 700
ignorehitpause = 1
