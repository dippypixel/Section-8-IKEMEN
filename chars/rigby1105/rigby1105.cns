;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State -1]
type = ChangeState
trigger1 = p2name = "Mordecai1105" || p4name = "Mordecai1105"
value = 193
ctrl = 0

[State -1]
type = ChangeState
triggerall = p3name != "Mordecai1105"
trigger1 = time = 0
trigger1 = random > 500
value = 191
ctrl = 0

[State -1]
type = ChangeState
triggerall = p3name != "Mordecai1105"
trigger1 = time = 0
trigger1 = random > 500
value = 192
ctrl = 0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = anim = 190
flag = Intro

[State 190, 3] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 190, 4] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = roundno = 1
flag = nomusic

[State 190, 5]
type = PlaySnd
trigger1 = time = 0
value = S2,3
channel = 1

[State 190, 6]
type = StopSnd
trigger1 = animtime = 0
channel = 1

[State 190, 7] ;Change to stand state
type = ChangeAnim
trigger1 = animtime = 0
value = 0

