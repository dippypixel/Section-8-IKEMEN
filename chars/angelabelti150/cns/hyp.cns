;---------------------------------------------------------------------------
; Get Hit Force Stand Shaking
[Statedef 2003]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((GetHitVar(groundtype) = 1),5002,5012)

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 0, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
value = 2004

;---------------------------------------------------------------------------
; Get Hit Force Stand Knocked Back
[Statedef 2004]
type    = S
movetype= H
physics = S

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = ifelse((GetHitVar(groundtype) = 1),5007,5017)

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 5001, 6]
type = SelfState
trigger1 = HitOver
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Dizzy get-hit
[Statedef 2005]
type    = S
movetype= H
physics = N
velset = 0,0

[State 0, PosSet]
type = PosSet
trigger1 = !Time
y = 0

[State 5000, 1]
type = ChangeAnim
trigger1 = Time < 8
value = ifelse(SelfAnimExist(5300)=1,5300,5007)

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = 1
x = .6

[State 5001, 6]
type = SelfState
trigger1 = Time = 64
value = 0
ctrl = 1

