[State 0, P2DefMul Special]
type = SuperPause
triggerall = Time = 1
triggerall = MoveType = A
trigger1 = StateNo = [1000,1999]
time = 0
anim = -1
sound = -1
darken = 0
p2defmul = 1.33

;[State 0, P2DefMul Super]
;type = SuperPause
;triggerall = Time = 1
;triggerall = MoveType = A
;trigger1 = StateNo = [2000,2999]
;time = 0
;anim = -1
;sound = -1
;darken = 0
;p2defmul = 1.5

;----------------
; Powerup
;----------------
[State 0, ChangeState]
type = ChangeState
triggerall = StateNo = [0,100]
triggerall = StateType != A
triggerall = Power >= 1000+(Var(55)*1000)
trigger1 = ctrl
trigger1 = RoundState = 2
trigger2 = RoundState < 2 && RoundsExisted >= 1
trigger3 = StateNo = 100
value = 3000
ctrl = 0

[State 0, VarSet]
type = VarSet
trigger1 = StateNo = 3000
trigger2 = RoundState < 2 && RoundsExisted < 1
v = 55
value = Ceil(Power/1000)

[State 0, VarSet]
type = VarSet
trigger1 = Power < (Var(55)*1000)
trigger2 = StateNo = 3000
v = 55
value = Ceil(Power/1000)

;----------------
; Trailblazer
;----------------

[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = Time < 1
trigger1 = MoveType = H
time = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
;[Statedef -3]
