;---------------------------------------------------------------------------
; Downed get-hit (hit ground from fall)
[Statedef 5100]
type    = L
movetype= H
physics = N

[State 5100, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5100, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 5100, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 5100, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 5100, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 5100, 7]
type = ChangeState
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
value = 5110 ;Downed get-hit (lying down)

[State 0, Helper]
type = Helper
trigger1 = Time = 0
helpertype = normal
name = "FX Land"
ID = 10047
stateno = 10047
pos = 0,0
postype = p1
ownpal = 1
supermovetime = 666

[State 5100, 9]
type = HitFallDamage
trigger1 = Time = 3

[State 0, Snd]
type = PlaySnd
trigger1 = Time = 1
value = S2,0
;channel = 0

[State 5100, 11]
type = PosFreeze
trigger1 = 1

[State 5100, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 5101 ;Downed get-hit (bounce off ground)

[State 5100, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20


;---------------------------------------------------------------------------
; Downed get-hit (lying down)
[Statedef 5110]
type    = L
movetype= H
physics = N

[State 5110, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5110, 1] ;For hit up/up-diag type (from state 5081)
type = ChangeAnim
persistent = 0
trigger1 = SelfAnimExist(5110 + (anim % 10))
trigger1 = anim = [5081,5089]
value = 5110 + (anim % 10)

[State 5110, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170

[State 5110, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim = [5161,5169]
trigger1 = SelfAnimExist(5170 + (anim % 10))
value = 5170 + (anim % 10)

[State 5110, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 5110, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5110, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 0, Snd]
type = PlaySnd
trigger1 = Time = 1
value = S2,0
;channel = 0

[State 0, Helper]
type = Helper
trigger1 = Time = 0
helpertype = normal
name = "FX Land"
ID = 10047
stateno = 10047
pos = 0,0
postype = p1
ownpal = 1
supermovetime = 666

[State 5110, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5110, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5110 + (anim % 10)

[State 5110, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110

[State 5110, 11] ;If just died
type = ChangeState
triggerall = !alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = Anim = [5110,5119]
value = 5150

[State 5110, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 5110, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5110, 14] ;Friction
type = VelSet
trigger1 = abs(Vel x) < 0.1
persistent = 0
x = 0

[State 5110, 15]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 5110, 16]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

;----------------
; Debug
;----------------
;[State 0, DisplayToClipboard]
;type = DisplayToClipboard
;trigger1 = 1
;text = "%d x %d"  ;vel x = %f
;params = floor(p2dist y), floor(p2bodydist y);,vel x
;ignorehitpause = 1

;----------------
; HitSpark
;----------------
[State 0, Var HitSpark Reset]
type = VarSet
trigger1 = 1
var(8) = ifelse(MoveContact=1,Var(8)+1,0)
ignorehitpause = 1

;----------------
; HitSpark
;----------------
[State -2, Pain Noise Low]
type = PlaySnd
triggerall = stateno = 5000  || stateno = 5010 || stateno = 5020
triggerall = gethitvar(animtype)<=1
triggerall = StateType != A
triggerall = random%2 = 0
triggerall = alive
trigger1 = Time = 1
value = S12, 0
channel = 0
persistent = 0
ignorehitpause = 1

[State -2, Pain Noise High]
type = PlaySnd
triggerall = stateno = 5000  || stateno = 5010 || stateno = 5020
triggerall = gethitvar(animtype)>=2
triggerall = StateType != A
triggerall = random%2 = 0
triggerall = alive
trigger1 = Time = 1
value = S12, 1
channel = 0
persistent = 0
ignorehitpause = 1

[State -2, Pain Noise Air]
type = PlaySnd
triggerall = stateno = 5050
triggerall = StateType = A
triggerall = random%2 = 0
triggerall = alive
trigger1 = Time = 1
value = S12, 2
channel = 0
persistent = 0
ignorehitpause = 1

