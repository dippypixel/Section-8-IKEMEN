;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = Anim = 100
x = const(velocity.run.fwd.x)

;[State 100, 2]
;type = AssertSpecial
;trigger1 = 1
;flag = NoWalk

;[State 100, 3]
;type = AssertSpecial
;trigger1 = 1
;flag = NoAutoTurn

[State 0, Snd Run]
type = PlaySnd
triggerall = Anim = 100
trigger1 = AnimElem = 3
trigger2 = AnimElem = 6
value = S2,3
;channel = 0

[State 0, Snd Stop]
type = PlaySnd
triggerall = Anim = 101
trigger1 = AnimElem = 1, 1
value = S2,4
;channel = 0

[State 100, 4]
type = ChangeState
triggerall = Anim != 101
trigger1 = command = "holdup"
trigger2 = Var(9) != 0 && (Var(9)*Var(9)*Var(9)*2)*0.1 > random
value = 40

[State 100, 4]
type = ChangeAnim
triggerall = Anim != 101
trigger1 = command != "holdfwd" && Var(9) = 0
trigger2 = Var(9) != 0 && (Var(9)*Var(9)*Var(9)*2)*0.5 > random
trigger2 = P2BodyDist X < 60
value = 101

[State 0, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = Anim = 101
value = 0
ctrl = 1

