;波紋の呼吸（特殊行動）
[Statedef 900]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0,0
anim     = 900
sprpriority = 1

[State 900, パワーゲージ増]
type = PowerAdd
trigger1 = 1
value = 1 + ceil(power / 200)

;[State 900, HP回復]
;type = LifeAdd
;trigger1 = 1
;value = 1 - ceil(life / 1000)

[State 900];「コオオオ」
type = playsnd
trigger1 = time = 1
value = 30,8
channel = 1

[State 900, 押し判定]
type = PlayerPush
trigger1 = 1
value = 0 ;相手を押さず、すり抜ける事が出来る。

[State 900, エフェクト];地面のケムリ
type = Explod
trigger1 = NumExplod(900) = 0 ;ＩＤナンバー「130」のExplodが画面中に１枚も出ていない時
trigger1 = life >= 300
anim = f130
facing = -1
postype = p1
pos = -5,0
sprpriority = 3
ownpal = 1
removetime = -1 ;「-1」なのでアニメーションが終わらず常に繰り返す
ID = 900

[State 900, エフェクト];波紋/左足
type = Explod
trigger1 = NumExplod(9001) = 0
anim = 901
facing = 1
postype = p1
pos = 10,0			;ifelse()で修正の要アリ
trans = add
sprpriority = -5
ownpal = 1
scale = ifelse(life >= 800 ,1.3,ifelse (life >= 300, 0.9, 0.2)) ,ifelse(life >= 800 ,1.3,ifelse (life >= 300, 0.9, 0.2))
removetime = -1 ;「-1」なのでアニメーションが終わらず常に繰り返す
ID = 9001

[State 900, エフェクト];波紋/右足
type = Explod
trigger1 = NumExplod(9002) = 0
anim = 901
facing = 1
postype = p1
pos = -10,0			;ifelse()で修正の要アリ
trans = add1
sprpriority = -5
ownpal = 1
scale = ifelse(life >= 800 ,1.3,ifelse (life >= 300, 0.9, 0.2)) ,ifelse(life >= 800 ,1.3,ifelse (life >= 300, 0.9, 0.2))
removetime = -1 ;「-1」なのでアニメーションが終わらず常に繰り返す
ID = 9002

[State 900, エフェクト];足の波紋
type = Explod
trigger1 = Time = [1,16] ;１～16フレームの間、毎フレーム有効にする。
trigger1 = NumExplod(902) = 0
anim = 902
Trans = add
facing = 1
postype = p1
pos = 0, 0
sprpriority = 3
ownpal = 1
scale = 1, 1
bindtime = -1       ;「このエフェクトを発生させた親」に『くっ付ける時間』（フレーム）
                   ;postypeに依存。-1なら常にくっ付ける事になる。
removetime = -1 ;「-1」なのでアニメーションが終わらず常に繰り返す
removeongethit = 1
ID = 902

[State 900, ステート変更]
type = ChangeState
trigger1 = command != "hamon" ;「hamon」のコマンドではない時（aボタンが離されたら）
