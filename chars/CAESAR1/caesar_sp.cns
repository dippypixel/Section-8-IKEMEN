;オーバードライブ弱
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 7
poweradd= 150
ctrl = 0
velset = 0,0
anim = 1000
sprpriority = -1

[State 1000]
type = varrandom
trigger1 = time = 0
v = 11
range = 10,11

[State 1000, 声]
type = PlaySnd
trigger1 = Time = 0
value = 30, var(11)

[State 1000, ビリビリ]
type = PlaySnd
trigger1 = AnimElem = 3
value = 10, 14

[State 1000, 飛び道具]
type = HitDef
trigger1 = AnimElem = 5
attr = S, SA
damage = 45,30
animtype  = Medium
pausetime = 7,7
guardflag = MA
priority = 3
sparkno = s6030
sparkxy = -50,-80
guard.sparkno = s6040
hitsound = s10,3
guardsound = 6,0
ground.type = High
ground.slidetime = 14
ground.hittime = 16
ground.velocity = -4,0
air.velocity = -3,-4
envshake.time = 8
envshake.ampl = 6
envshake.freq = 100

[State 1000, エフェクト]
type = Explod
trigger1 = AnimElem = 3
trigger1 = NumExplod(1000) <= 0
anim = 1001
facing = 1
postype = p1
pos = 30,-80
sprpriority = 4
ownpal = 1
scale = 0.5,0.5
bindtime = 36       ;「このエフェクトを発生させた親」に『くっ付ける時間』（フレーム）
                   ;postypeに依存。-1なら常にくっ付ける事になる。
removetime = 36
removeongethit = 1
ID = 1000

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

