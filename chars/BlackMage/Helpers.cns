type = RemoveExplod
trigger1 = fvar(0) <= 0.0
id = 3007
[State Die]
type = RemoveExplod
trigger1 = fvar(0) <= 0.0
id = 3008

[State Remove from play if fully faded out]
type = DestroySelf
trigger1 = fvar(0) <= 0.0

[State Start removing it from play]
type = VarAdd
;out of the state
trigger1 = root,stateno != 3005
;end of anim
trigger2 = root,stateno = 3005
trigger2 = root,anim = 3005
trigger2 = root,animelemtime(30) >= 0
;hurt
trigger3 = root,movetype = H
;already fading out
trigger4 = fvar(0) < 1.0
fvar(0) = -1.0/15

