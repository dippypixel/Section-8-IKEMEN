trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Fwd AirDash
[Statedef 110]
type    = A
physics = N
velset = 0,0
ctrl = 0
anim = 110

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = animelemtime(2) = 0
value = 100,0
channel = 2
ignorehitpause = 1
volumescale = 2147483647
loop = 1
[State 0, Explod]
type = Explod
trigger1 = Time = 0
trigger2 = AnimElem = 3
trigger3 = AnimTime = 0
anim = 6020 
pos = -65,-50
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
pausemovetime = 0
ontop = 1
ownpal = 1

[State 100, 5]
type = AssertSpecial
trigger1 = 1
flag = NoWalk


[State 0, VarSet]
type = VarSet
trigger1 = !time
var(15) = 0
[State 0, VarSet]
type = VarSet
trigger1 = !time
var(16) = 0
[State 0, VarSet]
type = VarSet
trigger1 = command = "holdup"
var(15) = 1
[State 0, VarSet]
type = VarAdd
trigger1 = var(15)
var(16) = 1

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
var(22) = var(22) | floor(exp(1*ln(2)) + 0.5)

[State 0, StateTypeSet]
type = Velset
trigger1 = animelem = 2
x = const(velocity.run.fwd.x)
y = 0

[State 0, VelAdd]
type = VelAdd
trigger1 = var(15) && command = "holdup" && vel y > -5
y = -0.5
[State 0, VelAdd]
type = VelAdd
trigger1 = var(15) && command != "holdup" && vel y < 0
y = 1

[State 0, CtrlSet]
type = CtrlSet
trigger1 = time >= 5
value = 1

[State 100, 3]
type = ChangeState
trigger1 = time >= 85 || command != "holdfwd"
trigger2 = var(16) >= 35 ; the higher the number, the longer she can fly after holding up
value = 111
ctrl = 1

