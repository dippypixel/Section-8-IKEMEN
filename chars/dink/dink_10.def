; Definition file for a character
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Dink Smallwood"        ;Name of character
displayname = "Dink Smallwood" ;Name of character to display
versiondate = 07,24,2017    ;Version date of character (MM-DD-YYYY)
mugenversion = 1.0
author = "The_None"         ;Character author name
pal.defaults = 4,1,5,6,2,3


; Files for the player
[Files]
cmd     = dink.cmd   ;Command set
cns     = dink.cns   ;Constants
st	= 10ov.st
st2      = dink.cns   ;States
st3     = config.txt
st4     = kame.st
stcommon = common1.cns ;Common states
sprite  = dink.sff   ;Sprite
anim    = dink.air   ;Animation
sound   = dink.snd   ;Sound
pal1    = pal4.act ; Balthazar's impression of Dink's colors of the official boxart
pal2    = pal5.act ; An attempt at a mage NPC
pal3    = pal6.act ; Orc trooper
pal4    = pal1.act ; Dink's default Palette
pal5    = pal2.act ; Midler Flatstomp
pal6    = pal3.act ; one of the Peasant NPCs
pal7    = pal7.act ; Dink's possible role model who recently got a new game on a new console
pal8    = pal8.act ; The White Wolf
pal9    = pal9.act ; if I wouldn't have cribbed from Balthazar maybe I would've cribbed from Disney
pal10    = pal10.act ; the Polish Street Fighter
pal11    = pal11.act ; why not
pal12    = pal12.act


; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
