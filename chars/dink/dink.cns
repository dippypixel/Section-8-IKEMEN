pos = floor(4*const(size.xscale)), floor(-228*const(size.yscale))

[State 810, Bind 6]
type = TargetBind
trigger1 = animelem = 5
pos = floor(55*const(size.xscale)), floor(-145*const(size.yscale))


[State 810, TargetState]
type = TargetState
trigger1 = animelem = 5
value = 821

[State 810, Grab Sound]
