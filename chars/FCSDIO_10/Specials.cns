; Stinging Eyes
[Statedef 1025]
type    = S
movetype= A
physics = N            
velset = 0,0
ctrl = 0
anim = 1015
sprpriority = 1

[State 1015, PosSet]
type = PosSet
trigger1 = time = 0
y = 0

[State 1015, Snd]
type = playsnd
trigger1 = Animelem = 2
value = s1000,1

[State 1015, Snd]
type = playsnd
trigger1 = Animelem = 3
value = s1000,2
loop = 1
channel = -1

[State 1015, VarSet]
type = VarSet
trigger1 = time = 0
v = 10
value = 0

[State 1015, VarAdd]
type = VarAdd
trigger1 = time = 100
v = 10
value = 1

[State 1015, ChangeState]
type = ChangeState
triggerall = time = 55
trigger1 = (command != "holdx" && command != "holdy" && command != "holdz") && var(10)=0 && !Var(15)
trigger2 = var(15) && (enemynear,movetype = A || p2dist x < 64)
value = 1026
ctrl = 0

[State 1015, ChangeState]
type = ChangeState
trigger1 = (command != "holdx" && command != "holdy" && command != "holdz") && var(10)=1 && !Var(15)
trigger2 = Time = 125 ; However long the max threshold is
trigger3 = var(15) && (enemynear,movetype = A || p2dist x < 64)
value = 1027
ctrl = 0

