;---------------------------------------------------------------------------
;Knives of THE WORLD P2 State 3
[Statedef 3009]
type = A
movetype = H
physics = N
velset = 0,0

[State 3009, 1]
type = Turn
trigger1 = Time = 0
trigger1 = Pos x*facing>=0

[State 3009, ChangeAnim]
type = ChangeAnim
trigger1 = time < 32
value = anim

[State 3009, ChangeAnim] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = time = 32
trigger1 = SelfAnimExist(5051)
value = 5051

[State 3009, ChangeAnim] ;Change anim when done with transition
type = ChangeAnim
trigger1 = time = 32
trigger1 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5050
persistent = 0

[State 3009, 2] ;Coming down anim
type = ChangeAnim
trigger1 = time >= 32
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 3009, EnvShake]
type = EnvShake
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
time = 10

[State 3009, Vel]
type = VelSet
trigger1 = time = 32
x = -2.5
y = -4.5

[State 3009, Vel]
type = VelAdd
trigger1 = time > 32
y = .47

[State 3009, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 3009, SelfState]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100

