trigger1 = Time = 0
value = 5010

[State 3007, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 3007, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 3007, SelfState]
type = SelfState
trigger1 = time = 24
value = ifelse(statetype = A,5030,0)
ctrl = ifelse(statetype = A,0,1)

