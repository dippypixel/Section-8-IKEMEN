triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 210 || stateno = 240 || stateno = 400 || stateno = 410) && MoveContact
trigger1 = command = "Stone Mask Strike" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.6 > random && RoundState = 2 ; AI continues attack
trigger2 = (enemynear,hitdefattr=SCA,AA) && inguarddist && (p2bodydist X = [48,120])

