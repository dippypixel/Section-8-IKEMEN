;---------------------------------------------------------------------------
[Statedef -1]
;===========================================================================

[State -1, AI Guard]
Type = ChangeState
Value = 120
triggerall = StateType != A && Var(15) != 0 && Ctrl
trigger1 = (Var(15)*Var(15)*Var(15)*2)*0.1
trigger1 = !(enemynear,hitdefattr=SCA,AT) && inguarddist
trigger1 = (stateno!=[120,155])


;---------------------------------------------------------------------------
;Dash Foward
[State -1, Dash Foward]
type = ChangeState
value = 100
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "FF" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.3 > random && RoundState = 2 ; AI runs in
trigger2 = P2BodyDist X > 32 && (P2StateNo != [5110,5120])
trigger3 = Var(15) && (Var(15)**3)*2*0.6 > random && RoundState = 2 ; AI runs in
trigger3 = P2BodyDist X > 96 && P2MoveType != A

;---------------------------------------------------------------------------
;Dash Back
[State -1, Dash Back]
type = ChangeState
value = 105
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "BB" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.5 > random && RoundState = 2 ; AI dashes back if they're down
trigger2 = P2Dist X < 56 && (P2StateNo = [5110,5120])

;---------------------------------------------------------------------------
;Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "start" && !Var(15)

;===========================================================================
