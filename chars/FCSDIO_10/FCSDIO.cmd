;Dio's Charisma
[State -1, Dio's Charisma]
type = ChangeState
value = 3010
triggerall = power >= 2000
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 210 || stateno = 240 || stateno = 400 || stateno = 410) && MoveContact
trigger1 = command = "Dio's Charisma" && !Var(15)

;---------------------------------------------------------------------------
