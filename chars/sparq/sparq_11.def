; Definition file for a character
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Sparq"        ;Name of character
displayname = "Sparq" ;Name of character to display
versiondate = 01,22,2018    ;Version date of character (MM-DD-YYYY)
mugenversion = 1.1
author = "The_None"         ;Character author name
pal.defaults = 4,5,1,2,3,6


; Files for the player
[Files]
cmd     = sparq.cmd   ;Command set
cns     = sparq.cns   ;Constants
st	= 11ov.st
st2      = sparq.cns   ;States
st3     = config.txt
st4     = kame.st
stcommon = common1.cns ;Common states
sprite  = sparq.sff   ;Sprite
anim    = sparq.air   ;Animation
sound   = sparq.snd   ;Sound
pal1    = sparq4.act
pal2    = sparq5.act
pal3    = sparq6.act
pal4    = sparq.act
pal5    = sparq2.act
pal6    = sparq3.act



; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
