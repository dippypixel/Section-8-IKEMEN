;--------------------------------------------------------------------------------
;立弱
;--------------------------------------------------------------------------------
[Statedef 200]
Type    = S
Movetype= A
Physics = S
Anim = 200
Ctrl = 0
Poweradd = 5

[State 200]
type = Null
trigger1 = time = 0
trigger1 = var(20) := 0 || 1
trigger1 = var(21) := 0 || 1
trigger1 = var(22) := Stateno || 1
trigger1 = var(23) := 4000 || 1
trigger1 = var(24) := 1 || 1
trigger1 = var(25) := 16 || 1
trigger1 = var(26) := -28 || 1
trigger1 = var(27) := 100 || 1

[State 200]
type = varset
trigger1 = MoveHit
fvar(1) = 0.93 * fvar(1)
ignorehitpause = 1
persistent = 0

[State 200]
type = varset
trigger1 = MoveHit
trigger1 = fvar(1) > 1
fvar(1) = 0.93 * fvar(1)
ignorehitpause = 1
persistent = 0

[State 200]
type = Playsnd
trigger1 = AnimElem = 4
value = S0, 0
channel = 1
ignorehitpause = 1
persistent = 0

[State 200]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 200]
type		= HitDef
triggerall 	= var(12) = 1
trigger1	= AnimElem = 3
attr		= S, NA
hitflag		= MAF
guardflag	= M
damage		= ceil(fvar(0)*19)
animtype	= Light
air.animtype	= Back
ground.type	= High
priority	= 4, Hit
pausetime	= 10, 9
fall		= 0		;1だと自動立ち直りなし
fall.recover	= 1		;0だと受身不可能
fall.recovertime= ceil(fvar(1)*33*0.75) + 9
air.fall	= 1		;1だと自動立ち直りなし
getpower	= 20, 10
givepower	= 10, 10
yaccel		= 0.32
ground.slidetime	= 10
ground.hittime		= 10
guard.hittime 		= 9
air.hittime 		= 10
guard.ctrltime 		= 9
airguard.ctrltime 	= 19
ground.velocity		= -2.5*(2-fvar(1)), 0
guard.velocity		= -3.5
air.velocity		= -1.5,-5*(IfElse(EnemyNear,vel Y > 0, 0.65, IfElse(EnemyNear,vel Y < 0, 1.3, 1)))
airguard.velocity	= -3,-6
ground.cornerpush.veloff= -2.5*1.9*(2-fvar(1))
air.cornerpush.veloff	= 0
down.cornerpush.veloff	= -2.5*1.9
guard.cornerpush.veloff = -3.5*1.8
airguard.cornerpush.veloff = 0

