ignorehitpause = 1
persistent = 0

[State 110]
type		= HitDef
triggerall 	= var(12) = 1
trigger1	= AnimElem = 3
trigger1	= var(40) >= 8
attr		= A, NA
hitflag		= MAF
guardflag	= MA
damage		= ceil(fvar(0)*60)
animtype	= Hard
air.animtype	= Back
ground.type	= High
priority	= 4, Hit
pausetime	= 10, 9
