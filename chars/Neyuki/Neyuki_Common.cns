[State 0]
type = ChangeAnim
trigger1 = Anim != 0
value = 0

[State 0]
type = velset
trigger1 = time = 0
Y = 0

[State 0]
type = ChangeState
trigger1 = !Alive
value = 5050

[State 0]
type = DestroySelf
trigger1 = IsHelper

