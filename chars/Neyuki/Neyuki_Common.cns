fall.recover	= 1		;0だと受身不可能
fall.recovertime= ceil(fvar(1)*40*0.75) + 9
air.fall	= 1		;1だと自動立ち直りなし
getpower	= 50, 25
givepower	= 25, 15
yaccel		= 0.4
ground.slidetime	= 23
ground.hittime		= 23
guard.hittime 		= 21
air.hittime 		= 23
guard.ctrltime 		= 21
airguard.ctrltime 	= 19
ground.velocity		= -4*(2-fvar(1)), 0
guard.velocity		= -4
air.velocity		= -5, IfElse(EnemyNear,vel Y <= 0,(-3.5+EnemyNear,Vel Y*0.25),-3.5)
airguard.velocity	= -1.5,-3
ground.cornerpush.veloff= -6
air.cornerpush.veloff	= 0
down.cornerpush.veloff	= -6
guard.cornerpush.veloff = -6
airguard.cornerpush.veloff = 0

