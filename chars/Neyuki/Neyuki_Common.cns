trigger1 = var(21) := 0 || 1
trigger1 = var(22) := Stateno || 1
trigger1 = var(23) := 4030 || 1
trigger1 = var(24) := 1 || 1
trigger1 = var(25) := 11 || 1
trigger1 = var(26) := -26 || 1
trigger1 = var(27) := 102 || 1

