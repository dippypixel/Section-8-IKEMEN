;--------------------------------------------------------------------------------
;ダッシュ
;--------------------------------------------------------------------------------
[Statedef 100]
Type	= S
Physics = S
Anim = 100
Velset = 0, 0
Ctrl = 0

[State 100]
type = StateTypeSet
trigger1 = AnimElemTime(6) = 0
StateType = A
Physics = N
persistent = 0

[State 100]
type = velset
trigger1 = AnimElemTime(6) = 0
X = const(velocity.run.fwd.x)
Y = const(velocity.run.fwd.y)

[State 100]
type = veladd
trigger1 = AnimElemTime(6) >= 1
Y = 0.18

[State 100]
type = AssertSpecial
trigger1 = 1
flag = nowalk
flag2 = noautoturn

[State 100]
type = AfterImage
trigger1 = time = 0
time = 40
PalBright = 0, 0, 0
PalContrast = 128, 128, 128
PalAdd = 0, 0, 0
PalMul = 1, 1, 1
TimeGap = 2
FrameGap = 1
Trans = Add1
length = 4
persistent = 0

[State 100]
type = ChangeState
trigger1 = StateType = A
trigger1 = command != "holddown" && command != "holdup"
trigger1 = var(5) < 1 + (var(40) >= 3) + (var(40) >= 8)
trigger1 = command = "BB"
value = 115

[State 100]
type = ChangeState
trigger1 = vel Y > 0 && pos Y >= 0
value = 52

