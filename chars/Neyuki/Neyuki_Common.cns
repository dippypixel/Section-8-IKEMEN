;--------------------------------------------------------------------------------
;歩き動作
;--------------------------------------------------------------------------------
[Statedef 20]
Type	= S
Physics = S

[State 20]
type = Turn
trigger1 = p2Dist X < 0

[State 20]
type = velset
trigger1 = command = "holdfwd"
X = Const(velocity.walk.fwd.x) + 0.05*var(40)

[State 20]
type = velset
trigger1 = command = "holdback"
X = Const(velocity.walk.back.x) - 0.05*var(40)

[State 20]
type = ChangeAnim
trigger1 = vel X >= 0 && Anim != 20
value = 20

[State 20]
type = ChangeAnim
trigger1 = vel X < 0 && Anim != 21
value = 21

;--------------------------------------------------------------------------------
;ジャンプ移行
;--------------------------------------------------------------------------------
[Statedef 40]
Type	= S
Physics = N
Anim = 40
Ctrl = 0

[State 40]
type = varset
trigger1 = time = 0
sysvar(1) = 0

[State 40]
type = varset
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40]
type = varset
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40]
type = NotHitBy
trigger1 = 1
value = , AT
ignorehitpause = 1

[State 40]
type = velset
trigger1 = AnimTime = 0
X = IfElse(sysvar(1)=0, const(velocity.jump.neu.x), IfElse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
Y = const(velocity.jump.y)

[State 40]
type = AfterImage
trigger1 = time = 0
time = 0

[State 40]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

