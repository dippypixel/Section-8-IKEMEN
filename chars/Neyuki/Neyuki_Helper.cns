;--------------------------------------------------------------------------------
;ワイヤーダメージ
;--------------------------------------------------------------------------------
[Statedef 4500]
Type	= A
Movetype= H
Physics = N

[State 4500]
type = ChangeAnim2
trigger1 = 1
value = 4500

[State 4500]
type = varset
trigger1 = time = 0
sysvar(1) = GetHitVar(fall.recovertime)

[State 4500]
type = varadd
trigger1 = time > 0
trigger1 = sysvar(1) > 0
sysvar(1) = -1

[State 4500]
type = PlayerPush
trigger1 = 1
value = 0

[State 4500]
type = velset
trigger1 = 1
X = 0
Y = 0

[State 4500]
type = ChangeState
trigger1 = HitShakeOver = 1
value = 4501

;--------------------------------------------------------------------------------
[Statedef 4501]
Type	= A
Movetype= H
Physics = N

[State 4501]
type = veladd
trigger1 = 1
y = GetHitVar(yaccel)

[State 4501]
type = varadd
trigger1 = sysvar(1) > 0
sysvar(1) = -1

[State 4501]
type = SelfState
trigger1 = CanRecover
trigger1 = sysvar(1) = 0
trigger1 = command = "recovery"
value = 5210

[State 4501]
type = NotHitBy
trigger1 = CanRecover
trigger1 = sysvar(1) = 0
value = SCA

[State 4501]
type = PlayerPush
trigger1 = 1
value = 0

[State 4501]
type = HitVelSet
trigger1 = time = 0
X = 1
Y = 1

[State 4501]
type = ChangeState
trigger1 = FrontEdgeBodyDist < 5 || BackEdgeBodyDist < 5
value = 4502

[State 4501]
type = SelfState
trigger1 = time > 0
trigger1 = vel Y > 0 && pos Y >= 0
value = 5100

