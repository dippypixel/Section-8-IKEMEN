;火達磨ダメージ
;--------------------------------------------------------------------------------
[Statedef 4600]
Type	= A
Movetype= H
Physics = N
velset = 0, 0

[State 4600]
type = ChangeAnim2
trigger1 = time = 0
value = 4600

[State 4600]
type = varset
trigger1 = time = 0
sysvar(1) = GetHitVar(fall.recovertime)

[State 4600]
type = ChangeState
trigger1 = time = 1
value = 4610

;--------------------------------------------------------------------------------
[Statedef 4610]
Type	= A
Movetype= H
Physics = N
Velset = GetHitVar(xvel)*Facing, GetHitVar(yvel)

[State 4610]
type = varadd
trigger1 = sysvar(1) > 0
sysvar(1) = -1

[State 4610]
type = SelfState
trigger1 = CanRecover
trigger1 = sysvar(1) = 0
trigger1 = command = "recovery"
value = 5210

[State 4503]
type = NotHitBy
trigger1 = CanRecover
trigger1 = sysvar(1) = 0
value = SCA
ignorehitpause = 1

[State 4610]
type = veladd
trigger1 = time = [1, 22]
X = -(GetHitVar(xvel)*Facing)/23
Y = -GetHitVar(yvel)/23

[State 4610]
type = velset
trigger1 = time = 23
X = 0
Y = 0

[State 4610]
type = veladd
trigger1 = time > 23
Y = 0.27

[State 4610]
type = PalFX
trigger1 = time = 0
time = 40
add = 80,-44,-124
sinadd = 30, 30, 0, 10
color = 0
invertall = 1
persistent = 0

[State 4610]
type = ChangeAnim
triggerall = Anim != 5055 && Anim != 5700 && Anim != 3595 && Anim != 9015
triggerall = time = 7
trigger1 = SelfAnimExist(7697)
value = 7697
persistent = 0

[State 4610]
type = ChangeAnim
triggerall = SelfAnimExist(5055)
triggerall = time = 6
trigger1 = Name = "Ayu Tukimiya" && AuthorName = "shikkoku"
value = 5055
persistent = 0

[State 4610]
type = ChangeAnim
triggerall = SelfAnimExist(5700)
triggerall = time = 6
trigger1 = Name = "Nayuki Minase" && AuthorName = "EL"
value = 5700
persistent = 0

[State 4610]
type = ChangeAnim
triggerall = SelfAnimExist(3595)
trigger1 = time = 6
trigger1 = Name = "Makoto Sawatari" && AuthorName = "EL"
value = 3595
persistent = 0

[State 4610]
type = ChangeAnim
triggerall = SelfAnimExist(9015)
triggerall = time = 6
trigger1 = Name = "Mayu Shiina" && AuthorName = "BF"
trigger2 = Name = "Makoto Sawatari" && AuthorName = "BF"
value = 9015
persistent = 0

[State 4610]
type = PalFX
trigger1 = Anim != 4600
time = 1
mul = 255, 255, 255
persistent = 0

[State 4610]
type = SelfState
trigger1 = vel Y > 0 && pos Y >= 0
value = 5100

;--------------------------------------------------------------------------------
;火達磨ダメージエフェクトヘルパー
;--------------------------------------------------------------------------------
[Statedef 4650]
Type	= A
Movetype= I
Physics = N
Anim = 4650
Ctrl = 0
Sprpriority = 5

[State 4650]
type = posset
triggerall = PlayerIDExist(root,var(16))
trigger1 = IsHelper(4650) || IsHelper(4652)
X = PlayerID(root,var(16)),pos X
Y = PlayerID(root,var(16)),pos Y
ignorehitapause = 1

[State 4650]
type = posset
triggerall = PlayerIDExist(root,var(17))
trigger1 = IsHelper(4651) || IsHelper(4653)
X = PlayerID(root,var(17)),pos X
Y = PlayerID(root,var(17)),pos Y
ignorehitapause = 1

[State 4650]
type = DestroySelf
trigger1 = AnimTime = 0
