;--------------------------------------------------------------------------------
;変数の使用状況
;--------------------------------------------------------------------------------
; var(0)  - 汎用変数1
; var(1)  - 汎用変数2
; var(2)  - 汎用変数3
; var(3)  - Simul相手補足
; var(4)  - 空中ジャンプ回数保存
; var(5)  - 空中ダッシュ回数保存
; var(6)  - 空中ジャンプ管理
; var(7)  - リコイル/硬直キャンセルフラグ１
; var(8)  - リコイル/硬直キャンセルフラグ２
; var(9)  - リコイル/入力保持
; var(10) - リコイル/硬直時間
; var(11) - リコイル/リコイルカウンター
; var(12) - ヒットフラグ
; var(13) - FICフラグ
; var(14) - 入力管理変数
; var(15) - 特殊やられ/p1p3判断
; var(16) - 特殊やられ/Enemy(0),ID
; var(17) - 特殊やられ/Enemy(1),ID
; var(18) - 設定変数/タッグ戦管理等
; var(19) - 勝利演出/相手参照
; var(20) - Move代入変数
; var(21) - MoveHitResetカウント
; var(22) - エフェクト/現在ステート
; var(23) - エフェクト/アニメ
; var(24) - エフェクト/基準位置
; var(25) - エフェクト/X座標
; var(26) - エフェクト/Y座標
; var(27) - ヒット音/S00,00
; var(28) - RFゲージ/X座標調整
; var(29) - RFゲージ/Y座標調整
; var(30) - ダメージ表示
; var(31) - ダメージ表示補助
; var(32) - 補正表示補助
; var(33) - 表示消滅補助
;
; var(40) - ジャム数
; var(41) - ジャム最低数
; var(42) - ジャム表示用変数
; var(43) - ジャム負けたときに減る
; var(44) - イチゴジャム/X座標調整
; var(45) - イチゴジャム/Y座標調整
;
; fvar(0) - 総合ダメージ係数
; fvar(1) - 技補正総合（受身係数）
; fvar(2) - RFゲージダメージ補正
; fvar(3) - RFゲージ量
; fvar(4) - RFゲージの色
; fvar(5) - 根性値処理
; fvar(6) - X速度保存
; fvar(7) - Y速度保存
;
;--------------------------------------------------------------------------------
;基本設定
;--------------------------------------------------------------------------------
[Data]
life		  = 1000
power		  = 3000
attack		  = 100
defence		  = 100
fall.defence_up   = 50
liedown.time 	  = 60
airjuggle 	  = 15
sparkno 	  = -1
guard.sparkno 	  = -1
KO.echo 	  = 0
volume 		  = 0
IntPersistIndex   = 0
FloatPersistIndex = 0

[Size]
xscale		 = 1
yscale		 = 1
ground.back	 = 11		;キャラクターの幅（後方、地上）
ground.front	 = 11		;キャラクターの幅（前方、地上）
air.back 	 = 11		;キャラクターの幅（後方、空中）
air.front 	 = 11		;キャラクターの幅（前方、空中）
height 		 = 60		;キャラクターの高さ
attack.dist 	 = 160		;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90		;相手がガード体勢に入る発射物との最低距離（最大320）
proj.doscale 	 = 0		;xscale, yscaleの設定が発射物にも適用するかどうか（1で有効）
head.pos 	 = -2,-69
mid.pos 	 = 0,-25
shadowoffset 	 = -1

[Velocity]
walk.fwd	=  1.4		;前に歩く時の速度
walk.back	= -1.4		;後ろに歩く時の速度
run.fwd		=  4.3,-3.3	;前に走る時の速度 (x, y) ホップさせる時はyを0以下にします
run.back	= -3.2,-4.2	;後ろに走る時の速度 (x, y) 走らせる時はyを0にします
jump.neu	=  0,  -6	;ジャンプ時の垂直移動速度 (x, y)
jump.fwd	=  1.7		;前にジャンプした時の水平移動速度
jump.back	= -1.7		;後ろにジャンプした時の水平移動速度
runjump.fwd	=  1.7,-6	;前ダッシュジャンプ
runjump.back	= -1.7,-6	;後ダッシュジャンプ
airjump.neu	=  0,  -6	;空中ジャンプ上
airjump.fwd	=  1.7		;空中で前にジャンプした時の水平移動速度
airjump.back	= -1.7		;空中で後ろにジャンプした時の水平移動速度

[Movement]
airjump.num	= 0	;空中ジャンプの回数 （オプション）
airjump.height	= 0	;空中ジャンプに必要な最低限の高さ （オプション）
yaccel		= 0.22	;垂直方向にかかる加速度（重力）
stand.friction	= 0.84	;立ち状態での摩擦係数
crouch.friction	= 0.84	;しゃがみ状態での摩擦係数
;--------------------------------------------------------------------------------


