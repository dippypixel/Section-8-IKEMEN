;--------------------------------------------------------------------------------
;くろいあくまだおー(Lv1)
;--------------------------------------------------------------------------------
[Statedef 2000]
Type    = S
Movetype= A
Physics = S
Anim = 2000 + var(40)
Velset = 0, 0
Ctrl = 0

[State 2000]
type = SuperPause
trigger1 = AnimElemTime(3) = 0
time = 40
movetime = 40
anim = -1
sound = S2, 0
darken = 0
p2defmul = 1
persistent = 0

[State 2000]
type = poweradd
trigger1 = AnimElemTime(3) = 0
value = -1000
ignorehitpause = 1
persistent = 0

[State 2000]
type = AssertSpecial
trigger1 = AnimElemTime(3) >= 0
trigger1 = AnimElemTime(4) < 2
flag = NoBG
ignorehitpause = 1

[State 2000]
type = Explod
trigger1 = AnimElemTime(3) = 0
anim = 4700
postype = p1
pos = 0,-40
facing = 1
bindtime = 1
removetime = -2
ownpal = 1
supermovetime = 9999
pausemovetime = 9999
sprpriority = 2
persistent = 0

[State 2000]
type = Null
trigger1 = time = 0
trigger1 = var(20) := 0 || 1
trigger1 = var(21) := 0 || 1
trigger1 = var(22) := Stateno || 1
trigger1 = var(23) := 0 || 1
trigger1 = var(24) := 0 || 1
trigger1 = var(25) := 0 || 1
trigger1 = var(26) := 0 || 1
trigger1 = var(27) := 0 || 1

[State 2000]
type = Playsnd
trigger1 = AnimElemTime(5) = 1
value = S3, 0

[State 2000]
type = Helper
trigger1 = AnimElemTime(5) = 1
name = "Frog"
ID = 2050
postype = p1
pos = 14,-42
stateno = 2050
ownpal = 1
facing = 1
size.Xscale = 1
size.Yscale = 1
ignorehitpause = 1
persistent = 0

[State 2000]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

