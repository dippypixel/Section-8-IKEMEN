[Statedef 2060]
Type    = S
Movetype= A
Physics = N
Anim = 2060
Velset = 0, 0
Ctrl = 0
Sprpriority = 3

[State 2060]
type = parentvarset
triggerall = root,var(18) & 2
trigger1 = MoveHit
fvar(8) = root,fvar(1)
ignorehitpause = 1

[State 2060]
type = parentvarset
trigger1 = MoveHit
fvar(1) = 0.90 * root,fvar(1)
ignorehitpause = 1
persistent = 0

[State 2060]
type = parentvarset
trigger1 = MoveHit
trigger1 = root,fvar(1) > 1
fvar(1) = 0.90 * root,fvar(1)
ignorehitpause = 1
persistent = 0

[State 2060]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 2060]
type = Playsnd
trigger1 = time = 0
value = S3, 1

[State 2060]
type = EnvShake
trigger1 = time = 0
time = 16
ampl = -4
freq = 60

[State 2060]
type = varrandom
trigger1 = 1
v = 0
range = -30, 30

[State 2060]
type = varrandom
trigger1 = 1
v = 1
range = -90,-40

[State 2060]
type = Explod
trigger1 = time = [5, 11]
trigger1 = Random%2 = 0
anim = 2065
ID = 2065
pos = var(0), var(1)
postype = p1
bindtime = 1
removetime = -2
removeongethit = 1
sprpriority = 2
ontop = 1
ignorehitpause = 1

[State 2060]
type = Explod
triggerall = MoveGuarded
triggerall = p2MoveType = H
trigger1 = NumTarget
trigger1 = Target,time = 0
anim = 4950
ID = 4000
pos = 0,-40
random = 10, 10
postype = p2
bindtime = 1
removetime = -2
ownpal = 1
ontop = 1
sprpriority = 5
facing = 1
pausemovetime = 0
supermovetime = 0
scale = 1, 1
ignorehitpause = 1

[State 2060]
type = TargetState
trigger1 = MoveHit && NumTarget > 0
trigger1 = (Target,IsHelper = 0) && (Target,Stateno != [120, 155])
value = 4600
ignorehitpause = 1
persistent = 0

[State 2060]
type = parentvarset
trigger1 = MoveContact || MoveReversed
trigger1 = p2MoveType != H
var(20) = 4

[State 2060]
type = parentvarset
trigger1 = MoveContact || MoveReversed
trigger1 = p2MoveType != H
var(11) = 1

[State 2060]
type = MoveHitReset
trigger1 = MoveContact = 2 || MoveReversed = 2
ignorehitpause = 1

[State 2060]
type = DestroySelf
trigger1 = AnimTime = 0

[State 2060]
type		= HitDef
triggerall 	= root,var(12) = 1
trigger1	= AnimElem = 4
attr		= S, HP
hitflag		= MAF
guardflag	= MA
damage		= ceil(root,fvar(0)*170), 20
animtype	= Hard
air.animtype	= Hard
ground.type	= High
priority	= 4, Hit
pausetime	= 0, 0
fall		= 1		;1だと自動立ち直りなし
fall.recover	= 0		;0だと受身不可能
fall.recovertime= 999999
air.fall	= 1		;1だと自動立ち直りなし
getpower	= 0, 0
givepower	= 25, 25
yaccel		= 0.32
ground.slidetime	= 23
ground.hittime		= 23
guard.hittime 		= 21
air.hittime 		= 23
guard.ctrltime 		= 21
airguard.ctrltime 	= 19
ground.velocity		= IfElse(Facing = root,Facing,-13, 13),-7
guard.velocity		= -5
air.velocity		= IfElse(Facing = root,Facing,-13, 13),-7
airguard.velocity	= -3,-6
ground.cornerpush.veloff= 0
air.cornerpush.veloff	= 0
down.cornerpush.veloff	= 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
hitsound	= S1, 5
guardsound	= S5, 0
guard.kill	= 0
sprpriority	= 3

