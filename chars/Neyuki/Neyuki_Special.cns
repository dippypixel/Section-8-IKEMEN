[Statedef 2050]
Type    = A
Movetype= I
Physics = N
Anim = 1
Velset = 1,-2.4
Ctrl = 0
Sprpriority = -1

[State 2050]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 2050]
type = ChangeAnim
trigger1= time = 0
trigger1 = IsHelper(2050) || IsHelper(2051) || IsHelper(2054)
value = 2050

[State 2050]
type = veladd
trigger1 = 1
Y = 0.4

[State 2050]
type = ChangeState
trigger1 = vel Y > 0 && pos Y >= 0
value = 2051

