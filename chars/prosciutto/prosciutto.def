
[Info]
Name         = "prosciutto_aniki"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "prosciutto"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 08,15,2013     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "amarimono"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 6,3,4,2        ;ＣＰＵで出てきた時のカラーパレットの順番

[Files]
Cmd     = aniki.cmd       ;コマンドファイルの登録
Cns     = aniki.cns       ;コンスタンツファイルの登録
St      = aniki.cns       ;ステートファイルの登録・最大１１個まで増やせます
st1     = tandem.cns   ;キャラのプログラム
StCommon = anikicommon.cns  ;コモンステートファイルの登録
Sprite  = aniki.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = aniki.air       ;アニメーションファイルの登録
Sound   = aniki.snd      
Pal1 = Anime.act  ;Ａボタンで決定した色が使えます
Pal2 = aniki02.act  ;Ｂ
Pal3 = aniki03.act  ;Ｃ
Pal4 = aniki01.act  ;Ｘ
Pal5 = aniki04.act  ;Ｙ
Pal6 = aniki05.act  ;Ｚ

;--| ストーリーボード設定 |---------------------------------------------------
;
; キャラクター固有のオープニングやエンディングのファイル（ストーリーボード）を
; 登録する場合はここで設定をします。
;
; ※ここで設定したストーリーボードが有効になるゲームモードは
; 「アーケードモード（ARCADE）」
; 「チームアーケードモード（TEAM ARCADE）」
; 「１Ｐと２ＰがペアになってＣＰＵと闘うモード（TEAM CO-OP）」の三種類のみ。
;
; 　しかしチームを組んだ場合、有効になるのは『選んだ最初の一人目』のみ。
;
;-----------------------------------------------------------------------------

[Arcade]
Intro.Storyboard = intro.def   ;オープニングのファイルを登録します
Ending.Storyboard = ending.def ;エンディングのファイルを登録します

