sprite  = media/crysis3.sff   ;Sprite
anim    = media/sfiii4th.air   ;Animation
sound   = media/angeldust.snd   ;Sound
pal1    = palettes/dlc1.act
pal2    = palettes/cvtwdbk.act
pal3    = palettes/dlcdotexe.act
pal4    = palettes/dlc4.act
pal5    = palettes/harley2010.act
pal6    = palettes/harley2.act
pal7    = palettes/harley3.act
pal8    = palettes/harley4.act
pal9    = palettes/super deebeekaw.act
pal10    = palettes/hyper deebeekaw.act
pal11   = palettes/jesse.act
pal12    = palettes/violette_kaw.act


[Palette Keymap]
x = 1
y = 2
z = 3
a = 4
