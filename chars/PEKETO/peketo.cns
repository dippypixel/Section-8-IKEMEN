;trigger1=!(teammode=simul)&&!(enemy,teammode=simul)
;value = 4499
;ctrl = 0

;;ENDING TEAM MODE WALLPAPER
;[State 0, ChangeState]
;type = null;ChangeState
;trigger1=teammode=simul && enemy,teammode=simul && !ishometeam
;trigger1=matchover && matchno >= 5
;value = 500
;ctrl = 0

[State 180, 1]
type = VarRandom
trigger1 = time = 0
v = 1
range = 1, 3

[State 180, a]
type = ChangeState
trigger1 = var(10) = 0
trigger1 = time >= 2
trigger1 = var(1) = 1
value = 181

[State 180, b]
type = ChangeState
trigger1 = var(10) = 0
trigger1 = time >= 2
trigger1 = var(1) = 2
value = 183

[State 180, b]
type = ChangeState
trigger1 = var(10) = 0
trigger1 = time >= 2
trigger1 = var(1) = 3
trigger2 = var(10) = 1
trigger2 = time >= 2
value = 185

