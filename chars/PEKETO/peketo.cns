; Win pose 3 - baile
[Statedef 185]
type = S
ctrl = 0
velset = 0,0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(10) = 0 && !time
value = 186

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(10) > 0 && !time
value = cond(random<500,30186,30187)

[state 191, Snd 2]
type = PlaySnd
trigger1 = var(10) = 0
trigger1 = AnimElem = 1
value = 15,1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 182, 1]
type = AssertSpecial
trigger1 = time < 200
flag = roundnotover

