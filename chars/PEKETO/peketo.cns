trigger16 = animelem = 62
trigger17 = animelem = 66
trigger18 = animelem = 70
trigger19 = animelem = 74
trigger20 = animelem = 78
trigger21 = animelem = 82
trigger22 = animelem = 86
trigger23 = animelem = 90
trigger24 = animelem = 94
trigger25 = animelem = 98
trigger26 = animelem = 102
trigger27 = animelem = 106
trigger28 = animelem = 110
value = 40,0
freqmul = 2.0+(random/3333.3)
volume = -60

;se cae cabeza
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(10)=0 && animelem = 18 && random < 500
value = 30186
elem = 18

[State 0, Helper]
type = Helper
trigger1 = var(10)=0 && anim = 30186
name = "cabeza win"
ID = 30186
pos = -3,-69
stateno = 186
persistent = 0

;---------------------------------
;cabeza winpose baile
[StateDef 186]
type = S
movetype= I
physics = N
ctrl = 0
sprpriority = 2

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 12,1

[State 0, VelSet]
type = VelSet
trigger1 = !time
x = 1

[State 0, VelAdd]
type = VelAdd
trigger1 = 1
y = .3

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = 59
elem = 25

[State 0, ChangeState]
type = Changeanim
trigger1 = anim = 59 && pos y >=1
value = 5190

[State 0, VelSet]
type = VelSet
trigger1 = anim = 5190
x = 0
y = 0

[State 0, posset]
type = posset
trigger1 = anim = 5190
y = 4

[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 5190
value = 6,0
persistent = 0




