; States that are executed when in self's state file (use statedef -3)
;--------------------------------------------------------------------------

[Statedef -3]



;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
value = 40, 0
freqmul = 0.8+(random/3333.3)
volume = 100

[State 0, PlaySnd]
type = PlaySnd
triggerall = time=1
trigger1 = stateno = 50
value = 0,1
volume = -100
freqmul = 0.6+(random/6666.6)

;se cancela afterimage si es golpeado
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = movetype = h
time = 0

;DF
;baja la vida si le pegan a la cabeza
[State -3, PowerAdd]
type = lifeAdd
triggerall = var(10) = 1
trigger1 = numhelper(3100)!= 0
trigger1 = helper(3100), stateno = 3121 && helper(3100), time = 0
value = -100
kill = 0

;DF
;baja el poder mientras esta en DF si es golpeado
[State -3, PowerAdd]
type = null;PowerAdd
triggerall = var(10) = 1
trigger1 = movetype = H && !time
value = -60

;DF
;baja el poder si le pegan a la cabeza
[State -3, PowerAdd]
type = null;powerAdd
triggerall = var(10) = 1
trigger1 = numhelper(3100)!= 0
trigger1 = helper(3100), stateno = 3121 && helper(3100), time = 0
value = -100

;DF
;inmune a throws
[State 0, NotHitBy]
type = null;NotHitBy
trigger1 = var(10) = 1
value = ,AT

;DF
;inmune a throws 2
[State 0, HitOverride]
type = null;HitOverride
trigger1 = var(10) = 1
slot = 0
attr = ,AT
stateno = 5000
time = 1

;DF cancela DF
[State -3, cancela]
type = ChangeState
triggerall = var(10) >0 && power > 0 && life !=0
triggerall = statetype !=A && (ctrl || (stateno=[200,440]) && time <3)
triggerall = command = "cabeza"
trigger1 = var(24) = 0
trigger2 = var(24) = 3
trigger3 = var(24) = 1 && power <=1000
trigger4 = var(24) = 2 && power <=1000
trigger5 = var(24) = 4
value = 3101
ctrl = 0

;Survival winscreen partner
;------------------
[State 0, ChangeState]
type = ChangeState
triggerall = numpartner
trigger1 = partner,stateno=18000 && stateno !=18000 && stateno !=18001
value = 18001

;Survival winscreen enemigo
[State 0, ChangeState]
type = ChangeState
triggerall = numenemy
trigger1 = enemynear,stateno=18000 && stateno !=18002
value = 18002


;sangre constante
[State 0, Helper]
type = Helper
trigger1 = life <= 250 && random < 10
trigger1 = roundstate = 2 && movetype != H && alive = 1
trigger1 = stateno != 3070 && stateno != 3075 && stateno != 3076 && stateno != 3090 && stateno != 4000 && stateno != 4003 && stateno != 4010
name = "sangre constante"
ID = 6100
stateno = 6100
pos = ceil(-8+(random/60)), ceil(cond(statetype!=c,-40,-20)-(cond(statetype!= c,(random/23),(random/24))))
facing = cond(random<500,1,-1)
ownpal = 1



