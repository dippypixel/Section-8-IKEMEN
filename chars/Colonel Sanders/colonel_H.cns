;---------------------------------------------------------------------------
;カットイン
;---------------------------------------------------------------------------

[Statedef 2000]
type    = A
movetype= A
physics = N
velset = -34,0
juggle = 0
anim = 2000
ctrl = 0

[State 2000]
type = VelAdd
trigger1 = Time = [0, 15]
x = 2

[State 2000]
type = VelAdd
trigger1 = Time = [15, 20]
x = 0.8

[State 2000]
type = VelAdd
trigger1 = Time = [20, 50]
x = -2

[State 2000]
type = DestroySelf
trigger1 = Time = 80
trigger2 = Root,StateNo = 3200
trigger2 = Time = 32
trigger3 = Root,StateNo = 3400
trigger3 = Time = 50

;---------------------------------------------------------------------------
;カットイン（ズーム有ステージ考慮）
;---------------------------------------------------------------------------

[Statedef 2001]
type    = A
movetype= I
physics = N
velset = 0,0
juggle = 0
anim = 1
ctrl = 0

[State 2000, Afterimages]
type = Helper
trigger1 = Time = 0 && (Parent,ID = Root,ID)
helpertype = normal
name = "Afterimages"
ID = 8590
stateno = 8590
pos = 0,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1
size.xscale = root,const(size.xscale)
size.yscale = root,const(size.yscale)
supermovetime = 999999
pausemovetime = 999999

[State 2000, Afterimages]
type = Helper
trigger1 = Time = 0 && (Parent,ID = Root,ID)
helpertype = normal
name = "Afterimages"
ID = 8591
stateno = 8590
pos = 0,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1
size.xscale = root,const(size.xscale)
size.yscale = root,const(size.yscale)
supermovetime = 999999
pausemovetime = 999999

[state 2000, RemoveTime Set (Default)]
type = varset
triggerall = !Time
trigger1 = 1
var(1)= 80
ignorehitpause = 1
[state 2000, RemoveTime Set 1]
type = varset
triggerall = !Time
trigger1 = Root,StateNo = 3000
var(1)= 102
ignorehitpause = 1
[state 2000, RemoveTime Set 2]
type = varset
triggerall = !Time
trigger1 = Root,StateNo = 3200 | Root,StateNo = 3600
var(1)= 32
ignorehitpause = 1
[state 2000, RemoveTime Set 3]
type = varset
triggerall = !Time
trigger1 = Root,StateNo = 3400
var(1)= 50
ignorehitpause = 1

[State 2001, CutIn]
type = Explod
trigger1 = !Time
anim = 2000
ID = 2001
sprPriority = -16
posType = Back
removeTime = var(1)
superMoveTime = -1

[State 2001, CutIn VelAdd]
type = varadd
trigger1 = 1
var(2) = 30 + var(3)

[State 2001, CutIn VelAdd]
type = varadd
trigger1 = Time < 15
var(3) = -2
[State 2001, CutIn VelAdd]
type = varadd
trigger1 = Time >= 16
var(3) = 2

[State 2001, CutIn is Moving]
type = ModifyExplod
trigger1 = NumExplod(2001)
ID = 2001
posType = Back
pos = ceil(320 - (var(2))), floor((1.3333333 * GameHeight / GameWidth) * 55)
scale = 1, 1

[State 2001]
type = DestroySelf
trigger1 = !var(1)
trigger1 = Time >= 32
trigger2 = var(1)
trigger2 = Time >= var(1)

