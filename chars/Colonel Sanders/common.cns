;---------------------------------------------------------------------------
;立ち
;---------------------------------------------------------------------------

[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, アニメ変更]
type = ChangeAnim
trigger1 = (Anim != 0) && (Anim != 5)
trigger2 = (Anim = 5) && (AnimTime = 0)
value = 0

[State 0, 移動速度]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 移動速度]
type = VelSet
trigger1 = (abs(Vel X) < 2) ;absは『Absolute（絶対値）』
trigger2 = Time = 4
trigger3 = (PrevStateNo = 20) && (Time = 0)
x = 0

[State 0, ステート変更]
type = ChangeState
trigger1 = (!Alive)
value = 5050

[State 0, ヘルパーを消す];ヘルパー分身バグ対策
type = DestroySelf
trigger1 = (IsHelper) ;このプレイヤーが「ヘルパーオブジェクト」だったら

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
;---------------------------------------------------------------------------
;ジャンプ開始
;---------------------------------------------------------------------------

[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velSet = 0,0
sprPriority = 1

[State 40, 1]
type = VarSet
trigger1 = !Time
var(3) = 0

[State 40, 変数];※システム用
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 変数];※システム用
type = VarSet
trigger1 = (command = "holdfwd")
trigger2 = (Var(36) = 1)
sysvar(1) = 1

[State 40, 変数];※システム用
type = VarSet
trigger1 = (command = "holdback")
trigger2 = (Var(36) = -1)
sysvar(1) = -1

[State 40, 変数];AI用左右入力フラグリセット
type = VarSet
trigger1 = Var(36) != 0
v = 36
value = 0

[State 40, 移動速度]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 振り返る]
type = Turn
triggerall = 1;(PrevStateNo = 52)
trigger1 = (Time = 0) && (P2Dist X < 0)
Persistent = 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
trigger1 = sysvar(1) = 1 || sysvar(1) = -1
trigger1 = (PrevStateNo = 100 && var(11)) || (PrevStateNo = 105 && var(11))
var(3) = 1

[State 40, 移動速度]
type = VelSet
trigger1 = (AnimTime = 0)
trigger1 = (var(3))
trigger1 = (sysvar(1) = 1)
x = const(velocity.runjump.fwd.x)

[State 40, 移動速度]
type = VelSet
trigger1 = (AnimTime = 0)
trigger1 = (var(3))
trigger1 = (sysvar(1) = -1)
x = const(velocity.runjump.back.x)

[State 40, 音を鳴らす]
type = PlaySnd
trigger1 = AnimTime = 0
value = 2, ifelse(var(3), 7, 6)
channel = 5

[State 40, 残像]
type = null;AfterImage
trigger1 = AnimTime = 0
trigger1 = (PrevStateNo = 100)
Time = 2
PalContrast = 120,120,120
Trans = Add1
TimeGap  = 4
FrameGap = 1
length = 3

[State 40, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = N

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
triggerall = (PrevStateNo != [600,699])
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
triggerall = (PrevStateNo != [600,699])
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State 50, Grounded Frame]
type = PosFreeze
trigger1 = Time < 1 && PrevStateNo = 40
value = 1

[State 50, Gravity]
type = Gravity
trigger1 = Time >= 1 || PrevStateNo != 40

[State 50, Landing]
type = ChangeState
trigger1 = pos y > -vel y
value = 52

;---------------------------------------------------------------------------
;空中下降
;---------------------------------------------------------------------------

[Statedef 51]
type     = A
movetype = I
physics  = N
ctrl     = 1
poweradd = 0

[State 51, アニメ変更]
type = ChangeAnim
trigger1 = (PrevStateNo = [700,701]) && (Time = 0)
trigger2 = (PrevStateNo = 800) && (Time = 0)
value = 41
elem = 5
Persistent = 0

[State 51, Gravity]
type = Gravity
trigger1 = 1

[State 50, Landing]
type = ChangeState
trigger1 = pos y > -vel y
value = 52

;---------------------------------------------------------------------------
;着地
;---------------------------------------------------------------------------

[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = ifelse((PrevStateNo = 1011 | PrevStateNo = 1071 | (PrevStateNo = 1030 && !var(48))),1012,47)
velset = 0,0

[State 52, SysVar]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 52, Assert: NoGuard]
type = AssertSpecial
trigger1 = PrevStateNo = 1011 | PrevStateNo = 1071 | PrevStateNo = 1030
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard

[State 52, 軸位置];地面に軸をリセットする
type = PosSet
trigger1 = 1
y = 0

[State 52, 移動速度];速度をリセットしている
type = VelSet
trigger1 = 1
x = 0
y = 0

[State 52, Assert: NoWalk]
type = AssertSpecial
trigger1 = anim != 5
flag = NoWalk

[State 52, コントロール]
type = CtrlSet
triggerall = (PrevStateNo = [40,51]) || (PrevStateNo = [600,699])
trigger1 = (Time > 0)
value = 1

[State 52, 振り返る]
type = Turn
trigger1 = (AnimTime = 0) && (P2Dist X < 0)
trigger2 = (AnimElemTime(1) = 0) && (P2Dist X < 0)

[State 52, エフェクト]
type = Explod
trigger1 = Time = 0
anim = 4020
postype = p1
pos = 0,0
scale = 0.5,0.5
sprpriority = -3
pauseMoveTime = -1
superMoveTime = -1
ownpal = 1
ID = 4020

[State 52, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 2,8

[State 52]
type = VarSet
trigger1 = (Var(35) != 0)
v = 35
value = 0

[State 52]
type = VarSet
trigger1 = (Var(36) != 0)
v = 36
value = 0

[State 52, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;走る
;---------------------------------------------------------------------------

[Statedef 100]
type     = S
movetype = I
physics  = N
anim     = 100
ctrl     = 1
sprpriority = 1

[State 100, アニメ変更]
type = ChangeAnim
triggerall = (Time > 7)
trigger1 = !AILevel && (command != "holdfwd")
trigger2 = AILevel && (Var(1) != [7, 10])
value = 101
Persistent = 0

[State 100, 状態変更]
type = StateTypeSet
trigger1 = (Anim = 101)
Physics = S

[State 100, 変数]
type = VarSet
trigger1 = 1
var(11) = ifelse((Anim = 100), 1, 0)

[State 100, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = nostandguard
flag3 = nocrouchguard

[State 100, 埃]
type = MakeDust
trigger1 = (Anim = 101)
pos = 0,0
spacing = 1
Persistent = 0

[State 100, 音]
type = PlaySnd
trigger1 = Time = 3
value = s2,4

[State 100, 音]
type = PlaySnd
trigger1 = Anim != 101
trigger1 = AnimElem = 5
value = s2,1

[State 100, 音]
type = PlaySnd
trigger1 = Anim != 101
trigger1 = AnimElem = 9
value = s2,2

[State 100, 音]
type = PlaySnd
trigger1 = Anim = 101
trigger1 = AnimElem = 1
value = s2,3

[State 100, 軸位置]
type = PosSet
trigger1 = 1
y = 0

[State 100, 移動速度]
type = VelSet
trigger1 = 1
y = 0

[State 100, 移動速度]
type = VelSet
trigger1 = Anim = 100
trigger1 = Time >= 3
x = const(velocity.run.fwd.x)

[State 100, ステート変更]
type = ChangeState
triggerall = (Anim = 101)
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;バックダッシュ
;---------------------------------------------------------------------------

[Statedef 105]
type     = S
movetype = I
physics  = N
anim     = 105
ctrl     = 1
sprpriority = 1

[State 105, アニメ変更]
type = ChangeAnim
triggerall = (Time > 7)
trigger1 = !AILevel && (command != "holdback")
trigger2 = AILevel && (Var(1) != [7, 10])
value = 106
Persistent = 0

[State 105, 状態変更]
type = StateTypeSet
trigger1 = (Anim = 106)
Physics = S

[State 105, 変数]
type = VarSet
trigger1 = 1
var(11) = ifelse((Anim = 105), 1, 0)

[State 105, 移動速度]
type = VelSet
trigger1 = Anim = 105
trigger1 = Time >= 3
x = const(velocity.run.back.x)

[State 105, 特殊効果]
type = AssertSpecial
trigger1 = Time < 15
trigger2 = Anim = 106
flag = NoWalk
flag2 = nostandguard
flag3 = nocrouchguard

[State 105, 特殊効果]
type = AssertSpecial
trigger1 = Time >= 15 && Anim = 105
flag = NoWalk

[State 105, 埃]
type = MakeDust
trigger1 = (Anim = 106) && AnimElemTime(1) = 0
pos = 0,0
spacing = 1

[State 100, 音]
type = PlaySnd
trigger1 = Time = 3
value = s2,4

[State 100, 音]
type = PlaySnd
trigger1 = Anim != 106
trigger1 = AnimElem = 5
value = s2,1

[State 100, 音]
type = PlaySnd
trigger1 = Anim != 106
trigger1 = AnimElem = 9
value = s2,2

[State 100, 音]
type = PlaySnd
trigger1 = Anim = 106
trigger1 = AnimElem = 1
value = s2,3

[State 105, 軸位置]
type = PosSet
trigger1 = 1
y = 0

[State 105, 移動速度]
type = VelSet
trigger1 = 1
y = 0

[State 105, ステート変更]
type = ChangeState
triggerall = (Anim = 106)
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; GUARD (start)
;---------------------------------------------------------------------------

[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && (command = "holddown" || Var(1) = 11) 
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && (command != "holddown" && Var(1) != 11)
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = (command != "holdback" && Var(1) != [11, 12])
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
[Statedef 130]
type    = S
physics = S

[State 130, SysVar]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 130, エフェクト]
type = Explod
trigger1 = Time = 0
trigger1 = PrevStateNo = 132 || (PrevStateNo = [154,155])
anim = 4020
postype = p1
pos = 0,0
scale = 0.5,0.5
sprpriority = -3
pauseMoveTime = -1
superMoveTime = -1
ownpal = 1
ID = 4020

[State 130, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
trigger1 = PrevStateNo = 132 || (PrevStateNo = [154,155])
value = 2,8

[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, Hi to Lo]
type = ChangeState
trigger1 = command = "holddown"
value = 131

[State 130, Stop Guarding]
type = ChangeState
trigger1 = (command != "holdback" && Var(1) != 12)
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)
[Statedef 131]
type    = C
physics = C

[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 131
value = 131

[State 131, Lo to Hi]
type = ChangeState
trigger1 = (command != "holddown" && Var(1) != 11)
value = 130

[State 131, Stop Guarding]
type = ChangeState
trigger1 = (command != "holdback" && Var(1) != 11)
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; AIR GUARD (guarding)
[Statedef 132]
type    = A
physics = N

[State 132, 1]
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 2]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 132, 3]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command = "holdback"
trigger1 = inguarddist
value = 130

[State 132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; GUARD (end)
[Statedef 140]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
ctrl = 1

[State 140, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (statetype = C) + (statetype = A)*2

[State 140, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 140, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 140, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 140, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 140, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 140, 5] ;Implemented within engine
type = ChangeState
trigger1 = statetype != A && !animtime
trigger2 = statetype = A && animelem = 2
value = (statetype = C)*11 + (statetype = A)*51

;---------------------------------------------------------------------------
; SGUARDHIT (shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

;--- ---
; sysvar(0): player_spark_xy
[state 0] ;[.07p1]
	type=varset
	triggerall=var(53)
	trigger1=!time
	sysvar(0)=0
	ignorehitpause=1
	persistent=0
[state 0] ;[.07p2]
	type=varset
	triggerall=var(53)
	trigger1=!time &&  gethitvar(ctrltime)>0 && playeridexist(gethitvar(ctrltime))
	trigger1= playerid(gethitvar(ctrltime)),const(data.sparkno)<-1       ;;<-var(#1)
	trigger1= playerid(gethitvar(ctrltime)),var(-playerid(gethitvar(ctrltime)),const(data.sparkno))>=0      ;;<-spark_no
	trigger1= playerid(gethitvar(ctrltime)),const(data.guard.sparkno)<-1 ;;<-var(#2)
	trigger1= playerid(gethitvar(ctrltime)),var(-playerid(gethitvar(ctrltime)),const(data.guard.sparkno))>0 ;;<-spark_xy
	sysvar(0)=playerid(gethitvar(ctrltime)),var(-playerid(gethitvar(ctrltime)),const(data.guard.sparkno))
	ignorehitpause=1
	persistent=0
; standing_guard_spark
[state 0] ;[.07]
	type=helper
	triggerall=var(53)
	trigger1=!time && sysvar(0)>0
	id=152100
	stateno=152100
	helpertype=normal
	ownpal=1
	keyctrl=0
	postype=p1
	pos=(((sysvar(0)/1000)%1000)-500),ceil((500-(sysvar(0)%1000))*playerid(gethitvar(ctrltime)),const(size.yscale)+playerid(gethitvar(ctrltime)),pos y-pos y)
	size.height=40+playerid(gethitvar(ctrltime)),var(-playerid(gethitvar(ctrltime)),const(data.sparkno))%10 ;;<-hit_spark
	ignorehitpause=1
	persistent=0

;---------------------------------------------------------------------------
