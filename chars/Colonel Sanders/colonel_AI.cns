;Var(1)		AI行動変数
;0.なにもしない
;1.ジャンプ前入力
;2.ジャンプ後入力
;3.垂直ジャンプ
;4.大ジャンプ前入力
;5.大ジャンプ後入力
;6.垂直大ジャンプ
;7.前ダッシュ(10f)
;8.後ダッシュ(10f)
;9.前ダッシュジャンプ
;10.後ダッシュジャンプ
;11.屈みガード

[Statedef -3]

[State -3, Parry Detection]
type = Helper
triggerAll = RoundState = 2 && !NumHelper(6090)
triggerAll = (MoveType = I && ctrl) || (StateNo = [6080,6082]) && Time >= 8 || StateNo = 5120 && AnimTime=0
triggerAll = (command != "rlsfwd" && command != "rlsback" && command != "rlsup" && command != "rlsdown") || AILevel
trigger1 = !AIlevel && (statetype = S || statetype = C || stateno = 5120 && AnimTime=0) && (ifElse(P2dist x >= 0, command = "fwd", command = "back") || command = "down")
trigger2 = !AIlevel && statetype = A && (ifElse(P2dist x >= 0, command = "fwd", command = "back"))
trigger3 = AIlevel && (stateno != [6080, 6082]) && inguarddist && random < 50
trigger4 = AIlevel && (stateno = [6080, 6082]) && time = 14 && random < 667
stateNo = 6090
ID = 6090
name = "Parry Detection"
posType = P1
pauseMoveTime = 65535
superMoveTime = 65535

[State -3, Parry Attacks]
type = ChangeState
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = Helper(6090), StateNo = 6091
value = ifElse((Helper(6090), Anim = 6092), 6082, ifElse((Helper(6090), Anim = 6091), 6081, 6080))
ignoreHitPause = 1

[State -3, Parry Projectiles]
type = HitOverride
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = !(Helper(6090), var(0)) && (Helper(6090), Anim = 6090)
attr = SA, AP
stateNo = 6080
slot = 0
time = 1
ignoreHitPause = 1

[State -3, Parry Projectiles]
type = HitOverride
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = !(Helper(6090), var(0)) && (Helper(6090), Anim = 6091)
attr = C, AP
stateNo = 6081
slot = 0
time = 1
ignoreHitPause = 1

[State -3, Parry Projectiles]
type = HitOverride
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = !(Helper(6090), var(0)) && (Helper(6090), Anim = 6092)
attr = SCA, AP
stateNo = 6082
slot = 0
time = 1
ignoreHitPause = 1

[State -3, Assert: NoWalk after Parry]
type = AssertSpecial
trigger1 = numhelper(6085)
flag = NoWalk
ignoreHitPause = 1

[State -3, Movement AfterImage]
type=AfterImage
triggerAll=(Time=1 && StateNo != 40) || (AnimTime = 0 && StateNo = 40)
trigger1=StateNo=40 && var(3)
trigger2=StateNo=10003
trigger3=(StateNo=[700,710])
trigger4=StateNo=10004
time=2
timeGap=1
frameGap=4
length=9
palBright=0,0,0
palContrast=128,128,128
palPostBright=0,0,0
palAdd=0,0,0
palMul=0.9,0.9,0.9
trans=Add1

[State -3, Level 1 Super AfterImage]
type=AfterImage
trigger1=StateNo=3000 && Time = 40
trigger2=StateNo=3300 && Time = 50
trigger3=StateNo=3400 && Time = 30
time=2
timeGap=1
frameGap=10
length=21
palBright=0,0,0
palContrast=128,128,128
palPostBright=0,0,0
palAdd=0,0,0
palMul=0.75,0.75,0.75
trans=Add1

[State -3, Level 2 Super AfterImage]
type=AfterImage
trigger1=StateNo=3500 && Time = 50
trigger2=StateNo=3600 && Time = 2
trigger3=StateNo=3601 && AnimElem = 2
time=2
timeGap=1
framegap=10
length=21
palBright=0,0,0
palContrast=32,32,160
palPostBright=0,0,0
palAdd=0,0,0
palMul=0.75,0.75,0.75
trans=Add1

[State -3, Level 3 Super AfterImage]
type=AfterImage
trigger1=StateNo=3200 && Time = 2
time=2
timeGap=1
frameGap=10
length=21
palBright=0,0,0
palContrast=160,32,32
palPostBright=0,0,0
palAdd=0,0,0
palMul= 0.75,0.75,0.75
trans=Add1

[State -3, AfterImage Persist]
type=AfterImageTime
trigger1=(StateNo=[50,51]) || (StateNo=[600,699]) || (StateNo=[1020,1030])
trigger1=(vel y < -1 && !var(35)) || var(35)
trigger1=(PrevStateNo=40&&var(3))||PrevStateNo!=40
trigger2=StateNo=[700,710]
trigger3=(StateNo=[3000,4999]) && StateNo!=3204
trigger4=StateNo=3204 && AnimElemTime(10)<0
time=2

[State -3, AfterImage Off]
type=AfterImageTime
triggerAll=Time <= 1
trigger1=StateNo=3000 || StateNo=3200 || Stateno=3300 || StateNo=3400 || StateNo=3500
time=0

[State -3, Get Hit Sound]
type=PlaySnd
triggerAll=Alive && Time=1
triggerAll=StateNo=5000 || StateNo=5010
trigger1=GetHitVar(AnimType) >= 2 && Random < 500
trigger2=GetHitVar(AnimType)=1 && Random < 375
trigger3=GetHitVar(AnimType)=0 && Random < 250
value=5000,(Random % 5)
channel=0
ignoreHitPause=1
[State -3, Get Hit Sound]
type =PlaySnd
triggerAll=Alive && Time=1
trigger1=(StateNo=5000 || StateNo=5010) && NumEnemy
trigger1=GetHitVar(fall) || (EnemyNear, HitDefAttr=SCA,SA,HA)
trigger2=(StateNo=5020 || StateNo=5070 || StateNo=5080)
trigger3=(StateNo=5050 || StateNo=5100) && (PrevStateNo != [5000,5199])
value=5000,(Random % 5)
channel=0
ignoreHitPause=1

[State -3, Super Finish]
type = Helper
triggerAll = WinKO
triggerAll = RoundState = 3 && !NumHelper(8600) && fvar(39) < 1
trigger1 = MoveHit = 1 && (StateNo = [3000,3999])
trigger2 = (StateNo = 3206)
trigger3 = (StateNo = 3305)
trigger4 = (StateNo = [3503,3504])
trigger5 = NumHelper(3400)
trigger5 = Helper(3400),StateNo = 3403
trigger6 = (StateNo = 3601)
helperType = Normal
stateNo = 8605
ID = 8600
name = "Super Finish"
posType = left
pos = 160,-120
ownPal = 1
size.xscale =1.0
size.yscale =1.0
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1

[State -3, Not Finish FX]
type = VarSet
trigger1 = 1
fvar(39) = Ifelse(RoundState >= 3, 1, 0)
IgnoreHitPause = 1

;---------------------------------------------------------------------------
;AI発動(Activate AI)
;---------------------------------------------------------------------------

[State -3, Activate_AI for Single]
type = VarSet
triggerall = (var(0) = 0) && (RoundState < 3)
triggerall = AILevel
trigger1 = TeamMode!=Simul
v = 0
value = floor(AILevel * 1.5);この値によりAIのレベルが決定されます。0でAIなし、12で最高レベルになります。
IgnoreHitPause = 1
Persistent = 1

[State -3, Activate_AI for Simul]
type = VarSet
triggerall = (var(0) = 0) && (RoundState < 3)
triggerall = AILevel
triggerall = NumPartner
trigger1 = TeamMode=Simul
v = 0
value = ifelse(Partner,AILevel<1, 12, floor(AILevel * 1.5))
IgnoreHitPause = 1
Persistent = 1

[State -3, Stop_AI]
type = VarSet
triggerall = (var(0) > 0) && (RoundState < 3)
trigger1 = !AILevel
v = 0
value = 0
IgnoreHitPause = 1
Persistent = 1

;---------------------------------------------------------------------------
;AIレベルごとにランダム変数の範囲を決定

[State -3]
type = VarRangeSet
trigger1 = (Var(54) = 0) && (Var(0) != 0)
first = 54
last = 56
value = ifelse(Var(0) > 12, 640, floor((1+(12-Var(0))*0.8)*640));
IgnoreHitPause = 1
Persistent = 1

