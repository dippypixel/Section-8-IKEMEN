
[Statedef -2]
;---------------------------------------------------------------------------
;製作用
;---------------------------------------------------------------------------
[State -2, コンボ確認]
Type = VarSet
Trigger1 = 1
fvar(39) = 0

;---------------------------------------------------------------------------
;タッグ用生死判別
;---------------------------------------------------------------------------
[State -1, VarSet]
Type = Varset
trigger1 = 1
var(58) = IfElse((!EnemyNear(0),Alive && NumEnemy = 2),1,0)

;---------------------------------------------------------------------------
;ヒット判定
;---------------------------------------------------------------------------
[State -2, Combo]
type = VarSet
trigger1 = movehit
trigger2 = projhit = 1
var(36) = ifelse(movehit,1,3)
ignorehitpause = 1

[State -2, Combo]
type = VarSet
trigger1 = moveguarded
trigger2 = projguarded = 1
var(36) = ifelse(moveguarded,2,4)
ignorehitpause = 1

;---------------------------------------------------------------------------
;ヒット数
;---------------------------------------------------------------------------
[State -2, VarSet]
type = VarSet
trigger1 = P2movetype != H
var(17) = 0
ignorehitpause = 1

[State -2, VarAdd]
type = VarAdd
trigger1 = (stateno != [800,810])
trigger1 = movehit = 1
trigger2 = projhit = 1
var(17) = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
;リコイルガード
;---------------------------------------------------------------------------
[State -2, フラグオフ]
type = varset
trigger1 = command != "holdback"
trigger2 = var(6) >= 11
var(5) = 0
ignorehitpause = 1

[State -2, フラグオン]
type = varset
trigger1 = var(6) < 11
trigger1 = command = "holdback"
var(5) = 1
ignorehitpause = 1

[State -2, holdback入力時間]
type = varadd
trigger1 = command = "holdback"
var(6) = 1
ignorehitpause = 1

[State -2, holdback入力時間リセット]
type = varset
trigger1 = command != "holdback"
trigger1 = stateno != [150,155]
var(6) = 0
ignorehitpause = 1

[State -2, ChangeState] 
type = ChangeState
triggerall = stateno = 150 || stateno = 152 || stateno = 154
triggerall = time = 0
trigger1 = !var(59) && var(5)
trigger2 = var(59) && Random<= 10+(390*((100*life/lifemax)<=25))+(40*statetype=A)
trigger2 = prevstateno != [140,155]
value = 160
ignorehitpause = 1

;---------------------------------------------------------------------------
;カウンター
;---------------------------------------------------------------------------
[State -2, PowerReset]
type = VarSet
trigger1 = P2MoveType = A
var(14) = 1

[State -2, PowerReset]
type = VarSet
trigger1 = P2MoveType != A
var(14) = 0

;---------------------------------------------------------------------------
;コンボ補正
;---------------------------------------------------------------------------
[State -2, コンボ補正]
type = VarSet
trigger1 = var(17) >= 30
trigger1 = (stateno != [2000, 2100])
fvar(0) = .02
ignorehitpause = 1

[State -2, コンボ補正]
type = VarSet
trigger1 = var(17) = [6,29]
trigger1 = (stateno != [2000, 2100])
fvar(0) = (25-(var(17)-5))*.02
ignorehitpause = 1

[State -2, コンボ補正]
type = VarSet
trigger1 = var(17) <= 5
trigger2 = (stateno = [2000, 2100])
fvar(0) = 1
ignorehitpause = 1

[State -2, 攻撃力補正]
type = VarSet
trigger1 = 1
fvar(10) = (10+(var(14)*2))*.1*fvar(0)
ignorehitpause = 1

;---------------------------------------------------------------------------
;曙フィニッシュ
;---------------------------------------------------------------------------
[State -2, KO]
type = Varadd
trigger1 = roundstate = 3
ignorehitpause = 1
var(32) = 1

[State -2, KO]
type = Varset
trigger1 = roundstate != 3
ignorehitpause = 1
var(32) = 0

[State -2, BGPalFX]
type = BGPalFX
triggerall = WinKo && var(32) = 1
trigger1 = (stateno = [2000, 2100])
mul = 460,430,300
sinadd = 155,155,205,60
time = 30
invertall = 0
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;AI起動用ヘルパー
;---------------------------------------------------------------------------
[State -3, AI起動用ヘルパー]
type=helper
trigger1=!NumHelper(10000)
trigger1=roundstate=2
trigger1=alive
trigger1=var(59)=0
trigger1=PrevStateNo=190||PrevStateNo=4000||PrevStateNo=5900
trigger1=ctrl&&stateno=0
helpertype=normal
name="AI"
stateno=10000
ID=10000
pos=9999,9999
keyctrl=1
pausemovetime=2147483647
supermovetime=2147483647
persistent = 0

[State -3, 関係無いステートに行かないように]
type=changestate
trigger1= ishelper(10000)
trigger1= stateno!=10000
value=10000

;---------------------------------------------------------------------------
;汎用処理
;---------------------------------------------------------------------------
[State -2 ,残像消去]
type = AfterImageTime
trigger1 = MoveType = H
trigger2 = StateNo = [0,410]
trigger3 = StateNo = [600,1500]
trigger4 = StateNo = 4000
time = 0
IgnoreHitPause = 1

[State -2, Combo]
type = VarSet
trigger1 = Time = 1
var(36) = 0
ignorehitpause = 1

[State -2, MoveHitReset]
type = MoveHitReset
trigger1 = MoveContact
ignorehitpause = 1

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = var(59)
flag = nowalk

;---------------------------------------------------------------------------
;ローカルルール
;---------------------------------------------------------------------------
;毒効果（ドロウィンアルカナ)
[state -2]
type = poweradd
triggerall = power > 0
trigger1 = enemy(0),authorname = "Drowin arcana"
trigger1 = enemy(0),fvar(20) > 0
trigger2 = numenemy = 2
trigger2 = enemy(1),authorname = "Drowin arcana"
trigger2 = enemy(1),fvar(20) > 0
value = -1

[state -2]
type = lifeadd
triggerall = gametime % 7 = 0
trigger1 = enemy(0),authorname = "Drowin arcana"
trigger1 = enemy(0),fvar(20) > 0
trigger2 = numenemy = 2
trigger2 = enemy(1),authorname = "Drowin arcana"
trigger2 = enemy(1),fvar(20) > 0
value = -1
kill = 0
			
[state -2]
type = Palfx
trigger1 = enemy(0),authorname = "Drowin arcana"
trigger1 = enemy(0),fvar(20) > 0
trigger2 = numenemy = 2
trigger2 = enemy(1),authorname = "Drowin arcana"
trigger2 = enemy(1),fvar(20) > 0
add = 100,0,110
mul = 220,220,220
time = 5
ignorehitpause = 1

;---------------------------------------------------------------------------
;獣を焦がす　相手用
[State -2]
Type = LifeAdd
Trigger1 = Enemy(0),AuthorName = "⑨" && Enemy(0),Name = "Akiha_Vermilion"
Trigger1 = Enemy(0),Var(47) = 1
Trigger2 = NumEnemy = 2
Trigger2 = Enemy(1),AuthorName = "⑨" && Enemy(1),Name = "Akiha_Vermilion"
Trigger2 = Enemy(1),Var(47) = 1
Value = -5
Kill = 0

[State -2]
Type = PowerAdd
Trigger1 = Enemy(0),AuthorName = "⑨" && Enemy(0),Name = "Akiha_Vermilion"
Trigger1 = Enemy(0),Var(47) = 1
Trigger2 = NumEnemy = 2
Trigger2 = Enemy(1),AuthorName = "⑨" && Enemy(1),Name = "Akiha_Vermilion"
Trigger2 = Enemy(1),Var(47) = 1
Value = -26

;---------------------------------------------------------------------------
;クリップボード
;---------------------------------------------------------------------------
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "pre=%d, back=%d, life=%d, fv11=%f, fr=%d"
params = prevstateno,backedgebodydist,(100*life/const(data.life)),fvar(11),30-6*((100*life/lifemax)<=80)-6*((100*life/lifemax)<=60)-6*((100*life/lifemax)<=40)-6*((100*life/lifemax)<=20)
ignorehitpause = 1

[State -2, 表示を下に加える]
type = AppendToClipboard
trigger1 = 1
text = "\nP2X=%d/P2Y=%d Vel X=%d/Vel Y=%d Power=%d"
params = floor(P2BodyDist X),floor(P2BodyDist Y),floor(Vel X),floor(Vel Y),Power
ignorehitpause = 1
