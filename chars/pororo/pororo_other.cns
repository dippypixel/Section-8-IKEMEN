
;■リコイルガード■
[Statedef 160]
type = U
movetype = I
physics = N
anim = 150 + (statetype = C) + (statetype = A)*2
ctrl = 0
poweradd = 50

[State 125, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 160, Time_Stop]
type = Pause
trigger1 = time = 0
time = 20
movetime = 20
ignorehitpause = 1

[State 4100, Explod]
type = Explod
trigger1 = Time = 0
anim = 6050
pos = 50-(statetype = C)*4+(statetype = A)*19, -41+(statetype = C)*13+(statetype = A)*4
postype = p1
supermovetime = 9999
pausemovetime = 9999
bindtime = -1
sprpriority = 3
ownpal = 1
ignorehitpause = 1

[State 4100, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 2, 11
ignorehitpause = 1

[State 701, VarSet]
type = NULL
trigger1 = StateType = A
trigger1 = time = 0
trigger1 = fvar(11) := Vel X || 1
trigger1 = fvar(12) := Vel Y || 1
IgnoreHitPause = 1

[State 125, VelSet]
type = VelSet
trigger1 = Time = (StateType = A)
x = 0
y = 0
ignorehitpause = 1

[State 701, VelSet]
type = VelSet
triggerall = StateType = A
trigger1 = Time = 20
x = fvar(11)
y = fvar(12)
ignorehitpause = 1

[State 125, StateTypeSet]
type = StateTypeSet
trigger1 = Time = 20
trigger1 = StateType = A
physics = A
ignorehitpause = 1

[State 701, ChangeState]
type = ChangeState
trigger1 = Time >= 20
value = 161
ignorehitpause = 1

;■リコイルガード硬直■
[Statedef 161]
type = U
movetype = I
physics = U
anim = 150 + (statetype = C) + (statetype = A)*2
velset = ifelse(StateType = A,Vel X,0),Vel Y
ctrl = 0

[State 125, NotHitBy]
type = NotHitBy
trigger1 = time = 0
value = SCA
time = ifelse(statetype=S,1,2)

[State 145, VarSet]
type = CtrlSet
trigger1 = Time = ifelse(statetype=S,1,2)
value = 1

[State 140, 5]
type = ChangeState
trigger1 = time = ifelse(statetype=S,20,22)
value = (statetype = C)*11 + (statetype = A)*51
ctrl = 1


;■回り込み■
[Statedef 500]
type = S
movetype= I
physics = N
anim = 500
velset = 0, 0
ctrl = 0

[State 810, Voice]
type = Playsnd
trigger1 = time = 1
value = 0, 0

[State 810, Push]
type = PlayerPush
trigger1 = AnimElemTime(7) < 0
value = 0

[State 810, HitBy]
type = HitBy
trigger1 = time <= 22
value = SCA, AT

[State 810, Velocity]
type = VelSet
trigger1 = AnimElem = 3
x = 7

[State 810, Velocity]
type = VelSet
trigger1 = AnimElem = 8
x = 0

[State 810, AfterImage]
type = Afterimage
trigger1 = AnimElem = 2
time = 999
length = 10
FrameGap = 3
PalBright = 1,1,1
PalContrast = 128,128,128
PalAdd = 0,0,0
PalMul = .5,.5,.5
trans = add1

[State 810, StateChange]
type = Changestate
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;■AI起動用ヘルパー■
[Statedef 10000]
anim = 9999
ctrl=0

[State 10000,間違いで本体が来たら立ちへ移行]
type=selfstate
trigger1=!ishelper
value=0

[State 10000,プレイヤー判定]
type=varset
trigger1=command="up"&&root,command="up"
trigger2=command="down"&&root,command="down"
trigger3=command="back"&&root,command="back"
trigger4=command="fwd"&&root,command="fwd"
trigger5=command="a"&&root,command="a"
trigger6=command="b"&&root,command="b"
trigger7=command="c"&&root,command="c"
trigger8=command="x"&&root,command="x"
trigger9=command="y"&&root,command="y"
trigger10=command="z"&&root,command="z"
trigger11=command="start"&&root,command="start"
var(59)=-1

[State 10000,立ったら消失]
Type = DestroySelf
triggerAll = isHelper
Trigger1 = root,var(59)||var(59)=-1
trigger2=command="up"&&root,command="up"
trigger3=command="down"&&root,command="down"
trigger4=command="back"&&root,command="back"
trigger5=command="fwd"&&root,command="fwd"
trigger6=command="a"&&root,command="a"
trigger7=command="b"&&root,command="b"
trigger8=command="c"&&root,command="c"
trigger9=command="x"&&root,command="x"
trigger10=command="y"&&root,command="y"
trigger11=command="z"&&root,command="z"
trigger12=command="start"&&root,command="start"

[State 10000,ﾌﾗｸﾞON]
type=varset
triggerall=var(59)!=-1
trigger1=root,command="up"
trigger2=root,command="down"
trigger3=root,command="back"
trigger4=root,command="fwd"
trigger5=root,command="a"
trigger6=root,command="b"
trigger7=root,command="c"
trigger8=root,command="x"
trigger9=root,command="y"
trigger10=root,command="z"
trigger11=root,command="start"
var(59)=1
