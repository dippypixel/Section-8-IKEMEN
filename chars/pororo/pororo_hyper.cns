
;■スロータークライ■
[Statedef 2000]
type = S
movetype= A
physics = S
anim = 2000
velset = 0, 0
ctrl = 0

[State 1100, VarSet]
type = VarSet
triggerall = !var(59)
trigger1 = Time = 0
