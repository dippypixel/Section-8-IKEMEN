
[Statedef -1]
;---------------------------------------------------------------------------
;製作用
;---------------------------------------------------------------------------
[State -1, デバッグ]
type = NULL;ChangeState
triggerall = !var(59)
trigger1 = command = "start"
trigger1 = StateType != A && Ctrl
value = 2100

;---------------------------------------------------------------------------
;超必
;---------------------------------------------------------------------------
[State -1, スロータークライ]
type = ChangeState
value = 2000
triggerall = !var(59)
triggerall = command = "レベル１スロータークライ" || command = "レベル２スロータークライ"
triggerall = power >= 1000
triggerall = statetype != A
triggerall = !NumProj
trigger1 = ctrl || stateno = 40 || (stateno = [100,101])
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

[State -1, ドラッジフィーダー]
type = ChangeState
value = 2100
triggerall = !var(59)
triggerall = command = "レベル１ドラッジフィーダー" || command = "レベル２ドラッジフィーダー"
triggerall = power >= 1000
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101])
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

;---------------------------------------------------------------------------
;必殺
;---------------------------------------------------------------------------

[State -1, キラーハロ]
type = ChangeState
value = 1000
triggerall = !var(59)
triggerall = command = "キラーハロ弱" || command = "キラーハロ強"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101])
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

[State -1, アグレッシブアージ]
type = ChangeState
value = 1400
triggerall = !var(59)
triggerall = command = "アグレッシブアージ弱" || command = "アグレッシブアージ強"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101])
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

[State -1, フレッシュリーバー]
type = ChangeState
value = 1200
triggerall = !var(59)
triggerall = command = "フレッシュリーバー弱" || command = "フレッシュリーバー強"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101])
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

[State -1, リブスブレード]
type = ChangeState
value = 1500
triggerall = !var(59)
triggerall = command = "リブスブレード弱" || command = "リブスブレード強"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101])
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

[State -1, モンスターバイツ]
type = ChangeState
value = 1300
triggerall = !var(59)
triggerall = command = "モンスターバイツ弱" || command = "モンスターバイツ強"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101])
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

[State -1, キラーハロ（空中）]
type = ChangeState
value = 1100
triggerall = !var(59)
triggerall = command = "モンスターバイツ弱" || command = "モンスターバイツ強"
triggerall = statetype = A
trigger1 = ctrl
trigger2 = StateNo = 600 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 610 && (var(36) = 1||var(36) = 2)

;---------------------------------------------------------------------------
;通常・その他
;---------------------------------------------------------------------------
[State -1, ダッシュ]
type = ChangeState
value = 100
triggerall = !var(59)
triggerall = command = "FF"
triggerall = statetype = S
trigger1 = ctrl

[State -1, バックステップ]
type = ChangeState
value = 105
triggerall = !var(59)
triggerall = command = "BB"
triggerall = statetype = S
trigger1 = ctrl

[State -1, 回り込み]
type = ChangeState
value = 500
triggerall = !var(59)
triggerall = command = "回り込み"
triggerall = StateType != A 
trigger1 = ctrl || (stateno = [100,101])

[State -1, 投げ]
type = ChangeState
value = 800
triggerall = !var(59)
triggerall = command = "b"
triggerall = statetype = S
trigger1 = ctrl || (stateno = [100,101])

[State -1, 立ち強攻撃]
type = ChangeState
value = 210
triggerall = !var(59)
triggerall = command = "y"
triggerall = command != "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101])

[State -1, 立ち弱攻撃]
type = ChangeState
value = 200
triggerall = !var(59)
triggerall = command = "x"
triggerall = command != "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101])
trigger2 = stateno = 400 && time > 4

[State -1, しゃがみ強攻撃]
type = ChangeState
value = 410
triggerall = !var(59)
triggerall = command = "y"
triggerall = command = "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101])

[State -1, しゃがみ弱攻撃]
type = ChangeState
value = 400
triggerall = !var(59)
triggerall = command = "x"
triggerall = command = "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101])
trigger2 = stateno = 400 && time > 4

[State -1, 空中強攻撃]
type = ChangeState
value = 610
triggerall = !var(59)
triggerall = command = "y"
triggerall = statetype = A
trigger1 = ctrl

[State -1, 空中弱攻撃]
type = ChangeState
value = 600
triggerall = !var(59)
triggerall = command = "x"
triggerall = statetype = A
trigger1 = ctrl

;---------------------------------------------------------------------------
;超必
;---------------------------------------------------------------------------
[Command]
name = "レベル２スロータークライ"
command = ~D, DF, F, D, DF, F, y
time = 25

[Command]
name = "レベル１スロータークライ"
command = ~D, DF, F, D, DF, F, x
time = 25

[Command]
name = "レベル２ドラッジフィーダー"
command = ~D, DF, F, D, DF, F, b
time = 25

[Command]
name = "レベル１ドラッジフィーダー"
command = ~D, DF, F, D, DF, F, a
time = 25

;---------------------------------------------------------------------------
;必殺
;---------------------------------------------------------------------------
[Command]
name = "キラーハロ強"
command = ~F, D, DF, y

[Command]
name = "キラーハロ弱"
command = ~F, D, DF, x

[Command]
name = "フレッシュリーバー強"
command = ~D, DB, B, y

[Command]
name = "フレッシュリーバー弱"
command = ~D, DB, B, x

[Command]
name = "モンスターバイツ強"
command = ~D, DF, F, y

[Command]
name = "モンスターバイツ弱"
command = ~D, DF, F, x

[Command]
name = "リブスブレード強"
command = ~D, DF, F, b

[Command]
name = "リブスブレード弱"
command = ~D, DF, F, a

[Command]
name = "アグレッシブアージ強"
command = ~F, DF, D, DB, B, y
time = 20

[Command]
name = "アグレッシブアージ弱"
command = ~F, DF, D, DB, B, x
time = 20

;---------------------------------------------------------------------------
;その他
;---------------------------------------------------------------------------
[Command]
name = "回り込み"
command = a+x
time = 1

;---------------------------------------------------------------------------
;キー２回連続入力
;---------------------------------------------------------------------------
[Command]
name = "FF"	;必須コマンド名
command = F, F
time = 10

[Command]
name = "BB"	;必須コマンド名
command = B, B
time = 10

;---------------------------------------------------------------------------
;同時押し
;---------------------------------------------------------------------------
[Command]
name = "recovery"	;必須コマンド名
command = x+y
time = 1

[Command]
name = "recovery"	;必須コマンド名
command = a+b
time = 1

;---------------------------------------------------------------------------
;方向キー＋ボタン
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
;ボタン単発
;---------------------------------------------------------------------------
[Command]
name = "a"
command = a
time = 1

[Command]
name = "b"
command = b
time = 1

[Command]
name = "c"
command = c
time = 1

[Command]
name = "x"
command = x
time = 1

[Command]
name = "y"
command = y
time = 1

[Command]
name = "z"
command = z
time = 1

[Command]
name = "start"
command = s
time = 1

[command]
name="fwd"
command=F
time=1

[command]
name="back"
command=B
time=1

[command]
name="up"
command=U
time=1

[command]
name="down"
command=D
time=1

;---------------------------------------------------------------------------
;方向キー押しっぱなし
;---------------------------------------------------------------------------
[Command]
name = "holdfwd"	;必須コマンド名
command = /$F
time = 1

[Command]
name = "holdback"	;必須コマンド名
command = /$B
time = 1

[Command]
name = "holdup" 	;必須コマンド名
command = /$U
time = 1

[Command]
name = "holddown"	;必須コマンド名
command = /$D
time = 1

