[Info]
Name         = "Ryu mvc1";キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "Ryu mvc1"     ;ゲーム中表示される名前（省略可能）
VersionDate  = 9,18,2010 ;キャラの最終更新日
MugenVersion = 04,14,2002
Author       = "K.Y-Shanxi"      ;このキャラの作成者の名前
Pal.Defaults = 2,3,4,5,6,1    ;CPUで出てくるキャラカラーの順番

[Files]
Sprite	= Ryu.sff		;複数のPCX画像を１パック化したスプライトファイルの登録
Anim	= Ryu.air		;アニメーションファイルの登録
Sound	= Ryu.snd		;複数のWAV音声を１パック化したサウンドファイルの登録

Cmd	= Ryu.cmd    	;入力コマンド定義ファイルの登録
Cns	= Ryu-R.cns	;基本ステータス情報ファイルの登録
Stcommon= common1.cns		;コモン動作プログラムファイルの登録
St	= Ryu-R.cns
St0	= Ryu-S.st
St1	= Ryu-H.st
St2	= Ryu-3.st
St3	= common.cns

