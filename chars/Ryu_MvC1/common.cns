;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1

[State 100]
type = VarSet
trigger1 = Time = 0
trigger1 = Command = "AG"
var(10)= 10

[State 100]
type = Explod
trigger1 = AnimElem = 2,>= 0
trigger1 = AnimElem = 3,< 0
trigger1 = Random > 500
anim = 7020+Random%4
ID = 7020
vel = -3,0
postype = P1
pos = -Random%50,-10-Random%90
bindtime = 1
removetime = -2
sprpriority = 3
ownpal = 1

[State 100, 0]
type = PlaySnd
trigger1 = AnimElem = 1
value = S1,1

[State 100, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)

[State 100, 1]
type = VelMul
trigger1 = Time >= 20
x = .93

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 3] ;Prevent from guarding
type = AssertSpecial
trigger1 = 1
flag = NoStandGuard

[State 100, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
