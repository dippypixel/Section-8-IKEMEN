[Statedef 180]
type = S
ctrl = 0
anim = 180+(Random >= 500)

[State 180];相手が一人のとき
type = null;victoryquote
trigger1 = Numenemy >= 1
trigger1 = EnemyNear,TeamMode = single
trigger1 = time = 0
value = 1+random%7

[State 180];相手が一人でないとき
type = null;victoryquote
trigger1 = Numenemy >= 1
trigger1 = EnemyNear,TeamMode != single
trigger1 = time = 0
value = 3+random%7

[State 180];ケンモード・豪鬼モード専用台詞
type = null;victoryquote
trigger1 = Random >= 300
trigger1 = Var(0) = [1,2]
trigger1 = time = 0
value = 9+Var(0)

[State 180];いい勝負
type = null;victoryquote
trigger1 = Life <= LifeMax*0.3
trigger1 = RoundNo >= 3
trigger1 = time = 0
value = 4

[State 180];余裕勝ち1
type = null;victoryquote
trigger1 = Life >= LifeMax*0.8
trigger1 = Random >= 500
trigger1 = time = 0
value = 5

[State 180];余裕勝ち2
type = null;victoryquote
trigger1 = Life >= LifeMax*0.8
trigger1 = Random < 500
trigger1 = time = 0
value = ifelse((EnemyNear,TeamMode = single),1,9)

[State 180]
type = PlaySnd
trigger1 = Anim = 180
trigger1 = AnimElem = 4
value = 180,0

[State 180]
type = PlaySnd
trigger1 = Anim = 181
trigger1 = AnimElem = 20
trigger1 = RoundNo >= 2 || EnemyNear,TeamMode = Turns
value = 181,0
