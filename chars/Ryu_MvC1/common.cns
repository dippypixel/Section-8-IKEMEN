triggerall = roundsexisted = 0
trigger1 = PalNo = 8
trigger2 = PalNo = 5
trigger3 = PalNo = 2
var(0) = 1

[State 5900, 3] ;Change mode
type = VarSet
triggerall = roundsexisted = 0
trigger1 = PalNo = 9
trigger2 = PalNo = 6
trigger3 = PalNo = 3
trigger4 = PalNo > 10
var(0) = 2

[State 5900, 3] ;Change palette
