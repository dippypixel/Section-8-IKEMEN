trigger1 = Time = 0
var(5) = 0

[State 52, 0]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = PrevStateNo = [1100,1199]
value = 1109

[State 52, 0]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = [1200,1209]
trigger2 = PrevStateNo = [1250,1259]
trigger3 = PrevStateNo = 340
value = 1209

[State 52, 0]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = [1210,1219]
value = 1219

[State 52, 0]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = [1350,1352]
value = PrevStateNo+10

[State 52, 0]
type = PosAdd
triggerall = Time = 0
trigger1 = Anim = [1360,1362]
x = 15

[State 52, 0]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = 2500
value = 2509

[State 52, 0]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = 2600
value = 2609

[State 52, 0]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = [2700,2701]
value = 2709

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = PlaySnd
trigger1 = !IsHelper
trigger1 = Time = 1
value = S52,0

[State 52, 3]
type = CtrlSet
trigger1 = Anim = 47
trigger1 = Time = 1
value = 1

[State 52, 5]
type = PosAdd
trigger1 = AnimTime = 0
trigger1 = Var(6) >= 2
trigger1 = BackEdgeBodyDist < -100
x = -BackEdgeBodyDist-100

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = Var(6) >= 2
trigger1 = BackEdgeBodyDist < 0
value = 100+Var(0)
ctrl = 1

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

