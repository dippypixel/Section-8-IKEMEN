; Intro 1
; CNS difficulty: basic
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 7 && palno != 12
value = S190,0+random%5

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 7 && palno = 12
value = S190,5+random%4

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

