triggerall = Time >= 8
trigger1 = (var(59) = 0) && (Command != "holdy" || Command != "holdb")
trigger2 = (var(59) != 0) && P2bodydist X <= 100 && random < 150 || (var(59) != 0) && P2statetype = A && random < 75 || (var(59) != 0) && P2MoveType!=H && random < 350
trigger3 = power >= powermax
