;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 12 && Anim != 47
trigger2 = Anim != 0 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0
[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0, Helper]
type = Helper
trigger1 = AnimElem = 26
helpertype = normal
name = "EyeGlowFX"
ID = 7000
stateno = 7000
pos = 0,0
postype = p1
supermovetime = 99999
pausemovetime = 99999
[State 0, Helper]
type = Helper
trigger1 = AnimElem = 33
helpertype = normal
name = "ExhaustFX"
ID = 7001
stateno = 7001
pos = 0,0
postype = p1
;supermovetime = 99999
pausemovetime = 16

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 27
value = S2,12
[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 33
value = S2,11

[State 0, 5] ;Are you floating?
type = ChangeState
trigger1 = pos y < 0
value = 50

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = Var(15)
sysvar(1) = 1
[State 40, 3]
type = VarSet
trigger1 = command = "holdback" && !Var(15)
sysvar(1) = -1

[State 40, Var Jump Height]
type = VarSet
trigger1 = Time = 0
v = 2
value = 1
[State 40, Var Jump Height]
type = VarSet
trigger1 = command != "holdup"
;trigger1 = PrevStateNo != 100
v = 2
value = 0

[State 0, Var Buffer Reset]
type = VarSet
trigger1 = Time = 0
v = 6
value = 0
[State 0, Var Buffer 1]
type = VarSet
trigger1 = command = "x"
v = 6
value = 1
[State 0, Var Buffer 2]
type = VarSet
trigger1 = command = "y"
v = 6
value = 2
[State 0, Var Buffer 3]
type = VarSet
trigger1 = command = "z"
v = 6
value = 3
[State 0, Var Buffer 4]
type = VarSet
trigger1 = command = "a"
v = 6
value = 4
[State 0, Var Buffer 5]
type = VarSet
trigger1 = command = "b"
v = 6
value = 5
[State 0, Var Buffer 6]
type = VarSet
trigger1 = command = "c"
v = 6
value = 6

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(var(2)=0,const(velocity.jump.y)*0.75,const(velocity.jump.y))

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

