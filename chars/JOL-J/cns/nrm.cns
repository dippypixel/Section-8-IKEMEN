trigger1 = Var(6) = 3
value = 620
[State 40, Buffer A]
type = ChangeState
triggerall = Time = 0
trigger1 = Var(6) = 4
value = 700
[State 40, Buffer B]
type = ChangeState
triggerall = Time = 0
trigger1 = Var(6) = 5
value = 710
[State 40, Buffer C]
type = ChangeState
triggerall = Time = 0
trigger1 = Var(6) = 6
value = 720

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Vel Y < -8,41,51)

;[State 50, 3]
;type = ChangeAnim
;trigger1 = Vel y > -2
