;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
facep2 = 1
anim = 40
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd" || Var(15)
sysvar(1) = 1
[State 40, 3]
type = VarSet
trigger1 = command = "holdback" && !Var(15)
sysvar(1) = -1

[State 0, VarSet]
type = VarSet
trigger1 = !Time
v = 5
value = 50
[State 0, VarSet]
type = VarSet
trigger1 = command = "a" && !Var(15)
v = 5
value = 600
[State 0, VarSet]
type = VarSet
trigger1 = command = "b" && !Var(15)
v = 5
value = 610 
[State 0, VarSet]
type = VarSet
trigger1 = command = "c" && !Var(15)
v = 5
value = 620

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 3
value = S5,2

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = 5

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = Var(5);50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 0, PlaySnd]
type = PlaySnd
triggerall = Anim = 42 || Anim = 43
trigger1 = AnimElem = 5
trigger2 = AnimElem = 9
trigger3 = AnimElem = 13
trigger4 = AnimElem = 17
value = S5,6
channel = 1

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

;---------------------------------------------------------------------------
; Run
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = 6

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nowalk
flag2 = noautoturn

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
trigger2 = AnimElem = 4
value = S5,6
channel = Time%3

[State 0, Explod]
type = Explod
trigger1 = Time = 0
trigger2 = AnimElem = 3
trigger3 = AnimTime = 0
anim = 6050
pos = -32,0
vel = -2,0
ownpal = 1

[State 100, 4]
type = ChangeState
triggerall = Time >= 3
trigger1 = command != "holdfwd" && !Var(15)
trigger2 = Var(15) && P2BodyDist X <= 4
trigger3 = Var(15) && EnemyNear,MoveType = A
value = 101
ctrl = 1

