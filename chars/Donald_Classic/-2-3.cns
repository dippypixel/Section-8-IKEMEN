;---------------------------------------------------------------------------
; 常時監視ステート（相手に行動を制御されても関係無く常に実行される）
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, 根性値的なもの]
type = defencemulset
triggerall = 1
triggerall = Life <= 250
trigger1 = PalNo != 12
value = 0.8

[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "Var(5)-Button=%d,Pos X=%d,Y=%d"
params = var(5),floor(Pos X),floor(Pos Y)

[State -2, ]
type = CtrlSet
trigger1 = PalNo = 12
trigger1 = movetype = H
trigger1 = Life <= 500
trigger1 = ALIVE
value = 1

[State -2, 無敵解除]
