;タンデム
[State -1, Strong Blasty Spike]
type = ChangeState
value = 2000
triggerall = power >= 1000
triggerall = statetype != A
triggerall = Enemynear, statetype != A
triggerall = Var(59)
triggerall = !var(2)   ;タンデムフラグ
triggerall = !var(3)   ;タンデム使用不可フラグOFF
trigger1 = movehit  
trigger1 = hitdefattr = SC, NA && movecontact 
triggerall = Random < 500


