; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State -3, 空歩中スタンドケージ減る]
type = VarAdd
trigger1 = var(49)
trigger1 = 1
fv = 1
value = -0.23456798

[State 820, ﾋﾟﾁｮﾝ]
type = null;PlaySnd
trigger1 = animelem = 4
trigger2 = animelem = 13
triggerall = Anim = 20 
value = S1, 23

[State 820, ﾋﾟﾁｮﾝ]
type = null;PlaySnd
trigger1 = animelem = 15
trigger2 = animelem = 7
triggerall = Anim = 21
value = S1, 23

[State 3100, 1]
type = StateTypeSet
trigger1 = var(49)
trigger1 = fvar(1) > 0
statetype = A


[State 3100, 1]
type = null;StateTypeSet
trigger1 = var(49)
trigger1 = fvar(1) <= 0
statetype = A
physics = A

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = ifelse(var(33),.5,const(velocity.walk.fwd.x))

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x =  ifelse(var(33),-.4,const(velocity.walk.back.x))

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5 && Anim != 10020 
trigger2 = Anim = 5 && AnimTime = 0
value = ifelse(var(33),10020,20)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5 && Anim != 10021 
trigger2 = Anim = 5 && AnimTime = 0
value = ifelse(var(33),10021,21)

