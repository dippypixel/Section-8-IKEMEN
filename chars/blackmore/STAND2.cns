;;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 3100, 1]
type = StateTypeSet
trigger1 = var(49)
trigger1 = fvar(1) > 0
statetype = A


[State 3100, 1]
type = null;StateTypeSet
trigger1 = var(49)
trigger1 = fvar(1) <= 0
statetype = A
physics = A

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 10000
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = ifelse(var(33),10000,0)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

