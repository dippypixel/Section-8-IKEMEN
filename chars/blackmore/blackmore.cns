;==============================================================================
; Varの使用状況
;==============================================================================
; var(0)  - ランダム変数(勝利イントロ分岐に使用)
; var(1)  - スィませェんフラグ
; var(2)  - タンデムフラグ(設定:1000)
; var(3)  - タンデム使用不可フラグ
; var(4)  - ショートジャンプフラグ
; var(5)  - タンデムキャンセルフラグ
; var(6)  - ヘルパーダメージレジストフラグ
; var(7)  - 永久防止フラグ
; var(8)  - 設置タイプ判定フラグ
; var(10)  - 空中スピニングアンブレラ実施回数カウンタ
; var(11)  - 空中スピニングアンブレラ連打数ストック
; var(33)  - ゾンビモード判定
; var(34)  - 勝ラン記憶
; var(35)  - 負けラン記憶
; var(49) - 空歩判定
; var(59) - AIフラグ

;==============================================================================
; システム関連(fvar)
;==============================================================================
; fvar(1) - スタントゲージ
; fvar(2) - 

[Data]
life = 950
power = 3000
attack = 100
defence = 99
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex = 0
FloatPersistIndex = 0

[Size]
xscale = .998
yscale = 1.02
ground.back = 15
ground.front = 18
air.back = 15
air.front = 15
height = 65
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -6, -105
mid.pos = 8, -72
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 1.87
walk.back = -1.87
run.fwd  = 9, 0
run.back = -10,0
jump.neu = 0,-10.1
jump.back = -2.5
jump.fwd = 3.33
runjump.back = -4.5,-11
runjump.fwd = 4.5,-11
airjump.neu = 0,-9.5
airjump.fwd = 2.9
airjump.back = -2.9

[Movement]
airjump.num = 2
airjump.height = 28
yaccel = .62
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------------------------------------------------------------
; ジャンプ開始
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 2, 2段ジャンプ不可フラグクリア]
type = VarSet
trigger1 = time = 0
var(6) = 0

[State 40, 0]
type = VarSet
trigger1 = time = 0
var(4) = 0

[State 40, ショートジャンプフラグ設定]
type = VarSet
trigger1 = command != "holdup"
var(4) = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 通常ジャンプ]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(4) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, ショートジャンプ]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(4) = 1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -6.9

[State 40, ダッシュからのジャンプ]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, ジャンプ開始ステ終了 - ステート移動]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; ジャンプ中
[Statedef 50]
type    = A
physics = A

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

