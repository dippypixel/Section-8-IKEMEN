x = 0

[State 100, 歩きでない]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, ターンしない]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, ダッシュ終了 - ステート移動]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

