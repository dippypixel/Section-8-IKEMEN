[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0

[State 195, 挑発終了 - ステート移動]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; 回り込み
[Statedef 300]
type    = S
physics = N
anim = 300
velset = 0,0
ctrl = 0

[State 820, 投げ非無敵]
type = HitBy
trigger1 = 1
value = SCA,NT,ST,HT

[State 820, 打撃無敵]
type = NotHitBy
trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP

[State 820, 押さない]
type = PlayerPush
trigger1 = 1
value = 0

[State 820, +10する]
type = PosAdd
