;---------------------------------------------------------------------------
;アドバ
[Statedef 810]
type    = U
movetype = I
ctrl = 0
velset = 0,0

[State 810, アドバ音]
type = PlaySnd
trigger1 = time = 0
value = 10, 12

[State 810, フッフッフッフ]
type = PlaySnd
trigger1 = time = 0
value = 100, 6

[State 810, アドバエフェクト]
type = Explod
trigger1 = time = 0
anim = 20060
pos = ceil(30*const(size.xscale)),-61
postype = p1
bindtime = 99
sprpriority = 4
scale = const(size.xscale),const(size.yscale)

[State 1202, 相手を押す透明ヘルパー発動]
type = helper
trigger1 = time = 0
ID = 811
stateno = 811
pos = 0,0
postyep = p1
bindtime = -1

[State 810, 自身の移動なし]
type = velset
trigger1 = 1
x = 0

[State 810, 2]
type = ChangeAnim
Trigger1 = time >= 0
Trigger1 = statetype = A
value = 152

[State 810, 2]
type = ChangeAnim
Trigger1 = time >= 0
Trigger1 = statetype != A
Trigger1 = command != "holddown"
value = 150

[State 810, 3]
type = ChangeAnim
trigger1 = time >= 0
Trigger1 = statetype != A
Trigger1 = command = "holddown"
value = 151

[State 810, 4]
type = statetypeset
