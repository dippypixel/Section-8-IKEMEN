trigger1 = time <= 1
value = SCA
time = 1

[State 200, アドバンシングガード終了 - ステート移動]
type = ChangeState
Trigger1 = statetype != A
trigger1 = time = 1
value = 151+2*ifelse(!var(59),(command = "holddown"),(EnemyNear,StateType!=A))

;---------------------------------------------------------------------------
; 投げA - 発動
; 基本的に、投げアニメには食らい判定をつけない(投げている最中に攻撃食らうとバグるため)。
; この投げも、800から802までのアニメは全て食らい判定はない。
; また、基本的には投げで与えるダメージはアニメに攻撃判定を作ってhitdefで行う打撃としての
; 攻撃設定ではなく下で出てくる「TargetLifeAdd」で行う。
[Statedef 800]
type = S
movetype = A
physics = N
anim = 800
velset = 0,0
ctrl = 0

[State 850, デストラクション - HitDef定義]
type = HitDef
trigger1 = p2stateno != [130,153]	;ガード中の相手は投げられないという設定トリガ
trigger1 = p2statetype != A		;空中の相手は投げられないという設定(ry
trigger1 = p2movetype != H		;食らいモーション中の相手は投げられない(ry
trigger1 = time = 0
attr = S, NT
hitflag = M
numhits = -1
priority = 2, miss
hitsound = -1
sprpriority = -1
sparkno = -1
snap = 30,0				;投げを食らった瞬間、相手をどの位置に持ってくるかの設定
p2facing = 1				;投げた瞬間に相手が逆を向いていたらこちら側を向かせる設定
p1stateno = 801				;投げが成功した場合、自分の動きをさせるステート
p2stateno = 803				;投げが成功した場合、相手の動きをさせるステート

[State 850, 投げられなかったら終了する]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; 投げA（成功 / 1P制御）
; 投げが成功(statedef 800のhitdefが決まった場合)したら自分のキャラはここに来る。
; ここで投げモーションをさせる。と同時に、相手にダメージを与える。
[Statedef 801]
type = S
movetype = A	;ダメージを与える必要があるのでタイプはA(アタック)を指定する。
physics = N
anim = 801

[State 52, 掴み音]
type = PlaySnd
trigger1 = time = 0
value = S1, 60
ignorehitpause = 1

; 後ろジャンプ後ゆっくり上昇させてみる
[State 851, 上昇]
type = VelSet
trigger1 = time >= 41 && time <= 68
x = -1
y = -1

; 落下前には上昇を停止させる
[State 851, 上昇停止]
type = VelSet
trigger1 = time = 68
x = 0
y = 0

[State 1101, ヒットの瞬間に画面がフラッシュする演出を入れてみる]
type = envcolor
trigger1 = time = 70
time = 2
value = 255,255,255
under = -1
persistent = 0
ignorehitpause=1

[State 200, ガラス生成音]
type = PlaySnd
trigger1 = animelem = 6
value = S1,22

[State 200, ガラス破壊音]
type = PlaySnd
trigger1 = time = 70
value = S1,57
volume = -250
persistent = 0		;「一度しか実行しない」という意味。playsnd以外にも使える

[State 200, 地面から生えるガラス]
type = Explod
triggerall = !NumExplod(804)	;本アニメがすでに表示されている場合は表示しないトリガ。基本的にどのexplodでも入れたほうがいい
trigger1 = animelem = 6
anim = 804
id = 804
pos = 20,30
postype = p1		;1Pの位置を基準に表示する
scale = 1,1.2		;大きさを少し縦長にしてみる(scale=1,1がデフォルトの大きさ)
removeongethit = 1	;攻撃食らったら本アニメを消す。食らい判定がないので食らうことはないが念のため。
ownpal = 1
sprpriority = 2

[State 200, ヒットスパークをExplodで表示]
type = Explod
triggerall = !NumExplod(8202)
trigger1 = time = 70
anim = 8203
id = 8203
pos = 30,-40
postype = p1
removeongethit = 1
ownpal = 1
sprpriority = 3

[State 851, 相手に与えるダメージを設定する]
type = TargetLifeAdd
trigger1 = time = 70
value = -120
; absolute = 1		;←これを有効にすると相手の防御力を無視して必ず120のダメージを与える。

; 落下後、地面に着地した瞬間に地面軸(y = 0)に軸合わせする必要がある。
; これをしないと地面にメリ込んだり、空中に浮いたりする。
; 軸合わせはpossetを使ってy = 0を指定するだけ。
[State 851, 地上に軸合わせ]
type = PosSet
trigger1 = time = 68
y = 0

[State 851, 着地後、ピョンとバックステップさせるためステートを分けたのでそこへ飛ばす]
type = ChangeState
trigger1 = animtime = 0
value = 802

;---------------------------------------------------------------------------
; 投げA成功後のバックステップ
; 801のアニメと802のアニメを全部繋げてしまうと、アニメが長すぎて1つのステート内の記述が
; 膨大になってしまうので攻撃を行うアニメの801、その後バックステップする802のアニメに分割する。
;
; type = Aとphysics = Aとしておけば、地面にバックステップ後
; 地面に着地した時に、勝手に着地専用ステートであるstatedef 52に飛ばされるので
; 着地の制御(「着地したら着地アニメを表示させる」など)をする必要がない。
[Statedef 802]
type = A
physics = A
anim = 802

;このvelset設定だけだと、ずっと上昇していく
[State 851, バックステップの距離と高さ]
type = VelSet
trigger1 = time >= 0
x = -4
y = -8

;velset/veladd/velmulの移動制御系を上手く使えばもっと滑らかに出来るけど
;上手くいかない・・・。使い方が良く分かっていなかったりしたりしなかったりするかもしれない
[State 851, この設定でずっと上昇していくのを防ぐ]
type = VelMul
trigger1 = time >= 4
y = -0.4

;physics = Aと設定しているのでchangestateで着地させる、とする必要はない。

;---------------------------------------------------------------------------
; 投げA（成功 / 相手側制御）
;
; 投げられる側の設定。必ずnothitbyで完全無敵にしておくこと。
;
[Statedef 803]
type = S
movetype = H
velset = 0,0
ctrl = 0

;投げが決まった瞬間は通常の上段のけぞりアニメを表示。69フレームの間
;ずっとこのアニメを表示させる。
[State 852, のけぞりアニメ]
type = changeanim
trigger1 = time >= 0 && time <= 69
value = 5000

[State 852, 攻撃食らい時は下段くらいアニメに変更してみる]
type = changeanim
trigger1 = time >= 70
value = 5011

;相手が逆側を向いていたら振り向かせる。念のため入れているだけ。
[State 852, 振り向き]
type = turn
trigger1 = time = 0
trigger1 = facing = enemy,facing

;特に意味なし
[State 852, カメラ(画面)を固定]
type = screenbound
trigger1 = 1
value = 0
movecamera = 0,0

;これをしないとガクガクする
[State 852, 1]
type = ChangeAnim
trigger1 = 1
value = anim
elem = 1

[State 852, 必須]
type = NotHitBy
trigger1 = 1
value = SCA

;PlayerPushでvalue = 0とすることで相手に押されたり位置がズレるのを防ぐ。
[State 852, 相手に押されない設定]
type = PlayerPush
trigger1 = 1
value = 0

;timeの値は下のSelfStateのtimeと同じにする。
[State 852, 攻撃くらい後吹っ飛ぶ設定]
type = VelSet
trigger1 = time = 81
x = -3
y = -5

; 今まで相手のステートを奪っているのでChangeStateではなく
; SelfStateで相手にコントロールを返してやり、同時に通常落下のアニメ(5050)にする。
[State 852, 16]
type = SelfState
trigger1 = time = 81
value = 5050

