; SUPER MOVES

;---------------------------------------------------------------------------
; Super - Spin Attack
; The basis of this code was snagged from Old Tontwa.
; Still trying to get my footing on this CNS shit :l
; Thank you for helping with the acceleration shiz, Chase <3
[Statedef 1000]
type    = S
movetype= A
physics = N
juggle  = 1
velset = 0,0
ctrl = 0
anim = 1000
sprpriority = 2


[State 182, Explod]
type = Explod
trigger1 = Time = 1
anim = 19500
pos = 0,0
scale = 1.4,1.4
postype = back
sprpriority = -1
ID = 19500
trans = add
alpha = 0,256
removetime = -1

[State 182, ModifyExplod]
type = ModifyExplod
trigger1 = time > 1 && time <= 100
ID = 19500
trans = add
alpha = floor(256*(time+1)/40), 256-floor(256*(time+1)/40)
ignorehitpause = 1

;TONTWA DOES THE COOL THING
[State 1000, SuperPause]
type = SuperPause
trigger1 = Time = 1
time = 30
sound = S10,2
pos = 0,-70
p2defmul = 1
darken = 1
unhittable = 1

[State 0, Helper]
type = Helper
trigger1 = time = 0
helpertype = normal ;player
name = "Tontwa_Spin"
ID = 9002
stateno = 9002
pos = 0,-40
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
pausemovetime = 9999
supermovetime = 9999
ownpal = 0
size.xscale = .7
size.yscale = .7

