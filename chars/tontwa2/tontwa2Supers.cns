[state MAIN PORTRAIT GONE]
type=removeexplod
trigger1= time = 80
id = 9100

[state 0, HELLOOOO~!]
type = playsnd
trigger1 = time = 1
value = s2000,0
volume = 200

[State 0, Hitbox Change to Wide]
type = ChangeAnim
trigger1 = anim!=1001&&abs(vel x) =[100,300]
value = 1001

[State 0, Hitbox Change to Widest]
type = ChangeAnim
trigger1 = anim!=1002&&abs(vel x) >300
value = 1002

[State 1000, you spin me right round baby moment]
type = PlaySnd
trigger1 = time = 1
value = S3000,0
volume = 100
channel = 3
loop = 1

[State 1000, AssertSpecial]
type = AssertSpecial
trigger1 = time = 1
flag = nomusic

[State 0, PowerAdd]
type = PowerAdd
trigger1 = time % 1 = 0
value = -5

[State 0, VelSet]
type = Veladd
trigger1 = command = "holdfwd"
x =  ifelse(vel x < -20,6,1)

;made the accel be from 1 to 6 if they are traveling too fast if they want to turn around quicker
[State 0, VelSet]
type = Veladd
trigger1 = command = "holdback"
x = ifelse(vel x > 20,-6,-1)


[State 0,ScreenBound]
type = ScreenBound
trigger1 = 1
value = 0

[state 1000, Screen Wrap]
type = PosAdd
trigger1 = frontedgedist < -(55+abs(vel x))
x = -(55+abs(vel x)) - backedgedist
;made it so the faster u go, the farther u spawn away from the edge

;also btw, apply abs() to a value is basically 
[state 1000, Screen Wrap]
type = PosAdd
trigger1 = backedgedist < -(55+abs(vel x)) && vel x <0
x = frontedgedist+(55+abs(vel x))

[State 1000, AfterImage]
type = AfterImage
trigger1 = Time = 1
time = -1
length = 20
palcolor = 256
palbright = 0,0,0
palcontrast = 200,200,200
palpostbright = 10,10,10
paladd = 30,0,30
palmul = 0.8,0.8,0.8
timegap = 1
framegap=2
trans = Add ;None, Add1, Sub
ignorehitpause = 1



[State 1000, bgPalFX]
type = bgPalFX
trigger1 = 1
time = 1
add = floor(50*sin(time*0.10)), floor(50*sin(time*0.10+2.094)), floor(50*sin(time*0.10+4.188))
[State 1000, PalFX]
type = PalFX
trigger1 = 1
time = 1
add = floor(128*sin(time*0.10)), floor(128*sin(time*0.10+2.094)), floor(128*sin(time*0.10+4.188))

[State 0, AngleDraw]
type = AngleDraw
trigger1=1
value = vel x=1 


[State 1000, 2]
type = HitDef
trigger1 = ifelse(abs(vel x) <50,time%7 =0,time%2=0)
attr = S, HA
damage = 2
getpower  = 0
animtype = Hard
hitflag = MAF
priority = 3, Hit
pausetime = 0, 1
sparkno = S7300+random%8
sparkxy = -10, -100+random%100
hitsound = s7000,ifelse(abs(vel x) <170,4,1)
guardsound = 6, 0
ground.type = High
ground.slidetime = 20
ground.hittime  = 12+ abs(vel x)
ground.velocity = -vel x*0.05
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -vel x*0.1,-0.5
air.hittime = 12+ abs(vel x)
envshake.time = 4
envshake.freq =100
kill = 0
envshake.ampl = -floor(abs(vel x)/50)


[State 0, AngleDraw]
type = AngleDraw
trigger1 =1
scale = 1+abs(vel x/40) ,1
ignorehitpause = 1
;persistent = 

