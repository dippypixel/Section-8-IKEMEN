;=====================================================================
;---------------------------------------------------------------------
[Statedef -2]
;---------------------------------------------------------------------
;=====================================================================

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "var(3) = %d, var(25) = %d var(21) = %d var(23) = %d var(34) = %d"
params = var(3), var(25), var(21), var(23), var(34)
ignorehitpause = 1


;[State -2, ENOUGH.]
;type = stopsnd
;trigger1 = (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080)
;trigger2 = time = 20
;channel = 16


[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = numexplod(19500)
trigger1 = (stateno!=[3000,3002])
trigger1 = (stateno!=[6000,6003])
trigger1 = (stateno!=[7000,7002])
id = 19500

[state unlock the wall bounce after a certain period of time]
type = varset
triggerall = var(34) = 1
trigger1 = time = 45
v = 34
value = 0


;CONDITIONAL WINQUOTE SHIZZ
; REGULAR QUOTES!!!

[State -2, WinQuoteSet]
type = VictoryQuote
trigger1 = 1
value = 1+random%34

; ANTHONY
[state -2, winquoteset]
type = victoryquote
triggerall = numenemy
triggerall = enemy, authorname = "AnarchyAxel/AwesomeBlue/Giko/year2000k/BakonArmy" || enemy, authorname = "anthony240/SkyScaper24/chaosCreation/year2000k/BakonArmy" || enemy, authorname = "AnarchyAxel/SkyScaper24/chaosCreation/year2000k/BakonArmy"
trigger1 = enemy, name = "Anthony" || enemy, name = "Anthony Small Final Update"
value = 35+random%2

; Tontwa. a.k.a. The actual character himself.
[state -2, WinQuoteSet]
type = VictoryQuote
triggerall = numenemy
trigger1 = enemy, name = "Tontwa"
trigger2 = enemy, authorname = "arikirao"
value = 37+random%3

; CHASE
[state -2, WinQuoteSet]
type = victoryquote
triggerall = numenemy
trigger1 = enemy, name = "CHASE"
trigger2 = enemy, authorname = "Chase2006"
value = 41+random%2

