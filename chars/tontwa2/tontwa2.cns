;[State 0, ModeHud Activate]
;type = Helper
;trigger1 =  !numhelper(10000) 
;helpertype = Normal 
;name = "ModeHud"
;ID = 10000
;stateno = 10000
;pos = 0,0
;postype = p1    ;P2, Front, Back, Left, Right
;keyctrl = 0
;sprpriority = -32

[State 0, PalFX]
type = PalFX
trigger1 = var(3)=1
time = 1
add = 90,50,50
mul = 256,256,256
invertall = 0
color = 210
ignorehitpause = 1
;persistent = 


[State 0, Turn]
type = Turn
trigger1 = prevstateno=220 && p2dist x < 0
trigger2 = prevstateno=221 && p2dist x < 0
;ignorehitpause = 
;persistent = 
[State 0, Turn]
type = velmul
trigger1 = prevstateno=220 && movetype=A
x=.5

[State -2, StopSnd]
type = StopSnd
trigger1 = stateno != 0
trigger1 = stateno != [10,12]
trigger1 = stateno != 20
trigger1 = stateno != 40
trigger1 = stateno != 45
trigger1 = stateno != [50,52]
trigger1 = stateno != 5120
channel = 4


;Thanks for fixing ts, Chase!!!

[State 0, Bang Cooldown]
type = Varset
trigger1 = var(25)&& stateno!=8000&&!numtarget
v = 25    ;fv = 10
value = 0
ignorehitpause=1

[State 0, Bang EX Cooldown]
type = Varadd
trigger1 = var(26)>0&& stateno!=8100
v = 26    ;fv = 10
value = -1
ignorehitpause=1

[State 0, Shove Cooldown]
type = Varadd
trigger1 = var(22)>0&& stateno!=6760
v = 22    ;fv = 10
value = -1
ignorehitpause=1

[State 0, Shove EX Cooldown]
type = Varadd
trigger1 = var(21)>0&& stateno!=6770
v = 21    ;fv = 1
value = -1
ignorehitpause=1

[State 0, Bang Cooldown]
type = Varset
trigger1 = stateno!=221 && !numtarget
v = 23    ;fv = 10
value = 0
ignorehitpause=1

[State 0, VarSet]
type = Varadd
trigger1 = stateno=250&&time=1
v = 3
value = 1

[State 0, VarSet]
type = Varset
trigger1 = 1
v = 3
value = var(3)%2

[State 0, VarSet]
type = Varset
trigger1 = !numtarget && stateno!=220
v = 20    ;fv = 10
value = 0


[State -2, Get Hit Sounds]
type = PlaySnd
triggerall = alive && time = 2
trigger1 = (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080)
trigger1 = enemynear,hitdefattr = SCA,NA,SA,HA
value = S5000,0+(random%10)
;channel = 16 ;Chase, you were right! The channel does not go up to 5000. What a concept!
volume = 255

;=====================================================================
;---------------------------------------------------------------------
; SPECIAL COOLDOWNS
;---------------------------------------------------------------------
;=====================================================================

;SHOVE
[State -2, VarAdd]
type = VarAdd
trigger1 = var(22) > 0
v = 22
value = -1

;SHOVE EX
[State -2, VarAdd]
type = VarAdd
trigger1 = var(21) > 0
v = 21
value = -1

;BANG EX
[State -2, VarAdd]
type = VarAdd
trigger1 = var(26) > 0
v = 26
value = -1


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0