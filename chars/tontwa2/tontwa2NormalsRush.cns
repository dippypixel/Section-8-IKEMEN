;---------------------------------------------------------------------------
;Air Spin (Shoto)
[Statedef 621]
type    = A
movetype= A
physics = N
juggle  = 2
poweradd= 5
ctrl = 0
anim = 620
sprpriority = 2

[State 0, VarSet]
type = VarADD
trigger1 = time=1
v = 23    ;fv = 10
value = 1

[State 0, VelAdd]
type = Velset
trigger1 = AnimElemTime (3) =0 
x=ifelse(command= "holdfwd",6,vel x)
y=ifelse(command= "holddown",2,ifelse(command= "holdup",-3,-2))
[State 0, Y]
type = Velset
trigger1 = AnimElemTime (3) >=0 
trigger1 = AnimElemTime (16) < 0 
y=vel y
[State 0, Gravity]
type = Gravity
trigger1 = AnimElemTime (3) <0 
trigger2 = AnimElemTime (16) >= 0 
;ignorehitpause = 
;persistent = 



[State 220, SFX]
type = PlaySnd
trigger1 = time = 0
value = s220,0
channel=0

[State 220, SFX]
type = PlaySnd
trigger1 = AnimElemTime(3) >= 0
trigger1 = AnimElemTime(16) < 0
value = 200, 0+random%2
channel = 0

[State 220, 2]
type = HitDef
trigger1 = time%2=0
trigger1 = AnimElemTime (3) >=0 
trigger1 = AnimElemTime (16) < 0 
attr = A, NA
animtype  = Heavy
damage    = 4
guardflag = MA
pausetime = 2,2
sparkno = s7202+random%3
sparkxy = -10+random%-20,-70+random%20
hitsound = s7000, 4
guardsound = 6,0
ground.type = high
ground.slidetime = 12
ground.hittime  = 16
ground.velocity = 0,0
air.velocity = 0,0
forcenofall = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = pos y >= vel y && vel y > 0 
value = 52
ctrl = 0

[State 0, CtrlSet]
type = CtrlSet
trigger1 = pos y > -50  && AnimElemTime (14) >=0 
value = 1
;ignorehitpause = 
;persistent = 


