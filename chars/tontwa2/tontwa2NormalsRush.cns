;---------------------------------------------------------------------------
; Stand LP (Rush)
[Statedef 201]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 300                       ;Change animation (Def: no change)
poweradd = 3                     ;Power to add (Def: 0)
sprpriority = 2                  ;Set p1's sprite layering priority to 2 (in front)
[State 0, VelSet]
type = VelSet
trigger1 = prevstateno=8000&&time=1
x = p2dist x/10


[State 300, 1]
type = HitDef
trigger1 = time= 1
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 5                   ;Damage that move inflicts, guard damage
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 6, 6                ;Time attacker pauses, time opponent shakes
sparkno = s7100+random%5                       ;Spark anim no (Def: set above)
sparkxy = -10, -56               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = s7000, 5                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 11             ;Time opponent is in hit state
ground.velocity = -3.75             ;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.4,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 15                 ;Time before opponent regains control in air

[State 300, 1]
type = PlaySnd
trigger1 = time = 1
value = 200, 0+random%3
channel = 0

[State 300, 2]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 300, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Stand SP (Rush)
[Statedef 211]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 15
ctrl = 0
velset = 0,0
anim = 211
sprpriority = -1

[State 0, VelSet]
type = VelSet
trigger1 = prevstateno=201&&time=1
trigger2 = prevstateno=231&&time=6
x = p2dist x/20

[State 210, Width]
type = Width
trigger1 = (AnimElemTime (2) >= 0) && (AnimElemTime (7) < 0)
value = 15,0

[State 210, 1]
type = PlaySnd
trigger1 = Time = 2
value = 0, 4

[State 210, 2]
type = HitDef
trigger1 = AnimElem = 3
attr = S, NA
animtype  = Medium
damage    = 7
guardflag = MA
pausetime = 6,8
sparkno = s7300+random%8 
sparkxy = -10,-70
hitsound = s7000, 1
guardsound = 6,0
ground.type = low
ground.slidetime = 12
ground.hittime  = 16
ground.velocity = -2
air.velocity = -2.5,-4
forcenofall = 1

[State 210, 2]
type = HitDef
trigger1 = AnimElem = 4
attr = S, NA
animtype  = Medium
damage    = 7
guardflag = MA
pausetime = 6,8
sparkno = s7300+random%8 
sparkxy = -10,-70
hitsound = s7000, 1
guardsound = 6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 16
ground.velocity = -6.5
air.velocity = -2.5,-4
forcenofall = 1

[State 210, 1]
type = PlaySnd
trigger1 = animelem = 3
value = 210, 0+random%3
channel = 0

[State 210, 4]
type = SprPriority
trigger1 = AnimElem = 5
value = 2
[State 0, ChangeState]
type = ChangeState
trigger1 = !ailevel
trigger1 = command = "holdup" 
trigger1 = movehit
value = 40
ctrl = 1
;anim =
ignorehitpause = 0

[State 210, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Spin (Rush)
[Statedef 221]
type    = S
movetype= A
physics = S
juggle  = 1
ctrl = 0
anim = 220
poweradd = 3
sprpriority = 2
[State 0, VelSet]
type = VelSet
trigger1 = command = "holdfwd" 
x = 6
persistent=0


[State 0, VarSet]
type = VarADD
trigger1 = time=1
v = 23    ;fv = 10
value = 1


[State 220, SFX]
type = PlaySnd
trigger1 = time = 0
value = s220,0
channel=0

;This shit down here is temporary. I promise.
;...or was it?
[State 220, 2]
type = HitDef
trigger1 = time%2=0
trigger1 = AnimElemTime (3) >=0 
trigger1 = AnimElemTime (10) < 0 
attr = S, NA
animtype  = Heavy
damage    = 4
guardflag = MA
pausetime = 3,3
sparkno = s7202+random%3
sparkxy = -10+random%-20,-70+random%20
hitsound = s7000, 4
guardsound = 6,0
ground.type = high
ground.slidetime = 12
ground.hittime  = 16
ground.velocity = 0,0
air.velocity = -2.5,0
forcenofall = 1

[State 0, TargetBind]
type = TargetBind
trigger1 = AnimElemTime (9) < 0 
trigger1 = movehit 
time = 2
id = -1
pos = p2dist x*0.8,0

[State 0, PlayerPush]
type = PlayerPush
trigger1 = movehit
value = 0

[State 220, SFX]
type = PlaySnd
trigger1 = AnimElemTime(3) >= 0
trigger1 = AnimElemTime(10) < 0
value = 200, 0+random%2
channel = 0

[State 0, VelAdd]
type = VelAdd
triggerall = vel x < 3
trigger1 = AnimElemTime(10) < 0
trigger1 = AnimElemTime(3) >= 0
x = 0.9

[State 0, VelAdd]
type = VelAdd
triggerall = vel x < 7
trigger1 = AnimElemTime(10) < 0
trigger1 = AnimElemTime(3) >= 0
trigger1 = command = "holdfwd"
x = 1


;[State 220, DON'T UNCOMMENT ME. IF YOU UNCOMMENT ME, I'LL DIE. DON'T LET ME DIEEEEE!!!!!!!]
;type = TargetBind
;trigger1 = NumTarget
;pos = -12,-30

[State 220, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1 

