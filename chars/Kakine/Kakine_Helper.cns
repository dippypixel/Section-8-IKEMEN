;セブンスヘルパー
[StateDef 1302]
StateType   = A
Movetype    = A
Physics     = N
Anim        = 1304+ (random %8)
SprPriority = 1
VelSet      = 0,0

[State 960, Color Gradation]
type           = Palfx
trigger1       = time >= 1
add            = 25*(-5-time),25*(-5-time),25*(-5-time)
time = 1
IgnoreHitPause = 1
Persistent = 1

[State -1]
Type     = NotHitBy
Trigger1 = 1
Value    = SAC, NT, ST, HT ,NA, SA, HA ,NP, SP, HP
Time     = 1

[State 40002, Override];カウンター対策
type = HitOverride
trigger1 = 1
attr = SCA,AA
slot = 0
stateno = -1
time = -1
ignorehitpause = 1

[State -1, Hit]
type = HitDef
trigger1          = time = 1
attr              = A, HA
damage            = 18,10
animtype          = Hard
hitflag           = MAF
guardflag         = HA 
priority          = 3, hit
pausetime         = 0,5
sparkno           = s8000
SparkXY           = 0-Random%30, 0-Random%30;0-Random%40, -40-Random%40;
guard.sparkno     = s6005
hitsound          = s1050,1
guardsound        = s120,IfElse((Var(26)=[2,3]),0,10)
ground.type       = High
air.type          = High
numhits           =1
ground.slidetime  = 20
ground.hittime    = 20
ground.velocity   = 0,-8
airguard.velocity = 0,-8
air.velocity      = 0,-8
guard.kill        = 0
kill              = 1
fall              = 1
air.fall          = 1
fall.recover      = 0
envshake.time     = 0
envshake.ampl     = 0
envshake.freg     = 0
getpower          = 0,0

[State -1]
Type     = DestroySelf
Trigger1 =Time = 10 

