[Statedef 30001]
anim = 9999;アニメなし

[State 30001];
type = ScreenBound
trigger1 = 1
value = 0
;movecamera = 1,0

[State 30001,タイマー1]
 type = ParentVaradd
trigger1 = (GameTime%5)=0
var(21) = -6
;	ignorehitpause = 1

[State 30001,タイマー1]
type = ParentVaradd
trigger1 = Parent,movetype = H
trigger1 = (GameTime%5)=0
var(21) = -9
ignorehitpause = 1

[State 30001,タイマー3]
type = ParentVaradd
triggerAll = RoundState = 2
trigger1 = Parent,var(14) = 1
fvar(21) = 0.000185
ignorehitpause = 1

[state 30001 , タイマー最低値]
type = ParentVarSet
trigger1 = Parent,var(21) < 1
var(21) = 0

[state 30001 , バースト使用可能]
type = ParentVarSet
trigger1 = Parent,var(14) != 0
trigger1 = Parent,fvar(21) > 0.5
var(14) = 0

[state 30001 , バーストゲージ初期化]
type = ParentVarSet
trigger1 = Parent,var(14) = 0
trigger1 = Parent,fvar(21) != 0
fvar(21) = 0

