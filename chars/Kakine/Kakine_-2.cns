;===========================================================================
; 常時監視ステート（－２）
;===========================================================================

[Statedef -2]

[State -2, 変数];板投げ用
type = VarSet
trigger1 = (StateNo != 1300)
var(5) = 0

;-----------------------------------
;ここは「パワー溜め」のステートで発生させた「Explod」のエフェクト画像を
;特定の条件が有効になれば消す、という処理をしています。

[State -2, エフェクトを消す];パワー溜めステート用
type = RemoveExplod
triggerall = NumExplod(130) > 0
                          ;↑はＩＤナンバー「130」のExplodの画面中の数が0よりも多い、
                          ;つまり１枚以上表示されている時
trigger1 = StateNo != 700 ;ステートが７００（パワー溜め）以外の時
trigger2 = MoveType != I  ;MoveTypeが「I（何もしてない）」以外の時
ID = 130                  ;消すExplodの特定のＩＤナンバーを指定



;-----------------------------------
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "Cancel=%d, Throw=%d, Button=%d, Body-Distance X=%d,Y=%d \n"
params = var(1),var(2),var(5),floor(P2BodyDist X),floor(P2BodyDist Y)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Position X=%d,Y=%d, Velocity X=%f,Y=%f, Hit=%d \n"
params = floor(Pos X),floor(Pos Y),(Vel X),(Vel Y),(MoveHit)

;===========================================================================

[State -2];バーストアイコンy軸
	type = Varset
	trigger1 = Numhelper(30000) = 0
	var(33) = 0;デフォルトは0 +方向で下に

[State -2];バーストアイコンx軸
	type = Varset
	trigger1 = Numhelper(30000) = 0
	var(34) = 0;デフォルトは0 -方向で中央に

;===========================================================================
;特殊システム
;===========================================================================
;---------------------------------------------------------------------------
;電池ゲージ
;---------------------------------------------------------------------------
[State -2];ダークマターゲージ上限
Type= Varset
Trigger1= var(3) >1000
var(3)=1000

[State -2];ダークマターゲージ下限
Type= Varset
Trigger1= var(3) < 0
var(3)=0

[State -2];ゲージ呼び出し
type = Helper
triggerAll = !var(18)
trigger1 = time = 1
trigger1 = Numhelper(9999) = 0
stateno = 9999
ID = 9999
pos = 0,0
postype = left
helpertype = normal
name = "gauge"
keyctrl = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999

[State -2];ゲージ回復
Type= VarAdd
TriggerAll= var(3) =[0,1001]
trigger1 = 1
var(3)=1

[State -2];ゲージ減少
Type= VarAdd
TriggerAll= var(3) =[0,1001]
trigger1 = MoveType = H
trigger1 = time = 1
var(3)=-15

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 950
value = 0.5

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 900 && var(3) <= 949
value = 0.6

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 800 && var(3) <= 899
value = 0.65

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 700 && var(3) <= 799
value = 0.7

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 600 && var(3) <= 699
value = 0.74

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 500 && var(3) <= 599
value = 0.78

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 400 && var(3) <= 499
value = 0.82

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 300 && var(3) <= 399
value = 0.86

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 200 && var(3) <= 299
value = 0.9

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) >= 100 && var(3) <= 199
value = 0.94

[State -2, 0]
type = DefenceMulSet
trigger1 = var(3) <= 99
value = 0.98


[State -2, 0]
type = AttackMulSet
trigger1 = var(3) <= 199
value = 1.3

[State -2, 0]
type = AttackMulSet
trigger1 = var(3) >= 200 && var(3) <= 299
value = 1.25

[State -2, 0]
type = AttackMulSet
trigger1 = var(3) >= 300 && var(3) <= 399
value = 1.2

[State -2, 0]
type = AttackMulSet
trigger1 = var(3) >= 400 && var(3) <= 499
value = 1.15

[State -2, 0]
type = AttackMulSet
trigger1 = var(3) >= 500
value = 1.0

[State -2];
type = Varset
trigger1 = StateNo = 6300 && AnimElemtime(5) = 0;
trigger2 = StateNo = 6350 && AnimElemtime(5) = 0;	
var(14) = 1

[State -2];タイマー呼び出し
type = Helper
triggerAll = Numhelper(30001) = 0
trigger1 = time = 1
stateno = 30001
ID = 30001
pos = 0,0
postype = left
helpertype = normal
name = "timers"
keyctrl = 0
ownpal = 1
pausemovetime = 1
supermovetime = 1

;===========================================================================
;ステート奪われ判断
;===========================================================================

[State -2, gametime];-2ステートへ置く
Type=varset
Trigger1 = var(49) != Gametime
var(49) = -1
ignorehitpause=1 ;Var(49)=-1でステート奪われ状態の認識。

;--------------------------------------------------------

;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;-----------------------------------
;ここは「ジャンプ」か「バックステップ」をした後に
;着地する音を鳴らす設定をしています。

[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
value = 40, 0

[State -3, 音を鳴らす]
type =   Varset
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
var(10) =   0 
      
[State -3, gametime];-3ステートへ置く
Type=null
Trigger1 = var(49) := Gametime
ignorehitpause=1 ;Var(49)= Gametimeでステート奪われてない状態の認識。



;---------------------------------------------------------------------------