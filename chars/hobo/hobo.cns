trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3


[State 0, VelAdd]
type = VelAdd
trigger1 = !aiLevel && (stateno != [1000, 3999]) && (stateno != [120,155]) && stateno != 55 && statetype = A && physics = A && movetype != H && command = "holdfwd" && vel x < ifelse(power=powermax,const(velocity.jump.fwd.x)*map(speedBuff),const(velocity.jump.fwd.x))
x = map(airAccel)*map(airAccelBuff)

[State 0, VelAdd]
type = VelAdd
trigger1 = !aiLevel && (stateno != [1000, 3999]) && (stateno != [120,155]) && stateno != 55 && statetype = A && physics = A && movetype != H && command = "holdback" && vel x > ifelse(power=powermax,const(velocity.jump.back.x)*map(speedBuff),const(velocity.jump.back.x))
x = -map(airAccel)*map(airAccelBuff)

