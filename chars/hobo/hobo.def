; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "HoboVV"        ;Name of character
displayname = "Hobo alpha build" ;Name of character to display
versiondate = 09,30,2009    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.1
ikemenversion = 0.99.2
author = "guymbagoomba, Usher11, arikirao, Chase2006"         ;Character author name
pal.defaults = 1,2,3,4

; Files for the player
[Files]
cmd     = hobo.cmd           ;Command set
cns     = hobo.cns           ;Constants
st      = hobo.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = hobo.sff           ;Sprite
anim    = hobo.air           ;Animation
sound   = hobo.snd           ;Sound
ai      = hobo.ai            ;AI hints data (not used)
movelist = movelist.dat     ;Ikemen feature: Movelist

[Palette Keymap]
a = 1
b = 2
c = 3
x = 4
y = 5
z = 6
a2 = 7
b2 = 8
c2 = 9
x2 = 10
y2 = 11
z2 = 12

[Map]
partOfTheGang = 1

defenceBuff = 1.1
attackBuff = 1
speedBuff = 1.1
airAccelBuff = 1
specialRecharge = 360  ;Kick
specialRecharge2 = 300 ;Anti-air
specialRecharge3 = 240 ;Projectile
numSpecials = 3
wallClingOffset = 154
airAccel = .65
landVoiceClips = 0
hasAltRetroSprite = 1
maxPal = 12

numTagInLines = 4

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
