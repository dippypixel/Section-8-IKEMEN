[Command]
name = "holdfwd"	;必須コマンド名
command = /$F
time = 1

[Command]
name = "holdback"	;必須コマンド名
command = /$B
time = 1

[Command]
name = "holdup"	;必須コマンド名
command = /$U
time = 1

[Command]
name = "holddown"	;必須コマンド名
command = /$D
time = 1

