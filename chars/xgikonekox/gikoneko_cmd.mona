[Command]
name = "上段当て身投げ"
command = ~F, DF, D, DB, B, x
time = 20

[Command]
name = "中段当て身投げ"
command = ~F, DF, D, DB, B, y
time = 20

[Command]
name = "下段当て身投げ"
command = ~F, DF, D, DB, B, a
time = 20

[Command]
name = "裏雲隠し"
command = ~F, DF, D, DB, B, b
time = 20

[Command]
name = "邪影拳強"
command = ~B, DB, D, DF, F, y
time = 20

[Command]
name = "邪影拳弱"
command = ~B, DB, D, DF, F, x
time = 20

[Command]
name = "飛翔日輪斬強"
command = ~F, D, DF, y

[Command]
name = "飛翔日輪斬弱"
command = ~F, D, DF, x

[Command]
name = "フェイント烈風拳"
command = ~D, DF, F, s

[Command]
name = "ダブル烈風拳"
command = ~D, DF, F, y

[Command]
name = "烈風拳"
command = ~D, DF, F, x

[Command]
name = "ダブル疾風拳"
command = ~D, DB, B, y

[Command]
name = "疾風拳"
command = ~D, DB, B, x

[Command]
name = "雷鳴豪破投げ"
command = DF, y

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;その他
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Command]
name = "避け"
command = a+x
time = 1

[Command]
name = "longjump"
command = D, $U
time = 18

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;キー２回連続入力
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Command]
name = "FF"	;必須コマンド名
command = F, F
time = 10

[Command]
name = "BB"	;必須コマンド名
command = B, B

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;同時押し
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Command]
name = "recovery"	;必須コマンド名
command = x+y
time = 1

[Command]
name = "recovery"	;必須コマンド名
command = a+b
time = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
