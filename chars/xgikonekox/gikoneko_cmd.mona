
[Statedef -1]
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;製作用
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, デバッグ]
type = NULL;ChangeState
triggerall = !var(59) 
trigger1 = command = "start"
trigger1 = StateType != A && Ctrl
value = 1700

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;超必
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, レイジングストーム]
type = ChangeState
value = 3000
triggerall = !var(59)
triggerall = (command = "レベル１レイジングストーム" && power >= 1000) || (command = "レベル２レイジングストーム" && power >= 2000) || (command = "サンダーブレイク" && power >= 3000)
triggerall = statetype != A
triggerall = !numproj
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 羅生門]
type = ChangeState
value = 3100
triggerall = !var(59)
triggerall = command = "羅生門"
triggerall = power >= 3000
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, デッドリーレイブ]
type = ChangeState
value = 3300
triggerall = !var(59)
triggerall = command = "デッドリーレイブ"
triggerall = power >= 3000
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, レイジングデッドエンド]
type = ChangeState
value = 3400
triggerall = !var(59)
triggerall = !var(32)
triggerall = command = "レイジングデッドエンド"
triggerall = power >= 3000
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 虚空烈風斬]
type = ChangeState
value = 3200
triggerall = !var(59)
triggerall = (command = "虚空烈風斬" && power >= 1000) || (command = "阿修羅疾風拳" && power >= 2000)
triggerall = statetype != A
triggerall = !numproj
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;必殺
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, 下段当て身投げ]
type = ChangeState
value = ifelse(!var(32),1700,3410)
triggerall = !var(59)
triggerall = command = "下段当て身投げ"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 中段当て身投げ]
type = ChangeState
value = ifelse(!var(32),1600,3410)
triggerall = !var(59)
triggerall = command = "中段当て身投げ" || command = "裏雲隠し"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 上段当て身投げ]
type = ChangeState
value = ifelse(!var(32),1500,3410)
triggerall = !var(59)
triggerall = command = "上段当て身投げ"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 飛翔日輪斬]
type = ChangeState
value = 1800
triggerall = !var(59)
triggerall = command = "飛翔日輪斬弱" || command = "飛翔日輪斬強"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 邪影拳]
type = ChangeState
value = 1400
triggerall = !var(59)
triggerall = command = "邪影拳弱" || command = "邪影拳強"
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 疾風拳]
type = ChangeState
value = 1300
triggerall = !var(59)
triggerall = !var(5)
triggerall = command = "疾風拳" || command = "ダブル疾風拳"
triggerall = statetype = A
triggerall = !numproj
trigger1 = ctrl || var(7)
trigger2 = var(11) = [1,3]

[State -1, 烈風拳]
type = ChangeState
value = 1200
triggerall = !var(59)
triggerall = command = "烈風拳" || command = "ダブル烈風拳" || command = "フェイント烈風拳"
triggerall = statetype != A
triggerall = !numproj
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)
trigger2 = var(11) = [1,3]

[State -1, 雷鳴豪破投げ]
type = ChangeState
value = 1900
triggerall = !var(59)
triggerall = command = "雷鳴豪破投げ"
triggerall = statetype != A
triggerall = p2bodydist X = [-10,15]
triggerall = p2statetype = L
triggerall = p2stateno != 5120
trigger1 = ctrl || stateno = 40 || (stateno = [100,101]) || var(7)

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;通常・その他
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, ダッシュ]
type = ChangeState
value = 100
triggerall = !var(59)
triggerall = command = "FF"
triggerall = statetype = S
trigger1 = ctrl

[State -1, バックステップ]
type = ChangeState
value = 105
triggerall = !var(59)
triggerall = command = "BB"
triggerall = statetype = S
trigger1 = ctrl

[State -1, 回り込み]
type = ChangeState
value = 500
triggerall = !var(59)
triggerall = command = "避け" && command = "holdfwd"
triggerall = StateType != A
trigger1 = ctrl || (stateno = [100,101])

[State -1, 避け]
type = ChangeState
value = 550
triggerall = !var(59)
triggerall = command = "避け"
triggerall = StateType != A 
trigger1 = ctrl || (stateno = [100,101])

[State -1, カウンター攻撃強]
type = ChangeState
value = 570
triggerall = !var(59)
triggerall = command = "y"
triggerall = StateType != A 
trigger1 = stateno = 550 && time = [15,25]

[State -1, カウンター攻撃弱]
type = ChangeState
value = 560
triggerall = !var(59)
triggerall = command = "x"
triggerall = StateType != A 
trigger1 = stateno = 550 && time = [15,25]

[State -1, 投げ]
type = ChangeState
value = 800
triggerall = !var(59)
triggerall =  command = "x" && (command = "holdfwd" || command = "holdback")
triggerall = statetype = S
triggerall = p2bodydist X = [-10,20]
triggerall = p2statetype != A
triggerall = p2movetype != H
trigger1 = ctrl

[State -1, 不動活殺裏拳]
type = ChangeState
value = 1000
triggerall = !var(59)
triggerall = command = "x" && command != "holddown" && command = "holdfwd"
triggerall = StateType != A
trigger1 = ctrl || (stateno = [100,101]) || var(7)

[State -1, 飛燕失脚]
type = ChangeState
value = 2000
triggerall = !var(59)
triggerall = command = "y" && command != "holddown" && command = "holdfwd"
triggerall = StateType != A
trigger1 = ctrl || (stateno = [100,101]) || var(7)
trigger2 = var(11) = 2

[State -1, 雷光回し蹴り]
type = ChangeState
value = 1100
triggerall = !var(59)
triggerall = command = "y" && command != "holddown" && command = "holdback"
triggerall = StateType != A
trigger1 = ctrl || (stateno = [100,101]) || var(7)
trigger2 = var(11) = 2

[State -1, 立ち強攻撃]
type = ChangeState
value = 210
triggerall = !var(59)
triggerall = command = "y"
triggerall = command != "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101]) || var(7)

[State -1, 立ち弱攻撃]
type = ChangeState
value = 200
triggerall = !var(59)
triggerall = command = "x"
triggerall = command != "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101]) || var(7)
trigger2 = var(11) = 1

[State -1, しゃがみ強攻撃]
type = ChangeState
value = 410
triggerall = !var(59)
triggerall = command = "y"
triggerall = command = "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101]) || var(7)

[State -1, しゃがみ弱攻撃]
type = ChangeState
value = 400
triggerall = !var(59)
triggerall = command = "x"
triggerall = command = "holddown"
triggerall = statetype != A
trigger1 = ctrl || (stateno = [100,101]) || var(7)
trigger2 = var(11) = 1

[State -1, 空中強攻撃]
type = ChangeState
value = 610
triggerall = !var(59)
triggerall = command = "y"
triggerall = statetype = A
trigger1 = ctrl || var(7)

[State -1, 空中弱攻撃]
type = ChangeState
value = 600
triggerall = !var(59)
triggerall = command = "x"
triggerall = statetype = A
trigger1 = ctrl || var(7)

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;超必
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Command]
name = "デッドリーレイブ"
command = ~F, DF, D, DB, B, F, x
time = 30

[Command]
name = "レイジングデッドエンド"
command = ~F, B, DB, D, DF, F, y
time = 30

[Command]
name = "羅生門"
command = ~F, $D, B, F, $D, B, x
time = 30

[Command]
name="サンダーブレイク"
command = ~DB, F, $D, B, DF, a
time = 35

[Command]
name="レベル２レイジングストーム"
command = ~DB, F, $D, B, DF, y
time = 35

[Command]
name="レベル１レイジングストーム"
command = ~DB, F, $D, B, DF, x
time = 35

[Command]
name = "阿修羅疾風拳"
command = ~D, DF, F, D, DF, F, y
time = 25

[Command]
name = "虚空烈風斬"
command = ~D, DF, F, D, DF, F, x
time = 25

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
