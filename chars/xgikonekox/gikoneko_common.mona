
;■通常立ち■
[Statedef 0]
type = S
physics = S
velocity = 0, 0
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != var(32) && Anim != 2 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = var(32)

[State 0, 1]
type = ChangeAnim
trigger1 = time = 600
trigger1 = anim != 2
value = 2

[State 0, 4]
type = ChangeState
trigger1 = !alive
value = 5050

;■歩き■
[Statedef 20]
type = S
physics = S
ctrl = 1
sprpriority = 0

[State 20, 1]
type = changestate
triggerall = var(59)
trigger1 = time = 0
value = 0
ctrl = 1
ignorehitpause = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21
value = 21

;■ＡＩ用歩き■
[Statedef 21]
type = S
physics = N
velset = 0, 0
ctrl = 0
sprpriority = 0

[State 20, 1]
type = Turn
trigger1 = P2dist X < 0

[State -1, VarSet]
type = VarSet
trigger1 = time = 0
var(57) = 0

[State -1, VarSet]
type = VarSet
triggerall = time = 0
trigger1 = random <= 333
trigger2 = frontedgebodydist <= 30
trigger3 = p2bodydist x < 50
var(57) = -1

[State -1, VarSet]
type = VarSet
triggerall = time = 0
trigger1 = backedgebodydist <= 30
var(57) = 1

[State 20, VelSet]
Type = VelSet
Trigger1 = time = 0
x = ifelse(var(57) = -1, const(velocity.walk.back.x), const(velocity.walk.fwd.x))

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21
value = 21

[State 20, 4]
type = changestate
trigger1 = time > 20
trigger1 = P2bodydist x <= 20 && anim = 20
trigger2 = time > 20
trigger2 = P2bodydist x >= 150 && anim = 21
trigger3 = time > 25
trigger3 = frontedgebodydist <= 30 || backedgebodydist <= 30
trigger4 = inguarddist
trigger5 = roundstate != 2
value = 0
ctrl = 1

;■ジャンプ開始■
[Statedef 40]
type = S
physics = S
anim = 40
velset = 0, 0
ctrl = 0

[State 20, 1]
type = changestate
triggerall = var(59)
trigger1 = time = 0
value = 0
ctrl = 1
ignorehitpause = 1

[State 40, HitBy]
type = HitBy
trigger1 = 1
value = SCA, AA, AP

[State 40, 1]
type = NULL
trigger1 = Time = 0
trigger1 = var(4) := 0 || 1
trigger1 = var(5) := 0 || 1

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = command = "holdfwd"-command = "holdback"

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = (PrevStateNo = [100,101]) && sysvar(1) = 1
trigger2 = Command = "longjump"
var(4) = 1

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(5) = 1

[State 40, 6]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, (const(velocity.jump.fwd.x)*!var(4)+const(velocity.runjump.fwd.x)*var(4)), (const(velocity.jump.back.x)*!var(4)+const(velocity.runjump.back.x)*var(4))))
y = ifelse(var(4) && !sysvar(1), const(velocity.jump.y)*1.15*ifelse(!var(5),1,.75), const(velocity.jump.y)*ifelse(!var(5),1,.75))

[State 52, Effect]
type = PlaySnd
triggerall = AnimTime = 0
trigger1 = !var(4) && !var(5)
trigger2 = var(4) && var(5)
value = 0, 3

[State 52, Effect]
type = PlaySnd
triggerall = AnimTime = 0
trigger1 = var(4) && !var(5)
value = 0, 4

[State 52, Effect]
type = PlaySnd
triggerall = AnimTime = 0
trigger1 = !var(4) && var(5)
value = 0, 5

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

