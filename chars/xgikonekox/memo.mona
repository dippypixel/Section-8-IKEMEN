━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
立ち回り
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
雷光回し蹴りと屈み強を中心に立ち回る
根元が当てると不利になるので先端が当たる距離をキープする
単調にならないように烈風拳も選択肢に入れておく
近距離は立ち強弱・屈み弱からコンボを狙う
遠距離では烈風拳・疾風拳を撒いて牽制

起き攻めはＪ強の表裏二択
中・遠距離では相手の起き上がりに烈風拳が重なるように出しておく

飛び込みは表裏二択Ｊ強と対対空の疾風拳
または小ＪからＪ弱

対空にはレイジングストーム・上段当身投げ
コマンド・タイミングが難しいので無理をせずガードを固めたり
前転で早めにかわしていくのも重要

デッドリーレイブはガードされても有利なので積極的に狙う

当て身投げのタイミング
・相手が手を出したくなるような状況をわざと作り、相手の攻撃を誘う
相手が有利になる通常攻撃をガードさせて＞当て身
隙の大きな技を空振ってから＞当て身
・相手の起き攻め・リバーサルを先読みして返す
・相手の連繋を先読みして返す

レイジングデッドエンドを発動しておけば全ての打撃を掴めるようになるので
相手へのプレッシャーになる

