trigger2 = StateNo = 210 && (var(0) = [1,2])
trigger3 = StateNo = 400
trigger4 = StateNo = 410 && (var(0) = [1,2])
trigger5 = StateNo = 560 && (var(0) = [1,2])
var(11) = 2
ignorehitpause = 1

[State -2, 連打キャンセル]
type = varset
trigger1 = StateNo = 200 && Time > 4
trigger2 = StateNo = 400 && Time > 4
var(11) = 1
ignorehitpause = 1

[State -2, 特殊技キャンセル]
type = varset
trigger1 = StateNo = 1000 && (var(0) = [1,2])
var(11) = 3
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;専用記述
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;■神尾観鈴（586氏）■
;「不幸の塊」「観鈴ちんピンチ！」
[State -2, LifeAdd]
type = LifeAdd
trigger1 = Enemy(0),AuthorName = "586"
trigger1 = Enemy(0),Name = "Misuzu Kamio"
trigger1 = Enemy(0),fvar(11) > 0
trigger1 = GameTime%(((Enemy(0),var(13)=1)*13)+((Enemy(0),var(13)=2)*11)+((Enemy(0),var(13)=3)*8)+((Enemy(0),var(13)=4)*6)+((Enemy(0),var(13)=5)*3)) = 0
value = -1
kil = -1
ignorehitpause = 1

[State -2, LifeAdd]
type = LifeAdd
trigger1 = NumEnemy = 2
trigger1 = Enemy(1),AuthorName = "586"
trigger1 = Enemy(1),Name = "Misuzu Kamio"
trigger1 = Enemy(1),fvar(11) > 0
trigger1 = GameTime%(((Enemy(1),var(13)=1)*13)+((Enemy(1),var(13)=2)*11)+((Enemy(1),var(13)=3)*8)+((Enemy(1),var(13)=4)*6)+((Enemy(1),var(13)=5)*3)) = 0
value = -1
kil = -1
ignorehitpause = 1

[State -2, PalFX]
type = PalFX
trigger1 = Enemy(0),AuthorName = "586"
trigger1 = Enemy(0),Name = "Misuzu Kamio"
trigger1 = Enemy(0),fvar(11) > 0
trigger2 = NumEnemy = 2
trigger2 = Enemy(1),AuthorName = "586"
trigger2 = Enemy(1),Name = "Misuzu Kamio"
trigger2 = Enemy(1),fvar(11) > 0
add = -50,150,150
time = 1
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;■赤主秋葉（⑨氏）■
;「獣を焦がす」「疾駆する獣を焦がす」
[State -2]
Type = LifeAdd
Trigger1 = Enemy(0),AuthorName = "⑨" && Enemy(0),Name = "Akiha_Vermilion"
Trigger1 = Enemy(0),Var(47) = 1
Value = -5
Kill = 0

[State -2]
Type = LifeAdd
Trigger1 = NumEnemy = 2
Trigger1 = Enemy(1),AuthorName = "⑨" && Enemy(1),Name = "Akiha_Vermilion"
Trigger1 = Enemy(1),Var(47) = 1
Value = -5
Kill = 0

[State -2]
Type = PowerAdd
Trigger1 = Enemy(0),AuthorName = "⑨" && Enemy(0),Name = "Akiha_Vermilion"
Trigger1 = Enemy(0),Var(47) = 1
Value = -26

[State -2]
Type = PowerAdd
Trigger1 = NumEnemy = 2
Trigger1 = Enemy(1),AuthorName = "⑨" && Enemy(1),Name = "Akiha_Vermilion"
Trigger1 = Enemy(1),Var(47) = 1
Value = -26

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;■西行寺幽々子（祇園城奏貴氏）■
;「霊符「无寿の夢」」「寿命「无寿国への約束手形」」
[State -2, LifeAdd]
Type = LifeAdd
Trigger1 = Enemy(0),AuthorName = "Souki" && Enemy(0),Name = "Yuyuko Saigyouji"
Trigger1 = Enemy(0),Var(3) = 1 || Enemy(0),Var(3) = 2
Trigger1 = GameTime%6 = 0
Value = IfElse(Enemy(0),Var(3) = 1,-2,-3)
Kill = 0

[State -2, LifeAdd]
Type = LifeAdd
Trigger1 = NumEnemy = 2
Trigger1 = Enemy(1),AuthorName = "Souki" && Enemy(1),Name = "Yuyuko Saigyouji"
Trigger1 = Enemy(1),Var(3) = 1 || Enemy(1),Var(3) = 2
Trigger1 = GameTime%6 = 0
Value = IfElse(Enemy(1),Var(3) = 1,-2,-3)
Kill = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;■廿楽冴姫/朱鷺宮神依/フィオナ・メイフィールド（ドロウィン氏）■
;「アンプゾワネ」「アバトワール」
[state -2]
type = poweradd
triggerall = power > 0
trigger1 = enemy(0),authorname = "Drowin arcana"
trigger1 = enemy(0),fvar(20) > 0
value = -1

[state -2]
type = poweradd
triggerall = power > 0
trigger1 = numenemy = 2
trigger1 = enemy(1),authorname = "Drowin arcana"
trigger1 = enemy(1),fvar(20) > 0
value = -1

[state -2]
type = lifeadd
triggerall = gametime % 7 = 0
trigger1 = enemy(0),authorname = "Drowin arcana"
trigger1 = enemy(0),fvar(20) > 0
value = -1
kill = 0

[state -2]
type = lifeadd
triggerall = gametime % 7 = 0
trigger1 = numenemy = 2
trigger1 = enemy(1),authorname = "Drowin arcana"
trigger1 = enemy(1),fvar(20) > 0
value = -1
kill = 0
			
[state -2]
type = Palfx
trigger1 = enemy(0),authorname = "Drowin arcana"
trigger1 = enemy(0),fvar(20) > 0
trigger2 = numenemy = 2
trigger2 = enemy(1),authorname = "Drowin arcana"
trigger2 = enemy(1),fvar(20) > 0
add = 100,0,110
mul = 220,220,220
time = 5
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;■小野塚小町（水影氏）■
;「脱魂の儀」
;振り向き抑制
[State pos moving]
type = AssertSpecial
Triggerall = (Enemynear(var(58)),Name = "Komachi Onoduka")*(Enemynear(var(58)),AuthorName = "mikage_th105")*(TeamMode = single)
trigger1 = (enemynear(var(58)),stateno = 820)*(enemynear(var(58)),anim = 823)*(enemynear(var(58)),animelem = 6,13)
trigger2 = (enemynear(var(58)),stateno = 821)*(enemynear(var(58)),anim = 823)*(enemynear(var(58)),animelem = 6,43)
flag = noautoturn

;移動
[State pos moving]
type = Posadd
Triggerall = (Enemynear(var(58)),Name = "Komachi Onoduka")*(Enemynear(var(58)),AuthorName = "mikage_th105")*(TeamMode = single)
trigger1 = (enemynear(var(58)),stateno = 820)*(enemynear(var(58)),anim = 823)*(enemynear(var(58)),animelem = 6,13)
trigger2 = (enemynear(var(58)),stateno = 821)*(enemynear(var(58)),anim = 823)*(enemynear(var(58)),animelem = 6,43)
x = -ceil(enemynear(var(58)),fVar(24))*facing*enemynear(var(58)),facing
y = -ceil(enemynear(var(58)),fVar(25))*(statetype!=L)

;statetype!=A+statetype!=Lの場合強制落下stateへ
[State pos moving]
type = Changestate
Triggerall = (Enemynear(var(58)),Name = "Komachi Onoduka")*(Enemynear(var(58)),AuthorName = "mikage_th105")*(TeamMode = single)
Triggerall = (statetype != A)*(pos y!=0)*(statetype!=L)
trigger1 = (enemynear(var(58)),stateno = 820)*(enemynear(var(58)),anim = 823)*(enemynear(var(58)),animelem = 6,13)
trigger2 = (enemynear(var(58)),stateno = 821)*(enemynear(var(58)),anim = 823)*(enemynear(var(58)),animelem = 6,43)
value = 50

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;■鈴仙・優曇華院・イナバ（水影氏）■
;「毒煙幕「瓦斯織物の玉」」
[State lifeadd]
type = lifeadd
Trigger1 = Pos y > -240
Trigger1 = (Enemy(0),Name = "Reisen Udongein Inaba")*(Enemy(0),AuthorName = "mikage_th105")*(Enemy(0),fvar(21))
value = -floor(Enemy(0),fvar(21))*2
ignorehitpause = 1
absolute = 1
kill = 0

[State lifeadd]
type = lifeadd
Trigger1 = NumEnemy = 2
Trigger1 = Pos y > -240
Trigger1 = (Enemy(1),Name = "Reisen Udongein Inaba")*(Enemy(1),AuthorName = "mikage_th105")*(Enemy(1),fvar(21))
value = -floor(Enemy(1),fvar(21))*2
ignorehitpause = 1
absolute = 1
kill = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;クリップボード
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 0
text = "v3=%d,v14=%d,v12=%d,var(8)=%d,numhelper=%d\n"
params = var(3),var(14),var(12),var(8),numhelper(6000)
ignorehitpause = 1

[State -2, 表示を横に加える]
type = AppendToClipboard
trigger1 = 0
text = "Front=%d/Back=%d Vel X=%d,Y=%d Power=%d\n"
params = FrontEdgeBodyDist,enemy,BackEdgeBodyDist,floor(Vel X),floor(Vel Y),Power
ignorehitpause = 1

[State -2, 表示を横に加える]
type = AppendToClipboard
trigger1 = 0
text = "P2X=%d/P2Y=%d Vel X=%d,Y=%d Power=%d"
params = floor(P2BodyDist X),floor(P2BodyDist Y),floor(Vel X),floor(Vel Y),Power
ignorehitpause = 1
