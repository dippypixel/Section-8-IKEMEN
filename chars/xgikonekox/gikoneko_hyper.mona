
;■レイジングストーム■
[Statedef 3000]
type = S
movetype = A
physics = S
velset = 0, 0
ctrl = 0

[State 1100, VarSet]
type = VarSet
triggerall = !var(59)
trigger1 = Time = 0
var(1) = ifelse(Command = "レベル１レイジングストーム", 0, ifelse(Command = "レベル２レイジングストーム", 1, 2))

[State 1100, VarSet]
type = NULL
triggerall = var(59) || fvar(39)
triggerall = Time = 0
trigger1 = var(1) := 0 && 0
trigger2 = power <= 3000
trigger2 = var(1) := random%floor(power*.001) && 0
trigger3 = power >= 2000
trigger3 = p2movetype = A
trigger3 = var(1) := 1 && 0

[State 1200, ChangeState]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(!var(1), 3000, ifelse(var(1) = 1, 3010, 3020))

[State -1, NotHitBy]
