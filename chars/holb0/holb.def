; ここにキャラ情報を書いてください
[Info]
name = "Hol horse"        ;キャラの名前
displayname = "Hol horse" ;表示されるキャラの名前
versiondate = 05,15,2005    ;キャラの更新情報
mugenversion = 04,14,2002   ;キャラが動くmugenのバージョン
author = "y.y"         ;キャラの製作者名
pal.defaults = 1,2,3,4,5,6      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = hol/hol.cmd   ;キャラのコマンド
cns     = hol/hol.cns   ;キャラのプログラム
st      = hol/hol.cns   ;キャラのプログラム
st1      = hol/hol0.cns
st2      = hol/hol2.cns
stcommon = common1.cns 
sprite  = hol.sff   ;キャラの絵
anim    = hol.air   ;キャラの動き
sound   = hol.snd   ;キャラの音
pal1    = hol/hol01.act  ;キャラの色（最大１２個）
pal2    = hol/hol02.act
pal3    = hol/hol03.act
pal4    = hol/hol04.act
pal5    = hol/hol05.act
pal6    = hol/hol06.act

[Arcade]
intro.storyboard =  holOP.def
ending.storyboard = holED.def
