type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 220, Position]
type = PosFreeze
trigger1 = time >= 4

[State 220, Effect]
type = PlaySnd
trigger1 = time = 1
value = 820, 1

[State 4900, 16]
type = AngleDraw
trigger1 = 1
scale = (1+(.05*Time))*root,const(size.xscale),(1-(.075*Time))*root,const(size.yscale)
ignorehitpause = 1

[State 1100, VarSet]
type = ParentVarSet
trigger1 = time = 12
var(8) = 0

[State 0, DestroySelf]
type = ChangeState
trigger1 = time = 12
value = 10000

;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 15000]
type    = S
movetype= H
physics = N
velset = 0,0
ctrl = 0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = helper(1250),GetHitVar(animtype) != [3,5]
value = ifelse((helper(1250),GetHitVar(groundtype) = 1),5000,5010) + helper(1250),GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = helper(1250),GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (helper(1250),GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + helper(1250),GetHitVar(animtype)))
value = 5047 + helper(1250),GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = helper(1250),GetHitVar(yvel) != 0 && helper(1250),GetHitVar(fall)
trigger2 = Pos Y != 0
type = a

[State 5000, 6]
type = ChangeState
trigger1 = alive = 1
trigger1 = helper(1250),HitShakeOver
trigger1 = helper(1250),GetHitVar(yvel) = 0
value = 15001 ;HITG_SLIDE

[State 5000, 7]
type = ChangeState
trigger1 = helper(1250),HitShakeOver
value = ifelse(alive = 0,5030,15030)

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

[State 5000, 11]
type = Lifeadd
trigger1 = time = 0
trigger1 = prevstateno != [5000,5099]
value = -(helper(1250),GetHitVar(damage))

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 15001]
type    = S
movetype= H
physics = S
ctrl = 0

[State 5001, 1]
type = VelSet
trigger1 = Time = 0
x = Helper(1250),GetHitVar(xvel)*ifelse(facing = -1,-1,1)

[State 5001, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 5005 + helper(1250),GetHitVar(animtype) + (helper(1250),GetHitVar(groundtype)=2)*10

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= helper(1250),GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = helper(1250),HitOver
x = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = helper(1250),HitOver
value = 1

[State 5001, 6]
type = ChangeState
trigger1 = helper(1250),HitOver
value = 0
ctrl = 1

