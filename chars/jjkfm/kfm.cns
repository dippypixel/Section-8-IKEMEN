[StateDef 1200]
type = U
movetype= I
physics = N
velset = 0,0
ctrl = 0
poweradd = 130
sprpriority = 2

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
value = 1200+(statetype=C||command = "holddown")+(statetype=A)*2

[State 0, PosSet]
type = PosSet
trigger1 = statetype != A
y = 0

[State 0, Gravity]
type = StatetypeSet
trigger1 = time = 0 && statetype != A && command != "holddown"
statetype = S

[State 0, Gravity]
type = StatetypeSet
trigger1 = time = 0 && statetype != A && command = "holddown"
statetype = C

[State 0, Gravity]
type = StatetypeSet
trigger1 = statetype = A && animelemtime(3) > 5
physics = A

[State 0, CtrlSet]
type = CtrlSet
trigger1 = animelemtime(3) > 6 && statetype != A
value = 1

[State 40, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

[State 40, 3]
type = VarSet
trigger1 = animelem = 3 && command = "holdback" && !var(0)
sysvar(1) = -1

[State 40, 2]
type = VarSet
trigger1 = animelem = 3 && command = "holdfwd" && !var(0)
sysvar(1) = 1

[State 40, 4]
type = VelSet
trigger1 = AnimElemTime(3) > 5 && Statetype = A
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 1200, end]
type = ChangeState
trigger1 = AnimTime = 0 && statetype != A
value = (statetype=C)*11
ctrl = 1

