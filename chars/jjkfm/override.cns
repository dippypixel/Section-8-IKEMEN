trigger1 = p2dist X <= 70
trigger1 = p2dist Y<=-100+(p2dist X/5)
value = 0

[State 21, 3]
type = ChangeState
trigger1 = p2dist X <= 70
trigger1 = p2dist Y>-100+(p2dist X/5)
value = 1210

[State 21, 3]
type = ChangeState
trigger1 = p2stateno != 1028
value = 0
ctrl = 1
