value = 1210

[State 21, 3]
type = ChangeState
trigger1 = p2stateno != 1028
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = var(0)
trigger2 = p2dist X>100
trigger3 = var(0)
trigger3 = p2movetype = A
trigger3 = enemy,hitdefattr = SCA,ST,HT
trigger4 = prevstateno = [100,102]
sysvar(1) = 1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0 && !var(41)
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0 && !var(41)
trigger1 = prevstateno = [100,102]
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0 && !var(41)
value = 50
ctrl = 1

[State 40, 6]
type = ChangeAnim
trigger1 = var(41) && !anim = 101
value = 101

[State 40, 6]
type = ChangeAnim
trigger1 = !var(41) && time = 0
value = 40

[State 40, 6]
type = ChangeState
trigger1 = var(41)
value = 4050
ctrl = 1

