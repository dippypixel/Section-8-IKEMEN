physics = S
ctrl = 0
anim = 100
sprpriority = 1

[State 22, 1]
type = VelSet
trigger1 = anim = 100
x = const(velocity.run.fwd.x)

[State 22, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 102, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 0, VarSet]
