[statedef -2]

[State 0, KFPalm]
type = Helper
trigger1 = !numhelper(1250)
helpertype = normal
name = "Clone"
ID = 1250
stateno = 10000
pos = 0,0
postype = p1
ownpal = 1

[State -2, Pausetimer]
type = Helper
trigger1 = !numhelper(9740)
HelperType = normal
name = "Pausetimer"
ID = 9740
pos = 0,0
StateNo = 9740
PauseMoveTime = 999999999
SuperMoveTime = 999999999

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "p2dist X = %f, p2dist Y = %f"
params = p2dist X, p2dist Y

[State -2, Enemy Has Paused]
type = VarSet
trigger1 = var(5)>1
var(7) = 100

[State -2, Enemy Has Paused]
type = VarSet
trigger1 = 1
var(5) = 0

[State -2, AI varset]
type = VarAdd
trigger1 = 1
var(6) = -1

[State -2, Enemy Has Paused]
type = VarAdd
trigger1 = var(7)
var(7) = -1

[State -2, AI varset]
type = VarSet
triggerall = p2dist X<=70
triggerall = p2statetype = S || p2statetype = C
trigger1 = stateno = 640
trigger1 = movecontact
trigger1 = pos Y <10
var(8) = 8

[State -2, AI varset]
type = VarAdd
trigger1 = var(8)
var(8) = -1

[State 0, SprPriority]
type = SprPriority
trigger1 = !ishelper && helper(1250),stateno!=10000
value = 2

[State -2, varset]
type = varset
trigger1 = var(40) < 0
var(40) = 0
ignorehitpause = 1
persistent = 1

[State -2, varadd]
type = varadd
trigger1 = var(40) > 0 && StateNo != 4000
var(40) = -1
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = movetype = H
v = 41
value = 0

[State 0, PalFX]
type = PalFX
trigger1 = !ishelper && var(41)
time = 2
invertall = 1
ignorehitpause = 1

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = var(41) && roundstate = 2
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = var(41) && roundstate = 2
flag = nojugglecheck

[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = !var(41) || roundstate > 2
time = 1

