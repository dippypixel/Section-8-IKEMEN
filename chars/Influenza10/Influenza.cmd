;---------------------------------------------------------------------------
[Statedef -1]

;===========================================================================
;---------------------------------------------------------------------------
;Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "FF" && command != "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI closes gap
trigger2 = P2BodyDist X > 64 && P2MoveType != A

;---------------------------------------------------------------------------
;Run Back
[State -1, Run Back]
type = ChangeState
value = 105
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "BB" && command != "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI backs from downed opponent
trigger2 = P2BodyDist X < 16 && (P2StateNo = [5100,5110])

;---------------------------------------------------------------------------
;Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "start" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.3 > random && RoundState = 2 ; AI taunts
trigger2 = RoundState = 3 && PrevStateNo != 195

;===========================================================================
;---------------------------------------------------------------------------
;Deadly Sneeze
[State -1, Deadly Sneeze]
type = ChangeState
value = 3001
triggerall = power >= 1000
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230 || StateNo = 430 || StateNo = 1001) && MoveContact
trigger1 = command = "QCB_xy" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.5 > random && RoundState = 2 ; AI throws out
trigger2 = P2BodyDist X < 32 && Abs(P2Dist Y) < 64

;---------------------------------------------------------------------------
;Tissue Rain
[State -1, Tissue Rain]
type = ChangeState
value = 3000
triggerall = power >= 1000
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230 || StateNo = 430 || StateNo = 1001) && MoveContact
trigger1 = command = "QCF_xy" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI chains roll
trigger2 = StateNo = 1001 && MoveHit
trigger3 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI chains LP
trigger3 = StateNo = 200 && MoveHit && AnimElem = 5,>= 1

;---------------------------------------------------------------------------
;Lay The Mat
[State -1, Lay The Mat]
type = ChangeState
value = 1004
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230 || StateNo = 430) && MoveContact
trigger1 = command = "Lay The Mat" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI chains roll
trigger2 = StateNo = 200 && MoveContact && AnimElem = 5,>= 1 && Power <= 1000

;---------------------------------------------------------------------------
;Take Flight
[State -1, Take Flight]
type = ChangeState
value = 1003
triggerall = statetype = A
triggerall = ctrl
trigger1 = command = "x" && command = "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI throws out
trigger2 = P2Dist X >= 16

;---------------------------------------------------------------------------
;Roll
[State -1, Roll]
type = ChangeState
value = 1002
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230 || StateNo = 430) && MoveContact
trigger1 = command = "QCB_y" && !Var(15)

;---------------------------------------------------------------------------
;Roll
[State -1, Roll]
type = ChangeState
value = 1001
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230 || StateNo = 430) && MoveContact
trigger1 = command = "QCF_y" && !Var(15)

;---------------------------------------------------------------------------
;Tissue Toss
[State -1, Tissue Toss]
type = ChangeState
value = 1000
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230 || StateNo = 430) && MoveContact
trigger1 = command = "QCF_x" && !Var(15)

;---------------------------------------------------------------------------
;Stand Light Punch
[State -1, Stand Light Punch]
type = ChangeState
value = 200
triggerall = statetype != A
triggerall = ctrl || (stateno = 230 || StateNo = 430) && MoveContact
trigger1 = command = "x" && command != "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI chains LK
trigger2 = StateNo = 230 && MoveHit

;---------------------------------------------------------------------------
;Stand Light Kick
[State -1, Stand Light Kick]
type = ChangeState
value = 230
triggerall = statetype != A
triggerall = ctrl || (stateno = 230 || StateNo = 430) && MoveContact
trigger1 = command = "y" && command != "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI starts the attack
trigger2 = P2BodyDist X < 32 && Abs(P2Dist Y < 48)

;---------------------------------------------------------------------------
; Throw
[State -1, Throw]
type = ChangeState
value = 800
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != 100
triggerall = p2bodydist X < 10
triggerall = (p2statetype = S) || (p2statetype = C)
triggerall = p2movetype != H
trigger1 = (command = "holdfwd" || command = "holdback") && command = "y" && !Var(15)

;---------------------------------------------------------------------------
;Crouching Light Punch
[State -1, Crouching Light Punch]
type = ChangeState
value = 400
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230 || StateNo = 430) && MoveContact
trigger1 = command = "x" && command = "holddown" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI chains LK
trigger2 = StateNo = 230 && MoveGuarded && P2StateType = S

;---------------------------------------------------------------------------
;Crouching light kick
[State -1, Crouching light kick]
type = ChangeState
value = 430
triggerall = statetype != A
triggerall = ctrl || (stateno = 200 || stateno = 230) && MoveContact
trigger1 = command = "y" && command = "holddown" && !Var(15)

;---------------------------------------------------------------------------
;Jump Light Punch
[State -1, Jump Light Punch]
type = ChangeState
value = 600
triggerall = statetype = A
triggerall = ctrl
trigger1 = command = "x" && !Var(15)
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI chains LK
trigger2 = P2Dist X = [-16,16]

;---------------------------------------------------------------------------
;Jump Light Kick
[State -1, Jump Light Kick]
type = ChangeState
value = 630
triggerall = statetype = A
triggerall = ctrl
trigger1 = command = "y" && !Var(15)