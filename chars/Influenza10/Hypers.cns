;====================<FREEZE STATUS TRANSITION>====================
;Freeze : Standing Hit Shake
[Statedef 5800]
type    = U
movetype= H
physics = N
velset = 0,0

[State 5800, ChangeState]
type = ChangeState
trigger1 = !Time
trigger1 = StateType != S
value = 5810 + (StateType = A) * 10

[State 5800, StateTypeSet]
type = StateTypeSet
trigger1 = !Time
StateType = S

[State 5800, Hit Anim]
type = ChangeAnim
trigger1 = !Time
value = 5002

[State 5800, Freeze Anim]
type = ChangeAnim
trigger1 = Time > 0
value = Anim

[State 5800, StateTypeSet : Air]
type = StateTypeSet
trigger1 = !Time
trigger1 = GetHitVar(YVel) != 0 || GetHitVar(Fall)
trigger2 = Pos Y != 0
statetype = A

[State 5800, ChangeState]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(YVel) = 0 && !GetHitVar(Fall)
value = 5801

[State 5800, PalFX]
type = PalFX
trigger1 = 1
time = 1
add = 255, 255, 255
mul = 140, 140, 140
color = 0

[State 5800, ChangeState]
type = ChangeState
trigger1 = HitShakeOver
value = 5830

;Freeze : Standing Slide Shake
[Statedef 5801]
type    = S
movetype= H
physics = S

[State 5801, ChangeAnim]
type = ChangeAnim
trigger1 = !HitOver
value = Anim

[State 5801, HitVelSet]
type = HitVelSet
trigger1 = !Time
x = 1

[State 5801, VelMul : Stop Sliding]
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 5801, VelSet]
type = VelSet
trigger1 = HitOver
x = 0

[State 5801, DefenceMulSet]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 5801, StateTypeSet]
type = StateTypeSet
trigger1 = HitOver
movetype = I 

[State 5801, NotHitBy]
type = NotHitBy
trigger1 = HitOver
value = , AT
time = 6
persistent = 0

[State 5801, PalFX]
type = PalFX
trigger1 = 1
time = 1
add = 255, 255, 255
mul = 140, 140, 140
color = 0

[State 5801, SelfState]
type = SelfState
trigger1 = HitOver
value = 0
ctrl = 1

