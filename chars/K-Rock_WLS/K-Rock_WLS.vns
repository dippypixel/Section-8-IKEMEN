; Win state decider Taken from KFM Plus some minor tweaks.
; Thanks to Neon_Tiger for pointing me out the VarRandom method.
[Statedef 180]
type = S
ctrl = 0

[State 180, 1]
type = ChangeState
trigger1 = command = "hold_x"
value = 171
[State 180, 1]
type = ChangeState
trigger1 = command = "hold_a"
value = 172
[State 180, 1]
type = ChangeState
trigger1 = command = "hold_y"
value = 173
[State 180, 1]
type = ChangeState
triggerall = numhelper(1741)
trigger1 = command = "hold_b"
trigger1 = var(36) = 1
;trigger1 = p2stateno = 5150
trigger1 = (enemynear,prevstateno = 5111)
value = 174

[State 180, 1]
type = ChangeState
triggerall = numhelper(1741)
trigger1 = !time
trigger1 = var(36) = 1
;trigger1 = p2stateno = 5150
trigger1 = (enemynear,prevstateno = 5111)
value = 174

[State 180, 1]
type = ChangeState
trigger1 = !time
value = 171+(random%3)

