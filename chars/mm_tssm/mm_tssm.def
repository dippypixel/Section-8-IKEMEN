type = TargetLifeAdd
trigger1 = AnimElem = 6
trigger2 = AnimElem = 14
trigger3 = AnimElem = 22
value = -50
kill = 0

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 = AnimElem = 30
value = -100

