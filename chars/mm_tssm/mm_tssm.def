ctrl = 0
anim = 181
velset = 0,0

[State 0, ]
type = PlaySnd
trigger1 = Time = 0
value = S1,0
channel = 0
volume = 255

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
