;---------------------------------------------------------------------------
; MatchOver dialog
[Statedef 9180]
type = S
movetype = I
physics = N
ctrl = 0
anim = 9741
velset = 0,0

[State 0, ]
type = VarRandom
trigger1 = Time = 0
v = 0
range = 0,7

[State 0, ]
type = Explod
trigger1 = Time = 0
anim = 9180 + var(0)
pos = 0,352
postype = left
bindtime = -1
removetime = -1
supermovetime = 65535
pausemovetime = 65535
scale = .5, .5
ontop = 1
ownpal = 1
ignorehitpause = 1


;---------------------------------------------------------------------------
; Intro decider
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = 1
value = ifelse(random<500,191,192)

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Introd 2
[Statedef 192]
type = S
ctrl = 0
anim = 192
velset = 0,0
sprpriority = 0

[State 0, ]
type = Explod
trigger1 = Time = 0
id = 1925
anim = 1925
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = 1
sprpriority = 1
shadow = 255,255,255
ownpal = 1
removeongethit = 1

[State 0, ]
type = ModifyExplod
trigger1 = animelem = 26
id = 1925
vel = -1,1
sprpriority = -1
shadow = 255,255,255
ownpal = 1

[State 0, ]
type = PlaySnd
trigger1 = AnimElem = 21
value = 0,6

[State 0, ]
type = PlaySnd
trigger1 = AnimElem = 15
value = 1,ifelse(random<500,5,6)

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0


