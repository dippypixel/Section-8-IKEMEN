triggerall = !var(59)
trigger1 = command = "holdback"
flag = nowalk

[State 100, 2]
type = ChangeState
triggerall = !var(59)
trigger1 = command != "holdback"
value = 0

[State 100, assert]
type = AssertSpecial
trigger1 = var(59)
flag = nowalk

[State 0, CtrlSet]
type = CtrlSet
trigger1 = var(59)
value = 0

[State 100, 2]
type = ChangeState
