type    = A
physics = A
anim = 106

[State 50, VelAdd]
type = VelAdd
trigger1 = time >= 1
trigger1 = command = "holdfwd"
x = 0.1

[State 50, VelAdd]
type = VelAdd
trigger1 = time >= 1
trigger1 = command = "holdback"
x = -0.1

[State 50, 0]
type = VarSet
trigger1 = time = 0
v = 2
value = 0

[State 50, 1]
