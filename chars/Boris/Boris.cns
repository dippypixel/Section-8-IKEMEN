physics = S
anim = 105
sprpriority = 1

[State 100, Footsteps]
type = PlaySnd
trigger1 = AnimElem = 2
trigger2 = AnimElem = 4
value = S20,0+random%3

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.back.x)

[State 100, assert]
