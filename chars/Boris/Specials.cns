;---------------------------------------------------------------------------
; The Dance
[Statedef 1000]
type    = S
movetype= A
physics = S
poweradd= 55
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2
juggle = 3

[State 810, Holding back?]
type = VarSet
trigger1 = Time = 0
var(2) = ifelse(!var(59),cond(command = "x",0,cond(command = "y",1,2)),cond(p2bodydist x < 35 ,0,cond(p2bodydist x < 50,1,2)))

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(2) = 1 && time < 2
trigger2 = var(2) = 2 && time < 5
value = 1000
elem = 1

[State 0, VelSet]
type = VelSet
trigger1 = AnimElem = 3
x = cond(var(2) = 0,8,cond(var(2) = 1,11,14))

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 0,2

[State 200,Voice]
type = PlaySnd
trigger1 = time = 1 && random >500
value = 1000,0
channel = 0
ignorehitpause = 1

[State 0, HitDef]
type = HitDef
trigger1 = !time
attr = S,SA        ;SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
hitflag = MAF        ;HLAFD+-
guardflag = MA         ;HLA
animtype = Diagup          ;light,medium,hard,back,up,diagup
air.animtype = Diagup
damage = cond(var(2) = 0,88,cond(var(2) = 1,85,81)),2
pausetime = 5 ,6
sparkno = s7020 + (random % 8)
guard.sparkno = s7000
sparkxy = -10,-42
hitsound   = S5,2
guardsound = S6,0
ground.type = Low      ;Low,Trip,None
air.type = Low
ground.slidetime = 11
ground.hittime = 18
guard.slidetime = 13
guard.hittime = 22
ground.velocity = -3.3,-4.3
air.velocity = -3,-3.8
fall = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

