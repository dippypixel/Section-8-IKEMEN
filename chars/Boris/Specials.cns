;---------------------------------------------------------------------------
; Wall Launch - Go to wall
[Statedef 1030]
type    = U
movetype= A
physics = N
poweradd= 55
velset = 0,0
anim = 1030
ctrl = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 1030,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4 && random >500
value = 1030,1
channel = 0
ignorehitpause = 1
volume = 140

[State 3000, StayOnTarget]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,1

[State 0, VelAdd]
type = VelSet
trigger1 = AnimElem = 4
x = -(backedgedist/16)-0.5
y = -2-ifelse(-2-(pos y*0.018) >= 0, -2, (pos y*0.018))

[State 0, AngleDraw]
type = AngleDraw
trigger1 = time > 10
value = (time-8)*15

[State 0, AngleMul]
type = AngleMul
trigger1 = time > 10
value = 1.5

[State 0, VelMul]
type = VelMul
trigger1 = time > 10
x = 1.2
y = 1.2

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 4
statetype = A

[State 0, ChangeState]
type = ChangeState
trigger1 = time > 18
trigger1 = backedgebodydist <= 0
value = 1031

;---------------------------------------------------------------------------
; Wall Launch - Clinging to wall
[Statedef 1031]
type    = A
movetype= I
physics = N
velset = 0,0.02
anim = 1031
ctrl = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 40,0

[State 3000, StayOnTarget]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,1

[State 0, PosAdd]
type = PosAdd
trigger1 = 1
x = -8 - backedgedist

[State 0, AngleDraw]
type = AngleDraw
trigger1 = !Time
value = 0

[State 0, VelMul]
type = VelMul
trigger1 = vel y < 3
y = 1.04

[State 0, VelAdd]
type = VelAdd
trigger1 = !var(59)
trigger1 = command = "holddown" && vel y < 9
trigger2 = var(59)
trigger2 = enemynear, pos y < (-35+ pos y) && vel y < 9
y = 0.45

[State 0, VelAdd]
type = VelAdd
trigger1 = !var(59)
trigger1 = command != "holddown" && vel y > 3
trigger2 = var(59)
trigger2 = enemynear, pos y >= (-35+ pos y) && vel y > 3
y = -1

[State 0, ChangeState]
type = ChangeState
trigger1 = pos y >= 21
value = 1032

[State 0, ChangeState]
type = ChangeState
trigger1 = !var(59)
trigger1 = command = "a" || command = "b" || command = "c"
trigger2 = var(59)
trigger2 = enemynear, pos y >= (-35+ pos y)
trigger2 = ifelse(var(49),random%450>405,random%450>440)
value = 1032

