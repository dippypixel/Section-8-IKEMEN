trigger1 = Time = 0
pos = 0,0
value = 0

[State 18000, 不可視設定]
type = AssertSpecial
trigger1 = 1
flag = invisible

[State 18000, 不可視時無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 800, タンデム発動フラグ判定]
type = ParentVarSet
trigger1 = !root,var(7)
trigger1 = time = 0
var(7) = 1

[State 18000, 不可視状態終了 - ステート移動]
type = ChangeState
trigger1 = root,time = 125
value = 18001
ignorehitpause = 1

