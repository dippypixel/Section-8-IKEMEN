
;=============================================================================
; Statedef -2開始
;=============================================================================
[Statedef -2]

;=============================================================================
; デバッグ表示
;=============================================================================
[State -2, DisplaytoClipBoard]
type = DisplayToClipBoard
trigger1 = 1
text ="		var(11) = %d 	var(3) = %d	dist = %f"
params =	var(11),	var(3),		helper(10000),rootdist x
supermovetime = 9999999
pausemovetime = 9999999

;=============================================================================
; KO演出
;=============================================================================
[State -2, 超必殺KOの場合]
type = VarSet
triggerall=roundstate = 2
trigger1 = EnemyNear,HitDefAttr=SCA, HA,HT,HP
trigger2 = GethitVar(hitcount) >= 20
var(55) = 2

[State -2, 必殺KOの場合]
type = VarSet
triggerall=roundstate = 2
triggerall=var(55) != 2
trigger1 = EnemyNear,HitDefAttr=SCA, SA,ST,SP
trigger2 = GethitVar(hitcount) >= 10 && GethitVar(hitcount) <= 19
var(55) = 1

[State -2, 必殺KO時演出コール]
type = Helper
trigger1 = !Numhelper(6624)
trigger1 = roundstate = 3
trigger1 = var(55) = 1
trigger1 = loseko
trigger1 = p3name != "dio"
id = 6624
stateno = 6624
ownpal = 1
postype = left
pos = -999,-999
pausemovetime = 999
ignorehitpause = 1

[State -2, 超必KO時演出コール]
type = Helper
trigger1 = !Numhelper(6625)
trigger1 = roundstate = 3
trigger1 = var(55) = 2
trigger1 = loseko
trigger1 = p3name != "dio"
id = 6625
stateno = 6625
postype = left
pos = -999,-999
pausemovetime = 999
ignorehitpause = 1

;=============================================================================
;『DIO-WIN』『to be continued…』表示
;=============================================================================
[State -2, DIO-WIN]
type = helper
trigger1 = !Numhelper(20360)
trigger1 = var(56) != 3		;時停止バグ以外
trigger1 = stateno = 180
id = 20360
stateno = 20360
pos = -110,-28
postype = left
ownpal = 1
sprpriority = 10
pausemovetime = 9999
size.xscale = 0.9
size.yscale = 0.9

[State -2, to be con]
type = helper
trigger1 = matchover
trigger1 = !NumHelper(20370)
trigger1 = var(56) != 3		;時停止バグ以外
trigger1 = stateno = 180
stateno = 20370
id = 20370
pos = 300,10
postype = left
ownpal = 1
ontop = 1
pausemovetime = 9999
size.xscale = 0.456
size.yscale = 0.487

[State -2, 勝利/敗北時ライフバー消去]
type = AssertSpecial
trigger1 = winko
trigger2 = lose
flag = nobardisplay

;=============================================================================
; ランダム変数生成
;=============================================================================
[State 1100, ランダム変数]
type = VarRandom
trigger1 = 1
Trigger1=time%2
v = 0
range = 1,10

;=============================================================================
; 常時監視ヘルパー/Explod群
;=============================================================================
;スタンドヘルパー
[State -2]
type = Helper
trigger1 = !NumHelper(11111)
ID = 11111
stateno = 11111
ownpal = 1
pos = 0,0
keyctrl = 0
pausemovetime = 9999999999999999
size.xscale = 0.85
size.yscale = 1.06

;=============================================================================
; サウンド関連
;=============================================================================
[State -2, 無駄無駄ボイス停止]
type = StopSnd
trigger1 = movetype = H
trigger2 = Numhelper(11111)
trigger2 = helper(11111),movetype = H
trigger3 = stateno = 52
trigger4 = stateno = 50
trigger5 = stateno = 1350
channel = 1
ignorehitpause = 1

[State -2, Soffザ・ワールドッ！ボイス停止]
type = StopSnd
trigger1 = movetype = H
channel = 2
ignorehitpause = 1

;=============================================================================
; 本体ダメージレジスト(時間停止中は対象外)
;=============================================================================
[State -2, damage]
type = VarSet
triggerall = !Numhelper(333)
trigger1 = roundstate = 2
trigger1 = enemy,GethitVar(hitcount) >= 2 && enemy,GethitVar(hitcount) <= 40
fv = 10
value = 1.0 - (enemy,GethitVar(hitcount) * 0.1)

[State -2, damage]
type = VarSet
triggerall = !Numhelper(333)
trigger1 = roundstate = 2
trigger1 = enemy,GethitVar(hitcount) >= 41
fv = 10
value = 1.0 - (enemy,GethitVar(hitcount) * 0.4)

[State -2, damage_reset]
type = VarSet
triggerall = !Numhelper(333)
trigger1 = p2movetype != H
trigger2 = enemy,GethitVar(hitcount) = 0
fv = 10
value = 1.0

[State -2, damage]
type = VarSet
triggerall = !Numhelper(333)
triggerall = enemy,GethitVar(hitcount) >= 2 && enemy,GethitVar(hitcount) <= 40
trigger1 = fvar(10) < 0
fv = 10
value = 0.5

[State -2, damage]
type = VarSet
triggerall = !Numhelper(333)
triggerall = enemy,GethitVar(hitcount) >= 41
trigger1 = fvar(10) < 0
fv = 10
value = 0.4

[State -2, damage]
type = AttackMulSet
triggerall = !Numhelper(333)
trigger1 = roundstate = 2
value = fvar(10)

;=============================================================================
; 変数関連
;=============================================================================
[State -2, ダッシュフラグOFF]
type = VarSet
triggerall = var(11)
trigger1 = ctrl && stateno != 105 && stateno != 10
trigger2 = movetype = H
trigger3 = statetype = L
trigger4 = stateno = 200 && time >= 8	;立ち弱（本体）
trigger5 = stateno = 201 && time >= 8	;立ち弱（S）
trigger6 = stateno = 210 && time >= 11	;立ち中（本体）
trigger7 = stateno = 211 && time >= 11	;立ち中（S）
trigger8 = stateno = 220 && time >= 13	;立ち強（本体）
trigger9 = stateno = 221 && time >= 13	;立ち強（S）
trigger10 = stateno = 302 && time >= 8	;屈み弱（S）
trigger11 = stateno = 312 && time >= 10	;屈み中（S）
trigger12 = stateno = 321 && time >= 12	;屈み強（S）
trigger13 = stateno = 330 && time >= 12	;スライディング（本体）
trigger14 = stateno = 300 && time >= 8	;屈み弱（本体）
trigger15 = stateno = 310 && time >= 10	;屈み中（本体）
trigger16 = stateno = 320 && time >= 11	;屈み強（本体）
var(11) = 0
ignorehitpause = 1

[State -2, スタンド消去不可時間]
type = VarSet
trigger1 = var(50) <= 0
var(50) = 0

[State -2]
type = VarAdd
trigger1 = var(50) != 0
var(50) = -1

[State -2, タンデム使用不能時間(2.5秒)]
type = VarAdd
trigger1 = var(8)
var(8) = 1

[State -2]
type = VarSet
trigger1 = var(8) = 150
var(8) = 0

[State -2, マッハデムフラグOFF]
type = VarSet
triggerall = var(16)
trigger1 = stateno = [4900,4950]	;時止め
trigger2 = stateno = 4550		;DIOの『世界』
trigger3 = stateno = 4100		;血の召喚
trigger4 = stateno = 4300		;パニッシュメント
trigger5 = stateno = [4000,4050]	;チェックメイト
trigger6 = stateno = 1800		;死ねィ！
trigger7 = stateno = [1300,1760]	;ムダァ！/ムダムダァ！
trigger8 = stateno = [900,950]		;ガーキャン
trigger9 = stateno = [201,202]		;Son立ち弱/立ち弱追加
trigger10 = stateno = 211		;Son立ち中
trigger11 = stateno = 221		;Son立ち強
trigger12 = stateno = 301		;Son屈弱
trigger13 = stateno = 311		;Son屈中
trigger14 = stateno = 321		;Son屈強
trigger15 = stateno = 401		;Sonジャンプ弱
trigger16 = stateno = 411		;Sonジャンプ中
trigger17 = stateno = 421		;Sonジャンプ強
trigger18 = stateno = 1104		;スタンド発現攻撃
trigger19 = stateno = 1100		;スタンド発現（地上）
trigger20 = stateno = 1102		;スタンド発現（空中）
trigger21 = stateno = 800		;タンデム
trigger21 = animtime = -1
var(16) = 0

[State -2, Sコン判定フラグOFF]
type = VarSet
triggerall = roundstate = 2
triggerall = var(19)
trigger1 = ctrl
var(19) = 0

[State -2, 回り込み使用不可カウンタ除算]
type = VarAdd
trigger1 = var(20)
var(20) = -1
ignorehitpause = 1

[State -2, キャンセル中スタンド発現フラグ OFF(S発現攻撃専用対処)]
type = VarSet
trigger1 = var(17) = 3
trigger1 = ctrl
var(17) = 0
ignorehitpause = 1

;=============================================================================
; 時止め関連
;=============================================================================
[State 1100, 時停止中タイマ同期のパワーオフセット]
type = PowerSet
trigger1 = var(3)
value = ceil(var(3)*19.23)
ignorehitpause = 1

[State -2, 時間停止中ヒットカウント停止]
type = HitAdd
trigger1 = var(2)
trigger1 = 1
value = -1

[State -2, 時停止中タイマ除算]
type = VarAdd
triggerall = stateno != 800 ;タンデム
triggerall = stateno != [4900,4950] ;時止め
trigger1 = var(2)
trigger1 = var(3)
var(3) = -1
ignorehitpause = 1

[State -2, 時停止中タイマ除算]
type = VarAdd
triggerall = var(2)
trigger1 = stateno = 4500 && time = 1	;スタンドパワー
trigger2 = stateno = 4502 && time = 1	;スタンドパワー追加
trigger3 = stateno = 4000 && time = 1	;チェックメイト
trigger4 = stateno = 4050 && time = 1	;チェックメイト空中
var(3) = ifelse(var(3)>=52,-52,-var(3))
ignorehitpause = 1

[State -2, 時間停止]
type = Pause
trigger1 = var(2)
time = 3
movetime = 3
ignorehitpause = 1

[State -2, 時停止中は無敵]
type = NotHitBy
trigger1 = var(2)
value = SCA
ignorehitpause = 1

[State -2, 灰色背景]
type = BGPalFx
trigger1 = var(2)
mul = 256,256,256
invertall = 1
color = 0
time = 3
ignorehitpause = 1

[State -2, バグイレース２]
type = VarSet
trigger1 = Alive = 0
trigger2 = Win
trigger3 = Lose
trigger4 = DrawGame
trigger5 = RoundState != 2
v = 2
value = 0
ignorehitpause = 1

;念のため
[State -2, 1]
type = VarSet
trigger1 = var(3) < 0
trigger1 = 1
var(3) = 0

;ザ・ワールド終了
[State -2, 1]
type = ChangeState
triggerall = var(2)
triggerall = var(3) < 1
trigger1 = stateType != A
trigger1 = ctrl
trigger2 = stateno = 200 && animtime = 0
trigger3 = stateno = 201 && animtime = 0
trigger4 = stateno = 300 && animtime = 0
value = 4906
ignorehitpause = 1

;=============================================================================
; ダメージボイス
;=============================================================================
[state -2]
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = GetHitVar(animtype) = 0
value = 200,1 + (random%4)
persistent = 0

[state -2]
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = GetHitVar(animtype) = 1
value = 200,2 + (random%4)
persistent = 0

[state -2]
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = GetHitVar(animtype) = 2
trigger2 = GetHitVar(animtype) = 3
trigger3 = GetHitVar(animtype) = 4
value = 200,3 + (random%4)
persistent = 0

