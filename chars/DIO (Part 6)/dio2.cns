ctrl = 0

[State 100, ダッシュフラグOFF]
type = VarSet
trigger1 = time = 0
var(11) = 0

[State 100, ダッシュフラグON]
type = VarSet
trigger1 = time = 1
var(11) = 1

[State 100, ダッシュ初速度]
type = VelSet
trigger1 = time >= 3 && time <= 18
x = 8.3

[State 100, ダッシュ逆慣性]
type = VelAdd
trigger1 = time >= 11 && time <= 18
x = -4

[State 100, ダッシュキャンセル(しゃがみ)]
