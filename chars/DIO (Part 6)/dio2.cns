;==============================================================================
; Varの使用状況
;==============================================================================
; var(0)  - ランダム変数(勝利イントロ分岐に使用)
; var(1)  - 弱中強判定（瞬間移動、本体モード無駄ァ！）
; var(2)  - 時止めフラグ
; var(3)  - 時止め時間
; var(4)  - ショートジャンプフラグ
; var(5)  - 時停止中ダメージボックス
; var(6)  - 2段ジャンプ回数フラグ
; var(7)  - タンデム発動中フラグ
; var(8)  - タンデム使用可否判定フラグ
; var(9)  - タンデム中攻撃回数カウンタ
; var(10) - スロゥナイブズ - ナイフタイプ判別
; var(11) - ダッシュ中フラグ
; var(12) - Son立ち中キャンセルフラグ
; var(13) - チェックメイト(空中)遠/近判定フラグ
; var(14) - ジャンプ関連
; var(15) - ムダァ！キャンセルフラグ（ムダァ！→タンデム時に使用）
; var(16) - マッハデムフラグ
; var(17) - キャンセル中スタンド発現フラグ
; var(18) - 投げ→スタンドパワーフラグ
; var(19) - スタンドコンボルート判定フラグ
; var(20) - 回り込み使用不可時間カウンタ
; var(21) - Son(空中)発動後ガード不可時間カウンタ
; var(22) - タンデム後無敵時間カウンタ
; var(23) - ムダムダァ！連打フラグ
; var(24) - 
; var(25) - 
; var(26) - 
; var(27) - 
; var(28) - 
; var(29) - 
; var(30) - 
; var(31) - 
; var(32) - 
; var(33) - 
; var(34) - 
; var(35) - 
; var(36) - 
; var(37) - 
; var(38) - 
; var(39) - 
; var(40) - 
; var(41) - 
; var(42) - 
; var(43) - 
; var(44) - 
; var(45) - 
; var(46) - 
; var(47) - 
; var(48) - 
; var(49) - スタンドモード判定フラグ
; var(50) - スタンド消去不能タイムラグ
; var(51) - スタンド出現中フラグ
; var(52) - 
; var(53) - 
; var(54) - 
; var(55) - KO種別判定フラグ
; var(56) - 時間停止バグフラグ
; var(57) - 
; var(58) - 
; var(59) - 

;==============================================================================
; システム関連(fvar)
;==============================================================================
; fvar(1) - ダメージ補正
; fvar(2) - ナイフダメージ補正

[Data]
life = 950
power = 10000
attack = 75
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex = 58 ;56以降ラウンド持ち越し
FloatPersistIndex = 0

[Size]
xscale = .833
yscale = 1.07
ground.back = 15
ground.front = 18
air.back = 15
air.front = 15
height = 65
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 7, -110
mid.pos = 8, -72
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.48
walk.back = -1.87
run.fwd  = 9, 0
run.back = -10,0
jump.neu = 0,-10.1
jump.back = -2.5
jump.fwd = 3.33
runjump.back = -4.5,-11
runjump.fwd = 4.5,-11
airjump.neu = 0,-5.4
airjump.back = -2.8
airjump.fwd = 2.8

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .6
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
;立ちアニメ
[Statedef 0]
type = S
physics = S
sprpriority = 0
anim = ifelse(!var(49),0,30000)

[State 0, Soff]
type = ChangeAnim
trigger1 = anim = 5 && Animtime = 0
value = ifelse(!var(49),0,30000)

[State 0, 2]
type = VelSet
trigger1 = time = 0
y = 0

[State 0, 3]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = time = 4
x = 0

[State 0, 死亡時]
type = ChangeState
trigger1 = !alive
value = 5050
;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Change palette
type = RemapPal
trigger1 = 1
source = 1,1  ;; <--- Change this to the palette that the sprites are using.  It might be 0,0?
dest = 1,palno

[State 5900, 4] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190

[State 5900, 5] ;All other rounds
type = ChangeState
trigger1 = 1
value = 0
 
;---------------------------------------------------------------------------
;歩き
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 前歩き速度]
type = VelSet
trigger1 = roundstate = 2
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 後ろ歩き速度]
type = VelSet
trigger1 = roundstate = 2
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 前歩き時のアニメ指定]
type = ChangeAnim
triggerall = !var(49)
triggerall = roundstate = 2
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = anim = 5 && Animtime = 0
value = 20

[State 20, 後ろ歩き時のアニメ指定]
type = ChangeAnim
triggerall = !var(49)
triggerall = roundstate = 2
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = anim = 5 && Animtime = 0
value = 21

[State 20, 前歩き時のアニメ指定(Son)]
type = ChangeAnim
triggerall = var(49)
triggerall = roundstate = 2
triggerall = vel x > 0
trigger1 = Anim != 30020 && Anim != 5
trigger2 = anim = 5 && Animtime = 0
value = 30020

[State 20, 後ろ歩き時のアニメ指定(Son)]
type = ChangeAnim
triggerall = var(49)
triggerall = roundstate = 2
triggerall = vel x < 0
trigger1 = Anim != 30021 && Anim != 5
trigger2 = anim = 5 && Animtime = 0
value = 30021

;---------------------------------------------------------------------------
; 立ち→しゃがみ
[Statedef 10]
type    = C
physics = C
anim = ifelse(!var(49),10,30010)

[State 10, 停止]
type = VelSet
trigger1 = !var(11)
trigger1 = time = 0
x = 0

[State 10, 立ち→しゃがみ終了(しゃがみ安定状態へ)]
type = ChangeState
trigger1 = Animtime = 0
value = 11

;---------------------------------------------------------------------------
; しゃがみ
[Statedef 11]
type    = C
physics = C
anim = ifelse(!var(49),11,30011)
sprpriority = 0

[State 11, しゃがみ安定状態]
type = ChangeAnim
trigger1 = anim = 6 && Animtime = 0
value = ifelse(!var(49),11,30010)

;---------------------------------------------------------------------------
; しゃがみ→立ち
[Statedef 12]
type    = S
physics = S
anim = ifelse(!var(49),12,30012)

[State 12, 1]
type = ChangeState
trigger1 = Animtime = 0
value = 0

;---------------------------------------------------------------------------
;ジャンプ開始
[Statedef 40]
type    = S
physics = N
anim = ifelse(!var(49),40,30040)
ctrl = 0
velset = 0,0

[State 2, 2段ジャンプ不可フラグOFF]
type = VarSet
trigger1 = time = 0
var(6) = 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = command = "holdfwd"-command = "holdback"

[State 40, 4]
type = VarSet
trigger1 = time = 0
var(14) = 0

[State 40, 4]
type = VarSet
triggerall = time = 0
trigger1 = prevstateno != 100
trigger1 = Command = "longjump"
var(14) = 1

[State 40, 4]
type = VarSet
triggerall = time = 0
trigger1 = prevstateno = 100
var(14) = 2

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(4) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(4) = 1

[State 40, 6]
type = VelSet
trigger1 = time = 0
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*ifelse((!var(49)&&var(14))||(var(49)&&var(14)=2),1.33,1)

[State 40, 8]
type = VelSet
trigger1 = time = 0
y = const(velocity.jump.y)*ifelse(!var(49)&&var(14)=1,1.1,1)

[State 40, 8]
type = VelMul
trigger1 = var(4)
y = .64
persistent = 0

[State 40, 10]
type = PosFreeze
trigger1 = 1

[State 40, 10]
type = ChangeState
trigger1 = animtime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------------------------------------------------------------
; 2段ジャンプ開始
[Statedef 2]
type    = A
physics = A
anim = ifelse(!var(49),40,30040)
ctrl = 0
sprpriority = 1

[State 2, 2段ジャンプ不可フラグON]
type = VarSet
trigger1 = time = 0
var(6) = 1

[State 2, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

[State 2, 2]
type = VarSet
trigger1 = time = 0
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 2, 3]
type = VarSet
trigger1 = time = 0
trigger1 = command = "holdback"
sysvar(1) = -1

[State 2, ジャンプ]
type = VelSet
trigger1 = animtime <= 0
x = 0
y = 0

[State 2, ジャンプ]
type = VelSet
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -9

[State 2, フン！]
type = PlaySnd
trigger1 = time = 0
value = S100,7

[State 2, 2段ジャンプ開始ステ終了 - ステート移動]
type = ChangeState
trigger1 = animtime = 0
value = 3
ctrl = 1

;---------------------------------------------------------------------------
; 2段ジャンプ
[Statedef 3]
type    = A
physics = A
anim = ifelse(!var(49),41,30041)

[State 3, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

;---------------------------------------------------------------------------
; ジャンプ中
[Statedef 50]
type    = A
physics = A

[State 50, 無駄ァ！]
type = PlaySnd
trigger1 = prevstateno = 1760
trigger1 = time = 0
value = S100,12
ignorehitpause = 1

[State 50, Soff時]
type = ChangeAnim
trigger1 = !var(49)
trigger1 = time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, Son時]
type = ChangeAnim
trigger1 = var(49)
trigger1 = time = 0
value = ifelse((vel x)=0, 30041, ifelse((vel x)>0, 30042, 30043))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; ジャンプ着地
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = ifelse(!var(49),47,30047)

[State 52, 無駄ァ！]
type = PlaySnd
trigger1 = prevstateno = 1760
trigger1 = time = 0
value = S100,12
ignorehitpause = 1

[State 52, 0]
type = Turn
trigger1 = time = 0
trigger1 = p2dist X < -5

[State 52, 1]
type = VelSet
trigger1 = time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = time = 0
y = 0

[State 52, 着地音]
type = PlaySnd
trigger1 = time = 0
value = S10, 9

[State 52, 3]
type = CtrlSet
trigger1 = prevstateno != 1760
trigger1 = time = 3
trigger2 = prevstateno = 1760
trigger2 = time = 1
value = 1
ignorehitpause = 1

[State 52, ジャンプ着地終了]
type = ChangeState
trigger1 = prevstateno != 1760
trigger1 = animtime = 0
trigger2 = prevstateno = 1760
trigger2 = time = 1
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; 立ち食らい中
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 5001 ;HITG_SLIDE

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; しゃがみ食らい中
[Statedef 5010]
type    = C
movetype= H
physics = N
velset = 0,0

[State 5010, Sonしゃがみ時2ヒット以上で立ち食らいへ強制移行]
type = ChangeState
trigger1 = var(49)
trigger1 = 1
trigger1 = GethitVar(hitcount) > 2
value = 5000

[State 5010, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = 5020 + GetHitVar(animtype)

[State 5010, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5010, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5010, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5010, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
triggerall = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 5010, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 5011 ;HITC_SLIDE

[State 5010, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5010, FFB Light]
type = ForceFeedback
trigger1 = anim = 5020
persistent = 0
time = 6
waveform = square

[State 5010, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5021
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5010, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5022
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; ダウンor空中立て直し分岐
[Statedef 5035]
type    = A
movetype= H
physics = N

[State 5035, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(5035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5035

[State 5035, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5035, 3]
type = ChangeState
trigger1 = !HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = !HitFall
trigger2 = Animtime = 0 ;Animation over
trigger3 = !HitFall
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = !HitFall
trigger4 = time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
trigger5 = HitFall
trigger5 = var(49) = 10000
value = 5040 ;HITA_RECOV

[State 5035, 4]
type = ChangeState
triggerall = HitFall
triggerall = var(49) = 0
trigger1 = HitOver  ;Hit is over
trigger2 = Animtime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 5050 ;HITA_FALL

;---------------------------------------------------------------------------
; ガード(ガード開始)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, Soff時]
type = ChangeAnim
trigger1 = !var(49)
trigger1 = time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, Son時]
type = ChangeAnim
trigger1 = var(49)
trigger1 = time = 0
value = 30120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = Animtime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; 立ちガード中
[Statedef 150]
type    = S
physics = N
velset = 0,0

[State 150, Soff時]
type = ChangeAnim
trigger1 = !var(49)
trigger1 = 1
value = 150

[State 150, Son時]
type = ChangeAnim
trigger1 = var(49)
trigger1 = 1
value = 30150

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, Son/Soffで削りダメージ有無切り替え（Soff時）]
type = StateTypeSet
trigger1 = !var(49)
trigger1 = 1
movetype = H

[State 150, Son/Soffで削りダメージ有無切り替え（Son時）]
type = StateTypeSet
trigger1 = var(49)
trigger1 = 1
movetype = I

[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

;---------------------------------------------------------------------------
; 立ちガード後スライド中
[Statedef 151]
type    = S
physics = S
anim = ifelse(!var(49),150,30150)

[State 151, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 151, 2]
type = VelSet
trigger1 = Time = GetHitVar(slidetime)
trigger2 = HitOver
x = 0

[State 151, 3]
type = CtrlSet
trigger1 = Time = GetHitVar(ctrltime)
value = 1

[State 151, Son/Soffで削りダメージ有無切り替え（Soff時）]
type = StateTypeSet
trigger1 = !var(49)
trigger1 = 1
movetype = H

[State 151, Son/Soffで削りダメージ有無切り替え（Son時）]
type = StateTypeSet
trigger1 = var(49)
trigger1 = 1
movetype = I

[State 151, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 151, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 151, 4]
type = ChangeState
trigger1 = HitOver
value = 130
ctrl = 1

;---------------------------------------------------------------------------
