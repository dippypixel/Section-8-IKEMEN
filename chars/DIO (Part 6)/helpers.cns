;------------------------------------------------------------------------------
;タンデムアタック - 入力ヘルパー
[Statedef 10800]
type = S
sprpriority = -1
anim = 11111
velset = 0,0
ctrl = 0

;===============================
;var(0)  ボタン押した数(順番も兼ねる)
;===============================

[State 10800,レンジセット - 0～59までをクリア]
type = varrangeset
triggerall = root,stateno = 800
trigger1 = root,time = 0
value = 0
first = 0
last = 59

[State 10800,タンデム - ボタン入力数varを設定]
type = varadd
triggerall = root,stateno = 800
trigger1 = root,command = "x" && root,command = "a"
trigger2 = root,command = "x" && root,command = "y"
trigger3 = root,command = "a" && root,command = "x"
trigger4 = root,command = "a" && root,command = "y"
trigger5 = root,command = "y" && root,command = "x"
trigger6 = root,command = "y" && root,command = "a"
trigger7 = root,command = "x" && root,command = "a" && root,command = "y"
trigger8 = root,command = "x"
trigger9 = root,command = "a"
trigger10 = root,command = "y"
v = 0
value = 1

;==============================
;入力開始
;==============================
;チェックメイトだッッ！
[State 10800,1]
type = varadd
triggerall = root,stateno = 800
triggerall = !fvar(1+var(0))
trigger1 = root,time >= 15
trigger1 = root,command="チェックメイト1" || root,command="チェックメイト2"
fv = 1+(var(0))
value = 9

;無駄ァ！
[State 10800,1]
