;==================================================================================================
[Statedef -1]

[State -1, Pucci's Assist]
type = ChangeState
value = 7800
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = !var(49)
triggerall = !var(51)        ;スタンド出現中でない場合
triggerall = !var(7)         ;タンデム中でない場合
triggerall = !var(2)         ;時間停止中でない場合
triggerall = !command = "holddown"
triggerall = command = "Pucci's Assist"
triggerall = power >=4600
triggerall = statetype = S
trigger1 = ctrl = 1

[State -1, Single Knife Throw]
type = ChangeState
value = 7850
triggerall = command != "holddown"
triggerall = command = "Single Knife Throw"
triggerall = power >=600
triggerall = statetype = S
trigger1 = ctrl = 1

[State -1, Vaporizing Freeze]
type = ChangeState
value = 7880
triggerall = !var(59)        ;AI OFFの場合
triggerall = !var(49)
triggerall = !var(51)        ;スタンド出現中でない場合
triggerall = !var(7)         ;タンデム中でない場合
triggerall = !var(2)         ;時間停止中でない場合
triggerall = !command = "holddown"
triggerall = command = "Vaporizing Freeze"
triggerall = power >=300
triggerall = statetype = S
trigger1 = ctrl = 1

[State -1, 状態キャンセル（ダッシュ）]
type = ChangeState
value = 100
triggerall = !winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = prevstateno != [100,105]
triggerall = statetype != A
triggerall = command = "FF"
trigger1 = stateno = 200 && animelemtime(4) >= 2 ;立ち弱
trigger2 = stateno = 300 && animelemtime(4) >= 2 ;屈み弱
trigger3 = stateno = 201 && animelemtime(4) >= 2 ;立ち弱(Son)
trigger4 = stateno = 311 && animelemtime(7) >= 2 ;ダッシュ屈み中(Son)
trigger4 = prevstateno = 100
ctrl = 1

[State -1, 状態キャンセル（ジャンプ）]
type = ChangeState
value = 40
triggerall = !winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = prevstateno != [100,105]
triggerall = statetype != A
triggerall = command = "holdup"
trigger1 = stateno = 200 && animelemtime(4) >= 2 ;立ち弱
trigger2 = stateno = 300 && animelemtime(4) >= 2 ;屈み弱
trigger3 = stateno = 201 && animelemtime(4) >= 2 ;立ち弱(Son)
trigger4 = stateno = 311 && animelemtime(7) >= 2 ;ダッシュ屈み中(Son)
trigger4 = prevstateno = 100
ctrl = 1

[State -1, 状態キャンセル（屈み）]
type = ChangeState
value = 10
triggerall = !winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = prevstateno != [100,105]
triggerall = statetype != A
triggerall = command = "holddown"
trigger1 = stateno = 200 && animelemtime(4) >= 2 ;立ち弱
trigger2 = stateno = 201 && animelemtime(4) >= 2 ;立ち弱(Son)
ctrl = 1

[State -1, 状態キャンセル（立ち）]
type = ChangeState
value = 12
triggerall = !winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = prevstateno != [100,105]
trigger1 = command != "holddown"
trigger1 = stateno = 300 && animelemtime(4) >= 1 ;屈み弱
ctrl = 1

[State -1, 状態キャンセル（歩き）]
type = ChangeState
value = 20
triggerall = !winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = prevstateno != [100,105]
triggerall = statetype != A
triggerall = command = "holdfwd" || command = "holdback"
trigger1 = stateno = 200 && animelemtime(4) >= 2 ;立ち弱
trigger2 = stateno = 300 && animelemtime(4) >= 2 ;屈み弱
trigger3 = stateno = 201 && animelemtime(4) >= 2 ;立ち弱(Son)
ctrl = 1

;==================================================================================================
;超必
;==================================================================================================
[State -1, 世界(THE WORLD)本体モード]
type = ChangeState
value = 4900
triggerall = !winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = var(56) != [2,3]        ;時止めバグ
triggerall = !var(49)        ;本体モード時のみ
triggerall = !var(51)        ;スタンド出現中でない場合
triggerall = !var(7)         ;タンデム中でない場合
triggerall = !var(2)         ;時間停止中でない場合
triggerall = statetype != A
triggerall = power >= 3000
triggerall = command = "ザ・ワールド"
trigger1 = ctrl
trigger2 = stateno = 200 ;立ち弱
trigger2 = movecontact
trigger3 = stateno = 210 ;立ち中
trigger3 = movecontact
trigger4 = stateno = 220 ;立ち強
trigger4 = movecontact
trigger5 = stateno = 300 ;屈み弱
trigger5 = movecontact
trigger6 = stateno = 310 ;屈み中
trigger6 = movecontact
trigger7 = stateno = 320 ;屈み強
trigger7 = movecontact
trigger8 = stateno = 330 ;スライディング
trigger8 = movecontact
trigger9 = stateno = 100 ;ダッシュ
trigger9 = time >= 4
trigger10 = stateno = 195 ;挑発
trigger10 = time >= 4
trigger11 = stateno = 200 && time >= 4 ;立ち弱
trigger11 = !movecontact
trigger12 = stateno = 210 && time >= 8 ;立ち中
trigger12 = !movecontact
trigger13 = stateno = 220 && time >= 4 ;立ち強
trigger13 = !movecontact
trigger14 = stateno = 300 && time >= 4 ;屈み弱
trigger14 = !movecontact
trigger15 = stateno = 310 && time >= 8 ;屈み中
trigger15 = !movecontact
trigger16 = stateno = 320 && time >= 10 ;屈み強
trigger16 = !movecontact
trigger17 = stateno = 330 && time >= 8 ;スライディング
trigger17 = !movecontact

[State -1, 世界(THE WORLD) バグ専用]
type = ChangeState
value = 4950
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = var(56) != [2,3]        ;時止めバグ
triggerall = var(49)         ;STモード時のみ
triggerall = !var(51)        ;スタンド出現中でない場合
triggerall = !var(7)         ;タンデム中でない場合
