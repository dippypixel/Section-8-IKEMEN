;▼MAX2▼

[State -2, MAX2 Cooldown] ;MAX2使用後しばらくは再使用不可
type = VarAdd
triggerall = !IsHelper
trigger1 = 1
var(14) = -1
ignorehitpause = 1

[State -2, MAX2 Cooldown Start]
type = VarSet
triggerall = !IsHelper
trigger1 = Var(14) <= -5
var(14) = 220
ignorehitpause = 1

[State -2, MAX2 Cooldown]
type = VarSet
triggerall = !IsHelper
trigger1 = Var(14) <= 0
var(14) = 1 -(Floor((Life*1000)/LifeMax) <= 300)
ignorehitpause = 1


;以下、キャラクターごとのMAX2処理

[State -2, Nami Kyara no Hensuu Ijiruna Voke ga!!] ;変な値が入っていたら0にする
