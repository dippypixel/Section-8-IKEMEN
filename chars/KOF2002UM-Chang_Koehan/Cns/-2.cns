triggerall = !IsHelper
trigger1 = 1
fvar(3) = (1000/132)
ignorehitpause = 1


;---------------------------------------------------------------------------
;▼強化モード▼

[State -2, Attack UP 2] ;ゴールドカラーは攻撃力2倍
type = VarSet
triggerall = !IsHelper
trigger1 = Var(57) = 2 || Var(57) = 5
fvar(0) = FVar(0)*2
ignorehitpause = 1

[State -2, Defence UP] ;ゴールドカラーは被ダメージ0.66倍
type = DefenceMulSet
triggerall = !IsHelper
trigger1 = Var(57) = 2 || Var(57) = 5
value = 0.66*(100/(100 +Const(Data.Fall.Defence_Mul)*(StateType = L)))
ignorehitpause = 1

[State -2, Auto Power Regene] ;パワーゲージ自動回復
type = PowerSet
triggerall = !IsHelper
trigger1 = (Var(57) = [1, 2]) || (Var(57) = [4, 5])
value = PowerMax
ignorehitpause = 1


