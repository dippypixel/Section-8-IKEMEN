;必殺技・超必殺技のステート


;===========================================================================
;---------------------------------------------------------------------------
;▼鉄球大回転（弱）▼

[Statedef 1000]
type    = S
movetype= A
physics = N
poweradd = Floor(4*FVar(3))
juggle = 0
anim = 1000
ctrl = 0
sprpriority = 2
velset = 0, 0
facep2 = 1

[State 1000, 0] ;半数補正リセット
type = VarSet
trigger1 = 1
fvar(2) = 1

[State 1000, 1]
type = ChangeState
trigger1 = 1
value = StateNo +1
ctrl = 0


;---------------------------------------------------------------------------
;▼鉄球大回転（弱） 攻撃▼

[Statedef 1001]
type    = U
movetype= U
physics = U
juggle = 0
ctrl = 0
sprpriority = 2

[State 1001, 0] ;ダメージ基礎値
type = Null
trigger1 = Var(57) = [0, 2]
trigger1 = Var(7) := IfElse(Var(18) = 0, 7, 9)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 8, 10)
ignorehitpause = 1

[State 1001, 1] ;ガークラ基礎値
type = Null
trigger1 = Var(27) := 2

[State 1001, 2] ;カウンター
type = Helper
triggerall = RoundState < 3
triggerall = Var(18)
triggerall = !(HitdefAttr = SCA, NT, ST, HT)
trigger1 = MoveHit = 1
id = 9990
helpertype = Normal
name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 1001, 3] ;追撃不能
type = VarSet
triggerall = Var(57)%3 != 2
triggerall = P2StateType = A
trigger1 = MoveHit = 1
var(9) = IfElse(Var(18) = 0, 1, Var(9))
ignorehitpause = 1
persistent = 0

[State 1001, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 1001, 5] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(1000)
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 1000
value = 5910
ignorehitpause = 1
persistent = 0

[State 1001, 6] ;半数補正
type = VarSet
;triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = MoveContact = 1
fvar(2) = FVar(2)*0.5
ignorehitpause = 1
persistent = 0

[State 1001, 7] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 1001, 8] ;アニメ固定
type = ChangeAnim
trigger1 = Anim != 1000
value = 1000

[State 1001, 9] ;攻撃判定リセット
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 1001, 10]
type = NotHitBy
trigger1 = Var(57)%3 = 2
value = , NA, SA, HA, NP, SP, HP, NT, ST, HT
ignorehitpause = 1

[State 1001, 11] ;むううぅぅん
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S10, 9
channel = 0

[State 1001, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 1002
ctrl = 0


;---------------------------------------------------------------------------
;▼鉄球大回転（弱） ループ▼

[Statedef 1002]
type    = U
movetype= U
physics = U
juggle = 0
ctrl = 0
sprpriority = 2

[State 1002, 0] ;ダメージ基礎値
type = Null
trigger1 = Var(57) = [0, 2]
trigger1 = Var(7) := IfElse(Var(18) = 0, 7, 9)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 8, 10)
ignorehitpause = 1

[State 1002, 1] ;ガークラ基礎値
type = Null
trigger1 = Var(27) := 2

[State 1002, 2] ;カウンター
type = Helper
triggerall = RoundState < 3
triggerall = Var(18)
triggerall = !(HitdefAttr = SCA, NT, ST, HT)
trigger1 = MoveHit = 1
id = 9990
helpertype = Normal
name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 1002, 3] ;追撃不能
type = VarSet
triggerall = Var(57)%3 != 2
triggerall = P2StateType = A
trigger1 = MoveHit = 1
var(9) = IfElse(Var(18) = 0, 1, Var(9))
ignorehitpause = 1
persistent = 0

[State 1002, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 1002, 5] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(1000)
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 1000
value = 5910
ignorehitpause = 1
persistent = 0

[State 1002, 6] ;半数補正
type = VarSet
;triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = MoveContact = 1
fvar(2) = FVar(2)*0.5
ignorehitpause = 1
persistent = 0

[State 1002, 7] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 1002, 8] ;アニメ固定
type = ChangeAnim
trigger1 = Anim != 1001
value = 1001

[State 1002, 9] ;攻撃判定リセット
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 1002, 10]
type = NotHitBy
trigger1 = Var(57)%3 = 2
value = , NA, SA, NP, HP, NT, ST, HT
ignorehitpause = 1

[State 1002, 11] ;アーマー
type = Helper
trigger1 = Var(57)%3 = 2
trigger1 = !NumHelper(1007)
id = 1007
helpertype = Normal
name = "Daikaiten Armor"
stateno = 2100
pos = 0, 0
postype = P1
supermovetime = 999999
pausemovetime = 999999
size.xscale = Const(Size.XScale)
size.yscale = Const(Size.YScale)
size.ground.back = Const(Size.Ground.Back)
size.ground.front = Const(Size.Ground.Front)
size.air.back = Const(Size.Air.Back)
size.air.front = Const(Size.Air.Front)
size.height = Const(Size.Height)
size.head.pos = Const(Size.Head.Pos.X), Const(Size.Head.Pos.Y)
size.mid.pos = Const(Size.Mid.Pos.X), Const(Size.Mid.Pos.Y)
ignorehitpause = 1

[State 1002, 12] ;鉄球
type = Helper
trigger1 = !NumHelper(1005)
id = 1005
helpertype = Normal
name = "Iron Ball"
stateno = 1005
pos = 15, 0
postype = P1
supermovetime = 999999*(Var(16) > 0)
pausemovetime = 999999*(Var(16) > 0)

[State 1002, 13]
type = VelSet
trigger1 = Var(59) <= 0 || Var(54) = 1
x = 1*(Command = "holdfwd") - 1*(Command = "holdback")

[State 1002, 14]
type = VelSet
trigger1 = Var(59) > 0 && Var(54) > 1
x = 1*(FVar(25) >= 65) - 1*(FVar(25) < 0)

[State 1002, 15]
type = ChangeState
triggerall = Time > 0
trigger1 = Time >= 90
trigger2 = Var(59) <= 0 || Var(54) = 1
trigger2 = Command = "x" && Command = "y" && Command = "a" && Command = "b"
value = 1003
ctrl = 0

[State 1002, 16]
type = ChangeState
triggerall = Time > 2*Var(54)
triggerall = Var(59) > 0 && Var(54) > 1
triggerall = Random < 70*Var(54) || Var(54) > 5
trigger1 = P2MoveType = A && P2StateType = C
trigger2 = P2MoveType = H && ((P2StateNo != [150, 159]) && P2StateType = A)
trigger2 = FVar(25) != [-60, 70]
trigger2 = FrontEdgeBodyDist > 70
trigger3 = P2MoveType != A || P2StateType = A
trigger3 = FVar(25) != [-60, 70]
value = 1003
ctrl = 0


;---------------------------------------------------------------------------
;▼鉄球大回転（弱強共通） 攻撃停止▼

[Statedef 1003]
type = S
movetype = I
physics = S
anim = 1002
ctrl = 0
velset = 0, 0
sprpriority = 2

[State 1003, 0]
type = StopSnd
trigger1 = AnimElemTime(1) = 0
channel = 0

[State 1003, 1]
type = ChangeState
trigger1 = Var(57)%3 = 2
value = 0
ctrl = 1

[State 1003, 2]
type = Explod
trigger1 = AnimElemTime(1) = 0
anim = 1006
id = 1006
pos = 0, 0
postype = P1
sprpriority = 1
bindtime = -1
removeonhit = 1
supermovetime = 999999*(Var(16) > 0)
pausemovetime = 999999*(Var(16) > 0)

[State 1003, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
;▼鉄球大回転（弱） どこキャン▼

[Statedef 1009]
type    = U
movetype= U
physics = U

[State 1009, 0] ;どこキャン処理（体光る）
type = PalFX
trigger1 = Time = 0
time = 7
add = 255, 255, 255

[State 1009, 1] ;どこキャン処理（残り時間減少）
type = VarAdd
trigger1 = Time = 0
var(15) = -150

[State 1009, 2]
type = ChangeState
trigger1 = Time = 0
value = StateNo -9
ctrl = 0


