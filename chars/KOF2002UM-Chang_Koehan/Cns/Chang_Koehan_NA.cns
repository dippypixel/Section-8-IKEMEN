;▼破顔撃 掴まれた相手1▼
; 
;     ここは投げられた瞬間の相手のステートです
;     たいしたことは書いてありませんがtypeがAになっている事です。
;     相手が投げれて空中にいる事を設定して次の821ステートに移動します

[Statedef 820]
type = U
movetype = H
physics = N
velset = 0, 0
sprpriority = 1

[State 820, 0]
type = SelfState
trigger1 = Alive
trigger1 = PrevStateNo = [150, 159]
value = PrevStateNo
ignorehitpause = 1

[State 820, 1]
type = NotHitBy
trigger1 = 1
value = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
ignorehitpause = 1

[State 820, 2]
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

[State 820, 3]
type = StateTypeSet
trigger1 = AnimElemTime(1) = 0
statetype = S

[State 820, 4]
type = StateTypeSet
trigger1 = AnimElemTime(2) >= 0
statetype = A

[State 820, 5]
type = OffSet
trigger1 = AnimElemTime(2) >= 0
y = -Ceil((Const(Size.Head.Pos.Y) -Const(Size.Mid.Pos.Y))*0.25)

[State 820, 6]
type = SelfState
trigger1 = Time >= 600
value = 5100


;---------------------------------------------------------------------------
;▼破顔撃 掴まれた相手2▼
;     
;     これは投げられている相手の状態ととれる行動を設定しています
;     type = SelfStateは相手のリカバー状態を設定する物でこの状態ならこれ。
;     と言うように地上近く、空中、叩きつけられた時と３つ設定しています。

[Statedef 821]
type    = A
movetype= H
physics = N
velset = -5, -7.5
sprpriority = 2

[State 821, 0]
type = VelAdd
Trigger1 = 1
y = .5

[State 821, 1]
type = NotHitBy
trigger1 = 1
value = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
ignorehitpause = 1

[State 821, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 5030

[State 821, 3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 821, 4]
type = PosSet
triggerall = 0
trigger1 = Time = 0
trigger1 = (-64 -Const(Size.Head.Pos.Y)) < 0
y = Ceil(-64 -Const(Size.Head.Pos.Y))

[State 821, 5]
type = ChangeAnim
triggerall = SelfAnimExist(5035)
trigger1 = Anim = 5030
trigger1 = AnimTime = 0
value = 5035

[State 821, 5]
type = ChangeAnim
triggerall = Anim != 5050
trigger1 = Anim = 5035
trigger1 = AnimTime = 0
trigger2 = Vel Y > 0
value = 5050

[State 821, 5] 
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 


