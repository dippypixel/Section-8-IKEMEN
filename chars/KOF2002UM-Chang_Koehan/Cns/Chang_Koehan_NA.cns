
;---------------------------------------------------------------------------
;▼近距離立ち弱パンチ▼

[Statedef 200]
type    = S                      
movetype= A
physics = S                                            
;Commonly-used controllers:
anim = 200
juggle = 0
ctrl = 0                         ;このステート中に他のコマンドを受け付けるか(1で受け付ける)
sprpriority = 2                  ;表示した絵の重なり具合(2一番前　0通常　-1奥)

[State 200, 0] ;半数補正リセット
type = VarSet
trigger1 = 1
fvar(2) = 1

[State 200, 1]
type = ChangeState
trigger1 = 1
value = StateNo +1
ctrl = 0


;---------------------------------------------------------------------------
;▼近距離立ち弱パンチ 攻撃▼

[Statedef 201]
type = U
movetype = U
physics = U
juggle = 0
ctrl = 0
sprpriority = 2

[State 201, -2] ;時止め中
type = VarAdd
triggerall = Var(16) > 0
trigger1 = MoveHit = 1
trigger1 = Var(12) := Facing
var(17) = Var(7)
ignorehitpause = 1
persistent = 0

[State 201, -1] ;時止め中
type = TargetState
triggerall = Var(16) > 0
triggerall = NumTarget(200)
triggerall = MoveHit = 1
trigger1 = !MoveGuarded
id = 200
value = 3280
ignorehitpause = 1
persistent = 0

[State 201, 0] ;ダメージ基礎値
type = Null
trigger1 = Var(57) = [0, 2]
trigger1 = Var(7) := IfElse(Var(18) = 0, 6, 8)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 6, 8)
ignorehitpause = 1

[State 201, 1] ;ガークラ基礎値
type = Null
trigger1 = Var(27) := 6

[State 201, 2] ;カウンター
type = Helper
triggerall = RoundState < 3
triggerall = Var(18)
triggerall = !(HitdefAttr = SCA, NT, ST, HT)
trigger1 = MoveHit = 1
id = 9990
helpertype = Normal
name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 201, 3] ;追撃不能
type = VarSet
triggerall = Var(57)%3 != 2
triggerall = Var(16) = 0
triggerall = P2StateType = A
trigger1 = MoveHit = 1
var(8) = IfElse(Var(18) = 0, 1, Var(8))
ignorehitpause = 1
persistent = 0

[State 201, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 201, 5] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(200)
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 200
value = 5910
ignorehitpause = 1
persistent = 0

[State 201, 6] ;半数補正
type = VarSet
triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = MoveContact = 1
fvar(2) = FVar(2)*0.5
ignorehitpause = 1
persistent = 0

[State 201, 7] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 201, 8] ;アニメ固定
type = ChangeAnim
trigger1 = Anim != 200
value = 200

[State 201, 9] ;攻撃判定リセット
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 201, 10] ;ふん！
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S10, 0 +(Random%3)
channel = 0

[State 201, 11] ;素振り音
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S0, 0

[State 201, 12]
type = HitDef
triggerall = !Var(8)
triggerall = !MoveContact && !MoveReversed
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
attr = S, NA
damage = Var(7)*(Var(16) = 0), 0
animtype = Light
air.animtype = Light
guardflag = M
hitflag = MAF
priority = 4, Hit
pausetime = 8, 9
guard.pausetime = 8, 7
sparkno = S4000
sparkxy = -10, -84
hitsound = S5, 0 +(Random%3)
guardsound = S6, 0
ground.type = High
ground.slidetime = 9
guard.slidetime = 9
ground.hittime = 9
guard.hittime = 9
guard.ctrltime = 9
yaccel = 0.5
ground.velocity = -5
air.type = High
air.velocity = -3, -6.25
airguard.velocity = -5, 0
ground.cornerpush.veloff = 0
air.hittime = 30
fall.recovertime = 34
fall.yvelocity = -2
id = 200
nochainid = 9998, 9999
getpower = Floor(12*FVar(3)), Floor(12*FVar(3))
givepower = 15, 15

[State 200, 13]
type = StateTypeSet
trigger1 = AnimElemTime(5) >= 0
movetype = I

[State 200, 14]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


