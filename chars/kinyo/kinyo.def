; Definition file for a character
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Kinyo Roadshow Opening"        ;Name of character
displayname = "Kinyo Roadshow" ;Name of character to display
versiondate = 04,01,2018    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 1,4,5,2,3,7,9,8,12,11,10


; Files for the player
[Files]
cmd     = kinyo.cmd   ;Command set
cns     = kinyo.cns   ;Constants
st      = kinyo.cns   ;States
st3     = config.txt
st4     = kame.st
stcommon = common1.cns ;Common states
sprite  = kinyo.sff   ;Sprite
anim    = kinyo.air   ;Animation
sound   = kinyo.snd   ;Sound
pal1    = kinyo.act
pal2    = kinyo2.act
pal3    = kinyo3.act
pal4    = kinyo4.act
pal5    = kinyo5.act
pal6    = kinyo6.act
pal7    = kinyo7.act
pal8    = kinyo8.act
pal9    = kinyo9.act
pal10    = kinyo10.act
pal11    = kinyo11.act
pal12    = kinyo12.act




; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
