;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = N

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2;Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State 0, Turn]
type = Turn
trigger1 = p2dist x < -20

[State 0, ScreenBound]
type = ScreenBound
trigger1 = screenpos y < 40
trigger1 = prevstateno = 40
value = 1
movecamera = 1,0
ignorehitpause = 1

[State 0, Air control]
type = VelSet
trigger1 = command = "holdfwd"
trigger2 = var(52) = 41
x = ifelse(vel x+1>const(velocity.jump.fwd.x),const(velocity.jump.fwd.x),vel x+1)
[State 0, Air control]
type = VelSet
trigger1 = command = "holdback"
trigger2 = var(52) = 43
x = ifelse(vel x-1<const(velocity.jump.back.x),const(velocity.jump.back.x),vel x-1)
[State Gravity]
type = VelSet
trigger1 = time > 0
y = vel y + ifelse(command="holdup",0.197,0.88)


[State 0, ChangeState]
type = ChangeState
trigger1 = vel y > 0
trigger1 = vel y + pos y >= 0
value = 52
ctrl = 0




