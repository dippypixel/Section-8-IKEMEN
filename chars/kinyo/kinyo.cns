trigger1 = time = 0
sysvar(0) = 0
ignorehitpause = 1
[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(0) = 0
ignorehitpause = 1

[State 5120, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 5120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 5120, 1a] ;Get up anim (roll forward)
type = VarSet
triggerall = time = 0
trigger1 = command = "holdfwd"
fvar(0) = 1
[State 5120, 1a] ;Get up anim (roll backward)
type = VarSet
triggerall = time = 0
trigger1 = command = "holdback"
fvar(0) = -1

[State 5120, 2]
type = VelSet
trigger1 = Time = 0
trigger2 = animelem = 17
x = 0

[State 5120, 2]
type = VelSet
trigger1 = animelem = 7
x = 7.1*fvar(0)

[State 0, PlayerPush]
type = PlayerPush
trigger1 = fvar(0)
trigger1 = animelemtime(7) >= 0
trigger1 = animelemtime(17) < 0
value = 0
ignorehitpause = 1

[State 5120, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5120, 4]
type = HitFallSet
trigger1 = AnimTime = 0
value = 1

[State 5120, 5] ;Can't be thrown right after getting up
