type = VarSet
triggerall = command != "upper_what"
trigger1 = !fvar(35)
trigger1 = command = "y"
var(2) = 610
[State 40, 1]
type = VarSet
triggerall = command != "upper_what"
trigger1 = !fvar(35)
trigger1 = command = "z"
var(2) = 620
