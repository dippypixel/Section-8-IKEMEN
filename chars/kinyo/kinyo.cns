[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(2) = 0
[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(3) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = fvar(35) && (var(52) = 41 || var(52) = 44)
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
trigger2 = fvar(35) && (var(52) = 42 || var(52) = 45)
sysvar(1) = -1
[State 40, 1]
type = VarSet
trigger1 = command = "SupahJump"
trigger1 = command != "ChargedSupahJump"
trigger2 = fvar(35) && (var(52) = [43,45])
sysvar(2) = 1
[State 40, 3]
type = VarAdd
triggerall = time
trigger1 = command = "holdup"
trigger2 = var(52) = [41,43]
sysvar(3) = 1
[State 40, 3]
type = VarAdd
triggerall = time
