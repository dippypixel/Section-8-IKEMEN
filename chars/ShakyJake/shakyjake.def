; Player information
[Info]
name = "Shaky Jake"        ;Name of character
displayname = "Shaky Jake" ;Name of character to display
versiondate = 1.0   ;Version date of character (MM-DD-YYYY)
mugenversion = 1.0   ;Version of M.U.G.E.N character works on
author = "MelvanaInChains"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = shakyjake.cmd   ;Command set
cns     = shakyjake.cns   ;Constants
st      = shakyjake.cns   ;States
stcommon = common1.cns ;Common states
sprite  = shakyjake.sff   ;Sprite
anim    = shakyjake.air   ;Animation
sound   = shakyjake.snd   ;Sound
pal1    = shakyjake.act  ;Palettes (can have up to 12)
pal2    = alternate.act
pal3    = leechaolan.act
pal4    = mongo.act
pal5    = dekecay.act
pal6    = hades.act
pal7    = tommy.act
pal8    = zabel.act
pal9    = albiole.act
pal10   = tigerjackson.act
pal11   = sundanceshot.act
pal12   = subbossshadow.act
; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
