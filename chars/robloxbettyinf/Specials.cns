trigger1 = animelem = 15
x = 2
y = 2

[State 0, VelSet]
type = VelSet
trigger1 = animelemtime(15) >= 0 && movehit = 1
x = 2
y = -3

;---------------------------------------------------------------------------
; Slap
[Statedef 1050]
type    = S
movetype= A
physics = S
juggle  = 6
poweradd= 50
velset = 0,0
anim = 1050
ctrl = 0
sprpriority = 2

[State 0, PlaySnd]
type = PlaySnd
trigger1 = movehit = 1
value = S1000,1+ (random % 5)
channel = 1
ignorehitpause = 1
persistent = 0 ; I FINALLY FOUND THE PURPOSE OF THIS


[State 0, Width]
type = Width
trigger1 = animelemtime(5) >= 0
edge = 0,0
player = -25,50

[State 0, AngleDraw]
type = AngleDraw
trigger1 = animtime != 0
;value = 1
scale = .5,.5
ignorehitpause = 1

[State 0, AngleSet]
type = AngleSet
trigger1 = animtime != 0
value = 0

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 4
x = 10

[State 0, PosAdd]
type = PosAdd
trigger1 = animelem = 5
x = -20

[State 1000, 1]
type = PlaySnd
trigger1 = animelem = 4
value = 0, 5

[State 1000, 6] ;Opponent not near
type = HitDef
trigger1 = time = 0
attr = S, SA
animtype  = Hard
damage    = 115, 4
getpower  = 250
priority  = 4
guardflag = MA
pausetime = 12,15
sparkxy = -10,-60
sparkno = S7031
guard.sparkno = S7001 
hitsound   = S5,4
guardsound = S6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 15
ground.velocity = -10,-3
air.velocity = -10,-2
envshake.time = 7
envshake.freq = 80
envshake.ampl = -5
envshake.phase = 90
fall = 1

[State 0, AngleDraw]
type = AngleDraw
trigger1 = animtime = 0
;value = 1
scale = 1,1
ignorehitpause = 1

[State 1000, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

