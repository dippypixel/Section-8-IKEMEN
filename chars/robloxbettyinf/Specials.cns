trigger1 = animelemtime(15) <= 0
y = .125


[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 15
;trigger2 = prevstateno = [7050,7150]
statetype = A       ;S,A,C,L
movetype = A        ;I,A,H
physics = A         ;A,C,S,N

[State 0, VelAdd]
