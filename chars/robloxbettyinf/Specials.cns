sparkno = S7021
guard.sparkno = S7001 
hitsound   = S5,11
guardsound = S6,0
ground.type = Low
ground.slidetime = 12
ground.hittime  = 10
ground.velocity = -7
air.velocity = -4,-2.5

[State 0, VelAdd]
