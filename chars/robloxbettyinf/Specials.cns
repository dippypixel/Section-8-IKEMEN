;---------------------------------------------------------------------------
; Sword Slash 4/Air
[Statedef 1030]
type    = A
movetype= A
physics = N
juggle  = 2
poweradd= 25
velset = 3.5,-3
anim = 1030
ctrl = 0
sprpriority = 2

[State 0, NotHitBy]
type = NotHitBy
trigger1 = animelemtime(3) >= 0 && animelemtime(14) <= 0 
value = SCA,NP,SP,HP
time = 1 

[State 1000, 1]
type = PlaySnd
trigger1 = animelem = 3 || animelem = 12 
value = 0, 6

[State 1000, 1]
type = PlaySnd
trigger1 = animelem = 6 || animelem = 8 || animelem = 10
value = 0, 7

[State 1000, 1]
type = PlaySnd
trigger1 = animelem = 15
value = 0, 2

[State 1000, 6] ;Opponent not near
type = HitDef
trigger1 = animelem = 2  || animelem = 5 || animelem = 7 || animelem = 9 || animelem = 11 || animelem = 13
attr = A, SA
animtype  = Hard
damage    = 15, 1
getpower  = 33
priority  = 4
guardflag = MA
pausetime = 4,8
sparkxy = 0-random%40,-38-random%20
sparkno = S7021
guard.sparkno = S7001 
hitsound   = S5,11
guardsound = S6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 15
ground.velocity = -3,-4
air.velocity = -3.45,ifelse(P2dist Y <= 0, -2.8, -3.05)

