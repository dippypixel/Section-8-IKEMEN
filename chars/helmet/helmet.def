; Definition file for a character
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Helmet"        ;Name of character
displayname = "Helmet" ;Name of character to display
versiondate = 01,22,2018    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 1,2,3,4,5,6


; Files for the player
[Files]
cmd     = helmet.cmd   ;Command set
cns     = helmet.cns   ;Constants
st      = helmet.cns   ;States
st3     = config.txt
st4     = kame.st
stcommon = common1.cns ;Common states
sprite  = helmet.sff   ;Sprite
anim    = helmet.air   ;Animation
sound   = helmet.snd   ;Sound
pal1    = helmet1.act
pal2    = helmet2.act
pal3    = helmet3.act
pal4    = helmet4.act
pal5    = helmet5.act
pal6    = helmet6.act



; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
