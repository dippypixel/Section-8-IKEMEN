; Definition file for the number one threat to America
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Mr. Bear"
displayname = "Mr. Bear"
versiondate = 08,29,2010
mugenversion = 04,14,2002
author = "The_None"         ;Character author name
pal.defaults = 1

; Files for the player
[Files]
