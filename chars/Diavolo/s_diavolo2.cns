;Config
;---------------------------------------------------------------------------
[Statedef 5900];コモンステート。ラウンド始まり直前
type = U

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900]
Type = VarSet
Trigger1 = 1
var(30) = 0

[State 5900]
Type = VarSet
Trigger1 = 1
var(33) = 1


;---------------------------------------------------------------------------
[State 5900, 3] ;Intro for round 1 
type = ChangeState 
value = 190 
trigger1 = RoundNo = 1 
trigger2 = RoundsExisted = 0 
trigger2 = TeamMode = Turns 
trigger2 = RoundNo > 0 

[State 370009]
Type = Null
Trigger1 = 1
;■■■■■■■■■■
[Statedef 370000];クイックサーチ
Type = A
[State 370010, AssertSpecial]
