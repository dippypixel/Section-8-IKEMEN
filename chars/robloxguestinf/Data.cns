; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 5]
type = Explod
trigger1 = (time%2) = 1
ID = 80
anim = 80
postype = p1
facing = 1
vfacing = 1
pos = -23,-55
bindtime = 1
removetime = 6
ontop = 1
vel = 0,0
ownpal = 1
random = 30,70
sprpriority = 3
scale = .4,.14
removeongethit = 1
ignorehitpause = 1
persistent = 1

[State -3, Sound]
type = PlaySnd
trigger1 = Time = 0
value = 100, 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = var(59) <= 0
trigger1 = command != "holdfwd"
trigger2 = var(59) > 0
trigger2 = time > 10+random%15 || p2bodyDist X <= 20
value = 0

