trigger1 = AnimElemTime(9) >= 0 && AnimElemTime(11) < 0
x = 10
y = 0

[State 0, VelAdd]
type = VelAdd
trigger1 = AnimElemTime(11) >= 0 && anim != 3012
x = 0
