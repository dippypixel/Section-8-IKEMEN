type = ChangeAnim
trigger1 = Time = 120 && movehit && anim != 3011
value = 3011
;elem = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 3011 && pos y >= 0 && anim != 3012
value = 3012

