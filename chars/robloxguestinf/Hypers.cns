fall = 1
fall.recover = 0
yaccel = .6

[State 3000, 7]
type = ChangeState
trigger1 = Time >= 120 && !movehit && movecontact
trigger2 = Time >= 90 && !movecontact
value = 51
anim = 3019
ctrl = 1

