;---------------------------------------------------------------------------
; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(1)  - Used in kfm.cmd for combo condition (updated every tick)
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).
; var(56) - used by the XOR-ed commands method to detect recent custom states.
; var(57) - the GameTime variable, required by the helper and XOR methods.
; var(58) - the primary AI variable.
; var(0)  - the simplifier variable, optional but helpful.

; var(45) - inactive mode?
; var(46) - lol "health"

;---------------------------------------------------------------------------
; HYPER COMBO FINISH
[Statedef 3998]
type    = S
movetype= I
physics = N
ctrl = 0
anim = 9741
sprpriority = 0

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(0) = 1
[State 0, VarSet]
type = VarAdd
trigger1 = time >= 45
fvar(0) = -0.03
[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(1) = 1
[State 0, VarSet]
type = VarSet
trigger1 = time
fvar(1) = ifelse(fvar(1)-0.09<=0,0,fvar(1)-0.09)
[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(2) = 1
[State 0, VarSet]
type = VarSet
trigger1 = time
fvar(2) = fvar(2) * 0.95

