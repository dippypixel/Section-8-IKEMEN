; Definition file for the coolest secret character to ever escape from an ill-fated Mugen game
; Contains all the filenames needed for the character

; Player information
[Info]
name = "DudeREAL EX"        ;Name of character
displayname = "DudeReal EX"
author = "The_None"         ;Character author name
versiondate = 04,01,2021
mugenversion = 1.1
pal.defaults = 1,4,3,2,5,6

; Files for the player
[Files]
cmd     = dudereal.cmd   ;Command set
cns     = dudereal.cns   ;Constants
st	= 11ov.st
st2      = dudereal.cns   ;States
stcommon = common1.cns ;Common states
sprite  = dudereal.sff   ;Sprite
anim    = dudereal.air   ;Animation
sound   = dudereal.snd   ;Sound
pal1    = dudereal.act
pal2    = dudereal2.act
pal3    = dudereal3.act
pal4    = dudereal4.act
pal5    = dudereal5.act
pal6    = dudereal6.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
ending.storyboard = coolending.def
