time = 14
PalBright = 0,0,0
PalContrast =  222,222,222
PalAdd      = -1,-1,-1
PalMul      = .5,.5,.5
Trans = Add
TimeGap  = 1
FrameGap = 2
length = 7

[State 100, 残像]
type = AfterImage
trigger1 = anim = 106
time = 1

[State 100, 3]
type = Changeanim
trigger1 = time = 22
value = 106

[State 100, 3]
type = ChangeState
trigger1 = anim = 106
trigger1 = !animtime
value = 0
ctrl = 1

