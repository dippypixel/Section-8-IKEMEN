type = S

[State 190, 2]
type = ChangeState
triggerall = time = 0 && var(50) != 1
trigger1 = P2Name = "Young Joseph +" || P2Name = "Young Joseph" || P2Name = "Joseph Joestar"
trigger2 = P4Name = "Young Joseph +" || P4Name = "Young Joseph" || P4Name = "Joseph Joestar"
value = 192

[State 190, 1]
type = ChangeState
triggerall = time = 0 && var(50) != 1
trigger1 = P2Name != "Young Joseph +" || P2Name != "Young Joseph" || P2Name != "Joseph Joestar"
trigger2 = P4Name != "Young Joseph +" || P4Name != "Young Joseph" || P4Name != "Joseph Joestar"
value = 191

[State 190, 4]
type = ChangeState
trigger1 = time = 0 && var(50) = 1
value = 194

