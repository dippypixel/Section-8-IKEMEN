type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, ﾌﾊﾊﾊ]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
value = 0, 170
channel = 0

[State 170, 1]
type = AssertSpecial
trigger1 = Time = [0, 400]
flag = RoundNotOver

