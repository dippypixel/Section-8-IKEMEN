[Statedef -2]

[state -2, helper]
type = helper
trigger1 = roundstate = [0,2]
trigger1 = !numhelper(10000)
helpertype = normal
name = "effect"
stateno = 10000
id = 10000
pos = 20,220
postype = back
ownpal = 1
keyctrl = 0
pausemovetime = 99999999
supermovetime = 99999999

[state -2, helper]
type = afterimage
trigger1 = movetype = H && prevstateno = 105
time = 1

;--------------------------------------------------------------------------------
[State -2, クリップボード]
type     = DisplayToClipBoard
trigger1 = 1
text     = "var(58)=%d,var(13)=%d,var(18)=%d,var(5)=%d"
params   = var(58),var(13),var(18),var(5)
IgnoreHitPause = 1

;ストライカーゲージ
[state -2, helper]
type = varset
trigger1 = !var(58)
trigger1 = roundstate = 0 || roundstate = 1
var(58) = 50

[state -2, helper]
type = varset
trigger1 = !var(58)
trigger1 = roundstate = 3
var(58) = 1

[state -2, helper]
type = varadd
triggerall = !var(5)
triggerall = roundstate = 2 && var(12)
trigger1 = var(58) < 50
trigger1 = !(gametime%45)
var(58) = 1

[state -2, helper]
type = varset
trigger1 = var(58) > 50
var(58) = 50
[state -2, helper]
type = varset
trigger1 = var(58) < 0
var(58) = 0

[state -2, helper]
type = varadd
trigger1 = var(5)
var(5) = -1

[state -2, helper]
type = varset
trigger1 = var(7)
var(58) = 50

[state -2, helper]
type = varadd
trigger1 = var(7)
var(7) = -1

;--------------------------------------------------------------------------------
;相手フライング
[State -2]
type = playsnd
triggerall = (roundstate = [0,1]) || (roundstate = 2 && !var(12))
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5070
trigger1 = time = 1
value = 4000,0;+(random%2)
channel = 2

;--------------------------------------------------------------------------------
[State -2]
type = varset
trigger1 = ctrl = 1
var(12) = 1

;ヒット数カウント
[State -2,ヒット数]
type = VarAdd
triggerall = !(stateno=860)
trigger1 = movehit = 1 || projhit = 1
var(13) = 1

[State -2,ヒット数初期化]
type = VarSet
triggerall = var(13) != 0
trigger1 = EnemyNear,MoveType != H
trigger1 = NumTarget = 0
var(13) = 0

[State -2,コンボ補正1]
type = VarSet
trigger1 = var(13) = 0
fVar(10) = 1

[State -2,コンボ補正1]
type = VarSet
trigger1 = var(13) = 1
fVar(10) = 0.75

[State -2,コンボ補正2]
type = VarSet
trigger1 = var(13) = 2
fVar(10) = 0.5

[State -2,コンボ補正3]
type = VarSet
trigger1 = var(13) >= 3
fVar(10) = 0.25

;浮き関連
[State -2,浮き補正ヒット数]
type = VarAdd
triggerall = EnemyNear,StateType = A
trigger1 = MoveHit = 1
trigger2 = ProjHit = 1
var(18) = 1

[State -2,浮き補正ヒット数初期化]
type = VarSet
triggerall = var(18) != 0
trigger1 = EnemyNear,MoveType != H
trigger1 = NumTarget = 0
var(18) = 0

[State -2,浮き補正]
type = varset
trigger1 = Var(18) >= 4
fVar(20) = 0.50*(var(18))

[State -2,浮き補正リセット]
type = varset
triggerall = EnemyNear,MoveType != H
trigger1 = var(18) = 0
fVar(20) = 0

;---------------------------------------------------------------------------
[State -1, タッグ用生死判別];
Type = VarSet
triggerall = RoundState = 2
trigger1 = NumEnemy = 1
trigger2 = NumEnemy = 2
trigger2 = EnemyNear(0),life > 0
var(48) = 0
IgnoreHitPause = 1

[State -1, タッグ用生死判別];
Type = VarSet
triggerall = RoundState = 2
trigger1 = NumEnemy = 2
trigger1 = EnemyNear(0),life <= 0
var(48) = 1
IgnoreHitPause = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[Statedef -3]

[State -3, Regeneration]
type = LifeAdd
triggerall = Alive = 1
trigger1 = (GameTime%30) = 0
ignorehitpause = 0
value = 2

[state -3, snd]
type = playsnd
triggerall = random < 400
triggerall = time = 1
triggerall = alive
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
trigger4 = stateno = 5070
trigger5 = stateno = 5080
trigger6 = stateno = 5100
value = 5000,0+GetHitVar(animtype)
volume = 255
channel = 0
;---------------------------------------------------------------------------

[state -3, snd]
type = playsnd
triggerall = numtarget(3000)
triggerall = stateno = 3010
triggerall = target(3000),time = 1
trigger1 = target(3000),stateno = 3021
trigger2 = target(3000),stateno = 3023
value = 5100,0

[state -3, snd]
type = explod
triggerall = numtarget(3000)
triggerall = stateno = 3010
triggerall = target(3000),time = 1
trigger1 = target(3000),stateno = 3021
trigger2 = target(3000),stateno = 3023
anim = 3060
id = 3060
postype = p2
pos = 0,0
bindtime = 1

;---------------------------------------------------------------------------
