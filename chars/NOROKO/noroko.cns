trigger1 = life <= 250 && random < 10
trigger1 = roundstate = 2 && movetype != H && alive = 1
trigger1 = var(10)=0
trigger1 = stateno != 3210 && stateno != 3510 && stateno != 3511 && stateno != 3520
name = "sangre constante"
ID = 6100
stateno = 6100
pos = ceil(-8+(random/60)), ceil(cond(statetype != c,-40,-20)-(cond(statetype != c,(random/21),(random/40))))
facing = cond(random<500,1,-1)
ownpal = 1


