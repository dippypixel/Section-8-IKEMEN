[State 0, VarSet]
type = VarSet
trigger1 = 1
sysfvar(2) = 60.0

[State 0, AngleDraw]
type = AngleDraw
trigger1 = time < 6
value = 1
scale = 0.166666666667*time, 0.166666666667*time
[State 0, AngleDraw]
type = AngleDraw
trigger1 = time >= 6
value = 1
scale = 1+(0.005*sysvar(1)), 1+(0.005*sysvar(1))
[State 0, AngleAdd]
type = AngleAdd
trigger1 = 1
value = gametime*30
[State 0, Trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256, 256

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = root,statetype != A
statetype = S
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = root,statetype = A
statetype = A

[State 0, BindToRoot]
type = BindToRoot
trigger1 = root, stateno = 1000 && root, anim = 1000
time = 1
facing = 0
pos = ceil(8*const(size.xscale)),ceil(-45*const(size.yscale))
[State 0, BindToRoot]
type = BindToRoot
trigger1 = root, stateno = 1000 && root, anim = 1010
time = 1
facing = 0
pos = ceil(70*const(size.xscale)),ceil(-140*const(size.yscale))

[State 0, Offset]
type = Offset
trigger1 = 1
y = 2*cos((40*pi)/500*gametime)

[State 1110, 2]
type = afterimage
trigger1 = Time = 0
time = 1000000
length = 8
framegap = 2
palbright = -100,-200,-100
palcontrast = 100,0,100
palpostbright = 0,-100,0
paladd = 0,-200,0
palmul = 1,0.5,1
trans = addalpha
alpha = 256,256

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = movecontact
movetype = I
ignorehitpause = 1

[State 0, HitBy]
type = HitBy
trigger1 = 1
value = 
time = 1
ignorehitpause = 1

[State 0, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 1002
time = 1
ignorehitpause = 1
[State 0, ChangeState]
type = ChangeState
trigger1= vel y > 0
trigger1= pos y > -vel y
trigger2 = movecontact
trigger3 = frontedgedist < -100
trigger4 = root,movetype = H
value = 1002
[State 0, ChangeState]
type = ChangeState
trigger1 = root, stateno = 1010 && root,AnimElemTime(2) >= 0
value = 1005
[State 0, DestroySelf]
type = DestroySelf
trigger1 = root,stateno != [1000,1010]
;trigger2 = root, movetype = H

