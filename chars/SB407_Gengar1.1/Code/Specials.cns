;---------------------------------------------------------------------------
; Shadow Ball
[Statedef 1000]
type    = U
movetype= I
juggle  = 4
poweradd= ceil(25*fvar(7))
ctrl = 0
anim = ifelse(statetype = A, 1010, 1000)

[State Reset Roman Cancel]
type = VarSet
v = 15
value = 0
triggerall = var(15)
trigger1 = !time

[State 0, VarSet]
type = VarSet
trigger1 = !time
sysvar(1) = 0
[State 0, VarSet]
type = VarSet
trigger1 = !time
sysvar(2) = 0
[State 0, VarAdd]
type = VarAdd
trigger1 = time > 6 && sysvar(1) < 60
sysvar(1) = 1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y = 0
statetype = S
physics = S
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y != 0
statetype = A
physics = N

[State 0, VelSet]
type = VelSet
trigger1 = !time && statetype != A
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
x = 0
y = 0 

[State 0, VelSet]
type = Velmul
trigger1 = !time && statetype = A
x = .05
y = .25
[State 0, VelSet]
type = Veladd
trigger1 = statetype = A
y = ifelse(time > 36, const(movement.yaccel),.025)

[State 0, Turn]
type = Turn
triggerall = !time && statetype != A
trigger1 = p2dist X < 0
trigger1 = prevstateno != 1000

[State 1200, Gravity]
type = VelAdd
triggerall = statetype = A
trigger1 = anim = 1250 && animelemtime(13) >= 0
y = const(movement.yaccel)

[State 1200, VelSet]
type = PosSet
trigger1= statetype = A
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0 
[State 1200, VelSet]
type = VelSet
trigger1= statetype = A
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0
x = 0

[State 0, Helper]
type = Helper
trigger1 = !time
name = "Shadow Ball"
id = 1000;+(anim=1010)
stateno = 1001
pos = cond(anim=1010,ceil(70*const(size.xscale)),ceil(8*const(size.xscale))),cond(anim=1010,ceil(-140*const(size.xscale)),ceil(-45*const(size.yscale)))
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0

[State 1200, Ground]
type = StateTypeSet
trigger1 = pos y = 0
statetype = S
[State 1200, Air]
type = StateTypeSet
trigger1 = pos y != 0
statetype = A

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S1000,0
channel = 4 

[State 0, Explod]
type = Explod
trigger1 = statetype = S && !numexplod(1020)
anim = 1020
id = 1020
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
removetime = -1
scale = 0,0
sprpriority = -1
shadow = 0,0,0
ownpal = 1
removeongethit = 1

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = numexplod(1020)
id = 1020
scale = 0.00833333333333*sysvar(1),0.00833333333333*sysvar(1)


[State 0, Explod]
type = Explod
trigger1 = sysvar(1) = 60
anim = 1151
pos = cond(anim=1010,ceil(70*const(size.xscale)),ceil(8*const(size.xscale))),cond(anim=1010,ceil(-140*const(size.xscale)),ceil(-45*const(size.yscale)))
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
removetime = -2
scale = 0.25,0.25
sprpriority = 4
shadow = 0,0,0
ownpal = 1
persistent = 0
removeongethit = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = sysvar(1) = 60
value = S1000,2
persistent = 0
[State 0, PlaySnd]
type = PlaySnd
trigger1 = sysvar(1) = 60
value = S1000,3
channel = 4
persistent = 0
loop = 1

[State 0, VarSet]
type = Varadd
trigger1 = sysvar(1) = 60
sysvar(2) = 8
persistent = 0
[State 0, VarSet]
type = Varadd
trigger1 = sysvar(2) > 0
sysvar(2) = -1

[State 0, PalFX]
type = PalFX
trigger1 = sysvar(1) = 60 && sysvar(2) > 0
time = 1
add = ceil(sysvar(2)*8),ceil(sysvar(2)*8),ceil(sysvar(2)*8)
mul = 256,256,256
invertall = 0
color = 256
[State 0, Offset]
type = Offset
trigger1 = sysvar(2) > 0
x = (sysvar(2)) * ifelse(sysvar(2)%2 = 0, 1, -1)
[State 0, Offset]
type = Offset
trigger1 = sysvar(1) = 60
y = ifelse(time%2=0, -1,0)


[State 230, 5]
type = ChangeState
triggerall = command != "hold_x" && command != "hold_y"
trigger1 = time >= 6
value = 1010



