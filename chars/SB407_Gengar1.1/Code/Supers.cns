type = PosSet
trigger1 = !time
x = (ceil(gamewidth/2) - 60) * -facing
y = -screenpos y + ceil(gameheight/2)

[State 0, PosSet]
type = VelSet
trigger1 = !time
x = .5
y = 2
[State 0, PosSet]
type = VelAdd
trigger1 = time < 12
x = 0.05
y = -.05
[State 0, PosSet]
type = VelAdd
trigger1 = (time = [28,48]) && vel y < 0.1
y = 0.05
[State 0, PosSet]
type = VelAdd
trigger1 = time > 48 && vel y > 0.1
y = -0.05
[State 0, PosSet]
type = VelAdd
trigger1 = time > 28 && vel x > 0.1
x = -0.025
[State 0, PosSet]
type = PosAdd
trigger1 = time = [15,18]
y = (-30 * (1 - exp(-5 * (time-15))));

[State 0, AngleDraw]
type = AngleDraw
trigger1 = enemy,name = "Gengar"
value = 1
scale = enemy,sysfvar(1), enemy,sysfvar(1)

