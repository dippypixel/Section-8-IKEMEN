fall = 1              ;Force p2 into falling down
getpower = 0, 0
givepower = 0, 0
id = 3000
ground.type = High
air.type = High
ground.slidetime = 21
ground.hittime  = 21
ground.velocity = -3
guard.slidetime = 15
guard.hittime = 15
guard.velocity = -3
