; Shadow Tag - FX
[Statedef 3320]
type    = U
movetype = I
physics = N
juggle  = 0
poweradd= 0
ctrl = 0
anim = 69
sprpriority = 99999

[State Explod]
type = Explod
trigger1 = !time
anim = 3397
ID = 3397
pos = ceil(root,sysvar(1)+(gamewidth/2)), ceil(root,sysvar(2)+(gameheight/2))
postype = back
sprpriority = 99996
removetime = -1
[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = numexplod(3397)
ID = 3397
pos = ceil(root,sysvar(1)+(gamewidth/2)), ceil(root,sysvar(2)+(gameheight/2))
postype = back
scale = 1.0+(root,sysfvar(1))*((gamewidth / 300) / camerazoom) , 1.0+(root,sysfvar(1))*((gameheight / 300) / camerazoom)

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = root,stateno != 3302
id = 3397

[State DestroySelf]
type = DestroySelf
trigger1 = !numexplod(3397)

