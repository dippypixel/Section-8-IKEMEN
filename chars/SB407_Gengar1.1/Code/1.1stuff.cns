;---------------------------------------------------------------------------
; Hyper Portrait
[Statedef 2999]
type    = U
movetype = I
physics = N
juggle  = 0
poweradd= 0
ctrl = 0
anim = 2999
sprpriority = 99999

[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time < 4
time = 1
add = 0,0,0
mul = ceil(256-(64*(time))),ceil(256-(64*(time))),ceil(256-(32*(time)))
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1
[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time >= 4 && Time < 24
time = 1
add = 0,0,0
mul = 96,32,96
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1
[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time >= 24 && time < 32
time = 1
add = 0,0,0
mul = 96+(20*(time-24)),32+(28*(time-24)),96+(20*(time-24))
sinadd = 0,0,0,0
invertall = 0
color = 256

[State 0, PosSet]
type = PosSet
trigger1 = 1
x = ceil((-gamewidth/2)*facing)

[State 0, VarSet]
type = VarAdd
trigger1 = time<18
v = 29
value = 18-(time)
[State 0, VarSet]
type = VarAdd
trigger1 = time>=32
v = 29
value = -(time-32)

[State 0, Offset]
type = Offset
trigger1 = 1
x = ((-200 + var(29) + random%5) * facing) / camerazoom
y = ceil((-Screenpos Y)+(gameheight/4)+random%5)

[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
scale = (1.95918367347 / (camerazoom*1.95918367347)), (1.95918367347 / (camerazoom*1.95918367347))

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "x = %f,  y = %f, zoom = %f, dick = %f"
params = (gamewidth / 640) * camerazoom , (gameheight / 480) * camerazoom, camerazoom, ceil(((-Screenpos Y)+(gameheight/3)+random%5) * camerazoom)

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 1200, ChangeState]
type = destroyself
trigger1 = time >= 60

;---------------------------------------------------------------------------
; Finisher Portraits
[Statedef 3299]
type    = A
movetype= I
physics = N
juggle  = 0
ctrl = 0
velset = 0,0
anim = 3299
sprpriority = 99999

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "fvar(27) = %f  fvar(28) = %f, Pos x = %f"
params = fvar(27), fvar(28), Pos X
ignorehitpause = 1

[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
scale = 0.5+fvar(29),0.5+fvar(29)
ignorehitpause = 1
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = Time = 0
flag = invisible
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 0, Starting var]
type = VarSet
trigger1 = !time
fv = 29
value = 0.5
[State 0, Shrink]
type = VarSet
trigger1 = Time
fv = 29
value = (fvar(29)*0.75)

[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time < 5
time = 1
add = 0,0,0
mul = ceil(256-(51.2*(time))),ceil(256-(51.2*(time))),ceil(256-(51.2*(time)))
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1
[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time >= 5 && Time <= 30
time = 1
add = 0,0,0
mul = 0,0,0
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1
[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time > 30 && Time < 40
time = 1
add = 0,0,0
mul = ceil(25.6*(time-30)),ceil(25.6*(time-30)),ceil(25.6*(time-30))
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1

[State 0, BGPalFX]
type = PalFX
trigger1 = Time < 10
time = 1
add = 0,0,0
mul = ceil(25.6*time),ceil(25.6*time),ceil(25.6*time)
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1 

[State 0, Trans]
type = Trans
trigger1 = Time > 30
trans = add
alpha = 256-ceil(25.6*(time-30)),ceil(25.6*(time-30))

[State 0, PosSet]
type = PosSet
trigger1 = 1
x = fvar(27)*-facing
[State 0, Offset]
type = Offset
trigger1 = 1
x = -5+random%10
y = ceil((-Screenpos Y)+(gameheight/1.5)+(-5+random%10))

[State 0, VelSet]
type = VarSet
trigger1 = !time
fv = 27
value = 0
[State 0, VelSet]
type = VarAdd
trigger1 = 1
fv = 27
value = fvar(28)
[State 0, VelSet]
type = VarSet
trigger1 = Time = 0
fv = 28
value = 15
[State 0, VelSet]
type = VarSet
trigger1 = Time < 30
fv = 28
value = fvar(28)*0.75
[State 0, VelAdd]
type = VarAdd
trigger1 = Time >= 30
fv = 28
value = 1.25

[State 0, DestroySelf]
type = DestroySelf
trigger1 = time = 40


;---------------------------------------------------------------------------
; Shadow Drop - evil head from outer space
[Statedef 3311]
type    = S
movetype= I
physics = N
juggle  = 0
poweradd= 0
ctrl = 0
velset = 0,0
anim = ifelse(ishelper(3310),3310, 3396)
sprpriority = 99997

[State HitBy]
type = HitBy
trigger1 = 1
value = 
time = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S3300,10
channel = 0

[State 0, VarSet]
type = VarAdd
trigger1 = time > 32 && sysvar(1) < 50 && time%4=0
sysvar(1) = 1
[State 0, VarSet]
type = VarAdd
trigger1 = time > 48 && sysvar(1) < 50 && time%4=2
sysvar(1) = 1
[State 0, VarSet]
type = VarAdd
trigger1 = time > 64 && sysvar(1) < 50 && time%2=0
sysvar(1) = 1

[State 0, AngleSet]
type = AngleSet
trigger1 = 1
value = 50 - sysvar(1);


[State 0, VarAdd]
type = VarAdd
trigger1 = time > 32
sysfvar(2) = 0.02*((time-32)*0.12)

[State 0, AngleDraw]
type = AngleDraw
trigger1 = isHelper(3310)
scale = .7+sysfvar(2),.7+sysfvar(2)
[State 0, AngleDraw]
type = AngleDraw
trigger1 = isHelper(3396)
scale = .77+sysfvar(2),.7+sysfvar(2)

[State 0, VelSet]
type = VelSet
trigger1 = !time
x = 5
y = -15
[State 0, VelMul]
type = VelMul
trigger1 = 1
x = .9
y = .9

[State 0, PosAdd]
type = PosSet
trigger1 = time > 32
x = pos x * ifelse(time > 48, 0.95, 0.99)
y = pos y * ifelse(time > 48, 0.95, 0.99)

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 0, Explod]
type = Explod
trigger1 = time = 96 && isHelper(3310)
anim = 3311
ID = 3311
pos = 0,-96
postype = left  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
removetime = 6
pausemovetime = 0
scale = (gamewidth / 1280) / camerazoom , (gameheight / 720) / camerazoom
sprpriority = 0
ontop = 1
shadow = 0,0,0
ownpal = 0
vel = 0, 16
removeongethit = 0
[State 0, Explod]
type = Explod
trigger1 = time = 96 && isHelper(3310)
anim = 3312
ID = 3312
pos = 0,96
postype = left  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
removetime = 6
pausemovetime = 0
vel = 0, -16
scale = (gamewidth / 1280) / camerazoom , (gameheight / 720) / camerazoom
sprpriority = 0
ontop = 1
shadow = 0,0,0
ownpal = 0
removeongethit = 0

[State 0, EnvShake]
type = EnvShake
trigger1 = time=102 && isHelper(3310)
time = 18
freq = 45
ampl = -5
phase = 20
[State 0, DestroySelf]
type = DestroySelf
trigger1 = time=102


