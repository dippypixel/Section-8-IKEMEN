;---------------------------------------------------------------------------
; Spot Dodge
[Statedef 700]
type    = S
physics = S
anim = 700
ctrl = 0
velset = 0,0
sprpriority = 1
facep2 = 1

[State 0, oooh i go byebye]
type = Trans
trigger1 = AnimElemTime(3) < 0
trans = addalpha
alpha = 256-ceil(time*42.6666666667),ceil(time*42.6666666667)
ignorehitpause = 1
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = animelemtime(3) >= 0 && animelemtime(4) < 0
flag = noshadow
flag2 = invisible
[State 0, AssertSpecial]
type = Trans
trigger1 = animelemtime(4) >= 0
trans = addalpha
alpha = ceil(animelemtime(4)*16),256-ceil(animelemtime(4)*16)

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = S701,0
[State 0, HitBy]
type = HitBy
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(4) < 0
value = SCA,AT
[State 0, PlayerPush]
type = PlayerPush
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(4) < 0
value = 0

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

