;---------------------------------------------------------------------------
; Parry
[Statedef 710]
type    = U
physics = S
ctrl = 0
anim = 710+statetype=C
velset = 0,0

[State 710, FX]
type = PalFX
trigger1 = time < 8
time = 2
add = 256-(time*32),256-(time*32),256-(time*32)
mul = 256,256,256
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1
[State 710, BG FX]
type = BGPalFX
trigger1 = time < 8
time = 2
add = -128+(time*16),-128+(time*16),-128+(time*16)
mul = 256,256,256
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1

[State 710, Explod]
type = Explod
trigger1 = !time
anim = 7200
ID = 7200
sprpriority = 5
postype = p1
pos = ceil(ifelse(anim=711,84,36)*const(size.yscale)), ceil(ifelse(anim=711,-90,-130)*const(size.yscale))
pausemovetime = 60
ownpal = 1
scale = 0.5, 0.5

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S710,0

[State 0, Pause]
type = Pause
trigger1 = !time
time = 15
movetime = 15

[State 130, Stop Guarding]
type = ChangeState
trigger1 = animtime = 0
value = 0+11*statetype=C+50*statetype=A
ctrl=1

;---------------------------------------------------------------------------
; Airdodge
[Statedef 707]
type    = A
physics = N
ctrl = 0
anim = 707

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = S701,0
[State 0, oooh i go byebye]
type = Trans
trigger1 = AnimElemTime(3) < 0
trans = addalpha
alpha = 256-ceil(time*42.6666666667),ceil(time*42.6666666667)
ignorehitpause = 1
[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = animelemtime(3) >= 0 && animelemtime(4) < 0
flag = noshadow
flag2 = invisible
[State 0, AssertSpecial]
type = Trans
trigger1 = animelemtime(4) >= 0
trans = addalpha
alpha = ceil(animelemtime(4)*16),256-ceil(animelemtime(4)*16)

[State 0, HitBy]
type = HitBy
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(4) < 0
value = SCA,AT
[State 0, PlayerPush]
type = PlayerPush
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(4) < 0
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = !time
v = 51
value = 1

[State 0, VelSet]
type = VelSet
triggerall = !time
trigger1 = command = "holdback" || command = "holdfwd" || command = "holddown" || command = "holdup"
x = ifelse(command = "holdback", const(velocity.runjump.back.x)*1.5, ifelse(command = "holdfwd", const(velocity.runjump.fwd.x)*1.5, 0))
y = ifelse(command = "holdup", -4.5, ifelse(command = "holddown", 4.5, 0))
[State 0, VarSet]
type = VarSet
trigger1 = time < 15
v = 50
value = 1
[State 0, VarSet]
type = VarSet
trigger1 = time >= 15
v = 50
value = 0

[State 0, VelAdd]
type = VelAdd
trigger1 = animelemtime(3) >= 0
y = const(movement.yaccel)
[State 0, VelAdd]
type = VelSet
trigger1 = animelemtime(3) >= 0 && AnimElemTime(5) < 0
x = vel X * .92

[State 0, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 50
ctrl = 1
[State 0, ChangeState]
type = ChangeState
trigger1= vel y > 0
trigger1= pos y > -vel y
trigger2= command != "holddown" && command != "holdup"
trigger2 = command = "holdback" || command = "holdfwd"
trigger2= pos y = 0
trigger3 = (prevstateno = [40,41]) && command = "holdup"
value = 52

;---------------------------------------------------------------------------
;P2 Safe Fall (Courtesy of P.o.t.S)
[Statedef 5205]
type= A
physics= N
movetype= H

[State 5205, End]; Sends character back to his own recovery states
type= selfstate
trigger1= 1
value= ifelse(pos y<-25, 5210, 5200)