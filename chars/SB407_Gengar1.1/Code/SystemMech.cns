;---------------------------------------------------------------------------
; Run forward
[Statedef 110]
type    = A
movetype = I
physics = N
anim = 100
velset = 0,0
sprpriority = 1
ctrl = 1

[State AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[State 0, AfterImage]
type = AfterImage
trigger1 = !time
time = 4
length = 8
palcolor = 256
palinvertall = 0
palbright = 0,0,0
palcontrast = 100,100,100
palpostbright = -100,-100,-100
paladd = -64,-64,128
palmul = .25,.25,.25
timegap = 1
framegap = 4
trans = add
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = 1
time = 4

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S110,0
[State 0, Explod]
type = Explod
trigger1 = !time 
anim = 110
pos = 0,ceil(-57*const(size.yscale))
postype = p1  ;p2,front,back,left,right
facing = -1
vfacing = 1
bindtime = 1
removetime = -2
vel = -vel x * 0.2, 0
pausemovetime = 0
scale = .5,.5
sprpriority = 0
ontop = 0
shadow = 0,0,0
ownpal = 1

[State 0, Explod]
type = Explod
trigger1 = time%4 = 0
anim = 111
pos = 0,ceil(-57*const(size.yscale))+((const(size.height)/2)-random%const(size.height))
postype = p1  ;p2,front,back,left,right
facing = -1
vfacing = 1
bindtime = 1
removetime = -2
vel = -vel x * 0.35, 0
pausemovetime = 0
scale = .5,.5
sprpriority = 0
ontop = 0
shadow = 0,0,0
ownpal = 1

[State 0, VarSet]
type = VarSet
trigger1 = !time
v = 11
value = 1

[State 100, 1]
type = VelSet
trigger1 = command = "holdup"
trigger2 = pos y <= 0 && command = "holddown"
y = ifelse(command = "holdup", -3, 3)
[State 0, VelAdd]
type = VelMul
trigger1 = command != "holdup" || command != "holddown"
y = .86

[State 0, PosSet]
type = PosSet
trigger1 = pos y >= 0
y = 0
[State 0, PosSet]
type = VelSet
trigger1 = pos y >= 0
y = 0

[State 1000, Land]
type= changestate
trigger1 = time >= 20
value= 50

