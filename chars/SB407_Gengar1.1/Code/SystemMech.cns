;---------------------------------------------------------------------------
; Super Jump
[Statedef 45]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 0, HitBy]
type = HitBy
trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ceil(const(velocity.jump.y)*1.5)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 105 ;RUN_Back
trigger1 = sysvar(1) = -1
x = const(velocity.runjump.back.x)

[State 0, VarSet]
type = VarSet
trigger1 = AnimTime = 0
v = 56
value = 1
ignorehitpause = 1
[State 40, Jump SFX]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,1
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Shadow Stealth - Forward
[Statedef 100]
type    = S
movetype= I
physics = S
juggle  = 1
poweradd= 0
ctrl = 0
anim = 1200
facep2 = 1

[State 0, VelSet]
type = VelSet
trigger1 = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
x = 0
y = 0 

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S100,0

[State 0, VarSet]
type = NotHitBy
triggerall = var(50)
trigger1 = animelemtime(3) >= 0 && animelemtime(7) < 0
value = ,NA,SA,HA,NP,SP,HP
[State 0, VarSet]
type = VarSet
triggerall = !var(50)
trigger1 = animelem = 3
v = 9
value = 20

[State 0, ChangeState]
type = ChangeState
trigger1 = animelemtime(5) >= 0 && animelemtime(7) < 0
trigger1 = command = "holdup"
value = 40
ctrl = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelemtime(3) >= 0 && animelemtime(7) < 0
physics = N
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 7
physics = S

[State 0, PlayerPush]
type = PlayerPush
trigger1 = animelemtime(3) >= 0
value = 0

[State 0, PosSet]
type = VelSet
trigger1 = animelem = 3
x = const(velocity.run.fwd.x)*1.5
[State 0, PosSet]
type = VelSet
trigger1 = animelem = 7
x = 0

[State 0, CtrlSet]
type = CtrlSet
trigger1 = animelem = 14
value = 1

[State 230, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

