[Statedef -1]

;---------------------------------------------------------------------------
; Shadow Drop
[State -1, Shadow Drop]
type = ChangeState
value = 3300
triggerall = power >= 3000
triggerall = command = "SDrop"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,499]) || (var(20) >= 1 && stateno != [3000,3099]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Night Shade
[State -1, Night Shade]
type = ChangeState
value = 3200
triggerall = power >= 1000
triggerall = command = "NShade"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,499]) || (var(20) >= 1 && stateno != [3000,3099]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Dream Eater
[State -1, Dream Eater]
type = ChangeState
value = 3000
triggerall = numexplod(3020) = 0
triggerall = power >= 1000
triggerall = command = "Dream"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,499]) || (var(20) >= 1 && stateno != [3000,3099]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Sludge Wave
[State -1, Sludge Wave]
type = ChangeState
value = 3100
triggerall = !numhelper(3100)
triggerall = power >= 1000
triggerall = command = "Wave"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,499]) || (var(20) >= 1 && stateno != [3000,3099]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Sludge Bomb
[State -1, Sludge Bomb]
type = ChangeState
value = 1400
triggerall = !numhelper(1400)
triggerall = command = "Bomb_a" || command = "Bomb_b"
triggerall = statetype != A
trigger1 = ctrl 
trigger2 = (stateno = [200,499])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Shadow Punch
[State -1, Shadow Punch]
type = ChangeState
value = 1300
triggerall = command = "Punch_x" || command = "Punch_y"
triggerall = statetype != A
trigger1 = ctrl 
trigger2 = (stateno = [200,499])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Hypnosis
[State -1, Hypnosis]
type = ChangeState
value = 1500
triggerall = command = "Hypnosis"
triggerall = statetype != A
trigger1 = ctrl 
trigger2 = (stateno = [200,499])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Counter
[State -1, Counter]
type = ChangeState
value = 1100
triggerall = command = "Counter"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,499])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Shadow Ball
[State -1, Shadow Ball]
type = ChangeState
value = 1000
;triggerall = statetype != A
triggerall =  command = "Ball_x" || command = "Ball_y"
triggerall = var(12) = 0
trigger1 = ctrl
trigger2 = (stateno = [200,699])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Roman Cancel - Activate
[State -1, Roman Cancel - Activate]
type = VarSet
v = 7
value = 1
triggerall = power >= 500
triggerall = (stateno = [200, 699]) || (stateno = [1000, 1599]) || (stateno = [810,816]) || stateno = [3100,3200]
triggerall = movetype != H
triggerall = command = "roman"
trigger1 = stateno != [810,811] 
trigger1 = movecontact
trigger2 = stateno = 1010 || stateno = 1300 || stateno = 615 || stateno = 3100 || stateno = [1400,1401]
trigger2 = var(15)
trigger3 = stateno = [810,811] 
trigger3 = animelemtime(6) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 816
trigger4 = animelemtime(11) >= 0
trigger4 = target,stateno != 822
ignorehitpause = 1
;---------------------------------------------------------------------------
; Roman Cancel - Decrease Power gain
[State -1, Roman Cancel - Decrease Power gain]
type = VarSet
fv = 7
value = 0.2
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,811]
trigger3 = animelemtime(6) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 816
trigger4 = animelemtime(11) >= 0
trigger4 = target,stateno != 822
;---------------------------------------------------------------------------
; Roman Cancel - Stop all momentumn when cancelling in air
[State -1, Roman Cancel - Stop all momentumn when cancelling in air]
type = VelSet
y = 0
x = 0
triggerall = power >= 500
triggerall = statetype = A
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,811] 
trigger3 = animelemtime(6) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 816
trigger4 = animelemtime(11) >= 0
trigger4 = target,stateno != 822
;---------------------------------------------------------------------------
; Roman Cancel - FX
[State -1, Roman Cancel - FX]
type = VarSet
v = 5
value = 256
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,811] 
trigger3 = animelemtime(6) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 816
trigger4 = animelemtime(11) >= 0
trigger4 = target,stateno != 822
;---------------------------------------------------------------------------
; Roman Cancel - SFX
[State -1, Roman Cancel - SFX]
type = PlaySnd
value = S700, 0
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,811] 
trigger3 = animelemtime(6) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 816
trigger4 = animelemtime(11) >= 0
trigger4 = target,stateno != 822
;---------------------------------------------------------------------------
; Roman Cancel - Remove Power
[State -1, Roman Cancel - Remove Power]
type = PowerAdd
value = -500
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,811] 
trigger3 = animelemtime(6) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 816
trigger4 = animelemtime(11) >= 0
trigger4 = target,stateno != 822
;---------------------------------------------------------------------------
; Roman Cancel - Reset
[State -1, Roman Cancel - Reset]
type = ChangeState
value = ifelse(statetype = A, 50, 0)
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,811] 
trigger3 = animelemtime(6) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 816
trigger4 = animelemtime(11) >= 0
trigger4 = target,stateno != 822
ctrl = 1
;---------------------------------------------------------------------------
; Roman Cancel - Deactivate
[State -1, Roman Cancel - Deactivate]
type = VarSet
v = 7
value = 0
trigger1 = var(7) != 0

;===========================================================================


;---------------------------------------------------------------------------
;Air Dash Back
[State -1, Air Dash Back]
type = ChangeState
value = 115
triggerall = (command = "BB") || (command = "holdback") && (command = "x") && (command = "y")
triggerall = var(11) = 0
triggerall = Pos Y < -const(movement.airjump.height)
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = [600,640]
trigger2 = movehit
;---------------------------------------------------------------------------
;Air Dash Fwd
[State -1, Air Dash Fwd]
type = ChangeState
value = 110
triggerall = (command = "FF") || (command = "x") && (command = "y")
triggerall = var(11) = 0
triggerall = Pos Y < -const(movement.airjump.height)
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = [600,640]
trigger2 = movehit

;---------------------------------------------------------------------------
; Run Back
[State -1, Run Back]
type = ChangeState
value = 105
trigger1 = (command = "BB"  || (command = "holdback" && command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = (command = "FF"  || (command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Super Jump
[State -1, Super Jump]
type = ChangeState
value = 45
trigger1 = command = "Super Jump" || (command = "a" && command = "b")
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = command = "holdup" || (command = "a" && command = "b")
trigger2 = stateno = 240
trigger2 = movehit

;---------------------------------------------------------------------------
; Throw Air
[State -1, Throw Air]
type = ChangeState
value = 850
triggerall = command = "y" || command = "b"
triggerall = var(38) = 0
triggerall = command = "holdfwd" || command = "holdback"
triggerall = statetype = A && p2statetype = A
triggerall = p2bodydist X < 10 && p2bodydist y = [-50,50]
triggerall = p2movetype != H
trigger1 = ctrl

;---------------------------------------------------------------------------
; Throw 1
[State -1, Throw 1]
type = ChangeState
value = 800
triggerall = command = "y"
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != [100,109]
triggerall = var(38) = 0
trigger1 = command = "holdfwd" || command = "holdback"
trigger1 = p2bodydist X < 10
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H

;---------------------------------------------------------------------------
; Throw 2
[State -1, Throw 2]
type = ChangeState
value = 815
triggerall = command = "b"
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != [100,109]
triggerall = var(38) = 0
trigger1 = command = "holdfwd" || command = "holdback"
trigger1 = p2bodydist X < 10
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H
;===========================================================================

;---------------------------------------------------------------------------
; Roll Backwards
[State -1, Roll Backwards]
type = ChangeState
value = 705
triggerall = command = "c"
triggerall = command = "holdback" && command != "holdfwd"
trigger1 = statetype != A
trigger1 = ctrl 

;---------------------------------------------------------------------------
; Roll Forwards
[State -1, Roll Forwards]
type = ChangeState
value = 706
triggerall = command = "c"
triggerall = command = "holdfwd" && command != "holdback"
trigger1 = statetype != A
trigger1 = ctrl 

;---------------------------------------------------------------------------
; Air Dodge
[State -1, Air Dodge]
type = ChangeState
value = 707
triggerall = var(51) = 0
triggerall = command = "c"
triggerall = stateno != [110,115]
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = [40,41]
trigger2 = command = "holdback" || command = "holdfwd"

;---------------------------------------------------------------------------
; Dodge
[State -1, Dodge]
type = ChangeState
value = 700
triggerall = command = "c"
triggerall = (command != "holdback" && command != "holdfwd") || (command = "holdback" && command = "holdfwd")
trigger1 = statetype != A
trigger1 = ctrl 

;---------------------------------------------------------------------------
; Stand Parry enabled
[State -1, Parry enabled]
type = VarSet
trigger1 = command = "fwd"
v = 6
value = 6
; Crouch Parry enabled
[State -1, Parry enabled]
type = VarSet
trigger1 = statetype != A
trigger1 = command = "down"
v = 8
value = 6

[State -1, Parry]
type = HitOverride
trigger1 = var(6)>0
trigger1 = ctrl
attr = SA,NA,SA,HA,NP,SP,HP
stateno = 710
time = 1
[State -1, Parry]
type = HitOverride
trigger1 = var(8)>0
trigger1 = ctrl
attr = C,NA,SA,HA,NP,SP,HP
stateno = 710
time = 1

;===========================================================================
;---------------------------------------------------------------------------
; Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = command = "s"
trigger1 = statetype != A
trigger1 = ctrl 

;---------------------------------------------------------------------------
; 6x
[State -1, 6x]
type = ChangeState
value = 205
triggerall = command = "x" && command = "holdfwd"
triggerall = command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl 

;---------------------------------------------------------------------------
; 6y
[State -1, 6x]
type = ChangeState
value = 215
triggerall = command = "y" && command = "holdfwd"
triggerall = command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl 
trigger2 = stateno = 200 || stateno = 210 || stateno = 230 || stateno = 240 || stateno = [400,440]
trigger2 = movecontact

;---------------------------------------------------------------------------
; 5x
[State -1, 5x]
type = ChangeState
value = 200
triggerall = command = "x"
triggerall = command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl 
trigger2 = (stateno = 200 || stateno = 400) && AnimElemTime(5) >= 0
trigger3 = (stateno = 230 && AnimElemTime(4) >= 0)


;---------------------------------------------------------------------------
; 5y - Followup
[State -1, 5y - Followup]
type = ChangeState
value = 211
triggerall = command = "y"
trigger1 = stateno = 210
trigger1 = movecontact
trigger2 = command = "holdback" && command != "holddown"
trigger2 = statetype != A
trigger2 = ctrl 
trigger3 = command = "holdback" && command != "holddown"
trigger3 = stateno = 200 || stateno = 400 || stateno = 230 || stateno = 430
trigger3 = movecontact

;---------------------------------------------------------------------------
; 5y
[State -1, 5y]
type = ChangeState
value = 210
triggerall = command = "y"
triggerall = command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl 
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 || stateno = 430
trigger2 = movecontact

;---------------------------------------------------------------------------
; 5a
[State -1, 5a]
type = ChangeState
value = 230
triggerall = command = "a" && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl 
trigger2 = (stateno = 200 || stateno = 400) && AnimElemTime(5) >= 0
trigger3 = (stateno = 230 && AnimElemTime(4) >= 0)
trigger4 = stateno = 200 || stateno = 400
trigger4 = movecontact

;---------------------------------------------------------------------------
;5b
[State -1, 5b]
type = ChangeState
value = 240
triggerall = command = "b" && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl 
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 || stateno = 430
trigger2 = movecontact

;---------------------------------------------------------------------------
; 2x
[State -1, 2x]
type = ChangeState
value = 400
triggerall = command = "x"
triggerall = command = "holddown"
trigger1 = statetype != A
