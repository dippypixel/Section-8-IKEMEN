;---------------------------------------------------------------------------
; Shadow Trail
[Statedef 1]
type = S
physics = S
sprpriority = -99999
anim = 2

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
[State 1, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "off = %d, alpha = %d"
params = sysvar(1), sysvar(2)

[State 1, Reset every frame]
type = VarSet
trigger1 = 1
sysvar(1) = 0
[State 1, Trail is gone]
type = VarSet
trigger1 = root,stateno = 196 && root,animelemtime(38) < 0 ;Ditto
trigger2 = (root,stateno = [100,105]) && root,animelemtime(7) < 0 ;Shadow Stealth
trigger3 = (root,stateno = [700,707]) && root,animelemtime(4) < 0 ;Dodging
trigger4 = root,stateno = [3302,3303] ;Shadow drop
trigger5 = root,anim = [5317,5318] ;Next meme!
sysvar(1) = 1

[State 1, gone in an instant.]
type = VarSet
triggerall = sysvar(1) = 1 && sysvar(2) > 0
trigger1 = root,stateno = [3302,3303]
sysvar(2) = 16
[State 1, make it disappear faster!!!]
type = VarAdd
triggerall = sysvar(1) = 1 && sysvar(2) > 0
trigger1 = (root,stateno = [100,105]) && root,animelemtime(7) < 0
trigger2 = (root,stateno = [700,707]) && root,animelemtime(4) < 0
sysvar(2) = 1
[State 1, Trail detransition]
type = VarAdd
trigger1 = sysvar(1) = 1 && sysvar(2) < 16
sysvar(2) = 1
[State 1, Trail transition]
type = VarAdd
trigger1 = sysvar(1) = 0 && sysvar(2) > 0
sysvar(2) = -1

[State 1, Not here while Ditto or dropping..]
type = AssertSpecial
trigger1 = root,stateno = 196 && root,animelemtime(38) < 0
trigger2 = root,stateno = [3302,3303]
flag = invisible

[State 1, Trans]
type = Trans
trigger1 = 1
trans = add ;none, add, addalpha, add1, sub
;alpha = 256,256

[State 1, Appear]
type = ChangeAnim
trigger1 = sysvar(1) = 0 && anim != 2
value = 2
[State 1, Disappear]
type = ChangeAnim
trigger1 = sysvar(1) = 1 && anim != 3
value = 3

[State 1, Ring]
type = Explod
triggerall = sysvar(1) = 0
trigger1 = !numexplod(1)
anim = 1
ID = 1
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
removetime = -1
pausemovetime = 0
scale = const(size.xscale)*1.75,const(size.yscale)*1.25
sprpriority = -99998
ontop = 0
shadow = 0,0,0
ownpal = 0
removeongethit = 0
trans = addalpha
alpha = 256,256

[State 1, Ring fading in/out]
type = ModifyExplod
trigger1 = numexplod(1)
ID =1
trans = addalpha
alpha = 256-(sysvar(2)*16), 256

[State 1, Turn]
type = Turn
trigger1 = facing != root,facing
[State 1, Follow]
type = PosSet
trigger1 = (root,stateno != [100,105]) && (root,stateno != [700,706]) && root,stateno != 707
trigger2 = (root,stateno = [100,105]) && root,animelemtime(7) >= 0
trigger3 = (root,stateno = [700,706]) && root,animelemtime(4) >= 0
trigger4 = root,stateno = 707 && root,animelemtime(4) >= 0
x = root,pos x
y = 0



