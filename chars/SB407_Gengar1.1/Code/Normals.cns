[State -2, Super jump Movement variable]
type = VarSet
trigger1 = statetype != A
trigger2 = movetype = H
trigger3 = (stateno = [1000,3999]) && (stateno != 1200) && (stateno != [1300,1301])
trigger4 = stateno = 645
trigger5 = stateno = [110,115]
trigger6 = stateno = 707
trigger7 = stateno = 851
v = 55
value = 0
ignorehitpause = 1
[State -2, Move Right]
type = VelAdd
triggerall = statetype = A
triggerall = var(55) != 0
triggerall = Vel X < const(velocity.jump.fwd.x)
;triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = command = "holdfwd" && command != "holdback"
x = const(velocity.jump.fwd.x)*0.13
[State -2, Move Left]
type = VelAdd
triggerall = statetype = A
triggerall = var(55) != 0
triggerall = Vel X > const(velocity.jump.back.x)
;triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = command = "holdback" && command != "holdfwd"
x = const(velocity.jump.back.x)*0.13
[State 0, Turn]
type = Turn
triggerall = var(55) != 0
triggerall = p2dist X < 0 ;ifelse(enemynear,statetype=A, enemynear,const(size.air.back), enemynear,const(size.ground.back))
triggerall = (stateno != [110,119])
trigger1 = stateno = 50
trigger2 = stateno = 600 && AnimElemTime(5) >= 0
trigger3 = (stateno = [610,630]) && animelemtime(6) >= 0
trigger4 = stateno = 640 && animelemtime(7) >= 0

;Velocity Deterioration system (Edited from RicePigeon's Damage Proration system)
[State -2, Reset velocity dampener]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,statetype!=A)
trigger2 = !numenemy
fvar(20) = 1.0
[State 0, Make sure it never goes negative]
type = VarSet
trigger1 = fvar(20) < 0.25
fv = 20 
value = 0.25
ignorehitpause = 1

;RicePigeon Damage Proration system
[State -2, Reset var when the opponent recovers]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(10) = 1.0
[State -2, Final Dampen]
type = null
trigger1 = (fvar(11) := ifelse(0.2>fvar(10),0.2,fvar(10))) || 1
ignorehitpause = 1
[State -2, Dampener itself]
type = Attackmulset
trigger1 = 1
value = fvar(11)
ignorehitpause = 1

[State -2, P2 Safe Fall]
type= targetstate
trigger1 = numtarget = 1
trigger1 = target, command = "recovery"
trigger1 = target, pos y >= -48 && target, vel y > 0
trigger1 = target, alive && target, hitfall && target, gethitvar(fall.recover)
trigger1 = target,stateno=5030 || target,stateno=5035 || target,stateno=5050 || target,stateno=5071 || target,stateno=6030 || target,stateno=6035 || target,stateno=6050 || target,stateno=6071
value= 5205
ignorehitpause= 1

[State -2, P2 Facing]
type= targetfacing
trigger1= movecontact=1 && numtarget=1
trigger1= !(target,hitshakeover) && !(target,hitfall) && (target,time<=1)
value= ifelse(p2dist x>=0, -1, 1)
ignorehitpause= 1

