trigger9 = command = "ai8"
trigger10 = command = "ai9"
trigger11 = command = "ai10"
trigger12 = command = "ai11"
trigger13 = command = "ai12"
trigger14 = command = "ai13"
var(7) = 1
[State -2, varrandom]
type = VarRandom
triggerall = stateno != [200,700]
trigger1 = Time = 0
v = 8
range = 0,3


[State -3, dust]
type = Explod
triggerall = !NumExplod(918)
trigger1 = StateNo = 105
id = 918
anim = F918
supermove = 1
ontop = 1
pos = -15, 6
facing = -1
removeongethit = 1

