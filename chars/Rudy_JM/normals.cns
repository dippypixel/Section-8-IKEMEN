;Hot Tamale Kit

;---------------------------------------------------------------------------
; Stand A
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 0
poweradd= 0
ctrl = 0
anim = ifelse(anim != 200, 200, 201)
facep2 = 1

[State Voice]
type = PlaySnd
triggerall = random < 690
trigger1 = Time = 0
value = S200,0+random%2
channel = 11

[State Fucking stop]
type = VelSet
trigger1 = vel x < 0
x = 0

[State Prorate]
type = VarSet
triggerall = Var(20) = 1 ;prevStateContact
trigger1 = Time = 0
fvar(10) = fvar(10) * 0.9
[State -2, StateContact reset]
type = VarSet
trigger1 = Time = 0
var(20) = 0
[State -2, StateContact?]
type = VarSet
triggerall = Var(20) = 0
trigger1 = MoveHit
var(20) = 1
ignorehitpause = 1

[State Woosh]
type = PlaySnd
trigger1 = !time
value = S0,0
channel = 2

[State 205, Time Offset]
type = VarSet
trigger1 = moveContact = 1
var(35) = Time
ignorehitpause = 1
persistent = 0
[State 205, Play Anim]
type = ChangeAnim
triggerall = anim = 200
triggerall = AnimElemTime(2) >= 0 && AnimElemTime(3) <= 0
trigger1 = hitPauseTime = [1,8 - (5 - Var(35))]
value = anim
elem = 3
ignorehitpause = 1

[State 205, Time Offset]
type = VarSet
trigger1 = moveContact = 1
var(35) = Time
ignorehitpause = 1
persistent = 0
[State 205, Play Anim]
type = ChangeAnim
triggerall = anim = 200 || Anim = 201
triggerall = AnimElemTime(2) >= 0 && AnimElemTime(3) <= 0
trigger1 = hitPauseTime = [1,8 - (5 - Var(35))]
value = anim
elem = 3
ignorehitpause = 1
[State 205, Play Anim]
type = ChangeAnim
triggerall = anim = 201
triggerall = AnimElemTime(3) >= 0 && AnimElemTime(4) <= 0
trigger1 = hitPauseTime = [1,8 - (8 - Var(35))]
value = anim
elem = 4
ignorehitpause = 1

[State Stand Light Hitdef]
type = HitDef
trigger1 = animelem = 2
attr = S,NA
hitflag = MAFD
guardflag = M;A
animtype = light
fall.animtype = Back
priority = 4,Hit
damage = 20,0
pausetime = (var(2):=8),8
sparkno = S6000
guard.sparkno = S6040
sparkxy = -12-0*ceil(fvar(0):=33.0),ceil(fvar(1):=-72.0)
hitsound = S5,0
guardsound = S6,0
ground.type = High
air.type = Low
ground.slidetime = 14
ground.hittime = 14
guard.slidetime = 13
guard.hittime = 13
air.hittime = 14
airguard.hittime = 13
airguard.ctrltime = 13
down.hittime = 14
yaccel = 0.4
ground.velocity = -3
guard.velocity = -3
air.velocity = -0.5,-4
airguard.velocity = -2,-0.8
down.velocity = -0.5,-4
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
forcenofall = 1
down.bounce = 1
id = 200
;getpower = 100,50
;givepower = 50,25

[State n0GGA]
type = StateTypeSet
trigger1 = AnimElem = 3
movetype = I
ignorehitpause = 1

[State 210, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

