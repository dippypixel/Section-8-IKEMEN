;for standing moves, do: trigger1 = p2bodydist x <= 30-(fvar(38) * <move startup time>) && p2bodydist y = [-50-(enemy,vel y)*<move startup time>,0-(enemy,vel y)*<move startup time>]

;for air moves, do: trigger1 = p2bodydist x <= 30-(fvar(38) * <move startup time>)+vel x*<move startup time> && p2bodydist y = [-50-(enemy,vel y-vel y)*<move startup time>,30-(enemy,vel y-vel y)*<move startup time>]

[State 0, ChangeState]
type = ChangeState
triggerall = fvar(39)
trigger1 = fvar(36) = 0 && fvar(37) = 0
trigger1 = statetype != A && (ctrl || (stateno = [21,22]))
trigger1 = p2bodydist x > 55 && enemynear,statetype != A
value = 99
[State -1]
Type=Assertspecial
Triggerall=StateNo!=[120,160]
Trigger1=fvar(39)
flag=noairguard
flag2=nocrouchguard
flag3=nostandguard
ignorehitpause = 1
persistent = 1

[State 0, Helper]
type = Helper
trigger1 = !numhelper(33333333) && fvar(39)
helpertype = normal ;player
name = "PROJECTILE DETECTION BY INKTREBUCHET"
ID = 33333333
stateno = 33333333
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 9999
pausemovetime = 9999

[State 0, ChangeState]
type = ChangeState
triggerall = fvar(39)
trigger1 = fvar(36) = 0 && fvar(37) = 0
triggerall = enemynear,statetype != L
trigger1 = statetype != A && (ctrl || (stateno = [21,22]) || (stateno = 99 && time > 3))
trigger1 = p2bodydist x <= 55 && enemynear,statetype != A
trigger2 = stateno = 400 && movecontact
trigger2 = p2bodydist x <= 45 && enemynear,statetype != A
trigger1 = random < 800
value = 400+0*(fvar(36):=0)

[State 0, ChangeState]
type = ChangeState
triggerall = fvar(39)
trigger1 = fvar(36) = 0 && fvar(37) = 0
trigger1 = statetype != A && (ctrl || (stateno = [21,22]) || (stateno = 99 && time > 3))
trigger1 = p2bodydist x <= 92-(fvar(38) * 4) && enemynear,statetype != A
trigger1 = random < 800
trigger2 = stateno = 400 && movecontact
value = 410+0*(fvar(36):=1+(p2bodydist x > 70-(fvar(38) * 4)))

[State 0, ChangeState]
type = ChangeState
triggerall = fvar(39)
triggerall = fvar(36) = 1 && fvar(37) = 0
trigger1 = statetype != A && (ctrl || (stateno = [21,22]) || (stateno = 99 && time > 3))
