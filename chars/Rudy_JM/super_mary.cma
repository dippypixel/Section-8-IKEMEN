triggerall = enemynear,movetype = A || enemynear,numproj || (PlayerIDExist(helper(33333333),var(3)) && PlayerID(helper(33333333),var(3)), p2dist x > 0)  ;?????,??????????????,??????
trigger1 = facing!= EnemyNear,facing ;????,??inguarddist
