;---------------------------------------------------------------------------
; The State Entry

[Statedef -1]

;--------=AI By ashurii.nekoweb.org=--------
[State AI Enable]
type = VarSet
trigger1 = 1
fv = 39
value = ifelse(roundstate <= 2,AILevel,0)

;AI better distance code
[State 0, Null]
type = Null
trigger1 = 1
trigger1 = fvar(38):=(enemy,vel x * enemy,facing * facing)

;for when not particularly doing anything but could be doing something
[State 0, ChangeState]
type = ChangeState
triggerall = fvar(36) <= 0
triggerall = !(var(46)&floor(exp(0*ln(2)) + 0.5))
triggerall = !numhelper(1050)
triggerall = fvar(39)
triggerall = enemy,statetype != L
trigger1 = (ctrl)
trigger1 = statetype != A
trigger1 = random < 400
triggerall = NumEnemy       ; it is for when MUGEN Enemy is put behind your MUGEN character
value = 1000

[State 0, VarSet]
type = VarSet
triggerall = fvar(39)
triggerall = !numtarget && helper,numtarget = 0 && movetype != A && enemynear,movetype != H
trigger1 = roundstate=0
trigger2 = (ctrl)
fv = 36    ;fv = 10
value = 0

[State 0, VarSet]
type = VarSet
triggerall = fvar(39)
triggerall = !numtarget && helper,numtarget = 0 && movetype != A && enemynear,movetype != H
trigger1 = roundstate=0
trigger2 = (ctrl)
fv = 37    ;fv = 10
value = 0

[State 0, DisplayToClipboard]
type = AppendToClipboard
trigger1 = 1
text = "\nAI STUFF BY ASH - 36 = %d 37 = %d"
params = fvar(36),fvar(37)
ignorehitpause = 1

;---------------------------------------------------------------------------
[State -3,??]
type = ChangeState
value = 131 ;???stateno
triggerall = fvar(39) && statetype !=A ;ai?????????
triggerall = p2statetype = C
triggerall = (ctrl || stateno = 99) && p2statetype !=A ;????????????????
triggerall = enemynear,movetype = A || enemynear,numproj || (PlayerIDExist(helper(33333333),var(3)) && PlayerID(helper(33333333),var(3)), p2dist x > 0)
trigger1 = inguarddist ;inguarddist????????,????????????,???????
trigger1 = facing !=EnemyNear,facing ;facing ? enemynear,facing???:enemynear,facing = facing??????,????
trigger2 = p2bodydist x < 0 ;???????????inguarddist?
;---------------------------------------------------------------------------
