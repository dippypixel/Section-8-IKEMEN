;---------------------------------------------------------------------------
; No
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 0;cond((var(40) & floor(exp(2*ln(2)) + 0.5)), 2, 0)
ctrl = 0
anim = 1000
sprpriority = 2
facep2 = 1
velset = 0,0
poweradd = 100

[State HERE I GO]
type = PlaySnd
trigger1 = animelem = 6
value = S10000,1

[State Prorate]
type = VarSet
triggerall = Var(20) = 1 ;prevStateContact
trigger1 = Time = 0
fvar(10) = fvar(10) * 0.9
[State -2, StateContact reset]
type = VarSet
trigger1 = Time = 0
var(20) = 0
[State -2, StateContact?]
type = VarSet
triggerall = Var(20) = 0
trigger1 = MoveHit
var(20) = 1
ignorehitpause = 1

[State Reset No Contact Flag]
type = VarSet
trigger1 = !Time
trigger1 = (var(45) & floor(exp(0*ln(2)) + 0.5))
var(45) = var(45) ^ floor(exp(0*ln(2)) + 0.5)

[State Anim Change]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(command = "NoC",1002,ifelse(command = "NoB",1001,1000))

[State Anim Change]
type = ChangeAnim
triggerall = Time = 0
triggerall = fvar(39)
trigger1 = fvar(36) <= 0
value = 1001+random%2

[State Dashu Dasuto]
type = Explod
triggerall = time%2 = 0
trigger1 = Vel X > 0.5
anim = 6120
pos = -25,0
random = 10,0
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
vel = -random/400.0,-random/750.0
removetime = -2
pausemovetime = 0
scale = 0.5,0.5
sprpriority = 5
ownpal = 1
removeongethit = 0

[State Woosh]
type = PlaySnd
trigger1 = Animelem = 3
value = S0,2
channel = 2

[State 0, VelSet]
type = VelSet
triggerall = prevstateno = [200,599]
trigger1 = Animelem = 3
x = 6

[State Broi]
type = Helper
trigger1 = Animelem = 4
helpertype = normal
name = "Bang Projectile"
ID = 1050
stateno = 1049
pos = -50,0
postype = back
facing = 1
keyctrl = 0
ownpal = 1
size.xscale = 0.5
size.yscale = 0.5
supermovetime = 0
pausemovetime = 0

[State Drill Hitdef]
type = HitDef
triggerall = !(var(40) & floor(exp(2*ln(2)) + 0.5))
triggerall = !movecontact && !movereversed
trigger1 = Animelemtime(5) >= 0 && Animelemtime(6) < 0
attr = S,SA
hitflag = MAFD
guardflag = M;A
animtype = Hard
fall.animtype = Back
priority = 4,Hit
damage = 20,2
pausetime = var(2):=10,10
sparkno = S6004
guard.sparkno = S6041
sparkxy = -12-0*ceil(fvar(0):=33.0),ceil(fvar(1):=-67.0)
hitsound = S5,2
guardsound = S6,1
ground.type = Low
air.type = Low
ground.slidetime = 50
ground.hittime = 50
guard.slidetime = 50
guard.hittime = 19
air.hittime = 50
airguard.hittime = 19
airguard.ctrltime = 19
down.hittime = 50
yaccel = 0.4
ground.velocity = 0,0
guard.velocity = -4
air.velocity = 0,0
airguard.velocity = -3,-0.8
down.velocity = 0,0
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
p2facing = 1
air.fall = 1
fall.recover = (var(39) >= 1)
fall.recovertime = 2100
down.bounce = 1
id = 1000
kill = 0
guard.kill = 0
envshake.time = 8
envshake.ampl = -1
envshake.freq = 180
;getpower = 100,50
;givepower = 50,25

[State Special Move Juggle]
type = VarSet
trigger1 = movehit = [1,2]
trigger1 = numtarget
trigger1 = target,GetHitVar(fall)
var(40) = var(40) | floor(exp(2*ln(2)) + 0.5)
ignorehitpause = 1
persistent = 0

[State Jump cancel]
type = ChangeState
triggerall = (var(45) & floor(exp(0*ln(2)) + 0.5))
triggerall = animelemtime(3) >= 0
trigger1 = command = "holdup" && !AILevel
value = 40
ctrl = 0

[State Jump cancel]
type = ChangeState
triggerall = (var(45) & floor(exp(0*ln(2)) + 0.5))
triggerall = animelemtime(3) >= 0
trigger1 = 1 && fvar(39)
value = 41+0*(fvar(36):=1)*(fvar(37):=1)
ctrl = 0

[State n0GGA]
type = StateTypeSet
trigger1 = AnimelemTime(6) = 0
movetype = I

[State Das Ende]
type = ChangeState
trigger1 = Animtime = 0
value = 0
ctrl = 1

;No Projectile Setup (This is the first projectile of the game!)
