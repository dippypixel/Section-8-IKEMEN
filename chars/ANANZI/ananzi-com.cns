; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = cond(var(15)=1,4.4,cond(sysvar(1)=0, const(velocity.jump.neu.x), cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x))))
y = cond(var(15)=0,const(velocity.jump.y),-9.5)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 0, Explod]
type = Explod
trigger1 = AnimTime = 0
anim = 7163
pos = 0,10
facing = cond(random<500,1,-1)
;scale = 0.3,0.3
sprpriority = 3
ownpal = 1

[State 0, Explod]
type = Explod
trigger1 = AnimTime = 0
anim = f 64
scale = 0.5,0.5
pos = 0,10
facing = cond(random<500,1,-1)
sprpriority = 0
ownpal = 1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

