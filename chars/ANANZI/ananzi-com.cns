; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, b]
type = ChangeAnim
triggerall = life <= 250
trigger1 = Anim != 2 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 2

;st-critical BATALLA FINAL
[State 0, b]
type = ChangeAnim
triggerall = StageVar(info.name) = "caos-4"
trigger1 = Anim != 2 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 2

;st-critical
[State 0, 1]
type = ChangeAnim
triggerall = life > 250
triggerall = StageVar(info.name) != "caos-4"
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

;sonido de araña, NO CRITICAL
[State 430, 1]
type = PlaySnd
triggerall = life > 250
trigger1 = animelem = 49
value = 5, 1
volume = 150
freqmul = 1.5

[State 191, Snd 2]
type = PlaySnd
triggerall = life <= 250
trigger1 = animelem = 7
value = 11,8
freqmul = 1.0 +(random/5000.0)

;termina DF
[State 0, ChangeState]
type = ChangeState
trigger1 = var(10) = 1 && power = 0
value = 3501
ctrl = 0

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;termina DF
[State 0, ChangeState]
type = ChangeState
trigger1 = var(10) = 1 && power = 0
value = 3501
ctrl = 0

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

;salto largo
[State 100, 4]
type = ChangeState
trigger1 = command = "holdup"
trigger2 = command = "holdfwd" && command = "holdup"
trigger3 =  command = "holdback" && command = "holdup"
value = 40
ctrl = 0

;ataques basicos
;---------------
[State 100, 4]
type = ChangeState
trigger1 = command = "x"
value = 200
ctrl = 0

[State 100, 4]
type = ChangeState
trigger1 = command = "y"
value = 210
ctrl = 0

[State 100, 4]
type = ChangeState
trigger1 = command = "a"
value = 230
ctrl = 0

[State 100, 4]
type = ChangeState
trigger1 = command = "b"
value = 240
ctrl = 0
;----------------------

[State 100, 4]
type = ChangeState
trigger1= var(24)=0 && command != "holdfwd"
trigger2= var(24)!=0 && p2bodydist x<60 && NumHelper(1100) = 0
trigger3= var(24)>=2 && var(24)<=3 &&enemynear, name = "ananzi" && enemynear, numhelper(1100)=1
trigger4 = var(24)>=2 && var(24)<=3 && enemynear, name = "ananzi" && enemynear, stateno = 3100
trigger5= var(24)!=0 && NumHelper(1100) = 1
trigger5 = helper(1100), stateno = 1103 && p2dist x <=50
value = 0
ctrl = 1

[State 106, 3]
type = MakeDust
trigger1 = animelem = 2
trigger2 = animelem = 5
trigger3 = animelem = 9
pos = -57,0
spacing = 1

[State 820, 5]
type = Envshake
trigger1 = animelem = 2
trigger2 = animelem = 5
trigger3 = animelem = 9
time = 8
ampl = 2
freq = 120

[State 430, 1]
type = PlaySnd
trigger1 = !time
value = 5, 1
freqmul = 1.4
channel = 0

[State 430, 1]
type = PlaySnd
trigger1 = animelem = 2
trigger2 = animelem = 5
trigger3 = animelem = 9
value = 6, 5
freqmul = 0.9+(random/3333.3)
volume = -50

