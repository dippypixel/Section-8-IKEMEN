;===============================================================================
; ------- Damage Dampener --------
;===============================================================================

[State -2, Counter Flag]
type = VarSet
trigger1 = NumEnemy
fvar(13) = (EnemyNear, MoveType = A)
ignoreHitPause = 1

;Damage Dampener Variable (by POTS)
[State -2, Hit Count]
type = VarAdd
triggerall = !NumProjID(1337)
trigger1 = !IsHelper
trigger1 = MoveHit = 1
trigger1 = !HitPauseTime
trigger1 = !(HitDefAttr = SCA, AT)
fvar(14) = 1

[State -2, Hit Count Reset]
type = VarSet
trigger1 = NumEnemy && fvar(14)
trigger1 = (EnemyNear, MoveType != H) && (EnemyNear, StateNo != 5300)
fvar(14) = 0
ignoreHitPause = 1

[State -2, Dampener]
type = VarSet
trigger1 = 1
fvar(9) = cond(fvar(14) < 1, 30, cond(fvar(14) >= 29, 1, 30 - fvar(14))) / 30.0
ignoreHitPause = 1

[State -2, Dampener Limit]
type = VarSet
trigger1 = fvar(9) < 0
fvar(9) = 0
ignoreHitPause = 1

[State -2, Root Dampener]
type = VarSet
trigger1 = 1
fvar(10) = fvar(9) * cond(fvar(13), 1.2, 1)
ignoreHitPause = 1


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]


;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 1
persistent = 0
freqmul = 0.9+(random/0.333)

[State 0, PlaySnd]
type = PlaySnd
triggerall = time=1
trigger1 = stateno = 50
trigger2 = stateno = 105
value = 0,cond(random<500,1,2)
volume = -100
freqmul = 0.8+(random/6666.6)

;sonido camina
[State 0, PlaySnd]
type = PlaySnd
triggerall = (anim = 20)||(anim = 21)
trigger1 = animelem = 2
trigger2 = animelem = 5
value = 40,1
volume = -50
freqmul = 1.0+(random/3333.3)

;se cancela afterimage si es golpeado
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = movetype = h
time = 0

;DF cancela DF
[State -3, cancela]
type = ChangeState
triggerall = var(10) >0 && power > 0 && life !=0
triggerall = statetype !=A && command = "legion" && ctrl
trigger1 = var(24) = 0
trigger2 = var(24) = 3
trigger3 = var(24) = 1 && power <=1000
trigger4 = var(24) = 2 && power <=1000
trigger5 = var(24) = 4 && power <=1000
value = 3501
ctrl = 0

;termina DF
[State 0, ChangeState]
type = ChangeState
trigger1 = var(10) = 1 && power = 0 && ctrl && statetype = s
value = 3501
ctrl = 0

;DF aumenta defensa
[State -3, defence]
type = defencemulset
trigger1 = var(10) >0
value = 0.7

;Survival winscreen partner
;------------------
[State 0, ChangeState]
type = ChangeState
triggerall = numpartner
trigger1 = partner,stateno=18000 && stateno !=18000 && stateno !=18001
value = 18001

;Survival winscreen enemigo
[State 0, ChangeState]
type = ChangeState
triggerall = numenemy
trigger1 = enemynear,stateno=18000 && stateno !=18002
value = 18002

;sangre constante
[State 0, Helper]
type = Helper
triggerall = movetype != H && alive = 1
triggerall = stateno != 3100 && stateno != 3101
triggerall = stateno != 4000 && stateno != 4001
triggerall = random < 10
trigger1 = life < 250
trigger1 = roundstate = 2
trigger1 = StageVar(info.name) != "caos-4"
trigger2 = StageVar(info.name) = "caos-4"
trigger2 = roundstate != 3 && roundstate != 4
name = "sangre constante"
ID = 6100
stateno = 6100
pos = ceil(-8+(random/60)), ceil(cond(statetype!= c,-40,-10)-(cond(statetype != c,(random/16),(random/40))))
facing = cond(random<500,1,-1)
ownpal = 1

;DF
;baja el poder mientras esta en DF si es golpeado
[State -3, PowerAdd]
type = PowerAdd
triggerall = var(10) > 0
trigger1 = movetype = H && !time
value = -60

