;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;AI Guarding Coding (Shirayuki33desu)
;=======================Start==========================
[State -3, ChangeState]
type = ChangeState
value = 130
triggerall = !IsHelper
triggerall = RoundState = 2
triggerall = Alive
triggerall = Var(59) && StateType != A
triggerall = P2StateType != C
triggerall = NumEnemy
triggerall = !EnemyNear, HitDefAttr = SCA,NT,ST,HT
triggerall = Ctrl
triggerall = !var(3)>0
trigger1 = InGuardDist
trigger1 = Facing != EnemyNear, Facing
trigger2 = Facing = EnemyNear, Facing
trigger2 = P2Dist X > 0
trigger2 = P2BodyDist X > -10 ; to be changed for your own need
trigger2 = P2MoveType = A
trigger3 = P2BodyDist X < 0 && P2MoveType = A

[State -3, ChangeState]
type = ChangeState
value = 131
triggerall = !IsHelper
triggerall = RoundState = 2
triggerall = Alive
triggerall = Var(59) && StateType != A
triggerall = P2StateType = C
triggerall = NumEnemy
triggerall = !EnemyNear, HitDefAttr = SCA,NT,ST,HT
triggerall = Ctrl && P2StateType != A
triggerall = !var(3)>0
trigger1 = InGuardDist
trigger1 = Facing != EnemyNear, Facing
trigger2 = P2BodyDist x < 0 && P2MoveType = A

[State -3, ChangeState]
type = ChangeState
value = 132
triggerall = !IsHelper
triggerall = RoundState = 2
triggerall = Alive
triggerall = Var(59) && StateType = A
triggerall = Ctrl
triggerall = !var(3)>0
trigger1 = InGuardDist
trigger2 = P2BodyDist X < 0 && P2MoveType = A
;=======================End============================

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = s40, 1
volumescale = 150

[State -3, Jumping Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = Stateno = 40
value = s40, 0
volumescale = 300

[State -3, Walking Sound]
type = PlaySnd
triggerall = AnimElem = 3 || AnimElem = 7
trigger1 = Anim = 20 || Anim = 21
value = s40, 1
volumescale = 150

[State -3, Running Sound]
type = PlaySnd
triggerall = AnimElem = 3 || AnimElem = 7
trigger1 = Anim = 100
value = s40, 1
volumescale = 150

[State -3, Running Back Sound]
type = PlaySnd
triggerall = AnimElem = 3
trigger1 = Anim = 105
value = s40, 1
volumescale = 150

[State -3, Stop Running Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = Anim = 101
value = s40, 2
volumescale = 300

[State -3, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 905
id = 905
persistent = 1

[State -3, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 907
id = 906
persistent = 1

[State -3, ChargeSndStop]
type = StopSnd
trigger1 = stateno != 905
trigger1 = stateno != 907
channel = 8

[State -3, StopIntroSnd]
type = StopSnd
trigger1 = RoundState = 2
channel = 2

[State -3, GetHitVocal]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 600
triggerall = Alive
trigger1 = StateNo = 5000 ;Stand get hit.
trigger2 = StateNo = 5010 ;Crouch get hit.
trigger3 = StateNo = 5020 ;Air get hit.
trigger4 = StateNo = 5070 ;Tripped.
value = s5000, Random%8
volumescale = 250
channel = 0

[State -3, GetUpVocal]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 700
trigger1 = StateNo = 5120 ;Get Up
value = S5001, Random%3
volumescale = 250
channel = 0
