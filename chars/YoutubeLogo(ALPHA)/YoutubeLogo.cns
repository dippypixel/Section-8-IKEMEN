[Quotes]
victory1 = "I am in missouri!"
victory2 = "Ever heard of the song Marble Soda? Good song..."
victory3 = "Bfbkid ain't got nothing on this!"
victory4 = "That defeat was so bad, I could make an Animation Meme out of it!"
victory5 = "Most of my victory quotes are inside jokes and references, sorry about that."
victory6 = "Well when life gives you lemons!"
victory7 = "That's what you missed on, Inanimate Insanity!"
victory8 = "Time for pizza!"
victory9 = "Did, uh, I, did I win?"
victory10 = "Umga, really? Cool!"
victory11 = "Still waiting for BFB 13..."
victory12 = "You just got Coconut Mall'd!"
victory13 = "Animation Memes are KING!"
victory14 = "No, I don't know what happened to my Little Mac Amiibo either..."
victory15 = "YOU GOT KNOCKED THE FRICK OUT MAN!"
victory16 = "YOU GOT KNOCKED THE... nevermind..."
victory17 = "Sorry for the beating... wanna play Little Big Planet 3 with me to make up for it? :)"
victory18 = "What's a DP input?"
victory19 = "If you weren't such a poopoo head I wouldn't have to take you down..."
victory20 = "And the winner is... YoutubeLogo!"
victory21 = "Majestic Objects? Cool intro, but crappy creator."
victory22 = "To celebrate my victory, I am gonna play One Piece Pirates' Carnival for the PS2!"
victory23 = "Grrrr, we gotta get spongebob back. :("
victory24 = "I don't know any of these fighters, I'm just happy to be here. :D"
victory25 = "Thank you for 100 subscribers!"
victory26 = "This poopoo head just got pood on!"
victory27 = "Did the Nintendo Switch come out yet? I can't wait to play it!"
victory28 = "If you want to cry about it, go to my Youtube Chat and complain to me there bud!"
victory29 = "What am I doing here? I LOVE object shows!"
victory30 = "Going into middle school is scary..."
;Against Self
victory31 = "You're sus, I'm voting you out IMPOSTER!"
victory32 = "That is some really nice fanart of me!"
victory33 = "I never knew I was this strong! I can take on anyone!"
;Against Green
victory34 = "So I see you watch SMG4 too, we could be great friends!"
victory35 = "Please, tone it down next fight! You're really loud dude!"
;Against TMS
victory36 = "Even after all that pestering of making me subscribe, I still didn't! Dab on that!"
victory37 = "Really? A Dragon Ball OC? I mean I know I am an object show OC but come on!"
;Against Mario
victory38 = "It's a me! YoutubeLogo!"
victory39 = "I can't believe I beat THE Super Mario! I gotta spread the news!"
victory40 = "Oh crap Mario! Are you okay!"
;Against Luigi
victory41 = "Luigi, you're so freaking awesome! It was amazing fighting you!"
victory42 = "You're a player 1 in my game Luigi!"
victory43 = "I loved playing Luigi's Mansion Dark Moon, you're a great ghost buster!"
;Against Sonic
victory44 = "I think YOU gotta step it up buddy."
victory45 = "Good fight Sonic! You gotta teach me that spindash dude!"

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181+random%2

;---------------------------------------------------------------------------
; Win - Pimp Named Slickback!
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0
ignorehitpause = 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nomusic
ignorehitpause = 1
persistent = 1

[State 181, PlaySnd]
type = PlaySnd
trigger1 = !Time
value = S180,0
volumescale = 350
ignorehitpause = 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = (time > 0) && (time <= 680)
flag = RoundNotOver
ignorehitpause = 1

