trigger1 = enemy,name = "SMG4 if he was a stickman" && enemy,authorname = "CallMeTony"
value = 34+(random%2)

[State -2, Specific Quote]
type = VictoryQuote
trigger1 = enemy,name = "goku but black (but also old)" && enemy,authorname = "CallMeTony, TwinMotionStudios"
value = 36+(random%2)

[State -2, Specific Quote]
