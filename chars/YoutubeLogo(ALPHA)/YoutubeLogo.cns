;Super Jump
[Statedef 900]
type = A
movetype = I
physics = N
anim = 900
velset = 0,-12
ctrl = 1

[State 900, 0]
type = VelAdd
trigger1 = 1
y = 0.5

[State 900, AfterImage]
type = AfterImage
trigger1 = time = 1
time = 80
length = 6
palcolor = 256
palinvertall = 0
palbright = 50,50,50
palcontrast = 120,120,220
palpostbright = 0,0,0
palmul = .65,.65,.75
timegap = 2
framegap = 1
trans = Add

[State 900, AfterImageTime]
type = AfterImageTime
trigger1 = Pos Y >= 5
time = 1
value = 0

[State 900, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = s900, 0
volumescale = 300

[State 900, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = s900, 1

[State 900, VelAdd]
type = VelAdd
trigger1 = command = "holdfwd" && vel x < 8
x = 0.6

[State 900, VelAdd]
type = VelAdd
trigger1 = command = "holdback"  && vel x > -8
x = -0.6

[State 900, ChangeState]
type = ChangeState
trigger1 = Pos Y >= 1
value = 52

