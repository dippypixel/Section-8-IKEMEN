; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Santana"        ;Name of character
displayname = "Santana" ;Name of character to display
versiondate = 09,30,2009    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.1         ;Version of M.U.G.E.N character works on (X.XX)
author = "Ryder The JoJo & Ditchu"         ;Character author name
pal.defaults = 1, 2, 3      ;Default palettes in order of preference (up to 4)
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = santana.cmd           ;Command set
cns     = Santana.cns           ;Constants
st      = Santana.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = santana.sff           ;Sprite
anim    = santana.air           ;Animation
sound   = Santana.snd           ;Sound
ai      = kfm.ai            ;AI hints data (not used)

pal1  = pal/anime.act
pal2  = pal/animedark.act
pal3  = pal/manga.act
pal4  = pal/early manga.act

; Maps character selection buttons to palette numbers.
[Palette Keymap]
a = 1 ;Press button X to select palette 1, etc.
b = 2
c = 3
x = 4
y = 5
z = 6
;x2 = 7 ;Hold Start and press button X for palette 7, etc.
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12

; Arcade mode
[Arcade]
intro.storyboard = 
ending.storyboard = 
