;立ち弱
[Statedef 200]
type    = S ;stand
movetype= A ;attack
physics = S ;立ち。摩擦とか
juggle  = 1 ;基本データのairjuggleから減らす
velset = 0,0 ;速度。ぴたっと止める
poweradd = 10*!(var(20)=1)
ctrl = 0     ;キー入力不可
anim = 200
sprpriority = 2
facep2 = 1   ;1でそのステート入った途端に相手側に振り向く

[State 200, ヒット定義]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA ;立ち通常打撃（Standing, Normal Attack）
damage = ceil(ifelse((20*fvar(7))<3,3,(20*fvar(7)))),0
animtype = Light
priority = 2, Hit
guardflag = MA
pausetime = 9, 11
sparkno = s20000
guard.sparkno = s20005
sparkxy = -10, -86
hitsound = s2,0
guardsound = s2,6
getpower = 20*!(var(20)=1)
givepower = 5,0
ground.type = high    ;地上でののけぞり方
ground.slidetime = 5;ヒットバック時間
ground.hittime  = 10 ;相手が行動不能になる時間
ground.velocity = -6 ;ヒットバック速度
air.velocity = -1.4,-1.4

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
trigger1 = Random = [0,499]
value = 0, 0
channel = 0       ;チャンネル0は、ボイス再生専用

[State 0];空振り音
