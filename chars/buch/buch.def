
[Info]
Name         = "Bruno"             ;名前（省略不可）
DisplayName  = "Bruno Bucciarati"  ;表示される名前（省略可）
VersionDate  = 01,07,2010          ;最終更新日
MugenVersion = 04,14,2002
Author       = "yoroko"            ;作成者（省略不可）
Pal.Defaults = 4,6                   ;CPUで出てきた時のカラーパレットの順番

;-----------------------------------------------------------------------------

[Files]
Cmd     = buch.cmd.cns       ;コマンドファイルの登録
Cns     = buch.cns       ;コンスタンツファイルの登録
St      = buch.cns       ;ステートファイルの登録・最大１１個まで増やせます
st1     = damage.cns
st2     = dem_buch.cns
st3     = _Config.txt
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません
StCommon = common1.cns  ;コモンステートファイルの登録
Sprite  = buch.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = buch.air       ;アニメーションファイルの登録
Sound   = buch.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録


Pal1 = white.act  ;Ａボタンで決定した色が使えます
Pal2 = yellow.act  ;Ｂ                           
Pal3 = aquablue.act  ;Ｃ                             
Pal4 = blue.act  ;Ｘ                           
Pal5 = violet.act  ;Ｙ                          
Pal6 = black.act  ;Ｚ                           

;Pal7 = kfm7.act  ;スタート押しながらＡ
;Pal8 = kfm8.act  ;Ｓ押しながらＢ
;Pal9 =           ;Ｓ押しながらＣ
;Pal10=           ;Ｓ押しながらＸ
;Pal11=           ;Ｓ押しながらＹ
;Pal12=           ;Ｓ押しながらＺ


[Arcade]
;Intro.Storyboard = intro.def   ;オープニングのファイルを登録します
;Ending.Storyboard = ending.def ;エンディングのファイルを登録します
