; KO Voice
[Statedef 179]
type = S
ctrl = 0
anim = 9741
velset = 0,0


[State WHAM Timer]
type = VarSet
trigger1 = 1
var(30) = parent,var(32)
ignorehitpause = 1
[State WHAM Timer]
type = VarSet
trigger1 = (parent,var(33)=0)
v = 32
value = 0
ignorehitpause = 1
[State WHAM Timer]
