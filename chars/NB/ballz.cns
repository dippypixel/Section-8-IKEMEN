;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw - thrown into the air
; (a custom gethit state)
; Description: This state has the opponent flying through the air and
;     falling down onto the ground. The SelfState controller sets the
;     opponent back using to his own state file when he his the ground.
;     Controllers 821,2 and 821,3 allow the opponent to recover by
;     hitting his recovery command when he is falling.
[Statedef 821]
type    = A
movetype= H
physics = N
velset = -1.5,-7
poweradd = 60

[State 0, PosFreeze]
type = PosFreeze
trigger1 = time <= 12
value = 1
ignorehitpause = 1
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time <= 12
value = 5012
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time > 12
trigger1 = anim != 5017
trigger1 = animtime = 0
value = 5017
[State 0, SelfState]
type = SelfState
trigger1 = time = 12
trigger1 = !alive
value = 5050
[State 821, 1] ;Gravity
type = VelAdd
trigger1 = time > 12
Trigger1 = statetype = A
y = .88
[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = time > 12
trigger1 = vel y > 0
trigger1 = vel y + pos y >= 0
statetype = S
physics = N
ignorehitpause = 1
[State 0, VelSet]
type = VelSet
trigger1 = statetype != A
y = 0
[State 0, VelSet]
type = PosSet
trigger1 = statetype != A
y = 0
[State 0, VelSet]
type = VelMul
trigger1 = statetype != A
x = 0.9
[State 0, HitFallSet]
type = HitFallSet
trigger1 = statetype != A
value = 0


[State 821, 4] ;Hit ground
type = SelfState
trigger1 = time >= 42
value = 0
ctrl = 1


