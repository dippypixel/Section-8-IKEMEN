;---------------------------------------------------------------------------
[Statedef -1]

;===========================================================================
;---------------------------------------------------------------------------
[State -1, AI Guard]
Type = ChangeState
Value = 120
triggerall = StateType != A && Var(15)
triggerall = ctrl || stateno = 195
triggerall = !(enemynear,hitdefattr=SCA,AT) && inguarddist
triggerall = (stateno!=[120,155])
trigger1 = (Var(15)**3)*2*0.9 > random && RoundState = 2

[State -1, AI Jump]
Type = ChangeState
Value = 40
triggerall = Ctrl && StateType = S
triggerall = Var(15) && (Var(15)**3)*2*0.1 > random && RoundState = 2
trigger1 = P2BodyDist X > 96
trigger2 = P2BodyDist X > 128 && (Enemy,StateNo = [5080,5150])

[State -1, AI JumpForward]
Type = VarSet
sysvar(1) = 1
triggerall = Var(15)
trigger1 = StateNo = 40 || StateNo = 45
trigger1 = P2BodyDist X > 8

;===========================================================================
;---------------------------------------------------------------------------
;Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "FF" && Var(15) = 0
trigger2 = P2BodyDist X < 152 && Enemy,StateNo < 5080
trigger2 = Var(15) && (Var(15)**3)*2*0.4 > random && RoundState = 2
trigger2 = (StateNo != [52,105]) && PrevStateNo != 52
trigger3 = P2BodyDist X >= 152
trigger3 = Var(15) && (Var(15)**3)*2*0.6 > random && RoundState = 2

;---------------------------------------------------------------------------
;Run Back
[State -1, Run Back]
type = ChangeState
value = 105
triggerall = statetype = S
