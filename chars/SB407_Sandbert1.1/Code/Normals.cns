type = S
movetype = I
physics = S
ctrl = 0
anim = 195
sprpriority = 2

[State 0, VelSet]
type = VelSet
trigger1 = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
x = 0
y = 0 

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 5
value = S195,0
channel = 0

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

