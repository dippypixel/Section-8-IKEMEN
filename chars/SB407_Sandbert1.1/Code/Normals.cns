trigger1= pos y > -vel y
;trigger1= pos y - const(size.mid.pos.y) > -vel y
value = 6100 ;Hit ground

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]


[State -2, RemapPal]
type = RemapPal
trigger1 = palno = 12
source = 1,1
dest = 1+(facing = -1),palno

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 3200
id = 3200

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Velocity Deterioration = %f, Damage Dampener = %f, Super Jump = %d"
params = fvar(20), fvar(11), var(55)
ignorehitpause = 1

[State -2, Only losers use juggles!]
type = AssertSpecial
trigger1 = 1
flag = nojugglecheck
ignorehitpause = 1

[State -2, Reset Shine]
type = VarSet
trigger1 = !numtarget || enemy, movetype != H
trigger1 = var(12)
v = 12
value = 0
ignorehitpause = 1
[State -2, Reset Aerial IPS]
type = VarSet
trigger1 = !numtarget || enemy, movetype != H
trigger1 = var(8)
v = 8
value = 0
ignorehitpause = 1
[State -2, Reset OTG IPS]
type = VarSet
trigger1 = !numtarget || enemy, movetype != H
trigger1 = var(10)
v = 10
value = 0
ignorehitpause = 1
[State -2, Reset Air Jump]
type = VarSet
trigger1 = statetype != A
v = 45
value = 0
ignorehitpause = 1
[State -2, Reset Wall Jump]
type = VarSet
trigger1 = statetype != A
v = 53
value = 0
ignorehitpause = 1

[State -1, Reset Roman Cancel]
type = VarSet
v = 15
value = 0
trigger1 = var(7) != 0
trigger2 = (!numhelper(1000) && stateno != 1000) && (!numhelper(3000) && stateno != 3000)
trigger3 = movetype = H
[State -1, Reset Roman Cancel]
type = VarSet
fv = 7
value = 1
trigger1 = !numtarget || enemy, movetype != H

[State -2, Roman Cancel FX]
type = VarAdd
trigger1 = var(5) != 0
v = 5
value = -64
[State -2, Roman Cancel FX]
type = PalFX
trigger1 = var(5) != 0
time = 1
add = var(5),var(5),var(5)
mul = 256,256,256
sinadd = 0,0,0,1
invertall = 0
color = 256

[State 0, VarAdd]
type = VarAdd
trigger1 = var(14) > 0
v = 14
value = -32
ignorehitpause = 1
[State 1200, Lucky 7 Hits]
type = PalFX
trigger1 = var(14) > 0
time = 2
add = var(14),var(14),var(14)
mul = 256,256,256
sinadd = 0,0,0,0
invertall = 0
color = 0
ignorehitpause = 1

[State 1020, Afterimage]
type = AfterImage
trigger1 = var(56) = 1
length = 12
PalBright   =  30,30,30
PalContrast =  35,35,35
PalAdd      = 25,25,25
PalMul      = .8,.8,.8
TimeGap  = 1
FrameGap = 3
Trans = Add
time = 2
[State 1020, Afterimage]
type = AfterImageTime
trigger1 = Vel Y < 0
trigger1 = var(56) > 0
time = 2
ignorehitpause = 1
[State 0, VarSet]
type = VarAdd
triggerall = var(56) < 2
trigger1 = movetype != H && prevstateno = 41
v = 56
value = 1
ignorehitpause = 1
[State 0, VarSet]
type = VarSet
triggerall = var(56) > 0
trigger1 = statetype = A
trigger1 = Vel Y >= 0
trigger2 = statetype != A
trigger3 = movetype = H 
trigger4 = stateno = 1300
v = 56
value = 0
ignorehitpause = 1

[State -2, Super jump Movement variable]
type = VarSet
trigger1 = stateno = 50 && vel Y <= -2.5
trigger1 = prevstateno = 41
v = 55
value = 1
ignorehitpause = 1
[State -2, Super jump Movement variable]
type = VarSet
trigger1 = statetype != A
trigger2 = movetype = H
trigger3 = (stateno = [1100,3999])
trigger4 = stateno = 707
trigger5 = stateno = 45 || stateno = 55
v = 55
value = 0
ignorehitpause = 1
[State -2, Move Right]
type = VelAdd
triggerall = statetype = A
triggerall = var(55) != 0
triggerall = Vel X < const(velocity.jump.fwd.x)
triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = command = "holdfwd" && command != "holdback"
x = const(velocity.jump.fwd.x)*0.3
[State -2, Move Left]
type = VelAdd
triggerall = statetype = A
triggerall = var(55) != 0
triggerall = Vel X > const(velocity.jump.back.x)
triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = command = "holdback" && command != "holdfwd"
x = const(velocity.jump.back.x)*0.3
[State 0, Turn]
type = Turn
triggerall = var(55) != 0
triggerall = p2dist X < 0
triggerall = (stateno != 1200) && (stateno != [1300,1301])
trigger1 = (stateno = 610) && (AnimElemTime(5) >= 0) || (stateno = 600 || stateno = 630) && (AnimElemTime(4) >= 0)
trigger2 = stateno = 615 || stateno = 50

;Velocity Deterioration system (Edited from RicePigeon's Damage Proration system)
[State -2, Reset velocity dampener]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,statetype!=A)
trigger2 = !numenemy
fvar(20) = 1.0
[State 0, Make sure it never goes under the limit]
type = VarSet
trigger1 = fvar(20) < 0.25
fv = 20 
value = 0.25
ignorehitpause = 1

;RicePigeon Damage Proration system
[State -2, Reset var when the opponent recovers]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(10) = 1.0
[State -2, Final Dampen]
type = null
trigger1 = (fvar(11) := ifelse(0.25>fvar(10),0.25,fvar(10))) || 1
ignorehitpause = 1
[State -2, Dampener itself]
type = Attackmulset
trigger1 = 1
value = fvar(11)
ignorehitpause = 1


;POTS Code
[State -2, Throws Disallowed]; Resets condition every tick to check again
type=varset
trigger1= 1
var(38)= 0
[State -2, Throws Disallowed]
type=varset
trigger1= (enemynear,stateno=[150,155])
trigger2= (enemynear,movetype=H && enemynear,statetype!=A)
trigger3= (enemynear,stateno=[5020,5040]) && !(enemynear,hitfall)
trigger4= ((enemynear,stateno=0) || (enemynear,stateno=52)) && (enemynear,prevstateno=[5000,5040]) && ((enemynear,time<=0) || !(enemynear,ctrl))
trigger5= (enemynear,stateno=0) && (enemynear,prevstateno=52) && ((enemynear,time<=0) || !(enemynear,ctrl))
trigger6= (enemynear,stateno=40) && (enemynear,time>=1 || enemynear,prevstateno=0 || enemynear,prevstateno=52)
var(38)= 1

[State -2, P2 Safe Fall]
type= targetstate
trigger1= numtarget=1; Just to prevent Simul mode shenanigans
trigger1= target,command="recovery"
trigger1= target,pos y>=-25 && target,vel y>0
trigger1= target,alive && target,hitfall && target,gethitvar(fall.recover)
trigger1= target,stateno=5030 || target,stateno=5035 || target,stateno=5050 || target,stateno=5071
value= 5205
ignorehitpause= 1

[State -2, P2 Facing]
type= targetfacing
trigger1= movecontact=1 && numtarget=1
trigger1= !(target,hitshakeover) && !(target,hitfall) && (target,time<=1)
value= ifelse(p2dist x>=0, -1, 1)
ignorehitpause= 1

;Wavedash stuff
[State -2, Wavedash Disable]
type = VarSet
triggerall = var(50)
trigger1 = statetype != A
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = stateno = 20 || stateno = [100,105]
trigger3 = stateno = 1100
trigger4 = stateno = 50
v = 50
value = 0
[State -2, Wavedash Traction]
type = VelMul
trigger1 = var(50)
trigger1 = statetype != A
x = .96
[State -2, Wavedash Physics]
type = StateTypeSet
trigger1 = var(50)
trigger1 = statetype = S
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger1 = stateno != 1100
physics = S
[State -2, Wavedash Physics]
type = StateTypeSet
trigger1 = var(50)
trigger1 = statetype = C
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger1 = stateno != 1100
physics = C
[State -2, Wavedash Physics]
type = StateTypeSet
trigger1 = var(50)
trigger1 = statetype != A
trigger1 = stateno != 1100
physics = N
[State -2, Can't walk during wavedash]
type = AssertSpecial
trigger1 = var(50)
trigger1 = abs(vel x) > 3
trigger1 = statetype != A
flag = nowalk

[State -1, Reset Airdodge var]
type = VarSet
v = 51
value = 0
trigger1 = statetype != A

;===========CUSTOM FALL STATES==============================================

[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5020
value = 6020
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5050
value = 6050
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5070
value = 6070
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != 6530 && target,stateno != [6020,6120]
trigger1 = target,stateno = 5080
value = 6080;ifelse(var(10),6530,6080)
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;POTS stuff

[State -3, Corner Push]; Reset
type= varset
trigger1= fvar(5)
trigger1= numtarget
trigger1= (target, hitover) || (target, gethitvar(hitshaketime) > 0 && target, time <= 0)
fvar(5)= 0
[State -3, Corner Push]; Get initial velocity
type= varset
trigger1= movecontact=1 && numtarget
fvar(5)= (target, gethitvar(xvel))
ignorehitpause= 1
[State -3, Corner Push]; Apply corner push
type= posadd
triggerall= fvar(5)
triggerall= (statetype = S || statetype = C) && numtarget
triggerall= !hitpausetime && (target, gethitvar(hitshaketime) <= 0)
triggerall= (target, statetype != L)
trigger1= target, frontedgebodydist <= abs(target, vel x)
trigger1= (target, gethitvar(xvel) * target, facing) > 0
trigger2= target, backedgebodydist <= abs(target, vel x)
trigger2= (target, gethitvar(xvel) * target, facing) < 0
x= ifelse(target, frontedgebodydist <= 0, -1, 1) * (target, facing) * fvar(5)
[State -3, Corner Push]; Apply friction to the velocity
type= varset
trigger1= numtarget
trigger1= target, gethitvar(hitshaketime) <= 0
fvar(5)= fvar(5) * 0.85

[State -3, Prevent Undergound Juggles]
type= targetbind
trigger1 = fvar(10) > 0
trigger1= movehit=1
trigger1= numtarget=1 && numenemy
trigger1= (target,time<=1) && (target,ID=enemynear,ID); this is just to prevent Simul issues as usual
trigger1= !(target,hitshakeover) && (target, hitfall) && (target, pos y>0)
pos= ceil(p2dist x), ceil(-pos y); keeps P2 at the same horizontal distance, but resets his Y position
ignorehitpause= 1

[State -3, Variable Height]
type= playerpush
triggerall= statetype=A && movetype!=H && numenemy
triggerall= p2bodydist x = [-(enemynear,const(size.ground.back) + enemynear,const(size.ground.front)), 0]; checks if both characters are within each other's width
trigger1= p2statetype=S
trigger1= p2dist y >= (enemynear,const(size.height) - 28)
trigger2= p2statetype=C
trigger2= p2dist y >= (enemynear,const(size.height) - 49)
trigger3= p2statetype=L
trigger3= p2dist y >= 10
value= 0
ignorehitpause= 1