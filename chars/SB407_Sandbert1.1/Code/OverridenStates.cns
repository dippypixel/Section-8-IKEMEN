;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = anim = 21
value = 5

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 21
trigger2 = Anim = 5 || Anim = 21
trigger2 = AnimTime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
triggerall = !var(50)
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = N
sprpriority = 0

[State 100, Walk Dust]
type = Explod
trigger1 = (anim = [20,21]) && (time%8 = 0)
anim = ifelse(anim = 20, 8603, 8604)
pos = 0,0
postype = p1
bindtime = 1
removetime = -2
scale = 2.2,2.2
pausemovetime = -1
supermovetime = -1
sprpriority = -4
ownpal = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)


[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 0, HitBy]
type = HitBy
trigger1 = !var(50)
value = SCA,NA,SA,HA,NP,SP,HP

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse((command = "holdup" && command != "hold_c"), const(velocity.jump.y), const(velocity.jump.y)*0.61538461538)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 105 ;RUN_Back
trigger1 = sysvar(1) = -1
x = const(velocity.runjump.back.x)


[State 40, Explod]
type = Explod
trigger1 = AnimTime = 0
anim = 8650
id = 8650
pos = 0,-pos y
postype = p1
removetime = -2
pausemovetime = -1
supermovetime = -1
sprpriority = 3
;bindtime = 0
ownpal = 1
scale = 2.2, 2.2
[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = numexplod(8650) && animtime=0
ID = 8650
;pos = -vel x, -pos y
bindtime = 0

[State 40, Jump SFX]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,0
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0
anim = 48

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 48, Jump Dust Back]
type = Explod
trigger1 = Time = 2
anim = 8655
pos = 0,10
postype = p1
bindtime = 1
removetime = -2
scale = 2.2,2.2
pausemovetime = -1
supermovetime = -1
sprpriority = -4
ownpal = 1
[State 48, Jump Dust Front]
type = Explod
trigger1 = Time = 2
anim = 8656
pos = 0,10
postype = p1
bindtime = 1
removetime = -2
scale = 2.2,2.2
pausemovetime = -1
supermovetime = -1
sprpriority = -3
ownpal = 1
[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = ifelse((prevstateno = 1200 || prevstateno=[600,699]), const(velocity.airjump.y)*.6, const(velocity.airjump.y))

[State -3, Landing Sound]
type = PlaySnd
trigger1 = Time = 2
value = 45, 0

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 0, VarAdd]
type = VarAdd
trigger1 = !time
triggerall = prevstateno = 45
v = 45
value = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = prevstateno != 45 && prevstateno != 55
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))
[State 50, 3]
type = ChangeAnim
trigger1 = prevstateno != 45 && prevstateno != 55
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = prevstateno = 45 || prevstateno = 55
value = ifelse((vel x)<0, 50, 49)

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type = S
ctrl = 0
anim = ifelse(var(50),51,47)

[State 52, Dust]
type = Explod
trigger1 = !time
anim = 8600
pos = 0,0
postype = p1
bindtime = 1
removetime = -2
pausemovetime = -1
supermovetime = -1
sprpriority = 3
ownpal = 1
scale = 2.2, 2.2

[State 0, VarSet]
type = VarAdd
trigger1 = !time
trigger1 = prevstateno = [600,699]
v = 8
value = 1

[State 0, CtrlSet]
type = CtrlSet
trigger1 = prevstateno != 707 && prevstateno != [600,699]
trigger2 = prevstateno = [600,699]
trigger2 = var(8) < 2
trigger3 = prevstateno = [600,699]
trigger3 = var(8) >= 2
trigger3 = time >= 2
value = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S52,0

[State 52, 1]
type = VelSet
trigger1 = var(50)
trigger1 = Time = 0
x = vel X*1.35
[State 52, 1]
type = VelSet
trigger1 = !var(50)
trigger1 = Time = 0
x = 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0
[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, Guard]
type= changestate
trigger1= inguarddist
trigger1= ctrl && command="holdback"
value= 120

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

