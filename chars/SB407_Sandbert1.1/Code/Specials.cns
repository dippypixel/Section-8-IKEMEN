;---------------------------------------------------------------------------
; Kiss
[Statedef 1000]
type    = U
movetype = A
physics = N
juggle  = 4
poweradd= ceil(45*fvar(7))
ctrl = 0
anim = 1000

[State 0, VelSet]
type = VelSet
triggerall = statetype != A
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
x = 0
y = 0 

[State 1200, Air]
type = StateTypeSet
trigger1 = pos y != 0
statetype = A
physics = N
[State 1200, Ground]
type = StateTypeSet
trigger1 = pos y = 0
statetype = S
physics = S
[State 1200, Gravity]
type = VelAdd
trigger1 = statetype = A
y = const(movement.yaccel)

[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(3) >= 0
movetype= I

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = S1000,0

[State 0, Helper]
type = Helper
trigger1 = AnimElem = 3
name = "Kiss"
id = 1000
stateno = 1001
pos = ceil(30*const(size.xscale)),ceil(-28*const(size.yscale))
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0

[State 0, ChangeState]
type = ChangeState
trigger1= statetype = A
trigger1= vel y > 0
trigger1= pos y > -vel y
value = 1005
ctrl = 0
[State 1200, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0+(statetype = A * 50)
ctrl = 1

;---------------------------------------------------------------------------
; Kiss - Projectile
[Statedef 1001]
type    = A
movetype= A
physics = N
juggle  = 0
velset = 12, 0
anim = 1010
sprpriority = 3

[State 200, 1]
type = HitDef
trigger1 = 1
attr = S, SP
damage = ceil(12.0*root,fvar(11)), 2
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 0,0
sparkno = 0
sparkxy = 0,0
hitsound = s5, 0
guardsound = s6, 0
getpower = ceil(20*parent,fvar(7)), ceil(10*parent,fvar(7))
givepower = 10, 10
ground.type = High
ground.slidetime = 3
ground.hittime  = 6
ground.velocity = -3
guard.velocity = -1
airguard.velocity = -1,-1
air.type = High
air.velocity = -2,-1
air.hittime = 6
guard.hittime = 3
airguard.hittime = 3
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/parent,fvar(20)

[State 0, VarSet]
type = ParentVarSet
trigger1 = parent,stateno = 1000
trigger1 = movecontact
v = 15
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Damage Dampen]
type = parentvarset
trigger1 = movehit
fvar(10) = (root,fvar(10))*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = parentvarset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = (root,fvar(20))-.035
ignorehitpause = 1
persistent = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = movecontact
movetype = I
ignorehitpause = 1

[State 0, HitBy]
type = HitBy
trigger1 = 1
value = SCA,AP
time = 1
ignorehitpause = 1

[State 0, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 1002
time = 1
ignorehitpause = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = frontedgedist < -100

[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact
value = 1002

;---------------------------------------------------------------------------
; Kiss - DEAD
[Statedef 1002]
type    = A
movetype= I
physics = N
juggle  = 0
anim = 69
velset = 0,0
sprpriority = 3

[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5020
value = 6020
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5050
value = 6050
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5070
value = 6070
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5080
value = 6080
ignorehitpause = 1

[State 0, ChangeState]
type = DestroySelf
trigger1 = !numtarget
trigger2 = parent,movehit

;---------------------------------------------------------------------------
; Special Land
[Statedef 1005]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, Dust]
type = Explod
trigger1 = !time
anim = 8600
pos = 0,0
postype = p1
bindtime = 1
removetime = -2
pausemovetime = -1
supermovetime = -1
sprpriority = 3
ontop = 1
ownpal = 1
scale = 2.2, 2.2

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S52,0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0
[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 5]
type = ChangeState
trigger1 = time >= 4
trigger1 = prevstateno = 1000 || prevstateno = 1302
trigger2 = time >= 12
trigger2 = prevstateno = [1300,1301]
value = 0
ctrl = 1

