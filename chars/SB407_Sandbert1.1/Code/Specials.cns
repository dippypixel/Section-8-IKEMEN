ctrl = 1

;---------------------------------------------------------------------------
; Demon Form
[Statedef 1300]
type    = U
movetype = A
physics = N
juggle  = 4
poweradd= ceil(45*fvar(7))
ctrl = 0
anim = 1300

[State 0, VelMul]
type = VelMul
triggerall = command = "holdback" || command = "holdup"
trigger1 = vel x != [-6,6]
trigger2 = command != "holdfwd" && command != "holdback"
x = .8
[State 0, VelMul]
type = VelMul
triggerall = command = "holdfwd" || command = "holdback"
trigger1 = command != "holdup" && command != "holddown"
y = .8
[State 0, VelMul]
type = VelMul
trigger1 = command != "holdup" && command != "holddown" && command != "holdfwd" && command != "holdback"
x = .3
y = .3


[State 0, VelAdd]
type = VelAdd
trigger1 = command = "holdfwd" || command = "holdback" || command = "holdup" || command = "holddown"
x = ifelse((command = "holdfwd" && vel X < 6), 1, ifelse((command = "holdback" && vel X > -6), -1, 0))
y = ifelse((command = "holddown" && vel Y < 6 && pos y <= 0), 1, ifelse(command = "holdup" && vel Y > -6 && pos y >= -200, -1, 0))

[State 1200, VelSet]
type = PosSet
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0 
[State 1200, VelSet]
type = PosSet
trigger1= vel y < 0
trigger1= pos y > -200
trigger1= pos y < -vel y - 200
y = -200
[State 1200, VelSet]
type = VelSet
trigger1= pos y < -200
trigger1= command != "holddown"
y = 1
[State 1200, VelSet]
type = VelSet
trigger1= vel y > 0
trigger1= pos y > -vel y
trigger2= vel y < 0
trigger2= pos y < -vel y - 200
y = 0

[State 200, 1]
type = HitDef
trigger1 = animelemtime(3) = 0
trigger2 = time%8 = 0
trigger2 = animelemtime(3) >= 0
attr = A, SA
damage = 6, 0
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 0,0
sparkno = 0
sparkxy = 0, ceil(-36*const(size.yscale))
hitsound = s5, 0
guardsound = s6, 0
getpower = ceil(5*fvar(7)), ceil(2*fvar(7))
givepower = 5,5
ground.type = High
ground.slidetime = 4
ground.hittime  = 8
ground.velocity = ifelse(p2dist x>=0, -1, 1)
guard.velocity = ifelse(p2dist x>=0, -1, 1)
airguard.velocity = ifelse(p2dist x>=0, -1, 1),-1
air.type = High
air.velocity = ifelse(p2dist x>=0, -1, 1),-3
air.hittime = 8
guard.hittime = 4
airguard.hittime = 4
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5
p2facing = 1

[State 200, Damage Dampen]
type = varset
trigger1 = movecontact = 1 || moveguarded = 1 || moveguarded = 1
trigger1 = movetype = A
fvar(10) = fvar(10)*0.95
ignorehitpause = 1
[State 200, Velocity Dampen]
type = varset
trigger1 = movecontact = 1 || moveguarded = 1 || moveguarded = 1
trigger1 = movetype = A
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.015
ignorehitpause = 1

[State 1300, PlayerPush]
type = PlayerPush
trigger1 = enemy,statetype = A
value = 0

[State #5, Attack]
type = StateTypeSet
trigger1 = animelemtime(3) = 0
trigger2 = animelemtime(4) = 0
trigger3 = animelemtime(5) = 0
trigger4 = animelemtime(6) = 0
trigger5 = animelemtime(7) = 0
movetype = A
ignorehitpause = 1
[State #5, No Attack]
type = StateTypeSet
trigger1 = movecontact = 1
movetype = I
ignorehitpause = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 3
trigger2 = animelem = 7
value = S1300,0

[State 1200, Air]
type = StateTypeSet
trigger1 = pos y != 0
statetype = A
physics = N
[State 1200, Ground]
type = StateTypeSet
trigger1 = pos y = 0
statetype = S
physics = N

[State 0, ChangeState]
type = ChangeState
trigger1 = animelemtime(3) >= 0
trigger1 = command = "a" || command = "b"
value = 1301
[State 0, ChangeState]
type = ChangeState
trigger1 = animelemtime(3) >= 0
trigger1 = command = "c"
trigger2 = time >= 150
value = 1302

