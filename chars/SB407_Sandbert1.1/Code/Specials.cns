[State 1200, Stop]
type = VelSet
triggerall = statetype != A
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
trigger2 = prevstateno = 250
x = 0
y = 0 
[State 1200, VelSet]
type = PosSet
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0 
[State 1200, VelSet]
type = VelSet
trigger1= vel y > 0
trigger1= pos y > -vel y
y = 0 

[State 200, Set to Idle]
type= StateTypeSet
