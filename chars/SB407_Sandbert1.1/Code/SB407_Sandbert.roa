[Statedef -1]

;---------------------------------------------------------------------------
;Air Jump
[State -1, Air Jump]
type = ChangeState
value = 45
triggerall = var(45) < 1 && var(46) = 0
triggerall = command = "up"
triggerall = statetype = A
trigger1 = Pos Y < -const(movement.airjump.height)
trigger1 = ctrl
trigger2 = stateno = [600,699]
trigger2 = movecontact
trigger3 = stateno = 1200
trigger3 = animelemtime(2) >= 3

[State -1, Air Jump Check]
type = VarSet
trigger1 = 1
v = 46
value = 0
[State -1, Air Jump Disabled]
type = VarSet
trigger1 = command = "holdup" || command = "holddown"
v = 46
value = 1

;---------------------------------------------------------------------------
; Wall Jump
[State -1, Wall Jump]
type = ChangeState
value = 55
triggerall = var(53) < 1
triggerall = Pos Y < -50
triggerall = ctrl
trigger1 = command = "holdfwd" && backedgebodydist <= 0
trigger2 = command = "holdback" && frontedgebodydist <= 0

;---------------------------------------------------------------------------
; Sandbergeddon
[State -1, Sandbergeddon]
type = ChangeState
value = 3200
triggerall = statetype != A
triggerall = power >= 3000
triggerall = command = "Sandbergeddon"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,499]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Blastbert
[State -1, Blastbert]
type = ChangeState
value = 3000
triggerall = power >= 1000
triggerall = command = "laser"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Sand Flash
[State -1, Sand Flash]
type = ChangeState
value = 3100
triggerall = power >= 1000
triggerall = command = "BOOM"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Demon
[State -1, Demon]
type = ChangeState
value = 1300
triggerall = command = "Demon"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Shine
[State -1, Shine]
type = ChangeState
value = 1200
triggerall = command = "Shine"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Sandbert Specter
[State -1, Sandbert Specter]
type = ChangeState
value = 1100
triggerall = command = "Sandbert Specter"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Chef
[State -1, Chef]
type = ChangeState
value = 1000
triggerall = command = "Chef"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Roman Cancel - Activate
[State -1, Roman Cancel - Activate]
type = VarSet
v = 7
value = 1
triggerall = power >= 500
triggerall = (stateno = [200, 699]) || (stateno = [1000, 1599]) || (stateno = [810,817]) || (stateno = [3000,3199]) 
triggerall = movetype != H
triggerall = command = "roman"
trigger1 = movecontact
trigger2 = stateno = 1000  || stateno = 3000 
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(3) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 811
trigger4 = animelemtime(5) >= 0
trigger4 = target,stateno != 820
ignorehitpause = 1
;---------------------------------------------------------------------------
; Roman Cancel - Decrease Power gain
[State -1, Roman Cancel - Decrease Power gain]
type = VarSet
fv = 7
value = 0.2
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(3) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 811
trigger4 = animelemtime(5) >= 0
trigger4 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - Stop all momentumn when cancelling in air
[State -1, Roman Cancel - Stop all momentumn when cancelling in air]
type = VelSet
y = 0
x = 0
triggerall = power >= 500
triggerall = statetype = A
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(3) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 811
trigger4 = animelemtime(5) >= 0
trigger4 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - FX
[State -1, Roman Cancel - FX]
type = VarSet
v = 5
value = 256
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(3) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 811
trigger4 = animelemtime(5) >= 0
trigger4 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - SFX
[State -1, Roman Cancel - SFX]
type = PlaySnd
value = S700, 0
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(3) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 811
trigger4 = animelemtime(5) >= 0
trigger4 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - Remove Power
[State -1, Roman Cancel - Remove Power]
type = PowerAdd
value = -500
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(3) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 811
trigger4 = animelemtime(5) >= 0
trigger4 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - Reset
[State -1, Roman Cancel - Reset]
type = ChangeState
value = ifelse(statetype = A, 50, 0)
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(3) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 811
trigger4 = animelemtime(5) >= 0
trigger4 = target,stateno != 820
ctrl = 1
;---------------------------------------------------------------------------
; Roman Cancel - Deactivate
[State -1, Roman Cancel - Deactivate]
type = VarSet
v = 7
value = 0
trigger1 = var(7) != 0

;===========================================================================
;---------------------------------------------------------------------------
; Run Back
[State -1, Run Back]
type = ChangeState
value = 105
trigger1 = (command = "BB"  || (command = "holdback" && command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = (command = "FF"  || (command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Super Jump
[State -1, Super Jump]
type = ChangeState
value = 41
trigger1 = command = "Super Jump" || (command = "a" && command = "b")
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = command = "holdup" || (command = "a" && command = "b")
trigger2 = stateno = 410
trigger2 = movehit

;---------------------------------------------------------------------------
; Throw 1
[State -1, Throw 1]
type = ChangeState
value = 800
triggerall = command = "y"
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != [100,109]
triggerall = var(38) = 0
trigger1 = command = "holdfwd" || command = "holdback"
trigger1 = p2bodydist X < 10
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H

;===========================================================================

;---------------------------------------------------------------------------
; Air Dodge
[State -1, Air Dodge]
type = ChangeState
value = 707
triggerall = var(51) = 0
triggerall = command = "c"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = [40,41]
;trigger2 = command = "holdback" || command = "holdfwd"

;---------------------------------------------------------------------------
; Dodge
[State -1, Dodge]
type = ChangeState
value = 700
triggerall = !numhelper(700)
triggerall = command = "c"
triggerall = (command != "holdback" && command != "holdfwd") || (command = "holdback" && command = "holdfwd")
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]

;---------------------------------------------------------------------------
; Roll Backwards
[State -1, Roll Backwards]
type = ChangeState
value = 705
triggerall = command = "c"
triggerall = command = "holdback" && command != "holdfwd"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]

;---------------------------------------------------------------------------
; Roll Forwards
[State -1, Roll Forwards]
type = ChangeState
value = 706
triggerall = command = "c"
triggerall = command = "holdfwd" && command != "holdback"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]

;===========================================================================
;---------------------------------------------------------------------------
; Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = command = "s"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]

;---------------------------------------------------------------------------
; Dash Attack
[State -1, Dash Attack]
type = ChangeState
value = 250
triggerall = command = "holdfwd" && command != "holddown"
triggerall = (command = "a" || command = "b")
trigger1 = stateno = 100
trigger1 = time < 8

;---------------------------------------------------------------------------
; Pummel
[State -1, Pummel]
type = ChangeState
value = 200
triggerall = command = "x"
triggerall = command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400
trigger2 = AnimElemTime (3) >= 0
;---------------------------------------------------------------------------
; Fire Attack
[State -1, Fire Attack]
type = ChangeState
value = 210
triggerall = command = "y"
triggerall = command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 || stateno = 430
trigger2 = movecontact

;---------------------------------------------------------------------------
; Greenhouse
[State -1, Greenhouse]
type = ChangeState
value = 230
triggerall = command = "a" && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400
trigger2 = movecontact

;---------------------------------------------------------------------------
;Lion
[State -1, Lion]
type = ChangeState
value = 240
triggerall = command = "b" && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 || stateno = 430 || stateno = 210
trigger2 = movecontact

;---------------------------------------------------------------------------
; Hammer
[State -1, Hammer]
type = ChangeState
value = 400
triggerall = command = "x"
triggerall = command = "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400
trigger2 = AnimElemTime (3) >= 0
trigger3 = stateno = 250
trigger3 = movehit

;---------------------------------------------------------------------------
; Octopus Helmet
[State -1, Octopus Helmet]
type = ChangeState
value = 410
triggerall = command = "y"
triggerall = command = "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 || stateno = 430
trigger2 = movecontact
trigger3 = stateno = 250
trigger3 = movehit
;---------------------------------------------------------------------------
; Manhole
[State -1, Manhole]
type = ChangeState
value = 430
triggerall = command = "a"
triggerall = command = "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400
trigger2 = movecontact
trigger3 = stateno = 230 && AnimElemTime (3) >= 0

;---------------------------------------------------------------------------
; Vermin
[State -1, Vermin]
type = ChangeState
value = 440
triggerall = command = "b"
triggerall = command = "holddown"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = stateno = 200 || stateno = 400 || stateno = 230 || stateno = 430 || stateno = 210
trigger2 = movecontact

;---------------------------------------------------------------------------
; Parachute
[State -1, Parachute]
type = ChangeState
value = 600
triggerall = command = "x"
trigger1 = statetype = A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Turtle
[State -1, Turtle]
type = ChangeState
value = 610
triggerall = command = "y"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 600 || stateno = 630
trigger2 = movecontact

;---------------------------------------------------------------------------
; Crate
[State -1, Crate]
type = ChangeState
