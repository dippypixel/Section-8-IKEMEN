;---------------------------------------------------------------------------
; Walk Forward AI
[Statedef 21]
type    = S
physics = S
anim = 20
ctrl = 0
sprpriority = 0

[State 21, VelSet]
type = VelSet
trigger1 = Anim = 20
x = const(velocity.walk.fwd.x)

[State 21, ChangeState]
type = ChangeState
trigger1 = p2bodydist x <= 25
trigger2 = p2movetype = A
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump AI
[Statedef 41]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 41, 4]
type = VelSet
trigger1 = AnimTime = 0
x = const(velocity.jump.back.x)
y = const(velocity.jump.y)

[State 41, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.back.x)

[State 41, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Run Forward AI
[Statedef 102]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 102, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 102, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 102, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 102, 4]
type = ChangeState
trigger1 = p2bodydist x <= 25
trigger2 = p2movetype = A
value = 101

;---------------------------------------------------------------------------
; Run Back AI
[Statedef 103]
type    = S
physics = S
anim = 105
sprpriority = 1

[State 103, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.back.x)

[State 103, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 103, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 103, 4]
type = ChangeState
trigger1 = p2bodydist x >= 101
trigger2 = p2movetype = A
trigger3 = backedgedist <= 30 && p2bodydist x <= 90
value = 0

