;vert starts twirling up
[Statedef 2030]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = N
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
anim = 2030                      ;Change animation (Def: no change)
sprpriority = 2                  ;Set p1's sprite layering priority to 2 (in front)

[State 2030, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 2030, PosSet]
type = PosSet
trigger1 = AnimElem = 2
x = Enemy,Pos x

[State 2030, Explod]
type = Explod
trigger1 = time = 0
anim = 2034
pos = -165,180
postype = Right  ;P2, Front, Back, Left, Right
bindtime = 1
removetime = -2
sprpriority = 4
ontop = 1
ownpal = 1

[State 2030, PlaySnd]
type = PlaySnd
trigger1 = Time = 10
value = s2030, 0
abspan = 1

[State 2030, PlaySnd]
type = PlaySnd
trigger1 = Time = 40
value = s2030, 2

[State 2030, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = s2030, 1

[State 2030, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
value2 = S,NA

[State 2030, HitDef]
type = HitDef
triggerall = time = [0,11]
trigger1 = time%4=0
attr = S, SA                     ;Attribute: Standing, Normal Attack
damage = 5, 2                   ;Damage that move inflicts, guard damage
animtype = Hard                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = L                   ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 0, 0                 ;Time attacker pauses, time opponent shakes
sparkno = s7001                      ;Spark anim no (Def: set above)
sparkxy = 0, -50               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = s1, 1                  ;Sound to play on hit
guardsound = s1, 7                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 3             ;Time that the opponent slides back
ground.hittime  = 12             ;Time opponent is in hit state
ground.velocity = 0,-9           ;Velocity at which opponent is pushed
airguard.velocity = 0,0     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = 0,-8           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 12                 ;Time before opponent regains control in air

[State 2030, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 2031

