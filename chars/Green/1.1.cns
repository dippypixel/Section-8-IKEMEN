;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, AssertSpecial]
type = AssertSpecial
trigger1 = Time >=0
flag = nomusic
ignorehitpause = 1
persistent = 1

[State 170, AssertSpecial]
type = AssertSpecial
trigger1 = (time > 0) && (time <= 250)
flag = RoundNotOver

[State 170, 1] ;le FUCKING LOSE MUSIC
type = playsnd
trigger1 = AnimElem = 1
value = s170,0
volumescale = 255

[State 170, 2]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

