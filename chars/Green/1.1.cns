;---------------------------------------------------------------------------
;Super Jump
[Statedef 9000] ;for the most part is (totally borrowed) from chase06 (because i didnt know how to do superjumps with custom superjump animations, sorry not sorry)
type = A
movetype = I
physics = N
anim = 9000
velset = 0,-12.6
ctrl = 0

[State 9000, 0]
type = VelAdd
trigger1 = 1
y = 0.3

[State 9000, AfterImage]
type = AfterImage
trigger1 = time = 1
time = 80
length = 6
palcolor = 256
palinvertall = 0
palbright = 50,50,50
palcontrast = 120,120,220
palpostbright = 0,0,0
palmul = .65,.65,.75
timegap = 2
framegap = 1
trans = Add

[State 9000, AfterImageTime]
type = AfterImageTime
trigger1 = Pos Y >= 1
time = 1
value = 0

[State 9000, Explod]
type = Explod
trigger1 = time = 0
anim = 9001
pos = 0,12
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
vfacing = 1
bindtime = 1
removetime = 60
supermovetime = 9999
pausemovetime = 9999
scale = 1,1
sprpriority = -1
ownpal = 1

[State 9000, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = s424, 0

[State 9000, CtrlSet]
type = CtrlSet
trigger1 = time = 0
value = 1

[State 9000, VelAdd]
type = Veladd
trigger1 = command = "holdfwd" && vel x < 8
x = 0.4

[State 9000, VelAdd2]
type = VelAdd
trigger1 = command = "holdback" && vel x > -8
x = -0.4

[State 9000, ChangeState]
type = ChangeState
trigger1 = Pos Y >= 1
value = 52
ctrl = 1

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
