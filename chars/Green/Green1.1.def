; Just a stick figure who stole the cap off a popular video game character.
; Version: 1.4
[Info]
name = "SMG4 if he was a stickman"
displayname = "Green"
versiondate = 8/12/2026
mugenversion = 1.1
author = "CallMeTony"
pal.defaults = 1,2,3,4,5,6           
