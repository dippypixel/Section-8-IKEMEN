; Definition file for Dantel
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Michael Bolton"        ;Name of character
displayname = "Dantel" ;Name of character to display
versiondate = 05,31,2018    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 1


; Files for the player
[Files]
cmd     = dantel.cmd   ;Command set
cns     = dantel.cns   ;Constants
st      = dantel.cns   ;States
st3     = config.txt
st4 = kame.st
stcommon = common1.cns ;Common states
sprite  = dantel.sff   ;Sprite
anim    = dantel.air   ;Animation
sound   = dantel.snd   ;Sound
pal1    = dantel.act
pal2    = dantel2.act


; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
