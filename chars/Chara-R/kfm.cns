;---------------------------------------------------------------------------
; The Light
; CNS difficulty: medium
; Description: This is like a standard attack, but with some differences.
;   There are two HitDefs in this attack. One is triggered when the
;   opponent is near (using a p2bodydist trigger), and the other
;   when the opponent is farther away. The main differences between
;   the near and far versions of the HitDefs is that the near version
;   has a "fall" parameter set to 1, causing the opponent to be knocked
;   down. Other minor differences are the damage, and the velocity to
;   give the opponent.
;   The line "attr = S, SA" line means this is a Standing, Special Attack.
;   It is important you have the attr parameter set correctly for all
;   you HitDefs.
[Statedef 1000]
type    = S
movetype= A
physics = N
poweradd= 100
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2

[State 1000, 1]
type = PlaySnd
trigger1 = Time = 7
value = 0, 3

[State 1000, 1]
type = PlaySnd
trigger1 = Time = 7
value = s102, 1
[State 1000, ExplosionEffect]
type = Explod
trigger1 = AnimElem = 4
anim = 1001               ; N˙mero de animaciÛn de la explosiÛn en tu .air
pos = 0, -60              ; PosiciÛn relativa al personaje (ajust· seg˙n el golpe)
postype = p1              ; Se posiciona relativo al oponente
bindtime = 1              ; Se queda pegado por 1 tick
removetime = -1           ; Dura hasta que termine la animaciÛn
scale = 1,1               ; Escala normal (podÈs agrandar si querÈs)
sprpriority = 5           ; Prioridad alta para que se vea encima
ownpal = 1  
[State 0, Explod]
type = Explod
trigger1 = time = 7
anim = 2802
ID = 2802
pos = -5,0
vel = floor(-vel x/2),0
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
removetime = -2
scale = 0.5,0.5
sprpriority = 5
ownpal = 1

[State 200, 1]
type = HitDef
triggerall = p2bodydist x <= 60
trigger1 = !time
attr = S, SA                     ;Attribute: Standing, Normal Attack
damage = 3,1                   ;Damage that move inflicts, guard damage
animtype = Hard                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
air.animtype = Back
fall.animtype = Back
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 4, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 15,15                 ;Time attacker pauses, time opponent shakes
sparkno = s6200                      ;Spark anim no (Def: set above)
guard.sparkno = s7051
sparkxy = -10, -61               ;X-offset for the "hit spark" rel. to p2,
hitsound = s5,2                  ;Sound to play on hit
guardsound = s6,0                ;Sound to play on guard
ground.slidetime = 20             ;Time that the opponent slides back
ground.hittime  = 20             ;Time opponent is in hit state
ground.type = Low               ;Type: High, Low, Trip (def: Normal)
air.type = Low                 ;Type: High, Low, Trip (def: same as ground.type)
ground.velocity = -4.1,-3            ;Velocity at which opponent is pushed
air.velocity = -4,-4             ;Velocity at which opponent is pushed
air.hittime = 20                 ;Time before opponent regains control in air
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
fall = 1 ;(p2bodydist x <= 50)
air.fall = 1
fall.recover = 0
forcestand = 1
envshake.time = 5
envshake.freq = 100
envshake.ampl = cond(random <= 500, -10, 10)
yaccel = 0.5
ID = 1000

[State 200, 1]
type = HitDef
triggerall = p2bodydist x > 60
trigger1 = !time
attr = S, SA                     ;Attribute: Standing, Normal Attack
damage = 70,7                   ;Damage that move inflicts, guard damage
animtype = Hard                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
air.animtype = Back
fall.animtype = Back
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 4, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 15,15                 ;Time attacker pauses, time opponent shakes
sparkno = s6200                      ;Spark anim no (Def: set above)
guard.sparkno = s7051
sparkxy = -10, -61               ;X-offset for the "hit spark" rel. to p2,
hitsound = s5,2                  ;Sound to play on hit
guardsound = s6,0                ;Sound to play on guard
ground.slidetime = 20             ;Time that the opponent slides back
