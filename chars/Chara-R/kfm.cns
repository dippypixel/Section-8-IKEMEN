; AI Blocking Helper
[Statedef 15900]
type = A
movetype = I
physics = N
anim = 9741
ctrl = 0

[State 0, VarSet]
type = Null
triggerall = enemynear,movehit = 1 ; When the opponent hits Adeleine
triggerall = root,prevstateno = 130 || root,prevstateno = 150 || root,prevstateno = 151 ; and she tried to block while standing
triggerall = enemynear,statetype != C ; and the enemy's statetype is not crouching 
triggerall = ishelper(15900)
trigger1 = !var(0)
trigger1 = var(0) := enemynear,stateno ; a safe guard is made
trigger2 = var(0) && !var(1)
trigger2 = enemynear,stateno != var(0) ; don't make duplicate safeguards
trigger2 = var(1) := enemynear,stateno
trigger3 = var(0) && var(1) && !var(2)
trigger3 = (enemynear,stateno != var(0) && enemynear,stateno != var(1))
trigger3 = var(2) := enemynear,stateno
trigger4 = var(0) && var(1) && var(2) && !var(3)
trigger4 = (enemynear,stateno != var(0) && enemynear,stateno != var(1) && enemynear,stateno != var(2))
trigger4 = var(3) := enemynear,stateno

[State 0, Safety]
type = HitBy
trigger1 = 1
value =

