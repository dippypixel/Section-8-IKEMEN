volumescale = 100

[State -1, AI]
type = VarSet
triggerall = (AILevel && RoundState = 2)
trigger1 = 1
v = 54
value = 0

[State -1, AI]
type = VarSet
triggerall = (AILevel && RoundState = 2)
triggerall = (!inguarddist && !enemy,numproj && !var(31))
triggerall = (prevstateno != [950,951])
trigger1 = (p2bodydist x - (enemynear,vel x * 4) >= 120)
trigger1 = (enemynear,vel x <= 0 || p2bodydist x >= 180 || !enemynear,ctrl || (enemynear,statetype = A && enemynear,vel y < 0) || (numhelper(2301) > 0 && p2dist y >= -80))
trigger2 = p2bodydist x >= 50 
trigger2 = (enemynear,statetype = L && enemynear,statetype != A)
trigger2 = (enemynear,vel x <= 0 || enemynear,backedgedist <= 100)
trigger2 = (enemynear,stateno != 5120 && enemynear,prevstateno != 5120)
v = 54
value = 1

