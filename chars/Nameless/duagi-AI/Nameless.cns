[State 132, 3]
type = varset
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = velset
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = posset
trigger1 = sysvar(0)
y = 0

[State 132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command = "holdback" && var(59) <= 0 || var(59) >= 4
trigger1 = inguarddist
value = 130

