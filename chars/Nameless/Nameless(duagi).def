; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Nameless"        ;Name of character
displayname = "Nameless" ;Name of character to display
versiondate = 04,14,2002    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Ahuron"         ;Character author name
pal.defaults = 7,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = duagi-AI\Nameless.cmd   ;Command set
cns     = duagi-AI\Nameless.cns   ;Constants
st      = duagi-AI\Nameless.cns   ;States
st2     = duagi-AI\Nameless2.cns   ;States
st3     = helper.cns   ;States
st4     = duagi-AI\Nameless-AI.cns  ;AI
stcommon = common1.cns ;Common states
sprite  = Nameless.sff   ;Sprite
anim    = Nameless.air   ;Animation
sound   = Nameless.snd   ;Sound
pal1    = Nameless.act
pal2    = Nameless2.act
pal3    = Nameless2.act
pal4    = Nameless3.act
pal5    = Nameless3.act
pal6    = Nameless4.act
pal7    = Nameless.act
pal8    = Nameless2.act
pal9    = Nameless2.act
pal10   = Nameless3.act
pal11   = Nameless3.act
pal12   = Nameless4.act