physics = S
anim = 101
sprpriority = 1
velset = 0,0
ctrl = 1

;---------------------[効果音]
[State 00]
type = stopSnd
trigger1 = Time= 0
channel = 1

;---------------------[ステート移行]
[State 04]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

