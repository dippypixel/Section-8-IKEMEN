triggerall = var(27)=1
triggerall = numhelper(8600) = 0
triggerall = numhelper(8066) = 0
triggerall = alive = 0
trigger1 = enemy,hitdefattr = SCA, HA, HP, HT;, SA, SP, ST
trigger1 = (var(27):=2)
trigger2 = enemy,stateno >= 3000 && enemy,stateno != [5000,5999]
trigger2 = (var(27):=2)
