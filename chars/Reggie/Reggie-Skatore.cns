;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State 0, VarRandom]
type = VarRandom
trigger1 = Time = 1
trigger1 = Anim = [5000,5099]
v = 3
range = 0,14

[State -3]
type = PlaySnd
channel = 5
triggerall = time = 0
triggerall = alive = 1
trigger1 = stateno = [5000,5099]
channel = 0
value = 101, var(3)

[State 0, VarSet]
type = VarSet
trigger1 = Var(15) = 0
trigger1 = AILevel != 0
v = 15
value = AILevel
[State 0, VarSet]
type = VarSet
trigger1 = Var(15) != 0
trigger1 = AILevel = 0
v = 15
value = 0