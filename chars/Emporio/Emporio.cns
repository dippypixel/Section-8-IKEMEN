trigger1 = stateno != 243
trigger1 = stateno != 242 
trigger1 = stateno != 241
trigger1 = stateno != 244
trigger1 = stateno != 641
trigger1 = stateno != 642
value = 243

[State -2, アニメ変更　ステートが奪われたとき]
type = DestroySelf
trigger1 = IsHelper(241)
trigger1 = movetype = H && stateno != [5000,5099] 

[State -2, ａｃｔ2やられ]
