;--------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;--------------------------------------------------------------------------

[Statedef -3]

;AI- salta cuando conecta bomba cerca (2000)
[State 0, ChangeState]
type = ChangeState
trigger1 = numhelper(2000)=1
trigger1 = var(24)=3 && stateno = 0 &&  helper(2000), movehit && enemynear, pos y > -130 && enemynear, vel Y > 0 && random <100
value = 40
ctrl = 0




;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
value = 40, 0
freqmul = 0.8+(random/3333.3)
volume = 100

[State 0, PlaySnd]
type = PlaySnd
triggerall = time=1
trigger1 = stateno = 50
value = 0,1
volume = -100
freqmul = 0.6+(random/6666.6)

;se cancela afterimage si es golpeado
[State 0, AfterImageTime]
type = AfterImageTime
trigger1 = movetype = h
trigger1 = !(ishelper)
time = 0

;WISP explod constante
[State -2, Explod]
type = Explod
trigger1 = var(10)=0
trigger1 = random < 150
trigger1 = alive
trigger1 = !(anim = 170 && animelemtime(47)>0)
trigger1 = !(anim = 194 && animelemtime(28)<0)
Anim =2200+random%5
ID = 2200
pos = ceil(-30+random%61),5-pos y
facing = cond(random<500,1,-1)
sprpriority = cond(random<500,0,2)
ownpal=1

;eliminar cuchillas y wisps si es hit
[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = movetype = h
id = 245

;eliminar cuchillas y wisps si es hit o aterriza
[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = movetype = h
trigger2 = stateno = 52
id = 246

;stop risa de taunt si le pegan
[State 0, StopSnd]
type = StopSnd
trigger1 = movetype = h
channel = 21

;DF
;baja el poder mientras esta en DF si es golpeado
[State -3, PowerAdd]
type = PowerAdd
triggerall = var(10) = 1
trigger1 = movetype = H && !time
value = -60

;DF cancela DF
[State -3, cancela]
type = ChangeState
triggerall = var(10)=1 && statetype !=A && ctrl
trigger1 = command = "espada"
;AI 2
trigger2 = var(24)=2 && power < 1000 && random < 2
trigger3 = var(24)=3 && power < 1000 && random < 2
value = 3701
ctrl = 0

;DF apaga var 10 si muere
[State 0, VarSet]
type = VarSet
trigger1 = !alive
var(10)=0

;Survival winscreen partner
;------------------
[State 0, ChangeState]
type = ChangeState
triggerall = numpartner
trigger1 = partner,stateno=18000 && stateno !=18000 && stateno !=18001
value = 18001

;Survival winscreen enemigo
[State 0, ChangeState]
type = ChangeState
triggerall = numenemy
trigger1 = enemynear,stateno=18000 && stateno !=18002
value = 18002

;sangre constante
[State 0, Helper]
type = Helper
triggerall = random < 10
triggerall = movetype != H && alive = 1
triggerall = stateno != 3070 && stateno != 3075 && stateno != 3076 && stateno != 3090 && stateno != 4000 && stateno != 4003 && stateno != 4010
trigger1 = roundstate = 2 && life <= 250
trigger1 = StageVar(info.name) != "caos-4"
trigger2 = roundstate != 3 && roundstate != 4
trigger2 = StageVar(info.name) = "caos-4"


name = "sangre constante"
ID = 6100
stateno = 6100
pos = ceil(-8+(random/60)), ceil(cond(statetype!=c,-40,-20)-(cond(statetype!= c,(random/23),(random/24))))
facing = cond(random<500,1,-1)
ownpal = 1


