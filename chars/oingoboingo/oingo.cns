fv = 3
value = .85;初速度に摩擦係数をプラスし続ける

[State -2,1];押し戻し速度が+にならないように
type = varset
trigger1 = fvar(3) >= 0;押し戻し速度が0以上になったら
fv = 3
value = 0;速度を0に設定する

[State -2,1];計算した押し戻し速度をPosaddで反映させる
type = posadd
trigger1 = fvar(3) < 0;押し戻し速度が+でないときのみ
trigger1 = numtarget
trigger1 = target,backedgebodydist <= 0 || target,frontedgebodydist <= 0
x = ceil(fvar(3))

