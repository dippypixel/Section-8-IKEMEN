; ここにキャラ情報を書いてください
[Info]
name = "Oingo & Boingo"        ;キャラの名前
displayname = "Oingo & Boingo" ;表示されるキャラの名前
versiondate = 12,25,2007    ;キャラの更新情報
mugenversion = 04,14,2002   ;キャラが動くmugenのバージョン
author = "Heal The World"         ;キャラの製作者名
pal.defaults = 1,2,3,4,5,6      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = oingo.cmd   ;キャラのコマンド
cns     = oingo.cns   ;キャラのプログラム
st      = oingo.cns   ;キャラのプログラム
st1      = oingo0.cns
st2      = oingo2.cns
stcommon = common1.cns 
sprite  = oingo.sff   ;キャラの絵
anim    = oingo.air   ;キャラの動き
sound   = oingo.snd   ;キャラの音
pal1    = oingo01.act  ;キャラの色（最大１２個）

intro.storyboard =  
ending.storyboard = 
