attr = C, NA
hitflag = MAF
guardflag = L
animtype = Light
air.animtype = back
fall.animtype = back
priority = 3,Hit
damage = 20
pausetime = 0,11
guard.pausetime = 11,0
sparkno = s810
guard.sparkno = S840
sparkxy = -10,-13
hitsound = S1,0
guardsound = S1,5
ground.type = Low
air.type = Low
ground.slidetime = ifelse((11-floor(var(28)*.125))<3,3,(11-floor(var(28)*.125)))
ground.hittime = ifelse((11-floor(var(28)*.125))<3,3,(11-floor(var(28)*.125)))
air.hittime = ifelse((11-floor(var(28)*.125))<3,3,(11-floor(var(28)*.125)))
guard.ctrltime = 11
ground.velocity = -6
guard.velocity = -5.5
air.velocity = -6
ground.cornerpush.veloff = -5
air.cornerpush.veloff = 0
getpower = 40*(var(8)!=3),0
givepower = 20*(var(8)!=3),0
persistent = 0
air.fall = 0
fall.recover = 1
yaccel = .44

