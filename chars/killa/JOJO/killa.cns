guardflag = HA
animtype = Light
damage    = 20
priority = 3
pausetime = 11,11
sparkno = S810
guard.sparkno = S840
sparkxy = -10,-54
hitsound = S1,0
guardsound = S1,5
ground.type = High
air.type = High
ground.slidetime = 11
ground.hittime = 11
air.hittime = 11
guard.ctrltime = 11
ground.velocity = -6
