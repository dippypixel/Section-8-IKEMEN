st3      = -2.cns
st4      = stand.cns
st5      = midler3.cns   ;通常技
st6      = dem.cns       ;タンデム
stcommon = common1.cns 

sprite   = midler.sff      ;キャラの絵
anim     = midler.air      ;キャラの動き
sound    = midler.snd    ;キャラの音
pal1     = 1.act

[Palette Keymap]
x  = 1
y  = 2
z  = 3
a  = 1
b  = 2
c  = 3
x2 = 2
y2 = 1
z2 = 3
a2 = 1
b2 = 3
c2 = 2