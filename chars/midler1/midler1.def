[Info]
name = "MIDLER"
displayname = "Midler"
author = "montana"
pal.defaults = 1,2,3
;---------------------------------------------------------------------------
[Files]
cmd      = midler.cmd    ;キャラのコマンド
cns      = midler1.cns   ;キャラのプログラム
st       = midler1.cns   ;キャラのプログラム
st1      = midler2.cns   ;通常技
