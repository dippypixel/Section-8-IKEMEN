p1facing = 1
p2facing = 1          
p1stateno = 810       ;攻撃がヒットしたときに自分が移行するステートの番号を指定します。
p2stateno = 820       ;攻撃がヒットしたときに相手が移行するステートの番号を指定します。
hitonce = 1
guard.dist = 0        ;相手のガード態勢に入る距離を０にしてるので、ガード不可
fall = 1              
fall.recover = 0 

[State 800, 2]
