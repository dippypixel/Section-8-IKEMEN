value = 0, 2

[State 3050, ヒット定義]
type = HitDef
trigger1 = Time = 0
attr = S, HA
animtype  = Up
damage    = 155, 12
getpower  = 0
priority  = 5
guardflag = MA
pausetime = 30,30
