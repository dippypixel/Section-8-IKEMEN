; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
triggerall = ctrl
triggerall = var(59)>0
triggerall = roundstate = 2
trigger1 = var(55) = 0
trigger1 = p2dist X > 50
trigger2 = var(55) = 1
trigger2 = p2dist X > 0
x = const(velocity.walk.fwd.x)

[State 20, 1]
type = VelSet
triggerall = var(59)<=0
triggerall = roundstate = 2
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
triggerall = var(59)<=0
triggerall = roundstate = 2
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 52, 3 s]
type = PlaySnd
trigger1 = animelem = 4
value = 3, 36

[State 52, 3 s]
type = PlaySnd
trigger1 = animelem = 8
value = 3, 37

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+var(49) && Anim != 5+var(49)
trigger2 = Anim = 5+var(49) && AnimTime = 0
value = 20+var(49)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+var(49) && Anim != 5+var(49)
trigger2 = Anim = 5+var(49) && AnimTime = 0
value = 21+var(49)

