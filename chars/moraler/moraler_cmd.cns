;---------------------------------------------------------------------------
;製作用
;---------------------------------------------------------------------------
[State -1, デバッグ]
type = NULL;ChangeState
triggerall = !var(59)
trigger1 = command = "start"
trigger1 = StateType != A && Ctrl
value = 1501

;---------------------------------------------------------------------------
;超必（モララー）
;---------------------------------------------------------------------------
[State -1, ラストジャッジメント]
type = ChangeState
value = 3200
triggerall = !var(59)
triggerall = !var(12)
triggerall = command = "ラストジャッジメント"
triggerall = Power >= 3000
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || stateno = 100
trigger2 = StateNo = 200
trigger3 = StateNo = 210
trigger4 = StateNo = 400
trigger5 = StateNo = 410

[State -1, G・エンド]
type = ChangeState
value = 2700
triggerall = !var(59)
triggerall = !var(12)
triggerall = command = "G・エンド"
triggerall = Power >= 3000
triggerall = statetype != A
trigger1 = ctrl || stateno = 40 || stateno = 100
trigger2 = StateNo = 200 && (var(36) = 1||var(36) = 2)
trigger3 = StateNo = 210 && (var(36) = 1||var(36) = 2)
trigger4 = StateNo = 400 && (var(36) = 1||var(36) = 2)
trigger5 = StateNo = 410 && (var(36) = 1||var(36) = 2)

