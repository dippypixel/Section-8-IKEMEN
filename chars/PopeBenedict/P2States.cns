;---------------------------------------------------------------------------
; Grab P2 State
[Statedef 258]
movetype = H
physics = N
velset = 0,0
ctrl = 0

[State 258, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 258, LifeAdd]
type = LifeAdd
trigger1 = Pos Y > 0 && Vel Y > 0
value = -128

[State 258, VelAdd]
type = VelAdd
trigger1 = Pos Y > 0 && Vel Y > 0
x = -3
y = -6

[State 258, ChangeAnim2]
type = ChangeAnim2
trigger1 = !Time
value = 258

[State 258, SelfState]
type = SelfState
triggerall = time > 26
trigger1 = Pos Y > 0 && Vel Y > 0
value = 5100

