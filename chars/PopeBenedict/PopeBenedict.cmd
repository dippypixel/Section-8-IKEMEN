[Statedef -1]

[State -1, AI Guard]
Type = ChangeState
Value = 120
triggerall = StateType != A && Var(15)
triggerall = ctrl || stateno = 195
triggerall = !(enemynear,hitdefattr=SCA,AT) && inguarddist
triggerall = (stateno!=[120,155])
trigger1 = (Var(15)**3)*2*0.9 > random && RoundState = 2

[State -1, AI Jump]
Type = ChangeState
Value = 40
triggerall = Ctrl && StateType = S
triggerall = Var(15) && (Var(15)**3)*2*0.1 > random && RoundState = 2
trigger1 = P2BodyDist X > 96
trigger2 = P2BodyDist X > 128 && (Enemy,StateNo = [5080,5150])
trigger3 = numhelper(260) && (numhelper(265) || numhelper(266))

[State -1, AI DoubleJump]
Type = ChangeState
Value = 45
triggerall = Ctrl && StateType = A && PrevStateNo != 45
triggerall = Var(15) && (Var(15)**3)*2*0.3 > random && RoundState = 2
trigger1 = Pos Y = [-48,-72]

[State -1, AI JumpForward]
Type = VarSet
sysvar(1) = 1
triggerall = Var(15)
trigger1 = StateNo = 40 || StateNo = 45
trigger1 = P2BodyDist X > 8

