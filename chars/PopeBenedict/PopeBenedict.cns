;---------------------------------------------------------------------------
; Messenger of Light
[Statedef 191]
type = S
physics = S
anim = 190
sprpriority = -10

[State 191, assert]
type = assertspecial
trigger1 = 1
flag = Intro

[State 191, assert]
type = assertspecial
trigger1 = time <= 50
flag = Invisible

[State 191, screen]
type = screenbound
trigger1 = 1
value = 1
movecamera = 1,0

[State 191, pos]
type = posset
trigger1 = time = 50
y = -250

[State 191, pos]
type = posadd
trigger1 = anim = 190
trigger1 = time > 50 && !(time%2)
trigger1 = pos y < 0
y = 2

[State 191, spr]
type = sprpriority
trigger1 = time > 50 && !(time%2)
trigger1 = pos y < -10
value = ifelse(!(time%4),3,1)

[State 191, snd]
type = playsnd
trigger1 = time = 70
value = 190,0+random%2
channel = 0

[State 191, snd]
type = playsnd
trigger1 = Time = 300
value = 190,2

[state 191, helper]
type = helper
trigger1 = time = 50
stateno = 2001
id = 2001
postype = p1
pausemovetime = 999999
supermovetime = 999999
sprpriority = 10

[State 191, explod]
type = removeexplod
trigger1 = numexplod(2002)
trigger1 = pos y >= -30
id = 2002

[State 191, anim]
type = changeanim
trigger1 = time > 50
trigger1 = pos y >= 0
value = 191
persistent = 0

[State 191, StopSnd]
type = StopSnd
trigger1 = command = "a" || command = "b" || command = "c" || command = "x" || command = "y" || command = "z" 
channel = 0
persistent = 0

[State 191, end]
type = changestate
trigger1 = anim = 191 && !animtime
value = 0

