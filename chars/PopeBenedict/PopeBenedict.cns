;---------------------------------------------------------------------------
;[State -2, DisplayToClipboard]
;type = DisplayToClipboard
;trigger1 = 1
;text = "var(45) = %d  var(45) = %d"
;params = var(45),var(52)

[State -2, Var SlowdownVar Reset]
type = VarSet
trigger1 = Var(45) != 0 && Var(52) != 0 && Life >= 1
v = 45
value = 0

[State -2, Var SlowdownVar Rise]
type = VarAdd
trigger1 = Life < 1 && Var(52) != 0
trigger1 = Power >= 3000 || Power = Powermax
v = 45
value = 1

[State -2, Pause]
type = Pause
trigger1 = Var(45) = [1,15]
time = 2
movetime = 0
ignorehitpause = 1

[State -2, Pause]
type = Pause
triggerall = StateNo = [5000,5110)
trigger1 = Var(45) = [15,24]
trigger1 = Time%3 != 0
trigger2 = Var(45) = [25,34]
trigger2 = Time%2 != 0
trigger3 = Var(45) > 35
trigger3 = Time%3 = 0
time = 1
movetime = 0
ignorehitpause = 1

[State -2, AssertSpecial]
type = AssertSpecial
triggerall = Enemy,life != 0 && var(52) != 0
trigger1 = power >= 3000 || power = powermax
flag = NoKO
ignorehitpause = 1

[State -2, Var AllowRevive]
type = VarSet
trigger1 = StateNo = [190,193]
trigger2 = RoundState < 2
var(52) = 1

[State -2, ChangeState]
type = ChangeState
trigger1 = StateNo = 5120
trigger1 = Var(52) = 1 && Var(45) > 0
value = 3009
ctrl = 0

