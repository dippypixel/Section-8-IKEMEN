[Data]
life = 1082
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -110  ;Approximate position of head
mid.pos = 0, -70   ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y). Recommended 0,0

[Velocity]
walk.fwd  = 4.6     ;Walk forward
walk.back = -4.4     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -4.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-8.4    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.
air.gethit.groundrecover = -.15,-3.5  ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = .5,.2     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,-4.5    ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -1       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 0         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -2         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 1.5      ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 1       ;Number of air jumps allowed (opt)
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .44          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .05       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 25           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .35    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

[Quotes]
; Not-Stolen-WinQuotes
victory1 = "The church has no use for a worm like you."
victory2 = "Everything is proceeding as I have foreseen."
victory3 = "If you will not be turned, you will be destroyed!"
victory4 = "Your feeble skills are no match for the power of the Dark Side."
victory5 = "Now, you will pay the price for your lack of vision!"
victory6 = "I am a little god. I have his name. I am one with Him. I'm in covenant relationship. I am a little god."
victory7 = "Sometimes I wish God would give me a Holy Ghost machine gun. I'd blow your head off!"
victory8 = "And the Holy Spirit spoke to me, the gift of faith come on me. He said: ‘Kick em in their face,’”'"
victory9 = "The Lord givith me a message to you my child, it says: You suck"
victory10 = "Your very public and painful executions will serve as an example to the rest of the galaxy."
victory11 = "By shooting it with lightning That's how i'll solve all my problems! And then afterwards I shall eat pudding."
victory12 = "You are a weak, pathetic farm boy!"
victory13 = "Today marks the death of the Heretics and a new order of peace for the Church."
victory14 = "Saa, kami ni inorinasai!"
victory15 = "Nurui desu ne."
victory16 = "Kore ga...shinbatsu desu!"
victory17 = "Kui aratame nasai."
victory18 = "Kami no gokago ga aran koto wo."
victory19 = "Foolish little lambs. Know an existence greater than you."
victory20 = "The least I can do is offer a prayer for you; then send you to Hell!"
victory21 = "By the orders of God, I will remove you!"
victory22 = "Your punishment is CRUCIFIXION!"
victory23 = "...And now i shall unleash God's Fury upon your pathetic world!"
victory24 = "There is no might stronger then this of God's will!"
victory25 = "ANIME HAS NO PLACE IN THE HOUSE OF GOD!"
victory26 = "Anime teaches you how to enter the world of Satan my child. I assure you I will not allow that to happen!"
victory27 = "UWARABA!"
victory28 = "I am Pope, the Conqueror! I'm also the last thing you'll ever see." 
victory29 = "Prepare to be destroyed by the god-give body of Pope Benedict!"
victory30 = "Your prays are as worthless as your soul. They have no place in the house of God!"
victory31 = "A poet's greatest fear is his inevitable encounter with the eternal darkness." 
victory32 = "At the risk of sounding immodest, I must confess I am a being of great superiority." 
victory33 = "Death is life's only salvation That is no paradox... it is simply the logical conclusion." 
victory34 = "Do you understand the fate of the fools who betrayed the truth?" 
victory35 = "If your life is but a path leading you to death, why not give your life up to my service?" 
victory36 = "This thing you call shadow, is it like a mother's blossom... rest now, in its eternally warm embrace." 
victory37 = "Darkness... It holds you in peace, like your mother's arms." 
victory38 = "I am the first and only ruler of this trivial planet!"
victory39 = "Guessing my intentions is easier than winning some magazine sweepstakes."
victory40 = "Life? Death? There is nothing. There is only man and the hand of God I bring forth down upon thy to bring destruction to this miserable existance of yours!"
victory41 = "It is over. You shall have an eternity in hell to regret your actions." 
victory42 = "I've waited 500 years only to awake to fight such weak scum as you!? Pathtic, this world stands no chance against my holy hands."
victory43 = "A light in shinning darkness, tis is I who shall be that light as I banish the darkness from this plane that is you!"
victory44 = "...As to all others who dared to challenge me they crumbled. They crumbled to the unrelenting fist of god!" 
victory45 = "For you to stain my hands with your blood is a sin commited against the Church. Perish like the scum you are as you lie in defeat."
victory46 = "Spare you? I shall do no such thing. You'll have enough time to beg in Hell."
victory47 = "Your actions only hold you higher not to God but, to the punish I shall bestow upon thy!"
victory48 = "There is no afterlife for you. Only death and the eternal punishment of repenting for your actions you've commited against the church!"
victory49 = "What victory you sought is non-existent. You cannot win against the power of God."
victory50 = "SEIRAIKEN IS THE STRONGEST STYLE THERE IS!"

