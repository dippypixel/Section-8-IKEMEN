;---------------------------------------------------------------------------
; Variable usage:
; var(5)   - Guard
; var(11)  - Special recharge
; var(12)  - Special recharge 2
; var(13)  - Special recharge 3
; var(14)  - Special recharge 4
; var(53)  - Wall Jump limit
; var(55)  - Lilbros' Spitball slowdown effect
; var(59)  - AI level

; fvar(20)  - Velocity Deterioration
;--------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0&& Anim != 1&& Anim != 3 
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = ifelse((life < (lifemax*.5)&& enemy,alive && roundstate = 2),ifelse(prevstateno=210||prevstateno=800||prevstateno=812||prevstateno=1000,3,1),0)
[State 0, Anger]
type = ChangeAnim
trigger1 = var(35) && Anim != 1&& Anim != 3 && enemy,alive&&ailevel
value = ifelse(prevstateno=210||prevstateno=800||prevstateno=812||prevstateno=1000,3,1)

[State 0, Width]
type = null;Width
trigger1 = anim = 1 || anim = 3
player = 20,0

[State 0, Transition To Anger]
type = ChangeAnim
trigger1 = life < (lifemax*.5) && anim=0 && roundstate = 2
trigger2 = var(35) && anim=0 && roundstate = 2&&ailevel
value = 3
persistent = 0
[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0, AIturn]
type = Turn
trigger1 = ailevel && p2dist x < -5
;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C

[State 10, 3]
type = ChangeState
trigger1 = !time
value = 0

;
;[State 0, 4] ;WINPOSE DEBUG
;type = ChangeState
;trigger1 = !time && roundstate = 2
;value = 183
;ctrl = 0
;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0



[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 0, VarRandom]
type = VarRandom
trigger1 = !time
v = 15
range = 0,100
;ignorehitpause = 
;persistent = 

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = anim = 22
flag = NoMusic


[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 22
value = S180,0
volume = 0
channel = 4
;lowpriority = -1
freqmul = 1.0
loop = 0
pan = 0
;abspan = 
;ignorehitpause = 
persistent = 0



[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5 && anim != 22
trigger2 = Anim = 5 && AnimTime = 0
value = ifelse(random>10,20,22) ;he does this

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;-------------------------------------------------------------------------------------------------------------------------------------------------
; Run Forwards
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
velset = ifelse(vel x <= 0,5,vel x),0
ctrl = 1

[State 105, 1]
type = VelAdd
trigger1 = time%2 = 1
x = ifelse(vel x <= const(velocity.run.fwd.x), 2, 0)


[State 105, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn
[State 0, PlaySnd]
type = PlaySnd
trigger1 = time%5=0
value = S101,0+random%6
channel = -1
volumescale = 100
[State 0, Explod]
type = Explod 
trigger1 = animelem = 2 || animelem = 4
anim = 20060
pos = -40,0
postype = p1
vel = -vel x / 3 ,0
removetime = -2
pausemovetime = 0
scale = 1,1
sprpriority = 9
ontop = 0
shadow = 0,0,0
ownpal = 1
bindtime = 0
removeongethit = 0

[State 20, 2]
type = ChangeState
trigger1 = !ailevel
trigger1 = command = "holdback"
trigger1 = (stateno = 100) || (stateno = 106 && time >= 9)
value = 101

[State 105, 4]
type = ChangeState
triggerall = !ailevel
trigger1 = command != "holdfwd"
value = 110


