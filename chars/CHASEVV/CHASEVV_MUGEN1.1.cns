trigger1=teamside = 1
trigger1=root,command="holdfwd"
trigger2=teamside = 2
trigger2=root,command="holdback"
ID = 500
anim = 503

[State 0, AngleDraw]
type = null
trigger1 = 1
value = 1
scale = 0,0
ignorehitpause = 1
 
[State 0, DisplayToClipboard]
