text = "var(36) = %d  vel x = %f"
params = var(36),vel x
ignorehitpause = 1

[State 12345, PosSet]
type = PosSet
trigger1 =!time 
x = root,pos x
y = root,pos y - root,var(36)
ignorehitpause = 1
 
[State 12345, AS]
type=assertspecial
trigger1=1
flag=noshadow

[State 12345, Reset]
type=varset
trigger1=!time
fvar(38)=200

[State 12345, Pal]
type=varset
trigger1=!time
var(36)=Cond(root,palno > 11,12+random%15,root,palno)
 
[State 12345, Varset]
type=varset
triggerall = root,command!="start"
trigger1=var(36)<1||var(36)>26 ; last palette
var(36)=1+(var(36)<1)*(26-1) ; subtract -1 from your last palette

[State 12345, PlaySnd]
type = PlaySnd
trigger1 =fvar(39)=2 
value = 50,0
volumescale = 100
channel = 20

[State 12345, PlaySnd]
type = PlaySnd
triggerall=ishelper(12345)
trigger1=root,command="a"||root,command="b"||root,command="c"||root,command="start"||roundstate=2
trigger2=time >= 600 || root,AILevel && enemy,stateno = 0
value = 50,1
volumescale = 100
channel = 20
persistent =0 
 
[State 12345, Countdown]
type = VarAdd
trigger1 =1 
fvar(38)=-1

[State 12345, Countdown]
type = VarAdd
trigger1=!fvar(39)&&fvar(38)<150
trigger1=root,command="holdback"||root,command="holdfwd"
fvar(38)=25
 
[State 12345, Palcycle GoForward]
type=varadd
triggerall = teamside = 1 && root,AILevel = 0
trigger1=!fvar(39)
trigger1=root,command="holdback"||root,command="holdfwd"
var(36)=1-(root,command="holdback"&&facing=1||root,command="holdfwd"&&facing=-1)*2
 
[State 12345, Palcycle GoBack]
type=varadd
triggerall = teamside = 2 && root,AILevel = 0
trigger1=!fvar(39)
trigger1=root,command="holdback"||root,command="holdfwd"
var(36)=(1-(root,command="holdback"&&facing=1||root,command="holdfwd"&&facing=-1)*2)*-1

[State 12345, PalAdd]
type=varadd
trigger1=(root,command="holdback"||root,command="holdfwd")&&!fvar(39)||fvar(39)
fvar(39)=1
 
[State 0, PalIcons AngleDraw]
type = AngleDraw
trigger1 = !animexist(506)
value = 1
scale = 0,0
ignorehitpause = 1
[State 0, PalIcons ChangeAnim]
type = ChangeAnim
trigger1 = animexist(506)
value = 506
elem = var(36)
ignorehitpause = 1
[State 12345, Varset]
type=varset
trigger1=!time||fvar(39)>=10
fvar(39)=0

[State 0, RemoveExplod]
type = RemoveExplod
trigger1=root,command="a"||root,command="b"||root,command="c"||root,command="start"||roundstate=2
trigger2=root,AILevel && enemy,stateno = 0
trigger3=time >= 600
id = 500
ignorehitpause = 1

[State 12345, End]
type=destroyself
triggerall=ishelper(12345)
trigger1=root,command="a"||root,command="b"||root,command="c"||root,command="start"||roundstate=2
trigger2=root,AILevel && enemy,stateno = 0
trigger3=time >= 600


