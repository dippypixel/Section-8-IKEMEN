trigger1 = !ailevel 
trigger1 = command = "holddown"
trigger2 = ailevel && enemynear,hitdefattr = C,NA,SA,HA,NP,SP,HP
value = 131

[State 0, ChangeState]
type = ChangeState
trigger1 = pos y != 0
value = 132

[State 130, Stop Guarding]
type = ChangeState
triggerall = !ailevel
trigger1 = command != "hold_c"
trigger2 = var(5) <= 1
value = 140

