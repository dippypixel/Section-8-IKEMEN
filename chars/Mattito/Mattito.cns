[Statedef 821]
type = A
movetype = H
physics = N
velset = -1,-9
poweradd = 40

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
y = .4

[State 0, VelAdd]
type = VelAdd
trigger1 = var(5) = 1
x = 14
y = -2

[State 821, 2] ; Recover near ground (use ChangeState)
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 821, 3] ; Recover in mid air (use SelfState)
type = SelfState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 821, 4] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
trigger1 = var(5) = 0
value = 5100 ;Hit ground



;---------------------------------------------------------------------------
; custom hitstate from C. Koa
[Statedef 2020]
type    = S
movetype= H
physics = N
velset = 0,0

[State HitFall]
type = HitFallSet
trigger1 = Time=0
value=0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(random%2,5000,5010) + 2

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a
[State Fell down]
type = StateTypeSet
trigger1 = pos Y >= 0
statetype = S
[State 0, VelSet]
type = VelSet
trigger1 = statetype = S
y = 0
[State 0, PosSet]
type = PosSet
trigger1 = statetype = S
y = 0

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
value = 2021

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

[State Dead]
type = SelfState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Bitoreivu States - Hit Slide
[Statedef 2021]
type    = U
movetype= H
physics = N

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2]
type = ChangeAnim
trigger1 = anim=5002 && AnimTime = 0
value = 5007
[State 5001, 2]
type = ChangeAnim
trigger1 = anim=5012 && AnimTime = 0
value = 5017

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6
[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time < GetHitVar(slidetime)
x = .85

[State 5001, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State Go down if prone to acceleration]
type = VelAdd
triggerall = statetype = A
trigger1 = Time
y = 0.8
[State Better]
type = Explod
trigger1 = statetype=A && pos Y >= 0 && vel Y > 0
anim = F61
pos = 0,0
postype = p1
facing = 1
removetime = -2
scale = 1,1
sprpriority = -1
ownpal = 1
removeongethit = 0
[State miss me?]
type = PlaySnd
trigger1 = statetype=A && pos Y >= 0 && vel Y > 0
value = F7,0
[State Fell down]
type = StateTypeSet
trigger1 = pos Y >= 0 && vel Y > 0
statetype = S
[State 0, VelSet]
type = VelSet
trigger1 = statetype = S
y = 0
[State 0, PosSet]
type = PosSet
trigger1 = statetype = S
y = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = HitOver && statetype = S
value = 1

[State 5001, 6]
type = SelfState
trigger1 = HitOver && statetype = S && alive
value = 0
ctrl = 1

[State Dead]
type = SelfState
trigger1 = !alive
value = 5050


;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
[statedef -2]
[State 0, DEBUG TEXT]
type = DisplayToClipboard
trigger1 = 1
text = "V-Scale = %f V-Scale = %d"
params = fvar(20),var(11)
ignorehitpause = 1

;Velocity Deterioration system (Edited from RicePigeon's Damage Proration system)
[State -2, Reset velocity dampener]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(20) = 1.0

[State 0, VarSet]
type = VarSet
trigger1 = !numtarget && var(11) && (stateno!=[1300,1310])
v = 11    ;fv = 10
value = 0

[State 0, Make sure it never goes under the limit]
type = VarSet
trigger1 = fvar(20) < 0.25
fv = 20 
value = 0.25
ignorehitpause = 1

[State in -2 variable was reset]
type = VarSet
trigger1 = enemynear,movetype != H || enemynear,ctrl || enemynear,stateno = 5120 ;reset variables ASAP
var(38) = 0
ignorehitpause = 1

[State GOOOOSH]
type = StopSnd
trigger1 = stateno!=100
channel = 6
persistent=0

[State Movehitoner (From None's Beavis)]
type = VarSet
trigger1 = numenemy
var(31) = ifelse(movehit=1&&(enemynear,movereversed!=[1,2]),var(31)+1,0)
ignorehitpause = 1

[State -2,Removeafterimage]
type = afterimagetime
trigger1 = movetype = H
time = 0

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------


[Statedef -3]

[State GOOOOSH]
type = StopSnd
trigger1 = stateno!=100
channel = 6
persistent=0

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Jump Sound]; (By Axel1825)
type = PlaySnd
triggerall = Time = 0
trigger1 = stateno = 40
trigger2 = stateno = 41
trigger3 = stateno = 42
trigger4 = stateno = 43
trigger5 = stateno = 44
trigger6 = stateno = 45
trigger7 = stateno = 46
trigger8 = stateno = 47
value = S50,0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
