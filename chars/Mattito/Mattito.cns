[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 200
sprpriority = 2

[State 200, 1]
type = HitDef
trigger1 = time = 0
attr = S, NA                    
damage = 18*fvar(20), 0                  
animtype = Light                
guardflag = MA                   
hitflag = MAF                   
priority = 3, Hit                
pausetime = 10, 10                
sparkno = 0                    
sparkxy = -10, -70          
hitsound = S5, 2                
guardsound = S6, 0              
ground.type = High   
air.type = High           
ground.slidetime = 11
ground.hittime  = 11    
guard.slidetime = 9
guard.hittime = 9                    
ground.velocity = -4            
air.hittime = 13                 
air.velocity = -3,-1      
airguard.velocity = -3,-1     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))                    
givepower = 5
getpower = 20

[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
fvar(20) = fvar(20)*.925
ignorehitpause = 1
persistent = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S0,2
volume = 255
channel = 0

[State 200, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

