;---------------------------------------------------------------------------
;ニュートラルポーズ
[Statedef 0]
type    = S
physics = S
;anim = 191
sprpriority = 0


[State 0, PosSet];------------------------GGGGG---------------------------------
type = PosSet
trigger1 = Pos Y != 0
y = 0
ignorehitpause =  1

[State 0, PlayerPush]
type = PlayerPush
triggerall = IsHelper
;triggerall = Facing != Root,Facing
trigger1 = parentdist x > 39
trigger2 = parentdist x < 37
value = 0
ignorehitpause = 1

[State 0, PosSet]
type = PosAdd
trigger1 = parentdist x < 37 ;Time = 0
triggerall = IsHelper
triggerall = Parent, statetype != A ;&& Parent, movetype != H
x = -2
ignorehitpause = 1

[State 0, PosSet]
type = PosAdd
trigger1 = parentdist x > 39 ;Time = 0
triggerall = IsHelper
triggerall = Parent, statetype != A ;&& Parent, movetype != H
x = 2
ignorehitpause = 1

[State 0, PosSet]
type = PosAdd
trigger1 = parentdist x < 58 ;Time = 0
triggerall = IsHelper
triggerall = Parent, statetype != A ;&& Parent, movetype != H
x = -2
ignorehitpause = 1

[State 0, PosSet]
type = PosAdd
trigger1 = parentdist x > 18 ;Time = 0
triggerall = IsHelper
triggerall = Parent, statetype != A ;&& Parent, movetype != H
x = 2
ignorehitpause = 1;-----------------------FFFF---------------------------------

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = IsHelper
trigger1 = Var(17) = 1
triggerall = Anim != 1
value = 1
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = IsHelper
trigger1 = Var(17) = 2
triggerall = Anim != 2
value = 2

[State 0, アニメ変更]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 1 && Anim != 2 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
trigger3 = Anim = 191 && AnimTime = 0
value = 0

[State 0, 速度設定]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, SelfState];Helper Win
type = SelfState
triggerall = IsHelper && Var(17) != 0
triggerall = Roundstate > 2 && Life > 0
trigger1 = Root, stateno = 183
value = 1839
ctrl = 0
ignorehitpause = 0

[State 0, SelfState];Helper Win
type = SelfState
triggerall = IsHelper && Var(17) != 0
triggerall = Roundstate > 2 && Life > 0
trigger1 = Root, stateno = 184
trigger2 = Root, stateno = 181
value = 1849
ctrl = 0
ignorehitpause = 0

[State 0, SelfState];Instructed to Lose
type = SelfState
triggerall = IsHelper && Var(17) != 0
triggerall = Life > 0 && stateno != 1899
trigger1 = Root, Life = 0
trigger2 = Root, Lose
trigger3 = Root, stateno = [170,175]
value = 1899
ctrl = 0
ignorehitpause = 0

[State 0, ステート変更]
type = ChangeState
trigger1 = !Alive
value = 5050

