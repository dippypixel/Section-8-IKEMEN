;---------------------------------------------------------------------------
;歩き
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = stateno = 20
flag = noautoturn

[State 191, Snd 1]
type = PlaySnd
triggerall = anim  = 20
trigger1 = animelemtime(6) = 1
trigger2 = animelemtime(12) = 1
value = 3,1

[State 20, 1]
type = VelSet
trigger1 = Command = "holdfwd"
trigger1 = !IsHelper
x = Const(Velocity.Walk.Fwd.X)
[State 20, 2]
type = VelSet
trigger1 = Command = "holdback"
trigger1 = !IsHelper
x = Const(Velocity.Walk.Back.X)

[State 20, 1]
type = VelSet
trigger1 = IsHelper
trigger1 = Root, Command = "holdfwd"
x = Root, Const(Velocity.Walk.Fwd.X)
[State 20, 2]
type = VelSet
trigger1 = IsHelper
trigger1 = Root, Command = "holdback"
x = Root, Const(Velocity.Walk.Back.X)

[State 20, アニメ変更]
type = ChangeAnim
triggerall = Vel X > 0
trigger1 = Anim != [20,22]
value = 20+Var(17)

[State 20, アニメ変更]
type = ChangeAnim
triggerall = Vel X < 0
trigger1 = Anim != [23,25]
value = 23+Var(17)

[State 0, SelfState]
type = SelfState
triggerall = IsHelper && Var(17) != 0
trigger1 = Parent, anim = 850
trigger2 = Root, Vel X = 0
value = 0
ctrl = 0
ignorehitpause = 0


;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 52, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = 7,1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = Time >= 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)


[State 40, 5]
type = VelSet
trigger1 = Time >= 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = Time >= 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 52, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = 7,1

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = 1
sysvar(1) = (Root, sysvar(1))

[State 45, 6]
type = VelSet
trigger1 = Time >= 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time >= 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, Gravity]
type = Gravity
trigger1 = time = 0

[State 120, アニメ変更]
type = ChangeAnim
trigger1 = Time = 0
value = 41+Var(17)

;[State 50, 2]
;type = ChangeAnim
;trigger1 = Time = 0  && Var(17) = 0
;value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

