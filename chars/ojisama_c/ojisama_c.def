; Definition file for Kung Fu Man
; Contains all the filenames needed for the characterk

; Player information
[Info]
name = "ojisama"        ;Name of character
displayname = "ojisama-chaos" ;Name of character to display
versiondate = 04,14,2002    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "man"         ;Character author name
pal.defaults = 4     ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = ojisama_c.cmd   ;Command set
cns     = ojisama_c.cns   ;Constants
st      = ojisama_c.cns   ;States
st2      = common.cns   ;States
st3      = ojizone.cns
stcommon = common1.cns ;Common states
sprite  = ojisama_c.sff   ;Sprite
anim    = ojisama_c.air   ;Animation
sound   = ojisama_c.snd   ;Sound
pal1    = ojisama_c4.act  ;Palettes (can have up to 12)
pal2    = ojisama_c2.act
pal3    = ojisama_c3.act
pal4    = ojisama_c.act
pal5    = ojisama_c5.act
pal6    = ojisama_c6.act

; Arcade mode
[Arcade]
intro.storyboard = ojisama_c_op.def
;ending.storyboard = 
