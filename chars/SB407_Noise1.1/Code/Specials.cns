;---------------------------------------------------------------------------
; Noise Bomb
[Statedef 1000]
type    = S
movetype = A
physics = N
juggle  = 0
poweradd= ceil(50*fvar(7))
ctrl = 0
anim = 1000

[State 0, VarSet]
type = VarSet
trigger1 = !time
sysvar(1) = ifelse(command = "b", 1, 0)

[State 0, ParentVarSet]
type = VarSet
trigger1 = !time
v = 12
value = 0
ignorehitpause = 1

[State 0, VelSet]
type = VelSet
triggerall = statetype != A
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
x = 0
y = 0 

[State 1200, Air]
type = StateTypeSet
trigger1 = pos y != 0
statetype = A
physics = N
[State 1200, Ground]
type = StateTypeSet
trigger1 = pos y = 0
statetype = S
physics = S
[State 1200, Gravity]
type = VelAdd
trigger1 = statetype = A
y = const(movement.yaccel)

[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(5) >= 0
movetype= I

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = S1000,0

[State 0, Helper]
type = Helper
trigger1 = AnimElem = 2
name = "Noise Bomb"
id = 1000
stateno = ifelse(name = "The Doise", 1010,1001)
pos = ceil(27*const(size.xscale)),ceil(-9*const(size.yscale))
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0

[State 0, ChangeState]
type = ChangeState
trigger1= statetype = A
trigger1= vel y > 0
trigger1= pos y > -vel y
value = 1005
ctrl = 0
[State 1200, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0+(statetype = A * 50)
ctrl = 1

;---------------------------------------------------------------------------
; Noise Bomb - Projectile
[Statedef 1001]
type    = A
movetype= A
physics = N
juggle  = 0
velset = 0, ifelse(root,sysvar(1)=1,-5,-3)
anim = 1050
sprpriority = 3

[State 0, RemapPal]
type = RemapPal
trigger1 = 1
source = 1,1
dest = ifelse(name="The Doise",2,1),palno
ignorehitpause = 1

[State 0, PalFX]
type = PalFX
trigger1 = time >= 120
trigger1 = time%8 = 0
time = 4
add = 256,256,256
mul = 256,256,256
invertall = 0
color = 256
ignorehitpause = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim=1051 && animelem=1
value = S1050,0
[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim=1051 && animelem=4
value = S1050,1

[State 200, 1]
type = HitDef
trigger1 = root,stateno = 1000 && root,animelemtime(5) >= 0
trigger2 = root,stateno != 1000
attr = S, SP
damage = ceil(61.0*root,fvar(11)), 6
animtype = Medium
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 0,16
guard.pausetime = 0, 8
sparkno = 2
sparkxy = 0,0
hitsound = s5, 2
guardsound = s6, 0
getpower = ceil(65*parent,fvar(7)), ceil(35*parent,fvar(7))
givepower = 55, 40
ground.type = High
ground.slidetime = 8
ground.hittime  = 16
ground.velocity = -8
guard.velocity = -2
airguard.velocity = -1,-2
air.type = High
air.velocity = -4,-3
air.hittime = 16
guard.hittime = 8
airguard.hittime = 8
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/parent,fvar(20)

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = statetype = A
trigger1 = var(1)
trigger1 = frontedgedist < 0
value = 1052
[State 0, VelSet]
type = VelSet
trigger1 = anim=1052 && animelemtime(1)=0
x = -vel x
[State 0, Turn]
type = Turn
trigger1 = anim=1052 && animelemtime(1)=0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 1050 || anim=1052
trigger1 = vel y > 0
trigger1 = pos y > -vel y
value = 1051
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 1051 && animtime=0
value = 1050

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = vel y > 0
trigger1 = pos y > -vel y
statetype = S

[State 0, PosSet]
type = VelSet
trigger1 = statetype = S
x = 0
y = 0
[State 0, PosSet]
type = PosSet
trigger1 = statetype = S
y = 0

[State 0, VarSet]
type = VarSet
trigger1 = root,stateno = 1000 && root,animelem=5
v = 1
value = 1
[State 55, Jump Dust Back]
type = Explod
trigger1 = root,stateno = 1000 && root,animelem=5
anim = 5701
pos = 0,0
postype = p1
bindtime = 1
removetime = -2
scale = const(size.xscale),const(size.yscale)
pausemovetime = -1
supermovetime = -1
sprpriority = 1
ownpal = 1


[State 1000, prevents clipping when pushed]
type = BindToRoot
trigger1 = !var(1) 
time = 1
facing = 0
pos = ceil(27*const(size.xscale)),pos y + vel y


[State 0, VelSet]
type = VelSet
trigger1 = anim = 1051 && animelem = 4
x = 4
y = -5

[State 0, VelSet]
type = VelSet
trigger1 = root,stateno = 1000 && root,animelem=5 && root,sysvar(1) = 0
x = 6
y = -3
[State 0, VelSet]
type = VelSet
trigger1 = root,stateno = 1000 && root,animelem=5 && root,sysvar(1) = 1
x = 2
y = -7

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = pos y != 0
trigger2 = anim = 1051 && animelem = 4
statetype = A

[State 0, VelAdd]
type = VelAdd
trigger1 = statetype = A
y = .44

[State 200, Add to Combo counter]
type = ParentVarAdd
triggerall = root,var(21) < 999
trigger1 = movehit
v = 21
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = ParentVarSet
trigger1 = movehit
v = 20
value = 402
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = ParentVarAdd
triggerall = root,var(20) > 0 && root,var(20) < 402
trigger1 = movecontact && moveguarded && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0
[State 200, Add to Score]
type = ParentVarAdd
trigger1 = movehit && root,var(41) = 1
v = 22
value = ceil((root,var(21)**2 * 0.25) + (root,var(21)*10))
ignorehitpause = 1
persistent = 0

[State 0, VarSet]
type = ParentVarSet
trigger1 = parent,stateno = [1000,1003]
trigger1 = movecontact
v = 15
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Damage Dampen]
type = parentvarset
trigger1 = movehit
fvar(10) = (root,fvar(10))*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = parentvarset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = (root,fvar(20))-.05
ignorehitpause = 1
persistent = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = movecontact
movetype = I
ignorehitpause = 1

[State 0, HitBy]
type = HitBy
trigger1 = var(1)
value = SCA,AP
time = 1
ignorehitpause = 1
[State 0, HitBy]
type = HitBy
trigger1 = !var(1)
value = 
time = 1
ignorehitpause = 1

[State 0, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 1003
time = 1
ignorehitpause = 1

;[State 0, DestroySelf]
;type = DestroySelf
;trigger1 = frontedgedist < -100
;trigger2 = root,stateno != 1000 && root,movetype = H && !var(1)

[State 0, ParentVarSet]
type = ParentVarSet
trigger1 = movehit
v = 12
value = 1
ignorehitpause = 1
[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact
trigger2 = time = 180
value = 1002
[State 0, ChangeState]
type = ChangeState
trigger1 = root,stateno != 1000 && root,movetype = H && !var(1)
value = 1003

;---------------------------------------------------------------------------
; Noise Bomb - DEAD
[Statedef 1002]
type    = A
movetype= I
physics = N
juggle  = 0
anim = 69
velset = 0,0
sprpriority = 3
movehitpersist = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S1000,1

[State 0, Explod]
type = Explod
trigger1 = !time
anim = 6300
ID = 6300
pos = -25+random%50, ceil(-15*const(size.yscale)) + (-25+random%50)
postype = p1  ;p2,front,back,left,right
removetime = -2
pausemovetime = 0
scale = const(size.xscale)*.5,const(size.yscale)*.5
sprpriority = 3
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0
[State 0, Explod]
type = Explod
trigger1 = !time
anim = 6001
ID = 6001
pos = -10+random%20, ceil(-15*const(size.yscale)) + (-10+random%20)
postype = p1  ;p2,front,back,left,right
removetime = -2
pausemovetime = 0
scale = const(size.xscale)*.5,const(size.yscale)*.5
sprpriority = 4
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0

[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5020
value = 6020
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5050
value = 6050
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5070
value = 6070
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5080
value = 6080
ignorehitpause = 1

[State 0, ChangeState]
type = DestroySelf
trigger1 = !numtarget
trigger2 = parent,movehit
trigger3 = isHelper(3310) || isHelper(3311)
trigger3 = time > 16

