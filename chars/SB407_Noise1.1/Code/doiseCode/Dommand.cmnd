value = 0
; Crouch Parry enabled
[State -1, Parry enabled]
type = VarSet
trigger1 = command = "fwd" || command = "up" || command = "back"
v = 11
value = 0

[State -1, Parry]
type = HitOverride
trigger1 = var(6)>0
trigger1 = ctrl
attr = SA,NA,SA,HA,NP,SP,HP
stateno = 710
time = 1
[State -1, Parry]
type = HitOverride
trigger1 = var(11)>0
trigger1 = ctrl
attr = C,NA,SA,HA,NP,SP,HP
stateno = 710
time = 1

;===========================================================================

[State -1, Breakdance buffer reset]
type = VarSet
trigger1 = command != "hold_s"
v = 17
value = 0
ignorehitpause = 1

[State -1, Breakdance buffer on]
type = VarAdd
trigger1 = command = "hold_s"
v = 17
value = 1
ignorehitpause = 1

