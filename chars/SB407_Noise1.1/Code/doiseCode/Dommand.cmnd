[Statedef -1]

;------------------------------------------------------------------------
;AI START HERE

;AI DiffSet
[State -1, AI DiffSet]
type = VarSet
trigger1 = 1
var(58) = ifelse(var(42)=0, 0, (AiLevel=1)*3 + (AiLevel=2)*8 + (AiLevel=3)*12 + (AiLevel=4)*24 + (AiLevel=5)*48 + (AiLevel=6)*72 + (AiLevel=7)*108 + (AiLevel=8)*150)

; Guard
[State -1, AI Guard]
type = ChangeState
value = 120
triggerall = AILevel && var(42) > 0 && roundstate = 2 && alive && numenemy
triggerall = inguarddist
triggerall = stateno != [120,160]
triggerall = movetype = I
trigger1 = ctrl
trigger2 = (prevstateno = [5000, 5300]) || (prevstateno = [120, 159])
trigger2 = stateno < 52

[State -1, AI Disable Guard]
type = AssertSpecial
trigger1 = (stateno != [120,160]) && aiLevel && var(42) > 0 
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

;AI STOP HERE

;---------------------------------------------------------------------------
[State -1, Air Jump]
type = null;ChangeState
value = 45
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = var(45) < 1 && var(46) = 0
triggerall = command = "up"
triggerall = statetype = A
trigger1 = Pos Y < -const(movement.airjump.height)
trigger1 = ctrl
trigger2 = stateno = [600,699]
trigger2 = movehit

[State -1, Glide]
type = ChangeState
value = 56
triggerall = stateno != 56
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = command = "holdup" && vel y > 2
triggerall = statetype = A
trigger1 = Pos Y < -const(movement.airjump.height)
trigger1 = ctrl

[State -1, Air Jump Check]
type = VarSet
trigger1 = 1
v = 46
value = 0
[State -1, Air Jump Disabled]
type = VarSet
trigger1 = command = "holdup" || command = "holddown"
v = 46
value = 1

;---------------------------------------------------------------------------
; Wall Jump
[State -1, Wall Jump]
type = ChangeState
value = 55
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = var(53) < 1
triggerall = Pos Y < -50
triggerall = ctrl
trigger1 = command = "holdfwd" && backedgebodydist <= 0
trigger2 = command = "holdback" && frontedgebodydist <= 0

;---------------------------------------------------------------------------
; Noise Crusher
[State -1, Noise Crusher]
type = ChangeState
value = 3100
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = power >= 1000
triggerall = command = "Crusher"
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger2 = (stateno = [200,699]) || (stateno = [1000,1999])
trigger2 = movecontact
trigger3 = stateno = 1000 && var(12)
trigger4 = stateno = 615 && movehit

;---------------------------------------------------------------------------
; Jetpack Dive
[State -1, Jetpack Dive]
type = ChangeState
value = 1400
triggerall = !numhelper(1000) || numhelper(1000) && var(12)!=0
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = command = "Dive"
triggerall = statetype = A
trigger1 = ctrl
trigger2 = stateno = 636 || stateno = [600,699]
trigger2 = movecontact
trigger3 = stateno = 615 && movehit

;---------------------------------------------------------------------------
; Copy Counter
[State -1, Copy Counter]
type = ChangeState
value = 1300
triggerall = !numhelper(1000) || numhelper(1000) && var(12)!=0
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = command = "Counter"
triggerall = statetype != A
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger2 = stateno = 636 || stateno = [200,499]
trigger2 = movecontact

;---------------------------------------------------------------------------
; Pogo Stick
[State -1, Pogo Stick]
type = ChangeState
value = 1200
triggerall = stateno != [1200,1201]
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = command = "Pogo"
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger2 = (stateno = [200,699])
trigger2 = movecontact
trigger3 = stateno = 615 && movehit

;---------------------------------------------------------------------------
; Noise Bomb
[State -1, Noise Bomb]
type = ChangeState
value = 1000
triggerall = !numhelper(1000) || numhelper(1000) && var(12)!=0
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = command = "Bomb"
triggerall = statetype != A
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger2 = stateno = 636 || stateno = [200,499]
trigger2 = movecontact

;---------------------------------------------------------------------------
; Spin
[State -1, Spin]
type = ChangeState
value = ifelse(var(1) >= 2, 1101, 1100)
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = command = "Spin"
triggerall = stateno != 102
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger2 = (stateno = [200,699])
trigger2 = movecontact
trigger3 = stateno = 615 && movehit

;---------------------------------------------------------------------------
; Roman Cancel - Activate
[State -1, Roman Cancel - Activate]
type = VarSet
v = 7
value = 1
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = power >= 500
triggerall = (stateno = [200, 699]) || (stateno = [1000, 1599]) || (stateno = [810,862]) || (stateno = [3000,3299]) 
triggerall = movetype != H
triggerall = command = "roman"
trigger1 = movecontact
trigger2 = stateno = 1000  || stateno = 3000 
trigger2 = var(15)
trigger3 = stateno = [810,815]
trigger3 = (animelemtime(9) >= 0 && stateno = 810) || (stateno = 815 && animelemtime(6) >= 0)
trigger3 = target,stateno != 820
trigger4 = stateno = 862
trigger4 = animelemtime(7) >= 0
trigger4 = target,stateno != 861
trigger5 = stateno = 1150
trigger5 = animelemtime(3) >= 8
trigger5 = target,stateno != [1151,1152]
trigger6 = stateno = 3101 && anim = 3102 && animelemtime(1) >= 1
ignorehitpause = 1
;---------------------------------------------------------------------------
; Roman Cancel - Decrease Power gain
[State -1, Roman Cancel - Decrease Power gain]
type = VarSet
fv = 7
value = 0.2
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,815]
trigger3 = (animelemtime(9) >= 0 && stateno = 810) || (stateno = 815 && animelemtime(6) >= 0)
trigger4 = stateno = 1150
trigger4 = animelemtime(3) >= 8
trigger4 = target,stateno != [1151,1152]
trigger5 = stateno = 3101 && anim = 3102 && animelemtime(1) >= 1
;---------------------------------------------------------------------------
; Roman Cancel - Stop all momentumn when cancelling in air
[State -1, Roman Cancel - Stop all momentumn when cancelling in air]
type = VelSet
y = 0
x = 0
triggerall = power >= 500
triggerall = statetype = A
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,815]
trigger3 = (animelemtime(9) >= 0 && stateno = 810) || (stateno = 815 && animelemtime(6) >= 0)
trigger4 = stateno = 1150
trigger4 = animelemtime(3) >= 8
trigger4 = target,stateno != [1151,1152]
trigger5 = stateno = 3101 && anim = 3102 && animelemtime(1) >= 1
;---------------------------------------------------------------------------
; Roman Cancel - FX
[State -1, Roman Cancel - FX]
type = VarSet
v = 5
value = 256
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 815
trigger4 =  animelemtime(6) >= 0
trigger4 = target,stateno != 820
trigger5 = stateno = 1150
trigger5 = animelemtime(3) >= 8
trigger5 = target,stateno != [1151,1152]
trigger6 = stateno = 3101 && anim = 3102 && animelemtime(1) >= 1
;---------------------------------------------------------------------------
; Roman Cancel - SFX
[State -1, Roman Cancel - SFX]
type = PlaySnd
value = S700, 0
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 815
trigger4 =  animelemtime(6) >= 0
trigger4 = target,stateno != 820
trigger5 = stateno = 1150
trigger5 = animelemtime(3) >= 8
trigger5 = target,stateno != [1151,1152]
trigger6 = stateno = 3101 && anim = 3102 && animelemtime(1) >= 1
;---------------------------------------------------------------------------
; Roman Cancel - Remove Power
[State -1, Roman Cancel - Remove Power]
type = PowerAdd
value = -500
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 815
trigger4 =  animelemtime(6) >= 0
trigger4 = target,stateno != 820
trigger5 = stateno = 1150
trigger5 = animelemtime(3) >= 8
trigger5 = target,stateno != [1151,1152]
trigger6 = stateno = 3101 && anim = 3102 && animelemtime(1) >= 1

;---------------------------------------------------------------------------
; Roman Cancel - Reset
[State -1, Roman Cancel - Reset]
type = ChangeState
value = ifelse(statetype = A, 50, 0)
triggerall = var(7) != 0
triggerall = stateno != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = 810
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
trigger4 = stateno = 815
trigger4 =  animelemtime(6) >= 0
trigger4 = target,stateno != 820
trigger5 = stateno = 1150
trigger5 = animelemtime(3) >= 8
trigger5 = target,stateno != [1151,1152]
trigger6 = stateno = 3101 && anim = 3102 && animelemtime(1) >= 1
ctrl = 1

;---------------------------------------------------------------------------
; Roman Cancel - Deactivate
[State -1, Roman Cancel - Deactivate]
type = VarSet
v = 7
value = 0
trigger1 = var(7) != 0

