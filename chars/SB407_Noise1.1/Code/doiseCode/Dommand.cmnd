; Run Back
[State -1, Run Back]
type = ChangeState
value = 105
triggerall = !AILevel || (AILevel && var(42) <= 0)
trigger1 = (command = "BB"  || (command = "holdback" && command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = (command = "FF"  || (command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------
; Super Jump
[State -1, Super Jump]
type = ChangeState
value = 41
triggerall = !AILevel || (AILevel && var(42) <= 0)
trigger1 = command = "Super Jump" || (command = "a" && command = "b")
trigger1 = statetype != A
trigger1 = ctrl || stateno = 646 && animelemtime(4) >= 0 || (stateno = [100,109])
trigger2 = command = "holdup" || (command = "a" && command = "b")
trigger2 = stateno = 410 || stateno = 215
trigger2 = movehit

;---------------------------------------------------------------------------
; Throw Air
[State -1, Throw Air]
type = ChangeState
value = 850
triggerall = !AILevel || (AILevel && var(42) <= 0)
triggerall = command = "y"; || command = "b"
triggerall = var(38) = 0
triggerall = command = "holdfwd" || command = "holdback"
triggerall = statetype = A && p2statetype = A
triggerall = p2bodydist X < 10 && p2bodydist y = [-50,50]
triggerall = p2movetype != H
trigger1 = ctrl
;trigger2 = stateno != 635 && (stateno = [600,699])
;trigger2 = movecontact

