value = 0
ctrl = 1

;---------------------------------------------------------------------------
; 5y
[Statedef 210]
type    = S
movetype= A
physics = S
juggle  = 0
poweradd= 0
ctrl = 0
anim = 216
facep2 = 1

[State 0, VelSet]
type = VelSet
trigger1 = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
x = 0
y = 0 

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = S0,2

[State 200, 1]
type = HitDef
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
trigger1 = !movecontact && !moveguarded && !movereversed
attr = S, NA
damage = 58, 0
animtype = Hard
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 12,12
sparkno = 2
sparkxy = -10, ceil(-18*const(size.yscale))
hitsound = s5, 2
guardsound = s6, 0
getpower = ceil(58*fvar(7)), ceil(29*fvar(7))
givepower = 20, 20
ground.type = Low
air.type = Low
ground.slidetime = 10
ground.hittime  = 18
air.hittime = 18
guard.hittime = 10
airguard.hittime = 19
ground.velocity = -8.85
air.velocity = -4,-4.5
guard.velocity = -4
airguard.velocity = -3,-3
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/fvar(20)
forcenofall = 1

[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
trigger1 = movehit
v = 21
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarSet
trigger1 = movehit
v = 20
value = 402
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = var(20) > 0 && var(20) < 402
trigger1 = movecontact && moveguarded && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0
[State 200, Add to Score]
type = VarAdd
trigger1 = movehit && var(41) = 1
v = 22
value = ceil((var(21)**2 * 0.25) + (var(21)*10))
ignorehitpause = 1
persistent = 0

[State 200, Damage Dampen]
type = varset
trigger1 = movehit
fvar(10) = fvar(10)*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.05
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = var(20) > 0 && var(20) < 402
trigger1 = movecontact && moveguarded && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0

[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(5) >= 0
trigger2= movecontact || moveguarded || movereversed
movetype= I

[State 240, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

