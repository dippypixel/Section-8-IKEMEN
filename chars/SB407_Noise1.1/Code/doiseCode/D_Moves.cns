;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = N
anim = 99+var(1)
ctrl = 0
sprpriority = 1

;Sorting the controllers like this so it's a bit easier to navigate through ;)

;---------------------TRANSITION FROM SPIN-------------------------
[State 0, PosSet]
type = velSet
trigger1 = prevstateno = 1101 && !time
y = 0
[State 0, PosSet]
type = PosSet
trigger1 = prevstateno = 1101 && !time
y = 0

;---------------------SFX-------------------------

[State 100, Mach 1]
type = PlaySnd
triggerall = prevstateno != 1101
trigger1 = anim = 99
value = S100,0
channel = 1
loop = 1
persistent = 0

[State 100, Mach 2 Start]
type = StopSnd
triggerall = prevstateno != 1101
trigger1 = anim = 100
channel = 1 
persistent = 0
[State 100, Mach 2]
type = PlaySnd
triggerall = prevstateno != 1101
trigger1 = anim = 100
value = S100,1
channel = 1
loop = 1
persistent = 0


;----------------VELOCITIES-----------
[State 100, Mach 1 Speed]
type = VelSet
trigger1 = anim = 99
x = const(velocity.run.fwd.x)*.7
[State 100, Mach 2 Speed]
type = VelSet
trigger1 = anim = 100
trigger2 = anim = 109
trigger2 = var(1) = 1
x = const(velocity.run.fwd.x)

;----------------VARIABLES----------
[State 100, Mach 2]
type = VarSet
trigger1 = anim = 99
trigger1 = animtime = 0
v = 1
value = 1


;------------------------ROLL----------------
[State 100, Roll Start]
type = StopSnd
trigger1 = anim = 109
trigger1 = animelemtime(1) = 1
channel = 1

[State 0, PlaySnd]
type = PlaySnd
triggerall = command = "holddown"
trigger1 = anim = 109
trigger1 = animelemtime(1) = 1
value = S110,0
channel = 1
loop = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 99
trigger1 = animtime = 0
trigger2 = var(1) = 1
trigger2 = command != "holddown"
trigger2 = anim = 109
value = S100,1
channel = 1
loop = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = command = "holddown"
trigger1 = anim != 109
value = 109

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(1) = 0
trigger1 = command != "holddown"
trigger1 = anim = 109
value = 99
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim = 99
trigger1 = animtime = 0
trigger2 = var(1) = 1
trigger2 = command != "holddown"
trigger2 = anim = 109
value = 100

;------------------FX--------------
[State 100, Red After]
type = AfterImage
triggerall = anim != 109
trigger1 = gametime%16 = 0
time = 8
length = 2
palcolor = 256
palinvertall = 0
palbright = 0,0,0
palcontrast = 256,0,0
palpostbright = 0,0,0
paladd = 0,-256,-256
palmul = 1,1,1
timegap = 4
framegap = 1
trans = add1
[State 100, Green After]
type = AfterImage
triggerall = anim != 109
trigger1 = gametime%16 = 8
time = 8
length = 2
palcolor = 256
palinvertall = 0
palbright = 0,0,0
palcontrast = 0,256,0
palpostbright = 0,0,0
paladd = -256,0,-256
palmul = 1,1,1
timegap = 4
framegap = 1
trans = add1
[State 100, Roll After]
type = AfterImage
trigger1 = anim = 109
trigger1 = gametime%8 = 0
time = 8
length = 2
palcolor = 256
palinvertall = 0
palbright = 0,0,0
palcontrast = 128,128,128
palpostbright = 0,0,0
paladd = 0,0,0
palmul = 1,1,1
timegap = 4
framegap = 1
trans = add1

[State 40, Explod]
type = Explod
trigger1 = time%8 = 0
trigger1 = var(1) < 2
anim = 6801
pos = 0,0
postype = p1
removetime = -2
;bindtime = 0
facing = 1
pausemovetime = -1
supermovetime = -1
sprpriority = -2
ownpal = 1
scale = ceil(const(size.xscale)),ceil(const(size.yscale))
[State 40, Explod]
type = Explod
trigger1 = time%16 = 0
trigger1 = var(1) >= 2
anim = 6802
pos = 0,0
postype = p1
removetime = -2
;bindtime = 0
facing = 1
pausemovetime = -1
supermovetime = -1
sprpriority = -3
ownpal = 1
scale = ceil(const(size.xscale)),ceil(const(size.yscale))
[State 40, Explod]
type = Explod
trigger1 = time%16 = 0
trigger1 = var(1) = 3
anim = 6100
pos = ceil(-5*const(size.xscale)),ceil(-25*const(size.yscale))
postype = p1
removetime = -2
;bindtime = 0
facing = 1
pausemovetime = -1
supermovetime = -1
sprpriority = -1
ownpal = 1
scale = ceil(const(size.xscale)),ceil(const(size.yscale))
[State 40, Explod]
type = Explod
trigger1 = time%8 = 0
trigger1 = var(1) = 3
anim = 6101
pos = 0,0
postype = p1
removetime = -2
;bindtime = 0
facing = 1
pausemovetime = -1
supermovetime = -1
sprpriority = -2
ownpal = 1
scale = ceil(const(size.xscale)),ceil(const(size.yscale))

[State 0, Explod]
type = Explod
trigger1 = !numexplod(100)
trigger1 = var(1) >= 2
trigger1 = anim != [109,110]
anim = 115
ID = 100
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -1
pausemovetime = 0
scale = const(size.xscale), const(size.yscale)
sprpriority = 5
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 1

;-------------------------ETC--------------------
[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup" && var(1) < 3 && !aiLevel
value = 40
[State 100, 4]
type = ChangeState
triggerall = command = "holdback" && command != "holdfwd" && command != "holddown" && !aiLevel
trigger1 = anim = 99
trigger2 = anim > 99
trigger2 = time > 5
value = ifelse(anim != 99, 102, 105)
[State 100, 4]
type = ChangeState
triggerall = anim != 99
trigger1 = command != "holdfwd" && command != "holddown" && !aiLevel
trigger1 = var(2) > 5
trigger2 = time >= 5
trigger2 = aiLevel && p2bodydist x <= 75 && p2statetype != L && ((enemynear,stateno != [5100,5120]) && (enemynear,stateno != [6100,6120]))
value = 101
[State 100, 4]
type = ChangeState
triggerall = anim = 99
trigger1 = command != "holdfwd" && command != "holddown" && !aiLevel
trigger1 = var(2) > 5
trigger2 = time >= 5
trigger2 = aiLevel && p2bodydist x <= 75 && p2statetype != L && ((enemynear,stateno != [5100,5120]) && (enemynear,stateno != [6100,6120]))
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Run Backward
[Statedef 105]
type    = S
physics = N
anim = 104+var(1)
ctrl = 0
sprpriority = 1

;Sorting the controllers like this so it's a bit easier to navigate through ;) except im actually not OOPS

;---------------------TRANSITION FROM SHOULDER BASH-------------------------
[State 0, PosSet]
type = velSet
trigger1 = prevstateno = 1101 && !time
y = 0
[State 0, PosSet]
type = PosSet
trigger1 = prevstateno = 1101 && !time
y = 0

;---------------------SFX-------------------------

[State 100, Mach 1]
type = PlaySnd
trigger1 = anim = 104
value = S100,0
channel = 1
loop = 1
persistent = 0

[State 100, Mach 2 Start]
type = StopSnd
trigger1 = anim = 105
channel = 1 
persistent = 0
[State 100, Mach 2]
type = PlaySnd
trigger1 = anim = 105
value = S100,1
channel = 1
loop = 1
persistent = 0

[State 100, 1]
type = VelSet
trigger1 = anim = 104
x = const(velocity.run.back.x)*0.7
[State 100, 1]
type = VelSet
trigger1 = anim = 105
trigger2 = anim = 110
trigger2 = var(1) = 1
x = const(velocity.run.back.x)

[State 0, VarSet]
type = VarSet
trigger1 = anim = 104
trigger1 = animtime = 0
v = 1
value = 1

;------------------------ROLL----------------
