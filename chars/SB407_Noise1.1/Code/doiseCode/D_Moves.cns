air.velocity = -4.45,-2.15
air.hittime = 17
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/fvar(20)
forcenofall = 1

[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
trigger1 = movehit
v = 21
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarSet
trigger1 = movehit
v = 20
value = 402
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = var(20) > 0 && var(20) < 402
trigger1 = movecontact && moveguarded && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0
[State 200, Add to Score]
type = VarAdd
trigger1 = movehit && var(41) = 1
v = 22
value = ceil((var(21)**2 * 0.25) + (var(21)*10))
ignorehitpause = 1
persistent = 0

[State 200, Damage Dampen]
type = varset
trigger1 = movehit
fvar(10) = fvar(10)*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.05
ignorehitpause = 1
persistent = 0

[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(9) >= 0
trigger2= movecontact || moveguarded || movereversed
movetype= I

[State 430, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1