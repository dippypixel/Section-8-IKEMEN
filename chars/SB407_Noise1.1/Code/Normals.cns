;---------------------------------------------------------------------------
; 5x
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 0
poweradd= 0
ctrl = 0
anim = 200
facep2 = 1

[State 0, VelSet]
type = VelSet
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499]) && prevstateno != 646
trigger1 = !var(50)
x = 0
y = 0 

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = S0,0

[State 200, 1]
type = HitDef
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = !movecontact && !moveguarded && !movereversed
attr = S, NA
damage = 22, 0
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 5,5
sparkno = 0
sparkxy = -10,ceil(-46*const(size.yscale))
hitsound = s5, 0
guardsound = s6, 0
getpower = ceil(25*fvar(7)), ceil(12*fvar(7))
givepower = 20, 20
ground.type = High
air.type = High
ground.slidetime = 8
ground.hittime  = 12
air.hittime = 12
guard.hittime = 8
airguard.hittime = 8
ground.velocity = -4.25
guard.velocity = -5
air.velocity = -3.5,-3
airguard.velocity = -2,-1
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/fvar(20)
forcenofall = 1

[State 200, Add to Combo counter]
type = VarAdd
triggerall = var(21) < 999
trigger1 = movehit
v = 21
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarSet
trigger1 = movehit
v = 20
value = 402
ignorehitpause = 1
persistent = 0
[State 200, Start/Reset Combo time]
type = VarAdd
triggerall = var(20) > 0 && var(20) < 402
trigger1 = movecontact && moveguarded && !movehit
v = 20
value = 20
ignorehitpause = 1
persistent = 0
[State 200, Add to Score]
type = VarAdd
trigger1 = movehit && var(41) = 1
v = 22
value = ceil((var(21)**2 * 0.25) + (var(21)*10))
ignorehitpause = 1
persistent = 0

[State 200, Damage Dampen]
type = varset
trigger1 = movehit
fvar(10) = fvar(10)*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.05
ignorehitpause = 1
persistent = 0

[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(3) >= 0
trigger2= movecontact || moveguarded || movereversed
movetype= I

[State 230, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

