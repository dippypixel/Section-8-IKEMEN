;---------------------------------------------------------------------------
; Hyper Portrait
[Statedef 2999]
type    = U
movetype = I
physics = N
juggle  = 0
poweradd= 0
ctrl = 0
anim = 2999
sprpriority = 99999

[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time < 4
time = 1
add = 0,0,0
mul = ceil(256-(64*(time))),ceil(256-(64*(time))),ceil(256-(32*(time)))
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1
[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time >= 4 && Time <= 24
time = 1
add = 0,0,0
mul = 64,64,128
sinadd = 0,0,0,0
invertall = 0
color = 256
ignorehitpause = 1
[State 0, BGPalFX]
type = BGPalFX
trigger1 = Time >= 24 && time < 32
time = 1
add = 0,0,0
mul = 64+(24*(time-24)),64+(24*(time-24)),128+(12*(time-24))
sinadd = 0,0,0,0
invertall = 0
color = 256

[State 0, PosSet]
type = PosSet
trigger1 = 1
x = ceil((-gamewidth/2)*facing)

[State 0, VarSet]
type = VarAdd
trigger1 = time<18
v = 29
value = 18-(time)
[State 0, VarSet]
type = VarAdd
trigger1 = time>=40
v = 29
value = -(time-40)

[State 0, Offset]
type = Offset
trigger1 = 1
x = (-200 + var(29) + random%5) * facing
y = ceil(-Screenpos Y)+(gameheight/4)+random%5

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 1200, ChangeState]
type = destroyself
trigger1 = time >= 90

