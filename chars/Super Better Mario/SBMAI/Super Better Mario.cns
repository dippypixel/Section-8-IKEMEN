sparkxy = -10, -40
hitsound = S1,0
guardsound = 6, 0
ground.type = low
ground.slidetime = 5
ground.hittime  = 10
ground.velocity = -1.1
guard.slidetime = 5
guard.hittime = 11
guard.ctrltime = 10	
airguard.velocity = -1.9,-.8
