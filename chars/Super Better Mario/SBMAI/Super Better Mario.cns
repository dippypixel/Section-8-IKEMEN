[Statedef 31502]
type    = A
movetype= I
physics = N
anim = 703
sprpriority = -3
ctrl = 0

[State 60, Trans]
type = Trans
trigger1 = 1
trans = add

[State 60, 1]
type = palfx
trigger1 = time > 0
time = 1
add = -time*10,-time*10,-time*10

[State 60, AngleDraw]
type = AngleDraw
trigger1 = time < 30
scale = 1*(time*.20),1*(time*.20)

[State 60, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 3201,2]
type = AngleSet
trigger1 = 1 ;High air hit
value = 90
persistent = 0

[State 60, DestroySelf]
type = DestroySelf
trigger1 = animtime = 0

;AI Counter Memory Helper
[StateDef 9741]
type = A
movetype = I
physics = N
anim = 9999 ; Blank State
ctrl = 0

[State 9741, BindToRoot]
type = BindToRoot
trigger1 = PlayerIdExist(Root,ID)
facing = 1
pos =0,0
ignorehitpause = 1 

[State 9741, HitBy]
type = HitBy
trigger1 = 1
value = 

[State 9741, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
flag2 = Invisible

