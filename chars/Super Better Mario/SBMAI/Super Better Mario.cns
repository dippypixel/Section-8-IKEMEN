[State 180, Set Random]
type = VarRandom
triggerall = !var(27)
triggerall = !var(8)
triggerall = life > 250
trigger1 = Time = 0
v = 35
range = 0,1

[State 180, 0]
type = ChangeState
triggerall = !var(27)
triggerall = !var(8)
triggerall = life > 250
trigger1 = Var(35) = 0
value = 181

[State 180, 1]
type = ChangeState
triggerall = !var(27)
triggerall = !var(8)
triggerall = life > 250
trigger1 = Var(35) = 1
value = 183+random%2

[State 180, 1]
type = ChangeState
triggerall = !var(27)
triggerall = !var(8)
trigger1 = life <= 250
value = 182

[State 180, 1]
type = ChangeState
triggerall = matchover = 1
trigger1 = var(8) > 0
value = 185

[State 180, 1]
type = ChangeState
trigger1 = var(27) > 0
value = 186
