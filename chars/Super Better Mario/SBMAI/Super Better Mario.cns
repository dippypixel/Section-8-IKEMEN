type = S
ctrl = 0
anim = 170
velset = 0,0

[State -3, Pain Sound]
type = PlaySnd
trigger1 = time = 0
value = s10,ifelse(random>500,98,17+random%2)
channel = 0
volumescale = 155

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

