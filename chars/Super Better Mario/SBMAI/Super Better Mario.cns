;---|Powercharge sounds|--------------------------------------------------
[State -3, levelup var 0]
type = VarSet
trigger1 = power < 1000
v =  2
value = 0

[State -3, levelup var 1]
type = VarSet
trigger1 = (power >= 1000) && (power < 2000)
v =  2
value = 1

[State -3, levelup var 2]
type = VarSet
trigger1 = (power >= 2000) && (power < 3000)
v =  2
value = 2

[State -3, levelup snd 3]
type = PlaySnd
triggerall = !var(11)
triggerall = !var(12)
triggerall = !var(13)
trigger1 = (power >= 3000) && (var(2) < 3) && (RoundState = 2)
value = 30,ifelse(teammode = simul,1,0)
abspan = 1

[State -3, levelup var 3]
type = VarSet
trigger1 = (power >= 3000)
v =  2
value = 3

;Due to the way MUGEN's default Double Jump system works, it's impossible to disable the default double
;jump code without making it look weird, which is why tbe double jump here is custom coded, however it'll basically work identically to the original
[state -3, Double Jump Available]
type = VarSet
trigger1 = statetype != A
var(17) = 0

[state -3, Double Jump Used]
type = VarSet
triggerall = statetype = A
trigger1 = stateno = 45 || prevstateno = 45
var(17) = 1

[State -3, Hold Up Detector]
type = VarSet
trigger1 = command != "holdup" || var(59)
var(18) = 0
