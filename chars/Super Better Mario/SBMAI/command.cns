;Wall jump
[State -1, Wall jump]
type = ChangeState
value = 730
triggerall = !var(59)
triggerall = command = "walljumpfwd"
triggerall = backedgebodydist <= 0
triggerall = statetype = A
trigger1 = ctrl 

