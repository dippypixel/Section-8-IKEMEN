[State -1, Stand Light Kick]
type = ChangeState
value = 230
triggerall = var(59) <= 3
triggerall = command = "a"
triggerall = command != "holddown"
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = stateno = 200 && movecontact && time >=2

