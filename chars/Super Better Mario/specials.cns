;Dizzy Hitting Floor
[Statedef 15100]
type = L
movetype = H
physics = N

[State Falling]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State Shake The Screen]
type = fallenvshake
trigger1 = !time

[State System Variable]
type = varset
trigger1 = !time
sysvar(1) = floor(vel y)

[State Hit Of The Ground]
type = ChangeAnim
trigger1 = !time
value = 5100

[State Stopped Positon]
type = posset
trigger1 = !time
y = 0

[State 1115100, Vel]
type = velset
trigger1 = !time
y = 0

[State 1115100, Vel]
type = velmul
trigger1 = !time
x = 0.75

[State Lie End]
type = changestate
trigger1 = !time
trigger1 = gethitvar(fall.yvel) = 0
value = 15110

[State Dust]
type = Explod
trigger1 = Time = 1
anim = F(60 + (sysvar(1) > Const720p(20)) + (sysvar(1) > Const720p(56)))
pos = 0, 0
postype = p1 ;Using The mugen1.1
sprpriority = ifelse (sysvar(1) <= Const720p(56), -10, 10)

[State Falling Damage]
type = HitFallDamage
trigger1 = Time = 3

[State Sound Bounce]
type = PlaySnd
trigger1 = Time = 1
value = F7, (sysvar(1) > Const720p(20)) + (sysvar(1) > Const720p(56))

[State Freezing]
type = posfreeze
trigger1 = 1

[State End]
type = changestate
trigger1 = !animtime
value = 15110
;-------------------------------------------------------------------------------
;Dizzy Bounce
[Statedef 15101]
type = L
movetype = H
physics = N

[State Air Bounce]
type = changeanim
trigger1 = !time
value = 5160

[State Falling Velocity]
type = hitfallvel
trigger1 = !time

[State Position The Save Cns]
type = PosSet
trigger1 = Time = 0
y = Const(movement.down.bounce.offset.y)

[State Position The Save Cns]
type = PosAdd
trigger1 = Time = 0
x = Const(movement.down.bounce.offset.x)

[State Position The Save Cns] ;Acceleration
type = VelAdd
trigger1 = 1
y = Const(movement.down.bounce.yaccel)

