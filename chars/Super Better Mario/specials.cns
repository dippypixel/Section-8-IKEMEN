;Dizzy Fall
[Statedef 15050]
type = A
movetype = H
physics = N

[State Accel]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[State 0, HitVelSet]
type = HitVelSet
trigger1 = !time
x = 1
y = 1

[State Done The Animation] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != [5090,5099] ;Not if hit off ground anim
value = 5050

[State Coming down Animation]
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, Const720p(4), Const720p(-8))
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State Bouncy]
type = changestate
trigger1 = vel y > 0
trigger1 = pos y >= ifelse((anim = [5051, 5059]) || (anim = [5061, 5069]), 0, 25)
value = 15100
