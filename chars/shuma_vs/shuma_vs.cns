trigger3 = (stateno = [650, 655]) && (var(6))
trigger4 = (stateno = [660, 665]) && (var(6))
name = "FS Effect (Aerial Rave)"
ID = 7500
stateno = 7500
pos = 0,0
postype = p2
ownpal = 1
size.air.back = 20
size.air.front = 20
ignorehitpause = 1
persistent = 0

