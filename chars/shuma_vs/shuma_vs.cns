;VAR(14) AND VAR(57) MUST BE ABOVE 1 AT THE SAME TIME FOR YOUR HYPER TO BE CANCELLED INTO BY YOUR PARTNERS DHC HYPER.
;VAR(14) WILL BE SET TO 1 WHEN YOUR HYPER CAN BE CANCELLED AND VAR(57) IS SET FROM THE LIST AT THE BOTTOM OF THE CNS.
;VAR(57) IS SET WHEN YOU ARE IN STATES 3000-3999, YOU DO YOUR PARTNERS HYPER COMMAND, YOU HAVE POWER >=1000 AND VAR(57)=0

;Set var(57) to 0 at the beginning and end of each hyper.
;of the cns file.
[State 3000]
type = Varset
trigger1=time<=30
trigger2=(AnimelemTime(46)>0)
v=57
value=0

;Set var(14) to 1 so your hyper CAN be cancelled into by your partners DHC hyper.
[State 3000]
type = Varset
trigger1=(AnimelemTime(7)>=0)&&(AnimelemTime(46)<0)
v=14
value=1

;Reset var(14) to 0 so your hyper CANNOT be cancelled into by your partners DHC hyper. 
[State 3000]
type = Varset
trigger1=(AnimelemTime(46)>0)
v=14
value=0

;This is the changestate for when your partner interrupts you hyper with his DHC hyper, this changestate makes you jump
;offscreen so your partner can start his DHC hyper(you will end up offscreen in state 4512)
[State 3000, DHC]
type=ChangeState
trigger1=(partner,stateno=[4401,4449])&&(partner,pos y <=0)||(stateno=[4401,4449])&&(pos y <=0)
value=4450

[State 3000]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1



