;==============================================================================================
;                                               DASHES
;==============================================================================================
;Dash Forward
[Statedef 100]
type    = S
physics = N
anim = 100
ctrl = 0;<------------this has to be set at 0 for the long jump to work
sprpriority = 1

[state 0, 1]
type = posset
trigger1 = 1
y = 0

[state 0, ctrlset for longjump]
type = ctrlset
trigger1 = time>=4
value = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time=1
value = S0,62
volume = 0
channel = -1

[State 100, 1] ;To start dashing forwards
type = VelSet
trigger1 =time=0
x = 5.5

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, dash FX]
type=Explod
Anim=7014
trigger1=ifelse(prevstateno=7600,time=2,time=0)
postype=P1
pos=-40,-15
bindTime=1
sprpriority=4
vel=ifelse(frontedgebodydist>=110,3,0),0
scale=.5,.5
ownpal=1
removeongethit=1

[State 100,6];<--------------with ctrl at 0, you need this for the long jump
type =changestate
trigger1 = command = "holdup"
value = 40


[State 100, 3] ;
type = ChangeState
trigger1 = AnimTime = 0
value = 101

