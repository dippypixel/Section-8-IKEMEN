type=varrangeset
trigger1= movetype=I 
trigger2= movetype=H && time
first=41
last=47
value=-1
ignorehitpause=1
[State -2, HitPause]
type=varadd
trigger1= var(47)>0
var(47)=-1
ignorehitpause=1

