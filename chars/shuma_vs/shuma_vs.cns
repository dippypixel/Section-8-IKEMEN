;================================================================================================
;                                         AI ACTIVATION
;================================================================================================
;---Adapted from Winane's---
[StateDef 9741]
anim=9741
ctrl=0
[State 9741, safety]
type=selfstate
trigger1=!ishelper
value=0
[State 9741, end]
type=destroyself
trigger1=((root,ID)!=(parent,ID))||!(root,alive)
trigger2=roundstate!=2
trigger3=root,var(59)

[State 9741, facing]
type=turn
trigger1=facing!=root,facing
[State 9741, pausecheck]
type=varset
trigger1=(root,movecontact)&&!(root,ctrl)
trigger2=(facing!=root,facing)
var(0)=0

[State 9741, dirturnonAI]
type=parentvarset
triggerall=var(0)
trigger1=(root,command="up")||(root,command="down")||(root,command="back")||(root,command="fwd")
var(59)=1
[State 9741, dirturnoffAI]
type=parentvarset
trigger1=(command="up")&&(root,command="up")
trigger2=(command="down")&&(root,command="down")
trigger3=(command="back")&&(root,command="back")
trigger4=(command="fwd")&&(root,command="fwd")
var(59)=-1
[State 9741, buttonturnonAI]
type=parentvarset
triggerall=var(0)
trigger1=(root,command="a")||(root,command="b")||(root,command="c")||(root,command="x")
trigger2=(root,command="y")||(root,command="z")||(root,command="start")
var(59)=1
[State 9741, buttonturnoffAI]
type=parentvarset
trigger1=(command="a")&&(root,command="a")
trigger2=(command="b")&&(root,command="b")
trigger3=(command="c")&&(root,command="c")
trigger4=(command="x")&&(root,command="x")
trigger5=(command="y")&&(root,command="y")
trigger6=(command="z")&&(root,command="z")
trigger7=(command="start")&&(root,command="start")
var(59)=-1
[State 9741, unpausecheck]
type=varset
trigger1=root,ctrl
var(0)=1
;================================================================================================
;                         States that are always executed (use statedef -2)
;================================================================================================

[Statedef -2]

;Debug
[State -2, Debug Flag Display]
type = DisplayToClipboard
trigger1 = 1
text = "Game width %d, middle %d, var 19 %d" 
params = GameWidth, GameWidth/2, var(19)
;text = "partner,stateno=%d , 14=%d , 57=%d , 51=%d , 59=%d" 
;params = var(50) , var(14) , var(57) , var(51) , var(59)


;================================================================================================
;                                  DANGER SOUND AND DISPLAY TRIGGERS
;================================================================================================
;Danger!
[State -2, Danger]
type = PlaySnd
triggerall = Var(12) = 1
triggerall = (Teamside =1 && IsHomeTeam) || (Teamside =2 && !IsHomeTeam) || (TeamSide=1 && !IsHomeTeam)
trigger1 = Life <= 200
value =9600,2

[State -2, Danger]
type = Explod
trigger1 = NumExplod(8000) = 0
trigger1 = Var(12) = 1
anim = 8000
sprpriority = 100
postype = Left
pos = ifelse(TeamSide = 2,240,80),55
bindtime = -1
supermove = 1
ownpal = 1
persistent = 0
ignorehitpause = 1
ontop = 1
scale=.8,.8
size.shadowoffset = -9999
id = 8000

[State -2, Danger VarAdd]
type = varadd
triggerall = Life <= 200
trigger1 = Var(12) <= 2 
v = 12
value = 1
;================================================================================================
;                                   KO/CHEAP DEATH SOUND TRIGGERS
;================================================================================================
[State -2, KO snd]
type = varset
trigger1 = alive && var(13) > 0
trigger2 = !alive && var(13) < 2
var(13) = ifelse(alive, 0, var(8) + 1)
ignorehitpause = 1

;THIS WILL PLAY YOU KO SOUND WHEN KILLED, IT COULD ALSO PLAY THE CHEAP DEATH SOUND WHEN IN STATE 5130 BUT USUALLY
;THE CHEAP DEATH SOUND IS NOT PLAYED AT THE VERY BEGINNING OF THE CHEAP DEATH STATE, IF IT IS THEN PUT IT HERE
[State -2, KO snd]
type = playsnd
trigger1 = !alive && var(13) = 1
trigger1 = var(13) := 2
trigger2 = !alive && var(13) = 61
trigger2 = var(13) := 2
value = 2,ifelse(stateno=5130,-1,0)
channel = 1
ignorehitpause = 1


;================================================================================================
;                                        Remove Explodes
;================================================================================================
[State -2,Dizzy Stars] 
type=RemoveExplod
trigger1=stateno!=[9001,9004] 
ID=9001



;================================================================================================
;                              Damage Dampener (Combos take less damage)
;================================================================================================

;BASIC ATTACKS
[State -2, Damage based on hits]
type=varset
trigger1=numenemy
fvar(12)=enemynear,gethitvar(hitcount)
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type=varset
trigger1=numenemy
trigger1=(enemynear,movetype!=H)
trigger2=!numenemy
fvar(12)=1

