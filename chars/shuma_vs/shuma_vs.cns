trigger1 = P2MoveType != H
trigger2 = (enemy, alive = 0) && roundstate > 2
var(5) := var(6) := 0

[State -2, Flying Screen ScreenBound]
type = ScreenBound
trigger1 = (stateno = [620, 625]) && (var(6))
trigger2 = (stateno = [621, 626]) && (var(6))
trigger3 = (stateno = [650, 655]) && (var(6))
trigger4 = (stateno = [660, 665]) && (var(6))
value = 0
movecamera = 0,0
ignorehitpause = 1

[State -2, Don't exchange Positions with foe if AR in corner]
type = PosAdd
triggerall = stateno != [3000, 4999]
trigger1 = (PrevStateNo = [620, 625]) && (FrontEdgeDist < 35)
trigger2 = (PrevStateNo = [621, 626]) && (FrontEdgeDist < 35)
trigger3 = (PrevStateNo = [650, 655]) && (FrontEdgeDist < 35)
trigger4 = (PrevStateNo = [660, 665]) && (FrontEdgeDist < 35)
x = -5
ignorehitpause = 1

[State -2, Dash On Screen after Flying Screen]
