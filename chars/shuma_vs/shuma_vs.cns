anim = 1250

[State 1260, BindToParent]
type = null;BindToParent
trigger1 = time >= 10
time = 1
pos= -50*sin(time*0.2), 50*cos(time*0.2)


; This VAR indicates the helper's location relative to its parent. (angle)
[State 9000, VarSet]
type = VarSet
trigger1 = time = 0
trigger1 = IsHelper(1260)
trigger1 = time <= 42
fv = 15
value = pi * -0.5

; This VAR indicates the helper's location relative to its parent. (angle)
[State 9000, VarSet]
type = VarSet
trigger1 = time = 0
trigger1 = IsHelper(1261)
trigger1 = time <= 42
fv = 15
value = pi* -0.16667

; This VAR indicates the helper's location relative to its parent. (angle)
[State 9000, VarSet]
type = VarSet
trigger1 = time = 0
trigger1 = IsHelper(1262)
trigger1 = time <= 42
fv = 15
value = pi* 0.16666

; This VAR indicates the helper's location relative to its parent. (angle)
[State 9000, VarSet]
type = VarSet
trigger1 = time = 0
trigger1 = IsHelper(1263)
trigger1 = time <= 42
fv = 15
value = pi * 0.5

; This VAR indicates the helper's location relative to its parent. (angle)
[State 9000, VarSet]
type = VarSet
trigger1 = time = 0
trigger1 = IsHelper(1264)
trigger1 = time <= 42
fv = 15
value = pi * 0.83333

; This VAR indicates the helper's location relative to its parent. (angle)
[State 9000, VarSet]
type = VarSet
trigger1 = time = 0
trigger1 = IsHelper(1265)
trigger1 = time <= 42
fv = 15
value = pi * -0.83333



;This VAR is the rotation speed (So, you will be able to accelerate, or decelerate the rotation ratio.)
[State 9000, VarSet]
type = VarSet
trigger1 = time = 0;Adjust as you wish.
trigger1 = time <= 42
fv = 16
value = 0.11



; This is the Y stretch of the move,in case you don't want a perfect circle. (Oval shaped effect.)
[State 9000, VarSet]
type = VarSet
trigger1 = 1
fv = 17
value = 50 ;Can be .5, .2, or even an expresion.

;This is the X stretch of the move.
[State 9000, VarSet]
type = VarSet
trigger1 = 1
fv = 18
value = 35


;This adds the angle to the current one
[State 9000, VarAdd]
type = VarAdd
trigger1 = Time >= 12 ;Adjust as you wish.
trigger1 = time <= 42
fv = 15
value = FVar(16)

;This sets the helper's position, relative to its parent.
[State 9000, BindToParent]
type = BindToParent
trigger1 = time > 0
trigger1 = time <= 42
facing = 1
time = 1
pos = Cos(FVar(15)) *FVar(18), Sin(FVar(15)) *FVar(18)


