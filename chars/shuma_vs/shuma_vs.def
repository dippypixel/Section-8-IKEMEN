;====================================================
; Definition file for Shuma-Gorath
; Versus Series Fighting Style
; Contains all the filenames needed for the character
;====================================================

; Player information
[Info]
name = "Shuma-Gorath"
displayname ="Shuma-Gorath"
versiondate = 02,22,2022
mugenversion = 1.0
author ="Nestor"
pal.defaults = 1, 2, 3, 4, 5, 6
localcoord = 384,240;384,240		;Local coordinate space width and height


; Files for the character
[Files]
cmd     = shuma_vs.cmd     
cns     = shuma_vs.cns     
st      = shuma_vs.cns     
;st1     = shuma_vs_DHC.st
;st2	= shuma_vs_TAG.st
;st3     = shuma_vs_THC.st
;st4	= shuma_vs_ASSIST.st
stcommon = Vs_common1.cns 
sprite    =shuma_vs.sff
anim      =shuma_vs.air     
sound     =shuma_vs.snd

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
