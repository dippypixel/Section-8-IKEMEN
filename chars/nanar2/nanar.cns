; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S

[State 190, SetAI]
type = VarSet
triggerall = !RoundState
triggerall = IsHomeTeam
trigger1 = (TeamSide = 2)
trigger2 = (MatchNo > 1)
var(59) = 1

