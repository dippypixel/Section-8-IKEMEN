;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

;---------------------
;EASY MODE STUFF

[State -2, VarSet]
type = VarSet
triggerall = command = "start"
trigger1 = RoundState = 1

var(45) = 1

[State 0, Explod]
type = Explod
trigger1 = AILevel = 0
trigger1 = roundstate = 1
trigger1 = var(45) = 0
anim = 9988
ID = -1
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = 1,1
sprpriority = 9
ontop = 1
shadow = 0,0,0
ownpal = 0
removeongethit = 0
;ignorehitpause =
;persistent =
;supermove = 0
;pausemove = 0



;----------------------------

[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = StageVar(info.name) = "Werid ice space things"
flag = unguardable

[State -2, PowerAdd]
type = PowerAdd
trigger1 = StageVar(info.name) = "Z"
value = 100


;STUN STUFF



;--------------------------------------------------------------


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;==================================================================================
;======| RELACIONADO À AI - AI RELATED (by Winane) |===============================
;==================================================================================


[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
value = S1, 17

[State -3,PlaySnd1]
type = PlaySnd
triggerall = Time = 1 && Alive && Random < 500
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5000 || Anim = 5010 || Anim = 5020
trigger2 = Anim = 15000 || Anim = 15010 || Anim = 15020
value = 5000,0
channel = 0

[State -3,PlaySnd2]
type = PlaySnd
triggerall = Time = 1 && Alive && Random < 500
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5001 || Anim = 5011 || Anim = 5021
trigger2 = Anim = 15001 || Anim = 15011 || Anim = 15021
value = 5000,1
channel = 0

[State -3,PlaySnd3]
type = PlaySnd
triggerall = Time = 1 && Alive && Random < 500
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5002 || Anim = 5012 || Anim = 5022
trigger2 = Anim = 15002 || Anim = 15012 || Anim = 15022
value = 5000,3
channel = 0

[State -3, PlaySnd]
type = PlaySnd
trigger1 = anim = 100
value = S1,21
volume = 0
channel = -1
freqmul = 10.0

[State -3, PlaySnd]
type = PlaySnd
trigger1 = anim = 40 && time = 1
value = S1,14
volume = 0
channel = -1

[State -3, Taunt]
type = ChangeState
triggerall = ctrl = 1
triggerall = Pos Y = 0
triggerall = movetype != H
triggerall = movetype != A
triggerall = enemy,movetype != A
triggerall = stateno != 195
trigger1 = roundstate = 3
trigger1 = winko
trigger1 = time = 0
value = 195
ignorehitpause = 1

