; ここにキャラ情報を書いてください
[Info]
name = "pucci"        ;キャラの名前
displayname = "pucci" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "0011"         ;キャラの製作者名
pal.defaults = 1,2,3,6      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = 0011-AI/pucci.cmd           ;コマンド
cns     = 0011-AI/pucci.cns           ;プログラム
st      = 0011-AI/pucci.cns           ;プログラム
st1      = 0011-AI/tandem.cns         ;タンデム（プログラム）
st2      = 0011-AI/Remotecontrol.cns  ;遠隔操作
st3      = _config.txt        ;コンフィグ
st4      = 0011-AI/Rtandem.cns        ;タンデム（リアルタイム）
stcommon = 0011-AI/jojocommon.cns     ;common
sprite  = pucci.sff   ;キャラの絵
anim    = pucci.air   ;キャラの動き
sound   = pucci.snd;   ;キャラの音
pal1    = pucci.act   ;キャラの色（最大１２個）
pal2    = pucci2.act
pal3    = pucci3.act
pal4    = pucci.act
pal5    = pucci4.act
pal6    = pucci5.act
pal7    = pucci6.act
pal8    = pucci6.act
pal9    = pucci6.act
pal10   = pucci7.act
pal11   = pucci8.act
pal12   = pucci7.act