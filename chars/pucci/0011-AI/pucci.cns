;------------------------------------------------------ここから下を適当なcnsファイル内にコピペ
[Statedef 9000]; アーマー判定ヘルパー
type = A
movetype = I
physics = N

[State 9000, 0]; 不具合対策
type = ChangeState
trigger1 = !IsHelper
value = 0
ctrl = 1

[State 9000, 0]; アーマー化した瞬間に重複被弾しないための無敵
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 1

[State 9000, 0]; 投げ無敵
type = NotHitBy
trigger1 = Time >= 1
value = ,AT
time = 2

[State 9000, 0]; 透明＋影消し
type = AssertSpecial
trigger1 = 1
flag = Invisible
flag2 = NoShadow

[State 9000, 0]; 本体に追従
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 9000, 0]; 判定を揃える
type = ChangeAnim
trigger1 = SelfAnimExist(Parent,Anim)
value = Parent,Anim
elem = Parent,AnimElemNo(0)

[State 9000, 0]; 打撃／飛び道具を受けたらステートを繰り返す
type = HitOverRide
trigger1 = IsHelper(9000)
attr = SCA,AA,AP
stateno = 9000

[State 9000, 0]; 本体がアーマーパートを過ぎたら消滅
type = DestroySelf
trigger1 = Parent,StateNo != 32100
trigger2 = Parent,StateNo = 32100 && (Parent,animelemtime(13) > 5)
;--------------------------------------------------------ここまでを適当なcnsファイル内にコピペ
;以下AIヘルパー
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ステージ右端検出
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;id : 55001
;var(0):前方ステージ端
;var(1):後方ステージ端
;var(2):相手のproj数
;var(3):相手のhelper数
;var(4):（タッグ時）もう一方の相手のproj数
;var(5):（タッグ時）もう一方の相手のhelper数
[Statedef 55001]
type=A
movetype=I
physics=N
ctrl=0
anim=29999;何も表示しないAnimなら、下記完全無敵と影消し、不可視化は不要
sprpriority=0
velset=10, 0;速度。projectileのものと同じにする

[state 50005]
type = AssertSpecial
trigger1 = 1
flag = invisible

[State 50005]
type = Nothitby
trigger1 = 1
Value = SCA

[State 50005]
type = SelfState
trigger1 = !IsHelper
Value = 0

[State 30000];画面にとらわれない
type=ScreenBound
trigger1=1
value=0
movecamera=0,0

[State 30000];判定用飛び道具射出
type=Projectile
trigger1=time=0
projID=55001
projanim=29999
velocity=10, 0;へルパーの初期速度と同じに
projpriority=4
projsprpriority=2
projstagebound=0;0がオススメ
projedgebound=99999
offset=0, 0
postype=right
supermovetime=99999
pausemovetime=99999
projremovetime=-1

[State -2];不可視化＆影消し。
type=assertspecial
trigger1=1
flag=noshadow
flag2=invisible
ignorehitpause=1

[State -2];飛び道具が消えたら停止。
type=velset
trigger1=!(root,numprojID(55001));ヘルパーが出したprojectileも本体管理になるので、「root,」を忘れないように
x=0
y=0

[State -2]
type=varset
trigger1=helper(55001),vel x = 0
trigger1=helper(55002),vel x = 0
trigger1=root,facing = 1
var(0) = root,facing*(pos x-root,pos x)

[State -2]
type=varset
trigger1=helper(55001),vel x = 0
trigger1=helper(55002),vel x = 0
trigger1=root,facing = -1
var(0) = root,facing*(helper(55002),pos x-root,pos x)

[State -2]
type=varset
trigger1=helper(55001),vel x = 0
trigger1=helper(55002),vel x = 0
trigger1=root,facing = -1
var(1) = root,facing*-1*(pos x-root,pos x)

[State -2]
type=varset
trigger1=helper(55001),vel x = 0
trigger1=helper(55002),vel x = 0
trigger1=root,facing = 1
var(1) = root,facing*-1*(helper(55002),pos x-root,pos x)

[State 30006, 飛び道具監視];上の処理の後に相手のprojとhelperの最新の数を代入する
type = null
triggerall = NumEnemy
trigger1 = var(2) := Enemy(0),numproj
trigger2 = var(3) := Enemy(0),numhelper

[State 30006, 飛び道具監視タッグ二人目用]
type = null
triggerall = NumEnemy
trigger1 = var(4) := Enemy(numenemy=2),numproj
trigger2 = var(5) := Enemy(numenemy=2),numhelper

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ステージ左端検出
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;id : 55002
;var(0):現在のステート
;var(1):1つ前のステート
;var(2):2つ前のステート
;var(3):3つ前のステート
;var(4):4つ前のステート
;var(5):相手の地上中段ステートA
;var(6):相手の地上中段ステートB
;var(7):相手の地上中段ステートC
;var(8):相手の地上中段ステートD
;var(9):相手の地上中段ステートE
;var(10):相手の立下段ステートA
;var(11):相手の立下段ステートB
;var(12):相手の立下段ステートC
;var(13):相手の立下段ステートD
;var(14):相手の立下段ステートE
;var(15):相手今中段技
;var(16):相手今下段技
;var(17):倒れているとき30,起き上がったら減っていく
;var(18):ガード警戒　起き上がってからしばらくの間1　連続ガードからCtrlがもどってちょっとの間1　相手が先に降りて自分も降りたときちょっとの間1
;var(19):ガード回数
;var(20):ガード回数が3回以上で5,ガードが解けたら減っていく
;var(21):自分と相手が空中にいたら1
;var(22):相手が先に地上に降りたら5,自分も降りたら減っていく
;var(23):ガードしたときの相手のステート一時記憶　ステートが変わったら０
;var(24):ガードしたあとこっちが有利なら10,そこから1減っていく
;var(25):ガードした後こっちが有利ならちょっと1
;var(26):相手がジャンプしてからの時間
;var(27);立強終わってからの時間
;var(28);投げ終わってからの時間
;var(29);前立中終わってからの時間
