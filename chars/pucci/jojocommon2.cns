; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State -1, 防止]
type = ChangeState
trigger1 = time = 0
trigger1 = numhelper(4321) >= 1
value = 0
ctrl = 1

[State 0,バグったとき用]
type = ChangeState
trigger1 = helper(1),stateno = [5000,5999]
trigger1 = prevstateno != 58765
value = 58765

[State 0, 1]
type = Offset
triggerall = var(49) = 10000  
trigger1 = 1
y = 10-(var(29) = 1)*5

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x);*ifelse(var(29) = 1,1.5,1)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x);*ifelse(var(29) = 1,1.5,1)

[State 20, 2]
type = ChangeAnim
trigger1 = Anim != 10021+var(29)*2+(var(3) && var(49) = 10000)*20000
trigger1 = command = "holdback"
trigger1 = var(49) = 10000
value = 10021+var(29)*2+(var(3) && var(49) = 10000)*20000

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+var(49)+var(29)*2+(var(3) && var(49) = 10000)*20000 && Anim != 5+var(49) 
trigger2 = Anim = 5+var(49)+(var(3) && var(49) = 10000)*20000 && AnimTime = 0
value = 20+var(49)+var(29)*2+(var(3) && var(49) = 10000)*20000

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+var(49)+var(29)*2+(var(3) && var(49) = 10000)*20000 && Anim != 5+var(49)
trigger2 = Anim = 5+var(49)+(var(3) && var(49) = 10000)*20000 && AnimTime = 0
value = 21+var(49)+var(29)*2+(var(3) && var(49) = 10000)*20000

