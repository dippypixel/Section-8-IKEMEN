value = 9998

[State 5000, 8]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 799
trigger1 = anim = 5000
trigger2 = anim = 5005
trigger3 = anim = 5010
trigger4 = anim = 5015
value = 5,0
channel = 0

[State 5000, 8]
type = PlaySnd
