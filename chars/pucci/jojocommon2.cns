; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100+var(49)+var(29)*2+(var(3) && var(49) = 10000)*20002
sprpriority = 1
ctrl = 0

[State 1027, Sound]
type = Width
trigger1 = var(3) = 1
trigger1 = var(29) != 1
player = 45,0

[State 1027, Sound]
type = PlaySnd
trigger1 = Time = 0
trigger1 = var(29) = 0
trigger1 = var(3) && var(49) = 10000
value = 100,22
channel = 0

[State 0, 1]
type = Offset
triggerall = var(49) = 10000  
trigger1 = 1
y = 10-(var(29) = 1)*10

[State 100, 1]
type = VelSet
trigger1 = 1
trigger1 = !(var(3) && var(49) = 10000)
x = const(velocity.run.fwd.x)*ifelse(var(29) = 1,(time >= 3)*1.5,1)

[State 100, 1]
type = VelSet
triggerall = var(3) && var(49) = 10000
trigger1 = time <= 3
x = const(velocity.run.fwd.x)*1.3

[State 100, 1]
type = VelSet
triggerall = var(3) && var(49) = 10000
trigger1 = time > 10
x = const(velocity.run.fwd.x)*ifelse(var(29) = 1,1.5,1)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 5]
type = ChangeState
trigger1 = time> 5  && command = "holdup"
value = 40

[State 100, 5]
type = ChangeState
trigger1 = time> 5+(var(3) && var(49) = 10000)*5 && command != "holdfwd"
trigger2 = AnimTime = 0
value = 101
