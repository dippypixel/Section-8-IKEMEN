; Jump Up
[Statedef 50]
type    = A
physics = A

[State 0, 1]
type = Offset
triggerall = var(49) = 10000  
trigger1 = 1
y = 10

[State 50, 1]
type = Veladd
trigger1 = vel y >= 0
trigger1 = var(3) = 1
y = 2
persistent = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))+var(49)+(var(3) && var(49) = 10000)*20000
elem = 1+(prevstateno = 110)*7+(prevstateno = 115)*7

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

