;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------
[Statedef -2]

[State 210, 3]
type = VarSet
;trigger1 = numtarget
trigger1 = 1;TeamMode = simul
var(18) = enemynear,ID;stateno;target,stateno

[State 210, 3]
type = VarSet
trigger1 = numhelper(12354)
var(24) = helper(12354),ID

[State 210, 3]
type = VarSet
trigger1 = numhelper(12355)
var(42) = helper(12355),ID

[State 210, 3]
type = VarSet
trigger1 = numhelper(1235)
var(32) = helper(1235),ID

[State 210, 3]
type = SprPriority
trigger1 = enemynear,name = "ASB_JOSUKE"
trigger1 = enemynear,stateno = 305100000
trigger1 = stateno = 17003500
trigger1 = abs(enemynear,pos X-pos X) <= 50
value = 3

[State 210, 3]
type = posadd
trigger1 = enemynear,name = "ASB_JOSUKE"
trigger1 = enemynear,stateno = 305100000
trigger1 = stateno = 17003500
trigger1 = abs(enemynear,pos X-pos X) <= 50
x = -20

[State 210, 3]
type = ChangeAnim
trigger1 = enemynear,name = "ASB_JOSUKE"
trigger1 = enemynear,stateno = 305100000
trigger1 = stateno = 17003500
trigger1 = anim = 195 && time >= 310
value = 0

[State 210, 3]
type = PlaySnd
trigger1 = numtarget
trigger1 = target,stateno = 17004
trigger1 = target,time = 1
value = 6,0

[State 1027, Anim]
type = TargetLifeAdd
trigger1 = numtarget
trigger1 = target,stateno = 17004
trigger1 = target,time = 1
value = -20

;スースー吹き出し消去　夢の中の幻覚
[state -2, explod]
type = removeexplod
trigger1 = enemy,stateno != 2280
trigger1 = numexplod(12220)
id = 12220

[State 0,0]
type = null;VarAdd
trigger1 = helper(1233),movehit
var(39) = 1

;[State -2, 上昇]
;type = varadd
;trigger1 = numhelper(1235)
;trigger1 = 1
;trigger1 = var(38) = 0
;;trigger1 = numhelper(1231)
;var(38) = gametime

;[State -2, 上昇]
;type = hitadd
;trigger1 = var(38) = gametime
;trigger1 = numhelper(1235)
;trigger1 = var(40) = 0
;trigger1 = numhelper(1231)
;value = -enemynear,gethitvar(hitcount)+helper(1233),var(37);+var(39)
;ignorehitpause = 1

;[State -2, 上昇]
;type = hitadd
;trigger1 = var(38) = gametime
;trigger1 = numhelper(1235)
;trigger1 = var(40) = 0
;trigger1 = !numhelper(1231)
;value = -enemynear,gethitvar(hitcount);+var(39)
;ignorehitpause = 1

[state -2,hitadd]
type = HitAdd
;triggerall = numhelper(1235) && var(37)
trigger1 = enemy,movetype != H
value = -var(37)
ignorehitpause = 1

[state -2,var]
type = varset
;trigger1 = numhelper(1235) && var(37)
trigger1 = enemy,movetype != H
;trigger2 = !numhelper(1235)
var(37) = 0
ignorehitpause = 1

[State -2, 上昇]
type = varadd
trigger1 = movehit = 1
trigger2 = projhit = 1
var(37) = 1

[State -2];イントロスキップ
type = StopSnd
trigger1 = stateno = 0
channel = 2

[State 200, 1];素数スキップ　挑発
type = StopSnd
trigger1 = prevstateno = 195
trigger1 = var(29) = 0
trigger2 = stateno != 195
trigger2 = var(29) = 0
trigger3 = helper(1),stateno != 50000
trigger3 = var(29) = 1
trigger4 = helper(1),anim != 181
trigger4 = var(29) = 1
channel = 3

[State 821, 4]
type = CtrlSet
trigger1 = helper(4321),anim = 4321+(var(3) = 1)
value = 0

[State 821, 4]
type = CtrlSet
trigger1 = helper(4321),anim = 29999
value = 1

[State 821, 4]
type = StateTypeSet
triggerall = var(29) = 1
trigger1 = var(33) > 0
trigger1 = helper(1),stateno != 50000
movetype = H

[State -2];解除
type = AssertSpecial
triggerall = numhelper(1) != 0
;trigger1 = var(29) = 1 ;遠隔操作onかつ
trigger1 = helper(1),movetype = H && helper(1),stateno != [5000,5210]
trigger1 = helper(1),movetype = H && helper(1),stateno != 120
trigger1 = helper(1),movetype = H && helper(1),stateno != [130,131]
trigger1 = helper(1),movetype = H && helper(1),stateno != [132,140]
trigger1 = helper(1),movetype = H && helper(1),stateno != [150,151]
trigger1 = helper(1),movetype = H && helper(1),stateno != [152,153]
trigger1 = helper(1),movetype = H && helper(1),stateno != [154,155]
trigger1 = helper(1),movetype = H && helper(1),stateno != [14000,14005]
trigger1 = 1 || Var(49) := 0
trigger1 = 1 || Var(17) := 1
trigger1 = 1 || Var(23) := var(23)+ifelse(var(23) = 0,helper(1),life,0)
trigger2 = var(17) = 1
flag = invisible

[State -2];解除
type = SelfState
trigger1 = !ishelper(1)
trigger1 = !ishelper(4321)
trigger1 = helper(1),movetype = H && helper(1),stateno != [5000,5210]
trigger1 = helper(1),movetype = H && helper(1),stateno != 120
trigger1 = helper(1),movetype = H && helper(1),stateno != [130,131]
trigger1 = helper(1),movetype = H && helper(1),stateno != [132,140]
trigger1 = helper(1),movetype = H && helper(1),stateno != [150,151]
trigger1 = helper(1),movetype = H && helper(1),stateno != [152,153]
trigger1 = helper(1),movetype = H && helper(1),stateno != [154,155]
trigger1 = helper(1),movetype = H && helper(1),stateno != [14000,14005]
trigger1 = movetype = H && stateno != [5000,5210]
trigger1 = movetype = H && stateno != 120
trigger1 = movetype = H && stateno != [130,131]
trigger1 = movetype = H && stateno != [132,140]
trigger1 = movetype = H && stateno != [150,151]
trigger1 = movetype = H && stateno != [152,153]
trigger1 = movetype = H && stateno != [154,155]
trigger1 = movetype = H && stateno != [14000,14005]
trigger1 = stateno = helper(1),stateno
trigger1 = var(17) = 1
value = 0

[State -2];解除
type = SelfState
trigger1 = !ishelper(1)
trigger1 = !ishelper(4321)
trigger1 = stateno = 57987
trigger1 = var(17) = 0
value = 0

[State -2];解除
type = ChangeState
trigger1 = var(17) = 1
trigger1 = !ishelper
trigger1 = stateno != 57987
value = 57987

[State -2];解除
type = LifeAdd
trigger1 = var(17) = 1
trigger1 = var(23) >= 2
trigger1 = helper(1),life != var(23)
trigger1 = numhelper(1) != 0
value = helper(1),life-var(23)+(Var(23) := helper(1),life)*0

[State -2];解除
type = LifeAdd
trigger1 = var(17) = 1
trigger1 = helper(1),life = 0
trigger2 = (enemy,name = "kars" && enemy,numtarget && enemy,stateno = 3010 && helper(1),stateno = 5101)
value = -1

[State -2]
type = AssertSpecial
;trigger1 = movetype = H
;trigger1 = ishelper(1)
