trigger1 = animTime = 0    ;やられた瞬間のｱﾆﾒが終わってから!
;つまり、ふっとび開始→ふっとび　になる時に消し、プッチに戻す。
;その後、var(49) = 0を認識してプッチの絵が消える。

trigger2 = var(49) = 10000 ;ｽﾀﾝﾄﾞonかつ
trigger2 = movetype = H && stateno != [5000,5210]
trigger2 = movetype = H && stateno != 120
trigger2 = movetype = H && stateno != [130,131]
trigger2 = movetype = H && stateno != [132,140]
trigger2 = movetype = H && stateno != [150,151]
trigger2 = movetype = H && stateno != [152,153]
trigger2 = movetype = H && stateno != [154,155]
trigger2 = movetype = H && stateno != [14000,14005]
;ヒット状態、かつ、やられｺﾓﾝｽﾃｰﾄ以外のとき。つまり、相手にｽﾃｰﾄ奪われた時
;投げ終わりにSelfStateでｺﾓﾝやられｽﾃｰﾄに返されるが、相手先で参照するDefは[5000,5210]ではない！落ち着いて考えろ
;ちなみにｽﾀﾝﾄﾞｸﾗｯｼｭのｽﾃｰﾄは16010あたり。
;つまり、ヒット状態、かつ、やられｺﾓﾝｽﾃｰﾄ以外のときに含まれる。

trigger2 = movetype = H && anim != [10000,15210]
;さらに、ｺﾞｰﾙﾄﾞｴｸｽﾍﾟﾘｴﾝｽのｱﾆﾒ以外に変更された時に。
;こうすることでDIOの時止めな感じの投げに対応できた。
;---------------------------------------------------------------------------
