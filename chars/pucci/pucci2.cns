trigger1 = prevstateno != [5070,5071];足払いじゃないとき
trigger1 = AnimElem = 25             ;velSetと同じﾀｲﾐﾝｸﾞで
value = 5050                         ;吹っ飛びｽﾃｰﾄへ。

[State 16010];足払いを食らって
