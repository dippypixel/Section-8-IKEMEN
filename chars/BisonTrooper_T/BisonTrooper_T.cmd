;Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "FF" && Var(15) = 0
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2
trigger2 = enemynear,anim = 5300 && p2bodydist X > 16

