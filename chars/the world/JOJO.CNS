
;殺された時の顔出現(Helper)用--------------------------
[Statedef 6010]
type     = S
physics  = S
movetype = I
;facing = 1
anim = 1208
ctrl = 0

[State 1211, Exclamation]
type = Explod
trigger1 = time = 0 && numexplod(8088) = 0 ;&& root, facing = 1
anim = 8088
id = 8088
pos = ifelse(root, facing = 1, 170, 140),230
postype = back
facing = ifelse(root, facing = 1, 1, -1)
sprpriority = -20
bindtime = -1
supermovetime = -1
pausemovetime = -1
persistent = 0
ignorehitpause = 1

[State that starts the inverted effect]
type           = PalFx
trigger1       = Time = 20
add            = 0,0,0
sinadd         = 256,256,256,120
time           = 30
ignorehitpause = 1

[state whee]
type = removeexplod
trigger1 = roundstate = 4
id = 8088

[State changestate!]
type = DestroySelf
trigger1 = roundstate = 0 || roundstate = 1

