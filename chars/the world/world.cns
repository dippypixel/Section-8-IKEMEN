[Data]
life = 1000
attack = 100
defence = 100
power = 10000
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 1
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 12        ;キャラの幅(後方,空中)
air.front = 12       ;キャラの幅(前方,空中)
height = 60          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -5, -90   ;頭の大体の座標
mid.pos = -5, -60    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;キャラの表示座標（Ｘ軸,Ｙ軸）

[Velocity]
walk.fwd  = 0.91         ;前進の速度
walk.back = -0.91        ;後退の速度
run.fwd  = 5,3           ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -4,7          ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-7.1        ;垂直ジャンプの速度
jump.back = -3.-7        ;後ジャンプの速度
jump.fwd = 3.-7          ;前ジャンプの速度
runjump.back = -5.5,-11  ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4.5,-11    ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-6.4     ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.8,-5.5 ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.8        ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 1       ;空中でジャンプする回数
airjump.height = 30   ;空中でジャンプする最低限の高さ
yaccel = .35           ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; ステイトの解説
; [Statedef STATENO]
; type = ?      S/C/A/L  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｌ：ダウン
; movetype = ?  I/A/H    Ｉ：通常状態/Ａ：攻撃状態/Ｈ：ダメージをくらってる状態
; physics = ?   S/C/A/N  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｎ：無し
; juggle = ?             その攻撃に使うジャグル数
;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = S
physics = S
anim = 105

[State 105, 1]
type = VelSet
trigger1 = 1
x = -5
y = 0

[State 100, 2] 
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 105, 3]
type = ChangeState
trigger1 = command != "holdback"
trigger1 = Time > 4
value = 0
ctrl = 1

