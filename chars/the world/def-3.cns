[State -1, Kuretsu]
type = ChangeState
value = 2000
triggerall = random <= 255
triggerall = numhelper(1000) <= 25
triggerall = power >= 1000
triggerall = win != 1
triggerall = var(5) 
triggerall = var(11) = 1
triggerall = p2stateno != [5110, 5129]
