;---------------------------------------------------------------------------
; ここから下は-3のステートを書いてください、ここに書いたものはゲーム中
; に条件が成立すればいつでも開始するステートです。
;---------------------------------------------------------------------------

[Statedef -3]

[state haha]
type = assertspecial
trigger1 = 1
flag = nokoslow
ignorehitpause = 1

;チームモード　交代時のイントロ
[State -3, Turns Mode Intro]
type = ChangeState
triggerall = teammode = turns
triggerall = roundno > 1
triggerall = time = 0
triggerall = roundstate = 0
trigger1 = roundsexisted <= 0
value = 191

[state 2000,1]  
type = varset
trigger1 = var(5) = 0
var(7) = 1

[state 2000,1]  
type = varset
trigger1 = var(5) = 1
var(7) = 0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 40
trigger2 = stateno = 45
value = 50, 0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 45
value = 110, 0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 
value = 52, 0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5100
trigger2 = stateno = 5110
value = 11000, 1

;Wall crash sound
[State -2, Wall]
type = PlaySnd
trigger1 = (enemy, stateno = 1331) && (enemy, time = 1)
value = S666,1
abspan = ceil(p2bodydist X)
lowpriority = 1

[state 2000,1]  
type = varset
trigger1 = var(5) = 1
trigger1 = helper(10000),stateno = 13010
trigger1 = helper(10000),statetime >= 100
var(5) = 0
ignorehitpause = 1

[state 2000,1]  
type = varset
trigger1 = var(6) = 1
trigger1 = helper(10000),stateno = 13010
trigger1 = helper(10000),statetime >= 100
var(6) = 0
ignorehitpause = 1

