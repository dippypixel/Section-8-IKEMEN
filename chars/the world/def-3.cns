[State 40, 6];ジャンプ制御
type = ChangeState
triggerall = stateno = 40
triggerall = var(59)
trigger1 = p2bodydist x  < 75
trigger2 = p2bodydist x  > 130
value = 0
ctrl = 1

[State -3, ];空中制御用
type = ctrlset
TriggerAll = RoundState = 2
triggerAll = var(59)
trigger1 = StateNo = [50,51]
trigger1 = ctrl
value = 0

[State -3, ];空中制御用 解除
type = ctrlset
TriggerAll = RoundState = 2
triggerAll = var(59)
triggerall = prevstateno != 191
trigger1 = StateNo = 0
trigger1 = ctrl = 0
value = 1

[State -3, ];相手の投げを避ける為の強制ジャンプ
type = ChangeState
TriggerAll = RoundState = 2
triggerAll = var(59)
triggerAll = statetype != A
triggerall = ctrl || stateno = 130 || stateno = 131
triggerall = power <= 999
trigger1 = enemynear,HitDefAttr = SC, ST, HT
trigger1 = p2bodydist X = [40,120]
value = 40

[State -3,];時止め中チェックメイト回数
type = VarAdd
TriggerAll = RoundState = 2
triggerAll = var(59) && var(5)
trigger1 = (stateno = 2000 || stateno = 2100) && time = 1
var(58) = 1

[State -3,];時止め中チェックメイト回数
type = VarSet
TriggerAll = RoundState = 2
triggerAll = var(59)
trigger1 = var(5) = 0
var(58) = 0

;チェックメイトだッ！
[State -3]
type = ChangeState
value = ifelse((statetype = S || statetype = C),2000,2100)
triggerall = var(59)
triggerall = roundstate = 2
triggerall = power >= 1000
triggerall = var(5) || Enemynear,statetype != L
triggerall = var(5) || enemynear,prevstateno != [5000,5999]
triggerall = var(58) < 3
trigger1 = ctrl || stateno = 100 || stateno = 105
trigger1 = statetype != A
trigger1 = p2movetype = A
trigger1 = p2bodydist X >= -3
trigger1 = p2bodydist Y >= -50
trigger1 = Random >= 500
trigger2 = ctrl && Random >= 900
trigger2 = statetype != A && Enemynear,statetype != L
trigger2 = p2bodydist Y <= -40 && p2bodydist X = [-1,100]
trigger3 = ctrl || stateno = 100 || stateno = 105
trigger3 = statetype = A
trigger3 = p2bodydist X = [20,100]
trigger3 = Enemynear,Movetype = A
trigger4 = ctrl || stateno = 100 || stateno = 105
trigger4 = var(5)
trigger4 = power >= 3000
trigger5 = (stateno = 2000 || stateno = 2100) && AnimTime = 0
trigger5 = prevstateno != 2000 && prevstateno != 2100
trigger5 = Enemynear,Movetype = H || Enemynear,Movetype = A

;しゃがみ弱キック
[State -1, Crouching Light Punch]
type = ChangeState
value = 300
triggerall = var(59) && var(5) >= 1
triggerall = roundstate = 2
triggerall = Enemynear,statetype = S
triggerall = statetype = S || statetype = C
triggerall = p2bodydist X <= 39 && p2bodydist Y >= -70
trigger1 = ctrl || stateno = 100 || stateno = 105

;挑発
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = var(59)
trigger1 = statetype != A
trigger1 = ctrl && var(5) >= 1 && power <= 100

;しゃがみガード
[State -3]
type = ChangeState
value = 131
TriggerAll = RoundState = 2
triggerall = var(59)
triggerall = ctrl || stateno = 100 || stateno = 105
triggerall = statetype != A && Enemynear,statetype != A
triggerall = stateno != 191 && Life > 10
triggerall = InGuardDist
trigger1 = enemynear, Numproj >= 1
trigger2 = enemynear, Numhelper >= 1
trigger3 = enemynear,HitDefAttr = SC, NA, SA, HA

;立ちガード
[State -3]
type = ChangeState
value = 130
TriggerAll = RoundState = 2
triggerall = var(59)
triggerall = ctrl || stateno = 100 || stateno = 105
triggerall = statetype != A && Enemynear,Statetype = A
triggerall = stateno != 191 && Life > 10
triggerall = p2bodydist X < 80
triggerall = InGuardDist
trigger1 = enemynear, Numproj >= 1
trigger2 = enemynear, Numhelper >= 1
trigger3 = enemynear,HitDefAttr = A, NA, SA, HA

;空中ガード
[State -3]
type = ChangeState
value = 132
TriggerAll = RoundState = 2
triggerall = var(59) && Life > 10
triggerall = ctrl || stateno = 100 || stateno = 105
triggerall = statetype = A && movetype = I 
triggerall = stateno != 105 && stateno != 191
Triggerall = inguarddist
trigger1 = enemynear, Numproj >= 1 && P2MoveType = A && p2bodydist X > 80
trigger2 = enemynear, Numhelper >= 1 && P2MoveType = A && p2bodydist X > 80
trigger3 = enemynear,HitDefAttr = SCA, NA, SA, HA
trigger4 = enemynear, Numproj >= 1

[State -1, Run Fwd];ダッシュ
type = ChangeState
value = 100
triggerall = var(59)
triggerall = statetype = S
trigger1 = ctrl && p2bodydist X >= 120