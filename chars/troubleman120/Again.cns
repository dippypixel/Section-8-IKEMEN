;---------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---

[Statedef -2]

;================================================================================
; ---- DAMAGE MULTIPLIER ----
;===============================================================================
[State 0, Multiplier Var Reset]
type = VarSet
triggerall = Var(10) < 100
;triggerall = ctrl = 1
trigger1 = P2MoveType != H
trigger2 = P2StateNo = 5120
;trigger3 = StateNo = 3000
v = 10
value = 100

[State 0, Multiplier Var Minimum]
type = VarSet
trigger1 = Time = 1
triggerall = gethitvar(animtype) = 0
triggerall = Var(10) <= 10
v = 10
value = 10


;================================================================================
; ---- DEBUG ----
;===============================================================================
[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Hi mah!     DamageMul = %d     AI = %d     XFactorTimer = %d\nXdist = %f     RS = %d"     ;  vel x = %f"
params = var(10),var(15),var(21),p2dist x,RoundState;,vel x

;================================================================================
; ------- Jump stuff --------
;===============================================================================
[State 50, reset]
type = VarSet
trigger1 = stateno != [40,50]
var(2) = 0

;================================================================================
; ------- BASIC SOUNDS --------
;===============================================================================
[State 0, StopSnd]
type = StopSnd
trigger1 = Time = 1
trigger1 = PrevStateNo = 101
;trigger2 = MoveType = H
;trigger2 = GameTime%20 = 0
;trigger2 = StateNo = [5000,5999]
channel = 1

[State 0, Getting Up Sound]
type = PlaySnd
triggerall = AnimElem = 2, 1
triggerall = RoundState = 2
triggerall = PrevStateNo != 191
trigger1 = StateNo = 5120
value = S13,random%11
channel = 0

[State -3, Pain Sound]
type = PlaySnd
triggerall = Time = 1
;triggerall = gethitvar(animtype) = 5
triggerall = random < 350
triggerall = Life > 0
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
value = S14, random%8
channel = 3

[State -3, Trip Sound]
type = PlaySnd
triggerall = Time = 1
;triggerall = gethitvar(animtype) = 5
;triggerall = random < 350
triggerall = Life > 0
trigger1 = stateno = 5070
value = S14, 10
channel = 3

;================================================================================
; ------- No Air Guard --------
;===============================================================================
[State -2, AirGuard]
type = AssertSpecial
trigger1 = 1
flag = NoAirGuard
IgnoreHitPause = 1

;================================================================================
; ---- Afterimage Remove
;===============================================================================
[State -2, Afterimage Remover]
type = AfterImageTime
triggerall = !var(20)
trigger1 = MoveType = H
;trigger2 = StateNo = [0,40]
;trigger3 = StateNo = [52,109]
;trigger4 = (StateNo = [200,749]) && PrevstateNo != 50
;trigger5 = Stateno = [5000,5999]
time = 0

;================================================================================
; ------- NotHitBy fix by Caddie --------
;===============================================================================
[State -2, hitby]
type = hitby
trigger1 = life > 0
trigger1 = stateno = 5100 || stateno = 5110 || stateno = 5120
trigger1 = anim != 5120
value = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
time = 1

