;=================================================;
;Vars Used
;Var   2  = Jump Shit
;Var   5  = Temp (Special Variant, etc)
;Var   6  = Temp (Project Type)
;Var   7  = Harassed EX Victim ID
;Var   10 = HitDef Multiplier
;Var   15 = AI Check
;Var   20 = X-Factor Check
;Var   21 = X-Factor Timer
;Var   22 = X-Factor Available
;Var   30 = Damage Mul - Low Basic
;Var   31 = Damage Mul - Med Basic
;Var   32 = Damage Mul - Hvy Basic
;Var   33 = Damage Mul - Special
;Var   34 = Damage Mul - Hyper


;---------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0

[State 0, 1]
type = ChangeAnim
triggerall = Var(20) = 0
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = Var(20) = 1
trigger1 = Anim != 20000 && Anim != 20005
trigger2 = Anim = 20005 && AnimTime = 0 ;Turn anim over
value = 20000

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
triggerall = fvar(6) = 0 ;Cornerpush is over. :)
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
trigger3 = Time = 0
x = 0

[State 0, SelfState]
type = SelfState
triggerall = RoundState != 1
trigger1 = PrevStateNo = [19405,19407]
value = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050 + 100*((Anim = 5120) || (Anim = 5150))

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10+(var(20)*20000)

[State 10, 1]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 0, StopSnd]
type = StopSnd
trigger1 = Time = 0
trigger1 = PrevStateNo = [100,102]
channel = 1

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11+(var(20)*20000)
sprpriority = 0

[State 10, 1]
type = AssertSpecial
trigger1 = Time = 0
trigger1 = Anim = 10
flag = NoAutoTurn

[State 11, 1] ;Change from turning animation
type = ChangeAnim
triggerall = !var(20)
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 1] ;Change from turning animation
type = ChangeAnim
triggerall = var(20)
trigger1 = Anim = 20006 && AnimTime = 0
value = 20011

[State 11, 1] ;Change from turning animation
type = ChangeAnim
triggerall = var(20)
trigger1 = Anim = 6
value = 20006

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12+(var(20)*20000)

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)+(Var(20)*1.5)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)-(Var(20)*1.25)

[State 20, 3]
type = ChangeAnim
triggerall = !var(20)
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 3]
type = ChangeAnim
triggerall = var(20)
triggerall = vel x > 0
trigger1 = Anim != 20020 && Anim != 20005 && Anim != 5
trigger2 = Anim = 20005 && AnimTime = 0
value = 20020

[State 20, 4]
type = ChangeAnim
triggerall = !var(20)
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, 4]
type = ChangeAnim
triggerall = var(20)
triggerall = vel x < 0
trigger1 = Anim != 20021 && Anim != 20005 && Anim != 5
trigger2 = Anim = 20005 && AnimTime = 0
value = 20021

[State 0, 1]
type = ChangeAnim
triggerall = var(20)
trigger1 = Anim = 5
value = 20005

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type = S
physics = S
ctrl = 0
velset = 0,0
facep2 = 1
sprpriority = 1

[State 100, Kino]
type = VarSet
trigger1 = !time
var(4) = 0
[State 100, Karin]
type = VarSet
trigger1 = command = "x"
var(4) = 1
[State 100, Karin]
type = VarSet
trigger1 = command = "y"
var(4) = 2
[State 100, Karin]
type = VarSet
trigger1 = command = "z"
var(4) = 3
[State 100, Karin]
type = VarSet
trigger1 = command = "a"
var(4) = 4
[State 100, Karin]
type = VarSet
trigger1 = command = "b"
var(4) = 5
[State 100, Karin]
type = VarSet
trigger1 = command = "c"
var(4) = 6

[State 40, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = 40+(var(20)*20000)

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 1]
type = VarSet
triggerall = sysvar(1)
trigger1 = command = "hijump" && command != "chargedhijump"
trigger2 = PrevStateNo = 101 && sysvar(1) = 1
var(2) = 1
[State 40, 1]
type = VarSet
trigger1 = PrevStateNo = 101 && sysvar(1) = -1
var(2) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(3) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(3) = 2

[State 40, 6]
type = VelSet
triggerall = !var(2)
trigger1 = AnimTime = 0
trigger2 = var(4) && time > 0
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)+(Var(20)*1.2), const(velocity.jump.back.x)-Var(20)))
[State 40, 7]
type = VelSet
triggerall = var(2)
trigger1 = AnimTime = 0
trigger2 = var(4) && time > 0
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
[State 40, 8]
type = VelSet
trigger1 = AnimTime = 0
trigger2 = var(4) && time > 0
y = ifelse (var(3), -6.65625, const(velocity.jump.y))

[State 40, PlaySnd]
type = PlaySnd
trigger1 = !animtime
trigger2 = var(4) && time > 0
value = S20,0

;--------------------------[APPROPIATE ATTACK STATE]----------------------------
[State -1, A L P]
type = ChangeState
value = 600
trigger1 = var(4) = 1 && time > 0
[State -1, A M P]
type = ChangeState
value = 610
trigger1 = var(4) = 2 && time > 0
[State -1, A H P]
type = ChangeState
value = 620
trigger1 = var(4) = 3 && time > 0
[State -1, A L K]
type = ChangeState
value = 700
trigger1 = var(4) = 4 && time > 0
[State -1, A M K]
type = ChangeState
value = 710
trigger1 = var(4) = 5 && time > 0
[State -1, A H K]
type = ChangeState
value = 720
trigger1 = var(4) = 5 && time > 0
;-------------------------------------------------------------------------------

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0 && command = "holdup"
value = 50
ctrl = 1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0 && Var(3) = 2
value = 41
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type = A
physics = N

[State 810, 1]
type = AfterImage
triggerall = !var(20)
trigger1 = !time && var(2) && sysvar(1)
time = 40
length = 4
framegap = 1
timegap = 4
trans = add1
palcontrast = 128,128,128
paladd = 0,0,0
palmul = 1,1,1

;[State 810, 1]
;type = AfterImage
;triggerall = var(31)
;trigger1 = !time && var(2) && sysvar(1)
;time = 10
;length = 9
;framegap = 3
;palcontrast = 256,256,256
;paladd = 0,0,0
;palmul = 1,1,1

[State 50, 1]
type = VarSet
trigger1 = Time = 1
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41+(var(20)*20000), ifelse((vel x)>0, 42+(var(20)*20000), 43+(var(20)*20000)))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, VelAdd]
type = VelAdd
trigger1 = time > 0
y = const(movement.yaccel)

[State 40, 6]
type = ChangeState
trigger1 = Vel Y + Pos Y >= 0
value = 52
ctrl = 1

;---------------------------------------------------------------------------
; Short Jump
[Statedef 41]
type = A
physics = N

[State 1101, pos]
type = VelAdd
trigger1 = time > 0
y = const(movement.yaccel)

[State 810, 1]
type = AfterImage
triggerall = !var(31)
trigger1 = !time && var(2) && sysvar(1)
time = -1
length = 4
framegap = 1
timegap = 6
trans = add1
palcontrast = 128,128,128
paladd = 0,0,0
palmul = 1,1,1

[State 810, 1]
type = AfterImage
triggerall = var(31)
trigger1 = !time && var(2) && sysvar(1)
time = 10
length = 9
framegap = 3
palcontrast = 256,256,256
paladd = 0,0,0
palmul = 1,1,1

[State 50, 1]
type = VarSet
trigger1 = Time = 1
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 51+(var(20)*20000), ifelse((vel x)>0, 52+(var(20)*20000), 53+(var(20)*20000)))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 40, 6]
type = ChangeState
trigger1 = Vel Y + Pos Y >= 0
value = 52
ctrl = 1

