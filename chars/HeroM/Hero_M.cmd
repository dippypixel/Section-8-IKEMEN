;Taunt
[State -1, Taunt]
type = ChangeState
value = 195
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "start" && Var(15) = 0

;---------------------------------------------------------------------------
;Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = statetype = S
triggerall = ctrl
trigger1 = command = "FF" && Var(15) = 0
trigger2 = P2BodyDist X < 152 && Enemy,StateNo < 5080 && P2MoveType != H && P2StateType != L
trigger2 = Var(15) && (Var(15)**3)*2*0.5 > random && RoundState = 2
trigger2 = (StateNo != [52,105]) && PrevStateNo != 52
trigger3 = P2BodyDist X >= 152
trigger3 = Var(15) && (Var(15)**3)*2*0.7 > random && RoundState = 2

