;-------------------------------------------------------------------------
;Zander's Mugen Remastered Character Template
;made by Alexander Cooper 19 for easier time porting new characters over
;Hitspark Effects by Viola
;-------------------------------------------------------------------------
[Info]
name         = "Totino_ZMR"                ;the name referred to in debug mode
displayname  = "Totino Jeno"               ;the name displayed in game
versiondate  = 07,29,2025                  ;date the template was created
mugenversion = 1.1                         ;self explainatory. DON'T CHANGE OR CHARACTER WILL BREAK.
author       = "Alexander Cooper 19"       ;Author Name
pal.defaults = 1,2,3,4,5,6                 ;a list of palette defaults
;-------------------------------------------------------------------------
[Files]
sprite       = Code/TotinoZMR.sff          ;Contains Sprites and Effects
anim         = Code/TotinoZMR.air          ;Contains all Animations
sound        = Code/TotinoZMR.snd          ;Includes all SFX/Voice Clips
cmd          = Code/TotinoZMR.cmd          ;Contains the characters command list
movelist     = Code/Movelist.dat           ;Generates a command list using text from this file for IKEMEN Go Pause Menu.
cns          = Code/CNS/TotinoZMR.cns      ;Contains Code
stcommon     = Code/CNS/common1_ZMR.cns    ;Universal Common1 file for Zander's Mugen Remastered
st           = Code/CNS/TotinoZMR.cns      ;Contains Code
st1          = Code/CNS/Normals.cns        ;Contains Code
st2          = Code/CNS/Specials.cns       ;Contains Code
st3          = Code/CNS/Supers.cns         ;Contains Code
st4          = TagTeamZMR.cns              ;Tag Team Coding (keep it enabled, it doesn't intefere with mugen builds outside ZMR.)
;-------------------------------------------------------------------------
;Palette Colors
pal1         = Palettes/Palette1.act   ;Normal Pizza Rolls
pal2         = Palettes/Palette2.act   ;Cheddar Blasted Crust
pal3         = Palettes/Palette3.act   ;Frozen Crust
pal4         = Palettes/Palette4.act   ;Ranch Blasted Crust
pal5         = Palettes/Palette5.act   ;Hellfire Pizza Roll
pal6         = Palettes/Palette6.act   ;Burnt Pizza Roll
pal7         = Palettes/Palette7.act   ;...Dad?
pal8         = Palettes/Palette8.act   ;Golden Brown Pizza Roll
pal9         = Palettes/Palette9.act   ;Supreme Pizza Rolls
pal10        = Palettes/Palette10.act  ;Purple Bag Pepperoni
pal11        = Palettes/Palette11.act  ;Aqua Marine
pal12        = Palettes/Palette12.act  ;Moldy and Rotten
