;Palette Colors (Ikemen Go)
pal13        = Palettes/Palette13_IkemenGo.act  ;Inverted Crust
pal14        = Palettes/Palette14_IkemenGo.act  ;Bravo, you fucked up!
pal15        = Palettes/Palette15_IkemenGo.act  ;Lime Crust
pal16        = Palettes/Palette16_IkemenGo.act  ;Midnight Crust
pal17        = Palettes/Palette17_IkemenGo.act  ;Crystal Crust
pal18        = Palettes/Palette18_IkemenGo.act  ;Blue Balls Jr
pal19        = Palettes/Palette19_IkemenGo.act  ;Dorito Crust
pal20        = Palettes/Palette20_IkemenGo.act  ;Cosmic Crust
pal21        = Palettes/Palette21_IkemenGo.act  ;Sunset Crust
pal22        = Palettes/Palette22_IkemenGo.act  ;Mayonnaise Crust
pal23        = Palettes/Palette23_IkemenGo.act  ;Nacho Cheese
pal24        = Palettes/Palette24_IkemenGo.act  ;Crimson Crust
pal25        = Palettes/Palette25_IkemenGo.act  ;On Fire!
;-------------------------------------------------------------------------
[Palette Keymap] 
x 	= 1
y	= 2
z	= 3
a 	= 4 ;Default would be pressing "X" instead of "A" to keep consistent with universal controls.
b	= 5
c 	= 6
x2	= 7
y2	= 8
z2	= 9
a2	= 10
b2	= 11
c2	= 12
