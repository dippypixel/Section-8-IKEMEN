ignorehitpause = 1

;;Projhit or guarded if you needed
;[State HitSpark FX Proj]
;type = Helper
;triggerall=playeridexist(var(44))
;trigger1 = projhit=1 ;projhitXXXX=1
;helpertype = Normal
;name = "HitSpark"
;ID = 823000
