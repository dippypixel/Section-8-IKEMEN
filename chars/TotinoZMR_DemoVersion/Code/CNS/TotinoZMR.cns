;--------------------------------------------------------------------------------------
;Corndog Orbs

;in ZMR by landing counter attacks you can obtain Corndog Orbs, special orbs that help
;you out in battle as little strikers for your characters that can give combo extensions.
;1 counter gives you an orb, when it maxes out at 3 orbs is when you can unleash one.

[State -3, Corndog Orb Meter]
type = Helper
triggerall = var(49)=0
triggerall = fvar(8)!=-1 ;turn off if it detects Time Attack (aka. Blitz Mode) via ZSS.
;-------------------------------------------------
;Disabled for Bosses && Hyper KO's
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
triggerall = !numhelper(9980)
triggerall = var(21) = 1 ;detects if the opponent is a ZMR character before activating the helper.
;-------------------------------------------------
triggerall = !numhelper(9999)
triggerall = !NumHelper(8400)
trigger1 = !var(59) && teammode = single                      ;activates on single only for player
trigger2 = var(59) && teammode = single                       ;activates on single only for CPU
trigger3 = var(59) && teammode = turns && numpartner!=1       ;activates on endless only for CPU if they are not in tag team.
trigger3 = enemynear,var(59)!=0 && teammode != turns          ;checks if the other player CPU in turns is fighting is CPU in turns, if requirements are meant meter gets turned off.
helpertype = normal
name = "Corndog Orb Meter"
ID = 8400
stateno = 8400
pos = 0, 250
postype = back
facing = facing * ifelse(teamside = 1, 1, -1)
keyctrl = 0
ownpal = 1
supermovetime=999999
pausemovetime=999999
size.xscale = 0.5
size.yscale = 0.5
ignorehitpause = 1

[State Training Mode Detected (For Orbs)] ;credits to Brergrsart for code in Statedef 0.
type = varset
triggerall = !var(59) ;for player only
triggerall = teammode = single && roundno = 1
triggerall = power = const(data.power)
triggerall = numhelper(50783)
trigger1 = !numhelper(840000)
fvar(8) = 3
ignorehitpause = 1
persistent = 1

[State Other Modes Detected] ;sets to 3 on modes that don't use orbs to fix some issues.
type = varset
triggerall = !var(59) ;for player only
triggerall = roundstate = 2 && roundno = 1
trigger1 = teammode = simul
trigger2 = teammode = turns
trigger3 = var(49) ;tag detector
fvar(8) = 3
ignorehitpause = 1
persistent = 1

;[State Guard Crush] ;left unused, might use it in the future for certain unblockables.
;type = ChangeState
;triggerall = var(21) = 1
;triggerall = FVar(8) <= 0 && StateNo != 5350
;trigger1 = StateNo = 150
;trigger2 = StateNo = 152
;value = 5350
;ctrl = 0

;===========================================================================
;AI

;used vars
;
;v59=Activation
;v58=StateNo
;v57=Total Enemy,NumProj before round starts
;v52=Jump type
;v51=enemy,id
;v50=AILevel
;

[State AI Activation]
Type                                                                                                                                                                                                                                                           =Null
Type=DisplayToClipBoard
triggerall=!ishelper
Trigger1=!var(59)
Trigger1=Var(59):=1                                                                                                                                                                                                                                            -1+AILevel&&0
Text="`SX-~DRE-AM~|-9H/>PYEUX+A$PYSX-~SUM-MER~--XX4PZ!j$)J$aTX-~AIR-Key~-+U=/P\\%c%%%%950d4CA"
Params=195
IgnoreHitPause=1

[state AILevel]
type=varset
trigger1=var(59)
var(50)=ifelse(var(50)<1,1,ifelse(var(50)>8,8,var(50)))
ignorehitpause=1
[state AILevel]
type                                                                                                                                                                                                                                                           =varset
type=null
trigger1=1;var(59)
var(50)=AILevel
ignorehitpause=1

[state Enemy,ID]
type=varset
trigger1=numenemy=1
var(51)=enemy,id
ignorehitpause=1

[state Enemy,ID]
type=varset
trigger1=numenemy>1
var(51)=ifelse(enemynear(0),alive,enemynear(0),id,enemynear(1),id)
ignorehitpause=1

[state Enemy,NumProj]
type=varset
triggerall=roundstate<2
trigger1=numenemy=1
var(57)=playerid(var(51)),numproj
ignorehitpause=1
[state Enemy,NumProj]
type=varset
triggerall=roundstate<2
trigger1=numenemy>1
var(57)=enemy(0),numproj+enemy(1),numproj
ignorehitpause=1

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = var(59)
text = "p2x:%d,p2y:%d,prev:%d,jumptype:%d,sj:%d"
params = floor(p2bodydist x),floor(p2bodydist y),var(50),var(52),var(35)
ignorehitpause = 1

[state Recover]
type=selfstate
triggerall=var(59)&&alive&&roundstate=2
triggerall=stateno=5050
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = CanRecover
trigger1 = random<=100+var(50)*80
value = 5200
[state Recover]
type=selfstate
triggerall=var(59)&&alive&&roundstate=2
triggerall=stateno=5050
triggerall = Vel Y > -1
triggerall = CanRecover
trigger1 = random<=100+var(50)*80
value = 5210

[state Corndog Orbs]
type=changestate
triggerall = NumHelper(8400)
triggerall = var(59)
triggerall=teammode=single
triggerall = fvar(8)!=-1
triggerall=alive&&roundstate=2&&ctrl&&statetype!=a
triggerall=var(50)>1
triggerall=var(57)<=0
triggerall=floor(fvar(8))>=3
triggerall=(p2bodydist x=[-20,120])&&p2bodydist y>=-20-(playerid(var(51)),vel y>=-1.5)*30
trigger1=!inguarddist
trigger1=p2bodydist x>=10
trigger1=playerid(var(51)),stateno=5120&&var(50)>=7
trigger1=random<(var(50)-6)*300
trigger2=playerid(var(51)),movetype=a||(playerid(var(51)),movetype=h&&playerid(var(51)),statetype!=l)
trigger2=random<((var(50)-5)*70)*ifelse(playerid(var(51)),facing=facing,1.5,1)
trigger3=(playerid(var(51)),statetype!=l&&var(50)>=4)||var(50)<4
trigger3=random<(var(50)-1)*20
trigger4=movecontact=1
trigger4=random<(var(50)-1)*30
trigger4=stateno=[200,410]
trigger5=random<(var(50)-1)*20
trigger5=power>=1000
trigger5=stateno=[150,153]
value=19500

[state Counter(Lv4 to Lv5)]
type=changestate
triggerall=var(59)&&alive&&roundstate=2
triggeralL=inguarddist||playerid(var(51)),movetype=a
triggerall=var(50)=[4,5]
triggerall=statetype!=a
triggerall=ctrl||stateno=20||stateno=100
triggerall=p2bodydist x=[-20,70]
triggerall=random<=(var(50)-3)*100
;Throw or Light normal
trigger1=p2bodydist x<=30
trigger1=random<=var(50)*30
trigger1=1||var(58):=ifelse(p2bodydist x<=15&&random<=300,800,ifelse(p2bodydist y<=-10,200,400))
;
;Any normal
trigger2=facing=playerid(var(51)),facing
trigger2=playerid(var(51)),numproj<=var(57)
trigger2=p2bodydist x<=50
trigger2=1||var(58):=ifelse(power>=500,420,ifelse(p2bodydist x<=20,ifelse(random<=var(50)*50&&playerid(var(51)),statetype!=a&&playerid(var(51)),movetype!=h,800,400-(p2bodydist y<=-10)*200),410-(p2bodydist y<=-10)*200))
;
trigger3=1||var(58):=ifelse(random<=400,1012,1002)
value=var(58)

[state Counter(Lv6 or higher)]
type=changestate
triggerall=var(59)&&alive&&roundstate=2
triggeralL=inguarddist||playerid(var(51)),movetype=a
triggerall=var(50)>=6
triggerall=statetype!=a
triggerall=ctrl||stateno=20||stateno=100
triggerall=p2bodydist x=[-20,70]
triggerall=random<=(50-(facing=playerid(var(51)),facing)*30)+(var(50)-5)*164
;
;Triple Palm
trigger1=power>=1000
trigger1=p2bodydist x<=80&&p2bodydist y>=-30
trigger1=random<=var(50)*30
trigger1=1||var(58):=ifelse(p2bodydist x<=60&&random<=400&&p2bodydist y>=-10,ifelse(p2bodydist y>=0&&random%3=0&&facing=playerid(var(51)),facing,3200,3000),3100)
;
;Throw or Light normal
trigger2=p2bodydist x<=20
trigger2=random<=var(50)*30
trigger2=1||var(58):=ifelse(p2bodydist x<=15&&random<=300,800,ifelse(p2bodydist y<=-10,200,400))
;
;Oraora
trigger3=facing=playerid(var(51)),facing
trigger3=playerid(var(51)),numproj<=var(57)
trigger3=p2bodydist x<=50
trigger3=random<=var(50)*30||p2bodydist x>40
trigger3=1||var(58):=1000
;
;Any normal
trigger4=facing=playerid(var(51)),facing
trigger4=playerid(var(51)),numproj<=var(57)
trigger4=p2bodydist x<=40
trigger4=1||var(58):=ifelse(power>=500,420,ifelse(p2bodydist x<=20,ifelse(random<=var(50)*50&&playerid(var(51)),statetype!=a&&playerid(var(51)),movetype!=h,800,400-(p2bodydist y<=-10)*200),410-(p2bodydist y<=-10)*200))
;
;Knee
trigger5=p2bodydist y>=-100&&p2bodydist y<=-20
trigger5=playerid(var(51)),statetype=a
trigger5=1||var(58):=1001
;
;Palm
trigger6=1||var(58):=ifelse(p2bodydist x>=60,1002,1000)
value=var(58)

[state Backward]
type=changestate
triggerall=var(59)&&alive&&roundstate=2
triggeralL=inguarddist||playerid(var(51)),movetype=a
triggerall=var(50)>=4;[4,8]
triggerall=statetype!=a
triggerall=ctrl||stateno=20||stateno=100
