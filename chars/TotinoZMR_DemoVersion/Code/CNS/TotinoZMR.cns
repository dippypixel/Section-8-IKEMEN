;==================================================================
;Announcer 

;Both of these track if you land a hit first or counter an opponents attack
;with your own moves, if requirements are meant they will show up where hitsparks
;are.

;unsure on who made these codes, but credit goes to them. thank you

[State -2, Counter FX]
type = Helper
triggerall = stateno != [900000,930000]
triggerall = numhelper(8290)=0
triggerall = var(10)!=1
triggerall = enemynear,stateno = [5000,5999]
triggerall = NumEnemy && var(7)
triggerall = enemynear,statetype != A
triggerall = !(HitDefAttr = SCA, AT) && (EnemyNear, MoveReversed != 1)
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
trigger1 = MoveHit = 1
helperType = Normal
stateNo = 8290
ID = 8290
name = "Counter FX"
postype = P1
pos = 0,0
ownPal = 1
sprpriority = 9999
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1

[State -2, Counter FX Anti-Air Version] ;This Code Co-Exists with the original code to be able to detect Anti-Airs, as normal helper isn't able to.
type = Helper
triggerall = stateno != [900000,930000]
triggerall = numhelper(8290)=0
triggerall = var(10)!=1
triggerall = NumEnemy && var(7)
triggerall = enemynear,statetype = A
triggerall = enemynear,stateno = [5000,5999]
;triggerall = statetype != A
triggerall = !(HitDefAttr = SCA, AT) && (EnemyNear, MoveReversed != 1)
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
trigger1 = MoveHit = 1
helperType = Normal
stateNo = 8290
ID = 8290
name = "Counter FX"
postype = P1
pos = 0,0
ownPal = 1
sprpriority = 9999
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1

;these variables do all the tracking for the First Attack and Counter helpers
[State -2, Counter Flag]
type = VarSet
trigger1 = NumEnemy
var(7) = (EnemyNear, MoveType = A)
ignoreHitPause = 1

[State -2, Air-To-Air Counter Tracker] ;This is for fixing the weird bugs with counter text during Air-To-Airs hopefully. 
type = VarSet
triggerall = numenemy
triggerall = enemynear,statetype = A
triggerall = enemynear,movetype = A
trigger1 = stateno != 160
var(10) = ifelse(movetype=H,0,1)
ignoreHitPause = 1

[State Turn On White Parry] ;this checks to see if you are guarding or not so that parry can change its visuals to White Parry
type = Varset
triggerall = !var(59)
triggerall = stateno != 160
trigger1 = (stateno = [15000,15300])
var(22) = 1
ignorehitpause = 1

[State Turn Off White Parry] ;this checks to see if you are guarding or not so that parry can change its visuals to White Parry
type = Varset
triggerall = !var(59)
triggerall = stateno != 160
trigger1 = (stateno != [15000,15300])
var(22) = 0
ignorehitpause = 1

[State Turn On White Parry (CPU)] ;this checks to see if you are guarding or not so that parry can change its visuals to White Parry
type = Varset
triggerall = var(59)
triggerall = stateno != 160
trigger1 = (stateno = [150,153])
var(22) = 1
ignorehitpause = 1

[State Turn Off White Parry (CPU)] ;this checks to see if you are guarding or not so that parry can change its visuals to White Parry
type = Varset
triggerall = var(59)
triggerall = stateno != 160
trigger1 = (stateno != [150,153])
var(22) = 0
ignorehitpause = 1

[State ZMR Debug Info (Player)] ;Both Clipboards are for tracking certain variables in the Debug Menu, accessed by pressing Ctrl+D on your keyboard.
type = DisplayToClipboard
trigger1 = !var(59)
text = "- Air Counter: %d | Aerial Rave: %d | Sucking Ass: %d | Inside ZMR?: %d"
params = var(10),Var(4),var(6),var(21)

[State ZMR Debug Info (Player)]
type = AppendToClipboard
trigger1 = !var(59)
text = "| Enemy Pos X: %d | Enemy Pos Y: %d"
params = p2bodydist x,p2bodydist y

[State -2, First Attack FX] ;checks if you land an attack on opponent at the start of the match, when activated will only appear once until the next round.
type = Helper
triggerall = roundno = 1
triggerall = stateno != [900000,930000]
triggerall = var(48)=0 ;tagged in
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
triggerall=!ishelper
triggerall = roundstate = 2
triggerall = var(6) = 0
triggerall = numhelper(8291)=0
triggerall = enemynear,life = enemynear,lifemax
trigger1 = enemynear,stateno = [5000,5300]
helperType = Normal
stateNo = 8291
ID = 8291
name = "First Attack FX"
postype = P1
pos = 0,0
ownPal = 1
sprpriority = 9999
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1
persistent = 0

;If you successfully preform an Aerial Rave
;the game checks to see if you have successfully did one. when
;you do it displays the message.
[State -2, Aerial Rave FX]
type = Helper
triggerall = numenemy
triggerall = var(48)=0 ;tagged out detector
triggerall = movetype = A
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
trigger1 = enemy,stateno = 51001 && enemy,time = 1
helperType = Normal
stateNo = 8292
ID = 8292
name = "Aerial Rave FX"
postype = P1
pos = 0,0
ownPal = 1
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1

[State -2, Parry Tracker] ;for announcer messages acting weird after a move is parried and countered with an air normal
type = VarSet
triggerall = stateno != 160
trigger1 = stateno != [600,630]
var(10) = 0
ignoreHitPause = 1

[State Life Tracker] ;tracks your health for perfects. if you lose any health it gets set to 1
type = VarSet
trigger1 = life != lifemax
var(6) = 1   

;This trigger controls the announcers KO, You Win and Hyper Combo Finish states
;in ZMR, the announcer gets more control over the game depending on what state 
;you're in. more information is in statedef 9980-9982 located in Common1_ZMR.cns
[State Roundstate 3 KO/Hyper Combo Finish]
type = Helper
triggerall = var(48) = 0
triggerall = stateno != [900000,930000]
triggerall=!ishelper
triggerall = winko && roundstate = 3 && alive
trigger1 = NumHelper(9980)=0
name = "Announcer"
ID = 9980
StateNo = 9980
ignorehitpause = 1
persistent = 0
ownpal = 1
supermovetime = 65
pausemovetime = 65

;=================================================
;Codes for Launcher to ignore juggle points during aerial raves.
;that and air guard isn't a thing in ZMR to make parries more valuable
;3rd code is to make sure opponents don't get hit before roundstate 2

[State Launcher Detector] ;if detected doesn't count juggle points during aerial rave
type = AssertSpecial
trigger1 = var(4)=1
flag = nojugglecheck
ignorehitpause =1

[State NO AIR GUARD] ;it stinks and sucks lol
type = AssertSpecial
trigger1 = 1
flag = noairguard
ignorehitpause=1

[State NO GUARD FOR TAG MEMBERS] ;to fix any potentional issues with tag team assist
type = AssertSpecial
triggerall = var(49)=1 ;tag team detector
trigger1 = var(48)=1 ;tagged out detector
flag = noairguard
flag2 = nostandguard
flag3 = nocrouchguard
ignorehitpause=1

[State Immune to all Strikes outside roundstate 2] ;self explainatory
type = NotHitBy
triggerall = GameTime && stateno !=[5000,5999]
trigger1 = !ctrl && RoundState != 2 
trigger2 = !Alive
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1

[State Tag Team Infinite Prevention]
type = Nothitby
triggerall = var(49)=1
trigger1 = !alive && roundstate = 2
value = SCA
ignorehitpause = 1

[State Immune to Strikes when Boss is defeated] ;self explainatory
type = NotHitBy
triggerall = alive && roundstate = 2
trigger1 = enemynear,name="CorndogOfLightV2"
trigger1 = enemynear,stateno = 6969 ;&& enemynear,movetype = H
trigger2 = enemynear,name="PizzaRollOfDarknessV2" 
trigger2 = enemynear,stateno = 555000 ;&& enemynear,movetype = H
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1
