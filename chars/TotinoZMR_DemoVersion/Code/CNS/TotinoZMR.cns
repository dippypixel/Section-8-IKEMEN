;---------------------- Integer variable list ----------------------

;ZM Universal Variables (KEEP THESE WHEN DESIGNING CHARACTER FOR ZMR.)
;Var(0) - KO Messages / Hyper Combo Finish
;Var(1) - Pause Menu Detector
;Var(2) - Pause Menu Cursor
;Var(3) - Universal Damage Dampener
;Var(4) - Launcher Detector
;Var(5) - Command List Cursor
;Var(6) - Health Tracker (For First Attack Text)
;Var(7) - Counter Tracker (For Counter Text
;Var(8) - Throw Facing
;Var(9) - Projectile Type
;Var(10) - Air Parry Punish Tracker
;Var(21) - Character Detector
;Var(22) - White Parry Checker

;Hitspark Variables
;var(40)=HitPauseTime
;var(41)=Spark X
;var(42)=Spark Y
;var(43)=Spark Type(-1 or lower=Guard FX,0 or higher=Hit FX)
;var(44)=Enemy,ID

;Channels
;Channel 0 - Voice
;Channel 1 - Announcer
;Channels 2 to 4 - Intro


;--------------------------------------------------------
;Stats
;--------------------------------------------------------
[Data]
life = 1050            ;Amount of life to start with
attack = 100           ;attack power (more is stronger)
defence = 100          ;defensive power (more is stronger)
power = 1000           ;for hypers, launcher and etc. (1000 by default)
fall.defence_up = 0    ;Unused in ZMR. Percentage to increase defense everytime player is knocked down
liedown.time = 60      ;this is left unused for ZMR, as it uses its own system to keep track of liedown time which is 60 ticks for all characters, the same as here. 
airjuggle = 12         ;Number of points for juggling
sparkno = s823100      ;Default hit spark number for HitDefs
guard.sparkno = s823600;Default guard spark number
KO.echo = 0            ;Always Unused. don't bother lol
volume = 255           ;Volume offset (negative for softer)
;--------------------------------------------------------
;if numbers for both Indexes are lower than 59, for example
;first ones at 39, the numbers 40-59 won't reset during rounds
;being able to be kepted consistent unaffected by the game.
;same applies to Float Index as well. anything beyond the number
;you put in that isn't 59-60 for Int or 39-40 would keep it 
;persistent between rounds
IntPersistIndex = 39
FloatPersistIndex = 7
;--------------------------------------------------------
[Size]
xscale = .7            ;Horizontal scaling factor.
yscale = .7            ;Vertical scaling factor.
ground.back = 27      ;Player width (back, ground)
ground.front = 27     ;Player width (front, ground)
air.back = 27         ;Player width (back, air)
air.front = 27        ;Player width (front, air)
height = 60           ;Height of player (for opponent to jump over)
attack.dist = 75      ;Default attack distance
proj.attack.dist = 75 ;Default attack distance for projectiles
proj.doscale = 0      ;Set to 1 to scale projectiles too
head.pos = 0, -60    ;Approximate position of head
mid.pos = 0, -40     ;Approximate position of midsection
shadowoffset = 0      ;Number of pixels to vertically offset the shadow
draw.offset = 0,0     ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.5       ;Walk forward
walk.back = -2.5    ;Walk backward
run.fwd  = 4.8, 0     ;Run forward (x, y)
run.back = -4.8,-5.8  ;Hop backward (x, y)
jump.neu = 0,-11.0     ;Neutral jumping velocity (x, y)
jump.back = -2.5    ;Jump back Speed (x, y)
jump.fwd = 2.5      ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4.6,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0       ;Unused
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .75       ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

; Up to 100 victory quotes can be specified per language (victory0 - victory99)
[Quotes]
victory1 = "Why have gender roles... when you can have Pizza Rolls!"
victory2 = "If i just gave you diarrhea, blame it yourself and not me."
victory3 = "pretty weird seeing a Pizza Roll kick your ass huh?"
victory4 = "lets go over to General Mills!"
victory5 = "Call me Rick Astley but you just got Pizza-ROLLED!"
victory6 = "I am like no other Pizza Roll. I am alive and Brave enough to kick someone's ass using packages."
victory7 = "don't EVER bring up PizzaRonis under my presence again! YOU HEAR ME DIPSHIT?!"
victory8 = "thats the way baby, thats how I like it!"
victory9 = "sorry for the trouble, I need to find my Dad..."
victory10 = "I've heard Pete Zaroll was a cool dude, I'd like to meet him one day."
victory11 = "remembered when I used to have no face or arms? didn't miss those times at all cause I couldn't scratch my ass."
victory12 = "hoping they'll come back with some new Totino's favors, something that will make someone really happy."
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0
sprpriority = 0

[State Hand]
type = Explod
trigger1 = Animelem = 2
anim = 171
ID = 171
pos = 0,0
bindtime = -1
postype = P1
scale = const(size.xscale),const(size.yscale)
sprpriority = 1
ownpal = 1
removetime = -1
ignorehitpause = 1
shadow = -1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = S100,33
channel = 0 

[State 0, Offset]
type = Offset
trigger1 = animelemtime(2)>=0
x = -0.5*sin(time*8)*0.7
[state ]
type=angledraw
triggerall=name="Totino_ZMR"
triggerall=2**9!=512
trigger1=animelemtime(2)>=0&&animelemtime(4)<=0
value=0
scale=1,0.8+time*0.007
[state ]
type=angledraw
triggerall=name="Totino_ZMR"
triggerall=2**9=512
trigger1=animelemtime(2)>=0&&animelemtime(4)<=0
value=0
scale=1,0.8+time*0.007
ignorehitpause=1

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191+random%3

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1] ;Win Poses are added here. KFM only has one but you can have as many as you want (3 is preferred in ZMR)
type = ChangeState
trigger1 = Time = 0
value = 181+random%3

