trigger2 = stateno = 5110
trigger3 = stateno = 5111
trigger4 = stateno = 51001
trigger5 = stateno = 51101
anim = 1002
ID = 1002
pos = 0,0
postype = P1
supermovetime = 999999
pausemovetime = 999999
trans=sub
scale = 0.5,0.5
sprpriority = -31
ownpal = 1

[State Knocked Down]
