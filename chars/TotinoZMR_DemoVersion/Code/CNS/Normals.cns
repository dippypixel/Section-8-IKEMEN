;Parry Tracker Counter Fix.
;its REALLY important to keep these in all air normal states otherwise counter text will be broken
[State -2, Counter FX]
type = Helper
triggerall = NumEnemy 
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
triggerall = var(10)=1 ;Var(10) keeps track of Air Parries so that counter text doesn't get bugged.
triggerall = enemynear,movetype=H
triggerall = numhelper(8290)=0
trigger1 = MoveHit = 1
helperType = Normal
stateNo = 8290
ID = 8290
name = "Counter FX"
postype = P1
pos = 0,0
ownPal = 1
sprpriority = 9999
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1
