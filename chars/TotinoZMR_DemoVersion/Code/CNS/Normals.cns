type = HitDef
trigger1 = !time 
attr = C, NA
damage    = 35
animtype  = Heavy
priority = 5, Hit
hitflag = MAF
guardflag = L
pausetime = 12,12
sparkno = -1
guard.sparkno=-1
sparkxy = -10,-55
hitsound   = s1,2
guardsound = s1,8
ground.type = Low
ground.slidetime = 12
ground.hittime  = 15
guard.ctrltime = 15
guard.hittime = 15
ground.velocity = -2,-8
air.velocity = -2,-6
guard.velocity = -6
guard.slidetime = 12
fall = 1
fall.recovertime = 45
ID = 420
NoChainID = 420
getpower = 0
envshake.time = 7
envshake.ampl = -6
envshake.freq = 110

[State EnvColor]
type = EnvColor
trigger1 = movehit
value = 255,255,255
time = 1
under = 1
persistent = 0
ignorehitpause = 1

[State Launcher Setup] ;Important
type = ChangeState
triggerall = movecontact=1 && roundstate = 2
triggerall = power > 499 && var(4)=0
;triggerall = enemynear,gethitvar(hitcount)<=9
trigger1 = command = "LauncherJump"&&(!var(59)||(var(59)&&var(50)=1))
value = 40

