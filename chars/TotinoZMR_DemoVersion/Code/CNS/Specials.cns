;Spark X
trigger1=1||var(41):=0
;
;Spark Y
trigger1=1||var(42):=-80
;
;Spark Type
;
;0=Normal Light
;1=Normal Medium
;2=Normal Hard
;10=Slash Light
;11=Slash Medium
;12=Slash Hard
