
;---------------------------------------------------------------------------
;Mini Spin (L)
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd = 0 ;every character should get the same amount of power for normals. don't change this if you are making a character for ZMR
;velset = 0,0
anim = 1010
ctrl = 0
sprpriority = 2

;----------------------------------------------------
;Air Version
[State 0, StateTypeSet]
type = StateTypeSet
triggerall = pos y < -5
trigger1 = !time
statetype = A              
physics = N        
ignorehitpause = 1

[State 0, ChangeState]
type = ChangeState
triggerall = pos y < -5
trigger1 = !time
value = 1004

[State 0, VelSet]
