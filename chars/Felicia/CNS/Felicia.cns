; Flying Screen Effect (Vs series feature, Hyper Sand Splash Only)
[Statedef 6511]
type = A
physics = N
ctrl = 0
anim = 6510

[State 6511, Screen is owned by FS]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1, 1
ignorehitpause = 1

[State 6511, Flying Screen Sound]
type = PlaySnd
trigger1 = root, ScreenPos X < 0
trigger2 = root, ScreenPos X > 320
value = 0,11
volume = 255
persistent = 0

[state 6510, AR FS Velocity]
type = VelSet
trigger1 = (NumEnemy < 2) && (enemy, stateno = 6401)
trigger2 = (NumEnemy > 1) && ((enemy(0), stateno = 6401) || (enemy(1), stateno = 6401))
x = -30
persistent = 0

[state 6510, AR FS Velocity]
type = VelSet
trigger1 = (NumEnemy < 2) && (enemy, stateno = 6402)
trigger2 = (NumEnemy > 1) && ((enemy(0), stateno = 6402) || (enemy(1), stateno = 6402))
x = -15
persistent = 0

[state 6510, Stop Moving if foe lands]
type = VelSet
trigger1 = (NumEnemy < 2) && (enemy, stateno = 6403)
trigger2 = (NumEnemy > 1) && ((enemy(0), stateno = 6403) || (enemy(1), stateno = 6403))
x = 0
y = 0

[State 6510, Finish!]
type = DestroySelf
trigger1 = (NumEnemy < 2) && (enemy, stateno = 6403)
trigger2 = (NumEnemy > 1) && ((enemy(0), stateno = 6403) || (enemy(1), stateno = 6403))
trigger3 = (NumEnemy < 2) && (enemy, stateno != [6400, 6402])
trigger4 = (NumEnemy > 1) && ((enemy(0), stateno != [6400, 6402]) && (enemy(1), stateno != [6400, 6402]))
trigger5 = Time >= 90

