trigger1 = time = 0
var(20) = (20*(enemy, const(size.height) < 30))

; Bind the foe to the specified positions when Felicia grabs him
[State 823, TargetBind]
type = TargetBind
trigger1 = 1
pos = ifelse(var(21) = 4, -35 + var(20), ifelse(var(21) = 3, -8, ifelse(var(21) = 2, 30 - var(20), ifelse(var(21) = 1, 4, 4)))), ifelse(((var(21) = 4) || (var(21) = 2)), -30, ifelse(var(21) = 3, -70 + var(20), ifelse(var(21) = 1, 0 - var(20), 0)))

