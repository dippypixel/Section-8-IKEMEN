; Homer's Basic Moves
;---------------------------------------------------------------------
; D¥oh!
[Data]
life = 1000 
attack = 100 
defence = 100
power = 4000
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0

[Size]
xscale = 1.0		
yscale = 1.0	
ground.back = 20
ground.front = 14
air.back = 20
air.front = 14
height = 58
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 0,-90
mid.pos = 0,-50
shadowoffset = 2

[Velocity]
walk.fwd  = 2.6
walk.back = -2.2
run.fwd  = 5.4, 0
run.back = -7,-3
jump.neu = 0,-9
jump.back = -2.8
jump.fwd =   2.8
runjump.back = -4.3,-10
runjump.fwd = 4.3,-10
airjump.neu = 0,-8.1 ;0
airjump.back = -2.55 ;0,0
airjump.fwd = 2.5 ;0,0

[Movement]
airjump.num = 1
airjump.height = 35
yaccel = .45
stand.friction = .85
crouch.friction = .82

[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory0 = "D'oh"
victory1 = "To Alcohol..."
victory2 = "Why you little!"
victory3 = "Woohoo!"
victory4 = "I am the champion!"

