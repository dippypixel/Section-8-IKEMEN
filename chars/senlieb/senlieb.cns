trigger2 = !SelfAnimExist(5160 + (anim % 10))
value = 5160+ifelse(var(45),10000,0)

[State 5101, 2] ;Coming hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5101+ifelse(var(45),10000,0),5109+ifelse(var(45),10000,0)]
trigger1 = SelfAnimExist(5160+ifelse(var(45),10000,0) + (anim % 10))
value = 5160+ifelse(var(45),10000,0) + (anim % 10)

[State 5101, 3]
type = HitFallVel
trigger1 = Time = 0

[State 5101, 4]
type = PosSet
trigger1 = Time = 0
y = 20;Const(movement.down.bounce.offset.y)

[State 5101, 5]
type = PosAdd
trigger1 = Time = 0
x = 0;Const(movement.down.bounce.offset.x)

[State 5101, 6] ;Acceleration
