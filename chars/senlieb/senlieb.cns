; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 +ifelse(var(45),10000,0) + (statetype = C) + (statetype = A)*2

[State 120, 2]
