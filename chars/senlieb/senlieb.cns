[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3
ctrl = 0

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = anim != [5888,5889]
triggerall = prevstateno != 6666
triggerall = Time = 0
triggerall = SelfAnimExist(5140+ifelse(var(45),10000,0))
trigger1 = (anim != [5111+ifelse(var(45),10000,0),5119+ifelse(var(45),10000,0)]) && (anim != [5171+ifelse(var(45),10000,0),5179+ifelse(var(45),10000,0)])
trigger2 = !SelfAnimExist(5140+ifelse(var(45),10000,0) + (anim % 10))
value = 5140+ifelse(var(45),10000,0)

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
triggerall = anim != [5888,5889]
triggerall = prevstateno != 6666
trigger1 = Time = 0
trigger1 = (anim = [5111+ifelse(var(45),10000,0),5119+ifelse(var(45),10000,0)]) || (anim = [5171+ifelse(var(45),10000,0),5179+ifelse(var(45),10000,0)])
trigger1 = SelfAnimExist(5140+ifelse(var(45),10000,0) + (anim % 10))
value = 5140+ifelse(var(45),10000,0) + (anim % 10)

[State 5150, 4] ;Match over anim
type = ChangeAnim
persistent = 0
triggerall = anim != [5888,5889]
triggerall = prevstateno != 6666
;trigger1 = Time = 0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
triggerall = anim != [5888,5889]
triggerall = prevstateno != 6666
trigger1 = Time = 0
trigger1 = Anim != [5140+ifelse(var(45),10000,0),5159+ifelse(var(45),10000,0)]
trigger1 = Anim != [5110+ifelse(var(45),10000,0),5119+ifelse(var(45),10000,0)]
value = 5110+ifelse(var(45),10000,0)

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = abs(Vel x) < 4;Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1


