value = ,NA,SA
time = 2
ignorehitpause = 1

[State 200, 1]
type = HitDef
trigger1 = time; = 1
trigger1 = !movecontact
trigger1 = !movereversed
trigger2 = movecontact = 3
trigger3 = movereversed = 3
attr = S, HP
damage = 13+ceil(50 / (hitcount + 1) ), 2
animtype = hard
guardflag = M
hitflag = MAF
pausetime = 8-(parent,var(49)), 8
;guard.pausetime = 0, 0
sparkno = S900
guard.sparkno = S901
sparkxy = 0,0
hitsound = S5, 7
guardsound = S6, 1
