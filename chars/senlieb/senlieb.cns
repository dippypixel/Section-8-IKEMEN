;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State 0, Helper]
type = Helper
triggerall = !ishelper
trigger1 = !numhelper(740)
helpertype = normal
name = "Head"
ID = 740
stateno = 740
pos = const(size.head.pos.x),const(size.head.pos.y)
postype = p1
ownpal = 1
;supermovetime = 65535
;pausemovetime = 65535
ignorehitpause = 1

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noairguard
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = var(23)
trigger1 = statetype != A
var(23) = 0
[State 0, VarSet]
type = VarSet
trigger1 = stateno = 45
trigger1 = prevstateno = 630
var(23) = var(23) | floor(exp(0*ln(2)) + 0.5)

; if you're making a 10ov.st and copied the statedef -2 in it's entirety, uncomment this strcl so e.g. the hitpauses in both mugen versions would be the same
