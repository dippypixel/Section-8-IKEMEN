;---------------------------------------------------------------------------
; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).
;           Also used in jump init state (state 40) for jump attack buffer
; var(6) - superpause check
; var(8) - throw limiter
; var(9)  - Used in kfm.cmd for combo condition (updated every tick)
; var(21) - (movehit = 1) time, checked by the e.g. wallbounces
; var(26) - weapon pickupable?
; var(27) - pistol ammo
; var(28) - current weapon
; var(37) - messages
; 0 - counter
; var(39) - bludsparkid
; var(38) - bludspark y
; 0 - none
; 1 - baseball
; 2 - katana
; 3 - pistol
; var(31) - countah
; vars 40-42 = NJS flags
; NJS's floor(exp(X*ln(2)) + 0.5) values (X for...)
; by the way, it may not be that reccomended to use more than 10 "flags" per var, once i tried a single-var NJS on Jango's Jones Entire moveset, things get a little screwy
; 40.0 - misc. attack
; 40.1 - S.LP
; 40.2 - S.MP
; 40.3 - S.HP
; 40.4 - S.LK
; 40.5 - S.MK
; 40.6 - S.HK
; 40.7 - C.LP
; 40.8 - C.MP
; 40.9 - C.HP
; 41.0 - C.LK
; 41.1 - C.MK
; 41.2 - C.HK
; 41.3 - J.LP
; 41.4 - J.MP
; 41.5 - J.HP
; 41.6 - J.LK
; 41.7 - J.MK
; 41.8 - J.HK
; 42.0 - B.MP
; 42.1 - F.HP
; 42.2 - Meteor
; 42.3 - Quake
; 42.4 - Phoenix
; 42.5 - Fireball
; var(45) - headless?
; var(48) - did the AI use the taunt?
; var(49) - denotes if a 1.0/post1.0 mugen def file is used
; var(50) - used by the AI
; var(51) - used by the AI
; var(55) - AIlevel simpilfer
; var(56) - used by the XOR-ed commands method to detect recent custom states.
; var(57) - the GameTime variable, required by the helper and XOR methods.
; var(58) - the primary AI variable.
; var(12) - used by Vans's cornerpush system
; var(17) - used by the push
; fvar(5) - cornerpush?
; fvar(6) - cornerpush?
; fvar(13) - proration

;---------------------------------------------------------------------------
; KO Voice
[Statedef 179]
type = S
ctrl = 0
anim = 9741
velset = 0,0

; Super Art system select ;

[State 0, PlaySnd]
type = PlaySnd
triggerall = numexplod(4000)
trigger1 = parent,roundsexisted = 0
trigger1 = roundstate = 2
trigger2 = parent,command="start"
value = S0,22
persistent = 0
[State to remove uneeded shit]
type = RemoveExplod
triggerall = numexplod(4000)
trigger1 = parent,roundsexisted = 0
trigger1 = roundstate = 2
trigger2 = parent,command="start"
id = 4000
[State to remove uneeded shit]
type = RemoveExplod
triggerall = numexplod(4010)
trigger1 = parent,roundsexisted = 0
trigger1 = roundstate = 2
trigger2 = parent,command="start"
id = 4010
[State to remove uneeded shit]
type = RemoveExplod
triggerall = numexplod(4020)
trigger1 = parent,var(59) != 0
trigger2 = parent,roundsexisted = 0
trigger2 = roundstate = 2
trigger3 = !numexplod(4000)
id = 4020
[State to remove uneeded shit]
type = RemoveExplod
triggerall = numexplod(4021)
trigger1 = parent,var(59) != 1
trigger2 = parent,roundsexisted = 0
trigger2 = roundstate = 2
trigger3 = !numexplod(4000)
id = 4021
[State to remove uneeded shit]
type = RemoveExplod
triggerall = numexplod(4022)
trigger1 = parent,var(59) != 2
trigger2 = parent,roundsexisted = 0
trigger2 = roundstate = 2
trigger3 = !numexplod(4000)
id = 4022
[State for frame]
type = Explod
trigger1 = parent,roundsexisted = 0
trigger1 = roundstate < 2
;trigger1 = !numexplod(4000)
anim = 4000
id = 4000
pos = ceil(screenpos x),ceil(screenpos y)
postype = left
bindtime = -1
removetime = -1
facing = 1
supermovetime = 65535
pausemovetime = 65535
sprpriority = 70
persistent = 0
[State 0, ParentVarSet]
type = ParentVarSet
triggerall = parent,roundsexisted = 0
triggerall = roundstate < 2
trigger1 = numexplod(4000)
var(59) = random%3
persistent = 0
[State for selection]
type = Explod
trigger1 = parent,roundsexisted = 0
trigger1 = roundstate < 2
trigger1 = !numexplod(4020+(parent,var(59)))
trigger1 = numexplod(4000)
anim = 4020+(parent,var(59))
id = 4020+(parent,var(59))
pos = ceil(screenpos x),ceil(screenpos y)
postype = left
bindtime = -1
removetime = -1
facing = 1
supermovetime = 65535
pausemovetime = 65535
sprpriority = 72
[State for command]
type = Explod
trigger1 = parent,roundsexisted = 0
trigger1 = roundstate < 2
;trigger1 = !numexplod(4000)
anim = ifelse(facing=1,4010,4011)
id = 4010
pos = ceil(screenpos x),ceil(screenpos y)
postype = left
bindtime = -1
removetime = -1
facing = 1
supermovetime = 65535
pausemovetime = 65535
sprpriority = 73
persistent = 0
[State update position]
type = ModifyExplod
trigger1 = numexplod(4000)
id = 4000
pos = ceil(screenpos x),ceil(screenpos y)
postype = left
facing = 1
bindtime = -1
[State update position]
type = ModifyExplod
trigger1 = numexplod(4010)
id = 4010
pos = ceil(screenpos x),ceil(screenpos y)
postype = left
facing = 1
bindtime = -1
[State update position]
type = ModifyExplod
trigger1 = numexplod(4020+(parent,var(59)))
id = 4020+(parent,var(59))
pos = ceil(screenpos x),ceil(screenpos y)
postype = left
facing = 1
bindtime = -1


[State 0, AssertSpecial]
type = AssertSpecial
triggerall = parent,roundsexisted = 0
triggerall = roundstate < 2
triggerall = time = [0,180]
trigger1 = numexplod(4000)
flag = intro

[State 0, PlaySnd]
type = PlaySnd
triggerall = parent,roundsexisted = 0
triggerall = roundstate < 2
triggerall = numexplod(4000)
trigger1 = parent,command = "tapu" || parent,command="tapd"
value = S0,44
[State 0, ParentVarSet]
type = ParentVarSet
triggerall = parent,roundsexisted = 0
triggerall = roundstate < 2
triggerall = numexplod(4000)
trigger1 = parent,command = "tapu"
var(59) = ifelse((parent,var(59))-1<0,2,(parent,var(59))-1)
[State 0, ParentVarSet]
type = ParentVarSet
triggerall = parent,roundsexisted = 0
triggerall = roundstate < 2
triggerall = numexplod(4000)
trigger1 = parent,command = "tapd"
var(59) = ifelse((parent,var(59))+1>2,0,(parent,var(59))+1)

