sysvar(0) = 0
ignorehitpause = 1

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse(statetype=C,5020,ifelse((GetHitVar(groundtype) = 1),5000,5010)) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = 1
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

[State 0, Offset]
type = Offset
trigger1 = 1
x = (-6+((time%4)*3)) * facing
y = 0
ignorehitpause = 1

[State 5000, 6]
type = SelfState
trigger1 = time >= 14
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = ifelse(statetype=C,5011,5001) ;Stand get-hit (knocked back)

[State 5000, 7]
type = SelfState
trigger1 = time >= 14
value = 5030


