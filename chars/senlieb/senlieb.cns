trigger1 = time = 0
trigger1 = prevstateno = 743
x = -1
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(0) = ifelse(prevstateno=743,4,0.1)
[State 0, VarSet]
type = VarSet
trigger1 = time
fvar(0) = ifelse(fvar(0)+0.03>8,8,fvar(0)+0.03)
[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(1) = 0.1
[State 0, VarSet]
type = VarSet
trigger1 = time
fvar(1) = ifelse(fvar(1)+0.0001>1.13,1.13,fvar(1)+0.0001)
[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(2) = 0.01;ifelse(prevstateno>=2500,0.75,0.1)
[State 0, VarSet]
type = VarSet
trigger1 = time
fvar(2) = ifelse(fvar(2)+0.001>0.05,0.05,fvar(2)+0.001)
[State 0, VelAdd]
type = VelAdd
trigger1 = prevstateno = 741
trigger1 = time = [0,30]
y = -0.01

[State 0, VelMul]
type = VelSet
trigger1 = time
x = ifelse(abs(vel x)<=1,0,vel x*0.97)
y = ifelse(abs(vel y)<=1,0,vel y*0.97)

[State 0, SprPriority]
type = SprPriority
trigger1 = sin(time*.1)>0
value = 3

[State 0, SprPriority]
type = SprPriority
trigger1 = sin(time*.1)<0
value = -2

[State 0, PosAdd]
type = PosAdd
trigger1 = 1
x = (parentdist x) * fvar(2)
y = (parentdist y + (const(size.mid.pos.y) / ifelse((parent,statetype=C||parent,statetype=L),2,1) )) * fvar(2)

[State 0, VelMul]
type = VelMul
trigger1 = vel y > 0
trigger1 = vel y + pos y >= 0
y = -1

[State 0, VarSet]
type = ParentVarSet
trigger1 = parent,var(45) != 1
var(45) = 1
ignorehitpause = 1

[State 0, Turn]
type = Turn
trigger1 = facing != parent,facing
;trigger1 = p2dist x < 0

;[State 0, ChangeState]
;type = ChangeState
;triggerall = time
;trigger1 = parentdist x = [-8,8]
;trigger1 = parentdist y + (const(size.head.pos.y) / ifelse((parent,statetype=C||parent,statetype=L),2,1) ) = [-25,2]
;trigger1 = parent,ctrl
;trigger1 = parent,alive
;trigger1 = parent,stateno = [0,59]
;trigger1 = parent,statetype != A
;trigger1 = parent,statetype != L
;value = 749
;ctrl = 0

[State 0, Explod]
type = Explod
trigger1 = parent,anim = 5300
trigger2 = parent,anim = [5000,5999]
trigger2 = parent,stateno != [760,769]
trigger3 = parent,stateno = [181,189]
anim = 909
ID = 909
pos = 0,0
;pos = 0-floor(parentdist x),20+floor(parentdist y)
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = 1,1
sprpriority = 4
ownpal = 1
ignorehitpause = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = parent,anim = 5300
trigger2 = parent,anim = [5000,5999]
trigger2 = parent,stateno != [760,769]
trigger3 = parent,stateno = [181,189]
value = S0,32

[State 0, ChangeState]
type = ChangeState
triggerall = time
trigger1 = parent,anim = 5300
trigger2 = parent,anim = [5000,5999]
trigger2 = parent,stateno != [760,769]
trigger3 = parent,stateno = [181,189]
value = 740
ctrl = 0

[State 0, ChangeState]
type = ChangeState
triggerall = time
trigger1 = !parent,alive
value = 741
ctrl = 0

[State 0, ChangeState]
type = ChangeState
triggerall = time
trigger1 = parent,stateno = 731
value = 745
ctrl = 0

[State 0, ChangeState]
type = ChangeState
trigger1 = time > 36
trigger2 = time > 6
trigger2 = parent,movehit
value = 742
ctrl = 0



;---------------------------------------------------------------------------
; AW SMACK crouch get-hit (shaking)
[Statedef 760]
type    = U
movetype= H
physics = N
velset = 0,0

[State 0, LifeAdd]
type = LifeAdd
trigger1 = time = 0
trigger1 = numhelper(740)
value = 0 - floor(helper(740),gethitvar(damage)/2)
kill = 0
absolute = 1
ignorehitpause = 1
persistent = 0

[State 5010, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = statetype != C
trigger1 = helper(740),GetHitVar(animtype) != [3,5]
value = ifelse((helper(740),GetHitVar(groundtype) = 1),5000,5010) + (helper(740),gethitvar(animtype))+ifelse(var(45),10000,0)

[State 5010, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = statetype = C
trigger1 = helper(740),GetHitVar(animtype) != [3,5]
value = 5020 + (helper(740),gethitvar(animtype))+ifelse(var(45),10000,0)

[State 5010, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = helper(740),GetHitVar(animtype) = [3,5]
value = 5030+ifelse(var(45),10000,0)

[State 5010, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5010, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
triggerall = Time = 0
trigger1 = (helper(740),GetHitVar(yvel) != 0) || (helper(740),GetHitVar(fall))
trigger2 = Pos Y != 0
statetype = a

[State 5010, 6]
type = ChangeState
trigger1 = time>=helper(740),gethitvar(hitshaketime)
trigger1 = (helper(740),GetHitVar(yvel) = 0) && (!helper(740),GetHitVar(fall))
value = 761 ;Crouch get-hit (knocked back)

[State 5010, 7]
type = ChangeState
trigger1 = time>=helper(740),gethitvar(hitshaketime)
value = 762

[State 5010, FFB Light]
type = ForceFeedback
trigger1 = anim = 5020
persistent = 0
time = 6
waveform = square

[State 5010, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5021
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5010, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5022
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; Crouch get-hit (knocked back)
[Statedef 761]
type    = U
movetype= H
physics = N

[State 5011, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = numhelper(740)
x = helper(740),hitvel x;GetHitVar(xvel)

[State 5011, 2]
type = ChangeAnim
trigger1 = (anim%10)=[0,4]
trigger1 = AnimTime = 0
value = anim + 5;5025 + helper(740),GetHitVar(animtype)

[State 5011, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= helper(740),GetHitVar(slidetime)
x = .6

[State 5011, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = anim + 5
persistent = 0

[State 5011, 4]
type = VelSet
trigger1 = numhelper(740)
trigger1 = (helper(740),GetHitVar(hittime)) <= 0
x = 0

[State 5011, 5]
type = DefenceMulSet
trigger1 = numhelper(740)
trigger1 = (helper(740),GetHitVar(hittime)) <= 0
trigger2 = !numhelper(740)
value = 1

[State 5011, 6]
type = ChangeState
trigger1 = numhelper(740)
trigger1 = (helper(740),GetHitVar(hittime)) <= 0
trigger2 = !numhelper(740)
value = ifelse(statetype=S,0,11)
ctrl = 1

;---------------------------------------------------------------------------
; Air get-hit (knocked away)
[Statedef 762]
type    = A
movetype= H
physics = N
ctrl = 0

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fvar(0) = helper(740),GetHitVar(yaccel)

[State 0, HitFallSet]
type = HitFallSet
trigger1 = time = 0
value = helper(740),GetHitVar(fall)
xvel = helper(740),GetHitVar(fall.xvel)
yvel = helper(740),GetHitVar(fall.yvel)

[State 5030, 1]
type = ChangeAnim
trigger1 = Anim != [5000, 5199]
trigger1 = SelfAnimExist(5030+ifelse(var(45),10000,0))
value = 5030+ifelse(var(45),10000,0)

[State 5010, 4] ;Freeze anim
type = ChangeAnim
trigger1 = time<=helper(740),gethitvar(hitshaketime)
value = anim
[State 0, PosFreeze]
type = PosFreeze
trigger1 = time<=helper(740),gethitvar(hitshaketime)
value = 1

[State 5030, 2]
type = VelAdd
trigger1 = 1
y = helper(740),GetHitVar(yaccel)

[State 5030, 3]
type = VelSet
trigger1 = Time = 0
x = helper(740),hitvel x;GetHitVar(xvel)
y = helper(740),hitvel y;GetHitVar(yvel)

[State 5030, 4]
type = ChangeState
triggerall = (!helper(740),GetHitVar(fall))
trigger1 = (helper(740),GetHitVar(hittime)) <= 0
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 20;Const(movement.air.gethit.groundlevel)
value = 764 ;HITA_RECOV

[State 5030, 5]
type = ChangeState
triggerall =(helper(740),GetHitVar(fall))
trigger1 = (helper(740),GetHitVar(hittime)) <= 0
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 20;Const(movement.air.gethit.groundlevel)
value = 765 ;HITA_FALL

[State 5030, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 763 ;Air get-hit (transition)

;---------------------------------------------------------------------------
; Air get-hit (transition)
[Statedef 763]
type    = A
movetype= H
physics = N

[State 5035, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5035+ifelse(var(45),10000,0))
trigger1 = Anim != [5051+ifelse(var(45),10000,0),5059+ifelse(var(45),10000,0)] ;Not if in hit up anim
trigger1 = Anim != 5090+ifelse(var(45),10000,0) ;Not if hit off ground anim
value = 5035+ifelse(var(45),10000,0)

[State 5035, 2]
type = VelAdd
trigger1 = 1
y = fvar(0)

[State 5035, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 20
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035+ifelse(var(45),10000,0) ;.
value = 764 ;Air get-hit (recovering in air, not falling)

[State 5035, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 20
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035+ifelse(var(45),10000,0) ;.
value = 765 ;Air get-hit (falling)

;---------------------------------------------------------------------------
; Air get-hit (recovering in air, not falling)
[Statedef 764]
type    = A
movetype= H
physics = N

[State 5040, 1]
type = ChangeState
trigger1 = !Alive
value = 765
ctrl = 0

[State 5040, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim != 5040+ifelse(var(45),10000,0)
trigger2 = Time = 0
trigger2 = Anim != 5035+ifelse(var(45),10000,0)
value = 5040

[State 5040, 3]
type = CtrlSet
trigger1 = HitOver
value = 1

[State 5040, 4]
type = StateTypeSet
trigger1 = HitOver
movetype = I

[State 5040, 5]
type = VelAdd
trigger1 = 1
y = fvar(0)

[State 5040, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;Jump land

;---------------------------------------------------------------------------
; Air get-hit (falling)
[Statedef 765]
type    = A
movetype= H
physics = N

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035+ifelse(var(45),10000,0)
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035+ifelse(var(45),10000,0)
trigger2 = (Anim != [5051+ifelse(var(45),10000,0), 5059+ifelse(var(45),10000,0)]) && (Anim != [5061+ifelse(var(45),10000,0), 5069+ifelse(var(45),10000,0)])
trigger2 = Anim != 5090+ifelse(var(45),10000,0) ;Not if hit off ground anim
value = 5050+ifelse(var(45),10000,0)

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050+ifelse(var(45),10000,0), 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = fvar(0)

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051+ifelse(var(45),10000,0),5059+ifelse(var(45),10000,0)]) || (anim = [5061+ifelse(var(45),10000,0),5069+ifelse(var(45),10000,0)]), 0, 25)
value = 5100 ;Downed get-hit (hit ground from fall)


;---------------------------------------------------------------------------
; Override common states (use same number to override) :
