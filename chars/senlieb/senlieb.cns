trigger1 = Anim != 5040+ifelse(var(45),10000,0)
trigger2 = Time = 0
trigger2 = Anim != 5035+ifelse(var(45),10000,0)
value = 5040+ifelse(var(45),10000,0)

[State 5040, 3]
type = CtrlSet
trigger1 = HitOver
value = 1

[State 5040, 4]
type = StateTypeSet
trigger1 = HitOver
movetype = I

[State 5040, 5]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5040, 6]
