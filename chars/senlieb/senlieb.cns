trigger1 = Anim != 20+ifelse(var(45),10000,0) && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20+ifelse(var(45),10000,0)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+ifelse(var(45),10000,0) && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21+ifelse(var(45),10000,0)

