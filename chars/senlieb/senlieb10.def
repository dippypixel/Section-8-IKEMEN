; Definition file for Senator Lieberman
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Joseph Lieberman"        ;Name of character
displayname = "Senator Lieberman" ;Name of character to display
versiondate = 05,31,2014    ;Version date of character (MM-DD-YYYY)
mugenversion = 1.0   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 4,1,2,5,6,5,3,8,9


; Files for the player
[Files]
cmd     = senlieb.cmd   ;Command set
cns     = senlieb.cns   ;Constants
st      = 10ov.st   ;States
st1      = senlieb.cns   ;States
st3     = config.txt
stcommon = common1.cns ;Common states
sprite  = senlieb.sff   ;Sprite
anim    = senlieb.air   ;Animation
sound   = senlieb.snd   ;Sound
pal1	= mic_hellhoundb.act
pal2	= mic_doctrinedark.act
pal3	= mic_shadow.act
pal4	= senlieb.act
pal5	= mic_freon.act
pal6	= mic_balga.act
pal7	= mic_blood.act
pal8	= mic_buzzlightyear.act
pal9	= mic_hyoimawano.act
pal10	= mic_johnebawang.act
pal11	= hhharn.act
pal12	= jim.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
ending.storyboard = ending.def
