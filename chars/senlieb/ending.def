; Ending cutscene for Hellhound's story.

; This storyboard has multiple scenes.
; Each scene uses two overlay anims, one for the picture, and
; another for the text.
; The fadein and fadeout parameters are used to fade one screen
; to the next.

[SceneDef]
spr = ending.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------
[Scene 0]
; Fade
fadein.time = 60       ;Time to take for fading in
fadein.col = 255,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 0
fadeout.col = 0,0,0
; Screen color
clearcolor = 0,0,0
; BG
bg.name = BG0          ;Name of BG to show (no spaces allowed)
; Overlay Anims (from 0 to 9)
;layerall.pos = 160,0   ;Default position for all layers
;layer0.anim =  0       ;Anim action number
;layer0.offset = 0,0   ;Position offset
;layer0.starttime = 0   ;Time to start display
;layer0.scale = .5,.5
;layer1.anim =  1
;layer1.offset = 0,240
;layer1.scale = .5,.5
;layer2.anim =  3
;layer2.offset = 0,240
;layer2.scale = .5,.5
;layer3.anim =  2
;layer3.offset = -120,240
;layer3.scale = .5,.5
; Music
bgm = ED.ogg        ;Name of music file to play
bgm.loop = 0
; Total time
end.time = 408

;------------------------------------
;BG def for scrolling mountain
;Note: the name for this BG must correspond to the value of bg.name in
;      Scene 0. For example, if you used "Scene0bg" instead of "BG0" for
;      bg.name, then the background definition group name should be
;      [Scene0bgDef].
[BG0Def]

[BG0 Text]
type = normal
id = 2
spriteno = 0,1
start = -192,0
velocity = 0
tile = 0,0
mask = 1

[BG0 Image]
type = anim
id = 3
actionno = 2
start = -192,0
velocity = 0
tile = 0,0
mask = 1

[BG0 Image]
type = normal
id = 3
spriteno = 0,0
start = -192,0
velocity = 0
tile = 0,0
mask = 1

;Background image
[Begin Action 0]
0,0, 0,0, -1

;Text
[Begin Action 1]
1,0, 0,0, -1

;Background image
[Begin Action 2]
0,2, 0,0, -1,,S

;BG controller to stop text from scrolling
[BG0CtrlDef Scrool]
CtrlID = 2
looptime = -1

[BG0Ctrl first]
type = Velset
time = 0
y = 0

[BG0Ctrl first]
type = Velset
time = 116
y = -3.5

[BG0Ctrl first]
type = Velset
time = 136
y = 0

[BG0Ctrl first]
type = Velset
time = 252
y = -3.5

[BG0Ctrl first]
type = Velset
time = 272
y = 0





;------------------------------------
[Scene 1]
; Fade
fadein.time = 0       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 0
fadeout.col = 0,0,0
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 160,100
layer0.anim =  100
layer0.offset = 0,0
layer0.starttime = 0
; Total time
end.time = 136


;Background image
[Begin Action 100]
2,3, 0,0, 2
2,4, 0,0, 2
2,5, 0,0, 2
2,6, 0,0, 2
2,7, 0,0, 2
2,8, 0,0, 2
2,9, 0,0, 2
2,10, 0,0, 2
2,11, 0,0, 2
2,12, 0,0, 2
2,13, 0,0, 2
2,14, 0,0, 2
2,15, 0,0, 2
2,16, 0,0, 3
2,17, 0,0, 4
2,18, 0,0, 5
2,19, 0,0, 6
2,20, 0,0, 6
2,0, 0,0, 6
2,1, 0,0, 6
2,2, 0,0, 6



