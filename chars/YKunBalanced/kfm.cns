victory2 = "WOW! I ONE!! YKUN IS BETTER THAN YOUUUUU!!!"
victory3 = "Sorry. Butt i so strong!!!"
victory4 = "NAN GWANG KAE GA A NYA SIBAL"
victory5 = "My A.I is GOOOOOOOOOOOOOOOOOOOOOD"
victory6 = "HEHEWHEHEHEWHEHWHEHWH!!THHAGAYH"

