[Statedef -2]

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "number hits = %f vscale=%f disty=%f %d %d %d"
params = fvar(11) , fvar(20), p2dist y ,var(10),var(11),var(20)
;ignorehitpause = 
;persistent = 

;Velocity Deterioration system (Edited from RicePigeon's Damage Proration system)
[State -2, Reset velocity dampener]
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
trigger3 = fvar(20) > 1.0
fvar(20) = 1.0

[State -2, Dampen vscaling]
type = Varset
trigger1 = stateno=2012 && animelem=44
fvar(20) = fvar(20) *1.5


[State 0, Make sure it never goes under the limit]
type = VarSet
trigger1 = fvar(20) < 0.25
fv = 20 
value = 0.25
ignorehitpause = 1


[State 0, MoveReset]
type = VarSet
trigger1 = !numtarget
v = 10
value = 0

[State 0, MoveReset]
type = VarSet
trigger1 = !numtarget
trigger2 = stateno=2012 && animelem=44
v = 11
value = 0
[State 0, MoveReset]
type = VarSet
trigger1 = !numtarget
v = 12
value = 0
[State -2, HurtSFX]
type = PlaySnd
triggerall = alive && stateno != 700
triggerall = random >= 300
trigger1 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5070)
trigger1 = !time
trigger2 = (stateno != 5000) && (stateno != 5010) && (stateno != 5020) && (stateno != 5070)
trigger2 = (stateno != [120,160]) && (stateno != [700,799])
trigger2 = gethitvar(damage)
value = 5000,0+(random%6)
channel = 0
volumescale = 100


[State 0, Death Sound]
type = PlaySnd
trigger1 =  !alive && fvar(2) = 0
value = S11,1+random%3
channel = -1
persistent = 0
ignorehitpause = 1

[State 0, DeathVar]
type = VarSet
trigger1 = 1
fv = 2 
value = !alive
ignorehitpause = 1

;combo code by ace_underscore 
[State -1,combo code]
