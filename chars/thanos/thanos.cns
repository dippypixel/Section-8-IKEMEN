;trigger2 = 
var(31) = var(31)+1
ignorehitpause = 1
[State WHAM Timer]
type = VarSet
trigger1 = !numenemy
var(32) = 0
ignorehitpause = 1
[State WHAM Timer]
type = VarSet
triggerall = numenemy
triggerall = enemynear, stateno != 227
trigger1 = enemynear, movetype != H
trigger2 = enemynear, statetype != A
;trigger2 = enemynear, vel x < 0
;trigger2 = (enemynear, vel x) + (enemynear, backedgebodydist) <= -1
var(32) = 0
ignorehitpause = 1
