trigger1 = Time = 0
trigger1 = !SysVar(0)
anim = 918;F(60 + (sysvar(1) > 5) + (sysvar(1) > 14))
pos = 0, 0
postype = p1
sprpriority = 10;ifelse (sysvar(1) <= 14, -10, 10)
scale = .5,.5
ownpal = 1

[State 5110, 8]
