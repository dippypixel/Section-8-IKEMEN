trigger1 = 1
text = "\nvar(45) = %d AI = %f, pro = %f, y = %f"
params = var(45),fvar(35),fvar(13),(vel y)
ignorehitpause = 1


[State 0, PlaySnd]
type = PlaySnd
triggerall = time = 0
trigger1 = stateno = 45
value = S0,7

