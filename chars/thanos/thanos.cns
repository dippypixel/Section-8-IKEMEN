type = PlaySnd
trigger1 = time = 0
value = S7,3

[State 0, ChangeState]
type = targetState
trigger1= time = 0
value =ifelse(prevstateno=810,803,802)

[State -2 Send the message]
type = Varset
trigger1 = time = 0
var(37) = var(37) | floor(exp(3*ln(2)) + 0.5)
ignorehitpause = 1

[State 0, PlayerPush]
