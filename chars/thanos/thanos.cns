anim = 809
ID = 809
pos = (enemynear,const(size.mid.pos.x)) + floor(enemynear,p2dist x/2),(enemynear,const(size.mid.pos.y))
postype = p2
facing = -1
vfacing = 1
bindtime = 1
removetime = -2
pausemovetime = 65535
supermovetime = 65535
scale = 1,1
sprpriority = 99
ontop = 1
shadow = 0,0,0
ownpal = 1
ignorehitpause =1

