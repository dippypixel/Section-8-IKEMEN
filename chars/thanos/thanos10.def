; Definition file for a Thanos
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Thanos"        ;Name of character
displayname = "Thanos" ;Name of character to display
versiondate = 01,08,2016    ;Version date of character (MM-DD-YYYY)
mugenversion = 1.0   ;Version of M.U.G.E.N character works on
author = "The_None"         ;Character author name
pal.defaults = 4,1,5,6,11,12,8,9,3,2,10,7      ;Default palettes in order of preference


; Files for the player
[Files]
cmd     = thanos.cmd   ;Command set
cns     = thanos.cns   ;Constants
st	= 10ov.st
st2      = thanos.cns   ;States
st3     = config.txt
st4 = kame.st
stcommon = common1.cns ;Common states
sprite  = thanos.sff   ;Sprite
anim    = thanos.air   ;Animation
sound   = thanos.snd   ;Sound
pal1    = par4.act ; MSH p1 palette
pal2    = par2.act ; Titan Royality by Davismaximus
pal3    = par3.act ; Black Adam by Calhoun Tubbs87
pal4    = par1.act ; Froz's vision of Default palette
pal5    = par5.act ; Skrull by Sabockee
pal6    = par6.act ; Darkseid by Froz
pal7    = par7.act ; Shrek by Froz
pal8    = par8.act ; Wolverine by TotalDramaXtremist
pal9    = par9.act ; M. Bison by Calhoun Tubbs87
pal10    = par10.act ; Dr. Doom by QuickFist
pal11    = par11.act ; Shazam by Calhoun Tubbs87
pal12    = par12.act ; SanThanos by Yours Truly


; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
