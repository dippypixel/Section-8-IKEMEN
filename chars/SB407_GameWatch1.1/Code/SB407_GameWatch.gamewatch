[Statedef -1]

;---------------------------------------------------------------------------
; Octopus
[State -1, Octopus]
type = ChangeState
value = 3200
triggerall = power >= 3000
triggerall = command = "Octopus"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699]) || (var(20) >= 1 && stateno != [3200,3299]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Helmet
[State -1, Helmet]
type = ChangeState
value = 3100
triggerall = !var(31)
triggerall = power >= 1000
triggerall = command = "Helmet"
triggerall = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,499]) || var(20) >= 1 || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Boxing
[State -1, Boxing]
type = ChangeState
value = 3000
triggerall = power >= 1000
triggerall = command = "Boxing"
triggerall = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,499]) || (var(20) >= 1 && stateno != [3000,3099]) || (stateno = [1000,1999])
trigger2 = movecontact

;---------------------------------------------------------------------------
; Bombs Away
[State -1, Bombs Away]
type = ChangeState
value = 1400
triggerall = command = "Bomb_x" || command = "Bomb_y"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699]) || (var(20) >= 1 && stateno != 1400)
trigger2 = movecontact

;---------------------------------------------------------------------------
; Oil Panic
[State -1, Oil Panic]
type = ChangeState
value = 1300
triggerall = command = "Oil_a" || command = "Oil_b"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699]) || (var(20) >= 1 && stateno != 1300)
trigger2 = movecontact

;---------------------------------------------------------------------------
; Judge
[State -1, Judge]
type = ChangeState
value = 1200
triggerall = command = "Judge"
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,699]) || (var(20) >= 1 && stateno != 1200)
trigger2 = movecontact
;---------------------------------------------------------------------------
; Fire
[State -1, Fire]
type = ChangeState
value = 1100
triggerall = numhelper(1103) = 0
triggerall = command = "Fire_x" || command = "Fire_y"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,499]) || (var(20) >= 1 && statetype != A && stateno != 1100)
trigger2 = movecontact
;---------------------------------------------------------------------------
; Chef
[State -1, Chef]
type = ChangeState
value = 1000
triggerall = command = "Chef"
triggerall = numhelper(1000) = 0
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = (stateno = [200,499]) || (var(20) >= 1 && statetype != A && stateno != 1000)
trigger2 = movecontact

;---------------------------------------------------------------------------
; Roman Cancel - Activate
[State -1, Roman Cancel - Activate]
type = VarSet
v = 7
value = 1
triggerall = power >= 500
triggerall = (stateno = [200, 699]) || (stateno = [1000, 1599]) || (stateno = [810,817]) || (stateno = [3000,3199]) 
triggerall = movetype != H
triggerall = command = "roman"
triggerall = stateno != 1200 || (stateno = 1200 && var(13) != 1)
trigger1 = movecontact
trigger2 = stateno = 1000  || stateno = 615 || stateno = [1400,1401]
trigger2 = var(15)
trigger3 = stateno = [810,817] 
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
ignorehitpause = 1
;---------------------------------------------------------------------------
; Roman Cancel - Decrease Power gain
[State -1, Roman Cancel - Decrease Power gain]
type = VarSet
fv = 7
value = 0.2
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,817]
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - Stop all momentumn when cancelling in air
[State -1, Roman Cancel - Stop all momentumn when cancelling in air]
type = VelSet
y = 0
x = 0
triggerall = power >= 500
triggerall = statetype = A
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,817]
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - FX
[State -1, Roman Cancel - FX]
type = VarSet
v = 5
value = 256
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,817]
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - SFX
[State -1, Roman Cancel - SFX]
type = PlaySnd
value = S700, 0
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,817]
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - Remove Power
[State -1, Roman Cancel - Remove Power]
type = PowerAdd
value = -500
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,817]
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
;---------------------------------------------------------------------------
; Roman Cancel - Reset
[State -1, Roman Cancel - Reset]
type = ChangeState
value = ifelse(statetype = A, 50, 0)
triggerall = var(7) != 0
trigger1 = movecontact
trigger2 = var(15)
trigger3 = stateno = [810,817]
trigger3 = animelemtime(9) >= 0
trigger3 = target,stateno != 820
ctrl = 1
;---------------------------------------------------------------------------
; Roman Cancel - Deactivate
[State -1, Roman Cancel - Deactivate]
type = VarSet
v = 7
value = 0
trigger1 = var(7) != 0

;===========================================================================
;---------------------------------------------------------------------------
; Run Back
[State -1, Run Back]
type = ChangeState
value = 105
trigger1 = (command = "BB"  || (command = "holdback" && command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl || (var(20) >= 1 && statetype != A && movetype != H && stateno != 1100 && movecontact)

;---------------------------------------------------------------------------
; Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = (command = "FF"  || (command = "x" && command = "y")) && command != "holddown"
trigger1 = statetype != A
trigger1 = ctrl || (var(20) >= 1 && statetype != A && movetype != H && stateno != 1100 && movecontact)

;---------------------------------------------------------------------------
; Super Jump
[State -1, Super Jump]
type = ChangeState
value = 41
trigger1 = command = "Super Jump" || (command = "a" && command = "b")
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]
trigger2 = command = "holdup" || (command = "a" && command = "b")
trigger2 = stateno = 410
trigger2 = movehit

;---------------------------------------------------------------------------
; Throw 1
[State -1, Throw 1]
type = ChangeState
value = 800
triggerall = command = "y"
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != [100,109]
triggerall = var(38) = 0
trigger1 = command = "holdfwd" || command = "holdback"
trigger1 = p2bodydist X < 10
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H

;---------------------------------------------------------------------------
; Throw 2
[State -1, Throw 2]
type = ChangeState
value = 815
triggerall = command = "b"
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != [100,109]
triggerall = var(38) = 0
trigger1 = command = "holdfwd" || command = "holdback"
trigger1 = p2bodydist X < 10
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H
;===========================================================================

;---------------------------------------------------------------------------
; Roll Backwards
[State -1, Roll Backwards]
type = ChangeState
value = 705
triggerall = command = "c"
triggerall = command = "holdback" && command != "holdfwd"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]

;---------------------------------------------------------------------------
; Roll Forwards
[State -1, Roll Forwards]
type = ChangeState
value = 706
triggerall = command = "c"
triggerall = command = "holdfwd" && command != "holdback"
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]

;---------------------------------------------------------------------------
; Air Dodge
[State -1, Air Dodge]
type = ChangeState
value = 707
triggerall = var(51) = 0
triggerall = command = "c"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = [40,41]
trigger2 = command = "holdback" || command = "holdfwd"

;---------------------------------------------------------------------------
; Dodge
[State -1, Dodge]
type = ChangeState
value = 700
triggerall = command = "c"
triggerall = (command != "holdback" && command != "holdfwd") || (command = "holdback" && command = "holdfwd")
trigger1 = statetype != A
trigger1 = ctrl || stateno = [100,109]

;---------------------------------------------------------------------------
; Stand Parry enabled
[State -1, Parry enabled]
type = VarSet
trigger1 = command = "fwd"
v = 6
value = 6
; Crouch Parry enabled
[State -1, Parry enabled]
type = VarSet
trigger1 = statetype != A
trigger1 = command = "down"
v = 8
value = 6

[State -1, Parry]
type = HitOverride
trigger1 = var(6)>0
trigger1 = ctrl
attr = SA,NA,SA,HA,NP,SP,HP
stateno = 710
time = 1
[State -1, Parry]
type = HitOverride
trigger1 = var(8)>0
trigger1 = ctrl
attr = C,NA,SA,HA,NP,SP,HP
stateno = 710
time = 1

;===========================================================================
