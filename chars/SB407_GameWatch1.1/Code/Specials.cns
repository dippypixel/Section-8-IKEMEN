airguard.velocity = ifelse(anim = 1110, -3.975, -3.25), ifelse(anim = 1110, -2.75, -2.115)
ground.cornerpush.veloff = 0
forcenofall = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.4/fvar(20)
[State 200, 1]
