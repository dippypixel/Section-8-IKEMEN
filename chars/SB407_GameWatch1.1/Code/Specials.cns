;---------------------------------------------------------------------------
; Chef
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= ceil(ifelse(prevstateno = 1000, 0, 45)*fvar(7))
ctrl = 0
anim = ifelse(prevstateno = 1000, 1001, 1000)

[State 0, VelSet]
type = VelSet
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
trigger2 = prevstateno = 250
x = 0
y = 0 

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = s0, ifelse(random > 500, 3, 8)

[State 0, Turn]
type = Turn
triggerall = !time
trigger1 = p2dist X < 0
trigger1 = prevstateno != 1000

[State 200, 1]
type = HitDef
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = !movecontact && !moveguarded && !movereversed
attr = S, SA
damage = 25, 3
animtype = Hard
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 5,5
sparkno = 2
sparkxy = -10, -76
hitsound = s5, 1
guardsound = s6, 0
getpower = ceil(ifelse(prevstateno = 1000, 40, 20)*fvar(7)), ceil(20*fvar(7))
givepower = 20, 20
ground.type = High
ground.slidetime = 12
ground.hittime  = 16
ground.velocity = -5.125
guard.velocity = -5.125
airguard.velocity = -2.75, -2.15
air.type = High
air.velocity = -4,-5.15
air.hittime = 16
ground.cornerpush.veloff = 0
palfx.time = 15
palfx.mul = 250,224,120
palfx.add = 240,50,0
palfx.sinadd = 110,55,85,10
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/fvar(20)

[State 200, Damage Dampen]
type = varset
trigger1 = movehit
fvar(10) = fvar(10)*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.075
ignorehitpause = 1
persistent = 0
[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(3) >= 0
trigger2= movecontact || moveguarded || movereversed
movetype= I

[State 0, Helper]
type = Helper
trigger1 = AnimElem = 2
name = "Food"
id = 1000
stateno = 1001
pos = ceil(65*const(size.xscale)),ceil(-69*const(size.yscale))
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0
size.xscale = (const(size.xscale)*0.65)
size.yscale = (const(size.yscale)*0.65)
[State 0, VarSet]
type = VarAdd
trigger1 = !time
trigger1 = prevstateno = 1000
v = 9
value = 1

[State 0, ChangeState]
type = ChangeState
triggerall = var(9) < 4
triggerall = command = "x" || command = "y"
trigger1 = AnimElemTime(2) >= 2
value = 1000

[State 230, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Chef - Food
[Statedef 1001]
type    = A
movetype= A
physics = N
juggle  = 0
velset = ifelse(parent,command = "holdfwd", ((30+random%15)/10), ifelse(parent,command = "holdback", ((20+random%10)/10), ((25+random%13)/10))), ifelse(parent,command = "holdup", ((-50-random%25)/10), ifelse(parent,command = "holddown", ((-30-random%15)/10), ((-40-random%20)/10)))
anim = 1010+random%4
sprpriority = 3

[State 0, VarSet]
type = VarSet
trigger1 = !time
v = 10
value = 1+random%8
ignorehitpause = 1

[State 0, AngleAdd]
type = AngleAdd
trigger1 = !movecontact
value = Vel X*var(10)
[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
ignorehitpause = 1

[State 200, 1]
type = HitDef
trigger1 = 1
attr = S, SP
damage = ceil(20.0*root,fvar(11)), 2
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 5,5
sparkno = 1
sparkxy = 0,0
hitsound = s5, 0
guardsound = s6, 0
getpower = ceil(15*parent,fvar(7)), ceil(8*parent,fvar(7))
givepower = 15, 15
ground.type = High
ground.slidetime = 12
ground.hittime  = 15
ground.velocity = -3.85
guard.velocity = -3.85
airguard.velocity = -1.25,-1
air.type = High
air.velocity = -1.5,-2
air.hittime = 15
guard.hittime = 8
airguard.hittime = 8
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/parent,fvar(20)

[State 0, VarSet]
type = ParentVarSet
trigger1 = parent,stateno = 1000
trigger1 = movecontact
v = 15
value = 1
ignorehitpause = 1
persistent = 0
[State 200, Damage Dampen]
type = parentvarset
trigger1 = movehit
fvar(10) = (root,fvar(10))*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = parentvarset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = (root,fvar(20))-.035
ignorehitpause = 1
persistent = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = movecontact
movetype = I
ignorehitpause = 1

[State 0, VelAdd]
type = VelAdd
trigger1 = 1
y = .285

[State 0, HitBy]
type = HitBy
trigger1 = 1
value = SCA,AP
time = 1
ignorehitpause = 1

[State 0, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 1002
time = 1
ignorehitpause = 1
[State 0, ChangeState]
type = ChangeState
trigger1= vel y > 0
trigger1= pos y > -vel y
trigger2 = movecontact
value = 1002

;---------------------------------------------------------------------------
; Chef - Food
[Statedef 1002]
type    = A
movetype= I
physics = N
juggle  = 0
velset = 0,0
sprpriority = 3

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = time%2 = 0
trigger2 = time >= 15
flag = invisible

[State 0, HitBy]
type = HitBy
trigger1 = 1
value =
time = 1
ignorehitpause = 1

[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
ignorehitpause = 1

[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5020
value = 6020
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5050
value = 6050
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5070
value = 6070
ignorehitpause = 1
[State -2, FALL.]
type = TargetState
triggerall = NumTarget
triggerall = target,stateno != [6020,6120]
trigger1 = target,stateno = 5080
value = 6080
ignorehitpause = 1

[State 0, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 1002
time = 1
ignorehitpause = 1
[State 0, ChangeState]
type = DestroySelf
triggerall = Time >= 15
trigger1 = !numtarget
trigger2 = root,movehit

