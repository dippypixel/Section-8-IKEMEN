trigger1 = animelem = 9
value = S0,9

[State 0, VelSet]
type = VelSet
triggerall = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
trigger2 = prevstateno = 250
x = 0
y = 0 

[State 0, Helper]
type = Helper
