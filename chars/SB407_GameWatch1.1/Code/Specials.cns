ground.hittime  = ifelse(anim = 1110, 21, 12)
guard.slidetime = ifelse(anim = 1110, 14, 8)
guard.hittime = ifelse(anim = 1110, 15, 8)
air.hittime = ifelse(anim = 1110, 21, 12)
airguard.hittime = ifelse(anim = 1110, 15, 8)
