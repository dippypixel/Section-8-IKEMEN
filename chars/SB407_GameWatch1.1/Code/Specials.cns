persistent = 0
[State 0, PlayerPush]
type = PlayerPush
trigger1 = AnimElemTime(4) >= 0
trigger1 = ifelse(anim = 1100, AnimElemTime(8) < 0, AnimElemTime(7) < 0)
value = 0
ignorehitpause = 1

[State 0, StateTypeSet]
type = StateTypeSet
