;------------------------------------------------------------------
;Sleep Sound Effect
[Statedef 1996092]
type= A
physics= N
movetype= I
anim = 69

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S19969,0
channel = 4
loop = 1

[State 0, PlaySnd]
type = StopSnd
trigger1= parent,anim != 1996092
channel = 4
[State 5205, End]
type= destroyself
trigger1= parent,anim != 1996092

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;Walking Sound
[State -2, first step]
type = PlaySnd
triggerall = stateno = 20
trigger1 = anim = [20,21]
trigger1 = !var(3)
value = S20,ifelse(var(2) = 0, 0, 1)
[State -2, following steps]
type = PlaySnd
trigger1 = stateno = 20
trigger1 = anim = [20,21]
trigger1 = animtime%15 = 0
trigger2 = time >= 12
trigger2 = (stateno = 100) || (stateno = 105)
trigger2 = animtime%6 = 0
value = S20,ifelse(var(2) = 0, 0, 1)
[State -2, change sound per step]
type = VarAdd
triggerall = stateno = 20
trigger1 = anim = [20,21]
trigger1 = animtime%15 = 0
trigger2 = !var(3)
v = 2
value = ifelse(var(2) = 0, 1, -1)
[State -2, change sound during run]
type = VarAdd
trigger1 = time >= 12
trigger1 = (stateno = 100) || (stateno = 105)
trigger1 = animtime%6 = 0
v = 2
value = ifelse(var(2) = 0, 1, -1)
[State -2, reset]
type = VarSet
trigger1 = stateno != 20 && stateno != 100 && stateno != 105
trigger2 = stateno = 20 && anim = 5
trigger3 = anim = [20,21]
trigger3 = animelemtime(2) < 0
v = 2
value = 0
ignorehitpause = 1 
[State -2, turn off first step]
type = VarSet
trigger1 = anim = [20,21]
v = 3
value = 1
ignorehitpause = 1 
[State -2, reset]
type = VarSet
trigger1 = anim != [20,21]
v = 3
value = 0
ignorehitpause = 1 

;POTS stuff

[State -3, Corner Push]
type = varset
trigger1 = fvar(5)
trigger1 = abs(fvar(5)) < 1.0
fvar(5) = 0
[State -3, Corner Push]
type = varset
trigger1 = fvar(5)
trigger1 = numtarget
trigger1 = target, hitover || (target, gethitvar(hitshaketime) > 0 && target, time <= 0)
fvar(5) = 0
[State -3, Corner Push]
type = varset
trigger1 = movecontact = 1 && numtarget
fvar(5) = target, gethitvar(xvel)
ignorehitpause = 1
[State -3, Corner Push]
type = posadd
triggerall = fvar(5)
triggerall = numtarget
triggerall = !hitpausetime && target, gethitvar(hitshaketime) <= 0
triggerall= (target, statetype = S || target, statetype = C) && !(target, gethitvar(yvel)) && !(target, hitfall)
trigger1 = target, frontedgebodydist <= abs(target, vel x)
trigger1 = (target, gethitvar(xvel) * target, facing) > 0
trigger2 = target, backedgebodydist <= abs(target, vel x)
trigger2 = (target, gethitvar(xvel) * target, facing) < 0
x = ifelse(target, frontedgebodydist <= 0, -1, 1) * (target, facing) * fvar(5)
[State -3, Corner Push]
type = varset
trigger1 = numtarget
trigger1 = target, gethitvar(hitshaketime) <= 0
fvar(5) = fvar(5) * 0.85

[State -3, Prevent Undergound Juggles]
type= targetbind
trigger1 = movecontact = 1
trigger1 = numtarget = 1 && numenemy
trigger1 = target, time <= 0
trigger1 = target, ID = enemynear, ID
trigger1 = !(target, hitshakeover) && (target, pos y > 0)
pos = ceil(p2dist x), ceil(-pos y)
ignorehitpause= 1

[State -3, Variable Height]
type= playerpush
triggerall= statetype=A && movetype!=H && numenemy
triggerall= p2bodydist x = [-(enemynear,const(size.ground.back) + enemynear,const(size.ground.front)), 0]; checks if both characters are within each other's width
trigger1= p2statetype=S
trigger1= p2dist y >= (enemynear,const(size.height) - 28)
trigger2= p2statetype=C
trigger2= p2dist y >= (enemynear,const(size.height) - 49)
trigger3= p2statetype=L
trigger3= p2dist y >= 10
value= 0
ignorehitpause= 1