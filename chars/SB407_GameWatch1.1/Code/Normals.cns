;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 0, Explod]
type = Explod
trigger1 = AnimElem = 2
anim = 191
ID = 190
pos = 0,0
postype = p1  ;p2,front,back,left,right
removetime = -1
sprpriority = 0
ontop = 0
scale = const(size.xscale), const(size.yscale)
shadow = 0,0,0
ownpal = 1
removeongethit = 0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = S190,0
[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = S190,1
[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = S190,2
[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5
value = S190,3

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = AnimElem = 5 
id = 190

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Taunt
; CNS difficulty: easy
[Statedef 195]
type = S
movetype = I
physics = S
ctrl = 0
anim = 195
sprpriority = 2

[State 0, VelSet]
type = VelSet
trigger1 = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
x = 0
y = 0 

[State 0, CtrlSet]
type = CtrlSet
trigger1 = Time >= 40
value = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S195,0
channel = 0

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Pummel
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 1
poweradd= 0
ctrl = 0
anim = 200
facep2 = 1

[State 0, VelSet]
type = VelSet
trigger1 = !time
trigger1 = (prevstateno != [100,109]) && (prevstateno != [200,499])
trigger1 = !var(50)
x = 0
y = 0 

[State 0, Helper]
type = Null;Helper
trigger1 = AnimElem = 2
name = "Pushbox"
stateno = 201
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0

[State 200, 1]
type = HitDef
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = !movecontact && !moveguarded && !movereversed
attr = S, NA
damage = 25, 0
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 7,7
sparkno = 0
sparkxy = -35,ceil(-76*const(size.yscale))
hitsound = s5, 0
guardsound = s6, 0
getpower = ceil(42*fvar(7)), ceil(16*fvar(7))
givepower = 20, 20
ground.type = High
air.type = High
ground.slidetime = 10
ground.hittime  = 13
air.hittime = 13
guard.hittime = 6
airguard.hittime = 6
ground.velocity = -3.5
guard.velocity = -3.5
air.velocity = -1.65,-4
airguard.velocity = -1.3,-1
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5/fvar(20)
forcenofall = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = S0,1

[State 200, Damage Dampen]
type = varset
trigger1 = movehit
fvar(10) = fvar(10)*0.9
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.05
ignorehitpause = 1
persistent = 0

[State 200, Set to Idle]
type= StateTypeSet
trigger1= AnimElemTime(3) >= 0
trigger2= movecontact || moveguarded || movereversed
movetype= I

[State 230, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Pummel - Pushbox
[Statedef 201]
type    = U
movetype= I
physics = N
juggle  = 0
velset = 0,0
anim = 201
sprpriority = -1

[State 0, BindToParent]
type = BindToParent
trigger1 = 1
time = 1
pos = 0,0
ignorehitpause = 1

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 1
ignorehitpause = 1

[State 0, HitBy]
type = HitBy
trigger1 = 1
value =
time = 1
ignorehitpause = 1

[State 0, Width]
type = Width
trigger1 = 1
player = ceil(35*const(size.xscale)), ceil(35*const(size.xscale))

[State 0, DestroySelf]
type = DestroySelf
trigger1 = parent,stateno != 200
trigger2 = parent, stateno = 200
trigger2 = (parent, AnimElemTime(3) >= 0) || (parent, AnimElemTime(1) >= 0 && parent, AnimElemTime(2) < 0)
ignorehitpause = 1

