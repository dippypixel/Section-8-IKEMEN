guard.velocity = -12
air.velocity = -2.75,-6.5
airguard.velocity = -3,-1
ground.cornerpush.veloff = 0
fall.recover = 1
fall.recovertime = 120
yaccel = 0.5
fall = 0
forcenofall = 1
id = 3000
[State 0, TargetBind]
type = TargetBind
trigger1 = movehit
trigger1 = target(3000), statetype = A
time = 1
id = 3000
pos = 15, -15
ignorehitpause = 1
persistent = 0


[State 200, Damage Dampen]
type = varset
trigger1 = movehit
fvar(10) = fvar(10)*0.95
ignorehitpause = 1
persistent = 0
[State 200, Velocity Dampen]
type = varset
trigger1 = movehit
trigger1 = numtarget
trigger1 = target, statetype = A
fvar(20) = fvar(20)-0.05
ignorehitpause = 1
persistent = 0

[State 0, ChangeState]
type = ChangeState
trigger1= statetype = A
trigger1= vel y > 0
trigger1= pos y > -vel y
value = 3002

