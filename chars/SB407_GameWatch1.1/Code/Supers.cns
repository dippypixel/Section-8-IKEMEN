value = S0,8

[State 200, 1]
type = HitDef
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
trigger1 = !movecontact && !moveguarded && !movereversed
attr = A, HA
damage = 50, 5
animtype = Heavy
guardflag = HA
hitflag = MAF
priority = 3, Hit
pausetime = 7,7
sparkno = 1
