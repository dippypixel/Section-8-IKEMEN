hitsound = s5, 1
guardsound = s6, 0
getpower = 0,0
givepower = 20, 20
ground.type = High
air.type = High
ground.slidetime = 25
ground.hittime  = 30
air.hittime = 30
guard.hittime = 30
airguard.hittime = 30
