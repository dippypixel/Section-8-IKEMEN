;---------------------------------------------------------------------------
; Super Jump
[Statedef 41]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 0, HitBy]
type = HitBy
trigger1 = !var(50)
value = SCA,NA,SA,HA,NP,SP,HP

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ceil(const(velocity.jump.y)*1.3215)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 105 ;RUN_Back
trigger1 = sysvar(1) = -1
x = const(velocity.runjump.back.x)

[State 0, VarSet]
type = VarSet
trigger1 = AnimTime = 0
v = 56
value = 1
ignorehitpause = 1
[State 40, Jump SFX]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,1
[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = N
anim = 100
ctrl = 0
sprpriority = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S100,0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)*ifelse(animelemtime(2) >= 0, 1, 1.17927338)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup"
value = 40
[State 100, 4]
type = ChangeState
trigger1 = command = "holdback" && command != "holdfwd"
value = ifelse(AnimElemTime(2) >= 0, 102, 105)
[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
trigger1 = AnimElemTime(2) >= 0
value = ifelse(AnimElemTime(2) >= 1, 101, 0)
ctrl = ifelse(AnimElemTime(2) >= 1, 0, 1)

;---------------------------------------------------------------------------
; Run - Stop
[Statedef 101]
type    = S
physics = N
anim = ifelse(prevstateno = 100, 101, 106)
ctrl = 0
sprpriority = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S100,1

[State 100, 1]
type = VelMul
trigger1 = 1
x = 0.825

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup"
value = 40
[State 100, 4]
type = ChangeState
triggerall = AnimElemTime(2) < 0
trigger1 = cond(anim = 101, command = "holdfwd", command = "holdback")
value = 102
anim = ifelse(prevstateno = 100, 102, 103)
ctrl = ifelse(command = "holdfwd" && command != "holdback", 0, ifelse(command = "holdback" && command != "holdfwd", 0, 1))
[State 100, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(command = "holdfwd" && command != "holdback", 100, ifelse(command = "holdback" && command != "holdfwd", 105, 0))
ctrl = ifelse(command = "holdfwd" && command != "holdback", 0, ifelse(command = "holdback" && command != "holdfwd", 0, 1))

;---------------------------------------------------------------------------
; Turnaround
[Statedef 102]
type    = S
physics = N
anim = ifelse(prevstateno = 100, 102, 103)
ctrl = 0
sprpriority = 1

[State 100, 1]
type = VelMul
trigger1 = 1
x = 0.825

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup"
value = 40
[State 100, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(command = "holdfwd" && command != "holdback", 100, ifelse(command = "holdback" && command != "holdfwd", 105, 0))
ctrl = ifelse(command = "holdfwd" && command != "holdback", 0, ifelse(command = "holdback" && command != "holdfwd", 0, 1))
;---------------------------------------------------------------------------
; Run Backward
[Statedef 105]
type    = S
physics = N
anim = 105
ctrl = 0
sprpriority = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S100,0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.back.x)*ifelse(animelemtime(2) >= 0, 1, 1.17927338)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup"
value = 40
[State 100, 4]
type = ChangeState
trigger1 = command = "holdfwd" && command != "holdback"
value = ifelse(AnimElemTime(2) >= 0, 102, 100)
[State 100, 4]
type = ChangeState
trigger1 = command != "holdback"
trigger1 = AnimElemTime(2) >= 0
value = ifelse(AnimElemTime(2) >= 1, 101, 0)
ctrl = ifelse(AnimElemTime(2) >= 1, 0, 1)

;---------------------------------------------------------------------------
; Spot Dodge
[Statedef 700]
type    = S
physics = S
anim = 700
ctrl = 0
velset = 0,0
sprpriority = 1
facep2 = 1

[State 0, HitBy]
type = HitBy
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(4) < 0
value = SCA,AT
[State 0, PlayerPush]
type = PlayerPush
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(4) < 0
value = 0

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

