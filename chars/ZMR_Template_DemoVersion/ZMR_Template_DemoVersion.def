  ;-------------------------------------------------------------------------
;Zander's Mugen Remastered Character Template
;made by Alexander Cooper 19 for easier time porting new characters over
;Hitspark Effects by Viola
;-------------------------------------------------------------------------
[Info]
name         = "ZMR_Template"                 ;the name referred to in debug mode
displayname  = "Kung Fu Man (ZMR)"            ;the name displayed in game
versiondate  = 03,18,2025                     ;date the template was created
mugenversion = 1.1                            ;self explainatory. DON'T CHANGE OR CHARACTER WILL BREAK.
author       = "Alexander Cooper 19 and Viola";Author Name
pal.defaults = 1,2,3,4,5,6                    ;a list of palette defaults
;-------------------------------------------------------------------------
[Files]
sprite       = Code/ZMR_Template.sff          ;Contains Sprites and Effects
anim         = Code/ZMR_Template.air          ;Contains all Animations
sound        = Code/ZMR_Template.snd          ;Includes all SFX/Voice Clips
cmd          = Code/ZMR_Template.cmd          ;Contains the characters command list
movelist     = Code/Movelist.dat              ;Generates a command list using text from this file for IKEMEN Go Pause Menu.
cns          = Code/CNS/ZMR_Template.cns      ;Contains Code
stcommon     = Code/CNS/common1_ZMR.cns       ;Universal Common1 file for Zander's Mugen Remastered
st           = Code/CNS/ZMR_Template.cns      ;Contains Code
st1          = Code/CNS/Normals.cns           ;Contains Code
st2          = Code/CNS/Specials.cns          ;Contains Code
st3          = Code/CNS/Supers.cns            ;Contains Code
st4          = TagTeamZMR.cns                 ;Tag Team Coding (keep it enabled, it doesn't intefere with mugen builds outside ZMR.)
;-------------------------------------------------------------------------
;Palette Colors
pal1         = Palettes/Palette1.act  ;Default
pal2         = Palettes/Palette2.act  ;Fighter
pal3         = Palettes/Palette3.act  ;Grandmaster Gold
pal4         = Palettes/Palette4.act  ;Navy Blue
pal5         = Palettes/Palette5.act  ;Honshu Purple
pal6         = Palettes/Palette6.act  ;Kyu Blue
pal7         = Palettes/Palette7.act  ;Blazing Hues
pal8         = Palettes/Palette8.act  ;Purple and Pink
pal9         = Palettes/Palette9.act  ;One Punch Man
pal10        = Palettes/Palette10.act ;Emerald Warrior
pal11        = Palettes/Palette11.act ;Inverted
pal12        = Palettes/Palette12.act ;Sauve Dude
;-------------------------------------------------------------------------
;Palette Colors (Ikemen Go)

pal13        = Palettes/Palette13_IkemenGo.act ;Ultra
pal14        = Palettes/Palette14_IkemenGo.act ;Evil MKII
pal15        = Palettes/Palette15_IkemenGo.act ;Dirty
pal16        = Palettes/Palette16_IkemenGo.act ;Blanka
pal17        = Palettes/Palette17_IkemenGo.act ;Goku
pal18        = Palettes/Palette18_IkemenGo.act ;Dash of Lemon
pal19        = Palettes/Palette19_IkemenGo.act ;Stone
pal20        = Palettes/Palette20_IkemenGo.act ;Classic Alt 1
pal21        = Palettes/Palette21_IkemenGo.act ;Classic Alt 2
pal22        = Palettes/Palette22_IkemenGo.act ;Classic Alt 3
pal23        = Palettes/Palette23_IkemenGo.act ;Classic Alt 4
pal24        = Palettes/Palette24_IkemenGo.act ;Classic Alt 5
pal25        = Palettes/Palette25_IkemenGo.act ;Valentine-Fu Man
;-------------------------------------------------------------------------
[Palette Keymap] 
x 	= 1
y	= 2
z	= 3
a 	= 4 ;Default would be pressing "X" instead of "A" to keep consistent with universal controls.
b	= 5
c 	= 6
x2	= 7
y2	= 8
z2	= 9
a2	= 10
b2	= 11
c2	= 12
;-------------------------------------------------------------------------
;Information Read by Ikemen Go. universal compatibility is left unaffected.
[PalInfo]
1  = Default
2  = Fighter
3  = Grandmaster Gold
4  = Navy Blue
5  = Honshu Purple
6  = Kyu Blue
7  = Blazing Hues
8  = Purple and Pink
