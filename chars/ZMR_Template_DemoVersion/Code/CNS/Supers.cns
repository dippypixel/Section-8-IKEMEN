;---------------------------------------------------------------------------
; Triple Kung Fu Palm
[Statedef 3000]
type    = S
movetype= A
physics = S
velset = 0,0
anim = 3000
ctrl = 0
sprpriority = 2

[State Voice Clip]
type = PlaySnd
trigger1 = AnimElem = 4
trigger2 = Animelem = 12
value = s100,ifelse(animelemtime(12)=0,3,2)
channel = 0
volumescale = 110

[State Default Zoom (Hypers)] ;WORKS IN 1.1 ONLY
type                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            