trigger1 = !time
helpertype = Normal ;Player
name = "Basic Zoom Helper"
ID = 6200
stateno = 6200
pos = 0,0
postype = P1
ownpal = 1
supermovetime = 9999999
pausemovetime = 9999999
ignorehitpause = 1

[State HitSpark]
type=null
;
;Spark X
trigger1=1||var(41):=0
;
;Spark Y
trigger1=1||var(42):=-60
;
;Spark Type
trigger1=1||var(43):=2
ignorehitpause=1

;Supers don't count towards the juggle meter and shouldn't do so.
