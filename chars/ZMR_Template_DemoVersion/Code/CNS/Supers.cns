;Effect
[Statedef 3001]
type    = A
movetype= I
physics = N
velset = 0,0
ctrl = 0
sprpriority = 5

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[state ]
type=selfstate
trigger1=!ishelper
value=52
ignorehitpause=1
;
;var(0)=Trans
;var(1)=Angle
;var(2)=Pos X
;var(3)=Pos Y
[state ]
type=null
trigger1=1||var(0):=(ishelper(300001)||ishelper(300002)||ishelper(301001)||ishelper(301002))
ignorehitpause=1
[state ]
type=null
triggerall=ishelper(300000)||ishelper(300001)||ishelper(300002)
trigger1=1||var(1):=-90
trigger1=1||var(2):=55
trigger1=1||var(3):=-55
ignorehitpause=1
[state ]
type=null
triggerall=ishelper(301000)||ishelper(301001)||ishelper(301002)
trigger1=1||var(1):=-18
trigger1=1||var(2):=38
trigger1=1||var(3):=-115
ignorehitpause=1

[State 0, SprPriority]
type = SprPriority
trigger1 = ishelper
value = 5-(ishelper(300001)||ishelper(301001))+(ishelper(300002)||ishelper(301002))*2
ignorehitpause = 1


[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "var(4):%d,size:%f"
params = var(4),(1.000/var(4))

[state ]
type=changeanim
trigger1=!time
value=102201
ignorehitpause=1

