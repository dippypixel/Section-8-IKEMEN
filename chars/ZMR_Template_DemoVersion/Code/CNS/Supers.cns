ID = 3000

[State 0, TargetState] ;this sends the opponent in a wall bounce state after they are damaged from the final hit of the attack.
type = TargetState
triggerall = NumTarget;()
trigger1 = animelemtime(21)>=0 && movehit = 1
value = 10250
ID = 3000
;persistent = 0

[State WHAM] ;this is needed to play a wallbounce sound when opponent goes into wall bounce state 
type = PlaySnd
triggerall = numtarget
triggerall = target,stateno = 10270
trigger1 = time != 1
value = S0,12
freqmul = 1.0
ignorehitpause = 1
persistent = 0

[State 0, PalFX]
type = envcolor
triggerall = movehit = 1
trigger1 = animelemtime(6) = 1
time = 1
value = 255,255,255
under = 1
persistent = 0
ignorehitpause = 1
[State 0, PalFX]
