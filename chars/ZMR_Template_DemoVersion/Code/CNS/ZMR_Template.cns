;===========================================================================
;AI/CPU

;this is where all the computer player code is created that when activated will allow the computer player to follow
;a sequence of specific inputs to be able to fight back. extra coding measures have been made so that AI difficulty can
;ramp up or ramp down on all versions of mugen (outside of WinMugen that needs to be set up manually in options on top)
;along with true instant activation so its always ready to fight.

;used vars
;
;v59=Activation
;v58=StateNo
;v57=Total Enemy,NumProj before round starts
;v52=Jump type
;v51=enemy,id
;v50=AILevel
;

[State AI Activation] ;very complex code that works when mugenversion is always set to 1.0, it helps with always activating the AI on time without any issues.
Type                                                                                                                                                                                                                                                           =Null
Type=DisplayToClipBoard
triggerall=!ishelper
Trigger1=!var(59)
Trigger1=Var(59):=1                                                                                                                                                                                                                                            -1+AILevel&&0
Text="`SX-~DRE-AM~|-9H/>PYEUX+A$PYSX-~SUM-MER~--XX4PZ!j$)J$aTX-~AIR-Key~-+U=/P\\%c%%%%950d4CA"
Params=195
IgnoreHitPause=1

[state AILevel] ;this var ramps up the AI difficulty level depending on what you choose in settings without the use of AILevel trigger for full compatibility with all mugen versions.
type=varset
trigger1=var(59)
var(50)=ifelse(var(50)<1,1,ifelse(var(50)>8,8,var(50)))
ignorehitpause=1
[state AILevel]
type                                                                                                                                                                                                                                                           =varset
type=null
trigger1=1;var(59)
var(50)=AILevel
ignorehitpause=1

[state Enemy,ID] ;for AI/CPU, tracks the ID of the character they fight against.
type=varset
trigger1=numenemy=1
var(51)=enemy,id
ignorehitpause=1

[state Enemy,ID] ;for AI/CPU, tracks the ID of the character they fight against.
type=varset
trigger1=numenemy>1
var(51)=ifelse(enemynear(0),alive,enemynear(0),id,enemynear(1),id)
ignorehitpause=1

[state Enemy,NumProj] ;for AI/CPU, tracks the ID of the character they fight against projectiles
type=varset
triggerall=roundstate<2
trigger1=numenemy=1
var(57)=playerid(var(51)),numproj
ignorehitpause=1
[state Enemy,NumProj] ;for AI/CPU, tracks the ID of the character they fight against projectiles
type=varset
triggerall=roundstate<2
trigger1=numenemy>1
var(57)=enemy(0),numproj+enemy(1),numproj
ignorehitpause=1
;
[State 0, DisplayToClipboard] ;debug info for AI/CPU only
type = DisplayToClipboard
trigger1 = var(59)
text = "p2x:%d,p2y:%d,prev:%d,jumptype:%d,sj:%d"
params = floor(p2bodydist x),floor(p2bodydist y),var(50),var(52),var(35)
ignorehitpause = 1

