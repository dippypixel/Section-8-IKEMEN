[state Reset HitPause]
type=varset
trigger1=1
var(40)=-1

;===========================================================================
;Small Jumps

;these allow you to lightly tap up to have a smaller jump, useful for jump-ins
;where you'd like to be closer to the ground after landing an aerial or if you
;need to reposition

;credits to Viola for the code.

[state Jump reset]
type=varset
triggerall=var(59)
trigger1=movetype=h
trigger2=stateno=52
trigger3=roundstate=0
var(52)=0
ignorehitpause=1

[state Small Jump] ;tapping up gives the small jump
type=varset
triggerall=var(4)=0
triggerall=!var(59)||(var(59)&&(var(50)=1))
trigger1=command!="holdup"
trigger2=var(59)
trigger2=(var(52)=[4,6])||var(52)=8||(var(52)=[10,11])
var(35)=-1

[state Normal Jump] ;holding up gives the normal jump
type=varset
triggerall=var(4)=0
triggerall=!var(59)||(var(59)&&(var(50)=1))
trigger1=command="holdup"
trigger2=stateno=52
trigger3=var(59)&&var(50)!=1
trigger3=(var(52)!=[4,6])&&var(52)!=8&&(var(52)!=[10,11])
var(35)=0
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

;==================================================================
;Variable Height System (coded by Jesuszilla)

;this system changes character height via code to make certain actions easier
;like cross-ups and jump-ins.

[State -2, JZ Variable Height]
type = PlayerPush
triggerall = StateType = A && NumEnemy
triggerall = P2Dist Y - Vel Y >= (EnemyNear(0), Const(Size.Height) - 35)
triggerall = (StateNo = [40,50]) || (StateNo = [600,620]); || (StateNo = [other air states...] ...)
trigger1 = P2StateType = S
trigger1 = P2Dist Y - Vel Y >= (EnemyNear(0), Const(Size.Height) - 35)
trigger2 = P2StateType = C
trigger2 = P2Dist Y - Vel Y >= (floor(EnemyNear(0), Const(Size.Height)*0.825) - 35) ;That's the ratio
value = 0

;==================================================================
;Air Juggle Gravity System (ZMR VS ZMR Only, doesn't apply outside of ZMR)

;this system only takes place if the characters are both in ZMR (through Var(21) detection)
;if they are then this new system takes priority over old 12 juggle points system.
;it makes it so that more combo hits in the air outside of aerial raves will increase the
;opponents gravity on each hit, to the point it becomes impossible to do juggles if it takes
;to long.

;Gravity thingy thing
[State -3, Reset]
type = VarSet
triggerall = Var(21)
trigger1 = StateType != A
trigger2 = (enemynear,stateno = [3000,3999]) ;detect hyper moves
trigger3 = ((enemynear,name = "Totino_ZMR") && enemynear,stateno = 1023) ;detect Pizza Roll Punch
fvar(15) = 0
ignorehitpause = 1

[State -3, Count up]
type = VarAdd
trigger1 = Var(21)
trigger1 = StateType = A
trigger1 = (GetHitVar(Damage))
fvar(15) = 0.04
ignorehitpause = 0
persistent = 0

[State -3, Affect gravity]
type = VelAdd
trigger1 = Var(21)
trigger1 = HitShakeOver
trigger1 = StateType = A
trigger1 = MoveType = H
trigger1 = fvar(15) != 0
y = fvar(15)
ignorehitpause = 0

[State -3 turn off juggle if ZMR Character VS ZMR Character is detected]
type = AssertSpecial
trigger1 = var(21)
flag = nojugglecheck
ignorehitpause = 1
;==================================================================
;Character Detector

;this will try and detect if a ZMR Characters is fighting another ZMR Character.
;if not will disable some ZMR exclusive UI elements or certain functions that are hard coded into these characters.
;note that future releases won't be compatible with characters with the "_DemoVersion" folder label.

[State ZMR Character Detector]
type = VarSet
triggerall = numenemy
;--------------------------------------------------------------------------------------------------------
;Demo Base Game Roster
trigger1 = enemynear,name = "ZMR_Template" && enemynear,authorname = "Alexander Cooper 19 and Viola" ;KFM/Kung Fu Man
trigger2 = enemynear,name = "ZanderCooper_ZMR" && enemynear,authorname = "Alexander Cooper 19"
trigger3 = enemynear,name = "CorndogPlate_ZMR" && enemynear,authorname = "Alexander Cooper 19"
trigger4 = enemynear,name = "Totino_ZMR" && enemynear,authorname = "Alexander Cooper 19"
trigger5 = enemynear,name = "ChickenGuy_ZMR" && enemynear,authorname = "Viola"
trigger6 = enemynear,name = "ExpandDong_ZMR" && enemynear,authorname = "Alexander Cooper 19"
trigger7 = enemynear,name = "Bamberly_ZMR" && enemynear,authorname = "Alexander Cooper 19"
trigger8 = enemynear,name = "AlexanderCooper_ZMR" && enemynear,authorname = "Alexander Cooper 19"
trigger9 = enemynear,name = "Khan_ZMR" && enemynear,authorname = "Alexander Cooper 19"
trigger10 = enemynear,name = "Ronald_ZMR" && enemynear,authorname = "Plu1223"
trigger11 = enemynear,name = "Colonel_ZMR" && enemynear,authorname = "Plu1223"
;--------------------------------------------------------------------------------------------------------
v = 21
value = 1
ignorehitpause = 1

;==============================================================
;Universal Damage Dampener

;made to insure that if you have a long combo going, it doesn't do to much
;damage. this is a no brainer I don't need to explain much on why Its here lol

;although, if you ever go into liedown state or do aerial raves, this resets the
;damage dampener.

;---------------------------------------------------
;VERY IMPORTANT: you can apply scaling to all your helpers by adding this line of code below at the top of your helpers 
;statedef. projectiles and other attacks involving helpers would be busted otherwise if not kept in.

;[State -3, Attack Scale for Projectiles] ;this code you can put in your projectiles for added scaling to them too.
;type = AttackMulSet
;trigger1 = 1
;value = root,fvar(3)
;ignorehitpause = 1
;---------------------------------------------------

[State -3, Attack Scale] ;fvar(3) always tracks the damage output of a combo at all times to prevent combos from doing to much damage.
type = AttackMulSet
trigger1 = 1
value = fvar(3)
ignorehitpause = 1
[State -3, Variable Scale] ;fvar(3) always tracks the damage output of a combo at all times to prevent combos from doing to much damage.
type = varset
trigger1 = numenemy
fvar(3) = fvar(3)*(0.9985**(enemynear(0),gethitvar(hitcount)))
ignorehitpause = 1
[State -3, Reset var when the opponent recovers] ;when opponent is out of hurt states it will reset scaling back to normal after a combo.
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(3) = 1
ignorehitpause = 1
;==============================================================
;Universal Launcher Detector

;this checks the variable for Aerial Raves. if you successfully preform 
;input for launcher jump after a launcher hit this keeps track of it and gives
;you no damage scaling with less overall damage output. 

;if you get hit or leave the air this variable gets set to 0, turning off
;aerial rave state.

[State Launcher Detector]
type = VarSet
triggerall = stateno != 40 || stateno != 52
trigger1 = statetype != A
trigger2 = movetype = H
v = 4 
value = 0
ignorehitpause = 1
