; Win pose 3 - Walk Away
[Statedef 183]
type = S
ctrl = 0
anim = 183
velset = 0,0

[State Roundnotover]
type = AssertSpecial
trigger1 = time = [0,300]
flag = roundnotover

[State 20, 2]
type = VelSet
trigger1 = animelemtime(13)>=0
x = const(velocity.walk.back.x)*1.2

[State 0, ScreenBound]
type = ScreenBound
trigger1 = animelemtime(13)>=0
value = 0
movecamera = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA

