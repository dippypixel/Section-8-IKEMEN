;---------------------------------------------------------------------------
;Intro 1 - WOOD
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 0, power]
type = powerset
trigger1 = roundsexisted = 0
trigger1 = !time
trigger1 = power < 500
value = 500

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
