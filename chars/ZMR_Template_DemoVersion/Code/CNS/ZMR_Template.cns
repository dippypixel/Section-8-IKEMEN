var(22) = 0
ignorehitpause = 1

[State ZMR Debug Info (Player)] ;Both Clipboards are for tracking certain variables in the Debug Menu, accessed by pressing Ctrl+D on your keyboard.
type = DisplayToClipboard
trigger1 = !var(59)
text = "- Air Counter: %d | Aerial Rave: %d | Sucking Ass: %d | Inside ZMR?: %d"
params = var(10),Var(4),var(6),var(21)

[State ZMR Debug Info (Player)]
type = AppendToClipboard
trigger1 = !var(59)
text = "| Enemy Pos X: %d | Enemy Pos Y: %d"
params = p2bodydist x,p2bodydist y

[State -2, First Attack FX] ;checks if you land an attack on opponent at the start of the match, when activated will only appear once until the next round.
type = Helper
triggerall = roundno = 1
triggerall = stateno != [900000,930000]
triggerall = var(48)=0 ;tagged in
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
triggerall=!ishelper
triggerall = roundstate = 2
triggerall = var(6) = 0
triggerall = numhelper(8291)=0
triggerall = enemynear,life = enemynear,lifemax
trigger1 = enemynear,stateno = [5000,5300]
helperType = Normal
stateNo = 8291
ID = 8291
name = "First Attack FX"
postype = P1
pos = 0,0
ownPal = 1
sprpriority = 9999
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1
persistent = 0

;If you successfully preform an Aerial Rave
;the game checks to see if you have successfully did one. when
;you do it displays the message.
[State -2, Aerial Rave FX]
type = Helper
triggerall = numenemy
triggerall = var(48)=0 ;tagged out detector
triggerall = movetype = A
;-------------------------------------------------
;Disabled for Bosses
triggerall = enemynear,name!="CorndogOfLightV2"
triggerall = enemynear,name!="PizzaRollOfDarknessV2" 
;-------------------------------------------------
trigger1 = enemy,stateno = 51001 && enemy,time = 1
helperType = Normal
stateNo = 8292
ID = 8292
name = "Aerial Rave FX"
postype = P1
pos = 0,0
ownPal = 1
pauseMoveTime = 255
superMoveTime = 255
ignoreHitPause = 1

[State -2, Parry Tracker] ;for announcer messages acting weird after a move is parried and countered with an air normal
type = VarSet
triggerall = stateno != 160
trigger1 = stateno != [600,630]
var(10) = 0
ignoreHitPause = 1

[State Life Tracker] ;tracks your health for perfects. if you lose any health it gets set to 1
type = VarSet
trigger1 = life != lifemax
var(6) = 1   

;This trigger controls the announcers KO, You Win and Hyper Combo Finish states
;in ZMR, the announcer gets more control over the game depending on what state 
;you're in. more information is in statedef 9980-9982 located in Common1_ZMR.cns
[State Roundstate 3 KO/Hyper Combo Finish]
type = Helper
triggerall = var(48) = 0
triggerall = stateno != [900000,930000]
triggerall=!ishelper
triggerall = winko && roundstate = 3 && alive
trigger1 = NumHelper(9980)=0
name = "Announcer"
ID = 9980
StateNo = 9980
ignorehitpause = 1
persistent = 0
ownpal = 1
supermovetime = 65
pausemovetime = 65

[state Corndog Orb Detector]
type=varset
trigger1=roundstate=0
var(23)=0

;=================================================
;Codes for Launcher to ignore juggle points during aerial raves.
;that and air guard isn't a thing in ZMR to make parries more valuable
;3rd code is to make sure opponents don't get hit before roundstate 2

[State Launcher Detector] ;if detected doesn't count juggle points during aerial rave
type = AssertSpecial
trigger1 = var(4)=1
flag = nojugglecheck
ignorehitpause =1

[State NO AIR GUARD] ;it stinks and sucks lol
type = AssertSpecial
trigger1 = 1
flag = noairguard
ignorehitpause=1

[State NO GUARD FOR TAG MEMBERS] ;to fix any potentional issues with tag team assist
type = AssertSpecial
triggerall = var(49)=1 ;tag team detector
trigger1 = var(48)=1 ;tagged out detector
flag = noairguard
flag2 = nostandguard
flag3 = nocrouchguard
ignorehitpause=1

[State Immune to all Strikes outside roundstate 2] ;self explainatory
type = NotHitBy
triggerall = GameTime && stateno !=[5000,5999]
trigger1 = !ctrl && RoundState != 2 
trigger2 = !Alive
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1

[State Tag Team Infinite Prevention]
type = Nothitby
triggerall = var(49)=1
trigger1 = !alive && roundstate = 2
value = SCA
ignorehitpause = 1

[State Immune to Strikes when Boss is defeated] ;self explainatory
type = NotHitBy
triggerall = alive && roundstate = 2
trigger1 = enemynear,name="CorndogOfLightV2"
trigger1 = enemynear,stateno = 6969 ;&& enemynear,movetype = H
trigger2 = enemynear,name="PizzaRollOfDarknessV2" 
trigger2 = enemynear,stateno = 555000 ;&& enemynear,movetype = H
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
ignorehitpause = 1
;---------------------------------------------------------------------------------------------
;Knocked Down Effects

;these are put here to fix an issue with aerial raves against characters that aren't from ZMR.
;they would have been in their respective states otherwise but liberties need to be made.

[State Knocked Down]
type = Explod
triggerall = time=1 ;&& !SysVar(0)
triggerall = BackEdgeDist > -80 ;ringout
triggerall = FrontEdgeDist > -80 ;ringout
trigger1 = stateno = 5100
trigger2 = stateno = 5110
trigger3 = stateno = 5111
trigger4 = stateno = 51001
trigger5 = stateno = 51101
anim = 1002
ID = 1002
pos = 0,0
postype = P1
supermovetime = 999999
pausemovetime = 999999
trans=add
scale = 0.45,0.45
sprpriority = -31
ownpal = 1

[State Knocked Down]
type = Explod
triggerall = time=1 ;&& !SysVar(0)
triggerall = BackEdgeDist > -80 ;ringout
triggerall = FrontEdgeDist > -80 ;ringout
trigger1 = stateno = 5100
trigger2 = stateno = 5110
trigger3 = stateno = 5111
trigger4 = stateno = 51001
trigger5 = stateno = 51101
anim = 1002
ID = 1002
pos = 0,0
postype = P1
supermovetime = 999999
pausemovetime = 999999
trans=sub
scale = 0.5,0.5
sprpriority = -31
ownpal = 1

[State Knocked Down]
type = EnvShake
triggerall = time=1 ;&& !SysVar(0)
triggerall = BackEdgeDist > -80 ;ringout
triggerall = FrontEdgeDist > -80 ;ringout
trigger1 = stateno = 5100
trigger2 = stateno = 5110
trigger3 = stateno = 5111
trigger4 = stateno = 51001
trigger5 = stateno = 51101
time = 7
freq = 120
ampl = -4

[State Knocked Down]
type = PlaySnd
triggerall = time=1 ;&& !SysVar(0)
triggerall = BackEdgeDist > -80 ;ringout
triggerall = FrontEdgeDist > -80 ;ringout
trigger1 = stateno = 5100
trigger2 = stateno = 5110
trigger3 = stateno = 5111
trigger4 = stateno = 51001
trigger5 = stateno = 51101
value = s1,10
;---------------------------------------------------------------------------------------------
;HitSparks

;ZMR Hitsparks are all coded into here for easier access. there is a Null trigger in all attack states
;that keep track of what kind of hitsparks they use and their positions. 

;[State HitSpark]
;type=null
;;
;;Spark X
;trigger1=1||var(41):=0
;;
;;Spark Y
;trigger1=1||var(42):=-76
;;
;;Spark Type
;;
;;0=Normal Light
;;1=Normal Medium
;;2=Normal Hard
;;10=Slash Light
;;11=Slash Medium
;;12=Slash Hard
;;
;trigger1=1||var(43):=0
;ignorehitpause=1

;if you see something like this in attack states, thats what its for. the rest
;you don't need to mess with, just the null trigger in attack states



[state Target,ID]
type=varset
triggerall=var(40)<0
triggerall=numenemy=1
trigger1=roundstate=0
trigger2=numtarget!=1
var(44)=enemynear,id
ignorehitpause=1
[state Target,ID]
type=varset
triggerall=var(40)<0
triggerall=numenemy>1
trigger1=roundstate=0
trigger2=numtarget!=1
var(44)=ifelse(enemynear(0),alive,enemynear(0),id,enemynear(1),id)
ignorehitpause=1
[state Target,ID]
type=varset
triggerall = enemynear,name != "CorndogOfLightV2" || enemynear,name != "PizzaRollOfDarknessV2"
triggerall=var(40)<0
trigger1=movecontact=1
trigger1=numtarget=1
var(44)=target,id
ignorehitpause=1
[state Target,ID]
type=varset
triggerall = enemynear,name != "CorndogOfLightV2" || enemynear,name != "PizzaRollOfDarknessV2"
triggerall=var(40)<0
trigger1=movecontact=1
trigger1=!numtarget
var(44)=-1
ignorehitpause=1
[state HitPause]
type=varset
triggerall=var(40)<0
trigger1=movecontact=1
var(40)=hitpausetime
ignorehitpause=1

[state Disable Spark]
type=varset
triggerall=var(43)>0
trigger1=stateno=0||stateno=10||stateno=20||stateno=40||stateno=50
trigger2=movetype=h
trigger3=roundstate<2
var(43)=-1
ignorehitpause=1

[State HitSpark FX]
type = Helper
triggerall = enemynear,name != "CorndogOfLightV2" || enemynear,name != "PizzaRollOfDarknessV2"
triggerall=playeridexist(var(44))
triggerall=hitpausetime=var(40)
triggerall=var(43)>=0
trigger1 = movehit=1
helpertype = Normal
name = "HitSpark"
ID = 823000
stateno = 823000
pos = (ceil(playerid(var(44)),pos x-pos x)*facing)+var(41),var(42)
postype = P1
ownpal = 1
supermovetime = 99999999
pausemovetime = 99999999
size.shadowoffset=100+var(43)
ignorehitpause = 1

[State HitSpark FX (FOR BOSSES ONLY)]
type = Helper
triggerall = teammode = single || teammode = turns || var(49)=1
triggerall = enemynear,name = "CorndogOfLightV2" || enemynear,name = "PizzaRollOfDarknessV2"
triggerall=hitpausetime=var(40)
triggerall=var(43)>=0
trigger1 = movehit=1
helpertype = Normal
name = "HitSpark"
ID = 823000
stateno = 823000
pos = p2dist x+var(41),var(42)
postype = P1
ownpal = 1
supermovetime = 99999999
pausemovetime = 99999999
size.shadowoffset=100+var(43)
ignorehitpause = 1

[State GuardSpark FX]
type = Helper
triggerall=playeridexist(var(44))
triggerall=hitpausetime=var(40)
triggerall=var(43)>=0
trigger1 = moveguarded=1
helpertype = Normal
name = "GuardSpark"
ID = 823000
stateno = 823001
pos = (ceil(playerid(var(44)),pos x-pos x)*facing)+var(41),var(42)
postype = P1
ownpal = 1
supermovetime = 99999999
pausemovetime = 99999999
size.shadowoffset=100+var(43)
ignorehitpause = 1

