velset = 0,0
anim = 1020
ctrl = 0
sprpriority = 2
velset = 0,0

[State 0, NotHitBy]
type = NotHitBy
trigger1 = animelemtime(5)<=0
value = SCA

[State 0, PalFX]
type = PalFX
trigger1 = !time
time = 3
add = 255,255,255

[State Whiff SFX]
type = PlaySnd
trigger1 = Animelem = 3
trigger2 = Animelem = 10
value = s2, ifelse(animelemtime(10)=0,3,4)

[State HitSpark]
type=null
;
;Spark X
trigger1=1||var(41):=0
;
;Spark Y
trigger1=1||var(42):=-56
;
;Spark Type
;
;0=Normal Light
;1=Normal Medium
;2=Normal Hard
;10=Slash Light
;11=Slash Medium
;12=Slash Hard
;
trigger1=1||var(43):=0
ignorehitpause=1

[state ]
type=velset
trigger1=animelem=4
x=3.5
y=-5
ignorehitpause=1
[state ]
type=statetypeset
trigger1=animelem=4
statetype=a
[state ]
type=statetypeset
trigger1=animelemtime(5)>=0&&pos y<0
physics=n
[State 0, VelAdd]
type = VelAdd
trigger1=animelemtime(5)>=0&&pos y<0
y = .40

[State 1050, 4]
type = HitDef
trigger1 = !time
trigger2 = Animelem = 12
attr = A, SA
animtype  = light
damage    = 30, ceil(30*.25)
priority  = 5
guardflag = MA
pausetime = 8,8
sparkxy = -10,-70
sparkno = -1
guard.sparkno=-1
hitsound   = s1,ifelse(animelemtime(12)=0,1,0)
guardsound = s1, 8  
ground.type = Low
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = ifelse(animelemtime(12)=0,-5,-1),-5
guard.velocity = -7
air.velocity = ifelse(animelemtime(12)=0,-5,-1),ifelse(animelemtime(12)=0,-1,-5)
fall = 1
fall.recovertime = 45

[state ]
type=changestate
triggerall = time > 10
trigger1=pos y>=0&&vel y>0
value=648 ;Hard Land


