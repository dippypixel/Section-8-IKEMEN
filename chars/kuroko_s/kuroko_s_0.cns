trigger1 = wintime = 1
value = 181


[State 180, 勝利ポーズ 1 へステート変更（軽率な行動は、お慎みあそばせ）]
type = ChangeState
trigger1 = var(11) = 1
value = 181

[State 180, 勝利ポーズ 2 へステート変更（急所は外してありますの）]
type = ChangeState
trigger1 = var(11) = 2
value = 182

[State 180, 勝利ポーズ 3 へステート変更（少々やりすぎてしまった感はあります）]
type = ChangeState
trigger1 = var(11) = 3
value = 183

