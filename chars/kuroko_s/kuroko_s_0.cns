type = S
ctrl = 0
anim = 0
velset = 0,0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利ポーズ分岐
; CNS レベル: 基本
[Statedef 180]
type = S

[State -1]
Type     = VarRandom
Trigger1 = Time = 0
V        = 11
Range    = 1,3

;セリフテスト用
[State -1]
Type     = null;varset
Trigger1 = Time = 0
V        = 11
Value    = 2


[State 184, 美琴勝利ポーズ 1 へステート変更]
type = ChangeState
trigger1 = NumHelper(4000) =1;美琴が画面内に存在してること
value = 184

[State 180, 勝利ポーズ 1 へステート変更（軽率な行動は、お慎みあそばせ）※タイムアウト勝利はこれに統一 ]
