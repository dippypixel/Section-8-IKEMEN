Trigger1 = 1
value = 0


;■　特殊イントロON/OFF ■■■■■■■■■
[State -1,intro]
type = Varset
Trigger1 = time =0
v = 2
value = 0
;特殊イントロON/OFFの変更は、上記の「Value =0」の値を変更して行います。
;  value = 0 → ON（デフォルト）。
;         -1 → OFF。

