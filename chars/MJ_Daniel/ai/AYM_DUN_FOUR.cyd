;AI related-------------------------------------------------------------------------------

[state -1]
type = varset
var(59) = 1
trigger1 = AILevel
ignorehitpause = 1

[state -1]
type = varset
var(59) = 0
trigger1 = !AILevel
ignorehitpause = 1


[State -1, AI DMM-like Guarding System]
type=helper
trigger1=!NumHelper(9742)
trigger1=roundstate=2
trigger1=alive&&!ishelper
trigger1=var(59)
helpertype=normal
name="AI Guarding Helper"
stateno=9742
ID=9742
pos=9999,9999
keyctrl=0
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[State -1, AI Guard]
type = ChangeState
value = 120
ctrl = 0
triggerall = var(59) && !ishelper && alive && roundstate < 3
triggerall = ctrl || (stateno = [21,22]) || (stateno = [100,101])
triggerall = stateno != 195 && stateno != [120,155]
triggerall = prevstateno != [8000,8002]
triggerall = !(enemynear(!enemynear,alive),hitdefattr = SCA,AT)
trigger1 = inguarddist
[State -1, Disable Default Guarding]
type = AssertSpecial
trigger1 = var(59) = 1 && !ishelper && alive && RoundState = 2
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard
ignorehitpause = 1

[State -1, Disable Default Walking]
type = AssertSpecial
trigger1 = var(59) = 1 && !ishelper && alive && RoundState = 2
flag = NoWalk
ignorehitpause = 1

[State -1, DMM Guarding Check (OFF)]
type = VarSet
triggerall = var(59) && numenemy
triggerall = numhelper(9742)
trigger1 = enemynear(!enemynear,alive), statetype != A
trigger1 = enemynear(!enemynear,alive), stateno != helper(9742),var(59) || enemynear(!enemynear,alive), stateno = 0
var(33) = 0
ignorehitpause = 1

[State -1, DMM Guarding Check (ON)]
type = VarSet
triggerall = var(59) && numenemy
trigger1 = enemynear(!enemynear,alive), statetype = A
trigger2 = numhelper(9742)
trigger2 = enemynear(!enemynear,alive), stateno != 0
trigger2 = enemynear(!enemynear,alive), stateno = helper(9742),var(59)
var(33) = 1
ignorehitpause = 1

