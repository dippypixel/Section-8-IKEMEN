[Statedef -3]

;========================================================
; 1.0 ONLY
;========================================================

[State 0, VarSet]
type = VarSet
triggerall = Time = 0
trigger1 = StateNo = [180,195)
v = 30
value = Ceil(GameWidth)
[State 0, VarSet]
type = VarSet
triggerall = Time = 0
trigger1 = StateNo = [180,195)
v = 31
value = Ceil(GameHeight)

;========================================================
; FIGHT! FIGHT! OH!
;========================================================

[State 0, VarSet]
type = VarSet
trigger1 = Var(15) = 0
trigger1 = AILevel != 0
v = 15
value = ifelse(Var(14) = 0,AILevel,Var(14))
[State 0, VarSet]
type = VarSet
trigger1 = Var(15) != 0
trigger1 = AILevel = 0
v = 15
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = IsHomeTeam
trigger1 = Var(15) != 0 && Var(15) < 8
v = 15
value = 8

;========================================================
; KO STUFF
;========================================================

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nokosnd

[State 0, PlaySnd]
type = PlaySnd
triggerall = StateNo != 5950
triggerall = PrevStateNo != 130 && PrevStateNo != 131 && PrevStateNo != [150,153]
trigger1 = !Alive
trigger1 = Var(32) = 0
value = S11,0
channel = 0