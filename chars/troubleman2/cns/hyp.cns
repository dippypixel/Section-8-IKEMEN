triggerall = Var(20) < 6 || Var(21) < 0
trigger1 = Time > 1
v = 21
value = 1
[State 0, VarSet FailState]
type = VarSet
trigger1 = Anim = 2101
v = 20
value = 666

[State 0, VarSet Input if X]
type = VarSet
triggerall = Var(20) < 6
triggerall = Var(21) >= 0
trigger1 = command = "x" && !Var(15)
trigger2 = Var(15) && !Var(5) && Random < 200 ; AI Random
trigger3 = Var(15) && Var(5) = 10 && Var(20) = 0 ; AI Pillar 1
trigger4 = Var(15) && Var(5) = 10 && Var(20) = 3 ; AI Pillar 4
trigger5 = Var(15) && Var(5) = 21 && Var(20) = 0 ; AI Bulletstorm 1
trigger6 = Var(15) && Var(5) = 21 && Var(20) = 1 ; AI Bulletstorm 2
trigger7 = Var(15) && Var(5) = 22 && Var(20) = 0 ; AI Stellar 1
v = 24+Var(20)
value = 1
[State 0, VarSet Input if Y]
type = VarSet
triggerall = Var(20) < 6
triggerall = Var(21) >= 0
trigger1 = command = "y" && !Var(15)
trigger2 = Var(15) && !Var(5) && Random < 200 ; AI Random
trigger3 = Var(15) && Var(5) = 10 && Var(20) = 1 ; AI Pillar 2
trigger4 = Var(15) && Var(5) = 10 && Var(20) = 4 ; AI Pillar 5
trigger5 = Var(15) && Var(5) = 12 && Var(20) = 1 ; AI AoKuang 2
trigger6 = Var(15) && Var(5) = 12 && Var(20) = 2 ; AI AoKuang 3
trigger7 = Var(15) && Var(5) = 12 && Var(20) = 5 ; AI AoKuang 6
trigger8 = Var(15) && Var(5) = 21 && Var(20) = 2 ; AI Bulletstorm 3
trigger9 = Var(15) && Var(5) = 21 && Var(20) = 3 ; AI Bulletstorm 4
trigger10 = Var(15) && Var(5) = 22 && Var(20) = 2 ; AI Stellar 3
v = 24+Var(20)
value = 2
[State 0, VarSet Input if Z]
