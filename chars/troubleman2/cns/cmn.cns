;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]


;==============
; DEBUG
;==============
[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = StageVar(info.name) = "sktestroom"
text = "%f * %f * %f \n %f * %f * %f"  ;%d %f
params = fvar(10),fvar(11),fvar(12),fvar(13),fvar(14),fvar(15) ;, FVar(11)
ignorehitpause = 1

;==============
; HITTIME
;==============
[State 0, HitTime Add]
type = VarAdd
trigger1 = MoveContact && !MoveReversed
v = 8
value = 1
ignorehitpause = 1
[State 0, HitTime Reset]
type = VarSet
trigger1 = 1
v = 8
value = 0

;==============
; COUNTER
;==============
[State 0, Counter Check]
type = VarSet
trigger1 = MoveType = A
v = 9
value = ifelse(EnemyNear,MoveType = A,1,0)
;ignorehitpause = 1
[State 0, Counter Test]
type = PalFX
triggerall = MoveHit && !MoveReversed
trigger1 = Var(8) = 1 && Var(9) != 0
time = 2
add = 128,128,128
mul = 256,256,256
invertall = 0
color = 0
ignorehitpause = 2

[State 0, Counter Move]
type = VarSet
trigger1 = Var(8) && MoveHit && !MoveReversed
