;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
facep2 = 1
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd" && Var(15) = 0
trigger2 = Var(15) != 0
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 0, VarSet]
type = VarSet
trigger1 = Time = 0
v = 3
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = Time = 3 && !Var(15)
trigger1 = Command = "holdup"
v = 3
value = 1
[State 0, VarSet AI Short Hops]
type = VarSet
trigger1 = Time = 3 && Var(15)
v = 3
value = ifelse(EnemyNear,StateNo < 5100 && EnemyNear,StateType != A,0,1)

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(var(3)=0, -5, const(velocity.jump.y))

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 0, AfterImage]
type = AfterImage
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
time = 20
length = 4
palcolor = 256
palbright = 0,0,0
palcontrast = 255,255,255
paladd = -64,-32,-32
palmul = 0.66,0.66,0.66
timegap = 2
framegap = 2

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Var(3) = 1
trigger1 = Time = 0
trigger1 = PrevStateNo != 45
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 2]
type = ChangeAnim
triggerall = Time = 0
trigger1 = Var(3) = 0
trigger2 = PrevStateNo = 45
value = 49

[State 0, Snd]
type = PlaySnd
trigger1 = Time = 0
value = S5,0
;channel = 0
[State 0, Snd]
type = PlaySnd
trigger1 = Time = 0
value = S41,0
channel = 1

