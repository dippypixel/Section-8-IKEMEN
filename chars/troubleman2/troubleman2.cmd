[Statedef -1]
; Another one Of Melvana's Many Asian Wives

;===========================================================================
;---------------------------------------------------------------------------
[State -1, AI Guard]
Type = ChangeState
Value = 120
triggerall = StateType != A && Var(15) != 0 && Ctrl
trigger1 = (Var(15)*Var(15)*Var(15)*2)*0.1
trigger1 = !(enemynear,hitdefattr=SCA,AT) && inguarddist
trigger1 = (stateno!=[120,155])

[State -1, AI Passive Reset]
type = VarSet
trigger1 = Var(15)
var(13) = 0

[State -1, AI Passive On]
type = VarSet
triggerall = Var(15)
trigger1 = EnemyNear,StateNo = [5100,5120]
var(13) = 1

[State -1, AI Jump]
Type = ChangeState
Value = 40
triggerall = StateType != A && Var(15) != 0 && (Ctrl || StateNo = 100) && RoundState = 2
trigger1 = (Var(15)**3)*2*0.6 > random
trigger1 = EnemyNear,StateNo = 5120 && P2Dist X < 64
trigger2 = (Var(15)**3)*2*0.3 > random
trigger2 = (P2Dist X = [48,80]) && !Var(13) && EnemyNear,MoveType != H
trigger3 = (Var(15)**3)*2*0.6 > random
trigger3 = Abs(P2Dist Y) > 64 && (EnemyNear,StateNo != [2020,2021])
trigger4 = (Var(15)**3)*2*0.7 > random
trigger4 = StateNo = 100 && (EnemyNear,StateNo = [1420,1422]) && EnemyNear,MoveType = H && P2Dist X < 96


