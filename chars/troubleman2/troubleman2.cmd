; * * * TEST * * * 
[State -1, * * * TEST * * * ]
type = ChangeState
value = 2700
triggerall = statetype != A && ctrl
trigger1 = command = "holddown" && command = "start" && Var(15) = 0

;===========================================================================
;---------------------------------------------------------------------------
;Run Fwd
[State -1, ff]
type = ChangeState
value = 100
triggerall = statetype = S && ctrl
trigger1 = command = "FF" && Var(15) = 0
trigger2 = Var(15) && (Var(15)**3)*2*0.9 > random && RoundState = 2 ; AI runs in after Seether
trigger2 = (EnemyNear,StateNo = [1420,1422]) && EnemyNear,MoveType = H && P2Dist X > 32
trigger3 = Var(15) && (Var(15)**3)*2*0.6 > random && RoundState = 2 ; AI runs in if enemy is hurt
trigger3 = EnemyNear,MoveType = H && P2Dist X > 32

;---------------------------------------------------------------------------
;Run Back
[State -1, bb]
type = ChangeState
value = 105
triggerall = statetype = S && ctrl
trigger1 = command = "BB" && Var(15) = 0
trigger2 = Var(15) && (Var(15)**3)*2*0.5 > random && RoundState = 2 ; AI dashes back if they're down
trigger2 = P2Dist X < 56 && var(13)

